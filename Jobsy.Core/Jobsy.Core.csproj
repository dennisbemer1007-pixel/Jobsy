    <EmbeddedResource Include="Data/SampleReports/*.json" />
    <EmbeddedResource Include="Data/DeepItems/*.json" />
    <EmbeddedResource Include="Scholen/Resources/dutch-first-names.txt" />
    <Content Remove="Rules/DeepItems/**" />
    <None Remove="Rules/DeepItems/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jobsy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
