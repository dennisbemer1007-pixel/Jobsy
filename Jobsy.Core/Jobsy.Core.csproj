    <EmbeddedResource Update="Data/Occupations/occupations.nl.json" WithCulture="false" LogicalName="Jobsy.Core.Data.Occupations.occupations.nl.json" />
    <EmbeddedResource Update="Data/Occupations/skills.nl.json" WithCulture="false" LogicalName="Jobsy.Core.Data.Occupations.skills.nl.json" />
