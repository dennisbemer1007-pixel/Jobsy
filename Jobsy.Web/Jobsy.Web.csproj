<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Sentry.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jobsy.Core\Jobsy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jobsy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Hosting\wwwroot-asset-versions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <PrecompressStaticJsScript>$(MSBuildThisFileDirectory)../tools/scripts/precompress-wwwroot-assets.py</PrecompressStaticJsScript>
  </PropertyGroup>
  <Target Name="PrecompressLargeStaticJs" BeforeTargets="BeforeBuild"
          Condition="'$(SkipPrecompressStaticJs)' != 'true' and Exists('$(PrecompressStaticJsScript)')">
    <Exec Command="python3 &quot;$(PrecompressStaticJsScript)&quot;"
          IgnoreExitCode="false"
          ConsoleToMsBuild="true" />
  </Target>

</Project>

