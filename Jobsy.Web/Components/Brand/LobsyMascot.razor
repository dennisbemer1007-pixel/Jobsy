@namespace Jobsy.Web.Components.Brand
@using Jobsy.Web.Media
@*
  Inline SVG mascot (6 expressions + shell ghost). External Svg/Raster still supported for tests.
*@

<span class="@RootClass"
      @attributes="RootAttributes">
@if (Source.IsInline)
{
    @((MarkupString)InlineSvg)
}
else if (Source.IsVector)
{
    <img class="pub-mascot__img"
         src="@Abs(Source.Src)"
         width="@BoxPx"
         height="@BoxPx"
         alt="@AltText"
         loading="@Loading"
         decoding="@Decoding"
         fetchpriority="@FetchPriority"
         draggable="false" />
}
else if (!Source.IsFallback && Source.AvifSrcSet is not null)
{
    <picture>
        <source type="image/avif" srcset="@AbsSrcSet(Source.AvifSrcSet)" sizes="@Sizes" />
        <img class="pub-mascot__img"
             src="@Abs(Source.Src)"
             srcset="@(Source.SrcSet is null ? null : AbsSrcSet(Source.SrcSet))"
             sizes="@Sizes"
             width="@BoxPx"
             height="@BoxPx"
             alt="@AltText"
             loading="@Loading"
             decoding="@Decoding"
             fetchpriority="@FetchPriority"
             draggable="false" />
    </picture>
}
else
{
    <img class="pub-mascot__img"
         src="@Abs(Source.Src)"
         srcset="@(Source.SrcSet is null ? null : AbsSrcSet(Source.SrcSet))"
         sizes="@Sizes"
         width="@BoxPx"
         height="@BoxPx"
         alt="@AltText"
         loading="@Loading"
         decoding="@Decoding"
         fetchpriority="@FetchPriority"
         draggable="false" />
}
</span>

@code {
    private static int _nextUid;

    [Parameter] public MascotPose Pose { get; set; } = MascotPose.Rustig;
    [Parameter] public MascotSize Size { get; set; } = MascotSize.Medium;
    [Parameter] public LobsyMascotArt.MascotVariant Variant { get; set; } = LobsyMascotArt.MascotVariant.Full;
    [Parameter] public bool Mirror { get; set; }
    [Parameter] public bool Priority { get; set; }
    /// <summary>Empty = decorative (aria-hidden). Non-empty = accessible name.</summary>
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string? Class { get; set; }

    private readonly int _uid = Interlocked.Increment(ref _nextUid);

    private MascotSource Source => MascotAssets.Resolve(Pose);
    private int BoxPx => (int)Size;
    private string Sizes => MascotAssets.SizesAttribute(Size);
    private string AltText => Alt ?? "";
    private bool IsDecorative => string.IsNullOrEmpty(AltText);
    private string Loading => Priority ? "eager" : "lazy";
    private const string Decoding = "async";
    private string? FetchPriority => Priority ? "high" : null;

    private string InlineSvg
    {
        get
        {
            var sb = new System.Text.StringBuilder(2200);
            LobsyMascotArt.AppendSvg(sb, Pose, _uid.ToString(), Variant, shellGhost: Pose == MascotPose.Shell);
            var svg = sb.ToString();
            if (Mirror)
            {
                svg = svg.Replace(
                    "class=\"pub-mascot__svg\"",
                    "class=\"pub-mascot__svg pub-mascot__svg--mirror\"",
                    StringComparison.Ordinal);
            }

            return svg;
        }
    }

    private string RootClass
    {
        get
        {
            var parts = new List<string> { "pub-mascot", MascotAssets.SizeCssClass(Size) };
            if (Variant == LobsyMascotArt.MascotVariant.Avatar)
            {
                parts.Add("pub-mascot--avatar");
            }

            if (Mirror)
            {
                parts.Add("pub-mascot--mirror");
            }

            if (!string.IsNullOrEmpty(Source.FallbackTransformClass))
            {
                parts.Add(Source.FallbackTransformClass);
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                parts.Add(Class.Trim());
            }

            return string.Join(' ', parts);
        }
    }

    private Dictionary<string, object> RootAttributes
    {
        get
        {
            var attrs = new Dictionary<string, object>();
            if (IsDecorative)
            {
                attrs["aria-hidden"] = "true";
            }
            else
            {
                attrs["role"] = "img";
                attrs["aria-label"] = AltText;
            }

            return attrs;
        }
    }

    private static string Abs(string path)
        => path.StartsWith('/') ? path : "/" + path;

    private static string AbsSrcSet(string srcSet)
    {
        return string.Join(", ",
            srcSet.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Select(part =>
                {
                    var space = part.IndexOf(' ');
                    if (space < 0)
                    {
                        return Abs(part);
                    }

                    return Abs(part[..space]) + part[space..];
                }));
    }

    /// <summary>Preload link for HeadContent. Inline SVG needs no preload.</summary>
    public static MarkupString PreloadLink(MascotPose pose, MascotSize size)
    {
        var source = MascotAssets.Resolve(pose);
        if (source.IsInline)
        {
            return default;
        }

        var sizes = MascotAssets.SizesAttribute(size);
        if (source.IsVector)
        {
            return new MarkupString(
                $"""<link rel="preload" as="image" href="{Abs(source.Src)}" fetchpriority="high" />""");
        }

        var srcset = source.SrcSet is null ? Abs(source.Src) : AbsSrcSet(source.SrcSet);
        return new MarkupString(
            $"""<link rel="preload" as="image" imagesrcset="{srcset}" imagesizes="{sizes}" fetchpriority="high" />""");
    }
}
