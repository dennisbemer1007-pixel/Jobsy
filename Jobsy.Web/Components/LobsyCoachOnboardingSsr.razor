@namespace Jobsy.Web.Components
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<div id="lobsy-assistant-ssr-config" hidden
     data-chat-url="/api/assistant-client/chat"
     data-business="1"
     data-coach-avatar-url="@BrandImages.AbsoluteCoachBAvatar"
     data-coach-figure-url="@BrandImages.AbsoluteCoachB"
     data-title="@Culture["Assistant.BotName"]"
     data-subtitle="@Culture["Assistant.SubtitleWarm"]"
     data-greeting="@Culture["Assistant.Greeting"]"
     data-you="@Culture["Assistant.You"]"
     data-close="@Culture["Assistant.Close"]"
     data-new-chat="@Culture["Assistant.NewChat"]"
     data-send="@Culture["Assistant.Send"]"
     data-placeholder="@Culture["Assistant.PlaceholderWarm"]"
     data-typing="@Culture["Assistant.Typing"]"
     data-disclaimer="@Culture["Assistant.Disclaimer"]"
     data-read-aloud-aria="@Culture["ReadAloud.PlayAria"]"
     data-read-aloud-play="@Culture["ReadAloud.Play"]"
     data-bubble-text="@_coachBubbleText"
     data-lang="@Culture.Language"></div>

<LobsyCoachVariantBDock ModeClass="lobsy-coach-dock--onboarding-b lobsy-coach-dock--variant-b"
                      TeaserText="@_coachBubbleText" />

@code {
    private string _coachBubbleText = "";

    protected override void OnInitialized()
    {
        _coachBubbleText = ResolveCoachBubbleText();
    }

    private string ResolveCoachBubbleText()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request is null)
        {
            return Culture["Coach.OnboardingBubble"];
        }

        var step = 0;
        if (request.Query.TryGetValue("step", out var stepRaw)
            && int.TryParse(stepRaw.ToString(), out var fromQuery))
        {
            step = fromQuery;
        }
        else
        {
            var path = request.Path.Value ?? "";
            if (path.Contains("step=7", StringComparison.OrdinalIgnoreCase))
            {
                step = 7;
            }
        }

        return step switch
        {
            >= 1 and <= 6 => Culture[$"Onboarding.IllustratedSidebar.Step{step}"],
            7 => Culture["Onboarding.Consent.Lead"],
            _ => Culture["Coach.OnboardingBubble"]
        };
    }
}