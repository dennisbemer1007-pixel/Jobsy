@using Jobsy.Core.Contracts
@inject CultureState Culture
@inject JobsyApiClient Api

@if (IsOpen)
{
    <div class="bk-modal-backdrop" @onclick="Close">
        <aside class="bk-side-panel" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="bk-knock-title">
            <header class="bk-side-panel__header">
                <h2 id="bk-knock-title">@Culture.Format("Initiative.Send.Title", CompanyName)</h2>
                <button type="button" class="icon-btn" @onclick="Close" aria-label="@Culture["Common.Close"]">×</button>
            </header>
            <div class="bk-side-panel__body">
                <section class="bk-side-panel__card">
                    <h3>@Culture["Initiative.Panel.Team"]</h3>
                    <p><strong>@SelectedTeamName</strong></p>
                    @if (Teams.Count > 1)
                    {
                        <button type="button" class="btn--link" @onclick="ToggleTeamPicker">@Culture["Common.Change"]</button>
                    }
                </section>
                @if (_showTeamPicker)
                {
                    @foreach (var team in Teams)
                    {
                        <label class="bk-team-pick">
                            <input type="radio" name="team" checked="@(team.Id == SelectedTeamId)" @onchange="() => PickTeam(team.Id)" />
                            @team.Name
                        </label>
                    }
                }
                <section class="bk-side-panel__card">
                    <h3>@Culture["Initiative.Panel.PassportGoes"]</h3>
                    <p>@Culture["Initiative.Panel.PassportHint"]</p>
                </section>
                <label class="bk-side-panel__motivation">
                    @Culture["Initiative.Panel.Motivation"]
                    <textarea maxlength="500" rows="5" @bind="_motivation" @bind:event="oninput"></textarea>
                    <span class="bk-side-panel__count">@_motivation.Length / 500</span>
                </label>
                <div class="bk-privacy-grid">
                    <div class="bk-privacy-grid__now">
                        <h4>@Culture["Initiative.Panel.SeesNow"]</h4>
                        <ul>
                            <li>@Culture["Initiative.Panel.SeesNow.Role"]</li>
                            <li>@Culture["Initiative.Panel.SeesNow.Region"]</li>
                            <li>@Culture["Initiative.Panel.SeesNow.Dna"]</li>
                            <li>@Culture["Initiative.Panel.SeesNow.Match"]</li>
                        </ul>
                    </div>
                    <div class="bk-privacy-grid__later">
                        <h4>@Culture["Initiative.Panel.SeesAfter"]</h4>
                        <ul>
                            <li>@Culture["Initiative.Panel.SeesAfter.Name"]</li>
                            <li>@Culture["Initiative.Panel.SeesAfter.Motivation"]</li>
                            <li>@Culture["Initiative.Panel.SeesAfter.Experience"]</li>
                            <li>@Culture["Initiative.Panel.SeesAfter.Contact"]</li>
                        </ul>
                    </div>
                </div>
                <p class="bk-side-panel__deadline">@Culture["Initiative.Panel.Deadline"]</p>
            </div>
            <footer class="bk-side-panel__footer">
                <button type="button" class="btn--secondary" @onclick="Close">@Culture["Common.Cancel"]</button>
                <button type="button" class="btn--primary" disabled="@_busy" @onclick="SendAsync">@Culture["Initiative.Panel.Send"]</button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string CompanyName { get; set; } = "";
    [Parameter] public Guid RootCompanyId { get; set; }
    [Parameter] public IReadOnlyList<PublicInitiativeTeamOptionDto> Teams { get; set; } = [];
    [Parameter] public Guid? SelectedTeamId { get; set; }
    [Parameter] public EventCallback<SendWorkInitiativeResult> OnSent { get; set; }

    private string _motivation = "";
    private bool _busy;
    private bool _showTeamPicker;

    private string SelectedTeamName =>
        Teams.FirstOrDefault(t => t.Id == SelectedTeamId)?.Name
        ?? Culture["Initiative.Panel.GeneralEntry"];

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            var result = await Api.SendWorkInitiativeAsync(new SendWorkInitiativeRequest(
                RootCompanyId,
                null,
                SelectedTeamId,
                _motivation,
                AttachPassport: true));
            if (result is not null)
            {
                await OnSent.InvokeAsync(result);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private void ToggleTeamPicker() => _showTeamPicker = !_showTeamPicker;

    private void PickTeam(Guid id) => SelectedTeamId = id;
}
