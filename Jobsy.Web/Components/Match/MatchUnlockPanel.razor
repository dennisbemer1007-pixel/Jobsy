@namespace Jobsy.Web.Components.Match
@using Jobsy.Core.Features
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Localization
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags

<div class="match-gate" aria-label="@Culture["Kb.Fit.Gate"]">
    @if (FitGateOnly)
    {
        <h2 class="match-gate__title">@Culture["Kb.Fit.Gate"]</h2>
        <p class="match-gate__lead">@Culture["Kb.Fit.GateMatch"]</p>
        <div class="match-gate__actions">
            <a class="match-page__cta" href="@KbRoutes.CultureTest">@Culture["Kb.Dna.Culture"]</a>
            <a class="match-page__cta match-page__cta--ghost" href="@KbRoutes.ValuesTest">@Culture["Kb.Dna.Values"]</a>
        </div>
        <p class="match-gate__hint">
            <a href="@KbRoutes.Map">@Culture["Discovery.BackToSearch"]</a>
        </p>
    }
    else if (!Gate.IsAuthenticated)
    {
        <h2 class="match-gate__title">Ontgrendel Match</h2>
        <p class="match-gate__lead">Log in als kandidaat en rond je startprofiel af om relevante vacatures te swipen.</p>
        <div class="match-gate__actions">
            <a class="match-page__cta" href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/match")}")">Inloggen</a>
            <a class="match-page__cta match-page__cta--ghost" href="@KbRoutes.Map">Naar de banenkaart</a>
        </div>
        <p class="match-gate__hint">@Culture["MatchUnlock.BanenkaartHint"]</p>
    }
    else
    {
        <h2 class="match-gate__title">@Culture["MatchUnlock.CompleteTitle"]</h2>
        <p class="match-gate__lead">@Culture["MatchUnlock.CompleteLead"]</p>
        <p class="match-gate__progress">@Gate.CompletedCount van @Gate.RequiredCount klaar</p>

        <ol class="whoami-checklist match-gate__checklist">
            <li class="@(Gate.ProfileBasicsFilled ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.ProfileBasicsFilled ? "✓" : "")</span>
                <div>
                    <strong>Basisgegevens</strong>
                    <p>@Culture["MatchUnlock.BasicsHint"]</p>
                    @if (!Gate.ProfileBasicsFilled)
                    {
                        <a class="engagement-btn" href="@_startPath">@Culture["MatchUnlock.ContinueStart"]</a>
                    }
                </div>
            </li>
            <li class="@(Gate.HasEducationLevel ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.HasEducationLevel ? "✓" : "")</span>
                <div>
                    <strong>Opleidingsniveau</strong>
                    <p>@Culture["MatchUnlock.EducationHint"]</p>
                    @if (!Gate.HasEducationLevel)
                    {
                        <a class="engagement-btn" href="@_startPath">@Culture["MatchUnlock.ContinueStart"]</a>
                    }
                </div>
            </li>
            <li class="@(Gate.WizardCompleted ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.WizardCompleted ? "✓" : "")</span>
                <div>
                    <strong>Startprofiel</strong>
                    <p>@Culture["MatchUnlock.WizardHint"]</p>
                    @if (!Gate.WizardCompleted)
                    {
                        <a class="engagement-btn" href="@_startPath">@Culture["MatchUnlock.StartOrResume"]</a>
                    }
                </div>
            </li>
        </ol>

        <p class="match-gate__hint">
            @Culture["MatchUnlock.BanenkaartHint"]
            <a href="@KbRoutes.Map">banenkaart</a>.
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public MatchProfileGateViewModel Gate { get; set; } = new();

    /// <summary>When true, only the culture/values fit gate is shown (D2).</summary>
    [Parameter]
    public bool FitGateOnly { get; set; }

    private string _startPath = OnboardingRoutes.ClassicStartPath;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var flags = await FeatureFlags.GetAsync();
            _startPath = OnboardingRoutes.StartPath(flags);
        }
        catch
        {
            _startPath = OnboardingRoutes.ClassicStartPath;
        }
    }
}
