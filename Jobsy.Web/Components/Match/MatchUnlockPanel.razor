@namespace Jobsy.Web.Components.Match
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@inject NavigationManager Navigation

<div class="match-gate" aria-label="Match ontgrendelen">
    @if (!Gate.IsAuthenticated)
    {
        <h2 class="match-gate__title">Ontgrendel Match</h2>
        <p class="match-gate__lead">Log in als kandidaat en rond je startprofiel af om relevante vacatures te swipen.</p>
        <div class="match-gate__actions">
            <a class="match-page__cta" href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/match")}")">Inloggen</a>
            <a class="match-page__cta match-page__cta--ghost" href="/">Naar de banenkaart</a>
        </div>
        <p class="match-gate__hint">
            Wil je breder zoeken of andere typen vacatures vinden? Ga dan naar de banenkaart.
        </p>
    }
    else
    {
        <h2 class="match-gate__title">Maak Match compleet</h2>
        <p class="match-gate__lead">
            Rond je startprofiel af (ongeveer 6 minuten) — daarna tonen we vacatures die bij jou passen.
            Opleiding mag <strong>Geen</strong> zijn.
        </p>
        <p class="match-gate__progress">@Gate.CompletedCount van @Gate.RequiredCount klaar</p>

        <ol class="whoami-checklist match-gate__checklist">
            <li class="@(Gate.ProfileBasicsFilled ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.ProfileBasicsFilled ? "✓" : "")</span>
                <div>
                    <strong>Basisgegevens</strong>
                    <p>Naam, beschikbaarheid en reistijd/vervoer</p>
                    @if (!Gate.ProfileBasicsFilled)
                    {
                        <a class="engagement-btn" href="/candidate/start">Verder met starten</a>
                    }
                </div>
            </li>
            <li class="@(Gate.HasEducationLevel ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.HasEducationLevel ? "✓" : "")</span>
                <div>
                    <strong>Opleidingsniveau</strong>
                    <p>Kies je niveau of <em>Geen</em></p>
                    @if (!Gate.HasEducationLevel)
                    {
                        <a class="engagement-btn" href="/candidate/start">Verder met starten</a>
                    }
                </div>
            </li>
            <li class="@(Gate.WizardCompleted ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(Gate.WizardCompleted ? "✓" : "")</span>
                <div>
                    <strong>Startprofiel</strong>
                    <p>Korte wizard met mini-tests voor je eerste indruk</p>
                    @if (!Gate.WizardCompleted)
                    {
                        <a class="engagement-btn" href="/candidate/start">Start of hervat</a>
                    }
                </div>
            </li>
        </ol>

        <p class="match-gate__hint">
            Wil je breder zoeken of andere typen vacatures vinden? Ga dan naar de
            <a href="/">banenkaart</a>.
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public MatchProfileGateViewModel Gate { get; set; } = new();
}
