@* Match swipe card — CSS translate/rotate, pointer gestures, no UI library. *@
@using Jobsy.Core.Rules.KandidaatBanen
@using Jobsy.Web.Models
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Components.KandidaatBanen
@inject CultureState Culture

@if (_visible && Model is not null)
{
    var isDialog = Variant == SwipeCardVariant.Dialog;
    var fit = BuildFit();
    var dnaRows = MatchDnaRows.Build(
        Model.FitDimensions,
        Model.FitWhyKinds,
        includeMissing: isDialog,
        maxWithData: 3);
    var rankLower = RankLowerLabel();
    var companyLine = CompanyLine();

    <div class="swipe-card-stage @(IsBackdrop ? "swipe-card-stage--backdrop" : null)">
        <article class="swipe-card @_animClass @(_dragging ? "is-dragging" : null) @(IsBackdrop ? "swipe-card--backdrop" : "swipe-card--enter") @(_lifting ? "is-lifting" : null) @(isDialog ? "swipe-card--dialog" : "swipe-card--mobile") @(Model.IsHiddenMode ? "swipe-card--hidden-mode" : null)"
                 style="@CardStyle"
                 data-testid="swipe-card"
                 @ontouchstart="OnPointerDown"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="OnPointerUp"
                 @ontouchcancel="OnPointerCancel"
                 @onpointerdown="OnMouseDown"
                 @onpointermove="OnMouseMove"
                 @onpointerup="OnMouseUp"
                 @onpointercancel="OnPointerCancel"
                 @onpointerleave="OnMouseLeave">
            <div class="swipe-card__photo">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt=""
                         loading="@(IsBackdrop ? "eager" : "lazy")" />
                }
                else
                {
                    <div class="swipe-card__photo-placeholder" aria-hidden="true"></div>
                }
                @if (!IsBackdrop && fit is not null)
                {
                    <div class="swipe-card__match-hero swipe-card__fit-overlay" title="@Culture["Match.Percentage"]">
                        <KbFitPill Fit="fit" />
                    </div>
                }
                @if (!IsBackdrop)
                {
                    <div class="swipe-card__stamp swipe-card__stamp--no @_stampNoClass" aria-hidden="true">@Culture["Match.StampNope"]</div>
                    <div class="swipe-card__stamp swipe-card__stamp--yes @_stampYesClass" aria-hidden="true">@Culture["Match.StampLike"]</div>
                }
            </div>

            <h2 class="swipe-card__title">@Model.JobTitle</h2>

            <p class="swipe-card__company">
                <span class="swipe-card__company-name">@companyLine</span>
                @if (!string.IsNullOrWhiteSpace(Model.LocationPrimary) && !Model.IsHiddenMode)
                {
                    <span class="swipe-card__company-loc"> · @Model.LocationPrimary</span>
                }
            </p>

            <div class="swipe-card__facts" role="group" aria-label="@Culture["Match.KeyFacts"]">
                <KbTravelTime Minutes="Model.TravelTimeMinutes"
                              Transport="Model.TransportMode"
                              ToBureau="Model.TravelToBureau" />
                @if (!string.IsNullOrWhiteSpace(Model.HoursPrimary))
                {
                    <span class="swipe-card__fact">
                        <span class="swipe-card__fact-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v5l3 2"/>
                            </svg>
                        </span>
                        <span>@Model.HoursPrimary @Culture["Kb.Match.HoursUnit"]</span>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SalaryPrimary))
                {
                    <span class="swipe-card__fact">
                        <span class="swipe-card__fact-icon" aria-hidden="true">€</span>
                        <span>@Model.SalaryPrimary</span>
                    </span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(rankLower))
            {
                <span class="kb-badges__chip kb-badges__chip--rank-lower" data-testid="kb-rank-lower">@rankLower</span>
            }

            @if (dnaRows.Count > 0 || !string.IsNullOrWhiteSpace(Model.WhyYouFit))
            {
                <div class="swipe-card__copy">
                    <div class="swipe-card__why" data-testid="swipe-why">
                        <span class="swipe-card__why-label">@Culture["Match.WhyYouFit"]</span>
                        @if (dnaRows.Count > 0)
                        {
                            <ul class="kb-dna kb-dna--match @(isDialog ? "kb-dna--match-dialog" : "kb-dna--match-mobile")" role="list">
                                @foreach (var row in dnaRows)
                                {
                                    <li class="kb-dna__row" data-dna="@row.Kind">
                                        <span class="kb-dna__label">@Culture[row.LabelKey]</span>
                                        @if (row.Percent is int barPct)
                                        {
                                            <progress class="kb-dna__progress" value="@barPct" max="100" aria-label="@Culture[row.LabelKey]">@barPct%</progress>
                                            <span class="kb-dna__reason">@Culture[row.WhyKey]</span>
                                        }
                                        else if (isDialog)
                                        {
                                            <a class="kb-dna__todo" href="@row.TestHref">@Culture["Kb.Dna.NotDone"]</a>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.WhyYouFit))
                        {
                            <p class="swipe-card__why-fallback">@Model.WhyYouFit</p>
                        }
                    </div>
                </div>
            }

            @if (Model.Tags.Count > 0)
            {
                <ul class="swipe-card__tags">
                    @foreach (var tag in Model.Tags.Take(isDialog ? 2 : 1))
                    {
                        <li>@tag</li>
                    }
                </ul>
            }
        </article>

        @if (!IsBackdrop)
        {
            <div class="swipe-actions @(isDialog ? "swipe-actions--dialog" : "swipe-actions--mobile")" role="group" aria-label="@Culture["Match.Actions"]">
                <button type="button"
                        class="swipe-actions__btn swipe-actions__btn--reject @(_pressedReject ? "is-pressed" : null)"
                        disabled="@_animating"
                        @onclick="() => SwipeAsync(SwipeDirection.Left)">
                    <span class="swipe-actions__circle" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M7 7l10 10M17 7 7 17"/>
                        </svg>
                    </span>
                    <span class="swipe-actions__label">@Culture["Match.Reject"]</span>
                </button>
                <button type="button"
                        class="swipe-actions__btn swipe-actions__btn--more"
                        disabled="@_animating"
                        @onclick="RaiseMoreInfoAsync"
                        @onclick:stopPropagation="true">
                    <span class="swipe-actions__circle swipe-actions__circle--ghost" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 6h10M4 12h10M4 18h7"/>
                            <path d="m14 9 5 3-5 3"/>
                        </svg>
                    </span>
                    <span class="swipe-actions__label">@Culture["Match.MoreInfo"]</span>
                </button>
                <button type="button"
                        class="swipe-actions__btn swipe-actions__btn--interest @(_pressedInterest ? "is-pressed" : null)"
                        disabled="@_animating"
                        @onclick="() => SwipeAsync(SwipeDirection.Right)">
                    <span class="swipe-actions__circle" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 16c1.5-1 3-1.5 5-1.5s3.5.5 5 1.5"/>
                            <path d="M8 10h.01M16 10h.01"/>
                            <path d="M6 8c0-2.5 2.2-4.5 6-4.5s6 2 6 4.5v2.2c0 1.3-.6 2.4-1.6 3.1L12 18l-4.4-4.7C6.6 12.6 6 11.5 6 10.2V8z"/>
                        </svg>
                    </span>
                    <span class="swipe-actions__label">@Culture["Match.Interest"]</span>
                </button>
            </div>
        }
    </div>
}

@code {
    private bool _visible = true;
    private bool _animating;
    private bool _dragging;
    private bool _lifting;
    private bool _pointerActive;
    private bool _pressedReject;
    private bool _pressedInterest;
    private double _dragX;
    private double _dragY;
    private double _startX;
    private double _startY;
    private string _animClass = "";
    private string _stampNoClass = "";
    private string _stampYesClass = "";

    [Parameter] public SwipeViewModel? Model { get; set; }

    /// <summary>When true, card sits under the active card (no gestures / actions).</summary>
    [Parameter] public bool IsBackdrop { get; set; }

    /// <summary>Mobile keeps current markup; Dialog adds BEM modifiers for the desktop match dialog.</summary>
    [Parameter] public SwipeCardVariant Variant { get; set; } = SwipeCardVariant.Mobile;

    /// <summary>Swipe animation duration in milliseconds (default 280).</summary>
    [Parameter] public int AnimationDurationMs { get; set; } = 280;

    /// <summary>Horizontal drag distance (px) required to commit a swipe.</summary>
    [Parameter] public int SwipeThresholdPx { get; set; } = 100;

    [Parameter] public EventCallback<SwipeViewModel> OnReject { get; set; }
    [Parameter] public EventCallback<SwipeViewModel> OnInterest { get; set; }
    [Parameter] public EventCallback<SwipeViewModel> OnMoreInfo { get; set; }
    [Parameter] public EventCallback<(SwipeViewModel Model, SwipeDirection Direction)> OnSwipeComplete { get; set; }

    /// <summary>Public entry for keyboard / dialog triggers (same animation as click/drag).</summary>
    public Task SwipeAsync(SwipeDirection direction) => SwipeInternalAsync(direction);

    private KbFitView? BuildFit()
    {
        if (Model is null)
        {
            return null;
        }

        if (string.Equals(Model.FitGate, CandidateFitApply.FitGateClosed, StringComparison.OrdinalIgnoreCase))
        {
            return new KbFitView(GateOpen: false, Percent: null, Band: null);
        }

        if (!Model.ShowMatchPercentage || Model.MatchPercentage is not int pct)
        {
            return null;
        }

        var band = Enum.TryParse<Jobsy.Core.Rules.KbFitBand>(Model.FitBand, ignoreCase: true, out var parsed)
            ? parsed
            : Jobsy.Core.Rules.KandidaatBanen.CandidateFitDisplay.BandFor(pct);
        return new KbFitView(GateOpen: true, Percent: pct, Band: band);
    }

    private string? RankLowerLabel()
    {
        if (Model is null || string.IsNullOrWhiteSpace(Model.RankLowerReason))
        {
            return null;
        }

        var reason = Culture[Model.RankLowerReason];
        if (string.IsNullOrWhiteSpace(reason) || reason == Model.RankLowerReason)
        {
            var slash = Model.RankLowerReason.LastIndexOf('.');
            reason = slash >= 0 ? Model.RankLowerReason[(slash + 1)..] : Model.RankLowerReason;
        }

        return string.Format(Culture["Kb.Rank.Lower"], reason);
    }

    private string CompanyLine()
    {
        if (Model is null)
        {
            return Culture["Match.CompanyFallback"];
        }

        if (Model.IsHiddenMode)
        {
            return string.Format(Culture["Kb.Via.Bureau"], Model.CompanyName);
        }

        return string.IsNullOrWhiteSpace(Model.CompanyName)
            ? Culture["Match.CompanyFallback"]
            : Model.CompanyName;
    }

    private string CardStyle
    {
        get
        {
            var duration = Math.Clamp(AnimationDurationMs, 0, 1200);
            if (IsBackdrop)
            {
                return "transition: none;";
            }

            if (_dragging || (_pointerActive && !_animating))
            {
                var lift = Math.Clamp(Math.Abs(_dragX) / 140.0, 0, 1);
                var rotate = Math.Clamp(_dragX / 14.0, -12, 12);
                var y = _dragY - (lift * 6);
                var blur = 22 + (lift * 28);
                var spreadY = 10 + (lift * 18);
                var alpha = 0.12 + (lift * 0.18);
                return $"transform: translate3d({_dragX:0.##}px, {y:0.##}px, 0) rotate({rotate:0.##}deg) scale({1 + lift * 0.02:0.###}); " +
                       $"box-shadow: 0 {spreadY:0.##}px {blur:0.##}px rgba(18, 32, 51, {alpha:0.###}); " +
                       $"transition: none; --swipe-duration: {duration}ms; --swipe-lift: {lift:0.###};";
            }

            return $"--swipe-duration: {duration}ms;";
        }
    }

    protected override void OnParametersSet()
    {
        if (IsBackdrop)
        {
            _visible = Model is not null;
            return;
        }

        _visible = Model is not null;
        if (!_animating)
        {
            _animClass = "";
            _stampNoClass = "";
            _stampYesClass = "";
            _dragX = 0;
            _dragY = 0;
        }
    }

    private async Task RaiseMoreInfoAsync()
    {
        if (IsBackdrop || _animating || Model is null)
        {
            return;
        }

        await OnMoreInfo.InvokeAsync(Model);
    }

    private Task SwipeInternalAsync(SwipeDirection direction) => SwipeCoreAsync(direction);

    private async Task SwipeCoreAsync(SwipeDirection direction)
    {
        if (IsBackdrop || _animating || Model is null)
        {
            return;
        }

        _animating = true;
        _dragging = false;
        _lifting = false;
        _pointerActive = false;
        _dragX = 0;
        _dragY = 0;

        var model = Model;
        if (direction == SwipeDirection.Left)
        {
            _pressedReject = true;
            _animClass = "swipe-card--out-left";
            _stampNoClass = "is-on";
            _ = OnReject.InvokeAsync(model);
        }
        else
        {
            _pressedInterest = true;
            _animClass = "swipe-card--out-right";
            _stampYesClass = "is-on";
            _ = OnInterest.InvokeAsync(model);
        }

        StateHasChanged();
        var ms = Math.Clamp(AnimationDurationMs, 120, 1200);
        await Task.Delay(ms);
        _pressedReject = false;
        _pressedInterest = false;

        _visible = false;
        _animating = false;
        _animClass = "";
        _stampNoClass = "";
        _stampYesClass = "";
        await OnSwipeComplete.InvokeAsync((model, direction));
    }

    private void OnPointerDown(TouchEventArgs e)
    {
        if (IsBackdrop || _animating || e.Touches.Length == 0)
        {
            return;
        }

        BeginDrag(e.Touches[0].ClientX, e.Touches[0].ClientY);
    }

    private void OnTouchMove(TouchEventArgs e)
    {
        if (!_pointerActive || e.Touches.Length == 0)
        {
            return;
        }

        MoveDrag(e.Touches[0].ClientX, e.Touches[0].ClientY);
    }

    private async Task OnPointerUp(TouchEventArgs e) => await EndDragAsync();

    private void OnMouseDown(PointerEventArgs e)
    {
        if (IsBackdrop || _animating || e.Button != 0)
        {
            return;
        }

        BeginDrag(e.ClientX, e.ClientY);
    }

    private void OnMouseMove(PointerEventArgs e)
    {
        if (!_pointerActive)
        {
            return;
        }

        MoveDrag(e.ClientX, e.ClientY);
    }

    private async Task OnMouseUp(PointerEventArgs e) => await EndDragAsync();

    private async Task OnMouseLeave(PointerEventArgs e)
    {
        if (_pointerActive)
        {
            await EndDragAsync();
        }
    }

    private void OnPointerCancel()
    {
        _pointerActive = false;
        _dragging = false;
        _lifting = false;
        _dragX = 0;
        _dragY = 0;
        _stampNoClass = "";
        _stampYesClass = "";
    }

    private void BeginDrag(double x, double y)
    {
        _pointerActive = true;
        _dragging = true;
        _lifting = true;
        _startX = x;
        _startY = y;
        _dragX = 0;
        _dragY = 0;
    }

    private void MoveDrag(double x, double y)
    {
        _dragX = x - _startX;
        _dragY = (y - _startY) * 0.35;
        _lifting = true;
        _stampNoClass = _dragX < -40 ? "is-on" : "";
        _stampYesClass = _dragX > 40 ? "is-on" : "";
    }

    private async Task EndDragAsync()
    {
        if (!_pointerActive)
        {
            return;
        }

        _pointerActive = false;
        _dragging = false;
        _lifting = false;

        if (Math.Abs(_dragX) >= SwipeThresholdPx)
        {
            var direction = _dragX < 0 ? SwipeDirection.Left : SwipeDirection.Right;
            await SwipeAsync(direction);
            return;
        }

        _dragX = 0;
        _dragY = 0;
        _stampNoClass = "";
        _stampYesClass = "";
    }
}
