@namespace Jobsy.Web.Components
@using Jobsy.Web.Media
@using Jobsy.Web.Localization
@inject CultureState Culture
@using Jobsy.Web.Navigation
@implements IDisposable
@inject NavigationManager Navigation
@inject CoachTipBus Tips
@inject AssistantChatHost ChatHost
@inject IJSRuntime Js

<div @ref="_dock"
     class="lobsy-coach-dock lobsy-coach-dock--variant-b @(Compact ? "lobsy-coach-dock--compact" : null) @(HasBottomNav ? "lobsy-coach-dock--has-nav" : null) @(ChatHost.IsOpen ? "lobsy-coach-dock--chat-open" : null)"
     data-lobsy-coach
     data-ssr-coach="business">
    @if (_showTip && !string.IsNullOrWhiteSpace(_tip))
    {
        <div class="lobsy-coach-dock__tip" role="status">
            <p>@_tip</p>
            <ReadAloudButton Text="@_tip" SpeechKey="@($"coach-tip-{_routeKey}")" />
            <button type="button" class="lobsy-coach-dock__close" @onclick="DismissTipAsync" aria-label="@CloseLabel">×</button>
        </div>
    }
    <p class="lobsy-coach-dock__teaser" data-ob-coach-bubble role="status">@Culture["Coach.OnboardingBubble"]</p>
    <button type="button"
            id="lobsy-coach-btn"
            class="lobsy-coach-dock__btn lobsy-coach-dock__btn--lobster-b"
            @onclick="OpenChat"
            aria-label="@Culture["Coach.OpenOnboarding"]"
            aria-haspopup="dialog"
            aria-expanded="@(ChatHost.IsOpen ? "true" : "false")"
            aria-controls="lobsy-assistant-panel">
        <img class="lobsy-coach-dock__lobster"
             src="@BrandImages.AbsoluteCoachB"
             alt="@Culture["Coach.LobsterAlt"]"
             width="165"
             height="250"
             decoding="async" />
    </button>
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool HasBottomNav { get; set; }
    [Parameter] public string AskLabel { get; set; } = "Lobsy-hulp";
    [Parameter] public string CloseLabel { get; set; } = "Tip sluiten";

    private string? _tip;
    private bool _showTip;
    private string _routeKey = "";
    private ElementReference _dock;

    protected override void OnInitialized()
    {
        Tips.Changed += OnTipChanged;
        ChatHost.Changed += OnChatChanged;
        Navigation.LocationChanged += OnLocationChanged;
        ApplyTip();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyTip();
        if (Compact)
        {
            _showTip = false;
            return;
        }

        await RefreshDismissedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await Js.InvokeVoidAsync("jobsyCoachDock.syncClearance", _dock);
        }
        catch
        {
            // Map controls keep the CSS fallback clearance when JS is blocked.
        }

        if (Compact || !_showTip)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("jobsyCoachDock.placeTip", _dock);
            await Js.InvokeVoidAsync("jobsyCoachDock.bindScrollDismiss", _dock);
        }
        catch
        {
            // Layout still keeps the tip above the lobster when JS is blocked.
        }
    }

    public void Dispose()
    {
        Tips.Changed -= OnTipChanged;
        ChatHost.Changed -= OnChatChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnChatChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnTipChanged() => _ = InvokeAsync(async () =>
    {
        ApplyTip();
        await RefreshDismissedAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        ApplyTip();
        await RefreshDismissedAsync();
        StateHasChanged();
    });

    private void ApplyTip()
    {
        var here = Navigation.Uri;
        _routeKey = RouteKey(here);
        _tip = Tips.Route is not null && SameRoute(Tips.Route, here) ? Tips.Tip : null;
        if (Compact || string.IsNullOrWhiteSpace(_tip))
        {
            _showTip = false;
        }
    }

    private async Task RefreshDismissedAsync()
    {
        if (Compact || string.IsNullOrWhiteSpace(_tip))
        {
            _showTip = false;
            return;
        }

        try
        {
            var dismissed = await Js.InvokeAsync<bool>("jobsyCoachDock.tipDismissed", _routeKey);
            _showTip = !dismissed;
        }
        catch
        {
            _showTip = true;
        }
    }

    private async Task DismissTipAsync()
    {
        _showTip = false;
        try
        {
            await Js.InvokeVoidAsync("jobsyCoachDock.dismissTip", _routeKey);
        }
        catch
        {
            // Remembered for this circuit only when storage is blocked.
        }
    }

    private void OpenChat() => ChatHost.RequestToggle();

    private static string RouteKey(string uri)
    {
        if (!Uri.TryCreate(uri, UriKind.Absolute, out var parsed))
        {
            return uri;
        }

        return parsed.AbsolutePath.TrimEnd('/').ToLowerInvariant();
    }

    private static bool SameRoute(string published, string current)
        => string.Equals(RouteKey(published), RouteKey(current), StringComparison.Ordinal);
}
