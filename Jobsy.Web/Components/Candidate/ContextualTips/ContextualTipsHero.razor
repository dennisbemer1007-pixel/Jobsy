@namespace Jobsy.Web.Components.Candidate.ContextualTips
@using Jobsy.Web.Components.Candidate
@using static Jobsy.Web.Media.CandidateIllustratedImages

<CandidateIllustratedHero Eyebrow="@Eyebrow"
                          Title="@Title"
                          Lead="@Lead"
                          CoralEyebrow="@CoralEyebrow"
                          ArtUrl="@TipsMomentHeroWide"
                          ArtUrlMobile="@TipsMomentHeroMobilePanel"
                          ArtPosition="right center"
                          CssClass="@HeroCssClass" />

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public bool CoralEyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? ExtraCssClass { get; set; }

    private string HeroCssClass =>
        string.IsNullOrWhiteSpace(ExtraCssClass)
            ? "cand-hero--profession-band cand-hero--tips-moment"
            : $"cand-hero--profession-band cand-hero--tips-moment {ExtraCssClass}";
}
