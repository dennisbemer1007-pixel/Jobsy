@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<CandidateIllustratedHero Title="@Greeting"
                        Lead="@Culture["Kompas.Greeting.Lead"]"
                        ArtUrl="@CandidateIllustratedImages.KompasMedallions"
                        ArtPosition="62% center" />

@code {
    [Parameter] public string? FirstName { get; set; }

    private string Greeting
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(FirstName) ? "" : FirstName.Trim();
            var hour = DateTime.Now.Hour;
            if (string.IsNullOrEmpty(name))
            {
                return hour switch
                {
                    < 12 => Culture["Kompas.Greeting.PlainMorning"],
                    < 18 => Culture["Kompas.Greeting.PlainAfternoon"],
                    _ => Culture["Kompas.Greeting.PlainEvening"]
                };
            }

            var key = hour switch
            {
                < 12 => "Kompas.Greeting.Morning",
                < 18 => "Kompas.Greeting.Afternoon",
                _ => "Kompas.Greeting.Evening"
            };
            return Culture.Format(key, name);
        }
    }
}
