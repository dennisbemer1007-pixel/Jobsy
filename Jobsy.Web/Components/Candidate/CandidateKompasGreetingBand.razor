@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<CandidateIllustratedHero Title="@Greeting"
                        Lead="@Culture["Kompas.Greeting.Lead"]"
                        ArtUrl="@CandidateIllustratedImages.KompasHeroWide"
                        ArtPosition="right center"
                        CssClass="cand-hero--profession-band cand-hero--kompas-band" />

@code {
    [Parameter] public string? FirstName { get; set; }

    private string Greeting
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(FirstName) ? "" : FirstName.Trim();
            var hour = DateTime.Now.Hour;
            if (string.IsNullOrEmpty(name))
            {
                if (hour < 12)
                {
                    return Culture["Kompas.Greeting.PlainMorning"];
                }

                if (hour < 18)
                {
                    return Culture["Kompas.Greeting.PlainAfternoon"];
                }

                return Culture["Kompas.Greeting.PlainEvening"];
            }

            if (hour < 12)
            {
                return Culture.Format("Kompas.Greeting.Morning", name);
            }

            if (hour < 18)
            {
                return Culture.Format("Kompas.Greeting.Afternoon", name);
            }

            return Culture.Format("Kompas.Greeting.Evening", name);
        }
    }
}
