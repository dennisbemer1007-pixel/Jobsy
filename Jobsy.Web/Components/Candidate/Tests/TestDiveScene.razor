@namespace Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Passport

<div class="test-dive-scene @(Mobile ?"test-dive-scene--mobile" : "test-dive-scene--desktop") @(Deep ? "test-dive-scene--deep" : null) @(Celebrate ? "test-dive-scene--celebrate" : null)"
     style="@GeometryStyle"
     aria-hidden="true">
    <div class="test-dive-scene__bg journey-scene journey-scene--depth-@SceneDepth"></div>
    <div class="test-dive-scene__ruler">
        @foreach (var band in RulerBands)
        {
            var pct = band.Count <= 0 ? 0 : Math.Min(100, band.Count * 100.0 / Math.Max(Target, 1));
            <span class="test-dive-scene__tick" style="--y:@pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
        }
    </div>
    @if (FallingShard)
    {
        <div class="test-dive-scene__shard @(Celebrate ?"is-falling" : "is-resting")"></div>
    }
    @if (!string.IsNullOrWhiteSpace(BubbleText))
    {
        <LobsyBubble Text="@BubbleText" Variant="LobsyBubble.BubbleVariant.Scene" />
    }
</div>

@code {
    [Parameter] public AssessmentKind Kind { get; set; }
    [Parameter] public int Answered { get; set; }
    [Parameter] public int Target { get; set; } = 25;
    [Parameter] public bool Deep { get; set; }
    [Parameter] public bool Mobile { get; set; }
    [Parameter] public bool Celebrate { get; set; }
    [Parameter] public bool FallingShard { get; set; }
    [Parameter] public int PlatesShed { get; set; }
    [Parameter] public bool NewShell { get; set; }
    [Parameter] public string? BubbleText { get; set; }

    private int SceneDepth
    {
        get
        {
            if (Deep) return 10;
            var reached = TestDepthRules.Reached(Kind, Answered);
            return reached is null
                ? 8
                : TestDepthRules.SceneDepth(reached.Value);
        }
    }

    private IReadOnlyList<TestDepthBand> RulerBands
        => Deep
            ? TestDepthRules.Parts(Kind).Select(p => new TestDepthBand(TestDepthLevel.Bottom, p.Size)).ToList()
            : TestDepthRules.Levels(Kind);

    private double LobsterY
    {
        get
        {
            var t = Math.Max(Target, 1);
            return Math.Clamp(Answered * 100.0 / t, 0, 100);
        }
    }

    private string GeometryStyle
        => Mobile
            ? "--scene-w:390;--scene-h:170"
            : "--scene-w:auto;--scene-h:100%";
}
