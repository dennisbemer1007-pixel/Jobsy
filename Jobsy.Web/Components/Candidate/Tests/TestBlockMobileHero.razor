@namespace Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Core.Rules

<div class="test-block-stage__mobile-hero @CssClass">
    @ChildContent
</div>

@code {
    [CascadingParameter(Name = "TestBlockArtSlug")]
    public string? BlockSlug { get; set; }

    [Parameter] public string CssClass { get; set; } = "test-block-stage__mobile-hero--band";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
