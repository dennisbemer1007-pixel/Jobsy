@namespace Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Core.Rules

@if (Enabled)
{
    <CascadingValue Value="true" Name="TestBlockStageActive">
        <div class="test-block-stage test-block-stage--@Slug" data-testid="test-block-stage" data-block="@Slug">
            <div class="test-block-stage__content">
                @ChildContent
            </div>
        </div>
    </CascadingValue>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public string Slug { get; set; } = TestBlockArt.SlugForFamily(TestBlockFamily.HoeJeWerkt);
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
