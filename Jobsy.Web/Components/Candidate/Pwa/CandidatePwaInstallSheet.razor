@namespace Jobsy.Web.Components.Candidate.Pwa
@using Jobsy.Web.Localization
@using Jobsy.Web.Pwa
@inject CultureState Culture
@inject IJSRuntime Js

@if (_open)
{
    <div class="pwa-entry-sheet-backdrop" data-testid="pwa-install-sheet-backdrop" @onclick="Close"></div>
    <div class="pwa-entry-sheet @(_platform == PwaEntryPlatform.Ios ? "pwa-entry-sheet--ios" : "pwa-entry-sheet--samsung")"
         role="dialog"
         aria-modal="true"
         aria-labelledby="pwa-entry-sheet-title"
         data-testid="pwa-install-sheet">
        <div class="pwa-entry-sheet__header">
            <h2 id="pwa-entry-sheet-title" class="pwa-entry-sheet__title">
                @if (_platform == PwaEntryPlatform.Ios)
                {
                    @Culture["Pwa.Sheet.Ios.Title"]
                }
                else
                {
                    @Culture["Pwa.Sheet.Samsung.Title"]
                }
            </h2>
            <button type="button" class="share-modal__close" @onclick="Close" aria-label="@Culture["Pwa.Sheet.Close"]">×</button>
        </div>
        <div class="pwa-entry-sheet__body">
            @if (_platform == PwaEntryPlatform.Ios)
            {
                <p class="pwa-entry-sheet__lead">@Culture["Pwa.Sheet.Ios.Lead"]</p>
                <ol class="pwa-entry-sheet__steps">
                    <li>@Culture["Pwa.Sheet.Ios.Step1"]</li>
                    <li>@Culture["Pwa.Sheet.Ios.Step2"]</li>
                </ol>
            }
            else
            {
                <p class="pwa-entry-sheet__lead">@Culture["Pwa.Sheet.Samsung.Lead"]</p>
                @if (!string.IsNullOrWhiteSpace(_chromeIntentUrl))
                {
                    <a class="login-submit pwa-entry-sheet__primary"
                       href="@_chromeIntentUrl"
                       data-testid="pwa-open-chrome">
                        @Culture["Pwa.Sheet.Samsung.OpenChrome"]
                    </a>
                }
                <button type="button" class="engagement-btn pwa-entry-sheet__secondary" @onclick="CopyLinkAsync">
                    @Culture["Pwa.Sheet.Samsung.CopyLink"]
                </button>
                @if (!string.IsNullOrWhiteSpace(_copyMessage))
                {
                    <p class="pwa-entry-sheet__msg" role="status">@_copyMessage</p>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public PwaEntryPlatform Platform { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _open;
    private PwaEntryPlatform _platform;
    private string? _chromeIntentUrl;
    private string? _copyMessage;

    public async Task OpenAsync(PwaEntryPlatform platform)
    {
        _platform = platform;
        _copyMessage = null;
        if (platform == PwaEntryPlatform.Samsung)
        {
            try
            {
                _chromeIntentUrl = await Js.InvokeAsync<string>("lobsyPwaInstall.buildChromeIntentUrl");
            }
            catch
            {
                _chromeIntentUrl = null;
            }
        }

        _open = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Close()
    {
        _open = false;
        await OnClosed.InvokeAsync();
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            var result = await Js.InvokeAsync<CopyResult>("lobsyPwaInstall.copyPageLink");
            _copyMessage = result?.Ok == true
                ? Culture["Pwa.Sheet.Samsung.LinkCopied"]
                : Culture["Share.CopiedMsg"];
        }
        catch
        {
            _copyMessage = Culture["Share.CopiedMsg"];
        }
    }

    private sealed class CopyResult
    {
        public bool Ok { get; set; }
        public string? Url { get; set; }
    }
}
