@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<section class="cand-apply-tip" aria-labelledby="@_titleId">
    <div class="cand-apply-tip__copy">
        <h2 id="@_titleId" class="cand-apply-tip__title">@Culture["Kb.Apps.ApplyTip.Title"]</h2>
        <p class="cand-apply-tip__body">@Culture["Kb.Apps.ApplyTip.Body"]</p>
    </div>
    <div class="cand-apply-tip__art" style="@($"background-image:url('{CandidateIllustratedImages.SpotOpleiding}')")" aria-hidden="true"></div>
</section>

@code {
    private readonly string _titleId = "cand-apply-tip-" + Guid.NewGuid().ToString("N")[..8];
}
