@namespace Jobsy.Web.Components.Candidate.Career
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@inject CultureState Culture

@{
    var nodes = BuildNodes();
    var pathD = BuildPath(nodes.Count);
}

<nav class="career-path-svg" aria-label="@Culture["Career.Illustrated.PathAria"]">
    <svg class="career-path-svg__curve" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true">
        <path class="career-path-svg__track" d="@pathD" pathLength="100" />
        <path class="career-path-svg__track career-path-svg__track--done" d="@pathD" pathLength="100"
              style="stroke-dasharray: @DoneDash; stroke-dashoffset: 0" />
    </svg>
    <ol class="career-path-svg__nodes">
        @for (var i = 0; i < nodes.Count; i++)
        {
            var node = nodes[i];
            var left = NodeLeftPercent(i, nodes.Count);
            <li class="career-path-svg__node career-path-svg__node--@node.State"
                style="--node-x:@(left.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">
                <span class="career-path-svg__pin" aria-hidden="true">
                    @if (node.Kind == NodeKind.Dream)
                    {
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                            <path d="M8 1.5l1.9 4 4.4.6-3.2 3.1.8 4.3L8 11.5l-3.9 2 .8-4.3L1.7 6.1l4.4-.6z" />
                        </svg>
                    }
                    else if (node.Kind == NodeKind.Now)
                    {
                        <span class="career-path-svg__dot"></span>
                    }
                    else if (node.State == "done")
                    {
                        <span aria-hidden="true">✓</span>
                    }
                    else
                    {
                        <span>@node.Order</span>
                    }
                </span>
                <span class="career-path-svg__label">@node.Label</span>
                @if (!string.IsNullOrWhiteSpace(node.Sub))
                {
                    <span class="career-path-svg__sub">@node.Sub</span>
                }
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter] public CareerPlanViewModel Plan { get; set; } = CareerPlanViewModel.Empty;
    [Parameter] public string NowLabel { get; set; } = "";

    private enum NodeKind { Now, Step, Dream }

    private sealed record PathNode(NodeKind Kind, string State, string Label, string Sub, int Order);

    private string DoneDash
    {
        get
        {
            var nodes = BuildNodes();
            if (nodes.Count <= 1)
            {
                return "0 100";
            }

            var currentIndex = nodes.FindIndex(n => n.State == "current");
            if (currentIndex < 0)
            {
                var allDone = nodes.All(n => n.State is "done" or "dream" && Plan.GoalReached);
                return allDone ? "100 100" : "0 100";
            }

            var pct = (currentIndex / (double)(nodes.Count - 1)) * 100;
            return $"{pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} 100";
        }
    }

    private List<PathNode> BuildNodes()
    {
        var list = new List<PathNode>
        {
            new(
                NodeKind.Now,
                "done",
                Culture["Career.Rail.Now"],
                string.IsNullOrWhiteSpace(NowLabel) ? Culture["Career.Rail.NowUnknown"] : NowLabel,
                0)
        };

        foreach (var step in Plan.Steps)
        {
            var state = step.Status switch
            {
                CareerStepStatus.Completed => "done",
                CareerStepStatus.Active => "current",
                _ => "todo"
            };
            list.Add(new(NodeKind.Step, state, Culture.Format("Career.Illustrated.StepN", step.Order), step.ShortTitle, step.Order));
        }

        list.Add(new(
            NodeKind.Dream,
            Plan.GoalReached ? "done" : "goal",
            Culture["Career.Stepper.Goal"],
            Plan.DreamTitle,
            Plan.Steps.Count + 1));

        return list;
    }

    private static double NodeLeftPercent(int index, int count)
    {
        if (count <= 1)
        {
            return 50;
        }

        const double pad = 6;
        return pad + (100 - pad * 2) * index / (count - 1);
    }

    private static string BuildPath(int count)
    {
        if (count <= 1)
        {
            return "M 50 90 L 950 90";
        }

        var parts = new List<string> { "M 40 95" };
        for (var i = 1; i < count; i++)
        {
            var x = 40 + (920.0 * i / (count - 1));
            var y = 95 - (i % 2 == 0 ? 28 : 12) - (i == count - 1 ? 8 : 0);
            parts.Add($"L {x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} {y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}");
        }

        return string.Join(' ', parts);
    }
}
