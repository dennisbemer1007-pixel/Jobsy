@namespace Jobsy.Web.Components.Pages.Candidate
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags

@if (Compass is null)
{
    return;
}

@if (Compass.Strengths.Count > 0)
{
    <p class="login-lead">@Culture["Kompas.CareerStrengths"]: @string.Join(" · ", Compass.Strengths)</p>
}

@if (Compass.HasOccupations)
{
    <div class="kompas-occupations" aria-label="@Culture["Kompas.Career"]">
        @if (GoalHits.Count > 0)
        {
            <section class="kompas-band kompas-band--goal">
                <h4>@Culture["Kompas.GoalRow"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var hit in GoalHits)
                    {
                        <li>@hit.Title</li>
                    }
                </ul>
                @if (EducationFlags.Count > 0)
                {
                    <p class="muted">@Culture["Kompas.EducationAbove"]: @string.Join(", ", EducationFlags.Take(4))</p>
                }
            </section>
        }
        @if (SuperForCandidate.Count > 0)
        {
            <section class="kompas-band kompas-band--super">
                <h4>@Culture["Kompas.BandSuper"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in SuperForCandidate)
                    {
                        @OccupationAccordion(item)
                    }
                </ul>
            </section>
        }
        @if (StrongForCandidate.Count > 0)
        {
            <section class="kompas-band kompas-band--strong">
                <h4>@Culture["Kompas.BandStrong"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in StrongForCandidate)
                    {
                        @OccupationAccordion(item)
                    }
                </ul>
            </section>
        }
        @if (Compass.Broadening.Count > 0)
        {
            <section class="kompas-band kompas-band--broaden">
                <h4>@Culture["Kompas.BandBroaden"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in Compass.Broadening)
                    {
                        @OccupationAccordion(item)
                    }
                </ul>
            </section>
        }
    </div>
}

@if (!Compass.HasOccupations)
{
    <div class="kompas-practical">
        <p>@Culture[CareerCompassSnapshot.EmptyNoteKey]</p>
    </div>
}
else if (VisibleNotes.Count > 0 || !_employersOn)
{
    <div class="kompas-practical">
        @foreach (var note in VisibleNotes)
        {
            <p>@note</p>
        }
        @if (!_employersOn)
        {
            <p>@Culture["Kompas.PracticalEmployersOff"]</p>
        }
    </div>
}

@code {
    [Parameter] public CareerCompassModel? Compass { get; set; }
    [Parameter] public CompetencyScoreSet? Competencies { get; set; }
    [Parameter] public string? DreamTitle { get; set; }
    [Parameter] public string? GoalEvidence { get; set; }
    [Parameter] public string? EducationLabel { get; set; }

    private IReadOnlyList<string> OccupationTitles =>
        (Compass?.SuperMatches ?? []).Select(m => m.Title)
            .Concat((Compass?.StrongChoices ?? []).Select(m => m.Title))
            .Concat((Compass?.Broadening ?? []).Select(m => m.Title))
            .Concat(CareerGoalFit.DreamTitles(DreamTitle))
            .ToList();

    private IReadOnlyList<CareerGoalFit.Hit> GoalHits =>
        CareerGoalFit.Pick(OccupationTitles, DreamTitle, GoalEvidence, EducationLabel);

    private List<CareerOccupationMatchModel> SuperForCandidate =>
        (Compass?.SuperMatches ?? [])
            .Where(item => CareerGoalFit.BelongsInSuper(item.Title, item.Percent, EducationLabel))
            .ToList();

    private List<CareerOccupationMatchModel> StrongForCandidate =>
        (Compass?.SuperMatches ?? [])
            .Where(item => !CareerGoalFit.BelongsInSuper(item.Title, item.Percent, EducationLabel))
            .Concat(Compass?.StrongChoices ?? [])
            .ToList();

    private IReadOnlyList<string> EducationFlags =>
        CareerGoalFit.AboveEducation(OccupationTitles, EducationLabel);

    private bool _employersOn = true;

    private IReadOnlyList<string> VisibleNotes =>
        CareerCompassBuilder.NotesForCandidate(Compass?.PracticalNotes ?? [], _employersOn);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _employersOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.Employers);
        }
        catch (Exception)
        {
            _employersOn = true;
        }
    }

    private RenderFragment OccupationAccordion(CareerOccupationMatchModel item) => __builder =>
    {
        <li class="kompas-occupation">
            <details class="kompas-occupation__details">
                <summary>
                    <span class="kompas-occupation__title">@item.Title</span>
                    @if (CareerGoalFit.RequiresHigherEducation(item.Title, EducationLabel))
                    {
                        <span class="muted">@Culture["Kompas.EducationAbove"]</span>
                    }
                    <span class="kompas-occupation__pct">@CareerGoalFit.DisplayPercent(item.Title, item.Percent, EducationLabel)%</span>
                </summary>
                @OccupationBody(item)
            </details>
        </li>
    };

    private RenderFragment OccupationBody(CareerOccupationMatchModel item) => __builder =>
    {
        var insight = BuildInsight(item.Title);
        <div class="kompas-occupation__body">
            @if (!string.IsNullOrWhiteSpace(item.Why))
            {
                <p class="kompas-occupation__why">@item.Why</p>
            }
            @if (insight is not null)
            {
                <h5>@Culture["Fit.Step2"]</h5>
                <ul>
                    @foreach (var line in insight.Strengths.Take(3))
                    {
                        <li>@line</li>
                    }
                </ul>
                <h5>@Culture["Fit.Step3"]</h5>
                <ul>
                    @foreach (var line in insight.Gaps.Take(3))
                    {
                        <li>@line</li>
                    }
                </ul>
            }
            <h5>@Culture["Fit.FormalBlock"]</h5>
            <ul>
                @foreach (var line in CareerOccupationDetail.Requirements(item.Title))
                {
                    <li>@line</li>
                }
            </ul>
            <TrainingOffersBlock JobTitle="@item.Title" Campaign="career_compass" Compact="true" />
        </div>
    };
}
