@namespace Jobsy.Web.Components.Candidate.Passport
@using Jobsy.Web.Navigation
@inject NavigationManager Navigation
@inject IServiceProvider Services

@*
    The page tip now lives in the one coach widget. This component only publishes
    the sentence; it no longer draws a second lobster.
*@

@if (!string.IsNullOrWhiteSpace(Text))
{
    <span class="visually-hidden">@Text</span>
}

@code {
    public enum BubbleVariant
    {
        Inline = 0,
        Scene = 1
    }

    [Parameter] public string Text { get; set; } = "";
    [Parameter] public BubbleVariant Variant { get; set; } = BubbleVariant.Inline;

    protected override void OnParametersSet()
    {
        if (Services.GetService(typeof(CoachTipBus)) is CoachTipBus tips)
        {
            tips.Publish(Navigation.Uri, Text);
        }
    }
}
