@namespace Jobsy.Web.Components.Candidate.Passport

<div class="passport-bubble @(Variant == BubbleVariant.Scene ? "passport-bubble--scene" : null)" role="note">
    <img class="passport-bubble__mascot"
         src="/images/brand/mascot-64.webp"
         width="40"
         height="40"
         alt=""
         aria-hidden="true" />
    <div class="passport-bubble__text">
        <p class="passport-bubble__copy">@Text</p>
        <ReadAloudButton Text="@Text" />
    </div>
</div>

@code {
    public enum BubbleVariant
    {
        Inline = 0,
        Scene = 1
    }

    [Parameter] public string Text { get; set; } = "";
    [Parameter] public BubbleVariant Variant { get; set; } = BubbleVariant.Inline;
}
