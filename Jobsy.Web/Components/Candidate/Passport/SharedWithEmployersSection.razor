@namespace Jobsy.Web.Components.Candidate.Passport
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.ProfileSections
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject Jobsy.Core.Features.IFeatureFlags FeatureFlags

<section class="shared-with-employers" data-testid="shared-with-employers">
    <p class="shared-with-employers__help">@Culture["Passport.Shared.Help"]</p>

    @RenderChipGroup(Culture["Passport.Shared.Indoor"], WorkPreferenceCatalogs.IndoorCodes, WorkPreferenceCatalogs.IndoorLabelKey, Editor.WorkIndoor, SetIndoor)
    @RenderChipGroup(Culture["Passport.Shared.Outdoor"], WorkPreferenceCatalogs.OutdoorCodes, WorkPreferenceCatalogs.OutdoorLabelKey, Editor.WorkOutdoor, SetOutdoor)
    @RenderChipGroup(Culture["Passport.Shared.Physical"], WorkPreferenceCatalogs.PhysicalWorkCodes, WorkPreferenceCatalogs.PhysicalLabelKey, Editor.WorkPhysical, SetPhysical)
    @RenderChipGroup(Culture["Passport.Shared.Pace"], WorkPreferenceCatalogs.PaceCodes, WorkPreferenceCatalogs.PaceLabelKey, Editor.WorkPace, SetPace)

    @if (_employerFitEnabled)
    {
        @RenderChipGroup(Culture["WorkPref.TeamMode.team"] + " / " + Culture["WorkPref.TeamMode.solo"], WorkPreferenceCatalogs.TeamModeCodes, WorkPreferenceCatalogs.TeamModeLabelKey, Editor.WorkTeamMode, SetTeamMode)
        @RenderChipGroup(Culture["WorkPref.Structure.fixed"], WorkPreferenceCatalogs.StructureCodes, WorkPreferenceCatalogs.StructureLabelKey, Editor.WorkStructure, SetStructure)
        @RenderChipGroup(Culture["WorkPref.Customer.much"], WorkPreferenceCatalogs.CustomerContactCodes, WorkPreferenceCatalogs.CustomerContactLabelKey, Editor.WorkCustomerContact, SetCustomer)
        @RenderChipGroup(Culture["WorkPref.Shifts.flex"], WorkPreferenceCatalogs.ShiftsPreferenceCodes, WorkPreferenceCatalogs.ShiftsLabelKey, Editor.WorkShiftsPreference, SetShifts)
    }

    <label class="detail-card passport-data__switch">
        <input type="checkbox" checked="@Editor.ShareEmployerPreferences" @onchange="ToggleShareEmployers" />
        <span>@Culture["Passport.Shared.ShareEmployers"]</span>
    </label>

    <label class="field">
        <span>@Culture["Passport.Shared.WorkRegion"]</span>
        <input data-testid="work-region" value="@Editor.WorkRegion" @onchange="OnRegion" maxlength="60" />
    </label>
    @if (!string.IsNullOrWhiteSpace(Editor.WorkRegionSuggestion) && string.IsNullOrWhiteSpace(Editor.WorkRegion))
    {
        <button type="button" class="btn btn-secondary" @onclick="UseSuggestion">@Editor.WorkRegionSuggestion</button>
    }

    <fieldset class="profile-roles profile-chip-grid">
        <legend>@Culture["Passport.Shared.OwnCar"]</legend>
        <button type="button"
                class="kompas-chip @(Editor.HasOwnCar == true ? "is-selected" : null)"
                aria-pressed="@(Editor.HasOwnCar == true ? "true" : "false")"
                @onclick="() => SetCar(true)">@Culture["Passport.Shared.Yes"]</button>
        <button type="button"
                class="kompas-chip @(Editor.HasOwnCar == false ? "is-selected" : null)"
                aria-pressed="@(Editor.HasOwnCar == false ? "true" : "false")"
                @onclick="() => SetCar(false)">@Culture["Passport.Shared.No"]</button>
    </fieldset>

    <fieldset class="profile-roles profile-chip-grid">
        <legend>@Culture["Passport.Shared.Contract"]</legend>
        @foreach (var code in WorkPreferenceCatalogs.ContractCodes)
        {
            var selected = Editor.ContractPreferences.Contains(code);
            <button type="button"
                    class="kompas-chip @(selected ? "is-selected" : null)"
                    aria-pressed="@(selected ? "true" : "false")"
                    @onclick="() => ToggleContract(code)">
                @Culture[WorkPreferenceCatalogs.ContractLabelKey(code)]
            </button>
        }
    </fieldset>

    <p data-testid="email-verified">
        @(Editor.EmailVerified ? Culture["Passport.Shared.EmailVerified"] : Culture["Passport.Shared.EmailConfirm"])
    </p>
    @if (PhoneVerificationEnabled)
    {
        <p data-testid="phone-verify">
            @(Editor.PhoneVerified ? Culture["Passport.Shared.PhoneVerified"] : Culture["Passport.Shared.PhoneConfirm"])
        </p>
    }
</section>

@code {
    [CascadingParameter] public CandidateProfileEditor Editor { get; set; } = default!;

    [Parameter] public bool PhoneVerificationEnabled { get; set; }

    private bool _employerFitEnabled;

    protected override async Task OnInitializedAsync()
    {
        var flags = await FeatureFlags.GetAsync();
        _employerFitEnabled = flags.IsEnabled(Jobsy.Core.Features.PlatformFeature.EmployerFitQuestionnaires);
    }

    private RenderFragment RenderChipGroup(
        string title,
        IReadOnlyList<string> codes,
        Func<string, string> labelKey,
        string? selectedCode,
        Action<string> onSelect)
        => builder =>
        {
            builder.OpenElement(0, "fieldset");
            builder.AddAttribute(1, "class", "profile-roles profile-chip-grid");
            builder.OpenElement(2, "legend");
            builder.AddContent(3, title);
            builder.CloseElement();
            var seq = 4;
            foreach (var code in codes)
            {
                var selected = string.Equals(selectedCode, code, StringComparison.OrdinalIgnoreCase);
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "class", $"kompas-chip {(selected ? "is-selected" : null)}");
                builder.AddAttribute(seq++, "aria-pressed", selected ? "true" : "false");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => onSelect(code)));
                builder.AddContent(seq++, Culture[labelKey(code)]);
                builder.CloseElement();
            }

            builder.CloseElement();
        };

    private RenderFragment RenderChipGroup(
        string title,
        string[] codes,
        Func<string, string> labelResolver,
        string? selectedCode,
        Action<string> onSelect)
        => RenderChipGroup(title, (IReadOnlyList<string>)codes, labelResolver, selectedCode, onSelect);

    private void SetIndoor(string code) { Editor.WorkIndoor = code; Editor.Notify(); }
    private void SetOutdoor(string code) { Editor.WorkOutdoor = code; Editor.Notify(); }
    private void SetPhysical(string code) { Editor.WorkPhysical = code; Editor.Notify(); }
    private void SetPace(string code) { Editor.WorkPace = code; Editor.Notify(); }
    private void SetTeamMode(string code) { Editor.WorkTeamMode = code; Editor.Notify(); }
    private void SetStructure(string code) { Editor.WorkStructure = code; Editor.Notify(); }
    private void SetCustomer(string code) { Editor.WorkCustomerContact = code; Editor.Notify(); }
    private void SetShifts(string code) { Editor.WorkShiftsPreference = code; Editor.Notify(); }
    private void SetCar(bool value) { Editor.HasOwnCar = value; Editor.Notify(); }

    private void ToggleShareEmployers(ChangeEventArgs _)
    {
        Editor.ShareEmployerPreferences = !Editor.ShareEmployerPreferences;
        Editor.Notify();
    }

    private void OnRegion(ChangeEventArgs e)
    {
        Editor.WorkRegion = e.Value?.ToString();
        Editor.Notify();
    }

    private void UseSuggestion()
    {
        Editor.WorkRegion = Editor.WorkRegionSuggestion;
        Editor.Notify();
    }

    private void ToggleContract(string code)
    {
        if (code == WorkPreferenceCatalogs.NoContractPreference)
        {
            Editor.ContractPreferences.Clear();
            Editor.ContractPreferences.Add(code);
        }
        else
        {
            Editor.ContractPreferences.Remove(WorkPreferenceCatalogs.NoContractPreference);
            if (!Editor.ContractPreferences.Add(code))
            {
                Editor.ContractPreferences.Remove(code);
            }
            else if (Editor.ContractPreferences.Count > WorkPreferenceCatalogs.MaxContractPreferences)
            {
                Editor.ContractPreferences.Remove(code);
            }
        }

        Editor.Notify();
    }
}
