@namespace Jobsy.Web.Components.Candidate.Discovery
@using Jobsy.Web.Localization
@inject CultureState Culture

<aside class="journey-rail card" aria-labelledby="journey-rail-title">
    <h2 id="journey-rail-title">@Culture["Discovery.Rail.Title"]</h2>
    <p class="journey-rail__count">@CountText</p>
    <ol class="journey-rail__route" aria-label="@Culture["Discovery.Rail.Aria"]">
        @{
            var beachDone = ActiveStep > 0 || CompletedSteps.Any(s => s is >= 1 and <= 10);
            var beachCurrent = ActiveStep == 0 && !LightStepComplete;
        }
        <li class="journey-rail__step @(beachCurrent ? "is-current" : beachDone ? "is-done" : "is-todo")"
            aria-current="@(beachCurrent ? "step" : null)"
            aria-label="@BeachAria(beachCurrent, beachDone)">
            @if (beachCurrent)
            {
                <span class="journey-rail__dot journey-rail__dot--current" aria-hidden="true"></span>
            }
            else if (beachDone)
            {
                <span class="journey-rail__dot journey-rail__dot--check" aria-hidden="true">✓</span>
            }
            else
            {
                <span class="journey-rail__dot journey-rail__dot--open" aria-hidden="true"></span>
            }
            <div>
                <b>@Culture["Discovery.Zone.Beach"]</b>
                <small>@Culture["Discovery.Rail.Start"]</small>
            </div>
        </li>
        @{
            string? zone = null;
        }
        @foreach (var step in JourneyCatalog.Steps)
        {
            if (zone != step.ZoneKey)
            {
                zone = step.ZoneKey;
                <li class="journey-rail__zone" aria-hidden="true">@Culture[JourneyCatalog.ZoneKeys[zone]]</li>
            }

            var done = CompletedSteps.Contains(step.Number);
            var current = ActiveStep == step.Number;
            var clickable = done && !current && OnGoToStep.HasDelegate;
            var rowClass = current ? "is-current" : done ? "is-done" : "is-todo";
            if (clickable)
            {
                rowClass += " is-clickable";
            }

            <li class="journey-rail__step @rowClass"
                aria-current="@(current ? "step" : null)"
                aria-label="@StepAria(step.Number, step.TitleKey, current, done)">
                @if (clickable)
                {
                    <button type="button"
                            class="journey-rail__jump"
                            @onclick="() => OnGoToStep.InvokeAsync(step.Number)">
                        @StepMarker(step.Number, current, done)
                        <div>
                            <b>@Culture[step.TitleKey]</b>
                            <small>@Culture.Format("Discovery.Rail.LayerOff", step.Number)</small>
                        </div>
                    </button>
                }
                else
                {
                    @StepMarker(step.Number, current, done)
                    <div>
                        <b>@Culture[step.TitleKey]</b>
                        <small>@(done
                            ? Culture.Format("Discovery.Rail.LayerOff", step.Number)
                            : Culture[step.SubKey])</small>
                    </div>
                }
            </li>
        }
        <li class="journey-rail__step @(LightStepComplete ? "is-done" : "is-todo is-end")"
            aria-label="@EndAria()">
            @if (LightStepComplete)
            {
                <span class="journey-rail__dot journey-rail__dot--check" aria-hidden="true">✓</span>
            }
            else
            {
                <span class="journey-rail__dot journey-rail__dot--open journey-rail__dot--sun" aria-hidden="true">☼</span>
            }
            <div>
                <b>@Culture["Discovery.Zone.Light"]</b>
                <small>@Culture["Discovery.Rail.NewShell"]</small>
            </div>
        </li>
    </ol>
    <div class="journey-rail__layers" aria-label="@Culture.Format("Discovery.Rail.LayersAria", LayersOff)">
        <span class="journey-rail__segs">
            @for (var k = 0; k < 10; k++)
            {
                <i class="@(k < LayersOff ? "is-off" : null)"></i>
            }
        </span>
        <span>@Culture.Format("Discovery.Rail.LayersCount", LayersOff)</span>
    </div>
    @if (ActiveStep > 0 || LayersOff > 0)
    {
        <p class="journey-rail__saved @SaveClass" aria-live="polite">@SaveText</p>
    }
</aside>

@code {
    [Parameter] public int ActiveStep { get; set; }
    [Parameter] public bool LightStepComplete { get; set; }
    [Parameter] public string SaveStatus { get; set; } = "idle";
    [Parameter] public IReadOnlySet<int> CompletedSteps { get; set; } = EmptySteps;
    [Parameter] public EventCallback<int> OnGoToStep { get; set; }

    private static readonly HashSet<int> EmptySteps = [];

    private int LayersOff
    {
        get
        {
            var n = CompletedSteps.Count(s => s is >= 1 and <= 10);
            return Math.Clamp(n, 0, 10);
        }
    }

    private string CountText
    {
        get
        {
            if (ActiveStep == 0 && LayersOff == 0)
            {
                return Culture["Discovery.Rail.StartCount"];
            }

            if (LightStepComplete && LayersOff >= 10)
            {
                return Culture["Discovery.Rail.DoneCount"];
            }

            if (ActiveStep is >= 1 and <= 10)
            {
                return Culture.Format("Discovery.Rail.StepLayersCount", ActiveStep, LayersOff);
            }

            return Culture.Format("Discovery.Rail.ProgressCount", LayersOff);
        }
    }

    private RenderFragment StepMarker(int number, bool current, bool done) => __builder =>
    {
        if (current)
        {
            <span class="journey-rail__dot journey-rail__dot--current" aria-hidden="true"></span>
        }
        else if (done)
        {
            <span class="journey-rail__dot journey-rail__dot--check" aria-hidden="true">✓</span>
        }
        else
        {
            <span class="journey-rail__dot journey-rail__dot--open" aria-hidden="true">@number</span>
        }
    };

    private string BeachAria(bool current, bool done)
    {
        var name = Culture["Discovery.Zone.Beach"];
        return StatusLabel(name, current, done);
    }

    private string StepAria(int number, string titleKey, bool current, bool done)
    {
        var name = Culture.Format("Discovery.Rail.StepName", number, Culture[titleKey]);
        return StatusLabel(name, current, done);
    }

    private string EndAria()
    {
        var name = Culture["Discovery.Zone.Light"];
        return LightStepComplete
            ? $"{name}, {Culture["Discovery.Rail.StatusDone"]}"
            : $"{name}, {Culture["Discovery.Rail.StatusTodo"]}";
    }

    private string StatusLabel(string name, bool current, bool done)
    {
        if (current)
        {
            return $"{name}, {Culture["Discovery.Rail.StatusCurrent"]}";
        }

        return done
            ? $"{name}, {Culture["Discovery.Rail.StatusDone"]}"
            : $"{name}, {Culture["Discovery.Rail.StatusTodo"]}";
    }

    private string SaveClass => SaveStatus switch
    {
        "error" => "is-error",
        "saving" => "is-saving",
        "saved" => "is-saved",
        _ => ""
    };

    private string SaveText => SaveStatus switch
    {
        "saving" => Culture["Discovery.Saved.Saving"],
        "error" => Culture["Discovery.Saved.Error"],
        "saved" => Culture["Discovery.Saved.Ok"],
        _ => ""
    };
}
