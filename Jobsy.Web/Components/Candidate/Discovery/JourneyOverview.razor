@namespace Jobsy.Web.Components.Candidate.Discovery
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture

<div class="journey-overview">
    <p class="journey-step__eyebrow">@Culture["Discovery.Eyebrow"]</p>
    <h1 tabindex="-1">@Culture["Discovery.Overview.Title"]</h1>
    <p class="journey-step__lead">@Culture["Discovery.Overview.Lead"]</p>

    <ul class="journey-overview__list" aria-busy="@IsLoading">
        @if (IsLoading)
        {
            @for (var i = 0; i < 6; i++)
            {
                <li class="journey-overview__row journey-overview__row--skeleton" aria-hidden="true">
                    <div class="journey-overview__main">
                        <span class="journey-skeleton journey-skeleton--title"></span>
                        <span class="journey-skeleton journey-skeleton--meta"></span>
                    </div>
                    <span class="journey-skeleton journey-skeleton--btn"></span>
                </li>
            }
        }
        else
        {
            @foreach (var row in Rows)
            {
                <li class="journey-overview__row">
                    <div class="journey-overview__main">
                        <b>@Culture[row.TitleKey]</b>
                        <small class="@(row.StatusClass)">@row.StatusText</small>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(row.ActionLabel))
                    {
                        <div class="journey-overview__actions">
                            <button type="button" class="btn btn-secondary" @onclick="() => OnRowAction.InvokeAsync(row)">
                                @row.ActionLabel
                            </button>
                        </div>
                    }
                </li>
            }
        }
    </ul>

    <h2 class="journey-q">@Culture["Discovery.Overview.TestsHeading"]</h2>
    <ul class="journey-overview__list" aria-busy="@IsLoading">
        @if (IsLoading)
        {
            @for (var i = 0; i < 4; i++)
            {
                <li class="journey-overview__row journey-overview__row--test journey-overview__row--skeleton" aria-hidden="true">
                    <div class="journey-overview__main">
                        <span class="journey-skeleton journey-skeleton--title"></span>
                        <span class="journey-skeleton journey-skeleton--meta"></span>
                    </div>
                    <span class="journey-skeleton journey-skeleton--btn"></span>
                </li>
            }
        }
        else
        {
        @foreach (var test in Tests)
        {
            <li class="journey-overview__row journey-overview__row--test">
                <div class="journey-overview__main">
                    <b>@Culture[test.TitleKey]</b>
                    <small>@test.DepthText</small>
                </div>
                <div class="journey-overview__actions">
                    @if (test.IsComplete)
                    {
                        <span class="status-pill status-pill--success">@Culture["Discovery.Overview.FullyDone"]</span>
                        <a class="btn btn-secondary" href="@test.ReportHref">@Culture["Discovery.Overview.FullReport"]</a>
                    }
                    else
                    {
                        @foreach (var level in test.NextLevels)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="() => OnDeepen.InvokeAsync((test.Step, level))">
                                @level.Label
                            </button>
                        }
                    }
                </div>
            </li>
        }
        }
    </ul>
</div>

@code {
    public sealed record OverviewRow(
        int Step,
        string TitleKey,
        string StatusText,
        string StatusClass,
        string? ActionLabel,
        bool IsConsent = false,
        bool IsReview = true);

    public sealed record DepthButton(int TargetCount, string Label);

    public sealed record TestRow(
        int Step,
        string TitleKey,
        string DepthText,
        bool IsComplete,
        string ReportHref,
        IReadOnlyList<DepthButton> NextLevels);

    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public IReadOnlyList<OverviewRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<TestRow> Tests { get; set; } = [];
    [Parameter] public EventCallback<OverviewRow> OnRowAction { get; set; }
    [Parameter] public EventCallback<(int Step, DepthButton Level)> OnDeepen { get; set; }
}
