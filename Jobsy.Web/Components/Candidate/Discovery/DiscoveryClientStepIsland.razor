@namespace Jobsy.Web.Components.Candidate.Discovery
@using Jobsy.Web.Discovery
@using Jobsy.Web.Onboarding
@using Jobsy.Web.Components.Candidate.Onboarding
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="disc-client-step"
     data-discovery-client-step="@Step"
     data-initial="@_initialJson"
     @ref="_root">
    @((MarkupString)DiscoveryClientStepShells.Build(Step, Culture))
</div>

@code {
    [Parameter] public int Step { get; set; }
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public IReadOnlyList<(string Code, string TitleKey, string LeadKey)> Presets { get; set; } = [];
    [Parameter] public OnboardingClientStepSeed? Seed { get; set; }

    private ElementReference _root;
    private string _initialJson = "{}";
    private bool _mounted;
    private int _lastStep;

    protected override void OnParametersSet()
    {
        if (_lastStep != Step)
        {
            _lastStep = Step;
            _mounted = false;
        }

        _initialJson = DiscoveryClientStepInitialState.Build(Step, Draft, Culture, Presets, Seed ?? new OnboardingClientStepSeed());
    }

    protected override bool ShouldRender() => !_mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mounted)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("jobsyDiscoveryClient.mount", _root, Step);
            _mounted = true;
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("jobsyDiscoveryClient.unmount", _root);
        }
        catch
        {
        }
    }

    [Inject] private CultureState Culture { get; set; } = default!;
}
