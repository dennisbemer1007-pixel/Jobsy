@namespace Jobsy.Web.Components.Candidate.ProfileSections
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@inject CultureState Culture

            <section class="profile-unsubscribe" aria-labelledby="profile-privacy-title">
                <h2 id="profile-privacy-title" class="profile-page__title">@Culture["Profile.Consent.Title"]</h2>
                <p class="login-lead">@Culture["Profile.Consent.Lead"]</p>

                <h3>@Culture["Profile.Consent.TestAiTitle"]</h3>
                <p class="profile-address__hint">
                    @(Editor.TestAiConsentAt is null
                        ? Culture["Profile.Consent.TestAiNone"]
                        : Culture.Format("Profile.Consent.TestAiSince", Editor.TestAiConsentAt.Value.ToLocalTime().ToString("dd-MM-yyyy")))
                </p>
                @if (Editor.TestAiConsentAt is null)
                {
                    <button class="btn btn-primary" type="button" disabled="@Editor.ConsentBusy" @onclick="Editor.AcceptTestConsentAsync">@Culture["Profile.Consent.Accept"]</button>
                }
                else
                {
                    <button class="btn btn-primary" type="button" disabled="@Editor.ConsentBusy" @onclick="() => Editor.WithdrawTestConsentAsync(false)">@Culture["Profile.Consent.Withdraw"]</button>
                    <button class="provider-btn provider-btn--danger" type="button" disabled="@Editor.ConsentBusy" @onclick="() => Editor.WithdrawTestConsentAsync(true)">@Culture["Profile.Consent.WithdrawDelete"]</button>
                }

                <h3>@Culture["Profile.Consent.TalentTitle"]</h3>
                <p class="profile-address__hint">
                    @(Editor.TalentPoolConsentAt is null
                        ? Culture["Profile.Consent.TalentOff"]
                        : Culture["Profile.Consent.TalentOn"])
                </p>
                @if (Editor.TalentPoolConsentAt is null)
                {
                    <button class="btn btn-primary" type="button" disabled="@Editor.ConsentBusy" @onclick="Editor.AcceptTalentPoolConsentAsync">@Culture["Profile.Consent.TalentAccept"]</button>
                }
                else
                {
                    <button class="provider-btn provider-btn--danger" type="button" disabled="@Editor.ConsentBusy" @onclick="Editor.WithdrawTalentPoolConsentAsync">@Culture["Profile.Consent.TalentWithdraw"]</button>
                }

                @if (Editor.IsUnder16 && Editor.ParentalConsentAt is null)
                {
                    <h3>@Culture["Profile.Consent.ParentalTitle"]</h3>
                    <p class="profile-address__hint">@Culture["Profile.Consent.ParentalLead"]</p>
                    <label>
                        @Culture["Profile.Consent.ParentalEmail"]
                        <input type="email" @bind="Editor.ParentalConsentEmail" autocomplete="email" />
                    </label>
                    <button class="btn btn-primary" type="button" disabled="@Editor.ConsentBusy" @onclick="Editor.RequestParentalConsentAsync">@Culture["Profile.Consent.ParentalSend"]</button>
                }
                @if (!string.IsNullOrWhiteSpace(Editor.ConsentMessage))
                {
                    <p class="state-message" aria-live="polite">@Editor.ConsentMessage</p>
                }
            </section>

@code {
    [CascadingParameter] public CandidateProfileEditor Editor { get; set; } = default!;
}
