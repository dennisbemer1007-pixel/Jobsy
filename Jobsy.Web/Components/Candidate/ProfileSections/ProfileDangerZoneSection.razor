@namespace Jobsy.Web.Components.Candidate.ProfileSections
@using Jobsy.Web.Localization
@inject CultureState Culture

<section class="profile-danger-zone" aria-labelledby="profile-danger-zone-title">
    <h2 id="profile-danger-zone-title" class="profile-page__title">@Culture["Profile.DangerZone.Title"]</h2>

    <article class="profile-danger-zone__block profile-danger-zone__block--reset" aria-labelledby="profile-reset-title">
        <h3 id="profile-reset-title" class="profile-danger-zone__subtitle">@Culture["Profile.Reset.Title"]</h3>
        <p class="login-lead profile-danger-zone__lead">@Culture["Profile.Reset.Lead"]</p>
        <button class="provider-btn" type="button" @onclick="Editor.OpenProfileReset">
            @Culture["Profile.Reset.Button"]
        </button>
    </article>

    <p class="profile-danger-zone__divider" aria-hidden="true">@Culture["Profile.DangerZone.Divider"]</p>

    <article class="profile-danger-zone__block profile-danger-zone__block--delete" aria-labelledby="profile-unsubscribe-title">
        <h3 id="profile-unsubscribe-title" class="profile-danger-zone__subtitle">@Culture["Profile.UnsubscribeTitle"]</h3>
        <p class="login-lead profile-danger-zone__lead">@Culture["Profile.UnsubscribeLead"]</p>
        <button class="provider-btn provider-btn--danger" type="button" @onclick="Editor.OpenUnsubscribe">
            @Culture["Profile.Unsubscribe"]
        </button>
    </article>
</section>

@code {
    [CascadingParameter] public CandidateProfileEditor Editor { get; set; } = default!;
}
