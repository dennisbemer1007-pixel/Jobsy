@namespace Jobsy.Web.Components.Candidate.ProfileSections
@using System.Net.Http.Json
@using Jobsy.Core.Contracts
@using Jobsy.Core.Privacy
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@inherits CultureAwareComponentBase
@inject IHttpClientFactory HttpClientFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject NavigationManager Navigation

@if (IsOpen)
{
    <LobsyFriendlyDialog IsOpen="IsOpen"
                         Title="@Culture["Profile.Reset.Dialog.Title"]"
                         TitleId="profile-reset-modal-title"
                         Class="publish-modal profile-reset-modal"
                         ShowClose="true"
                         CloseDisabled="_busy"
                         CloseAriaLabel="@Culture["Profile.Reset.Dialog.Cancel"]"
                         OnClose="CloseAsync">
        @if (_completed)
        {
            <p class="share-modal__lead lobsy-dialog__lead">@Culture["Profile.Reset.Done"]</p>
        }
        else
        {
            <p class="share-modal__lead lobsy-dialog__lead">@Culture["Profile.Reset.Dialog.Lead"]</p>
            <p class="login-lead profile-reset-modal__note">@Culture["Profile.Reset.Dialog.ApplicationsNote"]</p>
            @if (_showResearchNote)
            {
                <p class="login-lead profile-reset-modal__note profile-reset-modal__note--research">
                    @Culture["Profile.Reset.Dialog.ResearchNote"]
                </p>
            }
            <label class="profile-reset-modal__confirm">
                <span>@Culture.Format("Profile.Reset.Dialog.ConfirmLabel", _confirmWord)</span>
                <input class="apply-code-field__input"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       disabled="@_busy"
                       @bind="_typedConfirm"
                       @bind:event="oninput" />
            </label>
            <div class="inline-actions profile-reset-modal__actions">
                <button type="button"
                        class="btn-compact btn-compact--primary"
                        disabled="@(_busy || !CanSubmit)"
                        @onclick="SubmitAsync">
                    @(_busy ? Culture["Common.Busy"] : Culture["Profile.Reset.Dialog.Submit"])
                </button>
                <button type="button" class="btn-compact" disabled="@_busy" @onclick="CloseAsync">
                    @Culture["Profile.Reset.Dialog.Cancel"]
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error" role="alert">@_error</p>
        }
    </LobsyFriendlyDialog>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool ShowResearchNote { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _busy;
    private bool _completed;
    private string _typedConfirm = "";
    private string? _error;
    private bool _showResearchNote;
    private string _confirmWord = CandidateProfileResetConfirm.ExpectedPhrase("nl");

    private bool CanSubmit => CandidateProfileResetConfirm.Matches(Culture.Language, _typedConfirm);

    protected override void OnParametersSet()
    {
        _showResearchNote = ShowResearchNote;
        _confirmWord = CandidateProfileResetConfirm.ExpectedPhrase(Culture.Language);
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var http = HttpContextAccessor.HttpContext
                       ?? throw new InvalidOperationException("Geen HTTP-context.");
            var tokens = Antiforgery.GetAndStoreTokens(http);
            var client = HttpClientFactory.CreateClient("JobsyWebSelf");
            using var request = new HttpRequestMessage(HttpMethod.Post, CandidateProfileResetEndpoints.ResetPath);
            request.Headers.TryAddWithoutValidation(tokens.HeaderName ?? "RequestVerificationToken", tokens.RequestToken);
            request.Content = JsonContent.Create(new ResetCandidateProfileRequest(_typedConfirm.Trim()));
            using var response = await client.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = ExtractMessage(body) ?? Culture["Common.ErrorGeneric"];
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ResetCandidateProfileResponse>();
            _completed = true;
            await Task.Delay(400);
            Navigation.NavigateTo(result?.RedirectPath ?? "/candidate/start", forceLoad: true);
        }
        catch (Exception)
        {
            _error = Culture["Common.ErrorGeneric"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_busy)
        {
            return;
        }

        _typedConfirm = "";
        _error = null;
        _completed = false;
        await OnClose.InvokeAsync();
    }

    private static string? ExtractMessage(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("message", out var msg))
            {
                return msg.GetString();
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // ignore
        }

        return null;
    }
}
