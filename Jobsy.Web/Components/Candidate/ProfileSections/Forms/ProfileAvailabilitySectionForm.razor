@namespace Jobsy.Web.Components.Candidate.ProfileSections.Forms
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@inject CultureState Culture
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
<div data-profile-bff data-bff-url="@CandidateProfileBffEndpoints.AvailabilityPath">
<input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
<p data-bff-error class="form-error" role="alert" hidden></p>
<label><input type="checkbox" name="start_immediately" value="1" checked="@StartImmediately" />@Culture["Profile.AvailabilityStartImmediate"]</label>
<label>@Culture["Profile.HoursMin"]<input type="number" name="min_hours" value="@MinHours" /></label>
</div>
<ProfileSectionFormChrome Saved="Saved" Error="Error" />
@code { [Parameter] public bool StartImmediately { get; set; } = true; [Parameter] public decimal? MinHours { get; set; } [Parameter] public bool Saved { get; set; } [Parameter] public bool Error { get; set; }
private string _antiforgeryFieldName = ""; private string _antiforgeryToken = "";
protected override void OnInitialized() { var http = HttpContextAccessor.HttpContext; if (http is null) return; var t = Antiforgery.GetAndStoreTokens(http); _antiforgeryFieldName = t.FormFieldName; _antiforgeryToken = t.RequestToken ?? ""; } }
