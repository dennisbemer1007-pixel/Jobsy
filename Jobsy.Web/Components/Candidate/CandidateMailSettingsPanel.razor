@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Components.Account
@using Microsoft.AspNetCore.Antiforgery
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject IFeatureFlags FeatureFlags

@if (_loadError)
{
    <p class="muted">@Culture["MailSettings.LoadError"]</p>
}
else
{
    <form method="post" action="/account/mail-instellingen" class="login-form" data-enhance="false">
        <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />

        @if (_optional.Count > 0)
        {
            <input type="hidden" name="reminder_emails_shown" value="1" />
            <div class="cand-toggle">
                <div>
                    <strong class="mail-settings__label">@Culture["MailSettings.Reminders.Label"]</strong>
                    <span class="muted mail-settings__hint" style="display:block">@Culture["MailSettings.Reminders.Hint"]</span>
                </div>
                <label class="cand-toggle__switch @(_reminderEmails ? "is-on" : null)">
                    <input type="checkbox" name="reminder_emails" value="1" checked="@_reminderEmails" data-reminder-emails="1" />
                </label>
            </div>

            <h3 style="font-size:1rem;margin:1.25rem 0 0.5rem">@Culture["MailSettings.OptionalHeading"]</h3>
            @foreach (var item in _optional)
            {
                <div class="cand-toggle">
                    <div>
                        <strong class="mail-settings__label">@LabelFor(item.Key)</strong>
                        <span class="muted mail-settings__hint" style="display:block">@HintFor(item.Key)</span>
                    </div>
                    <label class="cand-toggle__switch @(item.Enabled ? "is-on" : null)">
                        <input type="checkbox" name="pref_@item.Key" value="1" checked="@item.Enabled" />
                    </label>
                </div>
            }
            <ComebackWhatsAppFields Available="_whatsAppAvailable" OptedIn="_whatsAppOptedIn" Phone="@_whatsAppPhone" />
            <button type="submit" class="btn btn-primary" style="margin-top:1rem">@Culture["MailSettings.Save"]</button>
        }
        else
        {
            <p class="muted">@Culture["MailSettings.NoOptional"]</p>
        }

        <h3 style="font-size:1rem;margin:2rem 0 0.5rem">@Culture["MailSettings.AlwaysHeading"]</h3>
        <ul>
            @foreach (var key in _alwaysKeys)
            {
                <li>@Culture[key]</li>
            }
        </ul>
        <p class="muted">@Culture[_employersOn ? "MailSettings.AlwaysHint" : "MailSettings.AlwaysHintOff"]</p>
    </form>

    @if (_saved)
    {
        <p role="status" style="margin-top:1rem;color:var(--success)">@Culture["MailSettings.Saved"]</p>
    }
}

@code {
    private readonly List<JobsyApiClient.EmailPreferenceItemDto> _optional = [];
    private readonly List<string> _alwaysKeys = [];
    private bool _employersOn = true;
    private bool _loadError;
    private bool _saved;
    private bool _reminderEmails = true;
    private bool _whatsAppAvailable;
    private bool _whatsAppOptedIn;
    private string? _whatsAppPhone;
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? "";
            _saved = string.Equals(http.Request.Query["saved"], "1", StringComparison.Ordinal);
        }

        try
        {
            var dto = await Api.GetMyEmailPreferencesAsync();
            if (dto is null)
            {
                _loadError = true;
                return;
            }

            _employersOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.Employers);
            _reminderEmails = dto.ReminderEmailsEnabled;
            _optional.Clear();
            _optional.AddRange(dto.Optional ?? []);
            _alwaysKeys.Clear();
            _alwaysKeys.Add("MailSettings.Always.Codes");
            if (_employersOn)
            {
                _alwaysKeys.Add("MailSettings.Always.Applications");
            }
            else
            {
                _optional.RemoveAll(item => item.Key is "PushBom");
            }

            _alwaysKeys.Add("MailSettings.Always.Security");
            var whatsApp = await Api.GetReminderWhatsAppAsync();
            _whatsAppAvailable = whatsApp?.Available == true;
            _whatsAppOptedIn = whatsApp?.OptedIn == true;
            _whatsAppPhone = whatsApp?.Phone;
        }
        catch
        {
            _loadError = true;
        }
    }

    private string LabelFor(string key) => key switch
    {
        "PushBom" => Culture["MailSettings.PushBom.Label"],
        "VacancyEngagementReminder" => Culture["MailSettings.VacancyEngagement.Label"],
        "CompanyReEngagement" => Culture["MailSettings.CompanyReEngagement.Label"],
        "ComebackReminder" => Culture["MailSettings.Comeback.Label"],
        _ => key
    };

    private string HintFor(string key) => key switch
    {
        "PushBom" => Culture["MailSettings.PushBom.Hint"],
        "VacancyEngagementReminder" => Culture["MailSettings.VacancyEngagement.Hint"],
        "CompanyReEngagement" => Culture["MailSettings.CompanyReEngagement.Hint"],
        "ComebackReminder" => Culture["MailSettings.Comeback.Hint"],
        _ => ""
    };
}
