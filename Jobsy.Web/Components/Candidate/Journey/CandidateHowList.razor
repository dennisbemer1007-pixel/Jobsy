@namespace Jobsy.Web.Components.Candidate.Journey
@using Jobsy.Web.Components
@using Jobsy.Web.Localization
@inject CultureState Culture

<ol class="how-stones" aria-label="@Culture["HowC.List.Label"]">
    @foreach (var row in Rows)
    {
        <li class="how-stone how-stone--@StateClass(row)" aria-current="@(row.IsNow ? "step" : null)">
            <a class="how-stone__row" href="@row.Stone.Href">
                <span class="how-stone__marker" aria-hidden="true">
                    @if (row.Done)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 13 4 4 10-10" />
                        </svg>
                    }
                    else if (row.IsNow)
                    {
                        <LobsyLogo Class="how-stone__lob" Alt="" UseMascot="true" />
                    }
                    else
                    {
                        @row.Number
                    }
                </span>
                <span class="how-stone__text">
                    <b class="how-stone__title">@Culture[row.Stone.TitleKey]</b>
                    <small class="how-stone__body">@Culture[row.Stone.BodyKey]</small>
                    <small class="how-stone__state">@Culture[StateKey(row)]</small>
                </span>
                @* Desktop shows the wording at the row end; on mobile the whole row is the tap target. *@
                <span class="how-stone__go career-only-desktop">@Culture[LinkKey(row)]</span>
            </a>
        </li>
    }
</ol>

@code {
    [Parameter] public IReadOnlyList<CandidateHowRow> Rows { get; set; } = [];

    private static string StateClass(CandidateHowRow row)
        => row.Done ? "done" : row.IsNow ? "now" : "todo";

    private static string StateKey(CandidateHowRow row)
        => row.Done ? "HowC.State.Done" : row.IsNow ? "HowC.State.Now" : "HowC.State.Todo";

    private static string LinkKey(CandidateHowRow row)
    {
        if (row.Stone.Action == CandidateHowStoneAction.Open)
        {
            return "HowC.Link.Open";
        }

        return row.Done ? "HowC.Link.Back" : row.IsNow ? "HowC.Link.Continue" : "HowC.Link.Start";
    }
}
