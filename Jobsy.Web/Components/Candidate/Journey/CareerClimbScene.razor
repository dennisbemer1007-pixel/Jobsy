@namespace Jobsy.Web.Components.Candidate.Journey
@using System.Globalization
<div class="career-scene @(Mobile ? "career-scene--mobile" : "career-scene--desktop") @(Celebrate ? "career-scene--celebrate" : null)"
     aria-hidden="true">
    @((MarkupString)_svg)

    @if ((Variant != ClimbVariant.Stones || ShowLobster) && _points.Count > 0)
    {
        <div class="career-scene__lob" style="--x:@(LobsterX)%;--y:@(LobsterY)%;--size:@(LobsterSize)px">
            <img class="lobsy-coach-art"
                 src="/images/brand/mascot-coach.webp"
                 alt=""
                 width="@LobsterSize"
                 height="@LobsterSize" />
        </div>
    }

    <div class="career-scene__labels">
        @for (var i = 0; i < _points.Count && i < Stones.Count; i++)
        {
            var stone = Stones[i];
            <span class="career-scene__label career-scene__label--@StateClass(stone.State) @(Mobile ? "career-scene__label--mark" : null)"
                  style="--x:@(Xp(i))%;--y:@(Yp(i))%">
                @if (Mobile)
                {
                    @if (stone.State == ClimbStoneState.Dream)
                    {
                        <svg class="career-scene__star" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
                            <path d="M8 1.5l1.9 4 4.4.6-3.2 3.1.8 4.3L8 11.5l-3.9 2 .8-4.3L1.7 6.1l4.4-.6z" />
                        </svg>
                    }
                    else
                    {
                        <b>@(stone.ShortMark ?? stone.Label)</b>
                    }
                }
                else
                {
                    <b>@stone.Label</b>
                    @if (!string.IsNullOrWhiteSpace(stone.StateText))
                    {
                        <small>@stone.StateText</small>
                    }
                }
            </span>
        }
    </div>
</div>

@code {
    private string _svg = "";
    private IReadOnlyList<CareerClimbGeometry.Point> _points = [];

    [Parameter] public ClimbVariant Variant { get; set; } = ClimbVariant.Climb;

    /// <summary>05 §2: the stones scene can still carry the lobster on the <c>now</c> stone.</summary>
    [Parameter] public bool ShowLobster { get; set; }

    [Parameter] public bool Mobile { get; set; }
    [Parameter] public IReadOnlyList<ClimbStone> Stones { get; set; } = [];
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public bool Celebrate { get; set; }
    [Parameter] public int PlatesShed { get; set; } = 4;
    [Parameter] public int LobsterSize { get; set; }

    /// <summary>Index of the old-shell plate that falls once during the growth moment (03 §5).</summary>
    [Parameter] public int? FallingPlate { get; set; }

    /// <summary>Localized label; only the completion moment carries meaning (§0).</summary>
    [Parameter] public string LobsterLabel { get; set; } = "";

    protected override void OnParametersSet()
    {
        var stepCount = Math.Max(1, Stones.Count - 2);
        _points = CareerClimbGeometry.Points(stepCount, Mobile);
        _svg = CareerClimbSceneBuilder.BuildSvg(
            _points,
            Stones,
            Math.Clamp(CurrentIndex, 0, Math.Max(0, _points.Count - 1)),
            Mobile,
            Celebrate,
            listen: Variant == ClimbVariant.Listen);
    }

    private int LobsterIndex => Math.Clamp(CurrentIndex, 0, Math.Max(0, _points.Count - 1));

    private string LobsterX => Xp(LobsterIndex);

    private string LobsterY => Yp(LobsterIndex);

    private string Xp(int index)
        => Percent(_points[index].X, CareerClimbGeometry.Width(Mobile));

    private string Yp(int index)
        => Percent(_points[index].Y, CareerClimbGeometry.Height(Mobile));

    private static string Percent(double value, double total)
        => (Math.Round(value / total * 1000) / 10).ToString("0.#", CultureInfo.InvariantCulture);

    private static string StateClass(ClimbStoneState state) => state switch
    {
        ClimbStoneState.Done => "done",
        ClimbStoneState.Now => "now",
        ClimbStoneState.Dream => "dream",
        _ => "todo"
    };
}
