@namespace Jobsy.Web.Components.Candidate.Journey
@using Jobsy.Core.Localization
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (AsDisclosure)
{
    <details class="career-archive how-safe how-safe--mobile career-only-mobile">
        <summary>@Culture["HowC.Safe.TitleMobile"]</summary>
        @Lines
    </details>
}
else
{
    <section class="career-rail how-safe" aria-labelledby="how-safe-title">
        <h2 id="how-safe-title">@Culture["HowC.Safe.Title"]</h2>
        @Lines
    </section>
}

@code {
    /// <summary>Mobile repeats the same copy as a disclosure under the list (cr-m7).</summary>
    [Parameter] public bool AsDisclosure { get; set; }

    /// <summary>Dependency D: with Werkgevers OFF nobody can ask for a name, so that line goes.</summary>
    [Parameter] public bool EmployersOn { get; set; } = true;

    /// <summary>Hidden when the assistant tab is not rendered for this user.</summary>
    [Parameter] public bool AssistantOn { get; set; } = true;

    private string AssistantText
        => Culture[Culture.IsRightToLeft ? "HowC.Safe.AssistantRtl" : "HowC.Safe.Assistant"];

    private RenderFragment Lines => @<ul class="how-safe__list">
        @if (EmployersOn)
        {
            <li>
                <span class="how-safe__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6Z" />
                    </svg>
                </span>
                <span>@Culture["HowC.Safe.Names"]</span>
            </li>
        }
        <li>
            <span class="how-safe__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4 10-10" />
                </svg>
            </span>
            <span>@Culture["HowC.Safe.Saved"]</span>
        </li>
        <li>
            <span class="how-safe__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
                    <path d="M2 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
                </svg>
            </span>
            <span class="how-safe__langs">
                @Culture["HowC.Safe.Languages"]
                <text> </text>
                @foreach (var (language, last) in Languages)
                {
                    <span lang="@language.Code" dir="@(language.IsRightToLeft ? "rtl" : null)">@language.NativeName</span>
                    @(last ? "." : ", ")
                }
            </span>
        </li>
        @if (AssistantOn)
        {
            <li>
                <span class="how-safe__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 12v9" />
                        <path d="M12 12 6 4" />
                        <path d="m12 12 6-8" />
                        <circle cx="6" cy="3" r="1.4" />
                        <circle cx="18" cy="3" r="1.4" />
                    </svg>
                </span>
                <span>@AssistantText</span>
            </li>
        }
    </ul>;

    /// <summary>Always all five, each in its own language (05 §2).</summary>
    private static IEnumerable<(LanguageOption Language, bool Last)> Languages
        => JobsyLanguages.All.Select((l, i) => (l, i == JobsyLanguages.All.Count - 1));
}
