@namespace Jobsy.Web.Components.Candidate.TestResult
@using Jobsy.Core.Enums
@using Jobsy.Core.Reports.Competence
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

@if (_reached is not null)
{
    <section class="test-depth-unlock" aria-label="@Culture["TestDepthValue.Unlock.Aria"]">
        <article class="test-depth-unlock__card test-depth-unlock__card--now">
            <h2>@Culture["TestDepthValue.Unlock.NowTitle"]</h2>
            <p>@Culture[_nowBodyKey]</p>
            <ul class="test-depth-unlock__list">
                @foreach (var line in _nowLines)
                {
                    <li>@line</li>
                }
            </ul>
        </article>
        @if (_next is not null && _preview is not null)
        {
            <article class="test-depth-unlock__card test-depth-unlock__card--next">
                <div class="test-depth-unlock__next-art test-depth-spot-art test-depth-spot-art--card" style="@_nextArtStyle" aria-hidden="true"></div>
                <h2>@Culture["TestDepthValue.Unlock.NextTitle"]</h2>
                <p class="test-depth-unlock__promise">@_previewPromise</p>
                <div class="test-depth-unlock__preview" aria-hidden="true">
                    <div class="test-depth-unlock__preview-inner test-depth-unlock__preview-inner--@PreviewVariant">
                        <span class="test-depth-unlock__preview-badge">@Culture[_previewBadgeKey]</span>
                        @foreach (var theme in _previewThemes)
                        {
                            <div class="test-depth-unlock__preview-theme">
                                <p class="test-depth-unlock__preview-theme-title">@theme.Title</p>
                                <p class="test-depth-unlock__preview-theme-body">@theme.Body</p>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public AssessmentKind Kind { get; set; }
    [Parameter] public int AnsweredCount { get; set; }
    [Parameter] public int QuickScanVersion { get; set; } = AssessmentTestVersions.V1;

    private TestDepthLevel? _reached;
    private TestDepthLevel? _next;
    private string _nowBodyKey = "TestDepthValue.Unlock.NowBody.First";
    private IReadOnlyList<string> _nowLines = [];
    private TestDepthValuePreviewCopy.PreviewModel? _preview;
    private string _previewPromise = "";
    private string _previewBadgeKey = "TestDepthValue.MiniMirror.Badge";
    private IReadOnlyList<PreviewTheme> _previewThemes = [];
    private string _nextArtStyle = "";

    private sealed record PreviewTheme(string Title, string Body);

    private string PreviewVariant => _next switch
    {
        TestDepthLevel.Deeper => "10",
        TestDepthLevel.Full => "25",
        TestDepthLevel.Bottom => "150",
        _ => "5"
    };

    protected override void OnParametersSet()
    {
        _reached = TestDepthRules.Reached(Kind, AnsweredCount, QuickScanVersion);
        _next = TestDepthRules.Next(Kind, AnsweredCount, QuickScanVersion);
        _nowBodyKey = _reached switch
        {
            TestDepthLevel.First => "TestDepthValue.Unlock.NowBody.First",
            TestDepthLevel.Deeper => "TestDepthValue.Unlock.NowBody.Deeper",
            TestDepthLevel.Full => "TestDepthValue.Unlock.NowBody.Full",
            _ => "TestDepthValue.Unlock.NowBody.First"
        };
        _nowLines = _reached switch
        {
            TestDepthLevel.First =>
            [
                Culture["TestDepthValue.Unlock.NowLine.First1"],
                Culture["TestDepthValue.Unlock.NowLine.First2"]
            ],
            TestDepthLevel.Deeper =>
            [
                Culture["TestDepthValue.Unlock.NowLine.Deeper1"],
                Culture["TestDepthValue.Unlock.NowLine.Deeper2"],
                Culture["TestDepthValue.Unlock.NowLine.Deeper3"]
            ],
            TestDepthLevel.Full =>
            [
                Culture["TestDepthValue.Unlock.NowLine.Full1"],
                Culture["TestDepthValue.Unlock.NowLine.Full2"],
                Culture["TestDepthValue.Unlock.NowLine.Full3"]
            ],
            _ => [Culture["TestDepthValue.Unlock.NowLine.First1"]]
        };

        _preview = TestDepthValuePreviewCopy.NextPreview(_next, QuickScanVersion);
        if (_preview is null)
        {
            _previewPromise = "";
            _previewThemes = [];
            _nextArtStyle = "";
            return;
        }

        var (nextUrl, nextPos) = TestDepthValueIllustratedArt.ForUnlockNextPreview(PreviewVariant);
        _nextArtStyle = TestDepthValueIllustratedArt.InlineBackground(nextUrl, nextPos);

        var nl = Culture.Language.StartsWith("nl", StringComparison.OrdinalIgnoreCase);
        _previewPromise = nl ? _preview.PromiseNl : _preview.PromiseEn;
        _previewBadgeKey = _preview.FullMirrorSections
            ? "TestDepthValue.Unlock.PreviewMirrorBadge"
            : "TestDepthValue.MiniMirror.Badge";
        _previewThemes = _preview.ThemeTitleKeys
            .Select(key => BuildPreviewTheme(key, nl))
            .ToList();
    }

    private PreviewTheme BuildPreviewTheme(string domainKey, bool nl)
    {
        if (_preview?.FullMirrorSections == true)
        {
            return new PreviewTheme(
                Culture[domainKey],
                TestDepthValuePreviewCopy.MirrorSectionBody(domainKey, nl));
        }

        if (_next == TestDepthLevel.Bottom)
        {
            var title = CompetenceDeepReportTexts.LabelNl(domainKey);
            var sample = CompetenceDeepReportTexts.For(domainKey, CompetenceDeepReportLevels.Gemiddeld);
            var body = sample?.Meaning ?? (nl
                ? "Meer uitleg over hoe deze kant op de werkvloer uitpakt."
                : "More on how this side shows up at work.");
            return new PreviewTheme(title, body);
        }

        var label = DimensionLabels.For(domainKey, Culture.Language);
        var copy = TestDepthValueMiniThemeCopy.TryGet(domainKey, Culture.Language);
        var text = copy is not null
            ? $"{copy.Meaning} {copy.Example}"
            : Culture.Format("TestDepthValue.ThemeBody", label);
        if (_next == TestDepthLevel.Deeper && copy is not null)
        {
            text += $" {copy.Energy}";
        }

        return new PreviewTheme(label, text);
    }
}
