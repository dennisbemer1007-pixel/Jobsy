@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Media

<header class="@HeaderClass" style="@StyleValue">
    <div class="cand-hero__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="cand-hero__eyebrow @(CoralEyebrow ? "cand-hero__eyebrow--coral" : null)">@Eyebrow</span>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1 tabindex="@TitleTabIndex">@Title</h1>
        }
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p class="cand-hero__lead">@Lead</p>
        }
        @ChildContent
    </div>
    @if (ShowMobileFiguresImage)
    {
        <div class="cand-hero__mob-figures-wrap" aria-hidden="true">
            <img class="cand-hero__mob-figures"
                 src="@ResolvedMobileFigures"
                 alt=""
                 loading="eager"
                 decoding="async" />
        </div>
    }
    @if (ShowTipsGesprekMobileArt)
    {
        <div class="cand-hero__tips-gesprek-art" aria-hidden="true"></div>
    }
    @if (ShowMediaLayer)
    {
        <div class="cand-hero__media" style="@MediaStyleValue" aria-hidden="true"></div>
    }
</header>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public bool CoralEyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? ArtUrl { get; set; }
    [Parameter] public string? ArtUrlDesktop { get; set; }
    [Parameter] public string? ArtUrlMobile { get; set; }
    [Parameter] public string? ArtUrlMobileFigures { get; set; }
    [Parameter] public string? ArtUrlMobileAtmosphere { get; set; }
    [Parameter] public string ArtPosition { get; set; } = "58% center";
    [Parameter] public string ArtPositionDesktop { get; set; } = "right center";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public int TitleTabIndex { get; set; } = -1;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? ResolvedMobileFigures =>
        !string.IsNullOrWhiteSpace(ArtUrlMobileFigures)
            ? ArtUrlMobileFigures
            : CandidateIllustratedImages.MobileFigureUrl(ArtUrl);

    private bool UsesCompositeMobileHero =>
        CssClass?.Contains("learn-grow", StringComparison.OrdinalIgnoreCase) == true;

    private bool UsesSingleMobileHeroArt =>
        !string.IsNullOrWhiteSpace(ArtUrlMobile) && !ShowTipsGesprekMobileArt;

    private bool ShowTipsGesprekMobileArt =>
        CssClass?.Contains("cand-hero--tips-moment", StringComparison.Ordinal) == true;

    private bool ShowMobileFiguresImage =>
        !UsesCompositeMobileHero
        && !UsesSingleMobileHeroArt
        && !string.IsNullOrWhiteSpace(ResolvedMobileFigures);

    private bool ShowMediaLayer =>
        (UsesCompositeMobileHero && !string.IsNullOrWhiteSpace(ResolvedMobileFigures))
        || (!UsesSingleMobileHeroArt && !string.IsNullOrWhiteSpace(ArtUrl));

    private string HeaderClass
    {
        get
        {
            var parts = new List<string> { "cand-hero" };
            if (!string.IsNullOrWhiteSpace(CssClass))
            {
                parts.Add(CssClass);
            }

            if (ShowMobileFiguresImage)
            {
                parts.Add("cand-hero--with-art");
            }

            return string.Join(' ', parts);
        }
    }

    private string? StyleValue
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ArtUrl)
                && string.IsNullOrWhiteSpace(ArtUrlDesktop)
                && string.IsNullOrWhiteSpace(ArtUrlMobileAtmosphere)
                && string.IsNullOrWhiteSpace(ArtUrlMobile))
            {
                return null;
            }

            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(ArtUrl))
            {
                parts.Add($"--cand-hero-art:url('{ArtUrl}')");
                parts.Add($"--cand-hero-pos:{ArtPosition}");
            }

            if (!string.IsNullOrWhiteSpace(ArtUrlDesktop))
            {
                parts.Add($"--cand-hero-art-desktop:url('{ArtUrlDesktop}')");
                parts.Add($"--cand-hero-pos-desktop:{ArtPositionDesktop}");
            }

            if (!string.IsNullOrWhiteSpace(ArtUrlMobileAtmosphere))
            {
                parts.Add($"--cand-hero-mobile-atmosphere:url('{ArtUrlMobileAtmosphere}')");
            }

            if (!string.IsNullOrWhiteSpace(ArtUrlMobile))
            {
                parts.Add($"--cand-hero-art-mobile:url('{ArtUrlMobile}')");
            }

            return parts.Count == 0 ? null : string.Join(';', parts) + ";";
        }
    }

    private string? MediaStyleValue
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ArtUrl) && string.IsNullOrWhiteSpace(ArtUrlMobileFigures))
            {
                return null;
            }

            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(ArtUrl))
            {
                parts.Add($"--cand-hero-art:url('{ArtUrl}')");
                parts.Add($"--cand-hero-pos:{ArtPosition}");
            }

            if (!string.IsNullOrWhiteSpace(ResolvedMobileFigures))
            {
                parts.Add($"--cand-hero-figures:url('{ResolvedMobileFigures}')");
            }

            return parts.Count == 0 ? null : string.Join(';', parts) + ";";
        }
    }
}
