@namespace Jobsy.Web.Components.Candidate
@using Jobsy.Web.Media

<header class="cand-hero @(string.IsNullOrWhiteSpace(ArtUrl) ? null : "cand-hero--with-art") @CssClass" style="@StyleValue">
    <div class="cand-hero__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="cand-hero__eyebrow @(CoralEyebrow ? "cand-hero__eyebrow--coral" : null)">@Eyebrow</span>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1>@Title</h1>
        }
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p class="cand-hero__lead">@Lead</p>
        }
        @ChildContent
    </div>
    @if (!string.IsNullOrWhiteSpace(ArtUrl))
    {
        <div class="cand-hero__media" style="@MediaStyleValue" aria-hidden="true"></div>
        @if (MobileFigureUrl is not null)
        {
            <img class="cand-hero__mob-figures" src="@MobileFigureUrl" alt="" aria-hidden="true" decoding="async" />
        }
    }
</header>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public bool CoralEyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? ArtUrl { get; set; }
    [Parameter] public string ArtPosition { get; set; } = "58% center";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? MobileFigureUrl => CandidateIllustratedImages.MobileFigureUrl(ArtUrl);

    private string? StyleValue
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ArtUrl))
            {
                return null;
            }

            var style = $"--cand-hero-art:url('{ArtUrl}');--cand-hero-pos:{ArtPosition}";
            if (MobileFigureUrl is not null)
            {
                style += $";--cand-hero-mob-figures:url('{MobileFigureUrl}')";
            }

            return style;
        }
    }

    private string? MediaStyleValue => string.IsNullOrWhiteSpace(ArtUrl)
        ? null
        : $"--cand-hero-art:url('{ArtUrl}');--cand-hero-pos:{ArtPosition}";
}
