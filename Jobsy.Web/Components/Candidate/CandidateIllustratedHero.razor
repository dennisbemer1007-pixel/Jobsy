@namespace Jobsy.Web.Components.Candidate

<header class="cand-hero" style="@StyleValue">
    <div class="cand-hero__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="cand-hero__eyebrow @(CoralEyebrow ? "cand-hero__eyebrow--coral" : null)">@Eyebrow</span>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1>@Title</h1>
        }
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p class="cand-hero__lead">@Lead</p>
        }
        @ChildContent
    </div>
    @if (!string.IsNullOrWhiteSpace(ArtUrl))
    {
        <div class="cand-hero__media" style="--cand-hero-art:url('@ArtUrl');--cand-hero-pos:@ArtPosition" aria-hidden="true"></div>
    }
</header>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public bool CoralEyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? ArtUrl { get; set; }
    [Parameter] public string ArtPosition { get; set; } = "42% 38%";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? StyleValue => string.IsNullOrWhiteSpace(ArtUrl)
        ? null
        : $"--cand-hero-art:url('{ArtUrl}');--cand-hero-pos:{ArtPosition}";
}
