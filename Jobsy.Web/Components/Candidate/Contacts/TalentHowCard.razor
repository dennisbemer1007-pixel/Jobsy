@namespace Jobsy.Web.Components.Candidate.Contacts
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (AsDisclosure)
{
    <details class="career-archive talent-how talent-how--mobile career-only-mobile">
        <summary>@Culture["TalentC.How.Title"]</summary>
        <p class="talent-how__sub">@Culture["TalentC.How.Sub"]</p>
        @Lines
    </details>
}
else
{
    <section class="career-rail talent-how" aria-labelledby="talent-how-title">
        <h2 id="talent-how-title">@Culture["TalentC.How.Title"]</h2>
        <p class="talent-how__sub">@Culture["TalentC.How.Sub"]</p>
        @Lines
    </section>
}

@code {
    /// <summary>Mobile renders the same copy as a disclosure under the list (cr-m6).</summary>
    [Parameter] public bool AsDisclosure { get; set; }

    /// <summary>D8: "paspoort" when the passport flag is on, otherwise "profiel".</summary>
    [Parameter] public bool PassportOn { get; set; }

    private string Word => Culture[PassportOn ? "TalentC.Word.Passport" : "TalentC.Word.Profile"];

    private RenderFragment Lines => @<ul class="talent-how__list">
        <li>
            <span class="talent-how__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21v-7" />
                    <path d="M12 14 5 4" />
                    <path d="m12 14 7-10" />
                    <circle cx="5" cy="3" r="1.4" />
                    <circle cx="19" cy="3" r="1.4" />
                </svg>
            </span>
            <span>@Culture.Format("TalentC.How.Anonymous", Word)</span>
        </li>
        <li>
            <span class="talent-how__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6Z" />
                </svg>
            </span>
            <span>@Culture["TalentC.How.Share"]</span>
        </li>
        <li>
            <span class="talent-how__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </span>
            <span>@Culture["TalentC.How.Time"]</span>
        </li>
        <li>
            <span class="talent-how__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3l18 18" />
                    <path d="M10.6 5.2A9.6 9.6 0 0 1 12 5c5 0 9 4.5 9 7 0 .8-.5 1.9-1.4 3" />
                    <path d="M6.3 7.3C4 8.9 3 11.2 3 12c0 2.5 4 7 9 7 1.5 0 2.9-.4 4.1-1" />
                    <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                </svg>
            </span>
            <span>@Culture["TalentC.How.No"]</span>
        </li>
    </ul>;
}
