@namespace Jobsy.Web.Components.Pages.Candidate.DeepReport
@using Jobsy.Core.Careers
@using Jobsy.Core.Reports
@using Jobsy.Core.Reports.Career
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate
@inject CultureState Culture

@if (Report is not null)
{
    var lang = ReportLanguage.FromUi(Culture.Language);
    <article class="competence-report" aria-label="@DeepReportCatalog.Get("title.career", lang)">
        <header class="competence-report__header">
            <span class="test-status-badge test-status-badge--gold competence-report__badge">
                <span aria-hidden="true">★</span>
                @Culture["Test.Status.Extended"]
            </span>
        </header>

        <section class="competence-report__section">
            <h2 class="test-detail__section-title">@DeepReportCatalog.Get("pdf.overview", lang)</h2>
            <p class="competence-report__summary">@Report.Summary.Resolve(lang)</p>
            <ScoreRadarChart AriaLabel="@DeepReportCatalog.Get("pdf.radar", lang)"
                             Labels="@_labels"
                             Values="@_scores"
                             NormValues="@(Report.ComparisonAvailable ? _norms : null)"
                             NormLegendLabel="@Culture["TestResult.Card.Radar.Sub.Lobsy"]" />
        </section>

        <section class="competence-report__section">
            <h2 class="test-detail__section-title">@DeepReportCatalog.Get("holland.title", lang)</h2>
            <p><strong>@Report.HollandCode</strong></p>
            <p class="muted">@DeepReportCatalog.Format("holland.body", lang, Report.HollandCode,
                string.Join(", ", Report.Domains.OrderByDescending(d => d.Score).Take(3).Select(d => RiasecUi(d.Domain))),
                string.Join(", ", ShownJobs.Take(3).Select(o => o.Title(lang))))</p>
        </section>

        @if (GoalHits.Count > 0)
        {
            <section class="competence-report__section" aria-label="@Culture["Kompas.GoalRow"]">
                <h2 class="test-detail__section-title">@Culture["Kompas.GoalRow"]</h2>
                <ul class="competence-norm-bars">
                    @foreach (var hit in GoalHits)
                    {
                        <li class="competence-norm-bar">
                            <div class="competence-norm-bar__row">
                                <span>@hit.Title</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (ShownJobs.Count > 0)
        {
            <section class="competence-report__section">
                <h2 class="test-detail__section-title">@Culture["TestResult.Card.Occupations"]</h2>
                <ul class="competence-norm-bars">
                    @foreach (var o in ShownJobs)
                    {
                        var explain = ExplainOccupation(o.TitleNl);
                        <li class="competence-norm-bar">
                            @if (explain is not null)
                            {
                                <FitPercentInfo Model="explain" Language="@Culture.Language">
                                    <span>@o.Title(lang)</span>
                                </FitPercentInfo>
                            }
                            else
                            {
                                <div class="competence-norm-bar__row">
                                    <span>@o.Title(lang)</span>
                                </div>
                            }
                            <p class="muted">@o.Reason(lang)</p>
                        </li>
                    }
                </ul>
                <p class="muted">@Culture["Occ.Footnote"]</p>
            </section>
        }

        @if (Report.ComparisonAvailable)
        {
            <section class="competence-report__section">
                <h2 class="test-detail__section-title">@Culture["TestResult.Card.Comparison"]</h2>
                <ul class="competence-norm-bars">
                    @foreach (var d in Report.Domains)
                    {
                        <li class="competence-norm-bar">
                            <div class="competence-norm-bar__row">
                                <span>@RiasecUi(d.Domain)</span>
                                <strong>@d.Score%</strong>
                            </div>
                            @if (d.NormMean is double n)
                            {
                                <p class="muted">Ø @Math.Round(n)%</p>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="competence-report__section">
            <h2 class="test-detail__section-title">@Culture["TestResult.Card.ActionPlan"]</h2>
            @foreach (var step in Report.ActionPlan)
            {
                <h3>@step.Title.Resolve(lang)</h3>
                <p>@step.Body.Resolve(lang)</p>
            }
        </section>

        <section class="competence-report__section">
            <h2 class="test-detail__section-title">@Culture["TestResult.Card.Strengths"]</h2>
            <ul>
                @foreach (var key in Report.StrengthKeys)
                {
                    <li>@StrengthLine(key, lang)</li>
                }
            </ul>
            <ul>
                @foreach (var key in Report.PitfallKeys)
                {
                    <li class="muted">△ @StrengthLine(key, lang)</li>
                }
            </ul>
        </section>

        <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="OnDownloadPdf">
            @Culture["Deep.DownloadPdf"]
        </button>
    </article>
}

@code {
    [Parameter] public CareerDeepReport? Report { get; set; }
    [Parameter] public string? DreamTitle { get; set; }
    [Parameter] public string? GoalEvidence { get; set; }
    [Parameter] public string? EducationLabel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnDownloadPdf { get; set; }

    private IReadOnlyList<CareerGoalFit.Hit> GoalHits
    {
        get
        {
            if (Report is null)
            {
                return [];
            }

            var lang = ReportLanguage.FromUi(Culture.Language);
            var titles = CareerDeepReportBuilder.ShownOccupations(Report, EducationLabel).Select(o => o.Title(lang))
                .Concat(CareerGoalFit.DreamTitles(DreamTitle))
                .ToList();
            return CareerGoalFit.Pick(titles, DreamTitle, GoalEvidence, EducationLabel);
        }
    }

    private string[] _labels = [];
    private int[] _scores = [];
    private int[]? _norms;

    protected override void OnParametersSet()
    {
        if (Report is null)
        {
            return;
        }

        var lang = ReportLanguage.FromUi(Culture.Language);
        _labels = Report.Domains.Select(d => RiasecUi(d.Domain)).ToArray();
        _scores = Report.Domains.Select(d => d.Score).ToArray();
        _norms = Report.ComparisonAvailable
            ? Report.Domains.Select(d => (int)Math.Round(d.NormMean ?? 0)).ToArray()
            : null;
    }

    private IReadOnlyList<DeepOccupationFit> ShownJobs
        => Report is null ? [] : CareerDeepReportBuilder.ShownOccupations(Report, EducationLabel);

    private RiasecScores? ReportScores
    {
        get
        {
            if (Report is null)
            {
                return null;
            }

            int? Score(string code)
            {
                var hit = Report.Domains.FirstOrDefault(domain =>
                    string.Equals(domain.Domain, code, StringComparison.OrdinalIgnoreCase));
                return hit is null ? null : hit.Score;
            }

            return FitPercentExplanation.TryScores(
                Score(CareerTestCatalog.Realistic),
                Score(CareerTestCatalog.Investigative),
                Score(CareerTestCatalog.Artistic),
                Score(CareerTestCatalog.Social),
                Score(CareerTestCatalog.Enterprising),
                Score(CareerTestCatalog.Conventional));
        }
    }

    private FitPercentExplanation? ExplainOccupation(string title)
        => ReportScores is { } scores
            ? FitPercentExplanation.Build(title, scores, EducationLabel)
            : null;

    private string RiasecUi(string domain)
        => Culture[$"Career.Riasec.{domain}"];

    private static string StrengthLine(string key, string lang)
    {
        if (DeepReportCatalog.TryGet(key, lang, out var text))
        {
            return text;
        }

        return DeepReportCatalog.RiasecLabel(key.Split('.').Last(), lang);
    }
}
