@using Jobsy.Web.Onboarding

<div class="ob-start-journey-route" data-testid="onboarding-start-journey-route">
    @* Path coords match vignette centers: (9%,53%) (27%,30%) (49%,55%) (71%,28%) (91%,49%) in 1000×240 viewBox *@
    <svg class="ob-start-journey-route__svg ob-start-journey-route__svg--horizontal" viewBox="0 0 1000 240" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="obStartJourneyStrokeH" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#c4a574" />
                <stop offset="45%" stop-color="#8fb8a8" />
                <stop offset="100%" stop-color="#d4b878" />
            </linearGradient>
        </defs>
        <path d="M 90 122 C 175 122, 220 68, 270 68 S 395 127, 490 127 S 615 62, 710 62 S 820 113, 910 113"
              fill="none"
              stroke="url(#obStartJourneyStrokeH)"
              stroke-width="13"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity="0.62" />
    </svg>
    @* Mobile path through vignette centers with visible S-curves (x swings 34↔86) *@
    <svg class="ob-start-journey-route__svg ob-start-journey-route__svg--vertical" viewBox="0 0 120 620" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="obStartJourneyStrokeV" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#c4a574" />
                <stop offset="50%" stop-color="#8fb8a8" />
                <stop offset="100%" stop-color="#d4b878" />
            </linearGradient>
        </defs>
        <path d="M 86 50 C 86 76, 38 96, 34 174 S 88 234, 86 298 S 34 348, 38 422 C 58 478, 44 520, 40 546"
              fill="none"
              stroke="url(#obStartJourneyStrokeV)"
              stroke-width="9"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity="0.65" />
    </svg>
    <ol class="ob-start-journey-route__stops">
        @foreach (var stop in OnboardingStartJourneyMockCopy.Stops)
        {
            var isCurrent = stop.Number == "1";
            var isSideA = int.Parse(stop.Number) % 2 == 1;
            <li class="ob-start-journey-route__stop ob-start-journey-route__stop--@stop.Number @(isCurrent ? "is-current" : null) @(isSideA ? "is-side-a" : "is-side-b")">
                <div class="ob-start-journey-route__stop-inner">
                    @if (isCurrent)
                    {
                        <span class="ob-start-journey-route__here">@OnboardingStartJourneyMockCopy.HereMarker</span>
                    }
                    <div class="ob-start-journey-route__anchor">
                        <div class="ob-start-journey-route__vignette @(isCurrent ? "is-current" : null)">
                            <img src="@stop.VignettePath" alt="" width="96" height="96" loading="eager" decoding="async" />
                        </div>
                    </div>
                    <div class="ob-start-journey-route__copy">
                        <div class="ob-start-journey-route__label">
                            <p class="ob-start-journey-route__title">@stop.Title</p>
                            <p class="ob-start-journey-route__sub">@stop.Subtitle</p>
                        </div>
                    </div>
                </div>
            </li>
        }
    </ol>
</div>
