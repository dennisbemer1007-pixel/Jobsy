@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Components.Shared.Questionnaire
@using Jobsy.Web.Localization
@inject CultureState Culture

<TestBlockBackground Slug="@_blockArtSlug" Enabled="@(Questions.Count > 0)">
<div class="ob-wizard__test-tabs @(JourneyShell ? "journey-segments" : null)">
    @foreach (var tab in TestTabs)
    {
        var isCurrent = tab.Step == Step;
        var isDone = tab.Step < Step;
        <span class="ob-wizard__test-tab @(isCurrent ? "is-current" : isDone ? "is-done" : null)">
            @if (isDone)
            {
                <span class="ob-wizard__test-tab-check" aria-hidden="true">✓</span>
            }
            <span class="ob-wizard__test-tab-label">@Culture[tab.Title]</span>
        </span>
    }
</div>
@if (!JourneyShell)
{
    @if (Questions.Count > 0)
    {
        <TestBlockMobileHero>
            <h1 tabindex="-1">@(string.IsNullOrWhiteSpace(TitleKey) ? Culture[$"Onboarding.Step{Step}.Title"] : Culture[TitleKey])</h1>
        </TestBlockMobileHero>
    }
    else
    {
        <h1 tabindex="-1">@(string.IsNullOrWhiteSpace(TitleKey) ? Culture[$"Onboarding.Step{Step}.Title"] : Culture[TitleKey])</h1>
    }
    <p class="ob-wizard__lead">@(string.IsNullOrWhiteSpace(LeadKey) ? Culture["Onboarding.Test.Lead"] : Culture[LeadKey])</p>
}
@if (Questions.Count == 0)
{
    <p>@Culture["Onboarding.MiniAllDone"]</p>
}
else
{
    <div class="ob-wizard__card">
    <TestQuestionFlow @key="FlowEpoch"
                      Kind="_kind"
                      Questions="_flowQuestions"
                      Answers="Answers"
                      StartAt="CurrentQuestion"
                      ExternalIndex="CurrentQuestion"
                      Target="Depth"
                      Compact="true"
                      QuestionTitle="@(JourneyShell ? (string.IsNullOrWhiteSpace(TitleKey) ? Culture[$"Onboarding.Step{Step}.Title"] : Culture[TitleKey]) : null)"
                      QuestionLead="@(JourneyShell ? Culture["TestFlow.QuestionLead"] : null)"
                      PartIndex="@(JourneyShell ? Step - 6 : 0)"
                      PartTotal="@(JourneyShell ? 4 : 0)"
                      FinishLabel="@Culture["Onboarding.NextTest"]"
                      InputPrefix="@InputPrefix"
                      AfterLikert="@JourneyAfterLikert"
                      OnAnswer="OnFlowAnswer"
                      OnIndexChanged="OnFlowIndexChanged"
                      OnFinished="OnFlowFinished"
                      OnLeave="OnLeave"
                      OnLater="OnLater"
                      LaterLabel="@LaterLabel"
                      ShowProgressInsight="ShowProgressInsight"
                      DomainForQuestionId="DomainForQuestionId"
                      ProgressInsightChanged="ProgressInsightChanged" />
    </div>
}
@if (!string.IsNullOrWhiteSpace(HintKey) && ShowHint && !JourneyShell)
{
    <p class="journey-deeper-hint">@Culture[HintKey]</p>
}
</TestBlockBackground>

@code {
    public sealed record TestTab(int Step, string Title, string Lead);
    public sealed record MiniQuestion(int Id, string TextKey);

    [Parameter] public int Step { get; set; }
    [Parameter] public int FlowEpoch { get; set; }
    [Parameter] public int CurrentQuestion { get; set; }
    [Parameter] public IReadOnlyList<TestTab> TestTabs { get; set; } = [];
    [Parameter] public IReadOnlyList<MiniQuestion> Questions { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<int, int> Answers { get; set; } = new Dictionary<int, int>();
    [Parameter] public string InputPrefix { get; set; } = "obv2-";
    [Parameter] public string? TitleKey { get; set; }
    [Parameter] public string? LeadKey { get; set; }
    [Parameter] public string? HintKey { get; set; }
    [Parameter] public bool ShowHint { get; set; }
    [Parameter] public bool ShowQuestionCounter { get; set; }
    [Parameter] public bool JourneyShell { get; set; }
    [Parameter] public TestDepthLevel Depth { get; set; } = TestDepthLevel.First;
    [Parameter] public EventCallback<(int Id, int Value)> Answer { get; set; }
    [Parameter] public EventCallback OnFinished { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public EventCallback OnLater { get; set; }
    [Parameter] public string? LaterLabel { get; set; }
    [Parameter] public EventCallback<int> ExpandQuestion { get; set; }
    [Parameter] public Func<MiniQuestion, string>? ResolveQuestionText { get; set; }
    [Parameter] public RenderFragment? JourneyAfterLikert { get; set; }
    [Parameter] public bool ShowProgressInsight { get; set; }
    [Parameter] public Func<int, string>? DomainForQuestionId { get; set; }
    [Parameter] public EventCallback<TestQuestionFlow.ProgressInsightSnapshot> ProgressInsightChanged { get; set; }

    private AssessmentKind _kind = AssessmentKind.Competence;
    private string _blockArtSlug = TestBlockArt.SlugForFamily(TestBlockFamily.HoeJeWerkt);
    private List<TestQuestionFlow.FlowQuestion> _flowQuestions = [];

    protected override void OnParametersSet()
    {
        _kind = Step switch
        {
            8 => AssessmentKind.Career,
            9 => AssessmentKind.Culture,
            10 => AssessmentKind.Values,
            _ => AssessmentKind.Competence
        };
        _blockArtSlug = TestBlockArt.SlugForAssessment(_kind);
        _flowQuestions = Questions
            .Select(q => new TestQuestionFlow.FlowQuestion(q.Id, QuestionText(q)))
            .ToList();
    }

    private string QuestionText(MiniQuestion question)
        => ResolveQuestionText?.Invoke(question) ?? Culture[question.TextKey];

    private Task OnFlowAnswer((int Id, int Value) pair)
        => Answer.InvokeAsync(pair);

    private Task OnFlowIndexChanged(int index)
        => ExpandQuestion.HasDelegate ? ExpandQuestion.InvokeAsync(index) : Task.CompletedTask;

    private Task OnFlowFinished()
        => OnFinished.InvokeAsync();
}
