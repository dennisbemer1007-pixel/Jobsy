@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Models
@inject CultureState Culture

@if (Signal is not null && !Signal.EmployersFeatureOff)
{
    @if (Layout == NearbyPanelLayout.Desktop)
    {
        <div class="ob-nearby-panel ob-nearby-panel--desktop"
             data-testid="onboarding-nearby-panel-desktop"
             aria-live="polite">
            <p class="ob-nearby-panel__headline">@HeadlineMarkup()</p>
            @ExamplesBlock(compact: false)
            @if (Signal!.Count > 0)
            {
                <div class="ob-nearby-panel__map-teaser" aria-hidden="true">
                    <svg class="ob-nearby-panel__map-svg" viewBox="0 0 240 120" preserveAspectRatio="xMidYMid slice">
                        <defs>
                            <linearGradient id="ob-nearby-map-bg" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#F3EEE4"/>
                                <stop offset="1" stop-color="#ECE5D7"/>
                            </linearGradient>
                            <radialGradient id="ob-nearby-map-ring" cx="50%" cy="55%" r="42%">
                                <stop offset="0" stop-color="#2F7D5B" stop-opacity=".16"/>
                                <stop offset="1" stop-color="#2F7D5B" stop-opacity=".02"/>
                            </radialGradient>
                        </defs>
                        <rect width="240" height="120" fill="url(#ob-nearby-map-bg)" rx="8"/>
                        <circle cx="120" cy="62" r="46" fill="url(#ob-nearby-map-ring)" stroke="#2F7D5B" stroke-opacity=".35" stroke-width="1" stroke-dasharray="4 5"/>
                        <circle cx="120" cy="62" r="4" fill="#2F7D5B"/>
                        <circle cx="92" cy="48" r="3" fill="#C45C26" opacity=".85"/>
                        <circle cx="148" cy="54" r="3" fill="#C45C26" opacity=".85"/>
                        <circle cx="108" cy="78" r="3" fill="#C45C26" opacity=".75"/>
                        <circle cx="138" cy="72" r="3" fill="#C45C26" opacity=".75"/>
                    </svg>
                    <span class="ob-nearby-panel__map-caption">@Culture["Onboarding.Panel.Nearby.MapCaption"]</span>
                </div>
                <p class="ob-nearby-panel__footnote">@Culture["Onboarding.Panel.Nearby.Footnote"]</p>
            }
        </div>
    }
    else
    {
        <p class="ob-nearby-panel ob-nearby-panel--mobile ob-nearby-panel__mobile-static"
           data-testid="onboarding-nearby-panel-mobile"
           aria-live="polite">
            @MobileLineText()
        </p>
    }
}

@code {
    public enum NearbyPanelLayout { Desktop, Mobile }

    [Parameter] public NearbyPanelLayout Layout { get; set; }
    [Parameter] public OnboardingNearbySignal? Signal { get; set; }
    [Parameter] public string TransportLabel { get; set; } = "";
    [Parameter] public bool RefinedHeadline { get; set; }

    private MarkupString HeadlineMarkup()
    {
        var count = Signal!.Count;
        if (count > 0)
        {
            var key = RefinedHeadline
                ? "Onboarding.Panel.Nearby.TitleRefined"
                : "Onboarding.Panel.Nearby.TitleInitial";
            return (MarkupString)Culture.Format(key, count);
        }

        return (MarkupString)Culture["Onboarding.Panel.Nearby.TitleZero"];
    }

    private string MobileLineText()
    {
        if (Signal!.Count > 0)
        {
            return Culture.Format("Onboarding.Panel.Nearby.MobileLine", Signal.Count);
        }

        return Culture["Onboarding.Panel.Nearby.MobileZero"];
    }

    private RenderFragment ExamplesBlock(bool compact) => __builder =>
    {
        if (Signal!.Examples.Count == 0)
        {
            return;
        }

        __builder.OpenElement(0, "ul");
        __builder.AddAttribute(1, "class", compact ? "ob-nearby-panel__list ob-nearby-panel__list--compact" : "ob-nearby-panel__list");
        foreach (var job in Signal.Examples)
        {
            __builder.OpenElement(2, "li");
            __builder.AddAttribute(3, "class", "ob-nearby-panel__item");
            __builder.OpenElement(4, "span");
            __builder.AddAttribute(5, "class", "ob-nearby-panel__title");
            __builder.AddContent(6, job.Title);
            __builder.CloseElement();
            __builder.OpenElement(7, "span");
            __builder.AddAttribute(8, "class", "ob-nearby-panel__meta");
            __builder.AddContent(9, FormatJobMeta(job));
            __builder.CloseElement();
            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    private static string FormatKm(double km)
        => km.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("nl-NL")).Replace('.', ',') + " km";

    private string FormatJobMeta(OnboardingNearbyVacancyCard job)
    {
        var parts = new List<string> { FormatKm(job.DistanceKm) };
        if (job.TravelMinutes is > 0)
        {
            parts.Add(FormatTravel(job.TravelMinutes));
        }

        return string.Join(" · ", parts);
    }

    private string FormatTravel(int minutes)
    {
        var mode = TravelReach.Fastest(TransportLabels.ParseMany(TransportLabel));
        var key = mode switch
        {
            TransportMode.Walking => "Onboarding.Early.Nearby.JobTravelWalk",
            TransportMode.Car => "Onboarding.Early.Nearby.JobTravelCar",
            TransportMode.PublicTransport => "Onboarding.Early.Nearby.JobTravelTransit",
            TransportMode.Bike => "Onboarding.Early.Nearby.JobTravelBike",
            _ => "Onboarding.Early.Nearby.JobTravelGeneric",
        };
        return Culture.Format(key, minutes);
    }
}
