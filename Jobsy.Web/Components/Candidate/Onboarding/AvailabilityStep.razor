@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (!Illustrated)
{
<h1 tabindex="-1">@Culture["Onboarding.Step2.Title"]</h1>
<p class="ob-wizard__lead">@Culture["Onboarding.Step2.Lead"]</p>
}

<div class="ob-wizard__card @(Illustrated ? "ob-wizard__card--illustrated" : null)">
<section class="ob-wizard__section" id="onboarding-field-availability-presets" aria-labelledby="ob-avail-presets">
    <h2 id="ob-avail-presets" class="ob-wizard__section-title">@Culture["Onboarding.AvailabilityPresetsLegend"]</h2>
    <p class="ob-wizard__hint ob-wizard__section-hint">@Culture["Onboarding.AvailabilityPresetsHint"]</p>
    <fieldset class="ob-wizard__presets-field">
        <legend class="visually-hidden">@Culture["Onboarding.AvailabilityPresetsLegend"]</legend>
        <ChoiceTileGrid Class="ob-wizard__presets" DesktopThreeColumns="false" AriaLabel="@Culture["Onboarding.AvailabilityPresetsLegend"]">
            @foreach (var preset in Presets)
            {
                var isSelected = Draft.Presets.Contains(preset.Code);
                <ChoiceTile Tall="true"
                            Icon="@ChoiceTileIcons.ForAvailabilityPreset(preset.Code)"
                            Selected="isSelected"
                            ShowCheckBadge="true"
                            OnClick="@(() => TogglePreset.InvokeAsync(preset.Code))">
                    <strong>@Culture[preset.Title]</strong>
                    <small>@Culture[preset.Lead]</small>
                </ChoiceTile>
            }
        </ChoiceTileGrid>
        @if (ShowValidation && !HasSelection)
        {
            <p class="error ob-wizard__preset-required" role="alert">@Culture["Onboarding.AvailabilityRequired"]</p>
        }
    </fieldset>
</section>

@if (HasSelection && !CustomMode)
{
    <section class="ob-wizard__availability-summary" aria-labelledby="ob-avail-summary">
        <div class="ob-wizard__summary-head">
            <strong id="ob-avail-summary">@Culture["Onboarding.AvailabilitySummaryTitle"]</strong>
            <button type="button"
                    class="ob-wizard__summary-action"
                    aria-expanded="@(Draft.FineTune ? "true" : "false")"
                    @onclick="OnFineTuneClickAsync">
                @(Draft.FineTune ? Culture["Onboarding.AvailabilityFineTuneClose"] : Culture["Onboarding.AvailabilityFineTuneCta"])
            </button>
        </div>
        <dl>
            <div>
                <dt>@Culture["Vacancy.HoursPerWeek"]</dt>
                <dd>@HoursLabel</dd>
            </div>
            <div>
                <dt>@Culture["Profile.Availability"]</dt>
                <dd>@DaysSummary</dd>
            </div>
            <div>
                <dt>@Culture["Onboarding.AvailabilityStartSummary"]</dt>
                <dd>@StartSummary</dd>
            </div>
        </dl>
    </section>
}

@if (ShowMatrix)
{
    <section class="ob-wizard__fine-tune @(CustomMode ? "ob-wizard__fine-tune--custom" : null)"
             id="onboarding-field-availability-grid"
             aria-labelledby="ob-avail-finetune">
        <h2 id="ob-avail-finetune" class="ob-wizard__section-title">
            @(CustomMode ? Culture["Onboarding.Preset.Custom.GridLegend"] : Culture["Onboarding.AvailabilityFineTuneLegend"])
        </h2>
        @if (CustomMode)
        {
            <p class="ob-wizard__hint ob-wizard__section-hint">@Culture["Onboarding.Preset.Custom.GridHint"]</p>
        }
        <HoursRangeSlider CssClass="hours-range--compact"
                          Min="1"
                          Max="60"
                          Low="@MinHoursSlider"
                          High="@MaxHoursSlider"
                          LowChanged="SetMinHours"
                          HighChanged="SetMaxHours"
                          RangeCommitted="ManualAvailability"
                          MinLabel="@Culture["Onboarding.MinHours"]"
                          MaxLabel="@Culture["Onboarding.MaxHours"]"
                          UnitLabel="@Culture["Onboarding.Hours"]" />
        <fieldset>
            <legend>@Culture["Profile.Availability"]</legend>
            <p class="ob-wizard__hint">@Culture["Onboarding.AvailabilityMatrixHint"]</p>
            <AvailabilityDayPartMatrix SelectedKeys="Draft.Availability"
                                       UseButtons="true"
                                       CssClass="availability-matrix--touch"
                                       AriaLabel="@Culture["Profile.Availability"]"
                                       OnToggle="ToggleAvailability" />
        </fieldset>
        @if (ShowValidation && Draft.Availability.Count == 0)
        {
            <p class="error" role="alert">@Culture["Onboarding.Validation.AvailabilityGrid"]</p>
        }
        @if (Draft.PresetsOverridden)
        {
            <p class="ob-wizard__hint">
                @Culture["Onboarding.ManualOverride"]
                <button type="button" class="ob-wizard__inline-link" @onclick="OnResetPresetsClickAsync">
                    @Culture["Onboarding.Refill"]
                </button>
            </p>
        }
    </section>
}

<AvailabilityStartSection Immediate="Draft.Immediate"
                            ImmediateChanged="OnImmediateChanged"
                            AvailableFrom="Draft.AvailableFrom"
                            AvailableFromChanged="OnAvailableFromChanged"
                            ShowValidation="ShowValidation" />

@if (ShowValidation && !StartDateValid && !Draft.Immediate)
{
    <p class="error ob-wizard__start-date-error" id="onboarding-field-availability-start" role="alert">@Culture["Onboarding.AvailabilityStartDateInvalid"]</p>
}
</div>

@code {
    public sealed record Preset(string Code, string Title, string Lead);

    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public IReadOnlyList<Preset> Presets { get; set; } = [];
    [Parameter] public EventCallback<string> TogglePreset { get; set; }
    [Parameter] public EventCallback ToggleFineTune { get; set; }
    [Parameter] public EventCallback<int> SetMinHours { get; set; }
    [Parameter] public EventCallback<int> SetMaxHours { get; set; }
    [Parameter] public EventCallback ManualAvailability { get; set; }
    [Parameter] public EventCallback<string> ToggleAvailability { get; set; }
    [Parameter] public EventCallback ResetPresets { get; set; }
    [Parameter] public bool ShowValidation { get; set; }
    [Parameter] public bool Illustrated { get; set; }

    private bool CustomMode => Draft.Presets.Contains(AvailabilityPresetRules.Custom);
    private bool ShowMatrix => CustomMode || Draft.FineTune;

    private int MinHoursSlider => decimal.ToInt32(Draft.MinHours ?? 1);
    private int MaxHoursSlider => decimal.ToInt32(Draft.MaxHours ?? 60);
    private bool HasSelection => Draft.Presets.Count > 0 || Draft.Availability.Count > 0;
    private bool StartDateValid => AvailabilityStartRules.StepIsValid(Draft.Immediate, Draft.AvailableFrom);
    private bool AvailabilityValid => Draft.MinHours is > 0
                                      && Draft.MaxHours >= Draft.MinHours
                                      && Draft.Availability.Count > 0
                                      && StartDateValid;

    private string HoursLabel => Draft.MinHours is not null && Draft.MaxHours is not null
        ? $"{Draft.MinHours:0} – {Draft.MaxHours:0} {Culture["Onboarding.Hours"]}" : "–";
    private string DaysSummary => Draft.Availability.Count == 0
        ? "–" : Culture.Format("Onboarding.DayPartsCount", Draft.Availability.Count);
    private string StartSummary => Draft.Immediate
        ? Culture["Onboarding.AvailableImmediate"]
        : Draft.AvailableFrom is { } d
            ? AvailabilityStartRules.FormatDisplayDate(d, Culture.Language)
            : "–";

    private Task NotifyAsync() => Draft.NotifyChangedAsync();

    private async Task OnImmediateChanged(bool value)
    {
        Draft.Immediate = value;
        if (value)
        {
            Draft.AvailableFrom = null;
        }

        await NotifyAsync();
    }

    private async Task OnAvailableFromChanged(DateOnly? value)
    {
        Draft.AvailableFrom = value;
        await NotifyAsync();
    }

    private Task OnFineTuneClickAsync()
    {
        Draft.FineTune = !Draft.FineTune;
        return ToggleFineTune.HasDelegate ? ToggleFineTune.InvokeAsync() : NotifyAsync();
    }

    private Task OnResetPresetsClickAsync() => ResetPresets.InvokeAsync();
}
