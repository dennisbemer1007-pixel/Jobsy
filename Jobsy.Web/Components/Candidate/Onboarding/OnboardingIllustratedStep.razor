@namespace Jobsy.Web.Components.Candidate.Onboarding

<section class="ob-illustrated-step" data-testid="@TestId">
    <div class="ob-illustrated-step__hero-band">
        <div class="ob-illustrated-step__hero-bg" aria-hidden="true" data-testid="onboarding-illustration-mobile-bg">
            <picture>
                <source media="(max-width: 1023px)" type="image/webp" srcset="@MobileBgWebpSrc" />
                <source media="(max-width: 1023px)" srcset="@MobileBgPngSrc" />
                <img src="@MobileBgPngSrc" alt="" loading="eager" decoding="async" tabindex="-1" />
            </picture>
        </div>
        @if (HeadContent is not null)
        {
            <div class="ob-illustrated-step__head">
                @HeadContent
            </div>
        }
        <div class="ob-illustrated-step__art" aria-hidden="true" data-testid="onboarding-illustration-art">
            <span class="ob-illustrated-step__art-img-wrap">
                <picture>
                    <source media="(min-width: 1024px)" type="image/webp" srcset="@WebpSrc" />
                    <source media="(max-width: 1023px)" type="image/webp" srcset="@MobileWebpSrc" />
                    <source media="(min-width: 1024px)" srcset="@JpgSrc" />
                    <source media="(max-width: 1023px)" srcset="@MobilePngSrc" />
                    <img src="@JpgSrc"
                         alt=""
                         width="@ImageWidth"
                         height="@ImageHeight"
                         loading="eager"
                         fetchpriority="high"
                         decoding="async"
                         tabindex="-1"
                         data-testid="onboarding-illustration-img" />
                </picture>
            </span>
        </div>
    </div>
    <div class="ob-illustrated-step__body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string WebpSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string JpgSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string MobileBgWebpSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string MobileBgPngSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string MobileWebpSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string MobilePngSrc { get; set; } = default!;
    [Parameter] public int ImageWidth { get; set; } = 1280;
    [Parameter] public int ImageHeight { get; set; } = 720;
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? HeadContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
