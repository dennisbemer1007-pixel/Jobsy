@namespace Jobsy.Web.Components.Candidate.Onboarding

<section class="ob-illustrated-step" data-testid="@TestId">
    <div class="ob-illustrated-step__stage">
        <div class="ob-illustrated-step__art" aria-hidden="true">
            <picture>
                <source type="image/webp" srcset="@WebpSrc" />
                <img src="@JpgSrc"
                     alt=""
                     width="@ImageWidth"
                     height="@ImageHeight"
                     loading="lazy"
                     decoding="async"
                     tabindex="-1" />
            </picture>
        </div>
        @if (HeadContent is not null)
        {
            <div class="ob-illustrated-step__head">
                @HeadContent
            </div>
        }
        <div class="ob-illustrated-step__overlay">
            @ChildContent
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string WebpSrc { get; set; } = default!;
    [Parameter, EditorRequired] public string JpgSrc { get; set; } = default!;
    [Parameter] public int ImageWidth { get; set; } = 1280;
    [Parameter] public int ImageHeight { get; set; } = 720;
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? HeadContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
