@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Careers
@using Jobsy.Core.Options
@using Jobsy.Core.Rules
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Components.Web
@inject IConfiguration Config
@inject IHostEnvironment HostEnv
@using Jobsy.Web.Localization
@using Jobsy.Web.Onboarding
@inject CultureState Culture

@if (IllustrationEnabled)
{
    <OnboardingIllustratedStep WebpSrc="@OnboardingIllustrationAssets.DreamJobWebp"
                               JpgSrc="@OnboardingIllustrationAssets.DreamJobJpg"
                               TestId="dream-job-step-illustrated">
        <HeadContent>
            @RenderHeading
        </HeadContent>
        <ChildContent>
        @if (Config.GetValue(OccupationCatalog.PreviewConfigKey, false) && !HostEnv.IsProduction())
        {
            <p class="muted" role="status">@Culture["Occ.PreviewBanner"]</p>
        }
        <div class="ob-illustrated-step__form">
            <DreamJobSearchField @ref="_searchField"
                                 TestId="dream-job-search"
                                 Query="@Draft.DreamSearch"
                                 Young="Young"
                                 Education="@Draft.Education"
                                 HighlightIndex="_highlightIndex"
                                 ChooseDream="ChooseDream"
                                 ChooseTitle="ChooseTitle"
                                 ChooseOwnDream="ChooseOwnDream"
                                 OnInput="OnIllustratedSearchInput"
                                 OnKeyDown="HandleSearchKeyDown" />
            <div class="ob-dream-sfeer__chips" data-testid="dream-inspiration-chips">
                <p class="ob-dream-sfeer__chips-label">@Culture["Onboarding.Step6.InspirationLabel"]</p>
                @foreach (var chip in DreamJobIllustrationChips.Default)
                {
                    var selected = string.Equals(Draft.Dream, chip.TitleNl, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="ob-dream-sfeer__chip @(selected ? "is-selected" : null)"
                            aria-pressed="@(selected ? "true" : "false")"
                            data-testid="dream-inspiration-chip"
                            @onclick="() => PickInspirationAsync(chip.TitleNl)">
                        @ChipLabel(chip)
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Draft.Dream))
            {
                <p class="ob-dream-sfeer__confirm" role="status" data-testid="dream-job-confirm">
                    @Culture["Onboarding.Step6.DreamConfirm"]
                </p>
            }
        </div>
        </ChildContent>
    </OnboardingIllustratedStep>
}
else
{
    @RenderHeading
    <div class="ob-wizard__card" data-testid="dream-job-step-classic">
        @if (Config.GetValue(OccupationCatalog.PreviewConfigKey, false) && !HostEnv.IsProduction())
        {
            <p class="muted" role="status">@Culture["Occ.PreviewBanner"]</p>
        }
        <DreamJobSearchField @ref="_searchField"
                             WrapperClass="ob-wizard__dream-search"
                             Query="@Draft.DreamSearch"
                             Young="Young"
                             Education="@Draft.Education"
                             HighlightIndex="_highlightIndex"
                             ChooseDream="ChooseDream"
                             ChooseTitle="ChooseTitle"
                             ChooseOwnDream="ChooseOwnDream"
                             OnInput="OnClassicSearchInput"
                             OnKeyDown="HandleSearchKeyDown" />
        @if (ShowChosenChip)
        {
            <p class="journey-chip is-selected" role="status">@Draft.Dream</p>
        }
        @if (Young)
        {
            <div class="ob-wizard__dream-grid">
                @foreach (var dreamJob in DreamJobCatalog.All)
                {
                    var isSelected = Draft.Dream == dreamJob.TitleNl;
                    <button type="button" aria-pressed="@(isSelected ? "true" : "false")"
                            class="@(isSelected ?"is-selected" : null)"
                            @onclick="() => ChooseDream.InvokeAsync(dreamJob)">
                        <span>@((MarkupString)(DreamJobIcons.TryGet(dreamJob.IconKey) ?? ""))</span>
                        <small>@Culture[$"DreamJob.{dreamJob.Key}"]</small>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private int _highlightIndex = -1;
    private DreamJobSearchField? _searchField;

    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public EventCallback<DreamJob> ChooseDream { get; set; }
    [Parameter] public EventCallback<string> ChooseTitle { get; set; }
    [Parameter] public EventCallback<string> ChooseInspiration { get; set; }
    [Parameter] public EventCallback ChooseOwnDream { get; set; }
    [Parameter] public bool Young { get; set; }

    private bool ShowChosenChip =>
        !string.IsNullOrWhiteSpace(Draft.Dream)
        && (!Young || DreamJobCatalog.All.All(job => job.TitleNl != Draft.Dream));
    [Parameter] public EventCallback<KeyboardEventArgs> DreamKeyDown { get; set; }
    [Parameter] public string? TitleKey { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public bool ShowLead { get; set; } = true;
    [Parameter] public bool AsSubsection { get; set; }

    private bool IllustrationEnabled =>
        DreamJobIllustrationGate.IsEnabled(Config[DreamJobIllustrationOptions.EnabledKey]);

    private bool TypeaheadOpen => !string.IsNullOrWhiteSpace(Draft.DreamSearch);

    private DreamJobTypeahead? ActiveTypeahead => _searchField?.Typeahead;

    private RenderFragment RenderHeading => __builder =>
    {
        if (!ShowHeading)
        {
            return;
        }

        if (AsSubsection)
        {
            __builder.OpenElement(0, "h2");
            __builder.AddAttribute(1, "class", "ob-wizard__subhead");
            __builder.AddContent(2, TitleKey is null ? Culture["Onboarding.Step6.Title"] : Culture[TitleKey]);
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(3, "h1");
            __builder.AddAttribute(4, "tabindex", "-1");
            __builder.AddContent(5, TitleKey is null ? Culture["Onboarding.Step6.Title"] : Culture[TitleKey]);
            __builder.CloseElement();
        }

        if (ShowLead)
        {
            __builder.OpenElement(6, "p");
            __builder.AddAttribute(7, "class", "ob-wizard__lead");
            __builder.AddContent(8, Culture["Onboarding.Step6.Lead"]);
            __builder.CloseElement();
        }
    };

    private string ChipLabel(DreamJobInspirationChip chip)
    {
        if (!string.IsNullOrEmpty(chip.LabelResourceKey))
        {
            return Culture[chip.LabelResourceKey];
        }

        if (!string.IsNullOrEmpty(chip.DreamJobCatalogKey))
        {
            return Culture[$"DreamJob.{chip.DreamJobCatalogKey}"];
        }

        return chip.TitleNl;
    }

    private async Task PickInspirationAsync(string titleNl)
    {
        ResetTypeaheadHighlight();
        if (ChooseInspiration.HasDelegate)
        {
            await ChooseInspiration.InvokeAsync(titleNl);
            return;
        }

        await ChooseTitle.InvokeAsync(titleNl);
        Draft.DreamSearch = titleNl.Trim()[..Math.Min(128, titleNl.Trim().Length)];
    }

    private void OnIllustratedSearchInput(ChangeEventArgs e)
    {
        Draft.DreamSearch = e.Value?.ToString() ?? "";
        var trimmed = Draft.DreamSearch.Trim();
        Draft.Dream = trimmed.Length == 0 ? "" : trimmed[..Math.Min(128, trimmed.Length)];
        ResetTypeaheadHighlight();
    }

    private void OnClassicSearchInput(ChangeEventArgs e)
    {
        Draft.DreamSearch = e.Value?.ToString() ?? "";
        ResetTypeaheadHighlight();
    }

    private void ResetTypeaheadHighlight() => _highlightIndex = -1;

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (TypeaheadOpen && ActiveTypeahead is not null)
        {
            var maxIndex = ActiveTypeahead.OwnOptionIndex;
            switch (e.Key)
            {
                case "ArrowDown":
                    _highlightIndex = _highlightIndex >= maxIndex ? 0 : _highlightIndex + 1;
                    if (_highlightIndex < 0)
                    {
                        _highlightIndex = 0;
                    }

                    return;
                case "ArrowUp":
                    _highlightIndex = _highlightIndex <= 0 ? maxIndex : _highlightIndex - 1;
                    return;
                case "Enter":
                    if (_highlightIndex >= 0)
                    {
                        await SelectHighlightedAsync();
                        return;
                    }

                    if (Draft.DreamSearch.Length > 0)
                    {
                        await ChooseOwnDream.InvokeAsync();
                        return;
                    }

                    break;
                case "Escape":
                    Draft.DreamSearch = "";
                    Draft.Dream = "";
                    ResetTypeaheadHighlight();
                    return;
            }
        }

        if (DreamKeyDown.HasDelegate)
        {
            await DreamKeyDown.InvokeAsync(e);
        }
    }

    private async Task SelectHighlightedAsync()
    {
        if (ActiveTypeahead is null || _highlightIndex < 0)
        {
            return;
        }

        if (Young)
        {
            var hits = DreamJobCatalog.Search(Draft.DreamSearch, 6);
            if (_highlightIndex < hits.Count)
            {
                await ChooseDream.InvokeAsync(hits[_highlightIndex]);
                ResetTypeaheadHighlight();
                return;
            }
        }
        else
        {
            var hits = OccupationCatalog.Shared.Search(Draft.DreamSearch, 6, Draft.Education);
            if (_highlightIndex < hits.Count)
            {
                await ChooseTitle.InvokeAsync(hits[_highlightIndex].Title);
                ResetTypeaheadHighlight();
                return;
            }
        }

        if (_highlightIndex == ActiveTypeahead.OwnOptionIndex)
        {
            await ChooseOwnDream.InvokeAsync();
            ResetTypeaheadHighlight();
        }
    }
}
