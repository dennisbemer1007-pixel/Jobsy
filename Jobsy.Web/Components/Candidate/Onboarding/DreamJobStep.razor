@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (ShowHeading)
{
    @if (AsSubsection)
    {
        <h2 class="ob-wizard__subhead">@(TitleKey is null ? Culture["Onboarding.Step6.Title"] : Culture[TitleKey])</h2>
    }
    else
    {
        <h1 tabindex="-1">@(TitleKey is null ? Culture["Onboarding.Step6.Title"] : Culture[TitleKey])</h1>
    }
    @if (ShowLead)
    {
        <p class="ob-wizard__lead">@Culture["Onboarding.Step6.Lead"]</p>
    }
}
<div class="ob-wizard__dream-search">
    <input role="combobox"
           aria-expanded="@(Draft.DreamSearch.Length > 0)"
           aria-autocomplete="list"
           placeholder="@Culture["Onboarding.DreamSearch"]"
           @bind="Draft.DreamSearch"
           @bind:event="oninput"
           @onkeydown="DreamKeyDown" />
    @if (Draft.DreamSearch.Length > 0)
    {
        <div role="listbox">
            @foreach (var dreamJob in DreamJobCatalog.Search(Draft.DreamSearch))
            {
                <button type="button" role="option" @onclick="() => ChooseDream.InvokeAsync(dreamJob)">
                    @((MarkupString)(DreamJobIcons.TryGet(dreamJob.IconKey) ?? ""))
                    <span>@Culture[$"DreamJob.{dreamJob.Key}"]</span>
                </button>
            }
            <button type="button" @onclick="ChooseOwnDream">
                ＋ @Culture.Format("Onboarding.DreamOwn", Draft.DreamSearch.Trim())
            </button>
        </div>
    }
</div>
<div class="ob-wizard__dream-grid">
    @foreach (var dreamJob in DreamJobCatalog.All)
    {
        var isSelected = Draft.Dream == dreamJob.TitleNl;
        <button type="button" aria-pressed="@isSelected"
                class="@(isSelected ? "is-selected" : null)"
                @onclick="() => ChooseDream.InvokeAsync(dreamJob)">
            <span>@((MarkupString)(DreamJobIcons.TryGet(dreamJob.IconKey) ?? ""))</span>
            <small>@Culture[$"DreamJob.{dreamJob.Key}"]</small>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public EventCallback<DreamJob> ChooseDream { get; set; }
    [Parameter] public EventCallback ChooseOwnDream { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> DreamKeyDown { get; set; }
    /// <summary>Optional override title key (journey: Discovery.Step4.DreamTitle).</summary>
    [Parameter] public string? TitleKey { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public bool ShowLead { get; set; } = true;
    [Parameter] public bool AsSubsection { get; set; }
}
