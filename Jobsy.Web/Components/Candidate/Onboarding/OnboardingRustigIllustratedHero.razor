@* Decorative illustrated hero (step 6 droom, kompas); pointer-events none. *@

<div class="ob-rustig__illustrated-hero" data-testid="ob-rustig-hero" aria-hidden="true">
    <picture class="ob-rustig__illustrated-frame">
        <source media="(max-width: 1023px)" srcset="@MobileUrl" />
        <source media="(min-width: 1024px)" srcset="@DesktopUrl" />
        <img src="@DesktopUrl"
             alt=""
             width="@ImgWidth"
             height="@ImgHeight"
             loading="@ImgLoading"
             decoding="@ImgDecoding"
             fetchpriority="@FetchPriority"
             data-testid="ob-rustig-hero-img" />
    </picture>
</div>

@code {
    [Parameter, EditorRequired] public string DesktopUrl { get; set; } = "";
    [Parameter, EditorRequired] public string MobileUrl { get; set; } = "";
    [Parameter] public string ImgLoading { get; set; } = "lazy";
    [Parameter] public string ImgDecoding { get; set; } = "async";
    [Parameter] public string FetchPriority { get; set; } = "high";
    [Parameter] public int ImgWidth { get; set; } = 3500;
    [Parameter] public int ImgHeight { get; set; } = 1000;
}
