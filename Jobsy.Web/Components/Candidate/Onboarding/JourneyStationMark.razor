@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Web.Localization
@inject CultureState Culture

<span class="ob-journey__mark ob-journey__mark--@Status" role="img" aria-label="@AriaLabel">
    @if (Status == "done")
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="8" class="ob-journey__mark-fill" />
            <path class="ob-journey__mark-check" d="M4.25 8.15 6.65 10.55 11.75 5.45" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="6.25" class="ob-journey__mark-ring" fill="none" stroke-width="1.5" />
        </svg>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "todo";

    private string AriaLabel => Status switch
    {
        "done" => Culture["Onboarding.Journey.Status.Done"],
        "next" => Culture["Onboarding.Journey.Status.Current"],
        _ => Culture["Onboarding.Journey.Status.Upcoming"]
    };
}
