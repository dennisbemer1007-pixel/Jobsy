@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (ShowHeading)
{
    <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
    <h1 tabindex="-1">@Culture["Onboarding.Step5.Title"]</h1>
    <p class="ob-wizard__lead">@Culture["Onboarding.Step5.Lead"]</p>
}

<section class="ob-wizard__section" aria-labelledby="ob-edu-level">
    <h2 id="ob-edu-level" class="ob-wizard__section-title">@Culture["Onboarding.EducationPickLevel"]</h2>
    <div class="ob-wizard__education-grid" role="radiogroup" aria-labelledby="ob-edu-level">
        @foreach (var level in OnboardingWizardCatalog.EducationRadioLevels)
        {
            var isSelected = EducationSelected(level);
            <button type="button"
                    role="radio"
                    aria-checked="@(isSelected ? "true" : "false")"
                    class="@(isSelected ? "is-selected" : null)"
                    @onclick="() => SelectEducation.InvokeAsync(level)">
                @EducationLabel(level)
            </button>
        }
    </div>
</section>

@if (Draft.Education.StartsWith("MBO", StringComparison.Ordinal))
{
    <section class="ob-wizard__section" aria-labelledby="ob-edu-mbo">
        <h2 id="ob-edu-mbo" class="ob-wizard__section-title">@Culture["Onboarding.EducationMboLegend"]</h2>
        <div class="ob-wizard__mbo-levels">
            @foreach (var mboLevel in MboLevels)
            {
                var isSelected = MboLevelSelected(mboLevel);
                <button type="button" aria-pressed="@(isSelected ? "true" : "false")"
                        class="@(isSelected ? "is-selected" : null)"
                        @onclick="() => SelectEducation.InvokeAsync(MboEducation(mboLevel))">
                    @Culture.Format("Onboarding.EducationMboLevel", mboLevel)
                </button>
            }
        </div>
    </section>
}

@if (ShowDirectionBlock)
{
    <section class="ob-wizard__section" aria-labelledby="ob-edu-direction">
        <h2 id="ob-edu-direction" class="ob-wizard__section-title">@Culture["Onboarding.EducationDirection"]</h2>
        <p class="ob-wizard__hint ob-wizard__section-hint">@Culture["Onboarding.EducationDirectionHint"]</p>
        @if (DirectionSuggestions.Count > 0)
        {
            <div class="ob-wizard__direction-chips" role="group" aria-label="@Culture["Onboarding.EducationDirection"]">
                @foreach (var suggestion in DirectionSuggestions)
                {
                    var picked = string.Equals(Draft.EducationDirection, suggestion, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="@(picked ? "is-selected" : null)"
                            aria-pressed="@(picked ? "true" : "false")"
                            @onclick="() => PickDirection(suggestion)">
                        @suggestion
                    </button>
                }
            </div>
        }
        <label>
            @Culture["Onboarding.EducationDirectionField"]
            <input maxlength="128"
                   placeholder="@Culture["Onboarding.EducationDirectionPlaceholder"]"
                   @bind="Draft.EducationDirection"
                   @bind:event="oninput"
                   @bind:after="NotifyAsync" />
        </label>
    </section>
}

@code {
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public EventCallback<string> SelectEducation { get; set; }

    private static readonly string[] MboLevels = ["1", "2", "3", "4"];

    private bool ShowDirectionBlock =>
        !string.IsNullOrWhiteSpace(Draft.Education)
        && !string.Equals(Draft.Education, EducationLevelLabels.None, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<string> DirectionSuggestions
    {
        get
        {
            var level = Draft.Education ?? "";
            if (level is "HAVO" or "VWO")
            {
                return OnboardingWizardCatalog.EducationDirectionHavoVwo;
            }

            if (level is "VMBO" || level.StartsWith("MBO", StringComparison.Ordinal))
            {
                return OnboardingWizardCatalog.EducationDirectionVmboMbo;
            }

            return Array.Empty<string>();
        }
    }

    private bool EducationSelected(string level)
        => Draft.Education == level || level == "MBO" && Draft.Education.StartsWith("MBO", StringComparison.Ordinal);

    private string EducationLabel(string level)
        => level == EducationLevelLabels.None ? Culture["Education.None"] : level;

    private static string MboEducation(string level) => $"MBO {level}";

    private bool MboLevelSelected(string level) => Draft.Education == MboEducation(level);

    private Task PickDirection(string direction)
    {
        Draft.EducationDirection = direction;
        return NotifyAsync();
    }

    private Task NotifyAsync() => Draft.NotifyChangedAsync();
}
