@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Careers
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@inject CultureState Culture

@if (ShowHeading)
{
    <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
    <h1 tabindex="-1">@Culture["Onboarding.Step4.Title"]</h1>
    <p class="ob-wizard__lead">@Culture["Onboarding.Step4.Lead"]</p>
}
<div class="ob-wizard__card">
<label class="ob-wizard__check">
    <input type="checkbox" checked="@Draft.NoWork" @onchange="OnNoWorkChangedAsync" />
    @Culture["Onboarding.NoWorkExperience"]
</label>
@if (!Draft.NoWork)
{
    @foreach (var job in Draft.Jobs)
    {
        var item = job;
        var canRemove = Draft.Jobs.Count > 1 || !item.IsBlank();
        var dutyChips = OccupationDutySuggestions.ForRole(item.Role, Culture.Language);
        <article class="ob-wizard__job ob-job-card" data-testid="onboarding-work-job">
            @if (canRemove)
            {
                <button type="button" class="icon-btn"
                        aria-label="@Culture.Format("Onboarding.DeleteJob", item.Role ?? "")"
                        @onclick="() => RemoveJob.InvokeAsync(item)">×</button>
            }
            <label>
                @Culture["Profile.Role"]
                <input @bind="item.Role" @bind:event="oninput" @bind:after="OnRoleChangedAsync" />
            </label>
            <label>
                @Culture["Profile.Employer"]
                <input @bind="item.EmployerName" @bind:event="oninput" @bind:after="NotifyAsync" />
            </label>
            <div class="ob-job-dates">
                <label class="ob-job-dates__from">
                    @Culture["Profile.EmployerFrom"]
                    <MonthYearInput Value="@item.StartMonth"
                                    ValueChanged="value => SetJobStart.InvokeAsync((item, value))" />
                </label>
                <div class="ob-job-dates__to-block">
                    <label class="ob-job-dates__to">
                        @Culture["Profile.EmployerTo"]
                        @if (item.ShowsAsCurrent)
                        {
                            <input class="ob-job-dates__present-input"
                                   type="text"
                                   readonly
                                   disabled
                                   value="@Culture["Profile.EmployerPresent"]"
                                   aria-label="@Culture["Profile.EmployerPresent"]" />
                        }
                        else
                        {
                            <MonthYearInput Value="@item.EndMonth"
                                            ReferenceMonth="@item.StartMonth"
                                            ValueChanged="value => SetJobEnd.InvokeAsync((item, value))" />
                        }
                    </label>
                    <label class="ob-job-dates__current">
                        <input type="checkbox"
                               checked="@item.ShowsAsCurrent"
                               @onchange="e => SetCurrentJob(item, e.Value is true)" />
                        <span>@Culture["Profile.CurrentJob"]</span>
                    </label>
                </div>
            </div>
            <label class="ob-job-duties">
                <span>@Culture["Onboarding.Work.DutiesLabel"] <small class="ob-job-duties__optional">@Culture["Onboarding.Optional"]</small></span>
                <textarea rows="3"
                          maxlength="1000"
                          placeholder="@Culture["Onboarding.Work.DutiesPlaceholder"]"
                          @bind="item.Description"
                          @bind:event="oninput"
                          @bind:after="NotifyAsync"></textarea>
            </label>
            @if (dutyChips.Count > 0)
            {
                <div class="ob-job-duty-pills" role="group" aria-label="@Culture["Onboarding.Work.DutyChipsAria"]">
                    @foreach (var chip in dutyChips)
                    {
                        var text = chip;
                        <button type="button"
                                class="ob-job-duty-pill"
                                @onclick="() => AppendDuty(item, text)">
                            @text
                        </button>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(item.EmployerName)
                 && string.IsNullOrWhiteSpace(item.Description)
                 && !Draft.NoWork)
            {
                <p class="ob-job-duties__hint">@Culture["Onboarding.Work.DutiesHint"]</p>
            }
        </article>
    }
    @if (ShowAddJobButton)
    {
        <button type="button"
                class="ob-wizard__add-job"
                data-testid="onboarding-add-job"
                @onclick="AddJob">
            @AddJobLabel
        </button>
    }
}
</div>

@code {
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public EventCallback AddJob { get; set; }
    [Parameter] public EventCallback<CandidateEmployerHistory> RemoveJob { get; set; }
    [Parameter] public EventCallback<(CandidateEmployerHistory Job, string? Value)> SetJobStart { get; set; }
    [Parameter] public EventCallback<(CandidateEmployerHistory Job, string? Value)> SetJobEnd { get; set; }

    protected override void OnParametersSet()
    {
        Draft.EnsureFirstJobSlot();
    }

    private bool ShowAddJobButton =>
        !Draft.NoWork
        && Draft.Jobs.Count < 3
        && Draft.HasEngagedJob();

    private string AddJobLabel => Culture["Onboarding.AddAnotherJob"];

    private Task NotifyAsync() => Draft.NotifyChangedAsync();

    private Task OnRoleChangedAsync()
    {
        StateHasChanged();
        return NotifyAsync();
    }

    private async Task OnNoWorkChangedAsync(ChangeEventArgs args)
    {
        Draft.NoWork = args.Value is true;
        if (Draft.NoWork)
        {
            Draft.Jobs.Clear();
        }
        else
        {
            Draft.EnsureFirstJobSlot();
        }

        await NotifyAsync();
    }

    private Task SetCurrentJob(CandidateEmployerHistory item, bool current)
    {
        item.IsCurrent = current;
        return current
            ? SetJobEnd.InvokeAsync((item, null))
            : Draft.NotifyChangedAsync();
    }

    private async Task AppendDuty(CandidateEmployerHistory item, string chip)
    {
        var existing = item.Description?.Trim() ?? "";
        if (existing.Contains(chip, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        item.Description = string.IsNullOrWhiteSpace(existing) ? chip : $"{existing.TrimEnd('.', ';')}; {chip}";
        await NotifyAsync();
    }
}
