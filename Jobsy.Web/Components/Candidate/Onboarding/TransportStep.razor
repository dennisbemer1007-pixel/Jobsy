@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@inject CultureState Culture

@if (ShowHeading && !Illustrated)
{
    <h1 tabindex="-1">@Culture["Onboarding.Step3.Title"]</h1>
    <p class="ob-wizard__lead">@Culture["Onboarding.Step3.Lead"]</p>
}
else if (!Illustrated && ShowHeading)
{
    <h2 class="ob-wizard__subhead">@Culture["Onboarding.Step3.Title"]</h2>
}
<div class="ob-wizard__card @(Illustrated ? "ob-wizard__card--illustrated" : null)">
@if (Illustrated)
{
    <div class="ob-wizard__section-title ob-illustrated-step__field-label"
         id="onboarding-transport-label"
         data-testid="onboarding-transport-heading">@Culture["Onboarding.Transport"]</div>
}
<fieldset id="onboarding-field-transport" aria-labelledby="@(Illustrated ? "onboarding-transport-label" : null)">
    @if (!Illustrated)
    {
        <legend class="ob-wizard__section-title">@Culture["Onboarding.Transport"]</legend>
    }
    else
    {
        <legend class="visually-hidden">@Culture["Onboarding.Transport"]</legend>
    }
    <p class="ob-wizard__hint @(Illustrated ? "ob-wizard__section-hint" : null)">@Culture["Onboarding.TransportMulti"]</p>
    <ChoiceTileGrid Class="ob-wizard__transport" AriaLabel="@Culture["Onboarding.Transport"]">
        @foreach (var transport in TransportOptions)
        {
            var isSelected = _displayTransport.Contains(transport);
            <ChoiceTile Label="@TransportLabel(transport)"
                        Icon="@ChoiceTileIcons.ForTransport(transport)"
                        Selected="isSelected"
                        OnClick="@(() => SelectTransportAsync(transport))" />
        }
    </ChoiceTileGrid>
    @if (ShowValidation && string.IsNullOrWhiteSpace(Draft.Transport))
    {
        <p class="error" role="alert">@Culture["Onboarding.Validation.Transport"]</p>
    }
</fieldset>
<fieldset>
    <legend>@Culture["Onboarding.MaxTravel"] <strong>@_displayMaxTravel @Culture["Onboarding.Minutes"]</strong></legend>
    <ChoiceTileGrid Class="ob-wizard__transport ob-wizard__travel-times" Wrap="true" DesktopThreeColumns="false" AriaLabel="@Culture["Onboarding.MaxTravel"]">
        @foreach (var minutes in TravelChoices)
        {
            var selected = _displayMaxTravel == minutes;
            <ChoiceTile Label="@minutes.ToString()"
                        Icon="@ChoiceTileIcons.Clock"
                        Selected="selected"
                        Inline="true"
                        OnClick="@(() => SelectTravelTimeAsync(minutes))" />
        }
    </ChoiceTileGrid>
    <button type="button" class="ob-wizard__inline-link" @onclick="ShowCustomTravel">
        @Culture["Onboarding.Other"]
    </button>
    @if (Draft.CustomTravel)
    {
        <input type="number" min="1" max="180"
               @bind="Draft.MaxTravel" @bind:after="NotifyAsync" />
    }
    @if (ShowValidation && Draft.MaxTravel <= 0)
    {
        <p class="error" role="alert">@Culture["Onboarding.Validation.MaxTravel"]</p>
    }
</fieldset>
@if (ShowDrivingLicenses)
{
    <fieldset>
        <legend>@Culture["Profile.Licenses"]</legend>
        <ChoiceTileGrid Class="ob-wizard__transport" Wrap="true" DesktopThreeColumns="false" AriaLabel="@Culture["Profile.Licenses"]">
            @foreach (var license in DrivingLicenseLabels.All)
            {
                var isSelected = Draft.DrivingLicenses.Contains(license);
                <ChoiceTile Label="@license"
                            Selected="isSelected"
                            AlignIcons="false"
                            Inline="true"
                            OnClick="@(() => ToggleLicense.InvokeAsync(license))" />
            }
        </ChoiceTileGrid>
    </fieldset>
}
</div>

@code {
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public EventCallback<string> SelectTransport { get; set; }
    [Parameter] public EventCallback<int> SelectTravelTime { get; set; }
    [Parameter] public EventCallback ShowCustomTravel { get; set; }
    [Parameter] public EventCallback<string> ToggleLicense { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public bool ShowDrivingLicenses { get; set; }
    [Parameter] public bool ShowValidation { get; set; }
    [Parameter] public bool Illustrated { get; set; }

    private static readonly string[] TransportOptions = TransportLabels.Selectable;
    private static readonly int[] TravelChoices = [10, 20, 30, 45];

    private HashSet<string> _displayTransport = new(StringComparer.OrdinalIgnoreCase);
    private int _displayMaxTravel;

    protected override void OnParametersSet()
    {
        var modes = TransportLabels.SplitMany(Draft.Transport);
        if (modes.Count > 0 || _displayTransport.Count == 0)
        {
            _displayTransport = new HashSet<string>(modes, StringComparer.OrdinalIgnoreCase);
        }

        if (Draft.MaxTravel > 0)
        {
            _displayMaxTravel = Draft.MaxTravel;
        }
        else if (_displayMaxTravel <= 0)
        {
            _displayMaxTravel = 30;
        }
    }

    private async Task SelectTransportAsync(string transport)
    {
        if (!_displayTransport.Add(transport))
        {
            _displayTransport.Remove(transport);
        }

        await InvokeAsync(StateHasChanged);
        await SelectTransport.InvokeAsync(transport);
    }

    private async Task SelectTravelTimeAsync(int minutes)
    {
        _displayMaxTravel = minutes;
        await InvokeAsync(StateHasChanged);
        await SelectTravelTime.InvokeAsync(minutes);
    }

    private string TransportLabel(string transport) => transport switch
    {
        TransportLabels.Bike => Culture["Transport.Bike"],
        TransportLabels.EBike => Culture["Transport.EBike"],
        TransportLabels.Car => Culture["Transport.Car"],
        TransportLabels.PublicTransport => Culture["Transport.Transit"],
        TransportLabels.Walking => Culture["Transport.Walk"],
        _ => transport
    };

    private Task NotifyAsync() => Draft.NotifyChangedAsync();
}
