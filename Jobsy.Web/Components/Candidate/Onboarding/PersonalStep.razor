@namespace Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Core.Privacy
@using Jobsy.Core.Rules
@using GeolocationPrefillMode = Jobsy.Core.Rules.GeolocationPrefillMode
@using static Jobsy.Core.Rules.OnboardingWizardValidation
@using Jobsy.Web.Components.KandidaatBanen
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Services
@inject CultureState Culture
@inject IJSRuntime Js
@inject IGeocodingClient Geocoder
@implements IAsyncDisposable

<div class="ob-fields @(Illustrated ? "ob-fields--illustrated" : null)">
@if (!Illustrated)
{
<h1 tabindex="-1">@Culture["Onboarding.Step1.Title"]</h1>
<p class="ob-wizard__lead">@Culture["Onboarding.Step1.Lead"]</p>
}
<div class="ob-wizard__card @(Illustrated ? "ob-wizard__card--illustrated" : null)">
<div class="ob-wizard__field-row">
    <label id="onboarding-field-firstname">
        @Culture["Profile.FirstName"]
        <input autocomplete="given-name" maxlength="128"
               aria-invalid="@(ShowValidation && string.IsNullOrWhiteSpace(Draft.FirstName) ? "true" : "false")"
               @bind="Draft.FirstName" @bind:event="oninput" @bind:after="NotifyAsync" />
        @if (ShowValidation && string.IsNullOrWhiteSpace(Draft.FirstName))
        {
            <span class="error" role="alert">@Culture["Onboarding.Validation.FirstName"]</span>
        }
    </label>
    <label id="onboarding-field-lastname">
        @Culture["Profile.LastName"]
        <input autocomplete="family-name" maxlength="128"
               aria-invalid="@(ShowValidation && string.IsNullOrWhiteSpace(Draft.LastName) ? "true" : "false")"
               @bind="Draft.LastName" @bind:event="oninput" @bind:after="NotifyAsync" />
        @if (ShowValidation && string.IsNullOrWhiteSpace(Draft.LastName))
        {
            <span class="error" role="alert">@Culture["Onboarding.Validation.LastName"]</span>
        }
    </label>
</div>
<div id="onboarding-field-location" class="ob-fields__address">
    <KbAddressField InputId="onboarding-home-address"
                    CssClass="kb-panel-head__address ob-fields__kb-address"
                    Label="@Culture["Discovery.Address"]"
                    Placeholder="@Culture["Discovery.AddressPlaceholder"]"
                    Query="@Draft.AddressQuery"
                    QueryChanged="OnAddressQueryChangedAsync"
                    OnQueryInput="OnAddressInputAsync"
                    Suggestions="Draft.Suggestions"
                    Suggesting="_suggesting"
                    @bind-ShowSuggestions="_showSuggestions"
                    OriginSet="@(Draft.HomeLat is not null && Draft.HomeLng is not null)"
                    Locating="_locating"
                    OnLocate="UseMyLocationAsync"
                    OnClear="ClearLocationAsync"
                    OnSelect="SelectSuggestionAsync"
                    OnBlurComplete="OnAddressBlurResolveAsync" />
    @if (ShowValidation && !LocationValid)
    {
        <span class="error" role="alert">@Culture["Onboarding.Validation.Location"]</span>
    }
    @if (!string.IsNullOrWhiteSpace(_locationError))
    {
        <p class="ob-fields__location-error error" role="status" data-testid="onboarding-location-error">@_locationError</p>
    }
</div>
@if (Draft.GeolocationPrefillMode == GeolocationPrefillMode.Approximate && Draft.GeolocationApproximateAccuracyMeters is int approxMeters)
{
    <p class="ob-wizard__hint ob-wizard__hint--geo" role="status">@Culture.Format("Onboarding.Geolocation.ApproximateHint", DisplayAccuracyMeters(approxMeters))</p>
}
@if (Draft.GeolocationPendingConfirm && Draft.GeolocationPrefillMode == GeolocationPrefillMode.Precise)
{
    <div class="ob-wizard__geo-confirm">
        <p class="ob-wizard__hint ob-wizard__hint--geo" role="status">@Culture["Onboarding.Geolocation.ConfirmPrecise"]</p>
        <button type="button" class="btn btn-secondary btn-compact" data-testid="geolocation-confirm-address" @onclick="ConfirmGeolocationAsync">
            @Culture["Onboarding.Geolocation.ConfirmCta"]
        </button>
    </div>
}
@if (Draft.PostcodeResolved && !Draft.GeolocationPendingConfirm && !string.IsNullOrWhiteSpace(LocationHint))
{
    <p class="ob-wizard__hint">✓ @LocationHint</p>
}
@if (Draft.PostcodeMissing)
{
    <p class="error">
        @Culture["Onboarding.PostcodeNotFound"]
        <button type="button" class="ob-wizard__inline-link" @onclick="OnShowCityAsync">
            @Culture["Onboarding.EnterCity"]
        </button>
    </p>
}
@if (Draft.ShowCity)
{
    <label>
        @Culture["Onboarding.City"]
        <input autocomplete="address-level2"
               @bind="Draft.City" @bind:event="oninput" @bind:after="OnCityChangedAsync" />
    </label>
}
<fieldset id="onboarding-field-birthdate">
    <legend>@Culture["Onboarding.BirthDate"]</legend>
    <div class="ob-wizard__birth-date">
        <JobsyDateField Constraint="JobsyDateConstraint.CandidateBirthDate"
                        Value="Draft.BirthDate"
                        ValueChanged="OnBirthDatePickedAsync"
                        TestId="onboarding-birth-date"
                        InputId="onboarding-birth-date-input" />
    </div>
    <small>@BirthHint</small>
    @if (ShowValidation && Draft.BirthDate is null)
    {
        <p class="error" role="alert">@Culture["Onboarding.Validation.BirthDate"]</p>
    }
    @if (AgeMessage is not null)
    {
        <p class="error" role="status">@AgeMessage</p>
    }
</fieldset>

<WorkStatusChipSelect Selected="Draft.WorkStatuses" OnToggle="ToggleWorkStatusAsync" />

<label>
    @Culture["Profile.Phone"] <small>@Culture["Onboarding.Optional"]</small>
    <input type="tel" autocomplete="tel"
           @bind="Draft.Phone" @bind:event="oninput" @bind:after="NotifyAsync" />
</label>
@if (ShowWhatsApp)
{
    <label class="ob-wizard__check">
        <input type="checkbox"
               disabled="@string.IsNullOrWhiteSpace(Draft.Phone)"
               @bind="Draft.WhatsAppAllowed"
               @bind:after="NotifyAsync" />
        @Culture["Profile.WhatsAppAllowed"]
    </label>
}
</div>
</div>

@code {
    [Parameter, EditorRequired] public OnboardingProfileDraft Draft { get; set; } = default!;
    [Parameter] public bool Illustrated { get; set; }
    [Parameter] public EventCallback AddressChanged { get; set; }
    [Parameter] public EventCallback BirthDateChanged { get; set; }
    [Parameter] public EventCallback ShowCity { get; set; }
    [Parameter] public EventCallback<AddressSuggestion> SelectAddress { get; set; }
    [Parameter] public bool ShowWhatsApp { get; set; }
    [Parameter] public bool EmployersEnabled { get; set; } = true;
    [Parameter] public bool UseDiscoveryPostcodeHint { get; set; }
    [Parameter] public bool ShowGeolocation { get; set; } = true;
    [Parameter] public bool ShowValidation { get; set; }

    private bool LocationValid => HasResolvableLocation(
        Draft.City,
        Draft.HomeLat,
        Draft.HomeLng,
        Draft.Postcode,
        Draft.PostcodeResolved,
        Draft.GeolocationPendingConfirm);

    private bool _locating;
    private bool _suggesting;
    private bool _showSuggestions;
    private bool _addressSuggestFromUser;
    private string? _locationError;
    private CancellationTokenSource? _suggestCts;
    private CancellationTokenSource? _postcodeCts;
    private CancellationTokenSource? _addressSaveCts;
    private int _suggestGeneration;

    private string? LocationHint
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Draft.City))
            {
                return UseDiscoveryPostcodeHint
                    ? Culture.Format("Discovery.Step1.PostcodeResolved", Draft.City)
                    : Culture.Format("Onboarding.PostcodeResolved", Draft.City);
            }

            return null;
        }
    }

    private string? AgeMessage
    {
        get
        {
            if (Draft.BirthDate is not DateOnly born)
            {
                return null;
            }

            var today = DateOnly.FromDateTime(DateTime.Today);
            if (CandidateConsentRules.IsBelowMinimumAge(born, today))
            {
                return Culture.Format("Onboarding.Age.TooYoung", CandidateConsentRules.MinimumCandidateAge);
            }

            if (CandidateConsentRules.AgeYears(born, today) is int age
                && age < CandidateConsentRules.ParentalConsentAge)
            {
                return Culture.Format(
                    "Onboarding.Age.Parent",
                    CandidateConsentRules.MinimumCandidateAge,
                    CandidateConsentRules.ParentalConsentAge);
            }

            return null;
        }
    }

    private string BirthHint => EmployersEnabled
        ? Culture["Onboarding.BirthHint"]
        : Culture["Discovery.Step1.BirthHintEmployersOff"];

    private Task NotifyAsync() => Draft.NotifyChangedAsync();

    private async Task ToggleWorkStatusAsync(string code)
    {
        if (!Draft.WorkStatuses.Add(code))
        {
            Draft.WorkStatuses.Remove(code);
        }

        await NotifyAsync();
        await SafeStateHasChangedAsync();
    }

    private async Task OnAddressQueryChangedAsync(string value)
    {
        Draft.AddressQuery = value ?? string.Empty;
        await Task.CompletedTask;
    }

    private async Task OnAddressBlurResolveAsync()
    {
        if (Draft.GeolocationPendingConfirm || Draft.HomeLat is not null && Draft.HomeLng is not null)
        {
            return;
        }

        if (await CandidateHomeAddressLookup.TryResolveTypedAddressAsync(Draft, Geocoder))
        {
            await AddressChanged.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnAddressInputAsync(string value)
    {
        _addressSuggestFromUser = true;
        _locationError = null;
        Draft.AddressQuery = value ?? string.Empty;
        CandidateHomeAddressLookup.MarkDraftInputChanged(Draft);
        var split = PostcodeMatch.SplitHomeAddress(Draft.AddressQuery);
        if (!string.IsNullOrWhiteSpace(split.Postcode))
        {
            Draft.Postcode = split.Postcode;
        }

        if (!string.IsNullOrWhiteSpace(split.City))
        {
            Draft.City = split.City;
        }

        ScheduleDebouncedAddressChanged();
        await SuggestAddressesAsync(Draft.AddressQuery);
        SchedulePostcodeResolve();
    }

    private void ScheduleDebouncedAddressChanged()
    {
        _addressSaveCts?.Cancel();
        _addressSaveCts?.Dispose();
        _addressSaveCts = new CancellationTokenSource();
        var token = _addressSaveCts.Token;
        _ = DebouncedAddressChangedAsync(token);
    }

    private async Task DebouncedAddressChangedAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(450, cancellationToken);
            await AddressChanged.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OnCityChangedAsync() => await AddressChanged.InvokeAsync();

    private async Task OnBirthDatePickedAsync(DateOnly? value)
    {
        Draft.BirthDate = value;
        if (value is { } d)
        {
            Draft.BirthDay = d.Day.ToString();
            Draft.BirthMonth = d.Month.ToString();
            Draft.BirthYear = d.Year.ToString();
        }
        else
        {
            Draft.BirthDay = "";
            Draft.BirthMonth = "";
            Draft.BirthYear = "";
        }

        await NotifyAsync();
        if (BirthDateChanged.HasDelegate)
        {
            await BirthDateChanged.InvokeAsync();
        }
    }

    private Task OnShowCityAsync() => ShowCity.InvokeAsync();

    private async Task SelectSuggestionAsync(AddressSuggestion suggestion)
    {
        _showSuggestions = false;
        await SelectAddress.InvokeAsync(suggestion);
    }

    private async Task ClearLocationAsync()
    {
        CandidateHomeAddressLookup.ClearDraftLocation(Draft);
        _showSuggestions = false;
        await AddressChanged.InvokeAsync();
    }

    private async Task ConfirmGeolocationAsync()
    {
        CandidateHomeAddressLookup.ConfirmGeolocationPrefill(Draft);
        await AddressChanged.InvokeAsync();
    }

    private static int DisplayAccuracyMeters(int meters)
        => meters >= 1_000_000 ? GeolocationAddressPrefill.PreciseAccuracyThresholdMeters + 1 : meters;

    private async Task UseMyLocationAsync()
    {
        if (!ShowGeolocation)
        {
            return;
        }

        _locationError = null;
        _locating = true;
        _showSuggestions = false;
        try
        {
            await Js.InvokeVoidAsync("jobsyGeo.blurElement", "onboarding-home-address");
            var position = await GeolocationInterop.RequestLocationAsync(Js);
            var lat = position.lat;
            var lng = position.lng;
            var accuracy = position.accuracyMeters;

            var label = await CandidateHomeAddressLookup.ReverseGeocodeLabelAsync(Geocoder, lat, lng);
            var prefill = CandidateHomeAddressLookup.ApplyGeolocationPrefill(Draft, lat, lng, accuracy, label);
            if (prefill is null)
            {
                _locationError = Culture["Onboarding.LocationFailed"];
            }
            else if (prefill.Mode == GeolocationPrefillMode.Approximate)
            {
                await Js.InvokeVoidAsync("jobsyGeo.focusElement", "onboarding-home-address");
            }

            await AddressChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _locationError = GeolocationInterop.MapGeolocationError(Culture, ex);
        }
        finally
        {
            _locating = false;
        }
    }

    private void SchedulePostcodeResolve()
    {
        _postcodeCts?.Cancel();
        _postcodeCts?.Dispose();
        _postcodeCts = new CancellationTokenSource();
        _ = ResolvePostcodeAsync(_postcodeCts.Token);
    }

    private async Task ResolvePostcodeAsync(CancellationToken cancellationToken)
    {
        try
        {
            var resolved = await CandidateHomeAddressLookup.TryResolvePostcodeAsync(
                Draft, Geocoder, cancellationToken);
            if (resolved)
            {
                await AddressChanged.InvokeAsync();
            }

            await SafeStateHasChangedAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            // Postcode lookup is best-effort while typing.
        }
    }

    private async Task SuggestAddressesAsync(string query)
    {
        if (!_addressSuggestFromUser)
        {
            return;
        }

        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _suggestCts = new CancellationTokenSource();
        var token = _suggestCts.Token;
        var generation = ++_suggestGeneration;

        var trimmed = (query ?? string.Empty).Trim();
        if (trimmed.Length < 3)
        {
            Draft.Suggestions.Clear();
            _showSuggestions = false;
            _suggesting = false;
            await SafeStateHasChangedAsync();
            return;
        }

        _showSuggestions = true;
        _suggesting = true;
        await SafeStateHasChangedAsync();

        try
        {
            await Task.Delay(280, token);
            var results = await Geocoder.SuggestAsync(trimmed, token);
            if (generation != _suggestGeneration || token.IsCancellationRequested)
            {
                return;
            }

            Draft.Suggestions.Clear();
            Draft.Suggestions.AddRange(results);
            _showSuggestions = results.Count > 0;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            if (generation == _suggestGeneration)
            {
                Draft.Suggestions.Clear();
                _showSuggestions = false;
            }
        }
        finally
        {
            if (generation == _suggestGeneration)
            {
                _suggesting = false;
                if (Draft.Suggestions.Count == 0)
                {
                    _showSuggestions = false;
                }

                await SafeStateHasChangedAsync();
            }
        }
    }

    private async Task SafeStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Circuit may be disconnected during teardown.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _postcodeCts?.Cancel();
        _postcodeCts?.Dispose();
        _addressSaveCts?.Cancel();
        _addressSaveCts?.Dispose();
        await Task.CompletedTask;
    }
}
