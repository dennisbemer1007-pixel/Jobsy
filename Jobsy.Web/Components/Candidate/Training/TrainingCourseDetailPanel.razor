@namespace Jobsy.Web.Components.Candidate.Training
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject UserFacingError UserFacing

@if (Offer is null)
{
    return;
}

<aside class="opl-panel" aria-labelledby="@_titleId">
    <div class="opl-panel__head">
        @if (ShowClose)
        {
            <button type="button" class="opl-panel__close" @onclick="OnClose" aria-label="@Culture["Training.ClosePanel"]">×</button>
        }
        <div class="opl-card__top">
            <span class="@TypeClass">@TypeLabel</span>
            @PriceMarkup
            @if (Offer.IsPartnerLink)
            {
                <span class="opl-badge-partner">@Culture["Training.PartnerLink"]</span>
            }
        </div>
        <h3 id="@_titleId">@Offer.Title</h3>
        <p class="opl-panel__by">@Offer.ProviderName</p>
    </div>
    <div class="opl-panel__body">
        <div class="opl-facts">
            <div>
                <small>@Culture["Training.Meta.Duration"]</small>
                <b>@DurationText</b>
            </div>
            <div>
                <small>@Culture["Training.Meta.Format"]</small>
                <b>@FormatText</b>
            </div>
            @if (StartsText is not null)
            {
                <div>
                    <small>@Culture["Training.Meta.Starts"]</small>
                    <b>@StartsText</b>
                </div>
            }
            <div>
                <small>@Culture["Training.Meta.Provider"]</small>
                <b>@Offer.ProviderName</b>
            </div>
        </div>

        @if (Offer.LearnBullets.Count > 0)
        {
            <div>
                <h4 class="career-card__block-title">@Culture["Training.LearnTitle"]</h4>
                <ul class="opl-panel__list">
                    @foreach (var bullet in Offer.LearnBullets)
                    {
                        <li>
                            <span aria-hidden="true">@((MarkupString)NavIcons.Check)</span>
                            <span>@bullet</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="opl-gain">
            <span class="opl-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Claw)</span>
            <div>
                <strong>@Culture["Training.GainTitle"]</strong>
                <ul class="opl-panel__list">
                    <li><span aria-hidden="true">@((MarkupString)NavIcons.Check)</span>@Culture["Training.Gain.Passport"]</li>
                </ul>
            </div>
        </div>

        <div class="opl-panel__actions">
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="OpenAsync">
                @Culture["Training.OpenExternal"]
            </button>
            <button type="button"
                    class="btn btn-ghost"
                    disabled="@_busy"
                    aria-pressed="@Offer.Saved"
                    @onclick="ToggleSaveAsync">
                @(Offer.Saved ? Culture["Training.Saved"] : Culture["Training.Save"])
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="state-message" role="alert">@_message</p>
        }
    </div>
</aside>

@code {
    [Parameter] public TrainingPartnerOfferModel? Offer { get; set; }
    [Parameter] public string Campaign { get; set; } = TrainingTracking.CampaignCompetence;
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TrainingPartnerOfferModel> OnSavedChanged { get; set; }

    private readonly string _titleId = "opl-panel-" + Guid.NewGuid().ToString("N")[..8];
    private bool _busy;
    private string? _message;

    private string TypeClass => Offer?.Type switch
    {
        "Workshop" => "opl-type opl-type--workshop",
        "Opleiding" => "opl-type opl-type--opleiding",
        _ => "opl-type opl-type--cursus"
    };

    private string TypeLabel => Offer?.Type switch
    {
        "Workshop" => Culture["Training.Type.Workshop"],
        "Opleiding" => Culture["Training.Type.Opleiding"],
        _ => Culture["Training.Type.Cursus"]
    };

    private MarkupString PriceMarkup => Offer switch
    {
        { IsFree: true } => (MarkupString)$"""<span class="opl-badge-free">✓ {Culture["Training.Free"]}</span>""",
        { PriceEuro: { } p } => (MarkupString)$"""<span class="opl-badge-price">€ {p:0.##}</span>""",
        { PriceLabel: { } label } => (MarkupString)$"""<span class="opl-badge-price">{label}</span>""",
        _ => (MarkupString)""
    };

    private string DurationText
    {
        get
        {
            if (Offer?.DurationValue is not int dv
                || !Enum.TryParse<TrainingDurationUnit>(Offer.DurationUnit, true, out var unit))
            {
                return "—";
            }

            var unitKey = TrainingDurationFormat.UnitKey(unit);
            return unitKey is null ? dv.ToString() : Culture.Format(unitKey, dv);
        }
    }

    private string FormatText => Offer?.Delivery switch
    {
        "OnSite" => string.IsNullOrWhiteSpace(Offer.Location)
            ? Culture["Training.Delivery.OnSite"]
            : Offer.Location!,
        "Blended" => Culture["Training.Delivery.Blended"],
        _ => Culture["Training.Delivery.Online"]
    };

    private string? StartsText => Offer?.StartsOn?.ToString("yyyy-MM-dd");

    private async Task OpenAsync()
    {
        if (Offer is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var tracked = await Api.TrackTrainingOfferAsync(Offer.OfferId, Campaign);
            if (string.IsNullOrWhiteSpace(tracked.Url)
                || tracked.Url.Contains('@', StringComparison.Ordinal)
                || !TrainingDeepLinkRules.IsCourseDeepLink(tracked.Url))
            {
                _message = Culture["Common.Error"];
                return;
            }

            var partner = Offer.IsPartnerLink;
            if (partner)
            {
                await Js.InvokeVoidAsync("open", tracked.Url, "_blank", "noopener,noreferrer");
            }
            else
            {
                var sameOrigin = tracked.Url.StartsWith("/", StringComparison.Ordinal)
                                 || tracked.Url.StartsWith(Navigation.BaseUri, StringComparison.OrdinalIgnoreCase);
                Navigation.NavigateTo(tracked.Url, forceLoad: !sameOrigin);
            }
        }
        catch (Exception ex)
        {
            _message = UserFacing.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleSaveAsync()
    {
        if (Offer is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await Api.ToggleTrainingPartnerOfferSavedAsync(Offer.OfferId);
            Offer.Saved = !Offer.Saved;
            await OnSavedChanged.InvokeAsync(Offer);
        }
        catch (Exception ex)
        {
            _message = UserFacing.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
