@using Jobsy.Web.Localization
@inject CultureState Culture
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (_visible)
{
    <div class="pwa-install-banner" role="status">
        <p class="pwa-install-banner__text">
            @if (_ios)
            {
                <text>@Culture["Pwa.IosHint"] </text>
                <span class="pwa-install-banner__ios-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3v12" />
                        <path d="M8 7l4-4 4 4" />
                        <path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                    </svg>
                </span>
            }
            else
            {
                @Culture["Pwa.BannerText"]
            }
        </p>
        <div class="pwa-install-banner__actions">
            @if (!_ios)
            {
                <button type="button" class="btn-compact btn-compact--primary" @onclick="InstallAsync">@Culture["Pwa.Install"]</button>
            }
            <button type="button" class="btn-compact" @onclick="DismissAsync">@Culture["Pwa.Dismiss"]</button>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _ios;
    private bool _checked;
    private DotNetObjectReference<PwaInstallBanner>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!_checked)
        {
            _checked = true;
            try
            {
                if (await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone"))
                {
                    _visible = false;
                    return;
                }

                await Js.InvokeAsync<int>("lobsyPwaInstall.bumpVisit");
                _ios = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
                _visible = await Js.InvokeAsync<bool>("lobsyPwaInstall.shouldShowBanner");
                _self ??= DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync("lobsyPwaInstall.watchBanner", _self);
                if (_visible)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                _checked = false;
            }
        }
    }

    [JSInvokable]
    public void SetPwaBannerVisible(bool visible)
    {
        if (_visible == visible)
        {
            return;
        }

        _visible = visible;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync()
    {
        try
        {
            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
        }
        catch
        {
            // Best-effort.
        }

        _visible = false;
    }

    private async Task DismissAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("lobsyPwaInstall.dismiss");
        }
        catch
        {
            // Best-effort.
        }

        _visible = false;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("lobsyPwaInstall.unwatchBanner");
        }
        catch
        {
            // Circuit may be gone.
        }

        _self?.Dispose();
    }
}
