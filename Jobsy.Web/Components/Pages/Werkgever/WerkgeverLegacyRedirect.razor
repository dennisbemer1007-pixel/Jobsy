@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Jobsy.Web.Navigation
@inject NavigationManager Navigation

@code {
    [Parameter] public Guid? TableId { get; set; }

    protected override void OnInitialized()
    {
        var rel = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = rel.Split('?', 2)[0];
        var query = rel.Contains('?', StringComparison.Ordinal) ? rel[rel.IndexOf('?')..] : "";

        if (TableId is Guid id && path.Contains("salary-tables", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/werkgever/organisatie/salaristabellen/{id}{query}", replace: true);
            return;
        }

        if (WerkgeverLegacyRoutes.TryMap(path, out var neu, out var tab))
        {
            var target = WerkgeverLegacyRoutes.BuildTarget(neu, query, tab);
            Navigation.NavigateTo(target, replace: true);
            return;
        }

        Navigation.NavigateTo("/werkgever", replace: true);
    }
}
