    private async Task SyncUrlAsync()
    {
        var parts = new List<string>();
        if (!string.Equals(_tab, "alle", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"tab={Uri.EscapeDataString(_tab)}");
        }

        if (!string.IsNullOrWhiteSpace(FilterQueryWithoutTab))
        {
            parts.Add(FilterQueryWithoutTab);
        }

        var url = parts.Count == 0 ? "/werkgever/vacatures" : "/werkgever/vacatures?" + string.Join("&", parts);
        Navigation.NavigateTo(url, replace: true);
        await Task.CompletedTask;
    }

    private void ToggleRow(Guid id, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (on)
        {
            if (_selected.Count < VacancyManageRules.BulkMax)
            {
                _selected.Add(id);
            }
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void OnToggleAll(bool on)
    {
        if (on)
        {
            foreach (var v in Paged.Take(VacancyManageRules.BulkMax))
            {
                _selected.Add(v.Id);
            }
        }
        else
        {
            foreach (var v in Paged)
            {
                _selected.Remove(v.Id);
            }
        }
    }

    private void ClearSelection() => _selected.Clear();

    private async Task ToggleCol(string name, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        switch (name)
        {
            case nameof(_colViews): _colViews = on; break;
            case nameof(_colOnline): _colOnline = on; break;
            case nameof(_colVisibility): _colVisibility = on; break;
        }

        await SaveColumnsAsync();
    }

    private async Task LoadColumnsAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("localStorage.getItem", VacancyManageRules.ColumnsStorageKey);
            if (string.IsNullOrWhiteSpace(raw))
            {
                return;
            }

            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("views", out var views))
            {
                _colViews = views.GetBoolean();
            }

            if (doc.RootElement.TryGetProperty("online", out var online))
            {
                _colOnline = online.GetBoolean();
            }

            if (doc.RootElement.TryGetProperty("visibility", out var vis))
            {
                _colVisibility = vis.GetBoolean();
            }
        }
        catch
        {
            // ignore
        }
    }

    private async Task SaveColumnsAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(new { views = _colViews, online = _colOnline, visibility = _colVisibility });
            await Js.InvokeVoidAsync("localStorage.setItem", VacancyManageRules.ColumnsStorageKey, json);
        }
        catch
        {
            // ignore
        }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("title,status,company,type,applications,views,end_date");
        foreach (var v in Filtered)
        {
            sb.AppendLine($"{Escape(v.Title)},{v.Status},{Escape(v.CompanyName)},{VacancyManageRules.EmploymentTypeLabel(v)},{v.ApplicationCount},{v.ImpressionCount},{v.EndDate:yyyy-MM-dd}");
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var b64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("jobsyExtras.ensure");
        await Js.InvokeVoidAsync("jobsyDownload.bytes", "vacatures.csv", b64, "text/csv;charset=utf-8");
    }

    private static string Escape(string s)
        => "\"" + s.Replace("\"", "\"\"", StringComparison.Ordinal) + "\"";

    private void ConfirmApproveAsync(VacancyListItem v)
    {
        var cost = VacancyManageRules.EstimatePendingTokens(v, _costs);
        var after = _tokenBalance - cost;
        _confirmKind = BulkKind.Approve;
        _confirmVacancyId = v.Id;
        _confirmTitle = Culture["WgVac.Confirm.ApproveTitle"];
        _confirmBody = string.Format(Culture["WgVac.Confirm.ApproveBody"],
            cost.ToString("0.##"), _tokenBalance.ToString("0.##"), after.ToString("0.##"));
        _confirmInsufficient = after < 0;
        _confirmOpen = true;
    }

    private void ConfirmBulkAsync(BulkKind kind)
    {
        var cost = kind switch
        {
            BulkKind.Extend => BulkExtendCost,
            BulkKind.Highlight => BulkHighlightCost,
            _ => 0m
        };
        var after = _tokenBalance - cost;
        _confirmKind = kind;
        _confirmVacancyId = null;
        _confirmTitle = Culture["WgVac.Confirm.BulkTitle"];
        _confirmBody = string.Format(Culture["WgVac.Confirm.BulkBody"],
            cost.ToString("0.##"), _tokenBalance.ToString("0.##"), after.ToString("0.##"));
        _confirmInsufficient = cost > 0 && after < 0;
        _confirmOpen = true;
    }

    private Task CloseConfirm()
    {
        _confirmOpen = false;
        return Task.CompletedTask;
    }

    private string TokenPhrase(decimal amount)
    {
        var text = amount == decimal.Truncate(amount)
            ? decimal.Truncate(amount).ToString("0", CultureInfo.InvariantCulture)
            : amount.ToString("0.##", CultureInfo.InvariantCulture);
        return amount == 1m
            ? Culture["Count.Token.One"]
            : string.Format(Culture["Count.Token.Many"], text);
    }

    private void OpenReopen(VacancyListItem vacancy)
    {
        var cost = _costs.GetValueOrDefault("Extend", 1m);
        var after = _tokenBalance - cost;
        _singleExtend = true;
        _deleteMode = false;
        _confirmKind = BulkKind.Extend;
        _confirmVacancyId = vacancy.Id;
        _confirmTitle = Culture["VacancyAction.Reactivate"];
        var costLabel = TokenPhrase(cost);
        var balanceLabel = TokenPhrase(_tokenBalance);
        _confirmBody = after < 0
            ? string.Format(Culture["WgVac.Confirm.ReopenLow"], costLabel, balanceLabel)
            : string.Format(Culture["WgVac.Confirm.Reopen"], costLabel, balanceLabel, after.ToString("0.##"));
        _confirmInsufficient = after < 0;
        _confirmOpen = true;
    }

    private void OpenDelete(VacancyListItem vacancy)
    {
        _deleteMode = true;
        _singleExtend = false;
        _confirmVacancyId = vacancy.Id;
        _confirmTitle = Culture["WgVac.Delete"];
        _confirmBody = string.Format(Culture["WgVac.Confirm.Delete"], vacancy.Title);
        _confirmInsufficient = false;
        _confirmOpen = true;
    }

    private async Task ConfirmProceedAsync()
    {
        if (_deleteMode && _confirmVacancyId is Guid deleteId)
        {
            _confirmOpen = false;
            _deleteMode = false;
            await DeleteVacancyAsync(deleteId);
            return;
        }

        if (_singleExtend && _confirmVacancyId is Guid extendId)
        {
            _confirmOpen = false;
            _singleExtend = false;
            await ExtendAsync(extendId);
            return;
        }

        if (_confirmKind == BulkKind.Approve && _confirmVacancyId is Guid id)
        {
            _confirmOpen = false;
            await ApproveAsync(id);
            return;
        }

        _confirmOpen = false;
        await RunBulkAsync(_confirmKind);
    }

    private void OpenTopUpFromConfirm()
    {
        _confirmOpen = false;
        OpenTopUp(new InsufficientTokensInfo
        {
            Message = Culture["WgVac.Confirm.AskTokens"],
            RequiredTokens = BulkHighlightCost,
            Balance = _tokenBalance,
            Deficit = Math.Max(0, BulkHighlightCost - _tokenBalance)
        });
    }

    private async Task RunBulkAsync(BulkKind kind)
    {
        var ids = _selected.Take(VacancyManageRules.BulkMax).ToList();
        if (ids.Count == 0)
        {
            return;
        }

        _busy = true;
        var ok = 0;
        var fail = 0;
        var reasons = new List<string>();
        foreach (var id in ids)
        {
            try
            {
                switch (kind)
                {
                    case BulkKind.Extend:
                        await Api.ExtendVacancyAsync(id);
                        break;
                    case BulkKind.Highlight:
                        await Api.HighlightVacancyAsync(id);
                        break;
                    case BulkKind.Deactivate:
                        await Api.DeactivateVacancyAsync(id);
                        break;
                    case BulkKind.Duplicate:
                        Navigation.NavigateTo($"/werkgever/vacatures/nieuw?from={id}");
                        ok++;
                        continue;
                }

                ok++;
            }
            catch (InsufficientTokensException ex)
            {
                fail++;
                reasons.Add(ex.Info.Message ?? "onvoldoende tokens");
                if (Role == EmployerRole.Bedrijfsmanager)
                {
                    OpenTopUp(ex.Info);
                }
            }
            catch (Exception ex)
            {
                fail++;
                reasons.Add(ex.Message);
            }
        }

        _busy = false;
        _selected.Clear();
        await RefreshAsync();
        _message = string.Format(Culture["WgVac.Bulk.Summary"], ok, fail)
            + (reasons.Count > 0 ? " — " + string.Join("; ", reasons.Distinct().Take(3)) : "");
    }

    private async Task RefreshAsync()
    {
        try
        {
            var ids = Scope.CompanyIds;
            _vacancies = (await Api.GetManagedVacanciesAsync(ids.Count > 0 ? ids : null))
                .Select(NormalizeVacancy).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

