@page "/werkgever/vacatures"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Components.Ui.Enterprise
@using Jobsy.Web.Components.Werkgever.Shell
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Components.Werkgever
@using Jobsy.Web.Werkgever
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject CultureState Culture
@inject EmployerScopeState Scope
@inject EmployerScopeBootstrap ScopeBootstrap
@inject IJSRuntime Js
@inject UserFacingError UserFacing
@implements IDisposable

<PageTitle>@Culture["WgNav.Vacancies"] · Lobsy</PageTitle>

<WgPageShell Title="@Culture["WgNav.Vacancies"]" Lead="@LeadText" ReadOnlyHint="@(Role == EmployerRole.Regiomanager)">
    <Actions>
        <button type="button" class="btn-compact" @onclick="ExportCsvAsync">
            <span aria-hidden="true">@((MarkupString)NavIcons.Download)</span>
            @Culture["WgVac.Export"]
        </button>
        @if (CanWrite)
        {
            <WgAction Kind="WgAction.WgActionKind.Primary" RequiresWrite="true" OnClick="GoNewVacancy">
                @Culture["WgVac.Post"]
            </WgAction>
        }
    </Actions>

    <ChildContent>
    <div class="wg-vac wg-vac--dense">
        @if (_loading)
        {
            <PageContentSkeleton Variant="cards" CardCount="4" LoadingLabel="@Culture["EntUi.Loading"]" />
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error">@_error</p>
        }
        else
        {
            <div class="wg-card">
                <EntTabs Tabs="@TabItems" ActiveKey="@_tab" BasePath="/werkgever/vacatures" ExtraQuery="@FilterQueryWithoutTab" />

                <EntFilterBar Query="@_searchQuery" QueryChanged="OnSearchChanged" Placeholder="@Culture["WgVac.Search"]">
                    @if (Role is EmployerRole.Bedrijfsmanager or EmployerRole.Regiomanager)
                    {
                        <label class="ent-filter-bar__select">
                            <span class="visually-hidden">@Culture["WgVac.Filter.Branch"]</span>
                            <select @bind="_filterBranch" @bind:after="OnFilterChanged">
                                <option value="">@Culture["WgVac.Filter.Branch"]</option>
                                @foreach (var b in BranchOptions)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (Role == EmployerRole.Bedrijfsmanager && RegionOptions.Count > 0)
                    {
                        <label class="ent-filter-bar__select">
                            <span class="visually-hidden">@Culture["WgVac.Filter.Region"]</span>
                            <select @bind="_filterRegion" @bind:after="OnFilterChanged">
                                <option value="">@Culture["WgVac.Filter.Region"]</option>
                                @foreach (var r in RegionOptions)
                                {
                                    <option value="@r.Key">@r.Label</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="ent-filter-bar__select">
                        <span class="visually-hidden">@Culture["WgVac.Filter.Type"]</span>
                        <select @bind="_filterType" @bind:after="OnFilterChanged">
                            <option value="">@Culture["WgVac.Filter.Type"]</option>
                            @foreach (var t in VacancyManageRules.EmploymentTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </label>
                    @if (Role == EmployerRole.Vestigingsmanager)
                    {
                        <label class="ent-filter-bar__select">
                            <span class="visually-hidden">@Culture["WgVac.Filter.SalaryTable"]</span>
                            <select @bind="_filterSalaryTable" @bind:after="OnFilterChanged">
                                <option value="">@Culture["WgVac.Filter.SalaryTable"]</option>
                                @foreach (var s in SalaryTableOptions)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <details class="wg-vac__cols">
                        <summary class="btn-compact">@Culture["WgVac.Columns"]</summary>
                        <div class="wg-vac__cols-panel">
                            <label><input type="checkbox" checked="@_colViews" @onchange="e => ToggleCol(nameof(_colViews), e)" /> @Culture["WgVac.Col.Views"]</label>
                            <label><input type="checkbox" checked="@_colOnline" @onchange="e => ToggleCol(nameof(_colOnline), e)" /> @Culture["WgVac.Col.OnlineUntil"]</label>
                            <label><input type="checkbox" checked="@_colVisibility" @onchange="e => ToggleCol(nameof(_colVisibility), e)" /> @Culture["WgVac.Col.Visibility"]</label>
                        </div>
                    </details>
                </EntFilterBar>

                @if (ShowBmPendingNote)
                {
                    <EntImpactNote Tone="info">
                        @string.Format(Culture["WgVac.Info.PendingBm"], PendingBranchCount, _tokenBalance.ToString("0.##"))
                        <a class="auth-link" href="/werkgever/vacatures?tab=wacht">@Culture["WgVac.Info.ShowRequests"]</a>
                    </EntImpactNote>
                }
                else if (ShowVmTokenNote)
                {
                    <EntImpactNote Tone="warn">
                        @string.Format(Culture["WgVac.Info.VmTokens"], Scope.Label, _tokenBalance.ToString("0.##"))
                        <a class="auth-link" href="/werkgever/tokens">@Culture["WgVac.Info.ViewTokens"]</a>
                    </EntImpactNote>
                }

                @if (CanWrite && _selected.Count > 0)
                {
                    <EntBulkBar SelectedCount="_selected.Count" OnClear="ClearSelection">
                        <button type="button" class="btn-compact" @onclick="() => ConfirmBulkAsync(BulkKind.Extend)">
                            @string.Format(Culture["WgVac.Bulk.Extend"], BulkExtendCost.ToString("0.##"))
                        </button>
                        <button type="button" class="btn-compact" @onclick="() => ConfirmBulkAsync(BulkKind.Highlight)">
                            @string.Format(Culture["WgVac.Bulk.Highlight"], BulkHighlightCost.ToString("0.##"))
                        </button>
                        <button type="button" class="btn-compact" @onclick="() => RunBulkAsync(BulkKind.Duplicate)">
                            @Culture["WgVac.Bulk.Duplicate"]
                        </button>
                        <button type="button" class="btn-compact" @onclick="() => RunBulkAsync(BulkKind.Deactivate)">
                            @Culture["WgVac.Bulk.Deactivate"]
                        </button>
                    </EntBulkBar>
                }

                <EntDataTable Loading="false"
                              Empty="@(Paged.Count == 0)"
                              EmptyText="@(_vacancies.Count == 0 ? Culture["WgVac.Empty"] : Culture["WgVac.EmptyFilter"])"
                              ShowCheckbox="@CanWrite"
                              AllSelected="@AllPageSelected"
                              AllSelectedChanged="OnToggleAll"
                              ShowRowActions="true">
                    <Header>
                        <th scope="col">@Culture["WgVac.Col.Vacancy"]</th>
                        <th scope="col">@Culture["WgVac.Col.Status"]</th>
                        <th scope="col">@Culture["WgVac.Col.Applications"]</th>
                        @if (_colViews)
                        {
                            <th scope="col">@Culture["WgVac.Col.Views"]</th>
                        }
                        @if (_colOnline)
                        {
                            <th scope="col">@Culture["WgVac.Col.OnlineUntil"]</th>
                        }
                        @if (_colVisibility)
                        {
                            <th scope="col">@Culture["WgVac.Col.Visibility"]</th>
                        }
                    </Header>
                    <Rows>
                        @foreach (var v in Paged)
                        {
                            var selected = _selected.Contains(v.Id);
                            var pending = string.Equals(v.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase);
                            <tr class="@(pending ? "wg-vac__row--hl" : null) @(selected ? "wg-vac__row--sel" : null)">
                                @if (CanWrite)
                                {
                                    <td class="ent-data-table__check" data-label="@Culture["WgVac.Col.Select"]">
                                        <input type="checkbox" checked="@selected" @onchange="e => ToggleRow(v.Id, e)"
                                               aria-label="@v.Title" />
                                    </td>
                                }
                                <td data-label="@Culture["WgVac.Col.Vacancy"]">
                                    <div class="wg-vac__title-cell">
                                        @if (Role == EmployerRole.Regiomanager)
                                        {
                                            <a class="wg-vac__title" href="@($"/vacancies/{v.Id}")">@v.Title</a>
                                        }
                                        else
                                        {
                                            <a class="wg-vac__title" href="@($"/werkgever/vacatures/nieuw?edit={v.Id}")">@v.Title</a>
                                        }
                                        <span class="wg-vac__meta">@VacancySubLine(v)</span>
                                        @if (!string.IsNullOrEmpty(VacancyInfoLine(v)))
                                        {
                                            <span class="wg-vac__info">@VacancyInfoLine(v)</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="@Culture["WgVac.Col.Status"]">
                                    <span class="status-pill wg-vac-status wg-vac-status--@VacancyManageRules.StatusCss(v)">
                                        @StatusLabel(v)
                                    </span>
                                </td>
                                <td class="tabular" data-label="@Culture["WgVac.Col.Applications"]">
                                    @if (v.NewApplicationCount > 0)
                                    {
                                        <span class="wg-vac__new" title="@Culture["WgVac.Col.Applications"]">@v.NewApplicationCount</span>
                                    }
                                    @v.ApplicationCount
                                </td>
                                @if (_colViews)
                                {
                                    <td class="tabular" data-label="@Culture["WgVac.Col.Views"]">@v.ImpressionCount.ToString("N0", CultureInfo.GetCultureInfo("nl-NL"))</td>
                                }
                                @if (_colOnline)
                                {
                                    <td class="tabular" data-label="@Culture["WgVac.Col.OnlineUntil"]">@OnlineUntilLabel(v)</td>
                                }
                                @if (_colVisibility)
                                {
                                    <td data-label="@Culture["WgVac.Col.Visibility"]">
                                        <div class="wg-vac__vis">
                                            @if (v.IsHighlighted)
                                            {
                                                <span class="wg-vac__chip">
                                                    <span aria-hidden="true">@((MarkupString)ActionIcons.Highlight)</span>
                                                    @Culture["WgVac.Visibility.Highlighted"]
                                                </span>
                                            }
                                            @if (v.HasPushBom)
                                            {
                                                <span class="wg-vac__chip">
                                                    <span aria-hidden="true">@((MarkupString)ActionIcons.Zap)</span>
                                                    @Culture["WgVac.Visibility.Push"]
                                                </span>
                                            }
                                        </div>
                                    </td>
                                }
                                <td class="wg-vac__actions" data-label="@Culture["Common.Actions"]">
                                    @PrimaryAction(v)
                                    @if (CanWrite)
                                    {
                                        <RowActionsMenu>
                                            @MenuItems(v)
                                        </RowActionsMenu>
                                    }
                                </td>
                            </tr>
                        }
                    </Rows>
                </EntDataTable>

                <div class="wg-vac__footer">
                    <span class="muted">@string.Format(Culture["WgVac.Pager"], Paged.Count, Filtered.Count)</span>
                    <EntPager Page="_page" TotalPages="@TotalPages" PageChanged="OnPageChanged" />
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message" role="status">@_message</p>
        }
    </div>
    </ChildContent>
</WgPageShell>

<PublishOptionsDialog IsOpen="_publishOpen"
                      Vacancy="_publishVacancy"
                      OnClose="ClosePublish"
                      OnPublished="OnPublished" />

<PushBomConfirmDialog IsOpen="_pushBomOpen"
                      Vacancy="_pushBomVacancy"
                      OnClose="ClosePushBom"
                      OnConfirmed="OnPushBomConfirmed" />

<TokenTopUpDialog IsOpen="_topUpOpen" Info="_topUpInfo" OnClose="CloseTopUp" />

@if (_confirmOpen)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="@_confirmTitle"
                         TitleId="wg-vac-confirm"
                         OnClose="CloseConfirm">
        <p>@_confirmBody</p>
        @if (_confirmInsufficient && Role == EmployerRole.Vestigingsmanager)
        {
            <p class="state-message error">@Culture["WgVac.Confirm.AskTokens"]</p>
        }
        <div class="inline-actions">
            @if (_confirmInsufficient && Role == EmployerRole.Bedrijfsmanager)
            {
                <button type="button" class="btn-compact btn-compact--primary" @onclick="OpenTopUpFromConfirm">Tokens kopen</button>
            }
            else if (!_confirmInsufficient)
            {
                <VacancyConfirmProceedButton DeleteMode="_deleteMode"
                                             Busy="_busy"
                                             Disabled="_busy"
                                             OnClick="ConfirmProceedAsync" />
            }
            <button type="button" class="btn-compact" disabled="@_busy" @onclick="CloseConfirm">@Culture["Common.Cancel"]</button>
        </div>
    </LobsyFriendlyDialog>
}

@if (_contactOpen && _contactVacancy is not null)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="Voorkeur voor contact"
                         TitleId="contact-pref-title"
                         Lead="@_contactVacancy.Title"
                         OnClose="CloseContactPref">
        <p class="muted">@Culture["WgVac.ContactFromProfile"]</p>
        <label class="checkbox-row" style="margin-top:0.5rem">
            <input type="checkbox" @bind="_contactDirect" @bind:after="OnContactDirectChanged" disabled="@_contactBusy" />
            Direct contact gewenst (WhatsApp / Telefoon / Mail)
        </label>
        @if (_contactDirect)
        {
            <div style="margin-top:0.5rem;display:grid;gap:0.35rem">
                <label class="checkbox-row"><input type="checkbox" @bind="_contactMail" disabled="@_contactBusy" /> Mail</label>
                <label class="checkbox-row"><input type="checkbox" @bind="_contactPhone" disabled="@_contactBusy" /> Telefoon</label>
                <label class="checkbox-row"><input type="checkbox" @bind="_contactWhatsApp" disabled="@_contactBusy" /> WhatsApp</label>
            </div>
        }
        @if (!string.IsNullOrEmpty(_contactError))
        {
            <p class="state-message error">@_contactError</p>
        }
        <div class="inline-actions">
            <button type="button" class="login-submit" disabled="@_contactBusy" @onclick="SaveContactPrefAsync">Opslaan</button>
            <button type="button" class="btn-compact" disabled="@_contactBusy" @onclick="CloseContactPref">Annuleren</button>
        </div>
    </LobsyFriendlyDialog>
}

@code {
    private enum BulkKind { Extend, Highlight, Duplicate, Deactivate, Approve }

    private bool _singleExtend;
    private bool _deleteMode;

    private List<VacancyListItem> _vacancies = [];
    private List<CompanySummary> _companies = [];
    private List<(Guid Id, string Name)> SalaryTableOptions = [];
    private readonly HashSet<Guid> _selected = [];
    private Dictionary<string, decimal> _costs = new(StringComparer.OrdinalIgnoreCase);
    private decimal _tokenBalance;
    private bool _tokensManagedByEnterprise;
    private bool _loading = true;
    private bool _busy;
    private bool _started;
    private string? _error;
    private string? _message;
    private string _tab = "alle";
    private string _searchQuery = "";
    private string _filterBranch = "";
    private string _filterRegion = "";
    private string _filterType = "";
    private string _filterSalaryTable = "";
    private int _page = 1;
    private bool _colViews = true;
    private bool _colOnline = true;
    private bool _colVisibility = true;

    private bool _publishOpen;
    private VacancyListItem? _publishVacancy;
    private bool _pushBomOpen;
    private VacancyListItem? _pushBomVacancy;
    private bool _topUpOpen;
    private InsufficientTokensInfo? _topUpInfo;
    private bool _contactOpen;
    private VacancyListItem? _contactVacancy;
    private bool _contactBusy;
    private string? _contactError;
    private bool _contactDirect;
    private bool _contactMail;
    private bool _contactPhone;
    private bool _contactWhatsApp;

    private bool _confirmOpen;
    private string _confirmTitle = "";
    private string _confirmBody = "";
    private bool _confirmInsufficient;
    private BulkKind _confirmKind;
    private Guid? _confirmVacancyId;

    private EmployerRole Role => Scope.Role ?? EmployerRole.Bedrijfsmanager;
    private bool CanWrite => Role is not EmployerRole.Regiomanager;
    private bool CanApprove => Role == EmployerRole.Bedrijfsmanager;
    private DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private string LeadText => Role switch
    {
        EmployerRole.Regiomanager => string.Format(Culture["WgVac.Lead.Rm"], Scope.Label),
        EmployerRole.Vestigingsmanager => string.Format(Culture["WgVac.Lead.Vm"], Scope.Label),
        _ => string.Format(
            Culture["WgVac.Lead.Bm"],
            string.Format(
                Culture[BranchOptions.Count == 1 ? "WgDash.Count.Branch" : "WgDash.Count.Branches"],
                BranchOptions.Count))
    };

    private IReadOnlyList<(Guid Id, string Name)> BranchOptions =>
        _companies.Where(c => c.ParentCompanyId is not null || Role == EmployerRole.Vestigingsmanager)
            .Select(c => (c.Id, c.Name))
            .Distinct()
            .OrderBy(c => c.Name)
            .ToList();

    private IReadOnlyList<EmployerScopeOption> RegionOptions =>
        Scope.AvailableScopes.Where(s => s.Kind == EmployerScopeKind.Region).ToList();

    private int PendingBranchCount =>
        _vacancies.Where(v => string.Equals(v.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase))
            .Select(v => v.CompanyId).Distinct().Count();

    private bool ShowBmPendingNote =>
        Role == EmployerRole.Bedrijfsmanager && PendingBranchCount > 0 && _tab != "wacht";

    private bool ShowVmTokenNote =>
        Role == EmployerRole.Vestigingsmanager && _tokensManagedByEnterprise;

    private IReadOnlyList<VacancyListItem> Filtered
    {
        get
        {
            IEnumerable<VacancyListItem> q = _vacancies;
            q = q.Where(v => VacancyManageRules.MatchesTab(v, _tab, Today));
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                q = q.Where(v =>
                    v.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    || v.CompanyName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    || v.Id.ToString("N").Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (Guid.TryParse(_filterBranch, out var branchId))
            {
                q = q.Where(v => v.CompanyId == branchId);
            }

            if (!string.IsNullOrEmpty(_filterRegion))
            {
                var regionIds = Scope.CompanyIdsFor(_filterRegion).ToHashSet();
                if (regionIds.Count > 0)
                {
                    q = q.Where(v => regionIds.Contains(v.CompanyId));
                }
            }

            if (!string.IsNullOrEmpty(_filterType))
            {
                q = q.Where(v => string.Equals(
                    VacancyManageRules.EmploymentTypeLabel(v), _filterType, StringComparison.OrdinalIgnoreCase));
            }

            if (Guid.TryParse(_filterSalaryTable, out var tableId))
            {
                q = q.Where(v => v.SalaryTableId == tableId);
            }

            return q.OrderByDescending(v => string.Equals(v.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase))
                .ThenBy(v => v.Title)
                .ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)VacancyManageRules.PageSize));
    private IReadOnlyList<VacancyListItem> Paged =>
        Filtered.Skip((_page - 1) * VacancyManageRules.PageSize).Take(VacancyManageRules.PageSize).ToList();

    private bool AllPageSelected =>
        CanWrite && Paged.Count > 0 && Paged.All(v => _selected.Contains(v.Id));

    private decimal BulkExtendCost =>
        _selected.Count * _costs.GetValueOrDefault("Extend", 1m);

    private decimal BulkHighlightCost =>
        _selected.Count * _costs.GetValueOrDefault("Highlight", VacancyProductRules.DefaultHighlightCostTokens);

    private IReadOnlyList<EntTabs.Tab> TabItems
    {
        get
        {
            var today = Today;
            var tabs = new List<EntTabs.Tab>
            {
                new("alle", $"{Culture["WgVac.Tab.All"]} ({_vacancies.Count})"),
                new("actief", $"{Culture["WgVac.Tab.Active"]} ({_vacancies.Count(v => VacancyManageRules.MatchesTab(v, "actief", today))})"),
                new("wacht", $"{Culture["WgVac.Tab.Pending"]} ({_vacancies.Count(v => VacancyManageRules.MatchesTab(v, "wacht", today))})"),
                new("concept", $"{Culture["WgVac.Tab.Draft"]} ({_vacancies.Count(v => VacancyManageRules.MatchesTab(v, "concept", today))})"),
            };
            var expiring = _vacancies.Count(v => VacancyManageRules.MatchesTab(v, "verloopt", today));
            // EndDate exists on Vacancy — always show the tab when any vacancy has an end date (all do).
            tabs.Add(new("verloopt", $"{Culture["WgVac.Tab.Expiring"]} ({expiring})"));
            tabs.Add(new("gesloten", $"{Culture["WgVac.Tab.Closed"]} ({_vacancies.Count(v => VacancyManageRules.MatchesTab(v, "gesloten", today))})"));
            return tabs;
        }
    }

    private string FilterQueryWithoutTab
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                parts.Add($"q={Uri.EscapeDataString(_searchQuery)}");
            }

            if (!string.IsNullOrEmpty(_filterBranch))
            {
                parts.Add($"vestiging={Uri.EscapeDataString(_filterBranch)}");
            }

            if (!string.IsNullOrEmpty(_filterType))
            {
                parts.Add($"type={Uri.EscapeDataString(_filterType)}");
            }

            return string.Join("&", parts);
        }
    }

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        _started = true;
        await ScopeBootstrap.EnsureLoadedAsync();
        await LoadColumnsAsync();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            ParseQuery();
            var ids = Scope.CompanyIds;
            _vacancies = (await Api.GetManagedVacanciesAsync(ids.Count > 0 ? ids : null))
                .Select(NormalizeVacancy).ToList();
            try
            {
                _companies = (await Api.GetMyCompaniesAsync()).ToList();
            }
            catch
            {
                _companies = [];
            }

            try
            {
                var costs = await Api.GetTokenCostsAsync();
                _costs = costs.ToDictionary(c => c.Reason, c => c.CostTokens, StringComparer.OrdinalIgnoreCase);
            }
            catch
            {
                _costs = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase)
                {
                    ["Publish"] = 1m, ["Highlight"] = 2m, ["PushBom"] = 3m, ["Extend"] = 1m
                };
            }

            try
            {
                var balances = await Api.GetTokenBalancesAsync();
                if (Role == EmployerRole.Vestigingsmanager)
                {
                    var own = balances.FirstOrDefault(b => ids.Contains(b.CompanyId)) ?? balances.FirstOrDefault();
                    _tokenBalance = own?.Balance ?? 0;
                    var co = _companies.FirstOrDefault(c => c.Id == (own?.CompanyId ?? Guid.Empty));
                    _tokensManagedByEnterprise = co?.TokensManagedByEnterprise ?? true;
                }
                else
                {
                    _tokenBalance = balances.Sum(b => b.Balance);
                    _tokensManagedByEnterprise = false;
                }
            }
            catch
            {
                _tokenBalance = 0;
            }

            if (Role == EmployerRole.Vestigingsmanager)
            {
                SalaryTableOptions = _vacancies
                    .Where(v => v.SalaryTableId is Guid)
                    .Select(v => (v.SalaryTableId!.Value, v.CategoryName ?? v.SalaryTableId.Value.ToString("N")[..8]))
                    .Distinct()
                    .ToList();
            }

            await TryOpenBoostFromQueryAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ParseQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("tab", out var tab) && !string.IsNullOrWhiteSpace(tab))
        {
            _tab = tab.ToString().Trim().ToLowerInvariant();
        }

        if (query.TryGetValue("q", out var q) && !string.IsNullOrWhiteSpace(q))
        {
            _searchQuery = q.ToString().Trim();
        }

        if (query.TryGetValue("vestiging", out var vest) && !string.IsNullOrWhiteSpace(vest))
        {
            _filterBranch = vest.ToString();
        }

        if (query.TryGetValue("type", out var type) && !string.IsNullOrWhiteSpace(type))
        {
            _filterType = type.ToString();
        }

        if (query.TryGetValue("salaryTableId", out var st) && Guid.TryParse(st, out var tableId))
        {
            _filterSalaryTable = tableId.ToString("D");
        }

        if (query.TryGetValue("paidAction", out var paid) && !string.IsNullOrWhiteSpace(paid))
        {
            _message = paid.ToString() switch
            {
                "Publish" => Culture["WgVac.Paid.Publish"],
                "Highlight" => Culture["WgVac.Paid.Highlight"],
                "PushBom" => Culture["WgVac.Paid.PushBom"],
                "Extend" => Culture["WgVac.Paid.Extend"],
                _ => "Betaling gelukt — actie uitgevoerd."
            };
        }
    }

    private async Task TryOpenBoostFromQueryAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!CanWrite
            || !query.TryGetValue("boost", out var boostRaw)
            || !query.TryGetValue("id", out var idRaw)
            || !Guid.TryParse(idRaw, out var boostId))
        {
            return;
        }

        var target = _vacancies.FirstOrDefault(v => v.Id == boostId);
        if (target is null)
        {
            return;
        }

        var boost = boostRaw.ToString().Trim().ToLowerInvariant();
        if (boost is "pushbom")
        {
            OpenPushBom(target);
        }
        else if (boost is "highlight" && !target.IsHighlighted)
        {
            await HighlightAsync(target.Id);
        }
    }

    private static VacancyListItem NormalizeVacancy(VacancyListItem vacancy)
    {
        vacancy.WorkTypes ??= Array.Empty<string>();
        vacancy.RequiredTransport ??= Array.Empty<string>();
        vacancy.WageByAge ??= new List<WageByAgeItem>();
        vacancy.DisplayStatus ??= vacancy.IsIncomplete && string.Equals(vacancy.Status, "Draft", StringComparison.OrdinalIgnoreCase)
            ? "DraftIncomplete"
            : vacancy.Status;
        return vacancy;
    }

    private string StatusLabel(VacancyListItem v)
    {
        if (v.PublishOnVerification
            || string.Equals(v.DisplayStatus, "ReadyOnVerification", StringComparison.OrdinalIgnoreCase))
        {
            return Culture["WaBanner.ReadyStatus"];
        }

        return Culture[WerkgeverStatusLabels.VacancyKey(
            v.Status,
            pendingAsVmWaiting: Role == EmployerRole.Vestigingsmanager)];
    }

    private string VacancySubLine(VacancyListItem v)
    {
        var type = VacancyManageRules.EmploymentTypeLabel(v);
        return Role == EmployerRole.Vestigingsmanager
            ? type
            : $"{v.CompanyName} · {type}";
    }

    private string? VacancyInfoLine(VacancyListItem v)
    {
        if (string.Equals(v.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase))
        {
            var tokens = VacancyManageRules.EstimatePendingTokens(v, _costs).ToString("0.##");
            return string.IsNullOrWhiteSpace(v.RequesterDisplayName)
                ? string.Format(Culture["WgVac.RequestLineAnon"], tokens)
                : string.Format(Culture["WgVac.RequestLine"], v.RequesterDisplayName, tokens);
        }

        if (string.Equals(v.Status, "Draft", StringComparison.OrdinalIgnoreCase))
        {
            if (v.IsIncomplete || v.IncompleteFieldCount > 0)
            {
                var n = Math.Max(1, v.IncompleteFieldCount);
                return string.Format(Culture["WgVac.DraftIncomplete"], n);
            }

            return Culture["WgVac.DraftReady"];
        }

        return null;
    }

    private string OnlineUntilLabel(VacancyListItem v)
    {
        if (string.Equals(v.Status, "Archived", StringComparison.OrdinalIgnoreCase)
            || string.Equals(v.Status, "Fulfilled", StringComparison.OrdinalIgnoreCase))
        {
            return string.Format(Culture["WgVac.ClosedOn"], v.EndDate.ToString("dd-MM-yyyy"));
        }

        if (string.Equals(v.Status, "Draft", StringComparison.OrdinalIgnoreCase)
            || string.Equals(v.Status, "PendingApproval", StringComparison.OrdinalIgnoreCase))
        {
            return "—";
        }

        return v.EndDate.ToString("dd-MM-yyyy");
    }

    private RenderFragment PrimaryAction(VacancyListItem v) => __builder =>
    {
        var status = v.Status ?? "";
        if (string.Equals(status, "PendingApproval", StringComparison.OrdinalIgnoreCase) && CanApprove)
        {
            <button type="button" class="btn-compact btn-compact--primary" @onclick="() => ConfirmApproveAsync(v)">
                @Culture["VacancyAction.Approve"]
            </button>
            return;
        }

        if (string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase) && CanWrite)
        {
            <a class="btn-compact btn-compact--primary" href="@($"/werkgever/vacatures/nieuw?edit={v.Id}")">
                @Culture["VacancyAction.Finish"]
            </a>
            return;
        }

        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            <a class="btn-compact wg-vac__inbox" href="@($"/werkgever/sollicitaties?vacature={v.Id}")" title="@Culture["VacancyAction.Applications"]">
                <span aria-hidden="true">@((MarkupString)ActionIcons.Mail)</span>
                <span class="visually-hidden">@Culture["VacancyAction.Applications"]</span>
            </a>
            return;
        }

        if ((string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase)
             || string.Equals(status, "Fulfilled", StringComparison.OrdinalIgnoreCase))
            && CanWrite)
        {
            <a class="btn-compact" href="@($"/werkgever/vacatures/nieuw?from={v.Id}")">
                @Culture["VacancyAction.Duplicate"]
            </a>
        }
    };

    private RenderFragment MenuItems(VacancyListItem v) => __builder =>
    {
        var status = v.Status ?? "";
        <a class="row-actions-menu__item" role="menuitem" href="@($"/vacancies/{v.Id}")">@Culture["VacancyAction.View"]</a>
        if (!CanWrite)
        {
            return;
        }

        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase))
        {
            <a class="row-actions-menu__item" role="menuitem" href="@($"/werkgever/vacatures/nieuw?edit={v.Id}")">Bewerken</a>
        }

        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenPublish(v)">
                @Culture["VacancyAction.Visibility"]
            </button>
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => ExtendAsync(v.Id)">
                @Culture["VacancyAction.Extend"]
            </button>
            @if (!v.IsHighlighted)
            {
                <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => HighlightAsync(v.Id)">
                    @Culture["VacancyAction.Highlight"]
                </button>
            }
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenPushBom(v)">
                @Culture["VacancyAction.PushBom"]
            </button>
            <a class="row-actions-menu__item" role="menuitem" href="@($"/werkgever/vacatures/nieuw?from={v.Id}")">
                @Culture["VacancyAction.Duplicate"]
            </a>
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => DeactivateAsync(v.Id)">
                @Culture["VacancyAction.Deactivate"]
            </button>
        }

        if (string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase) && !v.IsIncomplete)
        {
            if (IsCompanyUnverified(v))
            {
                if (v.PublishOnVerification)
                {
                    <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => ClearReadyAsync(v.Id)">
                        Klaar ongedaan maken
                    </button>
                }
                else
                {
                    <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => MarkReadyAsync(v)">
                        @Culture["WaBanner.ReadyCta"]
                    </button>
                }
            }
            else
            {
                <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenPublish(v)">
                    @Culture["VacancyAction.Publish"]
                </button>
            }
        }

        if (string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase))
        {
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenReopen(v)">
                @Culture["VacancyAction.Reactivate"]
            </button>
        }

        if ((string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase)
             || string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase))
            && v.ApplicationCount == 0)
        {
            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenDelete(v)">
                @Culture["WgVac.Delete"]
            </button>
        }

        <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenContactPref(v)">
            @Culture["VacancyAction.Contact"]
        </button>
    };

