@page "/werkgever/sollicitaties/{ApplicationId:guid}/after-match/panel-ssr"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Components.Werkgever.Shell
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@_pageTitle · Lobsy</PageTitle>
<PageSeo Title="@_pageTitle" />
<HeadContent>
    @foreach (var href in PageAssetCatalog.StylesheetsFor(
                  PageAssetCatalog.Area.Werkgever,
                  "/werkgever/sollicitaties"))
    {
        <link rel="stylesheet" href="@href" />
    }
    <link rel="stylesheet" href="css/features/na-de-match.css?v=20261025-ndm-wg0203" />
    <script src="/js/ndm-employer.js?v=20261025-ndm-wg0203" defer></script>
</HeadContent>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_redirecting)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    <WgPageShell Title="@_heroTitle"
                 Lead="@_heroLead"
                 CrumbDetail="@_candidateName">
        @((MarkupString)_bodyHtml)
    </WgPageShell>
}

@code {
    [Parameter] public Guid ApplicationId { get; set; }

    private bool _loading = true;
    private bool _redirecting;
    private string? _fatalMessage;
    private string? _bodyHtml;
    private string? _candidateName;
    private string _pageTitle = "";
    private string _heroTitle = "";
    private string _heroLead = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            http.Response.Headers.CacheControl = "no-store";

            var panel = AfterMatchEmployerPanelRouting.ResolvePanel(http.Request.Query);
            var isProposePanel = panel is "propose" or "slots";

            var thread = await Api.GetAfterMatchForEmployerAsync(ApplicationId, http.RequestAborted);
            if (!AfterMatchEmployerSsrRouting.ShouldUseWatNuScreen(thread)
                && !(isProposePanel && AfterMatchEmployerSsrRouting.ShouldUseProposeScreen(thread)))
            {
                _redirecting = true;
                var blazorPath = $"/werkgever/sollicitaties/{ApplicationId:D}/after-match/blazor";
                if (http.Request.QueryString.HasValue)
                {
                    blazorPath += http.Request.QueryString.Value;
                }

                http.Response.Redirect(blazorPath);
                return;
            }

            if (thread is null)
            {
                _fatalMessage = Culture["AfterMatch.Error.NotFound"];
                return;
            }

            _candidateName = thread.CandidateName;
            _heroTitle = isProposePanel
                ? Culture["AfterMatch.Screen03.Hero.Title"]
                : Culture["AfterMatch.Screen02.Hero.Title"];
            _heroLead = isProposePanel
                ? Culture["AfterMatch.Screen03.Hero.Lead"]
                : Culture["AfterMatch.Screen02.Hero.Lead"];
            _pageTitle = _heroTitle;

            var data = new AfterMatchEmployerPanelSsrShells.PageData(
                thread,
                $"/werkgever/sollicitaties/{ApplicationId:D}",
                null,
                AfterMatchEmployerDemoSlots.InitialUtc,
                InterviewFormat.OnSite,
                "Loosduinseweg 120, Den Haag · ingang naast de winkel",
                "Linda de Wit, eigenaar",
                "Je hoeft niets voor te bereiden. Kom gerust in je gewone kleren.",
                panel);

            _bodyHtml = AfterMatchEmployerPanelSsrShells.BuildBody(Culture, data, ApplicationId);
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
