@page "/werkgever/sollicitaties/{ApplicationId:guid}/after-match/reschedule-ssr"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Components.Werkgever.Shell
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["AfterMatch.Screen09.Hero.Title"] · Lobsy</PageTitle>
<PageSeo Title="@Culture["AfterMatch.Screen09.Hero.Title"]" />
<HeadContent>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-employer.js")}")" defer></script>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-employer-reschedule.js")}")" defer></script>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-employer-cancel.js")}")" defer></script>
</HeadContent>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    <WgPageShell Title="@_pageTitle"
                 Lead="@_pageLead"
                 CrumbDetail="@_candidateName">
        @((MarkupString)_bodyHtml)
    </WgPageShell>
}

@code {
    [Parameter] public Guid ApplicationId { get; set; }

    private bool _loading = true;
    private string? _fatalMessage;
    private string? _bodyHtml;
    private string? _candidateName;
    private string _pageTitle = "";
    private string _pageLead = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            http.Response.Headers.CacheControl = "no-store";

            var panel = AfterMatchEmployerPanelRouting.ResolvePanel(http.Request.Query);
            if (panel is "slots")
            {
                panel = "propose";
            }

            var thread = await Api.GetAfterMatchForEmployerAsync(ApplicationId, http.RequestAborted);
            if (!AfterMatchEmployerSsrRouting.ShouldAllowEmployerRescheduleSsrRoute(thread))
            {
                _fatalMessage = Culture["AfterMatch.Error.NotFound"];
                return;
            }

            if (thread is null)
            {
                _fatalMessage = Culture["AfterMatch.Error.NotFound"];
                return;
            }

            _candidateName = AfterMatchEmployerEmployerPresentation.CandidateDisplayName(thread);
            var data = AfterMatchEmployerRescheduleSsrData.FromThread(Culture, thread, ApplicationId);
            var pageTitle = data.EmployerInitiatedReschedule
                ? Culture["AfterMatch.Employer.Reschedule.EmployerInitiatedTitle"]
                : Culture["AfterMatch.Screen09.Hero.Title"];
            var pageLead = data.EmployerInitiatedReschedule
                ? Culture["AfterMatch.Employer.Reschedule.EmployerInitiatedLead"]
                : Culture["AfterMatch.Screen09.Hero.Lead"];
            _pageTitle = pageTitle;
            _pageLead = pageLead;
            var proposeData = new AfterMatchEmployerPanelSsrShells.PageData(
                thread,
                $"/werkgever/sollicitaties/{ApplicationId:D}",
                null,
                AfterMatchEmployerDemoSlots.InitialUtc(thread.ScheduledStartUtc),
                InterviewFormat.OnSite,
                "Loosduinseweg 120, Den Haag · ingang naast de winkel",
                "Linda de Wit, eigenaar",
                "Je hoeft niets voor te bereiden. Kom gerust in je gewone kleren.",
                panel is "propose" ? "propose" : "",
                null);
            var cancelData = new AfterMatchEmployerCancelSsrShells.PageData(
                thread,
                $"/werkgever/sollicitaties/{ApplicationId:D}/after-match",
                $"/werkgever/sollicitaties/{ApplicationId:D}");
            var options = new AfterMatchEmployerRescheduleSsrShells.BuildOptions(panel, proposeData, cancelData);
            _bodyHtml = AfterMatchEmployerRescheduleSsrShells.BuildBody(Culture, data, ApplicationId, options);
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
