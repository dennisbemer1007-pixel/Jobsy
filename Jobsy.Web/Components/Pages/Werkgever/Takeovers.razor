@page "/werkgever/overnames"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,EnterpriseManager,Admin")]
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["WgNav.Takeovers"] · Lobsy</PageTitle>

<WgPageShell Title="@Culture["WgNav.Takeovers"]" Lead="@Culture["WgTakeovers.Lead"]">
    <ChildContent>
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">@Culture["WgTakeovers.Empty"]</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var item in _items)
            {
                <div class="table-row">
                    <div>
                        <strong>@item.TargetCompanyName</strong>
                        <span class="muted">@item.KvkEstablishmentId · scope @item.Scope</span>
                        <span class="muted">Aanvrager: @item.RequesterName (@item.RequesterEmail)</span>
                    </div>
                    <div class="wizard-actions">
                        <button class="btn-compact" type="button" disabled="@_busy"
                                @onclick="() => RejectAsync(item.TakeoverId)">@Culture["WgTakeovers.Reject"]</button>
                        <button class="btn-compact btn-compact--primary" type="button" disabled="@_busy"
                                @onclick="() => ApproveAsync(item.TakeoverId)">@Culture["WgTakeovers.Approve"]</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
    </ChildContent>
</WgPageShell>

@code {
    private List<TakeoverInboxItem> _items = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = (await Api.GetTakeoverInboxAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(Guid id)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Api.ApproveTakeoverAsync(id);
            _message = result.Message;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(Guid id)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Api.RejectTakeoverAsync(id);
            _message = result.Message;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
