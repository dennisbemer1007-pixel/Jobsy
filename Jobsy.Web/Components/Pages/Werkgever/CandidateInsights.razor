@page "/werkgever/kandidaatinzichten"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager")]
@implements IAsyncDisposable
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@using Jobsy.Core.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

<PageTitle>@Culture["Insights.Title"] · Lobsy</PageTitle>

<div class="panel-page insights-page" tabindex="0" @onkeydown="OnKeyDown">
    <EmployerTalentTabs Active="insights" />

    @if (_storyMode)
    {
        var branchName = BranchLabel();
        var periodLabel = PeriodLabel();
        var radiusLabel = string.Format(Culture["Insights.Filter.Km"], _radiusKm);
        var locked = _data is null || !_data.Scope.IsFullAccess;

        <div class="insights-story-viewer" role="region" aria-roledescription="carousel" aria-label="@Culture["Insights.Tab.Insights"]">
            <div class="insights-story-viewer__progress" aria-hidden="true">
                @for (var i = 0; i < 10; i++)
                {
                    <span class="insights-story-viewer__seg @(i < _storyIndex ? "is-done" : i == _storyIndex ? "is-active" : null)"></span>
                }
            </div>
            <div class="insights-story-viewer__head">
                <div class="insights-story-viewer__meta">
                    <strong>@string.Format(Culture["Insights.Story.Title"], branchName)</strong>
                    <span>@string.Format(Culture["Insights.Story.Progress"], _storyIndex + 1, radiusLabel, periodLabel)</span>
                </div>
                <button type="button" class="insights-story-viewer__close" aria-label="@Culture["Insights.Story.Close"]" @onclick="CloseStory">×</button>
            </div>
            <button type="button" class="insights-story-tap insights-story-tap--prev" aria-label="@Culture["Insights.Story.Prev"]" @onclick="PrevStory"></button>
            <button type="button" class="insights-story-tap insights-story-tap--next" aria-label="@Culture["Insights.Story.Next"]" @onclick="NextStory"></button>
            <div class="insights-story-viewer__track">
                <InsightsStoryCard Index="0" Current="_storyIndex" Title="@Culture["Insights.Story.Card1"]" Locked="false">
                    <MetricTile Label="@Culture["Insights.Kpi.Candidates"]" FormattedValue="@CountText(_data?.Kpis.CandidatesInRadius)" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="1" Current="_storyIndex" Title="@Culture["Insights.Story.Card2"]" Locked="false">
                    <InsightsRankedList Items="@(_data?.DreamJobsTop?.Take(3).ToList() ?? [])" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="2" Current="_storyIndex" Title="@Culture["Insights.Story.Card3"]" Locked="false">
                    <MetricTile Label="@Culture["Insights.Kpi.AvgHours"]" FormattedValue="@CountText(_data?.Kpis.AvgHoursPerWeek)" />
                    <MetricTile Label="@Culture["Insights.Kpi.Hours32"]" FormattedValue="@CountText(_data?.Kpis.Candidates32PlusHours)" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="3" Current="_storyIndex" Title="@Culture["Insights.Story.Card4"]" Locked="false">
                    <InsightsDistributionBars Dist="_data?.Priorities" PriorityLabels="true" />
                    <InsightsTipsBlock Data="_data" IsRegional="_isRegional" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="4" Current="_storyIndex" Title="@Culture["Insights.Story.Card5"]" Locked="@locked" TokensHref="@_tokensHref">
                    <InsightsDistributionBars Dist="_data?.WorkKinds" WorkKind="true" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="5" Current="_storyIndex" Title="@Culture["Insights.Story.Card6"]" Locked="@locked" TokensHref="@_tokensHref" TestId="insights-story-card-6">
                    <InsightsVacanciesList Data="_data" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="6" Current="_storyIndex" Title="@Culture["Insights.Story.Card7"]" Locked="@locked" TokensHref="@_tokensHref">
                    <InsightsDistributionBars Dist="_data?.DnaRiasec" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="7" Current="_storyIndex" Title="@Culture["Insights.Story.Card8"]" Locked="@locked" TokensHref="@_tokensHref">
                    <InsightsDistributionBars Dist="_data?.WorkFields" />
                </InsightsStoryCard>
                <InsightsStoryCard Index="8" Current="_storyIndex" Title="@Culture["Insights.Story.Card9"]" Locked="@locked" TokensHref="@_tokensHref">
                    <div class="insights-trend-placeholder">@Culture["Insights.Trend.Placeholder"]</div>
                </InsightsStoryCard>
                <InsightsStoryCard Index="9" Current="_storyIndex" Title="@Culture["Insights.Story.Card10"]" Locked="@locked" TokensHref="@_tokensHref" TestId="insights-story-card-10" ShowCta="true">
                    <p>@Culture["Insights.Story.Card10.Lead"]</p>
                </InsightsStoryCard>
            </div>
            <div class="insights-story-nav">
                <button type="button" class="btn-compact provider-btn" disabled="@(_storyIndex == 0)" @onclick="PrevStory">@Culture["Insights.Story.Prev"]</button>
                <button type="button" class="btn-compact login-submit" disabled="@(_storyIndex == 9)" @onclick="NextStory">@Culture["Insights.Story.Next"]</button>
            </div>
        </div>
    }
    else
    {
        <header class="insights-header">
            <div class="insights-header__row">
                <h1>@Culture["Insights.Title"]</h1>
                @if (_data?.Scope.IsFullAccess == false)
                {
                    <span class="status-pill">@Culture["Insights.FreeBadge"]</span>
                }
                <div class="insights-header__actions">
                    @if (_data?.Scope.IsFullAccess == false)
                    {
                        <a class="btn-compact login-submit" href="@_tokensHref">@Culture["Insights.Cta.Full"]</a>
                        <button type="button" class="btn-compact provider-btn" @onclick="OpenStory">@Culture["Insights.Cta.Story"]</button>
                    }
                    else
                    {
                        <button type="button" class="btn-compact login-submit" @onclick="OpenStory">@Culture["Insights.Cta.Story"]</button>
                    }
                </div>
            </div>
            <p class="login-lead">@Culture["Insights.Lead"]</p>
            @if (_isRegional)
            {
                <p class="profile-address__hint">@Culture["Insights.RegionalReadOnly"]</p>
            }
        </header>

        <p class="insights-anonymity">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a5 5 0 0 1 5 5v1h1a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3h1V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v1h6V7a3 3 0 0 0-3-3Z"/></svg>
            <span>@Culture["Insights.Anonymity"]</span>
        </p>

        <div class="insights-filters">
            <div class="insights-filters__field">
                <label for="insights-branch">@Culture["Insights.Filter.Branch"]</label>
                <select id="insights-branch" class="insights-filters__control" disabled="@(_branchLocked || _loading)" value="@BranchSelectValue" @onchange="OnBranchChanged">
                    @if (_canSelectAll)
                    {
                        <option value="">@string.Format(Culture["Insights.Filter.AllBranches"], _branches.Count)</option>
                    }
                    @foreach (var b in _branches)
                    {
                        <option value="@b.Id.ToString("D")">@b.Name</option>
                    }
                </select>
            </div>
            <div class="insights-filters__field">
                <span>@Culture["Insights.Filter.Radius"]</span>
                <div class="insights-radius" role="group" aria-label="@Culture["Insights.Filter.Radius"]">
                    @foreach (var km in _radii)
                    {
                        <button type="button" class="insights-radius__btn @(_radiusKm == km ? "is-active" : null)" disabled="@_loading" @onclick="() => SetRadiusAsync(km)">
                            @string.Format(Culture["Insights.Filter.Km"], km)
                        </button>
                    }
                </div>
            </div>
            <div class="insights-filters__field">
                <label for="insights-period">@Culture["Insights.Filter.Period"]</label>
                <select id="insights-period" class="insights-filters__control" disabled="@_loading" @bind="_periodDays" @bind:after="ReloadAsync">
                    <option value="30">@Culture["Insights.Filter.Period.30"]</option>
                    <option value="90">@Culture["Insights.Filter.Period.90"]</option>
                    <option value="365">@Culture["Insights.Filter.Period.365"]</option>
                </select>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message">@_error</p>
        }
        else if (_loading || _data is null)
        {
            <div class="insights-kpis" aria-busy="true">
                <MetricTileSkeleton /><MetricTileSkeleton /><MetricTileSkeleton /><MetricTileSkeleton />
            </div>
        }
        else
        {
            var d = _data;
            var isLocked = !d.Scope.IsFullAccess;
            <div class="insights-grid insights-grid--main">
                <div class="insights-kpis insights-span-12">
                    <MetricTile Label="@Culture["Insights.Kpi.Candidates"]" FormattedValue="@CountText(d.Kpis.CandidatesInRadius)" />
                    <MetricTile Label="@Culture["Insights.Kpi.AvgHours"]" FormattedValue="@CountText(d.Kpis.AvgHoursPerWeek)" />
                    <MetricTile Label="@Culture["Insights.Kpi.Hours32"]" FormattedValue="@CountText(d.Kpis.Candidates32PlusHours)" />
                    <MetricTile Label="@Culture["Insights.Kpi.Matching"]" FormattedValue="@CountText(d.Kpis.MatchingYourVacancies)" />
                </div>

                <section class="insights-panel insights-span-7">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.DreamJobs"]</h2>
                    <InsightsRankedList Items="d.DreamJobsTop" />
                    @if (isLocked)
                    {
                        <InsightsLockedBlock TokensHref="@_tokensHref" TestId="insights-locked-dreams" />
                    }
                </section>

                <section class="insights-panel insights-span-5">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.Map"]</h2>
                    <div class="insights-map">
                        <div id="@_mapElementId" class="insights-map__canvas" role="img" aria-label="@Culture["Insights.Section.Map"]"></div>
                    </div>
                    <div class="insights-map__legend">
                        <div class="insights-map__swatches" aria-hidden="true">
                            <span class="insights-map__swatch" data-band="1"></span>
                            <span class="insights-map__swatch" data-band="2"></span>
                            <span class="insights-map__swatch" data-band="3"></span>
                        </div>
                        <span>@Culture["Insights.Map.LegendDensity"]</span>
                        <span>@Culture["Insights.Map.LegendRadius"]</span>
                        <span>@Culture["Insights.Map.LegendPrivacy"]</span>
                    </div>
                </section>

                <section class="insights-panel insights-span-7">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.Competences"]</h2>
                    @if (isLocked || d.Competences is null || d.DnaRiasec is null)
                    {
                        <InsightsLockedBlock TokensHref="@_tokensHref" TestId="insights-locked-dna" />
                    }
                    else
                    {
                        <InsightsDistributionBars Dist="d.Competences" />
                        <InsightsDistributionBars Dist="d.DnaRiasec" />
                    }
                </section>

                <section class="insights-panel insights-span-5">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.Priorities"]</h2>
                    <InsightsDistributionBars Dist="d.Priorities" PriorityLabels="true" />
                    <h3 class="insights-panel__title" style="margin-block-start:1rem">@Culture["Insights.Section.Tip"]</h3>
                    <InsightsTipsBlock Data="d" IsRegional="_isRegional" />
                </section>

                <section class="insights-panel insights-span-4">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.WorkFields"]</h2>
                    <InsightsDistributionBars Dist="d.WorkFields" />
                </section>
                <section class="insights-panel insights-span-4">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.WorkKinds"]</h2>
                    <InsightsDistributionBars Dist="d.WorkKinds" WorkKind="true" />
                </section>
                <section class="insights-panel insights-span-4">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.Trends"]</h2>
                    <div class="insights-trend-placeholder">@Culture["Insights.Trend.Placeholder"]</div>
                </section>

                <section class="insights-panel insights-span-12">
                    <h2 class="insights-panel__title">@Culture["Insights.Section.Vacancies"]</h2>
                    <InsightsVacanciesList Data="d" />
                </section>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "weergave")] public string? Weergave { get; set; }

    private static readonly int[] _radii = [10, 20, 30];
    private bool _loading = true;
    private bool _storyMode;
    private bool _branchLocked;
    private bool _canSelectAll;
    private bool _isRegional;
    private bool _isBranchManager;
    private bool _mapMounted;
    private string? _error;
    private string _tokensHref = "/werkgever/tokens";
    private readonly string _mapElementId = "insights-map-" + Guid.NewGuid().ToString("N");
    private Guid? _selectedBranchId;
    private int _radiusKm = 20;
    private int _periodDays = 90;
    private int _storyIndex;
    private List<CandidateInsightsBranchDto> _branches = [];
    private CandidateInsightsDto? _data;

    private string BranchSelectValue => _selectedBranchId?.ToString("D") ?? "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isRegional = RoleClaimMatching.HasRole(user, JobsyRoles.RegionalManager);
        _isBranchManager = RoleClaimMatching.HasRole(user, JobsyRoles.BranchManager);
        _tokensHref = _isBranchManager ? "/werkgever/tokens" : "/werkgever/tokens";
        _storyMode = string.Equals(Weergave, "story", StringComparison.OrdinalIgnoreCase);

        _branches = (await Api.GetCandidateInsightsBranchesAsync()).ToList();
        _branchLocked = _branches.Count > 0 && _branches.All(b => b.IsLocked);
        _canSelectAll = !_branchLocked && _branches.Count >= 2;
        if (_branchLocked && _branches.Count > 0)
        {
            _selectedBranchId = _branches[0].Id;
        }

        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is null || _storyMode || _mapMounted)
        {
            return;
        }

        try
        {
            await CandidateInsightsMapInterop.EnsureLoadedAsync(Js);
            var centerLng = _data.Scope.Branches.FirstOrDefault()?.Lng
                            ?? _data.Density.FirstOrDefault()?.CenterLng
                            ?? 5.2;
            var centerLat = _data.Scope.Branches.FirstOrDefault()?.Lat
                            ?? _data.Density.FirstOrDefault()?.CenterLat
                            ?? 52.1;
            await CandidateInsightsMapInterop.MountAsync(
                Js,
                _mapElementId,
                new
                {
                    center = new[] { centerLng, centerLat },
                    radiusKm = _radiusKm,
                    density = _data.Density,
                    branches = _data.Scope.Branches.Select(b => new { lat = b.Lat, lng = b.Lng, name = b.Name }).ToList()
                });
            _mapMounted = true;
        }
        catch
        {
            // Progressive enhancement — map optional.
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _mapMounted = false;
        try
        {
            _data = await Api.GetCandidateInsightsAsync(_selectedBranchId, _radiusKm, _periodDays);
            if (_data is null)
            {
                _error = Culture["Insights.Error"];
            }
        }
        catch
        {
            _error = Culture["Insights.Error"];
            _data = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _selectedBranchId = Guid.TryParse(raw, out var id) ? id : null;
        await ReloadAsync();
    }

    private async Task SetRadiusAsync(int km)
    {
        if (_radiusKm == km)
        {
            return;
        }

        _radiusKm = km;
        await ReloadAsync();
    }

    private void OpenStory()
    {
        _storyMode = true;
        _storyIndex = 0;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("weergave", "story"), replace: true);
    }

    private void CloseStory()
    {
        _storyMode = false;
        Navigation.NavigateTo("/werkgever/kandidaatinzichten", replace: true);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!_storyMode)
        {
            return;
        }

        if (e.Key == "Escape")
        {
            CloseStory();
        }
        else if (e.Key is "ArrowRight" or "ArrowDown")
        {
            NextStory();
        }
        else if (e.Key is "ArrowLeft" or "ArrowUp")
        {
            PrevStory();
        }
    }

    private void NextStory() => _storyIndex = Math.Min(9, _storyIndex + 1);
    private void PrevStory() => _storyIndex = Math.Max(0, _storyIndex - 1);

    private string BranchLabel()
    {
        if (_selectedBranchId is null && _canSelectAll)
        {
            return string.Format(Culture["Insights.Filter.AllBranches"], _branches.Count);
        }

        return _data?.Scope.Branches.FirstOrDefault()?.Name
               ?? _branches.FirstOrDefault(b => b.Id == _selectedBranchId)?.Name
               ?? "";
    }

    private string PeriodLabel() => _periodDays switch
    {
        30 => Culture["Insights.Filter.Period.30"],
        365 => Culture["Insights.Filter.Period.365"],
        _ => Culture["Insights.Filter.Period.90"]
    };

    private string CountText(SuppressedCountModel? count)
    {
        if (count is null || count.Status != "ok" || count.Value is null)
        {
            return Culture["Insights.Insufficient"];
        }

        return count.Value.Value.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await CandidateInsightsMapInterop.DestroyAsync(Js, _mapElementId);
        }
        catch
        {
            // ignore
        }
    }
}
