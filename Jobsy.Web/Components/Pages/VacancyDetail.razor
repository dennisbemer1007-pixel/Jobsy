    private string? HoursCategoryLabel
    {
        get
        {
            if (_vacancy?.MinHoursPerWeek is not decimal min || _vacancy.MaxHoursPerWeek is not decimal max)
            {
                return null;
            }

            var range = new HoursRange(min, max);
            return range.Validate() is null
                ? HoursRangeRules.CategoryLabel(range.Category)
                : null;
        }
    }

    private IReadOnlyList<string> ScheduleChips
    {
        get
        {
            if (_vacancy is null || _vacancy.FlexibleTimes || string.IsNullOrWhiteSpace(_vacancy.ScheduleJson))
            {
                return [];
            }

            try
            {
                var payload = System.Text.Json.JsonSerializer.Deserialize<SchedulePayload>(
                    _vacancy.ScheduleJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (payload?.Slots is null || payload.Slots.Count == 0)
                {
                    return [];
                }

                return payload.Slots
                    .OrderBy(kv => Array.IndexOf(DayPartMatrix.DayCodes, DayPartMatrix.NormalizeDayCode(kv.Key)))
                    .SelectMany(kv => (kv.Value ?? [])
                        .OrderBy(p => Array.IndexOf(DayPartMatrix.DayPartCodes, DayPartMatrix.NormalizeDayPartCode(p)))
                        .Select(p => $"{DayPartMatrix.NormalizeDayCode(kv.Key)} {DayPartMatrix.NormalizeDayPartCode(p)}"))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch (System.Text.Json.JsonException)
            {
                return [];
            }
        }
    }

    private IReadOnlyList<LegalFactItem> LegalFactItems
    {
        get
        {
            if (_vacancy is null)
            {
                return [];
            }

            var items = new List<LegalFactItem>();
            void Add(bool? value, string label, bool highlightWhenTrue = true, bool invertHighlight = false)
            {
                if (value is null)
                {
                    return;
                }

                var active = value.Value;
                var highlighted = invertHighlight ? !active : (highlightWhenTrue && active);
                items.Add(new LegalFactItem(label, active, highlighted));
            }

            Add(_vacancy.LegalWorksAfter19, Culture["Vacancy.LegalWorksAfter19"]);
            Add(_vacancy.LegalNightShift23To06, Culture["Vacancy.LegalNightShift"]);
            Add(_vacancy.LegalAdultSupervisorPresent, Culture["Vacancy.LegalAdultSupervisor"], highlightWhenTrue: false, invertHighlight: true);
            Add(_vacancy.LegalHandlesMoneyOrClosing, Culture["Vacancy.LegalHandlesMoney"]);
            Add(_vacancy.LegalHeavyOrHazardousWork, Culture["Vacancy.LegalHeavyWork"]);
            return items;
        }
    }

    private readonly record struct LegalFactItem(string Label, bool Active, bool Highlighted);

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistVacancyState);
        if (Persist.TryTakeFromJson<VacancyListItem>("vacancyDetail", out var saved)
            && saved is not null
            && saved.Id == Id)
        {
            _vacancy = saved;
            _loading = false;
        }
    }

    private Task PersistVacancyState()
    {
        if (_vacancy is not null)
        {
            Persist.PersistAsJson("vacancyDetail", _vacancy);
        }

        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedVacancyId == Id)
        {
            return;
        }

        var keepPrerendered = _vacancy is not null && _vacancy.Id == Id;
        ResetApplyUiState();
        _loadedVacancyId = Id;
        _liked = false;
        _clickRecorded = false;
        _ageYears = null;
        _mapReady = false;
        _mappedVacancyId = null;
        _mapObserveAttached = false;
        _videoActivated = false;
        _pendingInitialHydration = true;
        if (keepPrerendered)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _vacancy = null;
        if (!RendererInfo.IsInteractive)
        {
            await LoadAsync(origin: null);
            ApplyNotFoundStatus();
        }
    }

    /// <summary>
    /// An unknown or non-public vacancy is a real 404 for crawlers; a closed one (archived,
    /// fulfilled, or ran past its end date) is a real 410 — never a 200 with a message.
    /// </summary>
    private void ApplyNotFoundStatus()
    {
        var http = HttpContextAccessor.HttpContext;
        if (_vacancy is not null || http is null || http.Response.HasStarted)
        {
            return;
        }

        http.Response.StatusCode = _closed is not null
            ? StatusCodes.Status410Gone
            : StatusCodes.Status404NotFound;
        Jobsy.Web.Hosting.ErrorResponse.ApplyHeaders(http);
    }

    private bool _pendingInitialHydration;

    private void ResetApplyUiState()
    {
        _applying = false;
        _applied = false;
        _awaitingVerification = false;
        _enteredVerifyThisSession = false;
        _acceptedTerms = false;
        _workPermitConfirmed = false;
        _useAuthenticator = false;
        _verificationCode = string.Empty;
        _message = null;
        _profileReadyForApply = true;
        _profileHasAvailability = false;
        _profileHasLicense = true;
        _profileHasEmployers = false;
        _profileHasEducation = true;
        _profileHasAboutMe = false;
        _profileHasReferences = true;
        _requiresDrivingLicense = false;
        _requiresEducation = false;
        _authenticatorEnabled = false;
        _dobInput = null;
        _directContact = null;
        _directContactOpen = false;
    }

    private async void OnCultureChanged()
    {
        try
        {
            await LoadAsync(origin: null);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"VacancyDetail.OnCultureChanged: {ex.GetType().Name}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
        _dotNetMapRef?.Dispose();
        _dotNetMapRef = null;
        try { await Js.InvokeVoidAsync("jobsyList.disconnect"); }
        catch { /* ignore */ }
        if (_mapReady)
        {
            try
            {
                await Js.InvokeVoidAsync("vacancyDetailMap.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingInitialHydration)
        {
            _pendingInitialHydration = false;
            try
            {
                OriginPoint? origin = null;
                try
                {
                    var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                    if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                    {
                        origin = new OriginPoint { Latitude = lat, Longitude = lng };
                    }
                }
                catch
                {
                    // optional
                }

                _ageYears = await ResolveAgeYearsAsync();

                // Prefer profile geboortedatum over session filter when the candidate is logged in.
                try
                {
                    var auth = await AuthState.GetAuthenticationStateAsync();
                    if (auth.User.Identity?.IsAuthenticated == true
                        && RoleClaimMatching.HasRole(auth.User, JobsyRoles.Candidate))
                    {
                        var profile = await SafeProfileAsync();
                        if (profile?.DateOfBirth is DateOnly dob
                            && AgeRules.AgeYearsFromDateOfBirth(dob) is int fromDob)
                        {
                            _dobInput = dob;
                            _ageYears = AgeRules.ClampFilterAge(fromDob);
                            try { await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", _ageYears.Value); }
                            catch { /* ignore */ }
                        }
                    }
                }
                catch
                {
                    // profile optional
                }

                // Exactly one full vacancy load when missing; never re-fetch culture-fit/AI via LoadAsync.
                // Origin flows through so a closed vacancy's similar list can show travel time.
                var alreadyLoaded = (_vacancy is not null && _vacancy.Id == Id)
                                    || (_closed is not null && _closed.Id == Id);
                if (!alreadyLoaded)
                {
                    await LoadAsync(origin);
                }
                else
                {
                    _loading = false;
                }

                _hasOrigin = origin is not null;
                if (origin is not null)
                {
                    await RefreshTravelAsync();
                }

                await LoadLikeAsync();
                // Age discovered via likes only updates stored age — no second full vacancy GET.
                if (_dobInput is DateOnly likedDob
                    && AgeRules.AgeYearsFromDateOfBirth(likedDob) is int likedAge)
                {
                    var clamped = AgeRules.ClampFilterAge(likedAge);
                    if (_ageYears != clamped)
                    {
                        _ageYears = clamped;
                        try { await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", clamped); }
                        catch { /* ignore */ }
                    }
                }

                if (string.Equals(_vacancy?.CultureFitStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                {
                    _ = RefreshCultureFitLaterAsync();
                }

                await InvokeAsync(StateHasChanged);

                if (!_clickRecorded)
                {
                    _clickRecorded = true;
                    await Api.RecordClickOnceAsync(Js, Id);
                }

                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                if (uri.Fragment.Equals("#apply", StringComparison.OrdinalIgnoreCase))
                {
                    await Js.InvokeVoidAsync("jobsyGeo.scrollToId", "apply");
                }
                else if (uri.Fragment.Equals("#dob", StringComparison.OrdinalIgnoreCase))
                {
                    await Js.InvokeVoidAsync("jobsyGeo.scrollToId", "dob");
                }
            }
            catch
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        await ObserveDetailMapAsync();

        if (firstRender && RendererInfo.IsInteractive)
        {
            try
            {
                var wide = await Js.InvokeAsync<bool>("jobsyViewport.isKompasWide");
                if (wide != _detailWide)
                {
                    _detailWide = wide;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // keep mobile-first sticky apply
            }
        }
    }

    private async Task ObserveDetailMapAsync()
    {
        if (!HasLocation || _mapObserveAttached)
        {
            return;
        }

        try
        {
            _dotNetMapRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync(
                "jobsyList.observeMore",
                _mapWrapElement,
                _dotNetMapRef,
                nameof(OnMapVisibleAsync));
            _mapObserveAttached = true;
        }
        catch
        {
            await EnsureDetailMapAsync();
        }
    }

    [JSInvokable]
    public Task OnMapVisibleAsync()
        => EnsureDetailMapAsync();

    /// <summary>
    /// Age for wages: stored banenkaart filter age, else none (“Alle” → full table).
    /// Profile DOB is applied after LoadLike when available.
    /// </summary>
    private async Task<int?> ResolveAgeYearsAsync()
    {
        try
        {
            var stored = await Js.InvokeAsync<int?>("jobsyGeo.getStoredAge");
            if (stored is int age)
            {
                return AgeRules.ClampFilterAge(age);
            }
        }
        catch
        {
            // ignore
        }

        return null;
    }

    private async Task EnsureDetailMapAsync()
    {
        if (!HasLocation)
        {
            return;
        }

        // Recreate when navigating to another vacancy or first paint.
        if (_mapReady && _mappedVacancyId == Id)
        {
            return;
        }

        if (_mapReady)
        {
            try { await Js.InvokeVoidAsync("vacancyDetailMap.dispose"); }
            catch { /* ignore */ }
            _mapReady = false;
        }

        try
        {
            await MapScripts.EnsureDetailAsync(Js);
            // Pass numbers (JSON) so MapLibre gets exact coords without culture parsing.
            await Js.InvokeVoidAsync("vacancyDetailMap.init", "vacancy-detail-map", new Dictionary<string, object?>
            {
                ["lat"] = _vacancy!.Latitude,
                ["lng"] = _vacancy.Longitude,
                ["title"] = _vacancy.Title,
                ["company"] = KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                    ? KbIntermediaryDisplay.CompanyLine(Culture, _vacancy)
                    : _vacancy.CompanyName,
                ["offeredBy"] = KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                    ? null
                    : _vacancy.OfferedByLabel,
                ["address"] = _vacancy.CompanyAddress,
                ["hiddenBureau"] = KbIntermediaryDisplay.IsHiddenMode(_vacancy),
                ["bureauPinLabel"] = KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                    ? string.Format(Culture["Kb.Map.BureauPin"], _vacancy.CompanyName)
                    : null
            });
            _mapReady = true;
            _mappedVacancyId = Id;
        }
        catch
        {
            // MapLibre may not be ready yet — retry on next render
            _mapReady = false;
            _mappedVacancyId = null;
        }
    }

    private async Task LoadAsync(OriginPoint? origin)
    {
        try
        {
            // Full vacancy payload without travel — travel uses /travel separately.
            var lookup = await Api.GetVacancyLookupAsync(
                Id,
                originLat: null,
                originLng: null,
                _transport,
                _ageYears);

            switch (lookup)
            {
                case VacancyLookup.FoundResult found:
                    _vacancy = found.Vacancy;
                    _closed = null;
                    _similar = [];
                    if (string.Equals(_vacancy.CultureFitStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                    {
                        _ = RefreshCultureFitLaterAsync();
                    }

                    break;
                case VacancyLookup.ClosedResult closed:
                    _vacancy = null;
                    _closed = closed.Info;
                    // Travel time when the visitor already has an origin (like the banenkaart);
                    // the API falls back to crow-flies distance otherwise. Max 3, no new ranking —
                    // this reuses the discovery index via the /similar endpoint.
                    _similar = await Api.GetVacancySimilarAsync(
                        Id,
                        limit: 3,
                        originLat: origin?.Latitude,
                        originLng: origin?.Longitude,
                        _transport);
                    break;
                default:
                    _vacancy = null;
                    _closed = null;
                    _similar = [];
                    break;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private int _cultureFitRefreshAttempts;

    private async Task RefreshCultureFitLaterAsync()
    {
        while (_cultureFitRefreshAttempts < 3
               && _vacancy is not null
               && string.Equals(_vacancy.CultureFitStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _cultureFitRefreshAttempts++;
            try
            {
                await Task.Delay(3000);
                var poll = await Api.GetVacancyCultureFitAsync(Id);
                if (poll is null || _vacancy is null)
                {
                    continue;
                }

                _vacancy.CultureFitPercent = poll.Percent;
                _vacancy.CultureFitBand = poll.Band;
                _vacancy.CultureFitLabel = poll.Label;
                _vacancy.CultureFitWhy = poll.Why;
                _vacancy.CultureFitStatus = poll.Status ?? "Ready";
                await InvokeAsync(StateHasChanged);
                if (!string.Equals(_vacancy.CultureFitStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                {
                    break;
                }
            }
            catch
            {
                break;
            }
        }
    }

    private async Task LoadLikeAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var isCandidate = RoleClaimMatching.HasRole(auth.User, JobsyRoles.Candidate);
        Task<MeProfile?>? profileTask = null;
        Task<IReadOnlyList<ApplicationItem>?>? appsTask = null;
        MeProfile? candidateProfile = null;
        if (isCandidate)
        {
            profileTask = SafeProfileAsync();
            appsTask = SafeApplicationsAsync();
        }

        var likedTask = SafeLikedAsync();

        if (profileTask is not null)
        {
            var profile = await profileTask;
            candidateProfile = profile;
            if (profile is not null)
            {
                _dobInput = profile.DateOfBirth;
                _authenticatorEnabled = profile.AuthenticatorEnabled == true;
                var prefs = profile.Preferences ?? new CandidatePreferences();
                _requiresDrivingLicense = !string.IsNullOrWhiteSpace(_vacancy?.RequiredDrivingLicense);
                _requiresEducation = !string.IsNullOrWhiteSpace(_vacancy?.RequiredEducation);

                _profileHasAvailability = (prefs.Availability?.Count ?? 0) > 0;
                _profileHasLicense = !_requiresDrivingLicense
                    || DrivingLicenseLabels.CandidateMeetsRequirement(
                        prefs.DrivingLicenses,
                        _vacancy!.RequiredDrivingLicense);
                var employerCount = prefs.Employers?.Count ?? 0;
                var minEmployers = _vacancy?.MinimumEmployers is > 0 ? _vacancy.MinimumEmployers.Value : 1;
                _profileHasEmployers = employerCount >= minEmployers;
                _profileHasEducation = !_requiresEducation
                    || EducationLevelLabels.CandidateMeetsRequirement(
                        prefs.Educations,
                        _vacancy!.RequiredEducation);
                _profileHasAboutMe = !string.IsNullOrWhiteSpace(prefs.AboutMe);
                var neededRefs = _vacancy?.MinimumReferences is > 0 ? _vacancy.MinimumReferences.Value : 0;
                _profileHasReferences = neededRefs == 0
                    || CandidateReferenceRules.CountComplete(
                        (profile.References ?? []).Select(r => (r.EmployerName, r.ContactName, r.Email, r.Phone))) >= neededRefs;
                if (string.IsNullOrWhiteSpace(_motivation)
                    && !string.IsNullOrWhiteSpace(prefs.DefaultMotivation))
                {
                    _motivation = prefs.DefaultMotivation!;
                }

                if (!_transportTouched
                    && IsKnownTransport(prefs.PreferredTransport)
                    && !string.Equals(_transport, prefs.PreferredTransport!.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    _transport = NormalizeTransport(prefs.PreferredTransport);
                    if (_hasOrigin)
                    {
                        await RefreshTravelAsync();
                    }
                }
                _profileReadyForApply =
                    _profileHasAvailability
                    && _profileHasLicense
                    && _profileHasEmployers
                    && _profileHasEducation
                    && _profileHasAboutMe
                    && _profileHasReferences;
            }
        }

        if (isCandidate && _vacancy is not null)
        {
            await RecentlyViewedVacancies.RememberAsync(Js, _vacancy.Id, candidateProfile?.Id);
        }

        if (appsTask is not null)
        {
            var mine = await appsTask;
            if (mine is not null)
            {
                // Only verified (submitted) applications are returned — drafts awaiting a code stay out.
                // Withdrawn applications may be reopened via Apply, so they must not lock the UI.
                _applied = mine.Any(a => a.VacancyId == Id
                                         && !string.Equals(a.Status, "Withdrawn", StringComparison.OrdinalIgnoreCase));
                if (_applied)
                {
                    _awaitingVerification = false;
                    _enteredVerifyThisSession = false;
                    _message = Culture["Apply.AlreadyApplied"];
                    await LoadDirectContactAsync();
                }
                else if (!_enteredVerifyThisSession)
                {
                    _awaitingVerification = false;
                }
            }
        }

        _liked = await likedTask;
    }

    private async Task LoadDirectContactAsync()
