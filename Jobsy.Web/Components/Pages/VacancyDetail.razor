    private async Task OnTransportChanged(ChangeEventArgs e)
    {
        _transport = NormalizeTransport(e.Value?.ToString());
        _transportTouched = true;
        await RefreshTravelAsync();
    }

    private static bool IsKnownTransport(string? value)
        => value?.Trim() is "Fiets" or "E-bike" or "Auto" or "OV" or "Lopend";

    private static string NormalizeTransport(string? value)
        => value?.Trim() switch
        {
            "Auto" => "Auto",
            "OV" => "OV",
            "Lopend" => "Lopend",
            "E-bike" => "E-bike",
            _ => "Fiets"
        };

    private async Task<OriginPoint?> TryGetStoredOriginAsync()
    {
        try
        {
            var session = await Js.InvokeAsync<Dictionary<string, object?>?>("jobsyGeo.getSessionOrigin");
            if (session is not null
                && session.TryGetValue("lat", out var latObj)
                && session.TryGetValue("lng", out var lngObj)
                && double.TryParse(Convert.ToString(latObj, System.Globalization.CultureInfo.InvariantCulture),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var slat)
                && double.TryParse(Convert.ToString(lngObj, System.Globalization.CultureInfo.InvariantCulture),
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var slng)
                && double.IsFinite(slat) && double.IsFinite(slng)
                && !(slat == 0 && slng == 0))
            {
                if (session.TryGetValue("label", out var labelObj))
                {
                    _originLabel = Convert.ToString(labelObj);
                }

                return new OriginPoint { Latitude = slat, Longitude = slng };
            }
        }
        catch
        {
            // optional
        }

        try
        {
            var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
            if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng)
                && double.IsFinite(lat) && double.IsFinite(lng)
                && !(lat == 0 && lng == 0))
            {
                return new OriginPoint { Latitude = lat, Longitude = lng };
            }
        }
        catch
        {
            // optional
        }

        return null;
    }

    private async Task RefreshTravelAsync()
    {
        if (_vacancy is null || !HasLocation)
        {
            return;
        }

        _travelLoading = true;
        try
        {
            var origin = await TryGetStoredOriginAsync();
            _hasOrigin = origin is not null;
            if (origin is null)
            {
                _vacancy.TravelMinutes = null;
                _vacancy.DistanceKm = null;
                return;
            }

            var travel = await Api.GetVacancyTravelAsync(
                Id,
                origin.Latitude,
                origin.Longitude,
                _transport);
            _vacancy.TravelMinutes = travel?.TravelMinutes;
            _vacancy.DistanceKm = travel?.DistanceKm;
        }
        catch
        {
            _vacancy.TravelMinutes = null;
            _vacancy.DistanceKm = null;
        }
        finally
        {
            _travelLoading = false;
        }
    }

    private async Task OpenRouteAsync()
    {
        if (!HasLocation || _vacancy is null || KbIntermediaryDisplay.HideRouteAndStreetView(_vacancy))
        {
            return;
        }

        _openingRoute = true;
        try
        {
            double? originLat = null;
            double? originLng = null;

            try
            {
                var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                {
                    originLat = lat;
                    originLng = lng;
                }
            }
            catch
            {
                // ignore
            }

            if (originLat is null || originLng is null)
            {
                try
                {
                    var pos = await Js.InvokeAsync<Dictionary<string, double>>("jobsyGeo.requestLocation");
                    if (pos.TryGetValue("lat", out var lat) && pos.TryGetValue("lng", out var lng))
                    {
                        originLat = lat;
                        originLng = lng;
                        _hasOrigin = true;
                        if (_vacancy is not null)
                        {
                            var travel = await Api.GetVacancyTravelAsync(Id, lat, lng, _transport);
                            _vacancy.TravelMinutes = travel?.TravelMinutes;
                            _vacancy.DistanceKm = travel?.DistanceKm;
                        }
                    }
                }
                catch
                {
                    // Open destination-only directions if location is denied
                }
            }

            await Js.InvokeVoidAsync("vacancyDetailMap.openRoute", new
            {
                destLat = _vacancy!.Latitude,
                destLng = _vacancy.Longitude,
                originLat,
                originLng,
                transport = _transport
            });
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _openingRoute = false;
        }
    }

    private async Task OpenStreetViewAsync()
    {
        if (!HasLocation || _vacancy is null || KbIntermediaryDisplay.HideRouteAndStreetView(_vacancy))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("vacancyDetailMap.openStreetView", new
            {
                lat = _vacancy!.Latitude,
                lng = _vacancy.Longitude
            });
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task ApplyAsync()
    {
        if (_vacancy is null || _applied)
        {
            return;
        }

        // Resend from the verify panel: terms/profile already satisfied this session.
        var isResend = _awaitingVerification && _enteredVerifyThisSession;
        if (!isResend)
        {
            if (!_acceptedTerms)
            {
                _message = Culture["Apply.MustAcceptTerms"];
                return;
            }
            if (!_workPermitConfirmed)
            {
                _message = Culture["Apply.MustConfirmWorkPermit"];
                return;
            }
            if (!_profileReadyForApply)
            {
                _message = Culture["Apply.CompleteProfileFirst"];
                return;
            }
        }

        _applying = true;
        try
        {
            var minutes = _vacancy.TravelMinutes ?? 15;
            var wasAwaitingVerification = _awaitingVerification;
            var result = await Api.ApplyAsync(
                _vacancy.Id,
                _transport,
                minutes,
                _useAuthenticator,
                acceptedTerms: true,
                workPermitConfirmed: true,
                motivation: string.IsNullOrWhiteSpace(_motivation) ? null : _motivation.Trim(),
                confirmLowMatchSafetyNet: _confirmSafetyNet,
                studentNumber: RequiresExclusivityExtras ? _studentNumber.Trim() : null,
                schoolEmail: RequiresExclusivityExtras ? _schoolEmail.Trim() : null,
                studyProgram: RequiresExclusivityExtras ? _studyProgram.Trim() : null,
                studyYear: RequiresExclusivityExtras && !string.IsNullOrWhiteSpace(_studyYear) ? _studyYear.Trim() : null);
            if (result?.RequiresSafetyNetConfirmation == true)
            {
                _showSafetyNet = true;
                _safetyNetPercent = result.MatchPercent;
                _safetyNetMessage = result.SafetyNetMessage;
                _message = result.SafetyNetMessage;
                return;
            }

            _showSafetyNet = false;
            _confirmSafetyNet = false;
            if (result?.RequiresVerification == true)
            {
                _awaitingVerification = true;
                _enteredVerifyThisSession = true;
                _message = wasAwaitingVerification
                    ? Culture["Apply.CodeResent"]
                    : Culture["Apply.CodeSent"];
            }
            else
            {
                _applied = true;
                _awaitingVerification = false;
                _enteredVerifyThisSession = false;
                _message = _useAuthenticator
                    ? Culture["Apply.CodeSentAuthenticator"]
                    : Culture["Apply.SentStub"];
                OpenDirectContactIfAvailable(result?.DirectContact);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task ContinueWithSafetyNetAsync()
    {
        _confirmSafetyNet = true;
        _showSafetyNet = false;
        await ApplyAsync();
    }

    private async Task VerifyApplicationAsync()
    {
        if (_vacancy is null || !_awaitingVerification)
        {
            return;
        }

        _applying = true;
        try
        {
            var minutes = _vacancy.TravelMinutes ?? 15;
            var result = await Api.ApplyAsync(
                _vacancy.Id,
                _transport,
                minutes,
                _useAuthenticator,
                acceptedTerms: true,
                workPermitConfirmed: true,
                verificationCode: _verificationCode.Trim(),
                motivation: string.IsNullOrWhiteSpace(_motivation) ? null : _motivation.Trim(),
                studentNumber: RequiresExclusivityExtras ? _studentNumber.Trim() : null,
                schoolEmail: RequiresExclusivityExtras ? _schoolEmail.Trim() : null,
                studyProgram: RequiresExclusivityExtras ? _studyProgram.Trim() : null,
                studyYear: RequiresExclusivityExtras && !string.IsNullOrWhiteSpace(_studyYear) ? _studyYear.Trim() : null);

            _applied = result?.RequiresVerification != true;
            _awaitingVerification = result?.RequiresVerification == true;
            if (_applied)
            {
                _verificationCode = string.Empty;
                _enteredVerifyThisSession = false;
                _message = Culture["Apply.Verified"];
                OpenDirectContactIfAvailable(result?.DirectContact);
            }
            else
            {
                _message = Culture["Apply.CodeRejected"];
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task ToggleLikeAsync()
    {
        _liking = true;
        try
        {
            _liked = await Api.SetLikedAsync(Id, !_liked);
            _message = _liked ? Culture["Vacancy.LikedToast"] : Culture["Vacancy.LikeRemoved"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _liking = false;
        }
    }

    private void OpenShare() => _shareOpen = true;

    private Task CloseShare()
    {
        _shareOpen = false;
        return Task.CompletedTask;
    }

    private string LocalizeWorkType(string label) => UiLabels.WorkType(Culture, label);

    private string LocalizeTransport(string transport) => UiLabels.Transport(Culture, transport);

    private string LocalizeLicenseList(string stored) =>
        string.Join(", ", DrivingLicenseLabels.Split(stored).Select(x => UiLabels.License(Culture, x)));

    private string LocalizeEducationList(string stored) =>
        string.Join(", ", EducationLevelLabels.Split(stored).Select(x => UiLabels.Education(Culture, x)));

    private void OpenMockInterview() => _mockInterviewOpen = true;

    private Task CloseMockInterview()
    {
        _mockInterviewOpen = false;
        return Task.CompletedTask;
    }

    private void OpenDirectContactIfAvailable(EmployerDirectContactItem? contact)
    {
        if (contact is null || !contact.Available)
        {
            return;
        }

        var hasWhatsApp = contact.OfferWhatsApp && !string.IsNullOrWhiteSpace(contact.WhatsAppUrl);
        var hasPhone = contact.OfferPhone && !string.IsNullOrWhiteSpace(contact.Phone);
        var hasMail = contact.OfferMail && !string.IsNullOrWhiteSpace(contact.Email);
        if (!hasWhatsApp && !hasPhone && !hasMail)
        {
            return;
        }

        _directContact = contact;
        _directContactOpen = true;
    }

    private Task CloseDirectContact()
    {
        _directContactOpen = false;
        return Task.CompletedTask;
    }
}
