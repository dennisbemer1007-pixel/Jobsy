    private async Task SaveDobAsync()
    {
        if (_dobInput is null)
        {
            _message = Culture["Apply.PickDob"];
            return;
        }

        _savingDob = true;
        try
        {
            await Api.UpdateDateOfBirthAsync(_dobInput.Value);
            await LoadAsync(origin: null);
            // Refresh with origin if available
            try
            {
                var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                {
                    await LoadAsync(new OriginPoint { Latitude = lat, Longitude = lng });
                }
            }
            catch
            {
                // ignore
            }

            _message = Culture["Apply.DobSaved"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _savingDob = false;
        }
    }

