@page "/vacancies/{Id:guid}"
@* KB-FALLBACK(C): gate with PlatformFeature.Employers when paspoort 01 lands *@
@* KB-FALLBACK(A): KbHiddenIntermediaryMask / KbIntermediaryDisplay until intermediair 03 *@
@* Dep B: branche / kernwaarden / engagement available after werkgever-aanmelding 08/09 *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@inject PersistentComponentState Persist
@inject IHttpContextAccessor HttpContextAccessor
@using Jobsy.Core.Media
@using Jobsy.Core.Rules
@using Jobsy.Web.Hosting
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Components.Engagement
@using Jobsy.Web.Components.Errors
@using Jobsy.Web.Components.KandidaatBanen
@using Jobsy.Web.Seo
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable

<PageTitle>@(_vacancy?.Title ?? _closed?.Title ?? Culture["Vacancy.Title"]) · Lobsy</PageTitle>
<PageSeo Title="@SeoTitle"
         Description="@SeoDescription"
         Index="@(_vacancy is not null)"
         ImageUrl="@SeoImage"
         OgType="article"
         JsonLd="@SeoJsonLd" />

<div class="panel-page panel-page--vacancy">
    @if (_closed is not null)
    {
        <ClosedVacancyView Info="_closed" Similar="_similar" />
    }
    else if (_vacancy is null)
    {
        @if (_loading)
        {
            <article class="detail-card detail-card--pending" aria-busy="true">
                <p class="visually-hidden">@Culture["Common.Loading"]</p>
                <div class="detail-card__header-row">
                    <a class="back-link" href="@KbRoutes.Map">@Culture["Vacancy.BackToMap"]</a>
                </div>
                <div class="vacancy-media vacancy-media--split">
                    <div class="vacancy-media__skeleton"></div>
                    <div class="vacancy-media__skeleton"></div>
                </div>
                <div class="detail-card__skeleton-line"></div>
                <div class="detail-card__skeleton-line detail-card__skeleton-line--short"></div>
            </article>
        }
        else
        {
            <p class="state-message error">@Culture["Vacancy.NotFound"]</p>
        }
    }
    else
    {
        <article class="detail-card kb-detail" data-testid="kb-detail">
            <div class="detail-card__header-row">
                <a class="back-link" href="@KbRoutes.Map">@Culture["Vacancy.BackToMap"]</a>
            </div>

            <div class="kb-detail__layout">
                <div class="kb-detail__main-top">
                    @if (HasPhoto)
                    {
                        <div class="kb-detail__photo">
                            <VacancyPhoto Src="@_vacancy.ImageUrl"
                                          FallbackSrc="@_vacancy.CompanyLogoUrl"
                                          VacancyId="_vacancy.Id"
                                          WorkType="@(_vacancy.WorkTypes.FirstOrDefault())"
                                          Class="detail-card__image vacancy-media__photo"
                                          Width="720"
                                          Height="480"
                                          Eager="true"
                                          Sizes="(max-width: 1024px) 100vw, 720px" />
                        </div>
                    }

                    <div class="kb-detail__header">
                        <h1>@_vacancy.Title</h1>
                        <p class="kb-detail__company-line company">
                            @if (!KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                                && !string.IsNullOrWhiteSpace(_vacancy.KvkNumber)
                                && !string.IsNullOrWhiteSpace(_vacancy.Vestigingsnummer))
                            {
                                <a class="company-link" href="@($"/{_vacancy.KvkNumber}/{_vacancy.Vestigingsnummer}")">@_vacancy.CompanyName</a>
                            }
                            else if (KbIntermediaryDisplay.IsHiddenMode(_vacancy))
                            {
                                <span class="kb-via-bureau">@KbIntermediaryDisplay.CompanyLine(Culture, _vacancy)</span>
                            }
                            else
                            {
                                <span>@_vacancy.CompanyName</span>
                            }
                            @if (!KbIntermediaryDisplay.IsHiddenMode(_vacancy) && !string.IsNullOrWhiteSpace(_vacancy.CompanyAddress))
                            {
                                <span>· @_vacancy.CompanyAddress</span>
                            }
                        </p>
                        @* Dep B: engagement badges when present *@
                        @if (!KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                            && _vacancy.EngagementItems is { Count: > 0 })
                        {
                            <EngagementBadges Items="@(_vacancy.EngagementItems.Select(e => new EngagementBadges.EngageBadgeItem(e.ItemId, e.Checked)).ToList())" />
                        }
                        @if (string.Equals(_vacancy.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrWhiteSpace(_vacancy.ExclusivityName))
                        {
                            <p class="job-card__badge job-card__badge--soft kb-detail-badge-soft">@_vacancy.ExclusivityName</p>
                        }
                        @if (!KbIntermediaryDisplay.IsHiddenMode(_vacancy)
                            && !string.IsNullOrWhiteSpace(_vacancy.OfferedByLabel))
                        {
                            <p class="muted kb-detail-offered-by">@_vacancy.OfferedByLabel</p>
                        }
                        @if (KbIntermediaryDisplay.IsHiddenMode(_vacancy))
                        {
                            <p class="kb-hidden-info" role="note">
                                <span class="kb-hidden-info__icon" aria-hidden="true">i</span>
                                <span>@string.Format(Culture["Kb.Hidden.Info"], _vacancy.CompanyName)</span>
                            </p>
                        }
                    </div>

                    @{
                        var detailFit = KbFitMapping.FromVacancy(_vacancy);
                        var detailWhy = KbFitMapping.WhyLine(_vacancy, Culture);
                        var detailRank = KbFitMapping.RankLowerLabel(_vacancy, Culture);
                    }
                    @if (detailFit is not null)
                    {
                        <div class="kb-fit-panel" data-fit-gate="@(_vacancy.FitGate ?? "")" data-testid="kb-fit-panel">
                            <div class="kb-fit-panel__head">
                                <KbFitPill Fit="detailFit" />
                                @if (!string.IsNullOrWhiteSpace(detailRank))
                                {
                                    <span class="kb-badges__chip kb-badges__chip--rank-lower">@detailRank</span>
                                }
                            </div>
                            <KbWhyLine Text="detailWhy" />
                            @if (detailFit.GateOpen)
                            {
                                <ul class="kb-dna" role="list">
                                    @foreach (var row in DnaRows(_vacancy))
                                    {
                                        <li class="kb-dna__row">
                                            <span class="kb-dna__label">@row.Label</span>
                                            @if (row.Percent is int barPct)
                                            {
                                                <progress class="kb-dna__progress" value="@barPct" max="100" aria-label="@row.Label">@barPct%</progress>
                                                <span class="kb-dna__value">@barPct%</span>
                                            }
                                            else
                                            {
                                                <a class="kb-dna__todo" href="@row.TestHref">@Culture["Kb.Dna.NotDone"]</a>
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (_vacancy.MatchGaps is { Count: > 0 })
                                {
                                    <div class="kb-fit-panel__gaps">
                                        <h2 class="kb-fit-panel__gaps-title">@Culture["Kb.Dna.NewForYou"]</h2>
                                        <ul>
                                            @foreach (var gap in _vacancy.MatchGaps.Take(4))
                                            {
                                                <li>@gap</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="kb-fit-panel__gate-hint">@Culture["Kb.Fit.GateHint"]</p>
                                <div class="kb-fit-panel__gate-links">
                                    <a class="engagement-btn" href="@KbRoutes.CultureTest">@Culture["Kb.Dna.Culture"]</a>
                                    <a class="engagement-btn" href="@KbRoutes.ValuesTest">@Culture["Kb.Dna.Values"]</a>
                                </div>
                            }
                            @if (string.Equals(_vacancy.CultureFitStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                            {
                                <p class="state-message" aria-live="polite">@Culture["Insights.Updating"]</p>
                            }
                        </div>
                    }

                    <div class="kb-facts-grid" aria-label="@Culture["Kb.Detail.FactsAria"]" data-testid="kb-facts-grid">
                        @if (HasHoursInfo)
                        {
                            <div class="kb-facts-grid__item">
                                <span class="kb-facts-grid__label">@Culture["Kb.Detail.HoursFact"]</span>
                                <p class="kb-facts-grid__value">
                                    @_vacancy.MinHoursPerWeek?.ToString("0.#")–@_vacancy.MaxHoursPerWeek?.ToString("0.#")
                                    @Culture["Vacancy.HoursUnit"]
                                </p>
                            </div>
                        }
                        <div class="kb-facts-grid__item">
                            <span class="kb-facts-grid__label">@Culture["Kb.Detail.WageFact"]</span>
                            <p class="kb-facts-grid__value">
                                @if (_vacancy.WageVisible && _vacancy.HourlyWage is not null)
                                {
                                    <text>€ @_vacancy.HourlyWage.Value.ToString("0.00")</text>
                                }
                                else if (!_vacancy.WageVisible)
                                {
                                    <a href="#dob">@Culture["Vacancy.EnterDob"]</a>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </p>
                        </div>
                        <div class="kb-facts-grid__item">
                            <span class="kb-facts-grid__label">@Culture["Kb.Detail.WhenFact"]</span>
                            <p class="kb-facts-grid__value">@DetailWhenLabel</p>
                        </div>
                        <div class="kb-facts-grid__item">
                            <span class="kb-facts-grid__label">@Culture["Kb.Detail.StartFact"]</span>
                            <p class="kb-facts-grid__value">@Culture["Kb.Detail.StartFlexible"]</p>
                        </div>
                    </div>

                    @* Travel card lives in the rail (one map instance); CSS places the rail after facts on mobile. *@
                </div>@* kb-detail__main-top *@

                <aside class="kb-detail__rail" data-testid="kb-detail-rail">
                    @TravelCardFragment
                    <div class="kb-detail__actions kb-detail__rail-actions">
                        @if (_detailWide)
                        {
                            @PrimaryApplyFragment
                        }
                        <div class="kb-detail__secondary">
                            @SaveButtonFragment
                            <button class="kb-detail__icon-btn"
                                    type="button"
                                    title="@Culture["Kb.Detail.Share"]"
                                    aria-label="@Culture["Kb.Detail.Share"]"
                                    @onclick="OpenShare">
                                <svg class="engagement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="18" cy="5" r="2.5"/>
                                    <circle cx="6" cy="12" r="2.5"/>
                                    <circle cx="18" cy="19" r="2.5"/>
                                    <path d="M8.5 13.5 15.5 17.5M15.5 6.5 8.5 10.5"/>
                                </svg>
                            </button>
                        </div>
                        <p class="kb-detail__passport-hint">@Culture["Kb.Detail.PassportHint"]</p>
                    </div>
                </aside>

                <div class="kb-detail__main-bottom">

                    @if (VideoEmbedUrl is not null)
                    {
                        <div class="detail-card__video">
                            @if (_videoActivated)
                            {
                                <iframe src="@VideoEmbedUrl"
                                        title="@Culture["Vacancy.Video"]"
                                        loading="lazy"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen
                                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                            }
                            else
                            {
                                <button type="button"
                                        class="detail-card__video-poster"
                                        aria-label="@Culture["Vacancy.Video"]"
                                        @onclick="() => _videoActivated = true">
                                    @if (VideoThumbnailUrl is { } thumb)
                                    {
                                        <img src="@thumb" alt="" width="640" height="360" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="detail-card__video-poster-label">@Culture["Kb.Video.Loading"]</span>
                                    }
                                    <span class="detail-card__video-play" aria-hidden="true"></span>
                                </button>
                            }
                        </div>
                    }
                    else if (SafeVideoWatchUrl is not null)
                    {
                        <p class="detail-card__video-link">
                            <a href="@SafeVideoWatchUrl" target="_blank" rel="noopener noreferrer">@Culture["Vacancy.WatchVideo"]</a>
                        </p>
                    }

            <p class="detail-card__body">@_vacancy.Description</p>
            <p class="travel-hint">
                @Culture["Vacancy.StartDate"]: @_vacancy.StartDate.ToString("dd-MM-yyyy")
                @if (_vacancy.WorkTypes.Length > 0)
                {
                    <text> · @Culture["Vacancy.WorkType"]: @string.Join(", ", _vacancy.WorkTypes.Select(LocalizeWorkType))</text>
                }
            </p>

            @if (HasHoursInfo || HasScheduleInfo || HasLegalInfo)
            {
                <aside class="vacancy-facts" aria-label="@Culture["Vacancy.Facts"]">
                    @if (HasHoursInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.HoursPerWeek"]</h2>
                            <p class="vacancy-facts__text">
                                @_vacancy.MinHoursPerWeek?.ToString("0.#")–@_vacancy.MaxHoursPerWeek?.ToString("0.#")
                                @Culture["Vacancy.HoursUnit"]
                                @if (HoursCategoryLabel is not null)
                                {
                                    <span class="muted"> · @HoursCategoryLabel</span>
                                }
                            </p>
                        </div>
                    }

                    @if (HasScheduleInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.DayParts"]</h2>
                            @if (_vacancy.FlexibleTimes)
                            {
                                <p class="vacancy-facts__text">@Culture["Vacancy.FlexibleTimes"]</p>
                            }
                            else
                            {
                                <div class="vacancy-facts__chips">
                                    @foreach (var chip in ScheduleChips)
                                    {
                                        <span class="vacancy-facts__chip">@chip</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (HasLegalInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.WorkConditions"]</h2>
                            <ul class="vacancy-facts__list">
                                @foreach (var item in LegalFactItems)
                                {
                                    <li class="@(item.Highlighted ? "is-alert" : null)">
                                        <span class="vacancy-facts__badge">@(item.Active ? Culture["Vacancy.Yes"] : Culture["Vacancy.No"])</span>
                                        <span>@item.Label</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </aside>
            }

            @if (HasHardRequirementTags)
            {
                <aside class="lobsy-proximity" aria-label="@Culture["Vacancy.HardRequirements"]">
                    <span class="lobsy-proximity__icon"><LobsyMark /></span>
                    <div class="lobsy-proximity__body">
                        <p class="lobsy-proximity__title">@Culture["Vacancy.HardRequirements"]</p>
                        <p class="lobsy-proximity__meta">
                            @if (!string.IsNullOrWhiteSpace(_vacancy.RequiredDrivingLicense))
                            {
                                <span class="lobsy-proximity__chip">@Culture["Vacancy.License"]: @LocalizeLicenseList(_vacancy.RequiredDrivingLicense)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_vacancy.RequiredEducation))
                            {
                                <span class="lobsy-proximity__chip">@Culture["Vacancy.EducationLevel"]: @LocalizeEducationList(_vacancy.RequiredEducation)</span>
                            }
                            @foreach (var kind in _vacancy.BarrierHardChecks ?? [])
                            {
                                <span class="lobsy-proximity__chip">@VacancyHardCheckCatalog.Label(kind)</span>
                            }
                            @foreach (var diploma in _vacancy.BarrierDiplomas ?? [])
                            {
                                <span class="lobsy-proximity__chip">@diploma</span>
                            }
                            @foreach (var cert in _vacancy.BarrierCertifications ?? [])
                            {
                                <span class="lobsy-proximity__chip">@cert</span>
                            }
                            @if (_vacancy.BarrierMinExperienceYears is int years and > 0)
                            {
                                <span class="lobsy-proximity__chip">@Culture.Format("Vacancy.MinExperienceYears", years)</span>
                            }
                            @if (_vacancy.MinimumEmployers is > 0)
                            {
                                <span class="lobsy-proximity__chip">@Culture.Format("Vacancy.MinEmployers", _vacancy.MinimumEmployers)</span>
                            }
                            @if (_vacancy.MinimumReferences is > 0)
                            {
                                <span class="lobsy-proximity__chip">@Culture.Format("Vacancy.MinReferences", _vacancy.MinimumReferences)</span>
                            }
                        </p>
                    </div>
                </aside>
            }

            @if (VacancyCareerPath is { } careerPath)
            {
                <aside class="lobsy-proximity role-fit-path" aria-label="@Culture["Vacancy.PathTitle"]">
                    <span class="lobsy-proximity__icon"><LobsyMark /></span>
                    <div class="lobsy-proximity__body">
                        <p class="lobsy-proximity__title">@Culture["Vacancy.PathTitle"]</p>
                        <p>@careerPath.Summary</p>
                        <ol class="role-fit-path__steps">
                            @foreach (var step in careerPath.Steps)
                            {
                                <li>
                                    <strong>@step.Title</strong>
                                    <span class="role-fit-path__time">@Culture.Format("Fit.PathWithin", step.DurationLabel)</span>
                                    <span class="muted">@step.Detail</span>
                                </li>
                            }
                        </ol>
                    </div>
                </aside>
            }

            @if (!_vacancy.WageVisible)
            {
                <div id="dob" class="dob-prompt">
                    <p>@Culture["Vacancy.DobPrompt"]</p>
                    <AuthorizeView Roles="Candidate">
                        <Authorized>
                            <label>
                                @Culture["Vacancy.DateOfBirth"]
                                <input type="date" @bind="_dobInput" />
                            </label>
                            <button class="login-submit" type="button" disabled="@_savingDob" @onclick="SaveDobAsync">
                                @Culture["Common.Save"]
                            </button>
                            <p class="login-lead">@Culture["Vacancy.ManageInProfile"] <a href="/candidate/profile">@Culture["Vacancy.YourProfile"]</a>.</p>
                        </Authorized>
                        <NotAuthorized>
                            <a class="login-submit kb-detail-login-as" href="@LoginUrl">@Culture["Vacancy.LoginAsCandidate"]</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }

            <AuthorizeView Roles="Candidate">
                <Authorized>
                    <div class="lobsy-coach-cta">
                        <button type="button"
                                class="lobsy-coach-cta__btn"
                                @onclick="OpenMockInterview"
                                aria-label="@Culture["MockInterview.CtaAria"]">
                            <LobsyCoachAvatar Class="lobsy-coach-cta__mascot" Language="@Culture.Language" Alt="" />
                            <span class="lobsy-coach-cta__bubble">@Culture["MockInterview.CtaBubble"]</span>
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Candidate">
                <Authorized>
                    <p class="login-lead">
                        <a class="engagement-btn" href="@($"/candidate/profile?tab=fit&vacancyId={Id}")">@Culture["Fit.CheckVacancy"]</a>
                    </p>
                </Authorized>
            </AuthorizeView>

            <div id="apply" class="apply-flow">
                <AuthorizeView Roles="Candidate">
                    <Authorized>
                        <header class="apply-flow__header">
                            <h2 class="apply-flow__title">@Culture["Apply.Title"]</h2>
                            <p class="apply-flow__lead">@ApplyFlowLead</p>
                        </header>

                        <ol class="apply-steps" aria-label="@Culture["Apply.StepsLabel"]">
                            <li class="apply-steps__item @ProfileStepClass">
                                <span class="apply-steps__num" aria-hidden="true">1</span>
                                <span class="apply-steps__label">@Culture["Apply.StepProfile"]</span>
                            </li>
                            <li class="apply-steps__item @ConsentStepClass">
                                <span class="apply-steps__num" aria-hidden="true">2</span>
                                <span class="apply-steps__label">@Culture["Apply.StepConsent"]</span>
                            </li>
                            <li class="apply-steps__item @SendStepClass">
                                <span class="apply-steps__num" aria-hidden="true">3</span>
                                <span class="apply-steps__label">@Culture["Apply.StepSend"]</span>
                            </li>
                            <li class="apply-steps__item @VerifyStepClass">
                                <span class="apply-steps__num" aria-hidden="true">4</span>
                                <span class="apply-steps__label">@Culture["Apply.StepVerify"]</span>
                            </li>
                        </ol>

                        @if (_applied)
                        {
                            <div class="apply-panel apply-panel--success" role="status">
                                <p class="apply-panel__title">@Culture["Apply.SentTitle"]</p>
                                <p class="apply-panel__text">@Culture["Apply.SentBody"]</p>
                                @if (_directContact is { Available: true })
                                {
                                    <button type="button"
                                            class="login-submit apply-flow__primary kb-detail-direct-contact"
                                            @onclick="() => OpenDirectContactIfAvailable(_directContact)">
                                        @Culture["Apply.DirectContactTitle"]
                                    </button>
                                }
                                <a class="engagement-btn apply-flow__secondary" href="@KbRoutes.Applications">@Culture["Apply.MyApplications"]</a>
                            </div>
                        }
                        else if (!_profileReadyForApply)
                        {
                            <div class="apply-panel apply-panel--warn">
                                <p class="apply-panel__title">@Culture["Apply.CompleteProfileTitle"]</p>
                                <p class="apply-panel__text">@Culture["Apply.CompleteProfileBody"]</p>
                                <ul class="apply-checklist">
                                    <li class="@(_profileHasAvailability ? "is-done" : null)">@Culture["Apply.Availability"]</li>
                                    @if (_requiresDrivingLicense)
                                    {
                                        <li class="@(_profileHasLicense ? "is-done" : null)">@Culture.Format("Apply.LicenseItem", LocalizeLicenseList(_vacancy.RequiredDrivingLicense!))</li>
                                    }
                                    <li class="@(_profileHasEmployers ? "is-done" : null)">
                                        @if (_vacancy.MinimumEmployers is > 0)
                                        {
                                            @Culture.Format("Apply.ExperienceMin", _vacancy.MinimumEmployers)
                                        }
                                        else
                                        {
                                            @Culture["Apply.Experience"]
                                        }
                                    </li>
                                    @if (_requiresEducation)
                                    {
                                        <li class="@(_profileHasEducation ? "is-done" : null)">@Culture.Format("Apply.EducationItem", LocalizeEducationList(_vacancy.RequiredEducation!))</li>
                                    }
                                    <li class="@(_profileHasAboutMe ? "is-done" : null)">@Culture["Apply.AboutYou"]</li>
                                    @if (_vacancy.MinimumReferences is > 0)
                                    {
                                        <li class="@(_profileHasReferences ? "is-done" : null)">@Culture.Format("Apply.ReferencesMin", _vacancy.MinimumReferences)</li>
                                    }
                                </ul>
                                <a class="login-submit apply-flow__primary"
                                   href="@ProfileReturnHref">
                                    @Culture["Apply.CompleteProfileCta"]
                                </a>
                            </div>
                        }
                        else if (_awaitingVerification)
                        {
                            <div class="apply-panel apply-panel--verify">
                                <p class="apply-panel__title">@Culture["Apply.VerifyTitle"]</p>
                                <p class="apply-panel__text">
                                    @Culture["Apply.VerifyBody"]
                                </p>
                                <label class="apply-code-field">
                                    <span>@Culture["Apply.VerificationCode"]</span>
                                    <input class="apply-code-field__input"
                                           type="text"
                                           inputmode="numeric"
                                           autocomplete="one-time-code"
                                           maxlength="6"
                                           placeholder="••••••"
                                           @bind="_verificationCode"
                                           @bind:event="oninput" />
                                </label>
                                <button class="login-submit apply-flow__primary"
                                        type="button"
                                        disabled="@(_applying || _verificationCode.Trim().Length != 6)"
                                        @onclick="VerifyApplicationAsync">
                                    @(_applying ? Culture["Apply.Busy"] : Culture["Apply.ConfirmSend"])
                                </button>
                                <button class="engagement-btn apply-flow__secondary"
                                        type="button"
                                        disabled="@_applying"
                                        @onclick="ApplyAsync">
                                    @Culture["Apply.ResendCode"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="apply-panel">
                                <section class="apply-section">
                                    <h3 class="apply-section__title">@Culture["Apply.HowTravel"]</h3>
                                    <label class="apply-field">
                                        <span>@Culture["Apply.Transport"]</span>
