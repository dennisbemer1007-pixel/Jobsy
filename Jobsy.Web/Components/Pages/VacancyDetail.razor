@page "/vacancies/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@inject PersistentComponentState Persist
@using Jobsy.Core.Media
@using Jobsy.Core.Rules
@using Jobsy.Web.Hosting
@using Jobsy.Web.Seo
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable

<PageTitle>@(_vacancy?.Title ?? Culture["Vacancy.Title"]) · Lobsy</PageTitle>
<PageSeo Title="@SeoTitle"
         Description="@SeoDescription"
         Index="@(_vacancy is not null)"
         ImageUrl="@SeoImage"
         OgType="article"
         JsonLd="@SeoJsonLd" />

<div class="panel-page panel-page--vacancy">
    @if (_vacancy is null)
    {
        @if (_loading)
        {
            <article class="detail-card detail-card--pending" aria-busy="true">
                <p class="visually-hidden">@Culture["Common.Loading"]</p>
                <div class="detail-card__header-row">
                    <a class="back-link" href="/">@Culture["Vacancy.BackToMap"]</a>
                </div>
                <div class="vacancy-media vacancy-media--split">
                    <div class="vacancy-media__skeleton"></div>
                    <div class="vacancy-media__skeleton"></div>
                </div>
                <div class="detail-card__skeleton-line"></div>
                <div class="detail-card__skeleton-line detail-card__skeleton-line--short"></div>
            </article>
        }
        else
        {
            <p class="state-message error">@Culture["Vacancy.NotFound"]</p>
        }
    }
    else
    {
        <article class="detail-card">
            <div class="detail-card__header-row">
                <a class="back-link" href="/">@Culture["Vacancy.BackToMap"]</a>
                <div class="detail-engagement-icons">
                    <AuthorizeView>
                        <Authorized>
                            <button class="engagement-icon-btn @(_liked ? "is-liked" : null)"
                                    type="button"
                                    disabled="@_liking"
                                    title="@(_liked ? Culture["Vacancy.Liked"] : Culture["Vacancy.Like"])"
                                    aria-label="@(_liked ? Culture["Vacancy.Liked"] : Culture["Vacancy.Like"])"
                                    @onclick="ToggleLikeAsync">
                                @if (_liked)
                                {
                                    <svg class="engagement-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="engagement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                                    </svg>
                                }
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <a class="engagement-icon-btn"
                               href="@LoginUrl"
                               title="@Culture["Vacancy.Like"]"
                               aria-label="@Culture["Vacancy.Like"]">
                                <svg class="engagement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
                                </svg>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                    <button class="engagement-icon-btn"
                            type="button"
                            title="@Culture["Vacancy.Share"]"
                            aria-label="@Culture["Vacancy.Share"]"
                            @onclick="OpenShare">
                        <svg class="engagement-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="18" cy="5" r="2.5"/>
                            <circle cx="6" cy="12" r="2.5"/>
                            <circle cx="18" cy="19" r="2.5"/>
                            <path d="M8.5 13.5 15.5 17.5M15.5 6.5 8.5 10.5"/>
                        </svg>
                    </button>
                </div>
            </div>

            @if (HasPhoto || HasLocation)
            {
                <div class="vacancy-media @(HasPhoto && HasLocation ? "vacancy-media--split" : null)">
                    @if (HasPhoto)
                    {
                        <VacancyPhoto Src="@_vacancy.ImageUrl"
                                      FallbackSrc="@_vacancy.CompanyLogoUrl"
                                      VacancyId="_vacancy.Id"
                                      WorkType="@(_vacancy.WorkTypes.FirstOrDefault())"
                                      Class="detail-card__image vacancy-media__photo"
                                      Eager="true"
                                      Sizes="@(HasLocation ? "(max-width: 640px) 100vw, 55vw" : "(max-width: 700px) 100vw, 720px")" />
                    }

                    @if (HasLocation)
                    {
                        <div class="vacancy-location__map-wrap vacancy-media__map" aria-label="@Culture["Vacancy.LocationMap"]">
                            <div id="vacancy-detail-map" class="vacancy-location__map vacancy-detail-map"></div>
                        </div>
                    }
                </div>
                @if (HasLocation)
                {
                    <div class="vacancy-location__actions">
                        <label class="vacancy-location__transport">
                            @Culture["Vacancy.YourTransport"]
                            <select value="@_transport" @onchange="OnTransportChanged">
                                <option value="Fiets">@Culture["Transport.Bike"]</option>
                                <option value="Auto">@Culture["Transport.Car"]</option>
                                <option value="OV">@Culture["Transport.Transit"]</option>
                                <option value="Lopend">@Culture["Transport.Walk"]</option>
                            </select>
                        </label>
                        <p class="vacancy-location__eta" aria-live="polite">
                            @if (_travelLoading)
                            {
                                <span class="vacancy-location__eta-loading">@Culture["Vacancy.TravelLoading"]</span>
                            }
                            else if (_vacancy.TravelMinutes is int minutes && _vacancy.DistanceKm is double km)
                            {
                                <span class="vacancy-location__eta-value">@FormatTravelEta(minutes, km)</span>
                            }
                            else if (_hasOrigin)
                            {
                                <span class="vacancy-location__eta-hint">@Culture["Vacancy.TravelUnavailable"]</span>
                            }
                            else
                            {
                                <span class="vacancy-location__eta-hint">@Culture["Vacancy.TravelNeedOrigin"]</span>
                            }
                        </p>
                        <div class="vacancy-location__buttons">
                            <button class="engagement-btn vacancy-location__btn" type="button" disabled="@_openingRoute" @onclick="OpenRouteAsync">
                                @Culture["Vacancy.Route"]
                            </button>
                            <button class="engagement-btn vacancy-location__btn" type="button" @onclick="OpenStreetViewAsync">
                                @Culture["Vacancy.StreetView"]
                            </button>
                        </div>
                    </div>
                    @if (_vacancy.RequiredTransport.Length > 0)
                    {
                        <p class="vacancy-location__required">
                            @Culture["Vacancy.Transport"]: @string.Join(" · ", _vacancy.RequiredTransport.Select(LocalizeTransport))
                        </p>
                    }
                }
            }

            <div class="detail-card__top">
                <div>
                    <h1>@_vacancy.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(_vacancy.CategoryName)
                         && !VacancyCategoryDefaults.IsSeniorLightCategory(_vacancy.CategoryId))
                    {
                        <p class="vacancy-detail-category">
                            <span class="vacancy-category-swatch" style="--category-color:@(_vacancy.CategoryColorHex ?? "#F54A1B")" aria-hidden="true"></span>
                            @_vacancy.CategoryName
                        </p>
                    }
                    @if (ShowsSuitableFor65Plus)
                    {
                        <p class="suitable65-label-row">
                            <span class="suitable65-label" aria-hidden="true"></span>
                            @VacancyCategoryDefaults.SuitableFor65PlusLabel
                        </p>
                    }
                    @if (string.Equals(_vacancy.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
                        && !string.IsNullOrWhiteSpace(_vacancy.ExclusivityName))
                    {
                        <p class="job-card__badge job-card__badge--soft" style="display:inline-block;margin:0.35rem 0 0">@_vacancy.ExclusivityName</p>
                    }
                    <p class="company">
                        @if (!string.IsNullOrWhiteSpace(_vacancy.KvkNumber) && !string.IsNullOrWhiteSpace(_vacancy.Vestigingsnummer))
                        {
                            <a class="company-link" href="@($"/{_vacancy.KvkNumber}/{_vacancy.Vestigingsnummer}")">@_vacancy.CompanyName</a>
                        }
                        else
                        {
                            @_vacancy.CompanyName
                        }
                    </p>
                    <p class="address">@_vacancy.CompanyAddress</p>
                    @if (!string.IsNullOrWhiteSpace(_vacancy.OfferedByLabel))
                    {
                        <p class="muted" style="margin:0.25rem 0 0">@_vacancy.OfferedByLabel</p>
                    }
                </div>
                @if (_vacancy.WageVisible && _ageYears is null && _vacancy.WageByAge is { Count: > 0 })
                {
                    <aside class="detail-wage-panel" aria-label="@Culture["Vacancy.WagesByAge"]">
                        <p class="detail-wage-panel__title">@Culture["Vacancy.Wages"]</p>
                        <table class="wage-table">
                            <tbody>
                                @foreach (var band in _vacancy.WageByAge)
                                {
                                    <tr>
                                        <th>@band.Label</th>
                                        <td>€ @band.HourlyRate.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </aside>
                }
                else if (_vacancy.WageVisible && _vacancy.HourlyWage is not null)
                {
                    <span class="wage">€ @_vacancy.HourlyWage.Value.ToString("0.00")</span>
                }
                else if (!_vacancy.WageVisible)
                {
                    <a class="wage wage--cta" href="#dob">@Culture["Vacancy.EnterDob"]</a>
                }
            </div>

            @if (VideoEmbedUrl is not null)
            {
                <div class="detail-card__video">
                    <iframe src="@VideoEmbedUrl"
                            title="@Culture["Vacancy.Video"]"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                            referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            }
            else if (SafeVideoWatchUrl is not null)
            {
                <p class="detail-card__video-link">
                    <a href="@SafeVideoWatchUrl" target="_blank" rel="noopener noreferrer">@Culture["Vacancy.WatchVideo"]</a>
                </p>
            }

            <p class="detail-card__body">@_vacancy.Description</p>
            <p class="travel-hint">
                @Culture["Vacancy.StartDate"]: @_vacancy.StartDate.ToString("dd-MM-yyyy")
                @if (_vacancy.WorkTypes.Length > 0)
                {
                    <text> · @Culture["Vacancy.WorkType"]: @string.Join(", ", _vacancy.WorkTypes.Select(LocalizeWorkType))</text>
                }
            </p>

            @if (HasHoursInfo || HasScheduleInfo || HasLegalInfo)
            {
                <aside class="vacancy-facts" aria-label="@Culture["Vacancy.Facts"]">
                    @if (HasHoursInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.HoursPerWeek"]</h2>
                            <p class="vacancy-facts__text">
                                @_vacancy.MinHoursPerWeek?.ToString("0.#")–@_vacancy.MaxHoursPerWeek?.ToString("0.#")
                                @Culture["Vacancy.HoursUnit"]
                                @if (HoursCategoryLabel is not null)
                                {
                                    <span class="muted"> · @HoursCategoryLabel</span>
                                }
                            </p>
                        </div>
                    }

                    @if (HasScheduleInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.DayParts"]</h2>
                            @if (_vacancy.FlexibleTimes)
                            {
                                <p class="vacancy-facts__text">@Culture["Vacancy.FlexibleTimes"]</p>
                            }
                            else
                            {
                                <div class="vacancy-facts__chips">
                                    @foreach (var chip in ScheduleChips)
                                    {
                                        <span class="vacancy-facts__chip">@chip</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (HasLegalInfo)
                    {
                        <div class="vacancy-facts__block">
                            <h2 class="vacancy-facts__title">@Culture["Vacancy.WorkConditions"]</h2>
                            <ul class="vacancy-facts__list">
                                @foreach (var item in LegalFactItems)
                                {
                                    <li class="@(item.Highlighted ? "is-alert" : null)">
                                        <span class="vacancy-facts__badge">@(item.Active ? Culture["Vacancy.Yes"] : Culture["Vacancy.No"])</span>
                                        <span>@item.Label</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </aside>
            }

            @if (!string.IsNullOrWhiteSpace(_vacancy.RequiredDrivingLicense)
                || !string.IsNullOrWhiteSpace(_vacancy.RequiredEducation)
                || _vacancy.MinimumEmployers is > 0
                || _vacancy.MinimumReferences is > 0)
            {
                <aside class="lobsy-proximity" aria-label="@Culture["Vacancy.HardRequirements"]">
                    <span class="lobsy-proximity__icon"><LobsyMark /></span>
                    <div class="lobsy-proximity__body">
                        <p class="lobsy-proximity__title">@Culture["Vacancy.HardRequirements"]</p>
                        <p class="lobsy-proximity__meta">
                            @if (!string.IsNullOrWhiteSpace(_vacancy.RequiredDrivingLicense))
                            {
                                <span class="lobsy-proximity__chip">@Culture["Vacancy.License"]: @LocalizeLicenseList(_vacancy.RequiredDrivingLicense)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_vacancy.RequiredEducation))
                            {
                                <span class="lobsy-proximity__chip">@Culture["Vacancy.EducationLevel"]: @LocalizeEducationList(_vacancy.RequiredEducation)</span>
                            }
                            @if (_vacancy.MinimumEmployers is > 0)
                            {
                                <span class="lobsy-proximity__chip">@Culture.Format("Vacancy.MinEmployers", _vacancy.MinimumEmployers)</span>
                            }
                            @if (_vacancy.MinimumReferences is > 0)
                            {
                                <span class="lobsy-proximity__chip">@Culture.Format("Vacancy.MinReferences", _vacancy.MinimumReferences)</span>
                            }
                        </p>
                    </div>
                </aside>
            }

            @if (!_vacancy.WageVisible)
            {
                <div id="dob" class="dob-prompt">
                    <p>@Culture["Vacancy.DobPrompt"]</p>
                    <AuthorizeView Roles="Candidate">
                        <Authorized>
                            <label>
                                @Culture["Vacancy.DateOfBirth"]
                                <input type="date" @bind="_dobInput" />
                            </label>
                            <button class="login-submit" type="button" disabled="@_savingDob" @onclick="SaveDobAsync">
                                @Culture["Common.Save"]
                            </button>
                            <p class="login-lead">@Culture["Vacancy.ManageInProfile"] <a href="/candidate/profile">@Culture["Vacancy.YourProfile"]</a>.</p>
                        </Authorized>
                        <NotAuthorized>
                            <a class="login-submit" href="@LoginUrl" style="text-decoration:none;display:inline-flex;">@Culture["Vacancy.LoginAsCandidate"]</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }

            <AuthorizeView Roles="Candidate">
                <Authorized>
                    <div class="lobsy-coach-cta">
                        <button type="button"
                                class="lobsy-coach-cta__btn"
                                @onclick="OpenMockInterview"
                                aria-label="@Culture["MockInterview.CtaAria"]">
                            <LobsyCoachAvatar Class="lobsy-coach-cta__mascot" Language="@Culture.Language" Alt="" />
                            <span class="lobsy-coach-cta__bubble">@Culture["MockInterview.CtaBubble"]</span>
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div id="apply" class="apply-flow">
                <AuthorizeView Roles="Candidate">
                    <Authorized>
                        <header class="apply-flow__header">
                            <h2 class="apply-flow__title">@Culture["Apply.Title"]</h2>
                            <p class="apply-flow__lead">@ApplyFlowLead</p>
                        </header>

                        <ol class="apply-steps" aria-label="@Culture["Apply.StepsLabel"]">
                            <li class="apply-steps__item @ProfileStepClass">
                                <span class="apply-steps__num" aria-hidden="true">1</span>
                                <span class="apply-steps__label">@Culture["Apply.StepProfile"]</span>
                            </li>
                            <li class="apply-steps__item @ConsentStepClass">
                                <span class="apply-steps__num" aria-hidden="true">2</span>
                                <span class="apply-steps__label">@Culture["Apply.StepConsent"]</span>
                            </li>
                            <li class="apply-steps__item @SendStepClass">
                                <span class="apply-steps__num" aria-hidden="true">3</span>
                                <span class="apply-steps__label">@Culture["Apply.StepSend"]</span>
                            </li>
                            <li class="apply-steps__item @VerifyStepClass">
                                <span class="apply-steps__num" aria-hidden="true">4</span>
                                <span class="apply-steps__label">@Culture["Apply.StepVerify"]</span>
                            </li>
                        </ol>

                        @if (_applied)
                        {
                            <div class="apply-panel apply-panel--success" role="status">
                                <p class="apply-panel__title">@Culture["Apply.SentTitle"]</p>
                                <p class="apply-panel__text">@Culture["Apply.SentBody"]</p>
                                @if (_directContact is { Available: true })
                                {
                                    <button type="button"
                                            class="login-submit apply-flow__primary"
                                            style="margin-bottom:0.5rem"
                                            @onclick="() => OpenDirectContactIfAvailable(_directContact)">
                                        @Culture["Apply.DirectContactTitle"]
                                    </button>
                                }
                                <a class="engagement-btn apply-flow__secondary" href="/candidate/applications">@Culture["Apply.MyApplications"]</a>
                            </div>
                        }
                        else if (!_profileReadyForApply)
                        {
                            <div class="apply-panel apply-panel--warn">
                                <p class="apply-panel__title">@Culture["Apply.CompleteProfileTitle"]</p>
                                <p class="apply-panel__text">@Culture["Apply.CompleteProfileBody"]</p>
                                <ul class="apply-checklist">
                                    <li class="@(_profileHasAvailability ? "is-done" : null)">@Culture["Apply.Availability"]</li>
                                    @if (_requiresDrivingLicense)
                                    {
                                        <li class="@(_profileHasLicense ? "is-done" : null)">@Culture.Format("Apply.LicenseItem", LocalizeLicenseList(_vacancy.RequiredDrivingLicense!))</li>
                                    }
                                    <li class="@(_profileHasEmployers ? "is-done" : null)">
                                        @if (_vacancy.MinimumEmployers is > 0)
                                        {
                                            @Culture.Format("Apply.ExperienceMin", _vacancy.MinimumEmployers)
                                        }
                                        else
                                        {
                                            @Culture["Apply.Experience"]
                                        }
                                    </li>
                                    @if (_requiresEducation)
                                    {
                                        <li class="@(_profileHasEducation ? "is-done" : null)">@Culture.Format("Apply.EducationItem", LocalizeEducationList(_vacancy.RequiredEducation!))</li>
                                    }
                                    <li class="@(_profileHasAboutMe ? "is-done" : null)">@Culture["Apply.AboutYou"]</li>
                                    @if (_vacancy.MinimumReferences is > 0)
                                    {
                                        <li class="@(_profileHasReferences ? "is-done" : null)">@Culture.Format("Apply.ReferencesMin", _vacancy.MinimumReferences)</li>
                                    }
                                </ul>
                                <a class="login-submit apply-flow__primary"
                                   href="@ProfileReturnHref">
                                    @Culture["Apply.CompleteProfileCta"]
                                </a>
                            </div>
                        }
                        else if (_awaitingVerification)
                        {
                            <div class="apply-panel apply-panel--verify">
                                <p class="apply-panel__title">@Culture["Apply.VerifyTitle"]</p>
                                <p class="apply-panel__text">
                                    @Culture["Apply.VerifyBody"]
                                </p>
                                <label class="apply-code-field">
                                    <span>@Culture["Apply.VerificationCode"]</span>
                                    <input class="apply-code-field__input"
                                           type="text"
                                           inputmode="numeric"
                                           autocomplete="one-time-code"
                                           maxlength="6"
                                           placeholder="••••••"
                                           @bind="_verificationCode"
                                           @bind:event="oninput" />
                                </label>
                                <button class="login-submit apply-flow__primary"
                                        type="button"
                                        disabled="@(_applying || _verificationCode.Trim().Length != 6)"
                                        @onclick="VerifyApplicationAsync">
                                    @(_applying ? Culture["Apply.Busy"] : Culture["Apply.ConfirmSend"])
                                </button>
                                <button class="engagement-btn apply-flow__secondary"
                                        type="button"
                                        disabled="@_applying"
                                        @onclick="ApplyAsync">
                                    @Culture["Apply.ResendCode"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="apply-panel">
                                <section class="apply-section">
                                    <h3 class="apply-section__title">@Culture["Apply.HowTravel"]</h3>
                                    <label class="apply-field">
                                        <span>@Culture["Apply.Transport"]</span>
                                        <select value="@_transport" @onchange="OnTransportChanged">
                                            <option value="Fiets">@Culture["Transport.Bike"]</option>
                                            <option value="Auto">@Culture["Transport.Car"]</option>
                                            <option value="OV">@Culture["Transport.Transit"]</option>
                                            <option value="Lopend">@Culture["Transport.Walk"]</option>
                                        </select>
                                    </label>
                                </section>

                                <section class="apply-section">
                                    <h3 class="apply-section__title">@Culture["Apply.Confirmations"]</h3>
                                    @if (RequiresExclusivityExtras)
                                    {
                                        <p class="muted">@_vacancy!.ExclusivityName — vul je schoolgegevens in om te solliciteren.</p>
                                        <div class="apply-fields-grid">
                                            <label class="apply-field">
                                                <span>Studentnummer</span>
                                                <input @bind="_studentNumber" @bind:event="oninput" maxlength="64" required />
                                            </label>
                                            <label class="apply-field">
                                                <span>School e-mailadres</span>
                                                <input type="email" @bind="_schoolEmail" @bind:event="oninput" maxlength="256" required />
                                            </label>
                                            <label class="apply-field">
                                                <span>Opleiding</span>
                                                @if (_vacancy.ExclusivityEducations.Count > 0)
                                                {
                                                    <select @bind="_studyProgram">
                                                        <option value="">— Kies opleiding —</option>
                                                        @foreach (var edu in _vacancy.ExclusivityEducations)
                                                        {
                                                            <option value="@edu">@edu</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input @bind="_studyProgram" @bind:event="oninput" maxlength="256" required />
                                                }
                                            </label>
                                            <label class="apply-field">
                                                <span>Leerjaar (optioneel)</span>
                                                <input @bind="_studyYear" @bind:event="oninput" maxlength="64" />
                                            </label>
                                        </div>
                                    }
                                    @if (_authenticatorEnabled)
                                    {
                                        <label class="apply-check">
                                            <input type="checkbox" @bind="_useAuthenticator" />
                                            <span>@Culture["Apply.UseAuthenticator"]</span>
                                        </label>
                                    }
                                    <label class="apply-check">
                                        <input type="checkbox" @bind="_acceptedTerms" />
                                        <span>
                                            @Culture["Apply.AcceptTerms"]
                                            <a class="auth-link" href="/gebruiksvoorwaarden" target="_blank" rel="noopener">@Culture["Apply.Terms"]</a>
                                            @Culture["Apply.AndThe"]
                                            <a class="auth-link" href="/privacy" target="_blank" rel="noopener">@Culture["Apply.Privacy"]</a>.
                                        </span>
                                    </label>
                                    <label class="apply-check">
                                        <input type="checkbox" @bind="_workPermitConfirmed" />
                                        <span>@Culture["Apply.WorkPermit"]</span>
                                    </label>
                                    <label class="apply-field apply-field--motivation">
                                        <span>@Culture["Apply.MotivationLabel"]</span>
                                        <textarea maxlength="500"
                                                  rows="6"
                                                  @bind="_motivation"
                                                  @bind:event="oninput"
                                                  placeholder="@Culture["Apply.MotivationPlaceholder"]"></textarea>
                                    </label>
                                </section>

                                @if (_showSafetyNet)
                                {
                                    <div class="apply-panel apply-panel--warn" style="margin-bottom:0.75rem">
                                        <p class="apply-panel__title">Matchscore @_safetyNetPercent%</p>
                                        <p class="apply-panel__text">@(_safetyNetMessage ?? "Je matchscore is lager dan 50%. Pas je profiel aan of ga toch door via het vangnet.")</p>
                                        <div class="inline-actions" style="gap:0.5rem;flex-wrap:wrap">
                                            <a class="login-submit apply-flow__primary" href="@ProfileReturnHref">Ja, pas mijn profiel aan</a>
                                            <button class="engagement-btn apply-flow__secondary"
                                                    type="button"
                                                    disabled="@_applying"
                                                    @onclick="ContinueWithSafetyNetAsync">
                                                Toch doorgaan met solliciteren
                                            </button>
                                        </div>
                                    </div>
                                }

                                @if (RequiresExclusivityExtras && ExclusivityBlocksApply)
                                {
                                    <button class="login-submit apply-flow__primary"
                                            type="button"
                                            disabled>
                                        Alleen toegankelijk voor studenten van @_vacancy!.ExclusivityName
                                    </button>
                                }
                                else
                                {
                                    <button class="login-submit apply-flow__primary"
                                            type="button"
                                            disabled="@(_applying || !_acceptedTerms || !_workPermitConfirmed || _showSafetyNet || (RequiresExclusivityExtras && !ExclusivityFieldsReady))"
                                            @onclick="ApplyAsync">
                                        @(_applying ? Culture["Apply.Busy"] : Culture["Apply.Submit"])
                                    </button>
                                }
                                <p class="apply-flow__hint">@Culture["Apply.EmailCodeHint"]</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <p class="apply-flow__message @(_applied ? "is-success" : null)" role="status">@_message</p>
                        }
                    </Authorized>
                    <NotAuthorized>
                        @* Hide Solliciteren for admin / intermediary / manager roles; only anonymous see login-to-apply. *@
                        <AuthorizeView Context="authState">
                            <NotAuthorized Context="anon">
                                <div class="apply-panel apply-panel--guest">
                                    <div class="apply-panel--guest__copy">
                                        <h2 class="apply-flow__title">@Culture["Apply.Title"]</h2>
                                        <p class="apply-panel__text">@Culture["Apply.LoginToApply"]</p>
                                    </div>
                                    <a class="login-submit apply-flow__primary" href="@LoginUrl">@Culture["Apply.LoginCta"]</a>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

        </article>
    }
</div>

<ShareModal IsOpen="_shareOpen" Vacancy="_vacancy" OnClose="CloseShare" />
<MockInterviewModal IsOpen="_mockInterviewOpen" Vacancy="_vacancy" OnClose="CloseMockInterview" />
<DirectContactModal IsOpen="_directContactOpen" Contact="_directContact" OnClose="CloseDirectContact" />

@code {
    [Parameter] public Guid Id { get; set; }

    private VacancyListItem? _vacancy;
    private string? SeoTitle => _vacancy is null ? null : $"{_vacancy.Title} · Lobsy";
    private string? SeoDescription => _vacancy is null
        ? null
        : Culture.Format("Seo.VacancyDescription", _vacancy.Title, _vacancy.CompanyName);
    private string? SeoImage =>
        VacancyImageUrls.Normalize(_vacancy?.ImageUrl)
        ?? VacancyImageUrls.Normalize(_vacancy?.CompanyLogoUrl);
    private string? SeoJsonLd
    {
        get
        {
            if (_vacancy is null)
            {
                return null;
            }

            var origin = Navigation.BaseUri.TrimEnd('/');
            var pageUrl = origin + "/vacancies/" + _vacancy.Id.ToString("D");
            return StructuredData.JobPosting(
                _vacancy.Id,
                _vacancy.Title,
                _vacancy.Description,
                _vacancy.CompanyName,
                _vacancy.CompanyLogoUrl,
                _vacancy.CompanyAddress,
                _vacancy.Latitude,
                _vacancy.Longitude,
                _vacancy.StartDate,
                _vacancy.EndDate,
                _vacancy.Kind,
                _vacancy.HourlyWage,
                _vacancy.WageVisible,
                _vacancy.MinHoursPerWeek,
                _vacancy.MaxHoursPerWeek,
                pageUrl,
                origin);
        }
    }
    private bool ShowsSuitableFor65Plus =>
        _vacancy is not null
        && VacancyCategoryDefaults.MatchesSuitableFor65PlusFilter(_vacancy.CategoryId, _vacancy.SuitableFor65Plus);
    private bool _loading = true;
    private bool _applying;
    private bool _applied;
    private bool _liked;
    private bool _liking;
    private bool _shareOpen;
    private bool _mockInterviewOpen;
    private bool _directContactOpen;
    private EmployerDirectContactItem? _directContact;
    private bool _savingDob;
    private DateOnly? _dobInput;
    private string _transport = "Fiets";
    private bool _transportTouched;
    private bool _hasOrigin;
    private bool _travelLoading;
    private string? _message;
    private bool _clickRecorded;
    private bool _authenticatorEnabled;
    private bool _useAuthenticator;
    private bool _acceptedTerms;
    private bool _workPermitConfirmed;
    private bool _profileReadyForApply = true;
    private bool _profileHasAvailability;
    private bool _profileHasLicense = true;
    private bool _profileHasEmployers;
    private bool _profileHasEducation = true;
    private bool _profileHasAboutMe;
    private bool _profileHasReferences;
    private bool _requiresDrivingLicense;
    private bool _requiresEducation;
    private bool _awaitingVerification;
    private bool _enteredVerifyThisSession;
    private string _verificationCode = string.Empty;
    private string _motivation = string.Empty;
    private string _studentNumber = string.Empty;
    private string _schoolEmail = string.Empty;
    private string _studyProgram = string.Empty;
    private string _studyYear = string.Empty;
    private bool _showSafetyNet;
    private string? _safetyNetMessage;
    private int? _safetyNetPercent;
    private bool _confirmSafetyNet;
    private int? _ageYears;
    private bool _mapReady;
    private bool _openingRoute;
    private Guid? _mappedVacancyId;
    private Guid? _loadedVacancyId;
    private PersistingComponentStateSubscription _persistSubscription;

    private bool RequiresExclusivityExtras
        => _vacancy is not null
           && string.Equals(_vacancy.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
           && !_vacancy.ExclusivityIsOpen
           && !string.IsNullOrWhiteSpace(_vacancy.ExclusivityName);

    private bool ExclusivityFieldsReady
        => !string.IsNullOrWhiteSpace(_studentNumber)
           && !string.IsNullOrWhiteSpace(_schoolEmail)
           && !string.IsNullOrWhiteSpace(_studyProgram);

    /// <summary>
    /// Soft UI block when school domain is known and entered school e-mail clearly mismatches.
    /// </summary>
    private bool ExclusivityBlocksApply
    {
        get
        {
            if (!RequiresExclusivityExtras || string.IsNullOrWhiteSpace(_vacancy?.ExclusivitySchoolDomain))
            {
                return false;
            }

            if (string.IsNullOrWhiteSpace(_schoolEmail))
            {
                return false;
            }

            var domain = _vacancy!.ExclusivitySchoolDomain!.Trim().TrimStart('@').ToLowerInvariant();
            var email = _schoolEmail.Trim().ToLowerInvariant();
            var at = email.LastIndexOf('@');
            if (at < 0)
            {
                return true;
            }

            var mailDomain = email[(at + 1)..];
            return !string.Equals(mailDomain, domain, StringComparison.Ordinal);
        }
    }

    private string LoginUrl =>
        $"/login?returnUrl={Uri.EscapeDataString($"/vacancies/{Id}")}";

    private string ProfileReturnHref =>
        $"/candidate/profile?returnUrl={Uri.EscapeDataString($"/vacancies/{Id}#apply")}";

    private string ApplyFlowLead => _applied
        ? Culture["Apply.LeadDone"]
        : !_profileReadyForApply
            ? Culture["Apply.LeadProfile"]
            : _awaitingVerification
                ? Culture["Apply.LeadVerify"]
                : Culture["Apply.LeadReady"];

    private string ProfileStepClass =>
        _applied || _profileReadyForApply ? "is-done" : "is-current";

    private string ConsentStepClass =>
        _applied || _awaitingVerification
            ? "is-done"
            : _profileReadyForApply && (_acceptedTerms && _workPermitConfirmed)
                ? "is-done"
                : _profileReadyForApply
                    ? "is-current"
                    : string.Empty;

    private string SendStepClass =>
        _applied
            ? "is-done"
            : _awaitingVerification
                ? "is-done"
                : _profileReadyForApply && _acceptedTerms && _workPermitConfirmed
                    ? "is-current"
                    : string.Empty;

    private string VerifyStepClass =>
        _applied
            ? "is-done"
            : _awaitingVerification
                ? "is-current"
                : string.Empty;

    private bool HasPhoto =>
        _vacancy is not null
        && (!string.IsNullOrWhiteSpace(VacancyImageUrls.Normalize(_vacancy.ImageUrl))
            || !string.IsNullOrWhiteSpace(VacancyImageUrls.Normalize(_vacancy.CompanyLogoUrl)));

    private bool HasLocation =>
        _vacancy is not null
        && double.IsFinite(_vacancy.Latitude)
        && double.IsFinite(_vacancy.Longitude)
        && !(_vacancy.Latitude == 0 && _vacancy.Longitude == 0)
        && Math.Abs(_vacancy.Latitude) <= 90
        && Math.Abs(_vacancy.Longitude) <= 180;

    private string FormatTravelEta(int minutes, double km)
        => $"{minutes} {Culture["Discovery.Minutes"]} · {km.ToString("0.0")} km";

    private string? VideoEmbedUrl =>
        _vacancy is null ? null : VideoEmbed.TryGetEmbedUrl(_vacancy.VideoUrl);

    private string? SafeVideoWatchUrl =>
        VideoEmbedUrl is not null
            ? null
            : _vacancy is null ? null : VideoEmbed.TryGetSafeWatchUrl(_vacancy.VideoUrl);

    private bool HasHoursInfo =>
        _vacancy is { MinHoursPerWeek: not null, MaxHoursPerWeek: not null };

    private bool HasScheduleInfo =>
        _vacancy is not null
        && (_vacancy.FlexibleTimes
            || (!string.IsNullOrWhiteSpace(_vacancy.ScheduleJson) && ScheduleChips.Count > 0));

    private bool HasLegalInfo => LegalFactItems.Count > 0;

    private string? HoursCategoryLabel
    {
        get
        {
            if (_vacancy?.MinHoursPerWeek is not decimal min || _vacancy.MaxHoursPerWeek is not decimal max)
            {
                return null;
            }

            var range = new HoursRange(min, max);
            return range.Validate() is null
                ? HoursRangeRules.CategoryLabel(range.Category)
                : null;
        }
    }

    private IReadOnlyList<string> ScheduleChips
    {
        get
        {
            if (_vacancy is null || _vacancy.FlexibleTimes || string.IsNullOrWhiteSpace(_vacancy.ScheduleJson))
            {
                return [];
            }

            try
            {
                var payload = System.Text.Json.JsonSerializer.Deserialize<SchedulePayload>(
                    _vacancy.ScheduleJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (payload?.Slots is null || payload.Slots.Count == 0)
                {
                    return [];
                }

                return payload.Slots
                    .OrderBy(kv => Array.IndexOf(DayPartMatrix.DayCodes, DayPartMatrix.NormalizeDayCode(kv.Key)))
                    .SelectMany(kv => (kv.Value ?? [])
                        .OrderBy(p => Array.IndexOf(DayPartMatrix.DayPartCodes, DayPartMatrix.NormalizeDayPartCode(p)))
                        .Select(p => $"{DayPartMatrix.NormalizeDayCode(kv.Key)} {DayPartMatrix.NormalizeDayPartCode(p)}"))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch (System.Text.Json.JsonException)
            {
                return [];
            }
        }
    }

    private IReadOnlyList<LegalFactItem> LegalFactItems
    {
        get
        {
            if (_vacancy is null)
            {
                return [];
            }

            var items = new List<LegalFactItem>();
            void Add(bool? value, string label, bool highlightWhenTrue = true, bool invertHighlight = false)
            {
                if (value is null)
                {
                    return;
                }

                var active = value.Value;
                var highlighted = invertHighlight ? !active : (highlightWhenTrue && active);
                items.Add(new LegalFactItem(label, active, highlighted));
            }

            Add(_vacancy.LegalWorksAfter19, Culture["Vacancy.LegalWorksAfter19"]);
            Add(_vacancy.LegalNightShift23To06, Culture["Vacancy.LegalNightShift"]);
            Add(_vacancy.LegalAdultSupervisorPresent, Culture["Vacancy.LegalAdultSupervisor"], highlightWhenTrue: false, invertHighlight: true);
            Add(_vacancy.LegalHandlesMoneyOrClosing, Culture["Vacancy.LegalHandlesMoney"]);
            Add(_vacancy.LegalHeavyOrHazardousWork, Culture["Vacancy.LegalHeavyWork"]);
            return items;
        }
    }

    private readonly record struct LegalFactItem(string Label, bool Active, bool Highlighted);

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistVacancyState);
        if (Persist.TryTakeFromJson<VacancyListItem>("vacancyDetail", out var saved)
            && saved is not null
            && saved.Id == Id)
        {
            _vacancy = saved;
            _loading = false;
        }
    }

    private Task PersistVacancyState()
    {
        if (_vacancy is not null)
        {
            Persist.PersistAsJson("vacancyDetail", _vacancy);
        }

        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedVacancyId == Id)
        {
            return;
        }

        var keepPrerendered = _vacancy is not null && _vacancy.Id == Id;
        ResetApplyUiState();
        _loadedVacancyId = Id;
        _liked = false;
        _clickRecorded = false;
        _ageYears = null;
        _mapReady = false;
        _mappedVacancyId = null;
        _pendingInitialHydration = true;
        if (keepPrerendered)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _vacancy = null;
        if (!RendererInfo.IsInteractive)
        {
            await LoadAsync(origin: null);
        }
    }

    private bool _pendingInitialHydration;

    private void ResetApplyUiState()
    {
        _applying = false;
        _applied = false;
        _awaitingVerification = false;
        _enteredVerifyThisSession = false;
        _acceptedTerms = false;
        _workPermitConfirmed = false;
        _useAuthenticator = false;
        _verificationCode = string.Empty;
        _message = null;
        _profileReadyForApply = true;
        _profileHasAvailability = false;
        _profileHasLicense = true;
        _profileHasEmployers = false;
        _profileHasEducation = true;
        _profileHasAboutMe = false;
        _profileHasReferences = true;
        _requiresDrivingLicense = false;
        _requiresEducation = false;
        _authenticatorEnabled = false;
        _dobInput = null;
        _directContact = null;
        _directContactOpen = false;
    }

    private async void OnCultureChanged()
    {
        await LoadAsync(origin: null);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
        if (_mapReady)
        {
            try
            {
                await Js.InvokeVoidAsync("vacancyDetailMap.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingInitialHydration)
        {
            _pendingInitialHydration = false;
            try
            {
                OriginPoint? origin = null;
                try
                {
                    var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                    if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                    {
                        origin = new OriginPoint { Latitude = lat, Longitude = lng };
                    }
                }
                catch
                {
                    // optional
                }

                _ageYears = await ResolveAgeYearsAsync();

                // Prefer profile geboortedatum over session filter when the candidate is logged in.
                try
                {
                    var auth = await AuthState.GetAuthenticationStateAsync();
                    if (auth.User.Identity?.IsAuthenticated == true
                        && RoleClaimMatching.HasRole(auth.User, JobsyRoles.Candidate))
                    {
                        var profile = await SafeProfileAsync();
                        if (profile?.DateOfBirth is DateOnly dob
                            && AgeRules.AgeYearsFromDateOfBirth(dob) is int fromDob)
                        {
                            _dobInput = dob;
                            _ageYears = AgeRules.ClampFilterAge(fromDob);
                            try { await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", _ageYears.Value); }
                            catch { /* ignore */ }
                        }
                    }
                }
                catch
                {
                    // profile optional
                }

                await LoadAsync(origin);
                _hasOrigin = origin is not null;
                await LoadLikeAsync();

                // LoadLike may populate DOB when the early profile fetch missed — align wages once.
                if (_dobInput is DateOnly likedDob
                    && AgeRules.AgeYearsFromDateOfBirth(likedDob) is int likedAge)
                {
                    var clamped = AgeRules.ClampFilterAge(likedAge);
                    if (_ageYears != clamped)
                    {
                        _ageYears = clamped;
                        try { await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", clamped); }
                        catch { /* ignore */ }
                        await LoadAsync(origin);
                    }
                }

                await InvokeAsync(StateHasChanged);

                if (!_clickRecorded)
                {
                    _clickRecorded = true;
                    await Api.RecordClickOnceAsync(Js, Id);
                }

                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                if (uri.Fragment.Equals("#apply", StringComparison.OrdinalIgnoreCase))
                {
                    await Js.InvokeVoidAsync("jobsyGeo.scrollToId", "apply");
                }
                else if (uri.Fragment.Equals("#dob", StringComparison.OrdinalIgnoreCase))
                {
                    await Js.InvokeVoidAsync("jobsyGeo.scrollToId", "dob");
                }
            }
            catch
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        await EnsureDetailMapAsync();
    }

    /// <summary>
    /// Age for wages: stored banenkaart filter age, else none (“Alle” → full table).
    /// Profile DOB is applied after LoadLike when available.
    /// </summary>
    private async Task<int?> ResolveAgeYearsAsync()
    {
        try
        {
            var stored = await Js.InvokeAsync<int?>("jobsyGeo.getStoredAge");
            if (stored is int age)
            {
                return AgeRules.ClampFilterAge(age);
            }
        }
        catch
        {
            // ignore
        }

        return null;
    }

    private async Task EnsureDetailMapAsync()
    {
        if (!HasLocation)
        {
            return;
        }

        // Recreate when navigating to another vacancy or first paint.
        if (_mapReady && _mappedVacancyId == Id)
        {
            return;
        }

        if (_mapReady)
        {
            try { await Js.InvokeVoidAsync("vacancyDetailMap.dispose"); }
            catch { /* ignore */ }
            _mapReady = false;
        }

        try
        {
            await MapScripts.EnsureDetailAsync(Js);
            // Pass numbers (JSON) so MapLibre gets exact coords without culture parsing.
            await Js.InvokeVoidAsync("vacancyDetailMap.init", "vacancy-detail-map", new Dictionary<string, object?>
            {
                ["lat"] = _vacancy!.Latitude,
                ["lng"] = _vacancy.Longitude,
                ["title"] = _vacancy.Title,
                ["company"] = _vacancy.CompanyName,
                ["offeredBy"] = _vacancy.OfferedByLabel,
                ["address"] = _vacancy.CompanyAddress
            });
            _mapReady = true;
            _mappedVacancyId = Id;
        }
        catch
        {
            // MapLibre may not be ready yet — retry on next render
            _mapReady = false;
            _mappedVacancyId = null;
        }
    }

    private async Task LoadAsync(OriginPoint? origin)
    {
        try
        {
            _vacancy = await Api.GetVacancyAsync(
                Id,
                origin?.Latitude,
                origin?.Longitude,
                _transport,
                _ageYears);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLikeAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var isCandidate = RoleClaimMatching.HasRole(auth.User, JobsyRoles.Candidate);
        Task<MeProfile?>? profileTask = null;
        Task<IReadOnlyList<ApplicationItem>?>? appsTask = null;
        MeProfile? candidateProfile = null;
        if (isCandidate)
        {
            profileTask = SafeProfileAsync();
            appsTask = SafeApplicationsAsync();
        }

        var likedTask = SafeLikedAsync();

        if (profileTask is not null)
        {
            var profile = await profileTask;
            candidateProfile = profile;
            if (profile is not null)
            {
                _dobInput = profile.DateOfBirth;
                _authenticatorEnabled = profile.AuthenticatorEnabled == true;
                var prefs = profile.Preferences ?? new CandidatePreferences();
                _requiresDrivingLicense = !string.IsNullOrWhiteSpace(_vacancy?.RequiredDrivingLicense);
                _requiresEducation = !string.IsNullOrWhiteSpace(_vacancy?.RequiredEducation);

                _profileHasAvailability = (prefs.Availability?.Count ?? 0) > 0;
                _profileHasLicense = !_requiresDrivingLicense
                    || DrivingLicenseLabels.CandidateMeetsRequirement(
                        prefs.DrivingLicenses,
                        _vacancy!.RequiredDrivingLicense);
                var employerCount = prefs.Employers?.Count ?? 0;
                var minEmployers = _vacancy?.MinimumEmployers is > 0 ? _vacancy.MinimumEmployers.Value : 1;
                _profileHasEmployers = employerCount >= minEmployers;
                _profileHasEducation = !_requiresEducation
                    || EducationLevelLabels.CandidateMeetsRequirement(
                        prefs.Educations,
                        _vacancy!.RequiredEducation);
                _profileHasAboutMe = !string.IsNullOrWhiteSpace(prefs.AboutMe);
                var neededRefs = _vacancy?.MinimumReferences is > 0 ? _vacancy.MinimumReferences.Value : 0;
                _profileHasReferences = neededRefs == 0
                    || CandidateReferenceRules.CountComplete(
                        (profile.References ?? []).Select(r => (r.EmployerName, r.ContactName, r.Email, r.Phone))) >= neededRefs;
                if (string.IsNullOrWhiteSpace(_motivation)
                    && !string.IsNullOrWhiteSpace(prefs.DefaultMotivation))
                {
                    _motivation = prefs.DefaultMotivation!;
                }

                if (!_transportTouched
                    && IsKnownTransport(prefs.PreferredTransport)
                    && !string.Equals(_transport, prefs.PreferredTransport!.Trim(), StringComparison.OrdinalIgnoreCase))
                {
                    _transport = NormalizeTransport(prefs.PreferredTransport);
                    if (_hasOrigin)
                    {
                        await RefreshTravelAsync();
                    }
                }
                _profileReadyForApply =
                    _profileHasAvailability
                    && _profileHasLicense
                    && _profileHasEmployers
                    && _profileHasEducation
                    && _profileHasAboutMe
                    && _profileHasReferences;
            }
        }

        if (isCandidate && _vacancy is not null)
        {
            await RecentlyViewedVacancies.RememberAsync(Js, _vacancy.Id, candidateProfile?.Id);
        }

        if (appsTask is not null)
        {
            var mine = await appsTask;
            if (mine is not null)
            {
                // Only verified (submitted) applications are returned — drafts awaiting a code stay out.
                // Withdrawn applications may be reopened via Apply, so they must not lock the UI.
                _applied = mine.Any(a => a.VacancyId == Id
                                         && !string.Equals(a.Status, "Withdrawn", StringComparison.OrdinalIgnoreCase));
                if (_applied)
                {
                    _awaitingVerification = false;
                    _enteredVerifyThisSession = false;
                    _message = Culture["Apply.AlreadyApplied"];
                    await LoadDirectContactAsync();
                }
                else if (!_enteredVerifyThisSession)
                {
                    _awaitingVerification = false;
                }
            }
        }

        _liked = await likedTask;
    }

    private async Task LoadDirectContactAsync()
    {
        try
        {
            var contact = await Api.GetDirectContactForVacancyAsync(Id);
            if (contact is { Available: true }
                && (contact.OfferMail || contact.OfferPhone || contact.OfferWhatsApp))
            {
                _directContact = contact;
            }
            else
            {
                _directContact = null;
            }
        }
        catch
        {
            _directContact = null;
        }
    }

    private async Task<MeProfile?> SafeProfileAsync()
    {
        try
        {
            return await Api.GetMyProfileAsync();
        }
        catch
        {
            return null;
        }
    }

    private async Task<IReadOnlyList<ApplicationItem>?> SafeApplicationsAsync()
    {
        try
        {
            return await Api.GetMyApplicationsAsync();
        }
        catch
        {
            return null;
        }
    }

    private async Task<bool> SafeLikedAsync()
    {
        try
        {
            return await Api.GetLikedAsync(Id);
        }
        catch
        {
            return false;
        }
    }

    private async Task SaveDobAsync()
    {
        if (_dobInput is null)
        {
            _message = Culture["Apply.PickDob"];
            return;
        }

        _savingDob = true;
        try
        {
            await Api.UpdateDateOfBirthAsync(_dobInput.Value);
            await LoadAsync(origin: null);
            // Refresh with origin if available
            try
            {
                var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                {
                    await LoadAsync(new OriginPoint { Latitude = lat, Longitude = lng });
                }
            }
            catch
            {
                // ignore
            }

            _message = Culture["Apply.DobSaved"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _savingDob = false;
        }
    }

    private async Task OnTransportChanged(ChangeEventArgs e)
    {
        _transport = NormalizeTransport(e.Value?.ToString());
        _transportTouched = true;
        await RefreshTravelAsync();
    }

    private static bool IsKnownTransport(string? value)
        => value?.Trim() is "Fiets" or "Auto" or "OV" or "Lopend";

    private static string NormalizeTransport(string? value)
        => value?.Trim() switch
        {
            "Auto" => "Auto",
            "OV" => "OV",
            "Lopend" => "Lopend",
            _ => "Fiets"
        };

    private async Task<OriginPoint?> TryGetStoredOriginAsync()
    {
        try
        {
            var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
            if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng)
                && double.IsFinite(lat) && double.IsFinite(lng)
                && !(lat == 0 && lng == 0))
            {
                return new OriginPoint { Latitude = lat, Longitude = lng };
            }
        }
        catch
        {
            // optional
        }

        return null;
    }

    private async Task RefreshTravelAsync()
    {
        if (_vacancy is null || !HasLocation)
        {
            return;
        }

        _travelLoading = true;
        try
        {
            var origin = await TryGetStoredOriginAsync();
            _hasOrigin = origin is not null;
            if (origin is null)
            {
                _vacancy.TravelMinutes = null;
                _vacancy.DistanceKm = null;
                return;
            }

            var travel = await Api.GetVacancyTravelAsync(
                Id,
                origin.Latitude,
                origin.Longitude,
                _transport);
            _vacancy.TravelMinutes = travel?.TravelMinutes;
            _vacancy.DistanceKm = travel?.DistanceKm;
        }
        catch
        {
            _vacancy.TravelMinutes = null;
            _vacancy.DistanceKm = null;
        }
        finally
        {
            _travelLoading = false;
        }
    }

    private async Task OpenRouteAsync()
    {
        if (!HasLocation)
        {
            return;
        }

        _openingRoute = true;
        try
        {
            double? originLat = null;
            double? originLng = null;

            try
            {
                var dict = await Js.InvokeAsync<Dictionary<string, double>?>("jobsyGeo.getStoredOrigin");
                if (dict is not null && dict.TryGetValue("lat", out var lat) && dict.TryGetValue("lng", out var lng))
                {
                    originLat = lat;
                    originLng = lng;
                }
            }
            catch
            {
                // ignore
            }

            if (originLat is null || originLng is null)
            {
                try
                {
                    var pos = await Js.InvokeAsync<Dictionary<string, double>>("jobsyGeo.requestLocation");
                    if (pos.TryGetValue("lat", out var lat) && pos.TryGetValue("lng", out var lng))
                    {
                        originLat = lat;
                        originLng = lng;
                        await LoadAsync(new OriginPoint { Latitude = lat, Longitude = lng });
                    }
                }
                catch
                {
                    // Open destination-only directions if location is denied
                }
            }

            await Js.InvokeVoidAsync("vacancyDetailMap.openRoute", new
            {
                destLat = _vacancy!.Latitude,
                destLng = _vacancy.Longitude,
                originLat,
                originLng,
                transport = _transport
            });
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _openingRoute = false;
        }
    }

    private async Task OpenStreetViewAsync()
    {
        if (!HasLocation)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("vacancyDetailMap.openStreetView", new
            {
                lat = _vacancy!.Latitude,
                lng = _vacancy.Longitude
            });
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task ApplyAsync()
    {
        if (_vacancy is null || _applied)
        {
            return;
        }

        // Resend from the verify panel: terms/profile already satisfied this session.
        var isResend = _awaitingVerification && _enteredVerifyThisSession;
        if (!isResend)
        {
            if (!_acceptedTerms)
            {
                _message = Culture["Apply.MustAcceptTerms"];
                return;
            }
            if (!_workPermitConfirmed)
            {
                _message = Culture["Apply.MustConfirmWorkPermit"];
                return;
            }
            if (!_profileReadyForApply)
            {
                _message = Culture["Apply.CompleteProfileFirst"];
                return;
            }
        }

        _applying = true;
        try
        {
            var minutes = _vacancy.TravelMinutes ?? 15;
            var wasAwaitingVerification = _awaitingVerification;
            var result = await Api.ApplyAsync(
                _vacancy.Id,
                _transport,
                minutes,
                _useAuthenticator,
                acceptedTerms: true,
                workPermitConfirmed: true,
                motivation: string.IsNullOrWhiteSpace(_motivation) ? null : _motivation.Trim(),
                confirmLowMatchSafetyNet: _confirmSafetyNet,
                studentNumber: RequiresExclusivityExtras ? _studentNumber.Trim() : null,
                schoolEmail: RequiresExclusivityExtras ? _schoolEmail.Trim() : null,
                studyProgram: RequiresExclusivityExtras ? _studyProgram.Trim() : null,
                studyYear: RequiresExclusivityExtras && !string.IsNullOrWhiteSpace(_studyYear) ? _studyYear.Trim() : null);
            if (result?.RequiresSafetyNetConfirmation == true)
            {
                _showSafetyNet = true;
                _safetyNetPercent = result.MatchPercent;
                _safetyNetMessage = result.SafetyNetMessage;
                _message = result.SafetyNetMessage;
                return;
            }

            _showSafetyNet = false;
            _confirmSafetyNet = false;
            if (result?.RequiresVerification == true)
            {
                _awaitingVerification = true;
                _enteredVerifyThisSession = true;
                _message = wasAwaitingVerification
                    ? Culture["Apply.CodeResent"]
                    : Culture["Apply.CodeSent"];
            }
            else
            {
                _applied = true;
                _awaitingVerification = false;
                _enteredVerifyThisSession = false;
                _message = _useAuthenticator
                    ? Culture["Apply.CodeSentAuthenticator"]
                    : Culture["Apply.SentStub"];
                OpenDirectContactIfAvailable(result?.DirectContact);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task ContinueWithSafetyNetAsync()
    {
        _confirmSafetyNet = true;
        _showSafetyNet = false;
        await ApplyAsync();
    }

    private async Task VerifyApplicationAsync()
    {
        if (_vacancy is null || !_awaitingVerification)
        {
            return;
        }

        _applying = true;
        try
        {
            var minutes = _vacancy.TravelMinutes ?? 15;
            var result = await Api.ApplyAsync(
                _vacancy.Id,
                _transport,
                minutes,
                _useAuthenticator,
                acceptedTerms: true,
                workPermitConfirmed: true,
                verificationCode: _verificationCode.Trim(),
                motivation: string.IsNullOrWhiteSpace(_motivation) ? null : _motivation.Trim(),
                studentNumber: RequiresExclusivityExtras ? _studentNumber.Trim() : null,
                schoolEmail: RequiresExclusivityExtras ? _schoolEmail.Trim() : null,
                studyProgram: RequiresExclusivityExtras ? _studyProgram.Trim() : null,
                studyYear: RequiresExclusivityExtras && !string.IsNullOrWhiteSpace(_studyYear) ? _studyYear.Trim() : null);

            _applied = result?.RequiresVerification != true;
            _awaitingVerification = result?.RequiresVerification == true;
            if (_applied)
            {
                _verificationCode = string.Empty;
                _enteredVerifyThisSession = false;
                _message = Culture["Apply.Verified"];
                OpenDirectContactIfAvailable(result?.DirectContact);
            }
            else
            {
                _message = Culture["Apply.CodeRejected"];
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task ToggleLikeAsync()
    {
        _liking = true;
        try
        {
            _liked = await Api.SetLikedAsync(Id, !_liked);
