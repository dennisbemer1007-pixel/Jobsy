@page "/login"
@attribute [AllowAnonymous]
@using Jobsy.Web.Auth
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@inject IOptions<AuthOptions> AuthOptions
@inject IAntiforgery Antiforgery
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Inloggen · Lobsy</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <img class="login-brand__logo" src="images/brand/lobsy.png" alt="Lobsy" width="64" height="64" />
            <span class="login-brand__name">Lobsy</span>
        </div>
        <h1>Inloggen</h1>
        <p class="login-lead">Kies Microsoft Entra, Google of je Lobsy-account.</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="login-error">@_errorMessage</p>
        }

        <div class="login-providers">
            @if (_entraEnabled)
            {
                <a class="provider-btn provider-btn--entra"
                   href="@($"/account/external/entra?returnUrl={Uri.EscapeDataString(_returnUrl)}")">
                    <span class="provider-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 23 23" width="18" height="18"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
                    </span>
                    Microsoft Entra
                </a>
            }
            else
            {
                <button type="button" class="provider-btn provider-btn--entra is-disabled" disabled
                        title="Vul Entra ClientId/Secret in appsettings.json">
                    <span class="provider-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 23 23" width="18" height="18"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
                    </span>
                    Microsoft Entra
                </button>
            }

            @if (_googleEnabled)
            {
                <a class="provider-btn provider-btn--google"
                   href="@($"/account/external/google?returnUrl={Uri.EscapeDataString(_returnUrl)}")">
                    <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">G</span>
                    Google
                </a>
            }
            else
            {
                <button type="button" class="provider-btn provider-btn--google is-disabled" disabled
                        title="Vul Google ClientId/Secret in appsettings.json">
                    <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">G</span>
                    Google
                </button>
            }
        </div>

        <div class="login-divider"><span>of met e-mail</span></div>

        <form method="post" action="/account/login" class="login-form">
            <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>
                E-mail
                <input type="email" name="email" required autocomplete="username" placeholder="kandidaat@jobsy.local" />
            </label>
            <label>
                Wachtwoord
                <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
            </label>
            <button type="submit" class="login-submit">Inloggen</button>
        </form>

        <p class="muted" style="margin-top:1rem;text-align:center">
            Nieuw bedrijf? <a class="auth-link" href="/register">Registreer via KVK</a>
        </p>

        <details class="login-demo" open>
            <summary>Demo-accounts — klik om in te loggen</summary>
            <div class="login-demo__list">
                @foreach (var user in _demoUsers)
                {
                    <form method="post" action="/account/login" class="login-demo__form">
                        <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                        <input type="hidden" name="returnUrl" value="@_returnUrl" />
                        <input type="hidden" name="email" value="@user.Email" />
                        <input type="hidden" name="password" value="@user.Password" />
                        <button type="submit" class="login-demo__btn">
                            <span class="login-demo__role">@RoleLabel(user.Role)</span>
                            <span class="login-demo__email">@user.Email</span>
                        </button>
                    </form>
                }
            </div>
            <p class="login-demo__hint">Tijdelijk voor lokale demo — één klik, geen typen.</p>
        </details>
    </div>
</div>

@code {
    private string _returnUrl = "/home";
    private string? _errorMessage;
    private bool _entraEnabled;
    private bool _googleEnabled;
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private IReadOnlyList<DemoUserOptions> _demoUsers = [];

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? string.Empty;
        }

        var auth = AuthOptions.Value;
        _entraEnabled = auth.Entra.IsConfigured;
        _googleEnabled = auth.Google.IsConfigured;
        _demoUsers = auth.DemoUsers;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var returnUrl) && !string.IsNullOrWhiteSpace(returnUrl))
        {
            _returnUrl = AuthRedirects.SafeLocalUrl(AuthRedirects.PostLoginUrl(returnUrl.ToString()));
        }

        if (query.TryGetValue("error", out var error))
        {
            _errorMessage = error.ToString() switch
            {
                "invalid" => "Ongeldige e-mail of wachtwoord.",
                "entra-not-configured" => "Microsoft Entra is nog niet geconfigureerd. Vul ClientId en ClientSecret in appsettings.json.",
                "google-not-configured" => "Google is nog niet geconfigureerd. Vul ClientId en ClientSecret in appsettings.json.",
                "unknown-provider" => "Onbekende loginprovider.",
                _ => "Inloggen mislukt. Probeer het opnieuw."
            };
        }
    }

    private static string RoleLabel(string role) => role switch
    {
        "Candidate" => "Kandidaat",
        "BranchManager" => "Filiaalmanager",
        "RegionalManager" => "Regiomanager",
        "EnterpriseManager" => "Bedrijfsmanager",
        "Intermediary" => "Intermediair",
        "Admin" => "Admin",
        _ => role
    };
}
