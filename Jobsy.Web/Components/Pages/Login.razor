@page "/login"
@attribute [AllowAnonymous]
@using Jobsy.Core.Features
@using Jobsy.Web.Auth
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject IExternalAuthCredentialSource ExternalAuth
@inject IAntiforgery Antiforgery
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IEmployersSwitch Employers
@inject CultureState Culture
@inject IJSRuntime Js
@inject IFeatureFlags FeatureFlags
@implements IDisposable

<PageTitle>@Culture["Login.Title"] · Lobsy</PageTitle>

<div class="login-modal login-modal--compact" role="dialog" aria-modal="true" aria-labelledby="login-title">
    <a class="login-modal__backdrop"
       href="@_dismissUrl"
       tabindex="-1"
       aria-label="@Culture["Login.Close"]"></a>

    <div class="login-modal__dialog login-card">
        <div class="login-modal__header">
            <h1 id="login-title">@Culture["Login.Title"]</h1>
            <a class="login-modal__close"
               href="@_dismissUrl"
               aria-label="@Culture["Login.Close"]"
               title="@Culture["Login.Close"]">×</a>
        </div>

        <p class="login-lead">@Culture["Login.Lead"]</p>

        <GratisDnaRegisterBox />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="login-error" role="@(_sessionExpiredNotice || _pauseNotice ? "status" : "alert")">@_errorMessage</p>
            @if (_pauseNotice)
            {
                <p class="login-lead">@Culture["Login.ErrorLockedProviders"]</p>
                <p class="muted">@((MarkupString)_supportHelpHtml)</p>
            }
        }

        <div class="login-providers">
            @if (_entraEnabled)
            {
                <a class="provider-btn provider-btn--entra"
                   href="@($"/account/external/entra?returnUrl={Uri.EscapeDataString(_returnUrl)}")">
                    <span class="provider-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 23 23" width="16" height="16"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
                    </span>
                    @Culture["Login.Microsoft"]
                </a>
            }
            else
            {
                <button type="button" class="provider-btn provider-btn--entra is-disabled" disabled
                        title="@Culture["Login.EntraNotConfigured"]">
                    <span class="provider-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 23 23" width="16" height="16"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
                    </span>
                    @Culture["Login.Microsoft"]
                </button>
            }

            @if (_googleEnabled)
            {
                <a class="provider-btn provider-btn--google"
                   href="@($"/account/external/google?returnUrl={Uri.EscapeDataString(_returnUrl)}")">
                    <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">
                        <svg viewBox="0 0 48 48" width="16" height="16">
                            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.5-.4-3.5z"/>
                            <path fill="#FF3D00" d="M6.3 14.7 12.9 19.6C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/>
                            <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8h-6.6v5.1C9.5 39.6 16.2 44 24 44z"/>
                            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l.1-.1 6.3 5.2C39.2 40.3 44 34.7 44 24c0-1.3-.1-2.5-.4-3.5z"/>
                        </svg>
                    </span>
                    @Culture["Login.Google"]
                </a>
            }
            else
            {
                <button type="button" class="provider-btn provider-btn--google is-disabled" disabled
                        title="@Culture["Login.GoogleNotConfigured"]">
                    <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">
                        <svg viewBox="0 0 48 48" width="16" height="16">
                            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.5-.4-3.5z"/>
                            <path fill="#FF3D00" d="M6.3 14.7 12.9 19.6C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/>
                            <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8h-6.6v5.1C9.5 39.6 16.2 44 24 44z"/>
                            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l.1-.1 6.3 5.2C39.2 40.3 44 34.7 44 24c0-1.3-.1-2.5-.4-3.5z"/>
                        </svg>
                    </span>
                    @Culture["Login.Google"]
                </button>
            }
        </div>

        <div class="login-divider"><span>@Culture["Login.OrEmail"]</span></div>

        <form method="post" action="/account/login" class="login-form" data-enhance="false">
            <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>
                @Culture["Login.Email"]
                <input type="text"
                       name="email"
                       class="w-full px-4 py-3"
                       required
                       autocomplete="username"
                       inputmode="email"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       placeholder="naam@voorbeeld.nl" />
            </label>
            <label>
                @Culture["Login.Password"]
                <input type="password" name="password" class="w-full px-4 py-3" required autocomplete="current-password" placeholder="••••••••" />
            </label>
            <label class="login-remember">
                <input type="checkbox" name="rememberDevice" value="true" />
                <span>@Culture["Login.RememberDevice"]</span>
                <span class="muted login-remember__hint">@Culture["Login.RememberDeviceHint"]</span>
            </label>
            <button type="submit" class="login-submit" disabled="@(string.IsNullOrEmpty(_antiforgeryToken))">@Culture["Login.Submit"]</button>
            @if (string.IsNullOrEmpty(_antiforgeryToken))
            {
                <p class="login-error">@Culture["Login.ErrorRetry"]</p>
            }
        </form>

        <div class="login-register">
            <p class="login-register__lead login-register__lead--primary">
                @Culture["Login.CreateAccountLead"]
                <a class="login-register__cta" href="@CreateAccountHref">@Culture["Login.CreateAccountCta"]</a>
            </p>
            @if (_employersOn)
            {
                <p class="login-register__lead">
                    @Culture["Login.RegisterLead"]
                    <a class="login-register__cta" href="/register">@Culture["Login.RegisterCta"]</a>
                </p>
            }
            <a class="login-register__back" href="@_dismissUrl">@Culture["Login.BackToMap"]</a>
            <p class="login-register__lead gd-quiet-link-wrap">
                @Culture["GratisDna.QuietLink.Lead"]
                <a class="auth-link" href="/ontdek">@Culture["GratisDna.QuietLink.Cta"]</a>
            </p>
        </div>
    </div>
</div>

@code {
    private string _returnUrl = "/home";
    private string _dismissUrl = AuthRedirects.BanenkaartPath;
    private string? _errorMessage;
    private bool _sessionExpiredNotice;
    private bool _pauseNotice;
    private string _supportHelpHtml = string.Empty;
    private bool _entraEnabled;
    private bool _googleEnabled;
    private bool _employersOn = true;
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;

    private string CreateAccountHref
        => $"{PublicRoutes.CreateAccount}?returnUrl={Uri.EscapeDataString(_returnUrl)}";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;

        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? string.Empty;
        }

        _entraEnabled = await ExternalAuth.IsEntraConfiguredAsync();
        _googleEnabled = await ExternalAuth.IsGoogleConfiguredAsync();
        _employersOn = await Employers.IsEnabledAsync();

        var flags = await FeatureFlags.GetAsync();
        _employersOn = flags.EmployersEnabled;
        _dismissUrl = flags.EmployersEnabled
            ? AuthRedirects.BanenkaartPath
            : FeatureRoutes.OntdekPath;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _returnUrl = AuthRedirects.ResolveRequestedReturnUrl(
            QueryValue(query, "returnUrl"),
            QueryValue(query, "returnTo"),
            QueryValue(query, "redirect"));

        // Closing the dialog returns to banenkaart (ON) or ontdek (OFF).
        // (_dismissUrl already set from flags above)

        var errorCode = query.TryGetValue("error", out var error) ? error.ToString() : null;
        var sessionExpired = string.Equals(errorCode, "session-expired", StringComparison.OrdinalIgnoreCase);
        var setupDone = query.TryGetValue("setup", out var setup) &&
                        string.Equals(setup.ToString(), "done", StringComparison.OrdinalIgnoreCase);

        // Do not bounce authenticated users away when session-expired is set — a sticky
        // Jobsy.Auth cookie with a cleared LastActivity used to cause /home↔/login loops.
        if (http?.User.Identity?.IsAuthenticated == true && !sessionExpired)
        {
            Navigation.NavigateTo(_returnUrl, forceLoad: true);
            return;
        }

        if (setupDone)
        {
            _errorMessage = Culture["SetPassword.Done"];
        }
        else if (!string.IsNullOrEmpty(errorCode))
        {
            _sessionExpiredNotice = sessionExpired;
            var untilRaw = QueryValue(query, "until");
            var config = http?.RequestServices.GetService<IConfiguration>();
            var support = config?["Support:Email"]
                ?? config?["Mail:SupportAddress"]
                ?? "support@lobsy.nl";
            _supportHelpHtml = string.Format(
                System.Globalization.CultureInfo.InvariantCulture,
                Culture["Login.ErrorLockedSupport"],
                $"<a href=\"mailto:{support}\">{support}</a>");

            _errorMessage = errorCode switch
            {
                "invalid" => Culture["Login.ErrorInvalid"],
                "locked" => FormatPause(Culture["Login.ErrorLocked"], untilRaw),
                "too-many" => FormatPause(Culture["Login.ErrorTooMany"], untilRaw),
                "unavailable" => Culture["Login.ErrorUnavailable"],
                "retry" => Culture["Login.ErrorRetry"],
                "session-expired" => Culture["Login.ErrorSessionExpired"],
                "entra-not-configured" => Culture["Login.ErrorEntra"],
                "entra-failed" => Culture["Login.ErrorEntraFailed"],
                "google-not-configured" => Culture["Login.ErrorGoogle"],
                "google-failed" => Culture["Login.ErrorGoogleFailed"],
                "unknown-provider" => Culture["Login.ErrorProvider"],
                _ => Culture["Login.ErrorGeneric"]
            };
            _pauseNotice = errorCode is "locked";
        }

        // Ambassadeur referral cookie (?ref=AM-…) is parked while AmbassadorsEnabled is off (01.10).
        // Re-enable with a features check when the Ambassadeur stack returns.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_sessionExpiredNotice)
        {
            return;
        }

        try
        {
            // Shared-browser hygiene: drop any prior draft blobs after forced expiry.
            await JobsyJs.EnsureExtrasAsync(Js);
            await Js.InvokeVoidAsync("lobsySessionIdle.clearDrafts");
        }
        catch
        {
            // Script may not be ready on static render.
        }
    }

    private static string? QueryValue(
        Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query,
        string key)
        => query.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value.ToString()
            : null;

    private string FormatPause(string template, string? untilUnix)
    {
        if (long.TryParse(untilUnix, out var unix))
        {
            var utc = DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
            if (utc > DateTime.UtcNow)
            {
                var local = Jobsy.Core.Time.AmsterdamTime.ToLocal(utc);
                return string.Format(template, local.ToString("HH:mm"));
            }
        }

        return Culture["Login.ErrorLockedFallback"];
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
