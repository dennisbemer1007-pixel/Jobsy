@using Jobsy.Core.Privacy
@using Jobsy.Web.Auth
@using Jobsy.Web.Components.Auth
@using Jobsy.Web.Components.Media
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture

<div class="cp-plain-wrap cp-plain-login-wrap">
    <section class="cp-plain-login-section" aria-labelledby="signup-title">
        <div class="cp-plain-card">
            <nav class="cp-plain-tabs" aria-label="@Culture["PlainPublic.Login.TabSignup"]">
                <a href="@LoginHref">@Culture["PlainPublic.Login.TabLogin"]</a>
                <span class="cp-plain-tabs__active">@Culture["PlainPublic.Login.TabSignup"]</span>
            </nav>

            <h1 id="signup-title">@Culture["PlainPublic.Signup.Title"]</h1>
            <p class="cp-plain-lead">@Culture["PlainPublic.Signup.Lead"]</p>

            @if (FromTest)
            {
                <GratisDnaRegisterBox ForceVisible="true" ForceAnswerCount="20" />
            }

            @if (FromUnder16)
            {
                <p class="cp-plain-note" role="note">@Culture.Format(
                    "Signup.Under16",
                    CandidateConsentRules.MinimumCandidateAge,
                    CandidateConsentRules.ParentalConsentAge)</p>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="cp-plain-alert" role="alert">@ErrorMessage</p>
            }

            @if (ShowProviders)
            {
                <div class="au-stack cp-plain-providers">
                    @if (GoogleEnabled)
                    {
                        <ExternalProviderLink Class="au-provider cp-plain-provider"
                                              Href="@($"/account/external/google?returnUrl={Uri.EscapeDataString(ReturnUrl)}")"
                                              data-kpi="SignupStart"
                                              data-kpi-target="google">
                            <span class="au-provider__icon" aria-hidden="true">
                                <svg viewBox="0 0 48 48" width="20" height="20">
                                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.5-.4-3.5z"/>
                                    <path fill="#FF3D00" d="M6.3 14.7 12.9 19.6C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/>
                                    <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8h-6.6v5.1C9.5 39.6 16.2 44 24 44z"/>
                                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l.1-.1 6.3 5.2C39.2 40.3 44 34.7 44 24c0-1.3-.1-2.5-.4-3.5z"/>
                                </svg>
                            </span>
                            @Culture["Signup.Google"]
                        </ExternalProviderLink>
                    }
                    @if (EntraEnabled)
                    {
                        <ExternalProviderLink Class="au-provider cp-plain-provider"
                                              Href="@($"/account/external/entra?returnUrl={Uri.EscapeDataString(ReturnUrl)}")"
                                              data-kpi="SignupStart"
                                              data-kpi-target="microsoft">
                            <span class="au-provider__icon" aria-hidden="true">
                                <svg viewBox="0 0 23 23" width="20" height="20"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
                            </span>
                            @Culture["Signup.Microsoft"]
                        </ExternalProviderLink>
                    }
                </div>
                <div class="au-divider cp-plain-divider"><span>@Culture["Login.OrEmail"]</span></div>
            }

            <form method="post" action="/account/email-code/start" class="au-form" data-enhance="false" data-kpi="SignupStart" data-kpi-target="email">
                <input type="hidden" name="@AntiforgeryFieldName" value="@AntiforgeryToken" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                @if (!string.IsNullOrEmpty(Van))
                {
                    <input type="hidden" name="van" value="@Van" />
                }

                <div class="au-field">
                    <label class="au-field__label" for="signup-email">@Culture["Signup.Email"]</label>
                    <div class="au-input-wrap">
                        <input id="signup-email"
                               class="au-input"
                               type="email"
                               name="email"
                               required
                               autocomplete="email"
                               inputmode="email"
                               autocapitalize="none"
                               autocorrect="off"
                               spellcheck="false"
                               maxlength="320"
                               placeholder="naam@voorbeeld.nl" />
                    </div>
                </div>

                <div class="au-field">
                    <label class="au-field__label" for="signup-firstname">
                        @Culture["Signup.FirstName"]
                        <span class="cp-plain-optional">(@Culture["Signup.FirstNameOptional"])</span>
                    </label>
                    <div class="au-input-wrap">
                        <input id="signup-firstname"
                               class="au-input"
                               type="text"
                               name="firstName"
                               autocomplete="given-name"
                               maxlength="60" />
                    </div>
                </div>

                <button type="submit" class="au-submit" disabled="@(string.IsNullOrEmpty(AntiforgeryToken))">
                    @Culture["Signup.SendCode"]
                </button>
            </form>

            <p class="cp-plain-note cp-plain-consent">
                @((MarkupString)string.Format(
                    System.Globalization.CultureInfo.InvariantCulture,
                    Culture["Signup.Consent"],
                    $"<a href=\"{PublicRoutes.UsageTerms}\">{Culture["Signup.ConsentTerms"]}</a>",
                    $"<a href=\"{PublicRoutes.Privacy}\">{Culture["Signup.ConsentPrivacy"]}</a>"))
            </p>

            <div class="cp-plain-inline-links">
                <p>
                    @Culture["Signup.HaveAccount"]
                    <a href="@LoginHref">@Culture["Signup.Login"]</a>
                </p>
                @if (EmployersOn)
                {
                    <p>
                        @Culture["Signup.EmployerLead"]
                        <a href="@PublicRoutes.CompanyRegister">@Culture["Signup.EmployerCta"]</a>
                    </p>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string ReturnUrl { get; set; } = AuthRedirects.BanenkaartPath;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public string? Van { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool FromUnder16 { get; set; }
    [Parameter] public bool FromTest { get; set; }
    [Parameter] public bool EntraEnabled { get; set; }
    [Parameter] public bool GoogleEnabled { get; set; }
    [Parameter] public bool EmployersOn { get; set; } = true;
    [Parameter, EditorRequired] public string AntiforgeryFieldName { get; set; } = "";
    [Parameter, EditorRequired] public string AntiforgeryToken { get; set; } = "";

    private bool ShowProviders => EntraEnabled || GoogleEnabled;
}
