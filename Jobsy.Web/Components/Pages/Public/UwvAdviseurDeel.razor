@page "/deel/uwv-adviseur/{Token}"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net.Http.Json
@using Jobsy.Core.Uwv
@using Jobsy.Web.Components.Layout.Public
@using Jobsy.Web.Components.UwvMockups
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Jobsy.Web.UwvMockups
@inject CultureState Culture
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime Js

<PageTitle>@(UwvMockupCopy.IsEnglish(Culture.Language) ? "Summary for adviser" : "Samenvatting voor adviseur") · Lobsy</PageTitle>

<section class="pub-section uwv-adviseur-deel-page" aria-labelledby="uwv-deel-title">
    <div class="pub-card uwv-adviseur-deel-card">
        <PublicLangMenu ReturnPath="@ReturnPath" />
        @if (_problem is not null)
        {
            <h1 id="uwv-deel-title">@(UwvMockupCopy.IsEnglish(Culture.Language) ? "Link expired" : "Link verlopen")</h1>
            <p role="alert">@_problem</p>
        }
        else if (_view is null)
        {
            <p role="status">@Culture["Common.Loading"]</p>
        }
        else
        {
            <div class="uwv-adviseur-deel__actions no-print">
                <button type="button" class="btn btn-primary" @onclick="PrintAsync">
                    @UwvMockupCopy.Adviseur.Print(_view.Language)
                </button>
            </div>
            <UwvAdviseurShareDocument Lang="@_view.Language"
                                      CandidateDisplayName="@_view.CandidateDisplayName"
                                      Sections="@_view.Sections"
                                      OndernemerOutcomeKey="@_view.OndernemerOutcomeKey"
                                      DrijfverenDriverKeys="@_view.DrijfverenDriverKeys"
                                      EndorsedCompetences="@_view.EndorsedCompetences" />
        }
    </div>
</section>

@code {
    [Parameter] public string Token { get; set; } = "";

    private UwvAdviseurShareViewDto? _view;
    private string? _problem;

    private string ReturnPath => "/deel/uwv-adviseur/" + Token;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token) || Token.Length > 128)
        {
            _problem = Culture["Common.Error"];
            return;
        }

        try
        {
            var apiBase = (Configuration["ApiBaseUrl"] ?? Configuration["JobsyApi:BaseUrl"] ?? "http://localhost:5200").TrimEnd('/');
            var client = HttpClientFactory.CreateClient();
            _view = await client.GetFromJsonAsync<UwvAdviseurShareViewDto>(
                $"{apiBase}/api/uwv/adviseur-share/{Uri.EscapeDataString(Token)}");
            if (_view is null)
            {
                _problem = UwvMockupCopy.IsEnglish(Culture.Language)
                    ? "This share link is invalid or has expired."
                    : "Deze deellink is ongeldig of verlopen.";
            }
        }
        catch
        {
            _problem = Culture["Common.Error"];
        }
    }

    private Task PrintAsync() => Js.InvokeVoidAsync("print").AsTask();
}
