@page "/ontdek"
@page "/dna"
@layout PublicLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Security.Claims
@using Jobsy.Core.Privacy
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Feedback
@using Jobsy.Web.Components.Public
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@inject GratisDnaStorage Storage
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@Culture["GratisDna.Seo.Title"] · Lobsy</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/features/gratis-dna.css?v=20260930-landing-6" />
    <script>
        window.jobsyEnsureGratisDna = function () {
            if (window.jobsyGratisDna) {
                return Promise.resolve();
            }
            return new Promise(function (resolve, reject) {
                var existing = document.querySelector('script[data-gratis-dna]');
                if (existing) {
                    existing.addEventListener('load', function () { resolve(); });
                    existing.addEventListener('error', reject);
                    return;
                }
                var s = document.createElement('script');
                s.src = '/js/gratis-dna.js?v=20260930-landing-6';
                s.defer = true;
                s.dataset.gratisDna = 'true';
                s.onload = function () { resolve(); };
                s.onerror = reject;
                document.head.appendChild(s);
            });
        };
    </script>
</HeadContent>

<div class="gd-page gd-page--warm" dir="@(Culture.IsRightToLeft ? "rtl" : null)" data-gd-page>
    <div class="gd-page__inner">
        @if (_hydrating)
        {
            <p class="visually-hidden">@Culture["Common.Loading"]</p>
        }
        else if (_state == FlowState.Under16)
        {
            <GratisDnaUnder16View />
        }
        else if (_state == FlowState.Landing)
        {
            <div class="gd-start">
                <section class="gd-start__card" aria-labelledby="gd-landing-title" data-testid="gd-start">
                    <p class="gd-badge">
                        <PubEmoji Glyph="👋" />
                        @Culture["GratisDna.Landing.Badge"]
                    </p>
                    <h1 id="gd-landing-title">@Culture["GratisDna.Landing.Title"]</h1>
                    <p class="gd-hero__lead">@Culture["GratisDna.Landing.Lead"]</p>
                    @if (_showOwnLanguageHint)
                    {
                        <p class="gd-lang-hint">
                            <a href="#pub-lang" @onclick="OpenLangMenu" @onclick:preventDefault="false">
                                @Culture["GratisDna.Landing.OwnLanguage"]
                            </a>
                        </p>
                    }
                    <div class="gd-meta">
                        <span><PubEmoji Glyph="📝" /> @Culture.Format("GratisDna.Landing.MetaQuestions", _totalQuestions)</span>
                        <span><PubEmoji Glyph="⏱️" /> @Culture["GratisDna.Landing.MetaMinutes"]</span>
                        <span><PubEmoji Glyph="📱" /> @Culture["GratisDna.Landing.MetaDevice"]</span>
                    </div>
                    @if (_employerView)
                    {
                        <p class="gd-note">@Culture["GratisDna.Landing.EmployerNote"]</p>
                    }
                    <div class="gd-blocks">
                        @foreach (var block in _blocks)
                        {
                            <div class="gd-blk">
                                <span class="gd-blk__emo t-@block.Tint"><PubEmoji Glyph="@block.Emoji" /></span>
                                <div>
                                    <h2>@Culture[block.TitleKey]</h2>
                                    <p>@Culture[block.LeadKey]</p>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_needsConsentRenew)
                    {
                        <p class="gd-note">@Culture["GratisDna.Consent.Renew"]</p>
                    }
                    <label class="gd-consent gd-consent--check">
                        <input type="checkbox"
                               data-testid="gd-age16"
                               checked="@(_age16Plus == true)"
                               @onchange="OnAgeCheckbox" />
                        <span>@Culture["GratisDna.Landing.Age16"]</span>
                    </label>
                    @if (_age16Plus == true)
                    {
                        <label class="gd-consent gd-consent--check">
                            <input type="checkbox" data-testid="gd-consent" @bind="_consentChecked" />
                            <span>
                                @Culture["GratisDna.Landing.Consent"]
                                <a href="@PublicRoutes.Privacy">@Culture["GratisDna.Landing.PrivacyLink"]</a>
                            </span>
                        </label>
                    }
                    else
                    {
                        <p class="gd-under16-link">
                            <button type="button" class="gd-linkish" data-testid="gd-under16-choice" @onclick="() => ChooseAge(false)">
                                @Culture["GratisDna.Landing.AgeUnder16"]
                            </button>
                        </p>
                    }
                    @if (_resumeAvailable)
                    {
                        <button type="button" class="gd-cta gd-cta--ghost" @onclick="ResumeAsync">@Culture["GratisDna.Landing.Resume"]</button>
                    }
                    <div class="gd-start__actions">
                        <button type="button" class="gd-cta" disabled="@(!CanStart)" @onclick="StartAsync" data-testid="gd-start-cta">
                            @Culture["GratisDna.Landing.StartCta"] →
                        </button>
                        <p class="gd-start__login">
                            @Culture["Signup.HaveAccount"]
                            <a href="@PublicRoutes.Login">@Culture["Signup.Login"]</a>
                        </p>
                    </div>
                </section>

                <aside class="gd-side-scene" aria-hidden="true">
                    <div class="gd-bubble">@Culture["GratisDna.Landing.Bubble"]</div>
                    <div class="gd-side-scene__art">
                        <LobsyMascot Pose="MascotPose.Waving" Size="MascotSize.Large" Alt="" />
                    </div>
                    <div class="gd-after">
                        <h2><PubEmoji Glyph="🎁" /> @Culture["GratisDna.Landing.AfterTitle"]</h2>
                        <p>@Culture["GratisDna.Landing.AfterLead"]</p>
                    </div>
                </aside>
            </div>
        }
        else if (_state == FlowState.Questions && _payload is not null && CurrentQuestion is not null)
        {
            var q = CurrentQuestion;
            var blockIdx = CurrentTestIndex;
            var block = _blocks[blockIdx];
            var inBlock = (_currentIndex % 5) + 1;
            var answered = TryGetAnswer(q, out var currentValue);
            <div class="gd-questions gd-questions--warm"
                 data-testid="gd-questions"
                 tabindex="0"
                 @onkeydown="OnQuestionKeyDown"
                 @ref="_questionRoot">
                <div class="gd-qtop">
                    <button type="button" class="gd-qtop__nav" @onclick="BackAsync">← @Culture["GratisDna.Questions.Previous"]</button>
                    <p class="gd-qtop__progress" id="gd-q-progress">
                        @Culture.Format("GratisDna.Questions.ProgressCheer", _currentIndex + 1, _totalQuestions, EncourageFor(_currentIndex))
                    </p>
                    <a class="gd-qtop__nav" href="@PublicRoutes.Landing">@Culture["GratisDna.Questions.Later"]</a>
                </div>

                <div class="gd-prog" aria-hidden="true">
                    @for (var i = 0; i < _blocks.Length; i++)
                    {
                        var pct = BlockProgressPercent(i);
                        <div class="@(i == blockIdx ? "is-on" : null)">
                            <b style="--pct:@(pct)%"></b>
                            <span class="gd-prog__label"><PubEmoji Glyph="@_blocks[i].Emoji" /> @Culture[_blocks[i].TitleKey]</span>
                        </div>
                    }
                </div>

                <section class="gd-qcard" aria-labelledby="gd-q-heading">
                    <div class="gd-qcard__lab">
                        <span class="gd-blk__emo t-@block.Tint"><PubEmoji Glyph="@block.Emoji" /></span>
                        <div>
                            <strong>@Culture[block.TitleKey]</strong>
                            <div class="gd-qcard__sub">@Culture.Format("GratisDna.Questions.OfBlock", inBlock, 5)</div>
                        </div>
                    </div>
                    <h2 id="gd-q-heading" tabindex="-1">@QuestionText(q)</h2>
                    <div class="gd-lik" role="group" aria-labelledby="gd-q-heading">
                        @for (var value = 1; value <= 5; value++)
                        {
                            var v = value;
                            var face = Faces[v - 1];
                            var selected = answered && currentValue == v;
                            var aria = v == 1
                                ? Culture.Format("GratisDna.Likert.AriaLow", v)
                                : v == 5
                                    ? Culture.Format("GratisDna.Likert.AriaHigh", v)
                                    : Culture.Format("GratisDna.Likert.Aria", v);
                            <button type="button"
                                    class="gd-lik__opt @(selected ? "is-on" : null)"
                                    aria-pressed="@(selected ? "true" : "false")"
                                    aria-label="@aria"
                                    data-testid="@($"gd-likert-{v}")"
                                    @onclick="() => AnswerAsync(q, v)">
                                <span class="gd-lik__face" aria-hidden="true">@face</span>
                                <span class="gd-lik__num" aria-hidden="true">@v</span>
                            </button>
                        }
                    </div>
                    <div class="gd-lik__labels" aria-hidden="true">
                        <span>@Culture["Questionnaire.Likert.Low"]</span>
                        <span>@Culture["Questionnaire.Likert.High"]</span>
                    </div>
                    <div class="gd-tip">
                        <LobsyMascot Pose="MascotPose.Default" Size="MascotSize.Tiny" Alt="" />
                        <span>@Culture["GratisDna.Questions.Hint"]</span>
                    </div>
                </section>

                <div class="gd-mnav">
                    <button type="button" class="gd-cta gd-cta--ghost" @onclick="BackAsync">← @Culture["GratisDna.Questions.Previous"]</button>
                    <button type="button" class="gd-cta" disabled="@(!answered)" @onclick="NextQuestionAsync">@Culture["GratisDna.Questions.Next"] →</button>
                </div>

                <p class="gd-qfoot">
                    <PubEmoji Glyph="🔒" />
                    @Culture["GratisDna.Questions.Privacy"]
                </p>
            </div>
        }
        else if (_state == FlowState.Result && _payload is not null)
        {
            <GratisDnaResultView RegisterHref="@RegisterHref"
                                 StrengthSentence="@(_strengthTile is null ? null : TileSentence("Strength", _strengthTile.Code))"
                                 RiasecSentence="@(_riasecTile is null ? null : TileSentence("Riasec", _riasecTile.Code))"
                                 CultureSentence="@(_cultureTile is null ? null : TileSentence("Culture", _cultureTile.Code))"
                                 ValueSentence="@(_valueTile is null ? null : TileSentence("Value", _valueTile.Code))"
                                 StrengthLabel="@(_strengthTile?.Label)"
                                 RiasecLabel="@(_riasecTile?.Label)"
                                 CultureLabel="@(_cultureTile?.Label)"
                                 ValueLabel="@(_valueTile?.Label)"
                                 StrengthChips="@_strengthChips"
                                 RiasecChips="@_riasecChips"
                                 CultureChips="@_cultureChips"
                                 ValueChips="@_valueChips"
                                 ShareMessage="@_shareMessage"
                                 WipeConfirm="@_wipeConfirm"
                                 ShowSticky="@(!_stickyDismissed)"
                                 OnShare="ShareAsync"
                                 OnWipeRequest="() => _wipeConfirm = true"
                                 OnWipeConfirmed="WipeConfirmedAsync"
                                 OnWipeCancel="() => _wipeConfirm = false"
                                 OnStickyDismiss="() => _stickyDismissed = true" />
        }
    </div>
</div>

<FeedbackWidget />

@code {
    private enum FlowState { Landing, Questions, Result, Under16 }
    private enum TestKind { Competency, Career, Culture, Values }

    private sealed record DnaQuestion(TestKind Kind, int Id, string TextKey);
    private sealed record BlockDef(string Emoji, string Tint, string TitleKey, string LeadKey);

    private static readonly string[] Faces = ["😟", "😕", "😐", "🙂", "😄"];
    private static readonly string[] EncourageKeys =
    [
        "GratisDna.Questions.Cheer.0",
        "GratisDna.Questions.Cheer.1",
        "GratisDna.Questions.Cheer.2",
        "GratisDna.Questions.Cheer.3",
        "GratisDna.Questions.Cheer.4"
    ];

    private static readonly BlockDef[] _blocks =
    [
        new("🤝", "peach", "GratisDna.Tile.Title.Strength", "GratisDna.Landing.Block.Strength"),
        new("💛", "sun", "GratisDna.Tile.Title.Riasec", "GratisDna.Landing.Block.Riasec"),
        new("🏡", "mint", "GratisDna.Tile.Title.Culture", "GratisDna.Landing.Block.Culture"),
        new("🧭", "sky", "GratisDna.Tile.Title.Value", "GratisDna.Landing.Block.Value")
    ];

    private readonly List<DnaQuestion> _questions = BuildQuestions();
    private readonly int _totalQuestions = OnboardingWizardCatalog.TotalMiniQuestionCount;

    private FlowState _state = FlowState.Landing;
    private GratisDnaStoragePayload? _payload;
    private bool _hydrating = true;
    private bool _employerView;
    private bool _storageDisabled;
    private bool? _age16Plus;
    private bool _consentChecked;
    private bool _needsConsentRenew;
    private bool _resumeAvailable;
    private bool _showOwnLanguageHint;
    private int _currentIndex;
    private bool _wipeConfirm;
    private bool _stickyDismissed;
    private string? _shareMessage;
    private ElementReference _questionRoot;
    private bool _chromeBound;

    private OnboardingImpressionCoreItem? _strengthTile;
    private OnboardingImpressionCoreItem? _riasecTile;
    private OnboardingImpressionCoreItem? _cultureTile;
    private OnboardingImpressionCoreItem? _valueTile;
    private IReadOnlyList<string>? _strengthChips;
    private IReadOnlyList<string>? _riasecChips;
    private IReadOnlyList<string>? _cultureChips;
    private IReadOnlyList<string>? _valueChips;

    private string RegisterHref => PublicRoutes.CreateAccountFromTest;

    private bool CanStart => _age16Plus == true && _consentChecked && !_storageDisabled;

    private int AnsweredCount => _payload is null ? 0 : GratisDnaScoring.CountAnswers(_payload.Answers);

    private int CurrentTestIndex => CurrentQuestion?.Kind switch
    {
        TestKind.Competency => 0,
        TestKind.Career => 1,
        TestKind.Culture => 2,
        TestKind.Values => 3,
        _ => 0
    };

    private DnaQuestion? CurrentQuestion =>
        _currentIndex >= 0 && _currentIndex < _questions.Count ? _questions[_currentIndex] : null;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        TryReadVoorHint();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user.Identity?.IsAuthenticated == true && user.IsInRole("Candidate"))
            {
                Navigation.NavigateTo("/candidate/start", replace: true);
                return;
            }

            _employerView = user.Identity?.IsAuthenticated == true && !user.IsInRole("Candidate");
            _storageDisabled = _employerView;

            try
            {
                await Storage.EnsureModuleAsync();
                if (!_storageDisabled)
                {
                    _payload = await Storage.LoadAsync();
                }

                ApplyLoadedState();
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
            finally
            {
                _hydrating = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        if (_state == FlowState.Questions && !_chromeBound)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyEnsureGratisDna");
                await Js.InvokeVoidAsync("jobsyGratisDna.bindQuestionChrome");
                _chromeBound = true;
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (_state == FlowState.Questions)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyGratisDna.focusQuestionHeading");
            }
            catch
            {
                // ignore
            }
        }
    }

    private void TryReadVoorHint()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("voor", out var values))
            {
                _showOwnLanguageHint = string.Equals(values.FirstOrDefault(), "nieuw", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch
        {
            _showOwnLanguageHint = false;
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private void OnAgeCheckbox(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b
                 || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
                 || string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);
        if (on)
        {
            _age16Plus = true;
            return;
        }

        _age16Plus = null;
        _consentChecked = false;
    }

    private async Task OpenLangMenu()
    {
        try
        {
            await Js.InvokeVoidAsync("jobsyGratisDna.openLangMenu");
        }
        catch (JSException)
        {
        }
    }

    private void ApplyLoadedState()
    {
        if (_payload is null)
        {
            _resumeAvailable = false;
            _state = FlowState.Landing;
            return;
        }

        _resumeAvailable = AnsweredCount > 0 && AnsweredCount < _totalQuestions;
        _needsConsentRenew = !GratisDnaStorageValidator.StoredConsentMatchesCurrent(_payload);

        if (AnsweredCount >= _totalQuestions && !_needsConsentRenew)
        {
            BuildResultTiles();
            _state = FlowState.Result;
            _currentIndex = _totalQuestions - 1;
            return;
        }

        if (AnsweredCount > 0)
        {
            _currentIndex = FirstUnansweredIndex();
            _state = FlowState.Questions;
        }
    }

    private int FirstUnansweredIndex()
    {
        for (var i = 0; i < _questions.Count; i++)
        {
            if (!TryGetAnswer(_questions[i], out _))
            {
                return i;
            }
        }

        return Math.Max(0, _questions.Count - 1);
    }

    private void ChooseAge(bool is16Plus)
    {
        if (is16Plus)
        {
            _age16Plus = true;
            return;
        }

        _age16Plus = false;
        _state = FlowState.Under16;
    }

    private async Task StartAsync()
    {
        if (!CanStart)
        {
            return;
        }

        if (_payload is null && !_storageDisabled)
        {
            _payload = await Storage.CreateEmptyAsync(PrivacyConstants.CandidateProfilingConsentVersion);
        }

        if (_payload is not null && _needsConsentRenew)
        {
            var now = DateTime.UtcNow;
            _payload = ClonePayload(_payload, new GratisDnaStoredConsent
            {
                Version = PrivacyConstants.CandidateProfilingConsentVersion,
                AtUtc = now
            });
            _needsConsentRenew = false;
            await PersistAsync();
        }

        _currentIndex = FirstUnansweredIndex();
        _state = FlowState.Questions;
        _chromeBound = false;
    }

    private Task ResumeAsync()
    {
        _state = FlowState.Questions;
        _currentIndex = FirstUnansweredIndex();
        _chromeBound = false;
        return Task.CompletedTask;
    }

    private async Task AnswerAsync(DnaQuestion question, int value)
    {
        if (_payload is null || _storageDisabled)
        {
            return;
        }

        SetAnswer(question, value);
        await PersistAsync();

        if (AnsweredCount >= _totalQuestions)
        {
            BuildResultTiles();
            _state = FlowState.Result;
            return;
        }

        if (_currentIndex < _questions.Count - 1)
        {
            _currentIndex++;
        }
    }

    private async Task PersistAsync()
    {
        if (_payload is null || _storageDisabled)
        {
            return;
        }

        await Storage.SaveAsync(_payload);
    }

    private async Task BackAsync()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            return;
        }

        _state = FlowState.Landing;
        await Task.CompletedTask;
    }

    private Task NextQuestionAsync()
    {
        if (_currentIndex < _questions.Count - 1)
        {
            _currentIndex++;
        }
        else if (AnsweredCount >= _totalQuestions)
        {
            BuildResultTiles();
            _state = FlowState.Result;
        }

        return Task.CompletedTask;
    }

    private async Task OnQuestionKeyDown(KeyboardEventArgs e)
    {
        if (CurrentQuestion is null)
        {
            return;
        }

        if (e.Key is "1" or "2" or "3" or "4" or "5")
        {
            await AnswerAsync(CurrentQuestion, e.Key[0] - '0');
            return;
        }

        if (e.Key is "ArrowLeft" or "Left")
        {
            await BackAsync();
        }
    }

    private int BlockProgressPercent(int blockIndex)
    {
        var start = blockIndex * 5;
        var answeredInBlock = 0;
        for (var i = 0; i < 5 && start + i < _questions.Count; i++)
        {
            if (TryGetAnswer(_questions[start + i], out _))
            {
                answeredInBlock++;
            }
        }

        return answeredInBlock * 20;
    }

    private string EncourageFor(int questionIndex)
        => Culture[EncourageKeys[questionIndex % EncourageKeys.Length]];

    private void BuildResultTiles()
    {
        if (_payload is null)
        {
            return;
        }

        var core = GratisDnaScoring.Compose(_payload.Answers);
        _strengthTile = core.Strengths.FirstOrDefault();
        _riasecTile = core.RiasecTop.FirstOrDefault();
        _cultureTile = core.CultureHighlight;
        _valueTile = core.TopValue;
        _strengthChips = core.Strengths.Select(x => x.Label).Take(2).ToArray();
        _riasecChips = core.RiasecTop.Select(x => x.Label).Take(2).ToArray();
        _cultureChips = _cultureTile is null ? null : new[] { _cultureTile.Label };
        _valueChips = _valueTile is null ? null : new[] { _valueTile.Label };
    }

    private string TileSentence(string group, string code)
        => Culture[$"GratisDna.Tile.{group}.{code}"];

    private string QuestionText(DnaQuestion q) => Culture[q.TextKey];

    private bool TryGetAnswer(DnaQuestion q, out int value)
    {
        value = 0;
        if (_payload is null)
        {
            return false;
        }

        var map = q.Kind switch
        {
            TestKind.Competency => _payload.Answers.Competency,
            TestKind.Career => _payload.Answers.Career,
            TestKind.Culture => _payload.Answers.Culture,
            TestKind.Values => _payload.Answers.Values,
            _ => null
        };

        if (map is null || !map.TryGetValue(q.Id, out value))
        {
            return false;
        }

        return true;
    }

    private void SetAnswer(DnaQuestion q, int value)
    {
        if (_payload is null)
        {
            return;
        }

        var map = q.Kind switch
        {
            TestKind.Competency => _payload.Answers.Competency,
            TestKind.Career => _payload.Answers.Career,
            TestKind.Culture => _payload.Answers.Culture,
            TestKind.Values => _payload.Answers.Values,
            _ => null
        };
        if (map is not null)
        {
            map[q.Id] = value;
        }
    }

    private async Task ShareAsync(string channel)
    {
        _shareMessage = null;
        await Storage.EnsureModuleAsync();
        var model = new
        {
            title = Culture["GratisDna.Share.CardTitle"],
            badge = Culture["GratisDna.Result.Badge"],
            footerCta = Culture["GratisDna.Share.CardFooter"],
            shareText = Culture["GratisDna.Share.Text"],
            rtl = Culture.IsRightToLeft,
            tiles = new[]
            {
                new { title = Culture["GratisDna.Tile.Title.Strength"], sentence = _strengthTile is null ? "" : TileSentence("Strength", _strengthTile.Code) },
                new { title = Culture["GratisDna.Tile.Title.Riasec"], sentence = _riasecTile is null ? "" : TileSentence("Riasec", _riasecTile.Code) },
                new { title = Culture["GratisDna.Tile.Title.Culture"], sentence = _cultureTile is null ? "" : TileSentence("Culture", _cultureTile.Code) },
                new { title = Culture["GratisDna.Tile.Title.Value"], sentence = _valueTile is null ? "" : TileSentence("Value", _valueTile.Code) }
            }
        };

        try
        {
            var result = await Js.InvokeAsync<ShareResult>("jobsyGratisDna.share", model, channel);
            if (result?.Hint == "instagram")
            {
                _shareMessage = Culture["GratisDna.Share.InstagramHint"];
            }
            else if (result?.Copied == true)
            {
                _shareMessage = Culture["GratisDna.Share.Copied"];
            }
        }
        catch (JSException)
        {
        }
    }

    private async Task WipeConfirmedAsync()
    {
        if (!_storageDisabled)
        {
            await Storage.ClearAsync();
        }

        _payload = null;
        _wipeConfirm = false;
        _stickyDismissed = false;
        _state = FlowState.Landing;
        _age16Plus = null;
        _consentChecked = false;
        _resumeAvailable = false;
    }

    private static List<DnaQuestion> BuildQuestions()
    {
        var list = new List<DnaQuestion>();
        Add(list, TestKind.Competency, OnboardingWizardCatalog.CompetencyQuestionIds);
        Add(list, TestKind.Career, OnboardingWizardCatalog.CareerQuestionIds);
        Add(list, TestKind.Culture, OnboardingWizardCatalog.CultureQuestionIds);
        Add(list, TestKind.Values, OnboardingWizardCatalog.ValuesQuestionIds);
        return list;
    }

    private static void Add(List<DnaQuestion> target, TestKind kind, int[] ids)
    {
        foreach (var id in ids)
        {
            var textKey = kind switch
            {
                TestKind.Competency => CompetencyTestCatalog.Questions.First(q => q.Id == id).TextKey,
                TestKind.Career => CareerTestCatalog.Questions.First(q => q.Id == id).TextKey,
                TestKind.Culture => CulturePersonalityCatalog.Questions.First(q => q.Id == id).TextKey,
                TestKind.Values => SchwartzValuesCatalog.Questions.First(q => q.Id == id).TextKey,
                _ => ""
            };
            target.Add(new DnaQuestion(kind, id, textKey));
        }
    }

    private static GratisDnaStoragePayload ClonePayload(GratisDnaStoragePayload source, GratisDnaStoredConsent consent)
        => new()
        {
            V = source.V,
            CreatedAtUtc = source.CreatedAtUtc,
            ExpiresAtUtc = source.ExpiresAtUtc,
            AgeBand = source.AgeBand,
            Consent = consent,
            Answers = new GratisDnaStoredAnswers
            {
                Competency = new Dictionary<int, int>(source.Answers.Competency),
                Career = new Dictionary<int, int>(source.Answers.Career),
                Culture = new Dictionary<int, int>(source.Answers.Culture),
                Values = new Dictionary<int, int>(source.Answers.Values)
            }
        };

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        try
        {
            await Js.InvokeVoidAsync("jobsyGratisDna.unbindQuestionChrome");
        }
        catch
        {
            // ignore
        }
    }

    private sealed class ShareResult
    {
        public bool Ok { get; set; }
        public bool Copied { get; set; }
        public string? Hint { get; set; }
    }
