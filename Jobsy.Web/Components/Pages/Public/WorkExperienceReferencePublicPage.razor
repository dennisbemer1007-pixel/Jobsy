@page "/werk-referentie/{Token}"
@attribute [AllowAnonymous]
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Net.Http.Json
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Passport
@using Jobsy.Web.Components.Layout.Public
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<PageTitle>@Culture["RefVerif.Public.PageTitle"] · Lobsy</PageTitle>

<section class="pub-section ref-verif-public ref-verif-public-layout" aria-labelledby="ref-verif-public-title">
    @if (_thanks is not null)
    {
        <ReferenceVerificationIllustratedHero ImageUrl="@CandidateIllustratedImages.RefVerifPublic"
                                              CssClass="ref-verif-hero--public ref-verif-hero--public-compact"
                                              ObjectPosition="center 38%"
                                              AriaHidden="true" />
        <div class="ref-verif-public__shell">
            <div class="pub-card ref-verif-public__card ref-verif-lift-card ref-verif-lift-card--visible">
                <div class="ref-verif-public__inner">
                    <h1 id="ref-verif-public-title">@Culture["RefVerif.Public.PageTitle"]</h1>
                    <p role="status">@_thanks</p>
                </div>
            </div>
        </div>
    }
    else if (_problem is not null)
    {
        <ReferenceVerificationIllustratedHero ImageUrl="@CandidateIllustratedImages.RefVerifPublic"
                                              CssClass="ref-verif-hero--public ref-verif-hero--public-compact"
                                              ObjectPosition="center 38%"
                                              AriaHidden="true" />
        <div class="ref-verif-public__shell">
            <div class="pub-card ref-verif-public__card ref-verif-lift-card ref-verif-lift-card--visible">
                <div class="ref-verif-public__inner">
                    <h1 id="ref-verif-public-title">@Culture["RefVerif.Public.PageTitle"]</h1>
                    <p role="alert">@_problem</p>
                </div>
            </div>
        </div>
    }
    else if (_view is not null)
    {
        @if (_view.State == "open")
        {
            <ReferenceVerificationIllustratedHero ImageUrl="@CandidateIllustratedImages.RefVerifPublic"
                                                  CssClass="ref-verif-hero--public"
                                                  ObjectPosition="center 38%">
                <h1 id="ref-verif-public-title" class="ref-verif-hero__title">@Culture.Format("RefVerif.Public.Greeting", _view.ReferentName, _view.CandidateName)</h1>
                <p class="ref-verif-hero__lead">@Culture.Format("RefVerif.Public.IntroDetail", _view.CandidateName, _view.EmployerName, _view.RoleTitle)</p>
                <p class="ref-verif-hero__privacy">@Culture["RefVerif.Public.PrivacyShort"]</p>
            </ReferenceVerificationIllustratedHero>
            <div class="ref-verif-public__shell">
            <div class="pub-card ref-verif-public__card ref-verif-lift-card @(_cardVisible ? "ref-verif-lift-card--visible" : null)">
                <div class="ref-verif-public__inner">
                <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="ref-verif-public__form" data-testid="ref-verif-public-open">
                    <div class="ref-verif-public__section detail-card">
                        <h2 class="ref-verif-public__section-title">
                            <span class="ref-verif-public__step">1</span>
                            @Culture["RefVerif.Public.SectionFacts"]
                        </h2>
                        <p class="ref-verif-public__section-lead muted">@Culture["RefVerif.Public.SectionFactsLead"]</p>

                        <div class="ref-verif-public__row">
                            <p class="ref-verif-public__question">@Culture.Format("RefVerif.Public.Q.EmployerShort", _view.CandidateName, _view.EmployerName)</p>
                            <div class="ref-verif-pills" role="radiogroup" aria-label="@Culture.Format("RefVerif.Public.Q.EmployerShort", _view.CandidateName, _view.EmployerName)">
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedEmployer, true)" aria-pressed="@(_form.ConfirmedEmployer == true ? "true" : "false")" @onclick="() => _form.ConfirmedEmployer = true">@Culture["RefVerif.Public.Yes"]</button>
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedEmployer, false)" aria-pressed="@(_form.ConfirmedEmployer == false ? "true" : "false")" @onclick="() => _form.ConfirmedEmployer = false">@Culture["RefVerif.Public.No"]</button>
                            </div>
                        </div>

                        <div class="ref-verif-public__row">
                            <p class="ref-verif-public__question">@Culture.Format("RefVerif.Public.Q.PeriodDetail", FormatPeriodLabel(_view))</p>
                            <div class="ref-verif-pills" role="radiogroup">
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedPeriod, true)" aria-pressed="@(_form.ConfirmedPeriod == true ? "true" : "false")" @onclick="() => _form.ConfirmedPeriod = true">@Culture["RefVerif.Public.Yes"]</button>
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedPeriod, false)" aria-pressed="@(_form.ConfirmedPeriod == false ? "true" : "false")" @onclick="() => _form.ConfirmedPeriod = false">@Culture["RefVerif.Public.No"]</button>
                            </div>
                        </div>

                        <div class="ref-verif-public__row">
                            <p class="ref-verif-public__question">@Culture.Format("RefVerif.Public.Q.RoleDetail", _view.RoleTitle)</p>
                            <div class="ref-verif-pills" role="radiogroup">
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedRole, true)" aria-pressed="@(_form.ConfirmedRole == true ? "true" : "false")" @onclick="() => _form.ConfirmedRole = true">@Culture["RefVerif.Public.Yes"]</button>
                                <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedRole, false)" aria-pressed="@(_form.ConfirmedRole == false ? "true" : "false")" @onclick="() => _form.ConfirmedRole = false">@Culture["RefVerif.Public.No"]</button>
                            </div>
                        </div>

                        @if (_form is { ConfirmedEmployer: true, ConfirmedPeriod: true, ConfirmedRole: true })
                        {
                            <div class="ref-verif-public__row ref-verif-public__row--stack">
                                <p class="ref-verif-public__question">@Culture["RefVerif.Public.Q.Duties"]</p>
                                <div class="ref-verif-public__row-controls">
                                    <div class="ref-verif-pills" role="radiogroup">
                                        <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedDuties, true)" @onclick="() => _form.ConfirmedDuties = true">@Culture["RefVerif.Public.Yes"]</button>
                                        <button type="button" class="ref-verif-pills__btn @PillClass(_form.ConfirmedDuties, false)" @onclick="() => _form.ConfirmedDuties = false">@Culture["RefVerif.Public.No"]</button>
                                    </div>
                                    <button type="button" class="ref-verif-public__skip" @onclick="() => _form.ConfirmedDuties = null">
                                        @Culture["RefVerif.Public.SkipDuties"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_view.Competences.Count > 0)
                    {
                        <div class="ref-verif-public__section detail-card">
                            <div class="ref-verif-public__section-head">
                                <h2 class="ref-verif-public__section-title">
                                    <span class="ref-verif-public__step">2</span>
                                    @Culture["RefVerif.Public.SectionCompetences"]
                                </h2>
                                <p class="ref-verif-public__counter" aria-live="polite">@Culture.Format("RefVerif.Public.CompetenceCounter", _endorsed.Count, ReferenceVerificationRules.MaxCompetencesOffered)</p>
                            </div>
                            <p class="ref-verif-public__section-lead muted">@Culture.Format("RefVerif.Public.SectionCompetencesLead", _view.CandidateName)</p>
                            <div class="ref-verif-public__comp-list">
                                @foreach (var c in _view.Competences)
                                {
                                    var selected = _endorsed.Contains(c.Code);
                                    var disabled = !selected && _endorsed.Count >= ReferenceVerificationRules.MaxCompetencesOffered;
                                    <button type="button"
                                            class="ref-verif-public__comp @(selected ? "is-selected" : null) @(disabled ? "is-disabled" : null)"
                                            disabled="@disabled"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            @onclick="() => ToggleCompetence(c.Code)">
                                        <span class="ref-verif-public__comp-check @(selected ? "is-on" : null)" aria-hidden="true">
                                            @if (selected)
                                            {
                                                <span class="ref-verif-public__comp-tick">✓</span>
                                            }
                                        </span>
                                        <span class="ref-verif-public__comp-text">
                                            <span class="ref-verif-public__comp-label">@c.Label</span>
                                            @if (!string.IsNullOrWhiteSpace(c.Description))
                                            {
                                                <span class="ref-verif-public__comp-desc">@c.Description</span>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="ref-verif-public__section detail-card">
                        <h2 class="ref-verif-public__section-title">
                            <span class="ref-verif-public__step">3</span>
                            @Culture["RefVerif.Public.SectionComment"]
                            <span class="ref-verif-public__optional">@Culture["RefVerif.Public.Optional"]</span>
                        </h2>
                        <label class="ref-verif-public__comment-label" for="ref-comment">@Culture["RefVerif.Public.CommentHint"]</label>
                        <textarea id="ref-comment"
                                  class="ref-verif-public__textarea"
                                  rows="4"
                                  maxlength="400"
                                  placeholder="@Culture.Format("RefVerif.Public.CommentPlaceholder", _view.CandidateName)"
                                  @bind="_form.Comment"></textarea>
                        <p class="ref-verif-public__comment-private muted">@Culture.Format("RefVerif.Public.CommentPrivate", _view.CandidateName)</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_submitProblem))
                    {
                        <p class="ref-verif-public__error" role="alert">@_submitProblem</p>
                    }

                    <footer class="ref-verif-public__footer">
                        <div class="ref-verif-public__quiet">
                            <button type="button" class="ref-verif-public__link" disabled="@_busy" @onclick="UnknownAsync">@Culture["RefVerif.Public.Unknown"]</button>
                            <span class="ref-verif-public__sep" aria-hidden="true">·</span>
                            <button type="button" class="ref-verif-public__link" disabled="@_busy" @onclick="DeclineAsync">@Culture["RefVerif.Public.Decline"]</button>
                        </div>
                        <button type="submit" class="btn btn-primary ref-verif-public__submit" disabled="@_busy">@Culture["RefVerif.Public.Submit"]</button>
                    </footer>
                </EditForm>
                </div>
            </div>
            </div>
        }
        else
        {
            <ReferenceVerificationIllustratedHero ImageUrl="@CandidateIllustratedImages.RefVerifPublic"
                                                  CssClass="ref-verif-hero--public ref-verif-hero--public-compact"
                                                  ObjectPosition="center 38%"
                                                  AriaHidden="true" />
            <div class="ref-verif-public__shell">
                <div class="pub-card ref-verif-public__card ref-verif-lift-card @(_cardVisible ? "ref-verif-lift-card--visible" : null)">
                    <div class="ref-verif-public__inner">
                        <h1 id="ref-verif-public-title">@Culture["RefVerif.Public.PageTitle"]</h1>
                        <p role="status">@ProblemForState(_view.State)</p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="ref-verif-public__shell">
            <div class="pub-card ref-verif-public__card">
                <div class="ref-verif-public__inner">
                    <h1 id="ref-verif-public-title">@Culture["RefVerif.Public.PageTitle"]</h1>
                    <p role="status">@Culture["Common.Loading"]</p>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public string Token { get; set; } = "";

    private JobsyApiClient.ReferenceVerificationPublicView? _view;
    private string? _thanks;
    private string? _problem;
    private string? _submitProblem;
    private bool _busy;
    private readonly HashSet<string> _endorsed = new(StringComparer.Ordinal);
    private SubmitForm _form = new();
    private bool _cardVisible;

    private string ReturnPath => "/werk-referentie/" + Token;

    protected override async Task OnInitializedAsync()
    {
        if (Token.Length != 64)
        {
            _problem = Culture["RefVerif.Public.Invalid"];
            return;
        }

        try
        {
            var client = CreateClient();
            var view = await client.GetFromJsonAsync<JobsyApiClient.ReferenceVerificationPublicView>(
                $"api/public/reference-verification/{Uri.EscapeDataString(Token)}",
                JobsyApiClient.ApiJson);
            if (view is null)
            {
                _problem = Culture["RefVerif.Public.Invalid"];
                return;
            }

            _view = view;
            if (view.State != "open")
            {
                _problem = ProblemForState(view.State);
            }
            else
            {
                _cardVisible = true;
            }
        }
        catch
        {
            _problem = Culture["RefVerif.Public.Invalid"];
        }
    }

    private static string? PillClass(bool? current, bool value)
        => current == value ? "is-selected" : null;

    private static string? PillClassNullable(bool? current, bool? value)
        => current == value ? "is-selected" : null;

    private async Task SubmitAsync()
    {
        if (_view is null)
        {
            return;
        }

        _busy = true;
        _submitProblem = null;
        try
        {
            if (_form.ConfirmedEmployer is null || _form.ConfirmedPeriod is null || _form.ConfirmedRole is null)
            {
                _submitProblem = Culture["RefVerif.Public.AnswersMissing"];
                return;
            }

            var client = CreateClient();
            var response = await client.PostAsJsonAsync(
                $"api/public/reference-verification/{Uri.EscapeDataString(Token)}/submit",
                new
                {
                    confirmedEmployer = _form.ConfirmedEmployer,
                    confirmedPeriod = _form.ConfirmedPeriod,
                    confirmedRole = _form.ConfirmedRole,
                    confirmedDuties = _form.ConfirmedDuties,
                    endorsedCompetenceCodes = _endorsed.ToList(),
                    comment = _form.Comment
                },
                JobsyApiClient.ApiJson);
            if (response.IsSuccessStatusCode)
            {
                _thanks = Culture["RefVerif.Public.Thanks"];
                return;
            }

            var body = await response.Content.ReadAsStringAsync();
            _submitProblem = MapSubmitError(body);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeclineAsync()
    {
        _busy = true;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync(
                $"api/public/reference-verification/{Uri.EscapeDataString(Token)}/decline",
                null);
            if (response.IsSuccessStatusCode)
            {
                _thanks = Culture["RefVerif.Public.ThanksDecline"];
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UnknownAsync()
    {
        _busy = true;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync(
                $"api/public/reference-verification/{Uri.EscapeDataString(Token)}/unknown",
                null);
            if (response.IsSuccessStatusCode)
            {
                _thanks = Culture["RefVerif.Public.ThanksDecline"];
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleCompetence(string code)
    {
        if (_endorsed.Contains(code))
        {
            _endorsed.Remove(code);
            return;
        }

        if (_endorsed.Count >= ReferenceVerificationRules.MaxCompetencesOffered)
        {
            return;
        }

        _endorsed.Add(code);
    }

    private HttpClient CreateClient()
    {
        var apiBase = (Configuration["ApiBaseUrl"] ?? Configuration["JobsyApi:BaseUrl"] ?? "http://localhost:5200").TrimEnd('/');
        var client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(apiBase + "/");
        return client;
    }

    private string ProblemForState(string state) => state switch
    {
        "expired" => Culture["RefVerif.Public.Expired"],
        "used" => Culture["RefVerif.Public.Used"],
        _ => Culture["RefVerif.Public.Invalid"]
    };

    private string MapSubmitError(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var err))
            {
                return err.GetString() switch
                {
                    "answers" => Culture["RefVerif.Public.AnswersMissing"],
                    "expired" => Culture["RefVerif.Public.Expired"],
                    "used" => Culture["RefVerif.Public.Used"],
                    _ => Culture["RefVerif.Public.Invalid"]
                };
            }
        }
        catch
        {
            // ignore
        }

        return Culture["RefVerif.Public.Invalid"];
    }

    private string FormatPeriodLabel(JobsyApiClient.ReferenceVerificationPublicView view)
    {
        static string Part(string? m) => string.IsNullOrWhiteSpace(m) ? "…" : m;
        var end = view.IsCurrent ? Culture["RefVerif.Public.PeriodPresent"] : Part(view.EndMonth);
        return $"{Part(view.StartMonth)} – {end}";
    }

    private sealed class SubmitForm
    {
        public bool? ConfirmedEmployer { get; set; }
        public bool? ConfirmedPeriod { get; set; }
        public bool? ConfirmedRole { get; set; }
        public bool? ConfirmedDuties { get; set; }
        public string? Comment { get; set; }
    }

}
