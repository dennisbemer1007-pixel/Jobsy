@page "/ouder"
@layout MainLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Jobsy.Core.Authorization
@using Jobsy.Core.Features
@using Jobsy.Core.Scholen
@using Jobsy.Web.Scholen
@using Jobsy.Core.Scholen.PupilPassport
@using Jobsy.Web.Auth
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Media
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IFeatureFlags Features
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Culture["Ouder.Seo.Title"] · Lobsy</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-paspoort-g78.css")" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/scholen.css")" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/ouder-antwoorden.css")" />
</HeadContent>

@if (_loading)
{
    <section class="panel-page panel-section">
        <p class="state-message">@Culture["Common.Loading"]</p>
    </section>
}
else if (!_schoolsEnabled)
{
    <section class="panel-page panel-section">
        <p class="state-message">@Culture["Ouder.FeatureDisabled"]</p>
    </section>
}
else if (_session && _passportLoading)
{
    <section class="panel-page panel-section">
        <p class="state-message">@Culture["Common.Loading"]</p>
    </section>
}
else if (_session && _passport is not null && _passport.Enabled)
{
    <div class="ll-reis" data-testid="ouder-paspoort-page">
        <LeerlingPaspoortG78View Model="_passport" AllowNameEdit="false" />
        @if (_answersLoading)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (_answers is not null)
        {
            <OuderLeerlingAntwoorden Model="_answers" />
        }
        <nav class="lp-g78-paspoort-actions" aria-label="@Culture["Ouder.Passport.Pdf"]">
            <a class="btn-secondary" href="/ouder/uitloggen">@Culture["Ouder.Passport.OtherCode"]</a>
            <a class="btn-secondary" href="@PdfHref">@Culture["Ouder.Passport.Pdf"]</a>
        </nav>
    </div>
}
else if (_session)
{
    <section class="panel-page panel-section">
        <p class="ll-error" role="alert">@Culture["Ouder.Error.Invalid"]</p>
        <a class="btn-secondary" href="/ouder/uitloggen">@Culture["Ouder.Passport.OtherCode"]</a>
    </section>
}
else
{
    <section class="panel-page panel-section ouder-page" data-testid="ouder-login">
        <h1>@Culture["Ouder.Page.Title"]</h1>
        <p class="muted">@Culture["Ouder.Page.Lead"]</p>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="ll-error" role="alert">@_error</p>
        }
        <form method="post" action="/ouder/kijk" class="ll-form ouder-form">
            <AntiforgeryToken />
            <label class="ll-field">
                <span>@Culture["Ouder.Form.Code"]</span>
                <input type="text" name="code" required autocomplete="off" inputmode="text" maxlength="12" />
            </label>
            <button type="submit" class="btn-primary">@Culture["Ouder.Form.Submit"]</button>
        </form>
    </section>
}

@code {
    private bool _loading = true;
    private bool _schoolsEnabled;
    private bool _session;
    private bool _passportLoading;
    private PupilG78PassportWebDto? _passport;
    private ParentPassportAnswersWebDto? _answers;
    private bool _answersLoading;
    private string? _error;
    private string? _languageQuery;

    private string PdfHref
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_languageQuery))
            {
                return "/ouder/pdf";
            }

            return $"/ouder/pdf?lang={Uri.EscapeDataString(_languageQuery)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        await Culture.InitializeAsync();
        _schoolsEnabled = await SchoolsFeatureGate.IsEnabledAsync(Features);
        ParseQueryError();
        await RefreshSessionAsync();
        _loading = false;
    }

    private void ParseQueryError()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var err))
        {
            return;
        }

        _error = err.ToString() switch
        {
            "cooldown" => Culture["Ouder.Error.Cooldown"],
            "retry" => Culture["Ouder.Error.Retry"],
            "staff" => Culture["Ouder.Error.Staff"],
            "expired" => Culture["Ouder.Error.Expired"],
            _ => Culture["Ouder.Error.Invalid"]
        };
    }

    private async Task RefreshSessionAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            _session = false;
            return;
        }

        var auth = await http.AuthenticateAsync(ParentPassportAuthDefaults.Scheme);
        _session = auth.Succeeded && auth.Principal?.Identity?.IsAuthenticated == true;
        if (!_session || !_schoolsEnabled)
        {
            _passport = null;
            _answers = null;
            return;
        }

        _passportLoading = true;
        _answersLoading = true;
        _languageQuery = Culture.Language;
        try
        {
            _passport = await Api.GetParentG78PassportAsync(_languageQuery);
            _answers = await Api.GetParentTestAnswersAsync();
        }
        catch
        {
            _passport = null;
            _answers = null;
        }
        finally
        {
            _passportLoading = false;
            _answersLoading = false;
        }
    }

    private void OnCultureChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshSessionAsync();
        StateHasChanged();
    });

    public void Dispose() => Culture.Changed -= OnCultureChanged;
}
