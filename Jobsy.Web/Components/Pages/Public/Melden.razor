@page "/melden"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net.Http.Json
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IHttpClientFactory HttpClientFactory

<PageTitle>@Culture["Report.Seo.Title"] · Lobsy</PageTitle>

<section class="pub-section" aria-labelledby="melden-title">
    <div class="pub-card">
        @if (_sent)
        {
            <h1 id="melden-title">@Culture["Report.Success.Title"]</h1>
            @if (_sentWithEmail)
            {
                <p>@Culture["Report.Success.Email"]</p>
            }
            <p><a href="/banenkaart">@Culture["Report.Success.Back"]</a></p>
        }
        else
        {
            <h1 id="melden-title">@Culture["Report.Title"]</h1>
            <p>@Culture["Report.Lead"]</p>
            <p class="pp-report__target">
                <strong>@Culture["Report.About"]</strong>
                @(" ")
                @(_targetLabel ?? Culture["Report.About.Unknown"])
            </p>

            @if (_errorMessage is not null)
            {
                <p class="login-error" role="alert">@_errorMessage</p>
            }

            <form method="post" action="/melden/verstuur" class="login-form" data-enhance="false">
                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                <input type="hidden" name="type" value="@_type" />
                <input type="hidden" name="id" value="@_id" />

                <fieldset class="pp-report__reasons">
                    <legend>@Culture["Report.ReasonLegend"]</legend>
                    @foreach (var reason in Reasons)
                    {
                        <label>
                            <input type="radio"
                                   name="reason"
                                   value="@reason"
                                   required
                                   checked="@(_selectedReason == reason)" />
                            @Culture[$"Report.Reason.{reason}"]
                        </label>
                    }
                </fieldset>

                <label for="melden-details">@Culture["Report.Details"]</label>
                <textarea id="melden-details"
                          name="details"
                          rows="4"
                          maxlength="@ContentReportRules.DetailsMaxLength"></textarea>
                <p class="pp-report__hint">@Culture["Report.Details.Hint"]</p>

                <label for="melden-email">@Culture["Report.Email"]</label>
                <input id="melden-email" type="email" name="email" autocomplete="email" />
                <p class="pp-report__hint">@Culture["Report.Email.Hint"]</p>

                <p class="pp-report__hint">@Culture["Report.FalseWarning"]</p>
                <p class="pp-report__hint">@Culture["Report.Privacy"]</p>

                <button type="submit"
                        class="login-submit"
                        disabled="@(string.IsNullOrEmpty(_antiforgeryToken))">
                    @Culture["Report.Submit"]
                </button>
            </form>

            <p><a href="/gebruiksvoorwaarden#melden">@Culture["Report.Rules"]</a></p>
        }
    </div>
</section>

@code {
    private static readonly ContentReportReason[] Reasons = Enum.GetValues<ContentReportReason>();

    private string _type = "vacancy";
    private string _id = string.Empty;
    private string? _targetLabel;
    private string? _errorMessage;
    private ContentReportReason? _selectedReason;
    private bool _sent;
    private bool _sentWithEmail;
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        _type = ContentReportEndpoints.NormalizeType(Value(query, "type"));
        _id = Value(query, "id")?.Trim() ?? string.Empty;

        var sent = Value(query, "verzonden");
        _sent = !string.IsNullOrEmpty(sent);
        _sentWithEmail = string.Equals(sent, "mail", StringComparison.Ordinal);

        _errorMessage = Value(query, "fout") switch
        {
            "reden" => Culture["Report.Error.Reason"],
            "teveel" => Culture["Report.Error.TooMany"],
            "opnieuw" => Culture["Report.Error.Retry"],
            _ => null
        };

        var redenRaw = Value(query, "reden");
        if (Enum.TryParse<ContentReportReason>(redenRaw, ignoreCase: true, out var parsedReason)
            && Enum.IsDefined(parsedReason))
        {
            _selectedReason = parsedReason;
        }

        if (_sent)
        {
            return;
        }

        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? string.Empty;
        }

        _targetLabel = await LoadTargetLabelAsync();
    }

    private async Task<string?> LoadTargetLabelAsync()
    {
        if (_id.Length == 0)
        {
            return null;
        }

        try
        {
            var client = HttpClientFactory.CreateClient(ContentReportEndpoints.HttpClientName);
            var url = $"api/reports/target?type={Uri.EscapeDataString(_type)}&id={Uri.EscapeDataString(_id)}";
            var dto = await client.GetFromJsonAsync<TargetDto>(url);
            return string.IsNullOrWhiteSpace(dto?.Label) ? null : dto!.Label;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or NotSupportedException)
        {
            // The name is decoration only; the form stays usable with the generic label.
            return null;
        }
    }

    private static string? Value(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key)
        => query.TryGetValue(key, out var values) ? values.FirstOrDefault() : null;

    private sealed record TargetDto(string? Label);
}
