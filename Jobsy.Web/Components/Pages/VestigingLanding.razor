@page "/vestiging/{CompanyId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api
@inject NavigationManager Navigation

<PageTitle>Vacatures · Lobsy</PageTitle>

<div class="panel-page vestiging-landing">
    <p class="state-message">@(_message)</p>
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private string _message = "Even geduld — we openen de juiste vacatures…";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var route = await Api.GetBranchFlyerRouteAsync(CompanyId);
            var path = string.IsNullOrWhiteSpace(route?.RedirectPath)
                ? $"/?company={CompanyId:D}"
                : route.RedirectPath;

            if (route is not null
                && string.Equals(route.Kind, "VacancyDetail", StringComparison.OrdinalIgnoreCase))
            {
                _message = "Je wordt doorgestuurd naar de vacature…";
            }
            else
            {
                _message = "Je wordt doorgestuurd naar de vacaturekaart…";
            }

            await InvokeAsync(StateHasChanged);
            Navigation.NavigateTo(path, replace: true);
        }
        catch
        {
            _message = "Doorsturen naar de vacaturekaart…";
            Navigation.NavigateTo($"/?company={CompanyId:D}", replace: true);
        }
    }
}
