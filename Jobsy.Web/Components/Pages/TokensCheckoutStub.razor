@page "/tokens/checkout-stub"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,EnterpriseManager,Intermediary,Admin")]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject TokenBalanceCache TokenBalances

<PageTitle>Checkout stub · Lobsy</PageTitle>

<div class="panel-page">
    <h1>Mollie checkout (stub)</h1>
    <p class="login-lead">Simuleer een geslaagde betaling. Tokens worden bijgeschreven en een gekoppelde actie wordt direct uitgevoerd.</p>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-card__label">Payment</span>
                <strong class="stat-card__value" style="font-size:1rem">@_paymentId</strong>
            </div>
        </div>

        <div class="inline-actions" style="margin-top:1.5rem">
            <button class="login-submit" type="button" disabled="@_busy || string.IsNullOrWhiteSpace(_paymentId)" @onclick="CompleteAsync">
                @(_busy ? "Bezig…" : "Betaal (stub)")
            </button>
            <a class="auth-link" href="/employer/tokens">@Culture["Common.Cancel"]</a>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _busy;
    private string _paymentId = "";
    private Guid? _checkoutId;
    private string? _message;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _paymentId = query.TryGetValue("paymentId", out var pid) ? pid.ToString() : "";
        if (query.TryGetValue("checkoutId", out var cid) && Guid.TryParse(cid.ToString(), out var checkoutId))
        {
            _checkoutId = checkoutId;
        }

        _loading = false;
    }

    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(_paymentId) && _checkoutId is null)
        {
            _message = "Ongeldige checkout-parameters.";
            return;
        }

        _busy = true;
        try
        {
            CompleteCheckoutResult? result = null;
            if (_checkoutId is Guid checkoutId)
            {
                result = await Api.CompleteTokenCheckoutBySessionAsync(checkoutId);
            }
            else
            {
                result = await Api.CompleteTokenCheckoutAsync(_paymentId);
            }

            TokenBalances.Invalidate();

            if (result?.PendingAction is { Succeeded: true })
            {
                Navigation.NavigateTo($"/employer/vacancies?paidAction={Uri.EscapeDataString(result.PendingAction.Action)}");
                return;
            }

            if (result?.PendingAction is { Succeeded: false })
            {
                Navigation.NavigateTo(
                    $"/employer/vacancies?paidActionError={Uri.EscapeDataString(result.PendingAction.Message ?? "Actie mislukt")}");
                return;
            }

            Navigation.NavigateTo("/employer/tokens");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
