@page "/salesmanager/invoices"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SalesManager")]
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject CultureState Culture

<PageTitle>@Culture["Sales.Invoices"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Sales.Invoices"]</h1>
            <p class="login-lead">@Culture["Sales.InvoicesLead"]</p>
        </div>
        <button class="login-submit" type="button" disabled="@_busy" @onclick="OpenPayoutModalAsync">Uitbetalen</button>
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var inv in _invoices)
            {
                <div class="table-row">
                    <div>
                        <strong>@inv.InvoiceNumber</strong>
                        <div class="muted">@inv.Status · @inv.CreatedAt.ToLocalTime().ToString("g")</div>
                    </div>
                    <div class="inline-actions">
                        <span>€ @inv.TotalInclVat.ToString("0.00") incl. BTW</span>
                        <button class="provider-btn" type="button" disabled="@_busy"
                                @onclick="() => DownloadAsync(inv)">Download PDF</button>
                    </div>
                </div>
            }
        </div>
        @if (_invoices.Count == 0)
        {
            <p class="muted">Nog geen facturen.</p>
        }
    }
</div>

@if (_modalOpen)
{
    <div class="share-modal-backdrop" @onclick="CloseModal"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="payout-title"
         style="width:min(28rem, calc(100vw - 2rem));max-width:calc(100vw - 2rem)">
        <div class="share-modal__header">
            <h2 id="payout-title">Uitbetalen via Mollie</h2>
            <button type="button" class="share-modal__close" @onclick="CloseModal" aria-label="@Culture["Common.Close"]">×</button>
        </div>
        @if (_preview is null)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (_preview.AvailableExVat <= 0 && !_preview.CanPayout)
        {
            <p class="share-modal__lead" style="white-space:normal;max-width:none">@_preview.BlockReason</p>
            <div class="inline-actions" style="margin-top:1rem">
                <button type="button" class="btn-compact" @onclick="CloseModal">Sluiten</button>
            </div>
        }
        else
        {
            <p class="share-modal__lead" style="white-space:normal;max-width:none">
                Kies welk deel van je openstaande commissie je nu wilt laten uitbetalen.
                Na afronding verschijnt de self-billing factuur (PDF) in dit overzicht.
            </p>
            <p><strong>Rekening:</strong> @_preview.MaskedIban</p>
            <p class="muted">Beschikbaar: € @_preview.AvailableExVat.ToString("0.00") excl. BTW
                (€ @InclVat(_preview.AvailableExVat).ToString("0.00") incl. BTW)</p>

            <label class="login-form" style="display:block;margin-top:0.85rem">
                Bedrag excl. BTW
                <input type="number"
                       min="0.01"
                       max="@_preview.AvailableExVat.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.01"
                       inputmode="decimal"
                       value="@_amountInput"
                       @oninput="OnAmountInput"
                       disabled="@_busy" />
            </label>
            <div class="inline-actions" style="margin-top:0.5rem">
                <button type="button" class="btn-compact" disabled="@_busy" @onclick="SetFullAmount">Alles</button>
            </div>

            @if (_selectedAmountExVat is decimal amount && amount > 0)
            {
                <p style="margin-top:0.85rem">
                    <strong>Je laat uitbetalen:</strong>
                    € @InclVat(amount).ToString("0.00") incl. BTW
                    <span class="muted">(€ @amount.ToString("0.00") + € @VatOn(amount).ToString("0.00") BTW)</span>
                </p>
            }

            @if (!string.IsNullOrEmpty(_preview.BlockReason) && !_preview.CanPayout && _preview.AvailableExVat > 0)
            {
                <p class="state-message error">@_preview.BlockReason</p>
            }

            <div class="inline-actions" style="margin-top:1rem">
                <button type="button" class="login-submit"
                        disabled="@(_busy || !CanConfirm)"
                        @onclick="ConfirmPayoutAsync">
                    @(_busy ? "Bezig…" : "Bevestigen via Mollie")
                </button>
                <button type="button" class="btn-compact" disabled="@_busy" @onclick="CloseModal">@Culture["Common.Cancel"]</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_modalError))
        {
            <p class="state-message error">@_modalError</p>
        }
    </div>
}

@code {
    private List<SelfBillingInvoiceItem> _invoices = [];
    private SalesManagerPayoutPreview? _preview;
    private string _amountInput = "";
    private decimal? _selectedAmountExVat;
    private bool _loading = true;
    private bool _busy;
    private bool _modalOpen;
    private string? _error;
    private string? _message;
    private string? _modalError;

    private bool CanConfirm =>
        _preview is { CanPayout: true, AvailableExVat: > 0 }
        && _selectedAmountExVat is decimal a
        && a > 0
        && a <= _preview.AvailableExVat;

    [SupplyParameterFromQuery(Name = "paid")]
    public string? PaidInvoiceQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(PaidInvoiceQuery))
        {
            _message = $"Uitbetaling afgerond. Factuur {PaidInvoiceQuery} is als PDF beschikbaar om te downloaden.";
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _invoices = await Api.GetMySelfBillingInvoicesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenPayoutModalAsync()
    {
        _modalOpen = true;
        _modalError = null;
        _preview = null;
        _amountInput = "";
        _selectedAmountExVat = null;
        _error = null;
        _message = null;
        try
        {
            _preview = await Api.GetMyPayoutPreviewAsync();
            if (_preview is { AvailableExVat: > 0 })
            {
                SetAmount(_preview.AvailableExVat);
                await RefreshPreviewAsync();
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }

    private void CloseModal()
    {
        if (_busy)
        {
            return;
        }

        _modalOpen = false;
        _modalError = null;
    }

    private async Task OnAmountInput(ChangeEventArgs e)
    {
        _amountInput = e.Value?.ToString() ?? "";
        if (TryParseAmount(_amountInput, out var amount))
        {
            _selectedAmountExVat = amount;
            await RefreshPreviewAsync();
        }
        else
        {
            _selectedAmountExVat = null;
            if (_preview is not null)
            {
                _preview.CanPayout = false;
                _preview.BlockReason = "Voer een geldig bedrag in (bijv. 100,00).";
            }
        }
    }

    private async Task SetFullAmount()
    {
        if (_preview is null || _preview.AvailableExVat <= 0)
        {
            return;
        }

        SetAmount(_preview.AvailableExVat);
        await RefreshPreviewAsync();
    }

    private void SetAmount(decimal amountExVat)
    {
        var rounded = decimal.Round(amountExVat, 2, MidpointRounding.AwayFromZero);
        _selectedAmountExVat = rounded;
        _amountInput = rounded.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"));
    }

    private async Task RefreshPreviewAsync()
    {
        if (_selectedAmountExVat is not decimal amount)
        {
            return;
        }

        try
        {
            var available = _preview?.AvailableExVat;
            _preview = await Api.GetMyPayoutPreviewAsync(amount);
            if (_preview is not null && available is decimal keepAvailable && keepAvailable > _preview.AvailableExVat)
            {
                // Keep the originally shown available ceiling while typing.
                _preview.AvailableExVat = keepAvailable;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }

    private async Task ConfirmPayoutAsync()
    {
        if (_selectedAmountExVat is not decimal amount || amount <= 0)
        {
            _modalError = "Kies een bedrag om uit te betalen.";
            return;
        }

        _busy = true;
        _modalError = null;
        try
        {
            var checkout = await Api.CreateMyPayoutCheckoutAsync(amount);
            if (checkout is null || string.IsNullOrWhiteSpace(checkout.CheckoutUrl))
            {
                throw new InvalidOperationException("Geen Mollie-checkout ontvangen.");
            }

            _modalOpen = false;
            Nav.NavigateTo(checkout.CheckoutUrl, forceLoad: false);
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadAsync(SelfBillingInvoiceItem inv)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DownloadMySelfBillingInvoiceAsync(inv.Id, inv.InvoiceNumber, Js);
            _message = $"Factuur {inv.InvoiceNumber} (PDF) gedownload.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static decimal VatOn(decimal amountExVat)
        => decimal.Round(amountExVat * 0.21m, 2, MidpointRounding.AwayFromZero);

    private static decimal InclVat(decimal amountExVat) => amountExVat + VatOn(amountExVat);

    private static bool TryParseAmount(string? raw, out decimal amount)
    {
        amount = 0;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        var normalized = raw.Trim().Replace(',', '.');
        return decimal.TryParse(
                   normalized,
                   System.Globalization.NumberStyles.Number,
                   System.Globalization.CultureInfo.InvariantCulture,
                   out amount)
               && amount > 0;
    }
}
