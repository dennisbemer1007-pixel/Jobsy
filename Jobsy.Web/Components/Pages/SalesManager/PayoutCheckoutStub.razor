@page "/sales/wallet/uitbetalen"
@layout SalesLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SalesManager")]
@inject JobsyApiClient Api

<PageTitle>Uitbetaling stub · Lobsy</PageTitle>

<PayoutCheckoutStubView CancelHref="/sales/wallet"
                        SuccessNavigateHref="/sales/wallet"
                        CompleteCheckoutAsync="CompleteAsync" />

@code {
    private async Task<string?> CompleteAsync(string paymentId)
    {
        var result = await Api.CompleteMyPayoutCheckoutAsync(paymentId);
        return result?.InvoiceNumber;
    }
}
