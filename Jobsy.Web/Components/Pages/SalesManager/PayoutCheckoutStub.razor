@page "/salesmanager/payout-checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SalesManager")]
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@inject JobsyApiClient Api

<PageTitle>Uitbetaling stub · Lobsy</PageTitle>

<PayoutCheckoutStubView CancelHref="/salesmanager/invoices"
                        SuccessNavigateHref="/salesmanager/invoices"
                        CompleteCheckoutAsync="CompleteAsync" />

@code {
    private async Task<string?> CompleteAsync(string paymentId)
    {
        var result = await Api.CompleteMyPayoutCheckoutAsync(paymentId);
        return result?.InvoiceNumber;
    }
}
