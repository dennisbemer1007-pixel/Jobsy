@page "/salesmanager/toolkit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SalesManager")]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Sales.Toolkit"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Sales.Toolkit"]</h1>
            <p class="login-lead">@Culture["Sales.ToolkitLead"]</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
    {
        <p class="state-message">Rond eerst je onboarding af om een trackingcode te ontvangen.</p>
        <a class="login-submit" href="/salesmanager/onboarding" style="display:inline-block;text-decoration:none;text-align:center">Start onboarding</a>
    }
    else if (_dashboard is not null)
    {
        <div class="sales-toolkit-grid">
            <article class="sales-toolkit-card">
                <h2>Trackingcode</h2>
                <p class="muted">Deel je unieke code met ondernemers.</p>
                <strong>@_dashboard.TrackingCode</strong>
            </article>
            <article class="sales-toolkit-card">
                <h2>PDF-flyer &amp; delen</h2>
                <p class="muted">Persoonlijke A4-uitnodiging met jouw salescode, compacte tarieven en QR.</p>
                <button class="login-submit" type="button" disabled="@_busy" @onclick="DownloadFlyerAsync">
                    Download PDF-flyer
                </button>
                <div class="inline-actions" style="flex-wrap:wrap;gap:0.5rem">
                    <button class="btn-compact" type="button" @onclick="ShareWhatsApp">Deel via WhatsApp</button>
                    <button class="btn-compact" type="button" @onclick="ShareMail">Deel via mail</button>
                    <a class="btn-compact" href="@PartnerUrl">Open partnerpagina</a>
                </div>
            </article>
            <article class="sales-toolkit-card">
                <h2>Partnerlink</h2>
                <p class="muted" style="word-break:break-all">@PartnerUrl</p>
            </article>
        </div>

        @if (_catalog is not null)
        {
            <section class="panel-section">
                <h2>Actuele tarieven</h2>
                <p class="muted">Tokenwaarde € @_catalog.BaseTokenValueEuro.ToString("0.00") · start-highlight @_catalog.StartHighlightBonusTokens.ToString("0.##") tokens</p>
                <div class="table-list">
                    @foreach (var cost in _catalog.VacancyTypeCosts)
                    {
                        <div class="table-row">
                            <strong>
                                @cost.Label
                                @if (cost.CostTokens <= 0 || cost.PriceEuro <= 0)
                                {
                                    <span class="rate-free-badge">Gratis</span>
                                }
                            </strong>
                            <span>@cost.CostTokens.ToString("0.##") tokens · € @cost.PriceEuro.ToString("0.00")</span>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private SalesManagerDashboard? _dashboard;
    private PartnerSalesCatalog? _catalog;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private string PartnerUrl
    {
        get
        {
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var code = _dashboard?.TrackingCode;
            return string.IsNullOrWhiteSpace(code)
                ? $"{baseUri}/partner"
                : $"{baseUri}/partner/{Uri.EscapeDataString(code)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        try
        {
            _dashboard = await Api.GetMySalesManagerDashboardAsync();
            _catalog = await Api.GetPartnerSalesCatalogAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    private async Task DownloadFlyerAsync()
    {
        _busy = true;
        try
        {
            await Api.DownloadPartnerFlyerPdfAsync(Js, _dashboard?.TrackingCode);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShareWhatsApp()
    {
        var text = Uri.EscapeDataString(
            $"Lobsy partnerinfo met mijn code {_dashboard?.TrackingCode}: {PartnerUrl}");
        Navigation.NavigateTo($"https://wa.me/?text={text}", forceLoad: true);
    }

    private void ShareMail()
    {
        var subject = Uri.EscapeDataString("Lobsy — partneraanbod");
        var body = Uri.EscapeDataString(
            $"Hoi,%0A%0AHier is het Lobsy-partneraanbod met mijn salescode {_dashboard?.TrackingCode}:%0A{PartnerUrl}%0A%0A");
        Navigation.NavigateTo($"mailto:?subject={subject}&body={body}", forceLoad: true);
    }
}
