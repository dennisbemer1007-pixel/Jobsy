@page "/wie-zijn-wij"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@layout PublicLayout
@using Jobsy.Web.Components.Legal
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture
@inject LegalIdentityProvider LegalIdentity

<PageTitle>@Culture["Seo.AboutTitle"] · Lobsy</PageTitle>

<section class="pub-section pp-about" aria-labelledby="about-title">
    <header class="pp-doc__hero">
        <p class="pp-doc__eyebrow">
            <PubEmoji Glyph="👋" />
            <span>@Culture["About.Eyebrow"]</span>
        </p>
        <h1 id="about-title" class="pp-doc__title">@Culture["About.Title"]</h1>
        <p class="pp-doc__lead">@Culture["About.Lead"]</p>
    </header>

    <div class="pp-about__stories" aria-label="@Culture["About.Stories.Label"]">
        <article class="pp-about__story">
            <PubEmoji Glyph="🦞" />
            <h2>@Culture["About.Story.Lobster.Title"]</h2>
            <p>@Culture["About.Story.Lobster.Body"]</p>
        </article>
        <article class="pp-about__story">
            <PubEmoji Glyph="🌷" />
            <h2>@Culture["About.Story.Westland.Title"]</h2>
            <p>@Culture["About.Story.Westland.Body"]</p>
        </article>
        <article class="pp-about__story">
            <PubEmoji Glyph="🤝" />
            <h2>@Culture["About.Story.BothSides.Title"]</h2>
            <p>@Culture["About.Story.BothSides.Body"]</p>
        </article>
    </div>

    <article class="pp-about__founder">
        @* HasFounderPhoto is currently false (no photo checked in). Keep a single branch so the
           Razor generator does not emit an unreachable if (CS0162). Restore the <img> branch when
           AboutAssets.HasFounderPhoto is flipped and founder.webp is committed. *@
        <span class="pp-about__avatar" aria-hidden="true">🙂</span>
        <div>
            <h2>@Culture["About.Founder.Name"]</h2>
            <p>@Culture["About.Founder.Text"]</p>
        </div>
    </article>

    <article class="pp-about__contact">
        <h2>@Culture["About.Contact.Title"]</h2>
        <p>@Culture["About.Contact.Lead"]</p>
        @if (!string.IsNullOrWhiteSpace(_supportEmail))
        {
            <p class="pp-about__mail">
                <a class="pub-btn pub-btn--primary" href="mailto:@_supportEmail">@Culture["About.Contact.MailCta"]</a>
            </p>
        }
        <LegalIdentityCard />
        <p class="pp-about__privacy">
            @Culture["About.Contact.PrivacyNote"]
            <a href="@PublicRoutes.Privacy">@Culture["Legal.Privacy"]</a>
        </p>
    </article>
</section>

@code {
    private string? _supportEmail;

    protected override async Task OnInitializedAsync()
    {
        // D9: contact is Legal:SupportEmail; privacy@ stays for privacy questions only.
        var legal = await LegalIdentity.GetAsync();
        _supportEmail = legal.SupportEmail?.Trim();
    }
}
