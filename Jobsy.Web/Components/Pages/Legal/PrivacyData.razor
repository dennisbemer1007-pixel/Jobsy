@page "/privacy/data"
@attribute [Authorize]
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Jobsy.Core.Time
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IJSRuntime Js
@inject ILogger<PrivacyData> Logger

<PageTitle>@Culture["Privacy.Data.Title"] · Lobsy</PageTitle>

<section class="pub-section" aria-labelledby="mydata-title">
    <header class="pp-doc__hero">
        <p class="pp-doc__eyebrow">
            <span>@Culture["Privacy.Data.Eyebrow"]</span>
        </p>
        <h1 id="mydata-title" class="pp-doc__title">@Culture["Privacy.Data.Title"]</h1>
        <p class="pp-doc__lead">@Culture["Privacy.Data.Lead"]</p>
    </header>

    <div class="pp-mydata__grid">
        <article class="pp-mydata__card" aria-labelledby="mydata-download-title">
            <h2 id="mydata-download-title">@Culture["Privacy.Data.Download.Title"]</h2>
            <p>@Culture["Privacy.Data.Download.Text"]</p>
            @if (_exportFailed)
            {
                <p class="state-message error" role="alert">@Culture["Privacy.Data.ExportFailed"]</p>
            }
            <a class="pub-btn pub-btn--primary" href="/privacy/data/export" download>
                @Culture["Privacy.Data.Download.Button"]
            </a>
        </article>

        @if (!_supportNotesFailed)
        {
            <article class="pp-mydata__card" aria-labelledby="mydata-support-title">
                <h2 id="mydata-support-title">@Culture["Privacy.Data.Support.Title"]</h2>
                @if (_supportNotes.Count > 0)
                {
                    <ul class="pp-mydata__notes">
                        @foreach (var note in _supportNotes)
                        {
                            <li>@Culture.Format("Privacy.Data.SupportViewed", AmsterdamTime.FormatDate(note), AmsterdamTime.ToLocal(note).ToString("HH:mm"))</li>
                        }
                    </ul>
                }
                else
                {
                    <p>@Culture["Privacy.Data.Support.Empty"]</p>
                }
            </article>
        }

        <article class="pp-mydata__card pp-mydata__card--danger" aria-labelledby="mydata-delete-title">
            <h2 id="mydata-delete-title">@Culture["Privacy.Data.Delete.Title"]</h2>
            <p>@Culture["Privacy.Data.Delete.Text"]</p>
            <p><a href="/privacy#bewaren">@Culture["Privacy.Data.Delete.Retention"]</a></p>
            <button type="button" class="pub-btn pub-btn--secondary" @onclick="OpenUnsubscribe">
                @Culture["Privacy.Data.Delete.Button"]
            </button>
        </article>
    </div>

    <p class="pp-mydata__back"><a href="/privacy">@Culture["Privacy.Data.Back"]</a></p>
</section>

<UnsubscribeDialog IsOpen="_unsubscribeOpen"
                   OnClose="CloseUnsubscribe"
                   OnCompleted="OnUnsubscribeCompleted"
                   SkipLogoutNavigation="true" />

<form id="pp-logout-form" class="pp-mydata__logout-form" method="post" action="/account/logout">
    <AntiforgeryToken />
</form>

@code {
    private bool _unsubscribeOpen;
    private bool _exportFailed;
    private bool _supportNotesFailed;
    private List<DateTime> _supportNotes = [];

    [SupplyParameterFromQuery(Name = "export")]
    public string? ExportQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _exportFailed = string.Equals(ExportQuery, "failed", StringComparison.OrdinalIgnoreCase);

        try
        {
            _supportNotes = (await Api.GetSupportAccessNotesAsync()).ToList();
        }
        catch (Exception ex)
        {
            // Card 2 is decorative; hide it rather than show a raw error (07.4).
            _supportNotesFailed = true;
            _supportNotes = [];
            Logger.LogWarning(ex, "Could not load support-access notes for the Mijn gegevens page.");
        }
    }

    private void OpenUnsubscribe() => _unsubscribeOpen = true;

    private void CloseUnsubscribe() => _unsubscribeOpen = false;

    private async Task OnUnsubscribeCompleted()
    {
        // The dialog's own GET navigation is disabled (SkipLogoutNavigation); submit the
        // hidden antiforgery-protected POST form instead (07.2).
        await CircuitInterop.InvokeVoidIgnoredAsync(Js, "lobsyPublicPages.submitForm", "pp-logout-form");
    }
}
