@page "/privacy/data"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api

<PageTitle>Mijn gegevens · Lobsy</PageTitle>

<div class="panel-page">
    <h1>Mijn gegevens (AVG)</h1>
    <p class="login-lead">
        Exporteer je persoonsgegevens of meld je account af. Afmelden vereist een reden en een verificatiecode per e-mail;
        daarna wordt je account geblokkeerd en worden je gegevens opgeschoond.
    </p>

    <div class="inline-actions" style="margin-top:1.5rem">
        <button class="login-submit" type="button" disabled="@_busyExport" @onclick="ExportAsync">
            @(_busyExport ? "Bezig…" : "Exporteer JSON")
        </button>
        <button class="provider-btn provider-btn--danger" type="button" disabled="@_busyExport" @onclick="OpenUnsubscribe">
            Account afmelden
        </button>
        <a class="auth-link" href="/privacy">Terug naar privacyverklaring</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (!string.IsNullOrEmpty(_exportJson))
    {
        <pre class="code-block" style="margin-top:1.5rem;white-space:pre-wrap;max-height:28rem;overflow:auto">@_exportJson</pre>
    }
</div>

<UnsubscribeDialog IsOpen="_unsubscribeOpen"
                   OnClose="CloseUnsubscribe"
                   OnCompleted="OnUnsubscribeCompleted" />

@code {
    private bool _busyExport;
    private bool _unsubscribeOpen;
    private string? _message;
    private string? _exportJson;

    private void OpenUnsubscribe()
    {
        _message = null;
        _unsubscribeOpen = true;
    }

    private void CloseUnsubscribe() => _unsubscribeOpen = false;

    private void OnUnsubscribeCompleted() => _unsubscribeOpen = true;

    private async Task ExportAsync()
    {
        _busyExport = true;
        _message = null;
        try
        {
            _exportJson = await Api.ExportPrivacyDataAsync();
            _message = "Export geladen. Bewaar dit bestand veilig.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyExport = false;
        }
    }
}
