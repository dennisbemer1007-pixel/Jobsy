@page "/{KvkNumber:regex(^\\d{{8}}$)}"
@page "/{KvkNumber:regex(^\\d{{8}}$)}/{Vestigingsnummer:regex(^\\d{{1,12}}$)}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [AllowAnonymous]
@layout PublicLayout
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers, FallbackPath = "/")]
@inject JobsyApiClient Api
@inject IJSRuntime Js
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject ILogger<CompanyPublicPage> Logger
@using Jobsy.Core.Media
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Discovery
@using Jobsy.Web.Components.Engagement
@using Jobsy.Web.Components.Status
@using Jobsy.Web.Hosting
@using Jobsy.Web.Seo
@using Microsoft.AspNetCore.Http
@implements IAsyncDisposable

<PageTitle>@(_page?.Name ?? Culture["Status.NotFound.Title"]) · Lobsy</PageTitle>
<PageSeo Title="@SeoTitle"
         Description="@SeoDescription"
         Index="@(_page is not null)"
         CanonicalPath="@PagePath"
         ImageUrl="@_page?.LogoUrl"
         JsonLd="@SeoJsonLd" />

@if (_page is null)
{
    @if (_loading)
    {
        <section class="pub-section pp-company" aria-busy="true"></section>
    }
    else
    {
        <StatusPageContent Code="404" />
    }
}
else
{
    <section class="pub-section pp-company" aria-labelledby="company-title">
        <nav class="pp-company__crumbs" aria-label="@Culture["CompanyPage.Breadcrumb.Label"]">
            <a href="@PublicRoutes.Banenkaart">@Culture["CompanyPage.Breadcrumb.Map"]</a>
            <span class="pp-company__crumb-sep" aria-hidden="true">›</span>
            <span aria-current="page">@_page.Name</span>
        </nav>

        <header class="pub-card pp-company__header">
            @if (HasUploadedLogo)
            {
                <img class="pp-company__logo"
                     src="@_page.LogoUrl"
                     alt=""
                     width="56"
                     height="56"
                     decoding="async"
                     data-logo-fallback="1" />
            }
            else
            {
                <span class="pp-company__tile" aria-hidden="true">@CategoryGlyph</span>
            }
            <div class="pp-company__identity">
                <h1 id="company-title" class="pp-doc__title">@_page.Name</h1>
                <p class="pp-company__meta">
                    @if (!string.IsNullOrWhiteSpace(_page.City))
                    {
                        <span>@_page.City</span>
                        <span class="pp-company__meta-sep" aria-hidden="true">·</span>
                    }
                    <span>@VacancyCountText</span>
                    <span class="pub-chip pp-company__kvk">@Culture["CompanyPage.KvkVerified"]</span>
                </p>
                @if (_engagement.Count > 0)
                {
                    <EngagementBadges Items="@_engagement" />
                }
            </div>
        </header>

        @if (BranchTabs.Count > 0)
        {
            <nav class="pp-company__tabs" aria-label="@Culture["CompanyPage.Branches.Label"]">
                <a class="pp-company__tab @(string.IsNullOrWhiteSpace(Vestigingsnummer) ? "pp-company__tab--active" : null)"
                   href="@($"/{_page.DisplayKvk}")"
                   aria-current="@(string.IsNullOrWhiteSpace(Vestigingsnummer) ? "page" : null)">
                    @Culture.Format("CompanyPage.Branches.All", BranchTabs.Count)
                </a>
                @foreach (var branch in BranchTabs)
                {
                    var isCurrent = !string.IsNullOrWhiteSpace(Vestigingsnummer)
                                    && string.Equals(branch.Vestigingsnummer, Vestigingsnummer, StringComparison.Ordinal);
                    <a class="pp-company__tab @(isCurrent ? "pp-company__tab--active" : null)"
                       href="@BranchPath(branch)"
                       aria-current="@(isCurrent ? "page" : null)">
                        @BranchLabel(branch)
                    </a>
                }
            </nav>
        }

        <div class="pp-company__body">
            <div class="pp-company__list" aria-label="@Culture["CompanyPage.Vacancies.Label"]">
                @{ var cardIndex = 0; }
                @foreach (var vacancy in _vacancies)
                {
                    <VacancyCard @key="vacancy.Id"
                                 Vacancy="vacancy"
                                 IsHighlighted="vacancy.IsHighlighted"
                                 IsPressed="_hoveredId == vacancy.Id"
                                 Eager="cardIndex == 0"
                                 TravelText="@CardMeta(vacancy)"
                                 OnSelect="OnSelect"
                                 OnOpen="OnOpenVacancy" />
                    cardIndex++;
                }
            </div>

            <aside class="pp-company__map-pane" aria-label="@Culture["CompanyPage.Map.Label"]">
                <div @ref="_mapElement" id="branch-job-map" class="pp-company__map job-map"></div>
            </aside>
        </div>

        <p class="pp-company__report">
            @Culture["Report.Company.Prompt"]
            <a href="@ReportHref">@Culture["Report.Company.PromptCta"]</a>
        </p>
    </section>
}

@code {
    [Parameter] public string KvkNumber { get; set; } = string.Empty;
    [Parameter] public string? Vestigingsnummer { get; set; }

    private string PagePath => string.IsNullOrWhiteSpace(Vestigingsnummer)
        ? $"/{KvkNumber}"
        : $"/{KvkNumber}/{Vestigingsnummer}";

    private string ReportHref => $"/melden?type=company&id={Uri.EscapeDataString(KvkNumber)}";

    private string? SeoTitle => _page is null ? null : $"{_page.Name} · Lobsy";

    private string? SeoDescription => _page is null
        ? null
        : Culture.Format("Seo.CompanyDescription", _page.Name);

    /// <summary>Only a real uploaded logo is shown; a generated placeholder stays off the page (D4).</summary>
    private bool HasUploadedLogo => !string.IsNullOrWhiteSpace(_page?.LogoUrl);

    private string CategoryGlyph => CompanyCategoryEmoji.For(
        _vacancies.Select(v => v.CategoryName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)));

    private string VacancyCountText => _vacancies.Count == 1
        ? Culture["CompanyPage.VacancyCount.One"]
        : Culture.Format("CompanyPage.VacancyCount.Many", _vacancies.Count);

    /// <summary>Tabs only for branches that have a public vacancy (D4 extra).</summary>
    private List<PublicCompanyBranch> BranchTabs => _page?.Branches is { Count: > 0 } branches
        ? branches
            .Where(b => b.VacancyCount > 0
                        && !string.IsNullOrWhiteSpace(b.Path ?? b.PublicPath))
            .ToList()
        : [];

    private string? SeoJsonLd
    {
        get
        {
            if (_page is null)
            {
                return null;
            }

            // The origin comes from the configured public base URL, never the request Host (01).
            var origin = PageSeoResolver.ConfiguredOrigin(Navigation.Uri, Configuration);
            return StructuredData.Organization(origin, _page.Name, _page.City, _page.LogoUrl, PagePath);
        }
    }

    private ElementReference _mapElement;
    private PublicCompanyPage? _page;
    private List<VacancyListItem> _vacancies = [];
    private List<EngagementBadges.EngageBadgeItem> _engagement = [];
    private Guid _engagementCompanyId;
    private bool _loading = true;
    private bool _mapReady;
    private bool _mapInitScheduled;
    private Guid? _hoveredId;
    private readonly uint _highlightShuffleSeed = (uint)Random.Shared.NextInt64();
    private DotNetObjectReference<CompanyPublicPage>? _dotNetRef;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _page = null;
        _vacancies = [];
        _engagement = [];
        _engagementCompanyId = Guid.Empty;
        _mapReady = false;
        _mapInitScheduled = false;

        try
        {
            var kvk = CompanyPublicPaths.NormalizeKvkNumber(KvkNumber);
            if (kvk is null)
            {
                MarkNotFound();
                return;
            }

            _page = string.IsNullOrWhiteSpace(Vestigingsnummer)
                ? await Api.GetPublicCompanyByKvkAsync(kvk)
                : await Api.GetPublicCompanyByVestigingAsync(kvk, Vestigingsnummer);

            if (_page is null)
            {
                MarkNotFound();
                return;
            }

            _vacancies = (await Api.GetPublicCompanyVacanciesAsync(
                kvk,
                string.IsNullOrWhiteSpace(Vestigingsnummer) ? null : Vestigingsnummer)).ToList();

            if (_vacancies.Count == 0)
            {
                MarkNotFound();
                return;
            }

            _engagementCompanyId = _vacancies[0].CompanyId;
            var badges = await Api.GetPublicEngagementAsync(_engagementCompanyId);
            _engagement = badges
                .Select(b => new EngagementBadges.EngageBadgeItem(
                    b.ItemId,
                    string.Equals(b.Status, CompanyEngagementStatuses.Checked, StringComparison.OrdinalIgnoreCase),
                    b.CheckedSource))
                .ToList();
        }
        catch (Exception ex)
        {
            // A visitor never sees an API failure as an exception text; the page is a plain 404.
            Logger.LogWarning(ex, "Public company page failed for {Kvk}/{Vestiging}", KvkNumber, Vestigingsnummer);
            MarkNotFound();
        }
        finally
        {
            _loading = false;
        }
    }

    private void MarkNotFound()
    {
        _page = null;
        _vacancies = [];
        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null && !http.Response.HasStarted)
        {
            http.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }

    private string BranchPath(PublicCompanyBranch branch) => branch.Path ?? branch.PublicPath ?? PagePath;

    private static string BranchLabel(PublicCompanyBranch branch)
        => string.IsNullOrWhiteSpace(branch.Name) ? branch.City ?? "" : branch.Name;

    /// <summary>
    /// The card's second line: work type and hours. This page has no visitor location, so it never
    /// claims a travel time.
    /// </summary>
    private string CardMeta(VacancyListItem vacancy)
    {
        var parts = new List<string>(2);
        if (vacancy.WorkTypes.Length > 0)
        {
            parts.Add(UiLabels.WorkType(Culture, vacancy.WorkTypes[0]));
        }

        var hours = HoursText(vacancy);
        if (hours is not null)
        {
            parts.Add(hours);
        }

        return string.Join(" · ", parts);
    }

    private string? HoursText(VacancyListItem vacancy)
    {
        var min = vacancy.MinHoursPerWeek;
        var max = vacancy.MaxHoursPerWeek;
        if (min is null && max is null)
        {
            return null;
        }

        var unit = Culture["Vacancy.HoursUnit"];
        if (min is not null && max is not null && min != max)
        {
            return $"{min.Value:0.#}–{max.Value:0.#} {unit}";
        }

        return $"{(min ?? max)!.Value:0.#} {unit}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The list is in the prerendered HTML; the map is initialised afterwards (09.3).
        if (_loading || _page is null || _mapReady || _mapInitScheduled)
        {
            return;
        }

        _mapInitScheduled = true;
        try
        {
            if (!RendererInfo.IsInteractive)
            {
                _mapInitScheduled = false;
                return;
            }

            try
            {
                await Api.RecordImpressionsAsync(Js, _vacancies.Select(v => v.Id));
            }
            catch
            {
                // Analytics must not block the map.
            }

            _dotNetRef ??= DotNetObjectReference.Create(this);
            var markers = BuildMarkers();
            var options = new Dictionary<string, object?>
            {
                ["dotNetRef"] = _dotNetRef,
                ["highlightSeed"] = _highlightShuffleSeed,
                ["preferFilledLocation"] = false
            };
            await MapScripts.EnsureDiscoveryAsync(Js);
            await Js.InvokeVoidAsync("jobMap.init", "branch-job-map", markers, options);
            _mapReady = true;
            await Js.InvokeVoidAsync("jobMap.invalidate");
        }
        catch (JSDisconnectedException)
        {
            _mapInitScheduled = false;
        }
        catch
        {
            _mapInitScheduled = false;
        }
    }

    private List<Dictionary<string, object?>> BuildMarkers() =>
        _vacancies.Select(v =>
        {
            var primaryType = v.WorkTypes.FirstOrDefault() ?? "";
            var companyHref = !string.IsNullOrWhiteSpace(v.KvkNumber) && !string.IsNullOrWhiteSpace(v.Vestigingsnummer)
                ? $"/{v.KvkNumber}/{v.Vestigingsnummer}"
                : null;
            var typeBadge = ResolveTypeBadge(v);
            return new Dictionary<string, object?>
            {
                ["id"] = v.Id.ToString(),
                ["title"] = v.Title,
                ["company"] = v.CompanyName,
                ["companyId"] = v.CompanyId.ToString("D"),
                ["companyHref"] = companyHref,
                ["offeredBy"] = v.OfferedByLabel,
                ["address"] = v.CompanyAddress,
                ["logoUrl"] = VacancyImageUrls.Normalize(v.CompanyLogoUrl),
                ["imageUrl"] = VacancyImageUrls.Resolve(v.ImageUrl, v.CompanyLogoUrl, v.Id, v.WorkTypes.FirstOrDefault()),
                ["lat"] = v.Latitude,
                ["lng"] = v.Longitude,
                ["transport"] = v.RequiredTransport,
                ["workTypes"] = v.WorkTypes,
                ["workType"] = primaryType,
                ["categoryId"] = v.CategoryId?.ToString("D"),
                ["categoryName"] = v.CategoryName,
                ["categoryColor"] = v.CategoryColorHex,
                ["suitableFor65Plus"] = ShowsSuitableFor65Plus(v),
                ["suitableFor65PlusLabel"] = VacancyCategoryDefaults.SuitableFor65PlusLabel,
                ["suitableFor65PlusColor"] = VacancyCategoryDefaults.SeniorPlusColorHex,
                ["typeBadgeLabel"] = typeBadge.Label,
                ["typeBadgeColor"] = typeBadge.ColorHex,
                ["highlighted"] = v.IsHighlighted,
                ["highlightRank"] = v.IsHighlighted ? HighlightShuffleRules.Rank(_highlightShuffleSeed, v.Id) : 0u,
                ["featuredLabel"] = Culture["Discovery.Featured"],
                ["exclusivityBadge"] = !v.ExclusivityIsOpen
                    && string.Equals(v.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(v.ExclusivityName)
                    ? v.ExclusivityName
                    : null
            };
        }).ToList();

    private async Task OnSelect(Guid id)
    {
        _hoveredId = id;
        if (_mapReady)
        {
            await CircuitInterop.InvokeVoidIgnoredAsync(Js, "jobMap.focus", id.ToString());
        }
    }

    private async Task OnOpenVacancy(Guid id)
    {
        try
        {
            await Api.RecordClickOnceAsync(Js, id);
        }
        catch
        {
            // tracking must not break UX
        }
    }

    [JSInvokable]
    public async Task OnMapVacancyOpened(string id)
    {
        if (!Guid.TryParse(id, out var vacancyId))
        {
            return;
        }

        try
        {
            await Api.RecordClickOnceAsync(Js, vacancyId);
        }
        catch
        {
            // tracking must not break UX
        }
    }

    [JSInvokable]
    public Task OnMapLocateClicked() => Task.CompletedTask;

    private static bool ShowsSuitableFor65Plus(VacancyListItem vacancy)
        => VacancyCategoryDefaults.MatchesSuitableFor65PlusFilter(vacancy.CategoryId, vacancy.SuitableFor65Plus);

    private static (string? Label, string? ColorHex) ResolveTypeBadge(VacancyListItem vacancy)
    {
        VacancyKind? kind = Enum.TryParse<VacancyKind>(vacancy.Kind, ignoreCase: true, out var parsed)
            ? parsed
            : null;
        return VacancyCategoryDefaults.ResolveMapPopupTypeBadge(
            vacancy.CategoryId,
            vacancy.SuitableFor65Plus,
            kind);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_mapReady)
        {
            await CircuitInterop.InvokeVoidIgnoredAsync(Js, "jobMap.dispose");
        }
    }
}
