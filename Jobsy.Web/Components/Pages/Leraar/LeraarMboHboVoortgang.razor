@page "/leraar/klas/{ClassId:guid}/mbo-hbo"
@layout SchoolLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Teacher,SchoolAdmin")]
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Enums
@using Jobsy.Web.Hosting
@using Jobsy.Web.Services
@inject CultureState Culture
@inject JobsyApiClient Api

<HeadContent>
    @foreach (var href in PageAssetCatalog.LeerlingMboHboStylesheets("/leerling/mbo-hbo/overzicht"))
    {
        <link rel="stylesheet" href="@href" />
    }
</HeadContent>

<PageTitle>MBO/HBO voortgang · Lobsy</PageTitle>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_model is null)
{
    <p class="state-message error">@Culture["Leraar.LoadFailed"]</p>
}
else
{
    <header class="sch-page-header">
        <p class="sch-breadcrumb"><a href="@($"/leraar/klas/{ClassId:D}")">@Culture["Leraar.Nav.Overview"]</a> / MBO/HBO</p>
        <h1>@_model.ClassLabel</h1>
        <p class="muted">@Culture["Leraar.Codes.NamesNote"]</p>
    </header>

    <div class="mhbo-root" style="min-height:auto;background:transparent">
        <div class="mhbo-grid" style="grid-template-columns:1.55fr 1fr;margin-top:18px">
            <div class="mhbo-card" style="padding:14px 16px">
                <div style="display:flex;gap:16px;font-size:12.5px;color:#5a6576;margin-bottom:6px">
                    <span><span class="mhbo-dot d0"></span> Niet gestart</span>
                    <span><span class="mhbo-dot d1"></span> Bezig</span>
                    <span><span class="mhbo-dot d2"></span> Afgerond</span>
                </div>
                <table style="width:100%;border-collapse:collapse;font-size:14px">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Vakken</th>
                            <th>Interesse</th>
                            <th>Compet.</th>
                            <th>Beroepen</th>
                            <th>Werkw.</th>
                            <th>Af</th>
                            <th>Paspoort</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _model.Codes)
                        {
                            <tr>
                                <td>
                                    <b>@row.CodeDisplay</b>
                                    @if (row.PatternSignal)
                                    {
                                        <span class="mhbo-chip" title="Antwoordpatroon opvallend" style="margin-left:6px">⚠</span>
                                    }
                                </td>
                                @foreach (var st in row.BlockStatuses)
                                {
                                    <td><span class="mhbo-dot @DotClass(st)"></span></td>
                                }
                                <td>@row.CompletedCount/5</td>
                                <td>@(row.PassportReady ? "Klaar" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mhbo-grid">
                <div class="mhbo-card">
                    <h2 style="font-size:18px;color:#0f2747">Voortgang per test</h2>
                    @foreach (var pr in _model.Charts.BlockCompletion)
                    {
                        <div class="mhbo-hb">
                            <span style="width:110px">@pr.BlockKey</span>
                            <div class="mhbo-bar" style="display:flex">
                                <i style="width:@($"{pr.CompletedPercent}%");background:#2e8b57"></i>
                                <i style="width:@($"{pr.InProgressPercent}%");background:#e2b33c"></i>
                            </div>
                            <b>@pr.CompletedPercent%</b>
                        </div>
                    }
                </div>
                <div class="mhbo-card">
                    <h2 style="font-size:18px;color:#0f2747">Interesses in de groep (gemiddeld)</h2>
                    @foreach (var bar in _model.Charts.InteresseAverage)
                    {
                        <div class="mhbo-hb">
                            <span style="width:110px">@bar.Label</span>
                            <div class="mhbo-bar"><i style="width:@($"{bar.Percent}%");background:#0f2747"></i></div>
                            <b>@bar.Percent</b>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ClassId { get; set; }
    private TeacherMboHboClassProgressDto? _model;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _model = await Api.GetTeacherMboHboProgressAsync(ClassId);
        _loading = false;
    }

    private static string DotClass(PupilMboHboTileStatus st)
        => st switch
        {
            PupilMboHboTileStatus.Completed => "d2",
            PupilMboHboTileStatus.InProgress => "d1",
            _ => "d0"
        };

}
