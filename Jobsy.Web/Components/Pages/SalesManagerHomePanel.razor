@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture

<section class="panel-page panel-page--dashboard">
    <header class="panel-header panel-header--dashboard">
        <div>
            <h1>@Culture["Sales.Dashboard"]</h1>
            <p class="login-lead">@Culture["Sales.DashboardLead"]</p>
        </div>
        @if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
        {
            <a class="auth-link" href="/salesmanager/onboarding">@Culture["Sales.Onboarding"]</a>
        }
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
    {
        <p class="state-message">Rond eerst je onboarding af om een trackingcode te ontvangen.</p>
        <a class="login-submit" href="/salesmanager/onboarding" style="display:inline-block;text-decoration:none;text-align:center">Start onboarding</a>
    }
    else if (_dashboard is not null)
    {
        <div class="bento-grid">
            <div class="bento-grid__main">
                @{
                    var uninvoiced = (double)_dashboard.UninvoicedExVat;
                    var balance = (double)Math.Max(_dashboard.BalanceExVat, 0.01m);
                    var ring = Math.Clamp(100d * uninvoiced / (balance + uninvoiced), 0, 100);
                }
                <div class="bento-hero" style="--bento-hero-cols:4" aria-label="Kerncijfers">
                    <div class="stat-card stat-card--tile stat-card--emphasis stat-card--featured">
                        <span class="stat-card__top">
                            <span class="stat-card__label">Saldo excl. BTW</span>
                            <span class="stat-card__status stat-card__status--ok" aria-hidden="true"></span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value">€ @_dashboard.BalanceExVat.ToString("0.00")</strong>
                                <span class="stat-card__hint">incl. BTW € @_dashboard.BalanceInclVat.ToString("0.00")</span>
                            </span>
                            <MetricRing Progress="ring"
                                        CenterLabel="@($"{ring:0}%")"
                                        SizePx="40" />
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top">
                            <span class="stat-card__label">Trackingcode</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value" style="font-size:1.05rem;letter-spacing:0.03em">@_dashboard.TrackingCode</strong>
                            </span>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top">
                            <span class="stat-card__label">Niet gefactureerd</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value">€ @_dashboard.UninvoicedExVat.ToString("0.00")</strong>
                            </span>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top">
                            <span class="stat-card__label">Suppliers</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value">@_dashboard.Suppliers.Count</strong>
                            </span>
                        </span>
                    </div>
                </div>

                <div class="bento-cell bento-cell--split">
                    <article class="bento-rank__card">
                        <header class="bento-rank__header">
                            <h3>Gekoppelde suppliers</h3>
                            <p>Ondernemers via jouw code</p>
                        </header>
                        @if (_dashboard.Suppliers.Count == 0)
                        {
                            <p class="bento-rank__empty muted">Nog geen ondernemers via jouw code.</p>
                        }
                        else
                        {
                            <ol class="bento-rank__list">
                                @foreach (var s in _dashboard.Suppliers.Take(6))
                                {
                                    <li class="bento-rank__row">
                                        <div class="bento-rank__meta">
                                            <strong class="bento-rank__title">@s.Name</strong>
                                            <span class="bento-rank__sub muted">KvK @s.KvkNumber · slot @(s.FirstYearSupplierSlot?.ToString() ?? "—")</span>
                                        </div>
                                        <span class="bento-rank__value" style="min-width:auto">@(s.HasPaidOnboarding ? "€2500" : "Open")</span>
                                    </li>
                                }
                            </ol>
                        }
                    </article>

                    <article class="bento-rank__card">
                        <header class="bento-rank__header">
                            <h3>Recente commissies</h3>
                            <p>Laatste ledgerregels</p>
                        </header>
                        @if (_dashboard.RecentLedger.Count == 0)
                        {
                            <p class="bento-rank__empty muted">Nog geen commissies.</p>
                        }
                        else
                        {
                            <ol class="bento-rank__list">
                                @foreach (var e in _dashboard.RecentLedger.Take(6))
                                {
                                    <li class="bento-rank__row">
                                        <div class="bento-rank__meta">
                                            <strong class="bento-rank__title">@e.Kind</strong>
                                            <span class="bento-rank__sub muted">@(e.CompanyName ?? "—") · @e.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                        <span class="bento-rank__value" style="min-width:auto">€ @e.AmountExVat.ToString("0.00")</span>
                                    </li>
                                }
                            </ol>
                        }
                    </article>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private SalesManagerDashboard? _dashboard;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await Api.GetMySalesManagerDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
