@using Jobsy.Web.Services
@inject JobsyApiClient Api

<section class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Salesmanager</h1>
            <p class="login-lead">Gekoppelde ondernemers, wallet en self-billing uitbetalingen.</p>
        </div>
        @if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
        {
            <a class="auth-link" href="/salesmanager/onboarding">Onboarding</a>
        }
    </header>

    @if (_loading)
    {
        <p class="state-message">Laden…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
    {
        <p class="state-message">Rond eerst je onboarding af om een trackingcode te ontvangen.</p>
        <a class="login-submit" href="/salesmanager/onboarding" style="display:inline-block;text-decoration:none;text-align:center">Start onboarding</a>
    }
    else if (_dashboard is not null)
    {
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-card__label">Trackingcode</span>
                <strong class="stat-card__value">@_dashboard.TrackingCode</strong>
            </div>
            <div class="stat-card">
                <span class="stat-card__label">Saldo excl. BTW</span>
                <strong class="stat-card__value">€ @_dashboard.BalanceExVat.ToString("0.00")</strong>
            </div>
            <div class="stat-card">
                <span class="stat-card__label">Saldo incl. BTW</span>
                <strong class="stat-card__value">€ @_dashboard.BalanceInclVat.ToString("0.00")</strong>
            </div>
            <div class="stat-card">
                <span class="stat-card__label">Niet gefactureerd</span>
                <strong class="stat-card__value">€ @_dashboard.UninvoicedExVat.ToString("0.00")</strong>
            </div>
        </div>

        <section class="panel-section">
            <h2>Gekoppelde suppliers</h2>
            @if (_dashboard.Suppliers.Count == 0)
            {
                <p class="muted">Nog geen ondernemers via jouw code.</p>
            }
            else
            {
                <div class="table-list">
                    @foreach (var s in _dashboard.Suppliers)
                    {
                        <div class="table-row">
                            <div>
                                <strong>@s.Name</strong>
                                <div class="muted">KvK @s.KvkNumber · slot @(s.FirstYearSupplierSlot?.ToString() ?? "—")</div>
                            </div>
                            <span>@(s.HasPaidOnboarding ? "€2500 betaald" : "Onboarding open")</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-section">
            <h2>Recente commissies</h2>
            <div class="table-list">
                @foreach (var e in _dashboard.RecentLedger.Take(20))
                {
                    <div class="table-row">
                        <div>
                            <strong>@e.Kind</strong>
                            <div class="muted">@(e.CompanyName ?? "—") · @e.CreatedAt.ToLocalTime().ToString("g")</div>
                        </div>
                        <span>€ @e.AmountExVat.ToString("0.00")</span>
                    </div>
                }
            </div>
        </section>

        <p><a class="auth-link" href="/salesmanager/invoices">Facturen &amp; uitbetalen</a></p>
    }
</section>

@code {
    private SalesManagerDashboard? _dashboard;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await Api.GetMySalesManagerDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
