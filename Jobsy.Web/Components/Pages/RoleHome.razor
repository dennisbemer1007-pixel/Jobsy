@page "/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Jobsy.Core.Authorization
@using Jobsy.Web.Components.Pages.Admin
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home · Lobsy</PageTitle>

<AuthorizeView Roles="@JobsyRoles.Admin">
    <Authorized>
        <AdminHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Candidate">
    <Authorized>
        <CandidateHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.BranchManager">
    <Authorized>
        <EmployerHomePanel Title="Vestiging dashboard"
                           Lead="Jouw vacatures en tokens in één oogopslag."
                           VacanciesHref="/branch/vacancies"
                           TokensHref="/branch/tokens"
                           EnableRaamflyer="true" />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.RegionalManager">
    <Authorized>
        <EmployerHomePanel Title="Regio dashboard"
                           Lead="KPI’s en alleen-lezen inzicht in vacatures, sollicitaties, tokens en vestigingen."
                           VacanciesHref="/employer/vacancies"
                           TokensHref="/employer/tokens"
                           ApplicationsHref="/branch/applicants"
                           EnableRaamflyer="true"
                           AllowOverviewRaamflyer="true" />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.EnterpriseManager">
    <Authorized>
        <EmployerHomePanel Title="Bedrijf dashboard"
                           Lead="Vacatures, tokens, vestigingen en regio’s."
                           VacanciesHref="/employer/vacancies"
                           TokensHref="/employer/tokens"
                           EnableRaamflyer="true"
                           AllowOverviewRaamflyer="true" />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Intermediary">
    <Authorized>
        <EmployerHomePanel Title="Intermediair dashboard"
                           Lead="KPI’s over alle opdrachtgevers. Detail per bedrijf staat in Bedrijvenoverzicht."
                           VacanciesHref="/employer/vacancies"
                           TokensHref="/employer/tokens"
                           ApplicationsHref="/branch/applicants" />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.SalesManager">
    <Authorized>
        <SalesManagerHomePanel />
    </Authorized>
</AuthorizeView>
