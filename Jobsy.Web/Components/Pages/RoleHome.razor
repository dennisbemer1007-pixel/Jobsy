@page "/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Jobsy.Core.Authorization
@using Jobsy.Web.Components.Pages.Admin
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<PageTitle>Home · Lobsy</PageTitle>

<AuthorizeView Roles="@($"{JobsyRoles.BranchManager},{JobsyRoles.RegionalManager},{JobsyRoles.EnterpriseManager},{JobsyRoles.Intermediary}")">
    <Authorized>
        @{
            Navigation.NavigateTo("/werkgever", replace: true);
        }
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Admin">
    <Authorized>
        <AdminHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Candidate">
    <Authorized>
        <CandidateHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.SalesManager">
    <Authorized>
        <SalesManagerHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Ambassadeur">
    <Authorized>
        <AmbassadeurHomePanel />
    </Authorized>
</AuthorizeView>
