@page "/home"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation
@using Jobsy.Core.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<PageTitle>Home · Lobsy</PageTitle>

<AuthorizeView Roles="@($"{JobsyRoles.BranchManager},{JobsyRoles.RegionalManager},{JobsyRoles.EnterpriseManager},{JobsyRoles.Intermediary}")">
    <Authorized>
        @{
            Navigation.NavigateTo("/werkgever", replace: true);
        }
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Admin">
    <Authorized>
        <AdminHomeRedirect />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Candidate">
    <Authorized>
        <CandidateHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.SalesManager">
    <Authorized>
        <Jobsy.Web.Components.Sales.SalesRedirect Href="/sales" />
    </Authorized>
</AuthorizeView>

@* Ambassadeur parked: panel gated by AmbassadorsFeatureMiddleware while AmbassadorsEnabled is off. *@
<AuthorizeView Roles="@JobsyRoles.Ambassadeur">
    <Authorized>
        <AmbassadeurHomePanel />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.SchoolAdmin">
    <Authorized>
        <RedirectToPath Path="/school" />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@JobsyRoles.Teacher">
    <Authorized>
        <RedirectToPath Path="/leraar" />
    </Authorized>
</AuthorizeView>
