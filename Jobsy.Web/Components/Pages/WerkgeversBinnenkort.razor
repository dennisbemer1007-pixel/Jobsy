@page "/werkgevers/binnenkort"
@attribute [AllowAnonymous]
@attribute [NoBlazorRuntime]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using Jobsy.Core.Authorization
@using Jobsy.Core.Features
@using Jobsy.Web.Auth
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<PageTitle>@Culture["WgSoon.Title"] · Lobsy</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
</HeadContent>

@if (!_sendToCandidateShell)
{
<section class="pub-section wg-soon" aria-labelledby="wg-soon-title">
    <header class="pp-doc__hero">
        <h1 id="wg-soon-title" class="pp-doc__title">@Culture[_forCandidate ? "WgSoon.CandidateTitle" : "WgSoon.Title"]</h1>
        <p class="pp-doc__lead">@Culture[_forCandidate ? "WgSoon.CandidateLead" : "WgSoon.Lead"]</p>
    </header>
    @if (!_forCandidate)
    {
        <div class="wg-soon__grid" role="list">
            <article class="wg-soon__card" role="listitem">
                <h2>@Culture["WgSoon.EmployerCard1Title"]</h2>
                <p>@Culture["WgSoon.EmployerCard1Lead"]</p>
                <a href="/login?return=%2Fwerkgever%2Fvacatures">@Culture["WgSoon.EmployerCard1Cta"]</a>
            </article>
            <article class="wg-soon__card" role="listitem">
                <h2>@Culture["WgSoon.EmployerCard2Title"]</h2>
                <p>@Culture["WgSoon.EmployerCard2Lead"]</p>
                <a href="/how-lobsy-works/werkgever">@Culture["WgSoon.EmployerCard2Cta"]</a>
            </article>
            <article class="wg-soon__card" role="listitem">
                <h2>@Culture["WgSoon.EmployerCard3Title"]</h2>
                <p>@Culture["WgSoon.EmployerCard3Lead"]</p>
                <a href="/contact">@Culture["WgSoon.EmployerCard3Cta"]</a>
            </article>
        </div>
    }
    <p class="inline-actions">
        <a class="pub-btn pub-btn--primary" href="/">@Culture["WgSoon.CtaHome"]</a>
    </p>
</section>
}

@code {
    private bool _forCandidate;
    private bool _sendToCandidateShell;

    protected override void OnInitialized()
    {
        var http = HttpContextAccessor.HttpContext;
        var voor = http?.Request.Query["voor"].ToString();
        var user = http?.User;
        var isCandidate = user?.Identity?.IsAuthenticated == true
            && RoleClaimMatching.HasRole(user, JobsyRoles.Candidate);
        _forCandidate = string.Equals(voor, "kandidaat", StringComparison.OrdinalIgnoreCase) || isCandidate;
        if (!isCandidate)
        {
            return;
        }

        _sendToCandidateShell = true;
        Navigation.NavigateTo("/candidate/binnenkort", forceLoad: true);
    }
}
