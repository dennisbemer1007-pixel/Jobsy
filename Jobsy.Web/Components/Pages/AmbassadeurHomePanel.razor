@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IJSRuntime Js
@inject NavigationManager Navigation

<section class="panel-page panel-page--dashboard">
    <header class="panel-header panel-header--dashboard">
        <div>
            <h1>@Culture["Ambassadeur.Dashboard"]</h1>
            <p class="login-lead">@Culture["Ambassadeur.DashboardLead"]</p>
        </div>
        <div class="inline-actions" style="gap:0.75rem;flex-wrap:wrap">
            @if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
            {
                <a class="auth-link" href="/ambassadeur/onboarding">@Culture["Ambassadeur.Onboarding"]</a>
            }
            else
            {
                <a class="auth-link" href="/ambassadeur/toolkit">Toolkit</a>
                <a class="auth-link" href="/ambassadeur/finance">Financieel</a>
            }
        </div>
    </header>

    @if (_error is not null && _dashboard is null && !_loading)
    {
        <p class="state-message error">@_error</p>
    }
    else if (_loading && _dashboard is null)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_dashboard is not null && !_dashboard.IsOnboardingComplete)
    {
        <p class="state-message">Rond eerst je onboarding af om een trackingcode te ontvangen.</p>
        <a class="login-submit" href="/ambassadeur/onboarding" style="display:inline-block;text-decoration:none;text-align:center">Start onboarding</a>
    }
    else if (_dashboard is not null)
    {
        <div class="bento-grid">
            <div class="bento-grid__main">
                <div class="bento-hero" style="--bento-hero-cols:3" aria-label="Prestatie KPI’s">
                    <div class="stat-card stat-card--tile stat-card--emphasis stat-card--featured">
                        <span class="stat-card__top">
                            <span class="stat-card__label">KPI 1 · Geregistreerde kandidaten</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value">@_dashboard.RegisteredCandidates</strong>
                                <span class="stat-card__hint">aangebracht via jouw trackingcode</span>
                            </span>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top">
                            <span class="stat-card__label">KPI 2 · Sollicitaties</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value">@_dashboard.CandidateApplications</strong>
                                <span class="stat-card__hint">verricht door jouw kandidaten</span>
                            </span>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top">
                            <span class="stat-card__label">Trackingcode</span>
                        </span>
                        <span class="stat-card__body">
                            <span class="stat-card__main">
                                <strong class="stat-card__value" style="font-size:1.05rem;letter-spacing:0.03em">@_dashboard.TrackingCode</strong>
                                <button class="btn-compact" type="button" style="margin-top:0.35rem" @onclick="CopyLinkAsync">Kopieer link</button>
                            </span>
                        </span>
                    </div>
                </div>

                <article class="bento-rank__card" style="margin-top:0.85rem" aria-label="Live commissiemeter">
                    <header class="bento-rank__header">
                        <h3>Live commissiemeter</h3>
                        <p>
                            @if (_dashboard.CommissionPercentageOverride is not null)
                            {
                                <text>Admin-override actief · max @_dashboard.MaxCommissionPercentage.ToString("0.##")%</text>
                            }
                            else if (_atMax)
                            {
                                <text>Maximum bereikt (@_dashboard.MaxCommissionPercentage.ToString("0.##")%)</text>
                            }
                            else
                            {
                                <text>Nog @_dashboard.CandidatesUntilNextTier kandidaten tot +@_dashboard.PercentPerThreshold.ToString("0.##")%</text>
                            }
                        </p>
                    </header>
                    <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;padding:0.5rem 0.75rem 1rem">
                        <MetricRing Progress="@_tierProgress"
                                    CenterLabel="@($"{_dashboard.CurrentCommissionPercentage.ToString("0.##")}%")"
                                    SizePx="72" />
                        <div style="flex:1;min-width:12rem">
                            <div style="display:flex;justify-content:space-between;font-size:0.85rem;margin-bottom:0.35rem">
                                <span>Basis @_dashboard.BaseCommissionPercentage.ToString("0.##")%</span>
                                <span>Max @_dashboard.MaxCommissionPercentage.ToString("0.##")%</span>
                            </div>
                            <div style="height:0.55rem;background:var(--surface-muted, #e8eef7);border-radius:999px;overflow:hidden" aria-hidden="true">
                                <div style="height:100%;width:@(_meterWidth.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:#1a7a6d;border-radius:999px"></div>
                            </div>
                            <p class="muted" style="margin:0.5rem 0 0;font-size:0.85rem">
                                Drempel: elke @_dashboard.CandidateThreshold kandidaten → +@_dashboard.PercentPerThreshold.ToString("0.##")%
                                · voortgang in huidige stap: @_progressInStep / @_dashboard.CandidateThreshold
                            </p>
                        </div>
                    </div>
                </article>

                <div class="bento-hero" style="--bento-hero-cols:3;margin-top:0.75rem" aria-label="Financieel">
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top"><span class="stat-card__label">Saldo excl. BTW</span></span>
                        <span class="stat-card__body">
                            <strong class="stat-card__value">€ @_dashboard.BalanceExVat.ToString("0.00")</strong>
                            <span class="stat-card__hint">incl. € @_dashboard.BalanceInclVat.ToString("0.00")</span>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top"><span class="stat-card__label">Niet gefactureerd</span></span>
                        <span class="stat-card__body">
                            <strong class="stat-card__value">€ @_dashboard.UninvoicedExVat.ToString("0.00")</strong>
                        </span>
                    </div>
                    <div class="stat-card stat-card--tile">
                        <span class="stat-card__top"><span class="stat-card__label">Uitkeren</span></span>
                        <span class="stat-card__body">
                            <a class="btn-compact btn-compact--primary" href="/ambassadeur/finance">Naar financieel</a>
                        </span>
                    </div>
                </div>

                <div class="bento-cell bento-cell--split">
                    <article class="bento-rank__card">
                        <header class="bento-rank__header">
                            <h3>Recente kandidaten</h3>
                            <p>Via jouw trackingcode</p>
                        </header>
                        @if (_dashboard.RecentCandidates.Count == 0)
                        {
                            <p class="bento-rank__empty muted">Nog geen kandidaten via jouw code.</p>
                        }
                        else
                        {
                            <ol class="bento-rank__list">
                                @foreach (var c in _dashboard.RecentCandidates.Take(6))
                                {
                                    <li class="bento-rank__row">
                                        <div class="bento-rank__meta">
                                            <strong class="bento-rank__title">@c.FullName</strong>
                                            <span class="bento-rank__sub muted">@c.ApplicationCount sollicitaties</span>
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    </article>

                    <article class="bento-rank__card">
                        <header class="bento-rank__header">
                            <h3>Recente commissies</h3>
                            <p>Per transactie / token</p>
                        </header>
                        @if (_dashboard.RecentLedger.Count == 0)
                        {
                            <p class="bento-rank__empty muted">Nog geen commissies.</p>
                        }
                        else
                        {
                            <ol class="bento-rank__list">
                                @foreach (var e in _dashboard.RecentLedger.Take(6))
                                {
                                    <li class="bento-rank__row">
                                        <div class="bento-rank__meta">
                                            <strong class="bento-rank__title">@e.Kind</strong>
                                            <span class="bento-rank__sub muted">@(e.CompanyName ?? "—") · @e.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                        <span class="bento-rank__value" style="min-width:auto">€ @e.AmountExVat.ToString("0.00")</span>
                                    </li>
                                }
                            </ol>
                        }
                    </article>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private AmbassadeurDashboard? _dashboard;
    private bool _loading = true;
    private string? _error;

    private bool _atMax;
    private double _tierProgress;
    private double _meterWidth;
    private int _progressInStep;

    private string TrackingUrl
    {
        get
        {
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var code = _dashboard?.TrackingCode;
            return string.IsNullOrWhiteSpace(code)
                ? baseUri
                : $"{baseUri}/werven/{Uri.EscapeDataString(code)}";
        }
    }

    private bool _loadStarted;

    protected override Task OnInitializedAsync()
        => TryLoadAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? TryLoadAsync() : Task.CompletedTask;

    private async Task TryLoadAsync()
    {
        if (!HomeDashboardLoad.TryBegin(ref _loadStarted, RendererInfo.IsInteractive))
        {
            return;
        }

        var (data, error) = await HomeDashboardLoad.FetchAsync(async () => await Api.GetMyAmbassadeurDashboardAsync());
        _dashboard = data;
        _error = error;
        if (_dashboard is not null)
        {
            RecalcMeter();
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void RecalcMeter()
    {
        if (_dashboard is null)
        {
            return;
        }

        var threshold = Math.Max(1, _dashboard.CandidateThreshold);
        var registered = Math.Max(0, _dashboard.RegisteredCandidates);
        _progressInStep = registered % threshold;
        _atMax = _dashboard.CurrentCommissionPercentage >= _dashboard.MaxCommissionPercentage
                 && _dashboard.CommissionPercentageOverride is null
                 && _dashboard.CandidatesUntilNextTier == 0;

        // Ring = progress within current threshold step (or 100% at max / override).
        if (_dashboard.CommissionPercentageOverride is not null || _atMax)
        {
            _tierProgress = 100;
        }
        else
        {
            _tierProgress = 100d * _progressInStep / threshold;
        }

        // Bar = position between base and max.
        var span = Math.Max(0.01m, _dashboard.MaxCommissionPercentage - _dashboard.BaseCommissionPercentage);
        var earned = Math.Clamp(
            _dashboard.CurrentCommissionPercentage - _dashboard.BaseCommissionPercentage,
            0m,
            span);
        _meterWidth = (double)(100m * earned / span);
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", TrackingUrl);
        }
        catch
        {
            // Clipboard may be blocked; ignore.
        }
    }
}
