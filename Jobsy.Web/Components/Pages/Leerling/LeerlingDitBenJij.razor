@page "/leerling/dit-ben-jij"
@layout LeerlingReisLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using System.Net.Http.Json
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Core.Scholen
@using Jobsy.Core.Scholen.QuestionSets
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Scholen
@using Jobsy.Web.Services
@inject CultureState Culture
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject IServiceProvider Services
@inject IFeatureFlags Features
@inject LeerlingReisShellState ShellState
@inject LeerlingGroep78ShellTheme ShellTheme

<PageTitle>@Culture["LeerlingStory.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <p class="wrap" style="padding: 2rem 0">@Culture["Common.Loading"]</p>
}
else if (_resultPending)
{
    <section class="wrap card" style="margin-top: 2rem">
        <p class="vr-error" role="alert">@Culture["Leerling.Reis.ResultPending"]</p>
        <button type="button" class="btn btn-main" disabled="@_retryBusy" @onclick="RetryOnce">
            @Culture["Leerling.Reis.Retry"]
        </button>
    </section>
}
else if (_sessionLost)
{
    <section class="wrap card" style="margin-top: 2rem">
        <h1>@Culture["Leerling.Result.Title"]</h1>
        <p class="muted">@Culture["Leerling.Session.Lost"]</p>
        <a class="btn btn-main" href="/leerling/reis">@Culture["Leerling.Reis.Title"]</a>
    </section>
}
else if (_result is null)
{
    <div class="wrap" style="margin-top: 2rem">
        <LeerlingOfflineRetry Busy="@_retryBusy" OnRetry="RetryOffline" />
    </div>
}
else if (_groep78Themed)
{
    <LeerlingGroep78Result Result="_result"
                           JourneyThemeKey="@(_journeyThemeKey ?? PupilJourneyTheme.ZeeExpeditie)"
                           ShowPassport="_passportV2" />
}
else
{
    <div class="ll-reis ll-result" data-testid="leerling-dit-ben-jij">
        <LeerlingCoachCue Text="@Culture["Leerling.Coach.Story"]" />

        <section class="ll-card">
            <p class="ll-question__meta">
                <span class="ll-pill">@Culture["LeerlingStory.DonePill"]</span>
            </p>
            <h1>@Culture["LeerlingStory.Title"]</h1>
            <LeerlingSpeak Text="@_result.Story.Body" SpeechKey="ll-story" />
            <p class="ll-result__story">@_result.Story.Body</p>

            <div class="ll-tile-grid">
                @foreach (var tile in _result.Story.Tiles)
                {
                    <div class="ll-tile">
                        <LeerlingSpeak Text="@SpokenText.Join(tile.KidLabel, tile.Explanation)" SpeechKey="@($"ll-tile-{tile.ModelKey}")" />
                        <p class="ll-tile__label">@tile.KidLabel</p>
                        <p class="ll-tile__value">@tile.Explanation</p>
                    </div>
                }
            </div>

            @if (_result.Likes.Count > 0)
            {
                <h2 class="ll-result__sub">@Culture["LeerlingStory.LikesTitle"]</h2>
                <div class="ll-chips__row">
                    @foreach (var chip in _result.Likes)
                    {
                        <span class="ll-chip is-on is-like">@chip</span>
                    }
                </div>
            }

            <h2 class="ll-result__sub">@Culture["LeerlingStory.JobsTitle"]</h2>
            <LeerlingSpeak Text="@SpokenText.Join(_result.Story.JobIdeas.ToArray())" SpeechKey="ll-jobs" />
            <div class="ll-chips__row">
                @foreach (var job in _result.Story.JobIdeas)
                {
                    <span class="ll-job-idea">@job</span>
                }
            </div>

            <p class="ll-privacy" role="note">@Culture[PupilCopy.Key(_result.QuestionSet, "LeerlingStory.Privacy")]</p>
        </section>

        <div class="ll-result__actions">
            @if (_passportV2)
            {
                <a class="btn-secondary" href="/leerling/paspoort">@Culture["LeerlingStory.PassportButton"]</a>
            }
            <a class="btn-secondary" href="/leerling/pdf">@Culture["LeerlingStory.Pdf"]</a>
            <a class="btn-primary" href="/leerling/droombaan">@Culture["LeerlingStory.CheckDream"]</a>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _resultPending;
    private bool _retryBusy;
    private bool _retried;
    private bool _sessionLost;
    private bool _groep78Themed;
    private string? _journeyThemeKey;
    private PupilResultPageDto? _result;
    private bool _passportV2;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(allowRetry: true);
        var flags = await Features.GetAsync();
        _passportV2 = flags.PupilPassportV2Enabled
                      && _result?.QuestionSet == PupilQuestionSet.Groep78;
    }

    private async Task RetryOnce()
    {
        if (_retryBusy)
        {
            return;
        }

        _retryBusy = true;
        try
        {
            await LoadAsync(allowRetry: false);
        }
        finally
        {
            _retryBusy = false;
        }
    }

    private Task RetryOffline() => LoadAsync(allowRetry: true);

    private async Task LoadAsync(bool allowRetry)
    {
        _loading = true;
        _sessionLost = false;
        _resultPending = false;
        _groep78Themed = false;
        Exception? lastError = null;
        System.Net.HttpStatusCode? lastStatus = null;
        try
        {
            for (var attempt = 0; attempt < PupilLoadRetry.AttemptDelaysMs.Length; attempt++)
            {
                if (PupilLoadRetry.AttemptDelaysMs[attempt] > 0)
                {
                    await Task.Delay(PupilLoadRetry.AttemptDelaysMs[attempt]);
                }

                try
                {
                    using var response = await Api.GetPupilResultResponseAsync();
                    if (PupilLoadRetry.IsSessionLost(response.StatusCode))
                    {
                        _sessionLost = true;
                        _result = null;
                        _resultPending = false;
                        return;
                    }

                    if (response.IsSuccessStatusCode)
                    {
                        _result = await response.Content.ReadFromJsonAsync<PupilResultPageDto>(JobsyApiClient.ApiJson);
                        _resultPending = false;
                        await ApplyShellFromProgressAsync();
                        return;
                    }

                    if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                    {
                        await HandleConflictAsync(allowRetry);
                        return;
                    }

                    lastStatus = response.StatusCode;
                    lastError = null;
                    LeerlingLoadLog.Failed(Services, "result", null, lastStatus, giveUp: false);
                }
                catch (Exception ex) when (PupilLoadRetry.IsSessionLost(ex))
                {
                    _sessionLost = true;
                    _result = null;
                    _resultPending = false;
                    return;
                }
                catch (Exception ex)
                {
                    lastError = ex;
                    lastStatus = ex is HttpRequestException http ? http.StatusCode : null;
                    LeerlingLoadLog.Failed(Services, "result", ex, lastStatus, giveUp: false);
                }
            }

            LeerlingLoadLog.Failed(Services, "result", lastError, lastStatus, giveUp: true);
            _result = null;
            _resultPending = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyShellFromProgressAsync()
    {
        if (_result?.QuestionSet != PupilQuestionSet.Groep78)
        {
            ShellState.Mode = LeerlingReisShellMode.Classic;
            return;
        }

        var progress = await Api.GetPupilProgressAsync();
        if (progress is null || !PupilJourneyTheme.IsValid(progress.JourneyThemeKey))
        {
            ShellState.Mode = LeerlingReisShellMode.Classic;
            return;
        }

        _journeyThemeKey = progress.JourneyThemeKey!;
        ShellState.Mode = ShellModeFor(progress);
        ShellTheme.ApplyJourney(_journeyThemeKey, routeHeader: true);
        _groep78Themed = ShellState.Mode is LeerlingReisShellMode.ZeeExpeditie
                         or LeerlingReisShellMode.Eilandtuin
                         or LeerlingReisShellMode.Sterrenkust;
    }

    private async Task HandleConflictAsync(bool allowRetry)
    {
        var progress = await Api.GetPupilProgressAsync();
        if (progress is not null
            && progress.AnsweredCount >= progress.TotalItems
            && progress.TotalItems > 0)
        {
            if (allowRetry && !_retried)
            {
                _retried = true;
                using var retry = await Api.GetPupilResultResponseAsync();
                if (retry.IsSuccessStatusCode)
                {
                    _result = await retry.Content.ReadFromJsonAsync<PupilResultPageDto>(JobsyApiClient.ApiJson);
                    _resultPending = false;
                    await ApplyShellFromProgressAsync();
                    return;
                }
            }

            _resultPending = true;
            _result = null;
            return;
        }

        _result = null;
        _resultPending = false;
    }

    private static LeerlingReisShellMode ShellModeFor(PupilProgressStateDto state)
    {
        if (state.QuestionSet != PupilQuestionSet.Groep78)
        {
            return LeerlingReisShellMode.Classic;
        }

        if (string.Equals(state.JourneyThemeKey, PupilJourneyTheme.ZeeExpeditie, StringComparison.OrdinalIgnoreCase))
        {
            return LeerlingReisShellMode.ZeeExpeditie;
        }

        if (string.Equals(state.JourneyThemeKey, PupilJourneyTheme.Eilandtuin, StringComparison.OrdinalIgnoreCase))
        {
            return LeerlingReisShellMode.Eilandtuin;
        }

        if (string.Equals(state.JourneyThemeKey, PupilJourneyTheme.Sterrenkust, StringComparison.OrdinalIgnoreCase))
        {
            return LeerlingReisShellMode.Sterrenkust;
        }

        return LeerlingReisShellMode.Classic;
    }
}
