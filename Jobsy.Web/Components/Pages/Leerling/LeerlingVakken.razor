@page "/leerling/vakken"
@layout LeerlingJourneyLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Enums
@using Jobsy.Core.Scholen
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Components.Leerling.Scene
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Scholen
@using Jobsy.Web.Services
@inject CultureState Culture
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>@Culture["Leerling.Vakken.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_sessionLost)
{
    <p class="state-message error">@Culture["Leerling.Session.Lost"]</p>
}
else if (_state is null)
{
    <LeerlingOfflineRetry OnRetry="Reload" />
}
else if (_groep78)
{
    var doneOnPage = DoneCountOnPage();
    var totalOnPage = _pageKeys.Count;
    var remainingOnPage = totalOnPage - doneOnPage;
    var pageProgressPct = totalOnPage == 0 ? 0 : doneOnPage * 100.0 / totalOnPage;

    <div class="ll-vt" data-testid="leerling-vakken">
        <div class="ll-vt-scene-bar" data-testid="ll-vt-scene-bar">
            <span class="ll-vt-scene-bar__tag">@G78SceneTag()</span>
            <span class="ll-vt-scene-bar__t">@Culture["Leerling.Vakken.Heading"]</span>
            <span class="ll-vt-scene-bar__stars" aria-hidden="true">@VakkenTopStarsLine()</span>
        </div>
        <main class="ll-vt-main">
            <div class="ll-vt-hd">
                <div>
                    <h1 class="ll-vt-title">@Culture["Leerling.Vakken.Heading"]</h1>
                    <p class="ll-vt-sub">@Culture["Leerling.Vakken.Intro1"]</p>
                </div>
                <div class="ll-vt-prog" aria-live="polite">
                    <div class="ll-vt-prog__labels">
                        <span>@string.Format(Culture["Leerling.Vakken.PageRemaining"], remainingOnPage)</span>
                        <span>@string.Format(Culture["Leerling.Vakken.PageProgressCount"], doneOnPage, totalOnPage)</span>
                    </div>
                    <div class="ll-vt-prog__bar" role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="@totalOnPage"
                         aria-valuenow="@doneOnPage">
                        <i style="width:@($"{pageProgressPct:0.##}%")"></i>
                    </div>
                </div>
            </div>

            <div class="ll-vt-grid">
                @foreach (var key in _pageKeys)
                {
                    var emoji = SubjectEmoji(key);
                    var complete = SubjectComplete(key);
                    <article class="ll-vt-card @(complete ? "is-done" : null)">
                        <div class="ll-vt-card__head">
                            <span class="ll-vt-card__ic" aria-hidden="true">@emoji</span>
                            <h2 class="ll-vt-card__name">@Culture[PupilVakSubjectLabels.UiKey(key)]</h2>
                            @if (complete)
                            {
                                <span class="ll-vt-card__ok" aria-hidden="true">✓</span>
                            }
                        </div>
                        <div class="ll-vt-q">
                            <div class="ll-vt-ql">@Culture["Leerling.Vakken.Leuk"]</div>
                            <div class="ll-vt-sc ll-vt-scale-btns" role="radiogroup" aria-label="@($"{Culture[PupilVakSubjectLabels.UiKey(key)]} — {Culture["Leerling.Vakken.Leuk"]}")">
                                @for (var v = 1; v <= 5; v++)
                                {
                                    var val = v;
                                    var selected = GetLeuk(key) == val;
                                    <button type="button"
                                            class="ll-vt-scale-btn @(selected ? "is-on" : null)"
                                            role="radio"
                                            aria-checked="@(selected ? "true" : "false")"
                                            disabled="@_busy"
                                            @onclick="() => SetLeuk(key, val)">@val</button>
                                }
                            </div>
                            <div class="ll-vt-ends">
                                <span>@Culture["Leerling.Vakken.ScaleLow"]</span>
                                <span>@Culture["Leerling.Vakken.ScaleHigh"]</span>
                            </div>
                        </div>
                        <div class="ll-vt-q">
                            <div class="ll-vt-ql">@Culture["Leerling.Vakken.Goed"]</div>
                            <div class="ll-vt-sc ll-vt-scale-btns" role="radiogroup" aria-label="@($"{Culture[PupilVakSubjectLabels.UiKey(key)]} — {Culture["Leerling.Vakken.Goed"]}")">
                                @for (var v = 1; v <= 5; v++)
                                {
                                    var val = v;
                                    var selected = GetGoed(key) == val;
                                    <button type="button"
                                            class="ll-vt-scale-btn @(selected ? "is-on" : null)"
                                            role="radio"
                                            aria-checked="@(selected ? "true" : "false")"
                                            disabled="@_busy"
                                            @onclick="() => SetGoed(key, val)">@val</button>
                                }
                            </div>
                            <div class="ll-vt-ends">
                                <span>@Culture["Leerling.Vakken.ScaleLow"]</span>
                                <span>@Culture["Leerling.Vakken.ScaleHigh"]</span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="ll-vt-error" role="alert">@_error</p>
            }

            <div class="ll-vt-foot">
                <button type="button" class="ll-vt-back" disabled="@_busy" @onclick="GoBack">
                    @Culture["Leerling.Vakken.Back"]
                </button>
                <button type="button"
                        class="ll-vt-next"
                        data-testid="ll-vt-next"
                        disabled="@(_busy || !PageComplete())"
                        @onclick="ContinueAsync">
                    @Culture[_page == 1 ? "Leerling.Vakken.Next" : "Leerling.Vakken.Finish"]
                </button>
                <div class="ll-vt-lob">
                    <div class="ll-vt-bub">@VakkenBubbleText()</div>
                    <img src="/leerling/werelden/img/kreeft-portret.png"
                         width="60"
                         height="60"
                         alt="Lobsy de kreeft" />
                </div>
            </div>
        </main>
    </div>
}
else
{
    <LeerlingCoachCue Text="@Culture["Leerling.Vakken.Kicker"]" />
    <LeerlingScene Depth="@SceneDepth" />

    <div class="ll-reis ll-vakken" data-testid="leerling-vakken">
        <section class="ll-card ll-vakken-card">
            <div class="ll-progress-dots" role="group" aria-label="@Culture["Leerling.Vakken.Progress"]">
                @for (var i = 1; i <= 5; i++)
                {
                    var on = i <= (_page == 1 ? 4 : 5);
                    var now = _page == 1 ? i == 4 : i == 5;
                    <span class="ll-progress-dots__dot @(on ? "is-on" : null) @(now ? "is-now" : null)" aria-hidden="true"></span>
                }
            </div>

            <p class="ll-question__world">@Culture["Leerling.Vakken.Kicker"]</p>
            <h1 class="ll-question__text">@Culture["Leerling.Vakken.Heading"]</h1>
            <p class="muted">@Culture[_page == 1 ? "Leerling.Vakken.Intro1" : "Leerling.Vakken.Intro2"]</p>

            <div class="ll-vakken__grid">
                @foreach (var key in _pageKeys)
                {
                    var emoji = SubjectEmoji(key);
                    <article class="ll-vakken__subject">
                        <div class="ll-vakken__subject-head">
                            <span class="ll-vakken__emoji" aria-hidden="true">@emoji</span>
                            <h2>@Culture[PupilVakSubjectLabels.UiKey(key)]</h2>
                        </div>
                        <div class="ll-vakken__scale">
                            <span class="ll-vakken__scale-label">@Culture["Leerling.Vakken.Leuk"]</span>
                            <div class="ll-vakken__scale-btns" role="radiogroup" aria-label="@($"{Culture[PupilVakSubjectLabels.UiKey(key)]} — {Culture["Leerling.Vakken.Leuk"]}")">
                                @for (var v = 1; v <= 5; v++)
                                {
                                    var val = v;
                                    var selected = GetLeuk(key) == val;
                                    <button type="button"
                                            class="ll-vakken__btn @(selected ? "is-on" : null)"
                                            role="radio"
                                            aria-checked="@(selected ? "true" : "false")"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            disabled="@_busy"
                                            @onclick="() => SetLeuk(key, val)">@val</button>
                                }
                            </div>
                        </div>
                        <div class="ll-vakken__scale">
                            <span class="ll-vakken__scale-label">@Culture["Leerling.Vakken.Goed"]</span>
                            <div class="ll-vakken__scale-btns" role="radiogroup" aria-label="@($"{Culture[PupilVakSubjectLabels.UiKey(key)]} — {Culture["Leerling.Vakken.Goed"]}")">
                                @for (var v = 1; v <= 5; v++)
                                {
                                    var val = v;
                                    var selected = GetGoed(key) == val;
                                    <button type="button"
                                            class="ll-vakken__btn @(selected ? "is-on" : null)"
                                            role="radio"
                                            aria-checked="@(selected ? "true" : "false")"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            disabled="@_busy"
                                            @onclick="() => SetGoed(key, val)">@val</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="ll-error" role="alert">@_error</p>
            }

            <div class="ll-question__nav">
                <button type="button" class="btn-secondary" disabled="@_busy" @onclick="GoBack">
                    @Culture["Leerling.Vakken.Back"]
                </button>
                <button type="button" class="btn-primary" disabled="@(_busy || !PageComplete())" @onclick="ContinueAsync">
                    @Culture[_page == 1 ? "Leerling.Vakken.Next" : "Leerling.Vakken.Finish"]
                </button>
            </div>
        </section>

        <aside class="ll-lob-zone" aria-hidden="@(_page != 1)">
            @if (_page == 1)
            {
                <p class="ll-bubble">@Culture["Leerling.Vakken.Bubble"]</p>
            }
            <LeerlingLobster PlatesShed="@LobsterPlatesShed"
                             NewShell="@_state.NewShell"
                             Label="Lobsy de kreeft" />
        </aside>

        <aside class="ll-lob-zone ll-lob-zone--mobile" aria-hidden="@(_page != 1)">
            @if (_page == 1)
            {
                <p class="ll-bubble">@Culture["Leerling.Vakken.Bubble"]</p>
            }
            <LeerlingLobster PlatesShed="@LobsterPlatesShed"
                             NewShell="@_state.NewShell"
                             Mobile="true"
                             Label="Lobsy de kreeft" />
        </aside>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    private PupilProgressStateDto? _state;
    private bool _loading = true;
    private bool _sessionLost;
    private bool _busy;
    private string? _error;
    private int _page = 1;
    private readonly Dictionary<string, (int Leuk, int Goed)> _scores = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> _pageKeys = [];

    private int SceneDepth => 9;
    private bool _groep78;
    private string? _themeKey;

    private int LobsterPlatesShed => Math.Clamp(_state?.PlatesShed ?? 10, 0, 10);

    protected override async Task OnInitializedAsync()
    {
        ApplyPageFromQuery();
        await Reload();
    }

    protected override void OnParametersSet()
    {
        ApplyPageFromQuery();
    }

    private void ApplyPageFromQuery()
    {
        _page = Page == 2 ? 2 : 1;
        _pageKeys = PupilVakScores.KeysForPage(_page);
    }

    private async Task Reload()
    {
        _loading = true;
        _sessionLost = false;
        var outcome = await PupilLoadRetry.RunAsync(() => Api.GetPupilProgressAsync(), Services, "vakken");
        if (outcome.SessionLost)
        {
            _sessionLost = true;
            _state = null;
        }
        else if (outcome.Value is null)
        {
            _state = null;
        }
        else if (PupilGroep78Navigation.RedirectIfThemeMissing(Nav, outcome.Value))
        {
            return;
        }
        else
        {
            ApplyLoaded(outcome.Value);
        }

        _loading = false;
    }

    private void ApplyLoaded(PupilProgressStateDto state)
    {
        _state = state;
        _groep78 = state.QuestionSet == PupilQuestionSet.Groep78
                   && PupilJourneyTheme.IsValid(state.JourneyThemeKey);
        _themeKey = state.JourneyThemeKey;
        if (state.Completed || string.Equals(state.NextStep, "done", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/leerling/dit-ben-jij");
            return;
        }

        if (string.Equals(state.NextStep, "vakken", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Nav.NavigateTo("/leerling/reis");
    }

    private int? GetLeuk(string key)
        => _scores.TryGetValue(key, out var p) ? p.Leuk : null;

    private int? GetGoed(string key)
        => _scores.TryGetValue(key, out var p) ? p.Goed : null;

    private void SetLeuk(string key, int value)
    {
        _scores.TryGetValue(key, out var p);
        _scores[key] = (value, p.Goed);
        StateHasChanged();
    }

    private void SetGoed(string key, int value)
    {
        _scores.TryGetValue(key, out var p);
        _scores[key] = (p.Leuk, value);
        StateHasChanged();
    }

    private bool SubjectComplete(string key)
    {
        if (!_scores.TryGetValue(key, out var p))
        {
            return false;
        }

        return p.Leuk is >= 1 and <= 5 && p.Goed is >= 1 and <= 5;
    }

    private int DoneCountOnPage()
    {
        var n = 0;
        foreach (var key in _pageKeys)
        {
            if (SubjectComplete(key))
            {
                n++;
            }
        }

        return n;
    }

    private string G78SceneTag()
    {
        var themeTitle = _themeKey switch
        {
            PupilJourneyTheme.Eilandtuin => Culture["Leerling.Wereld.Tuin.Title"],
            PupilJourneyTheme.Sterrenkust => Culture["Leerling.Wereld.Ster.Title"],
            _ => Culture["Leerling.Wereld.Zee.Title"]
        };
        var spot = Culture[PupilJourneyTheme.WorldTitleKey(_themeKey, "lagune")];
        return $"{themeTitle} · {spot}";
    }

    private string VakkenTopStarsLine()
    {
        var filled = _page == 1 ? 3 : 4;
        var parts = new string[4];
        for (var i = 0; i < 4; i++)
        {
            parts[i] = i < filled ? "★" : "☆";
        }

        return $"{string.Join(" ", parts)} {string.Format(Culture["Leerling.Vakken.PageOf"], _page, 2)}";
    }

    private bool PageComplete()
    {
        foreach (var key in _pageKeys)
        {
            if (!_scores.TryGetValue(key, out var p) || p.Leuk is < 1 or > 5 || p.Goed is < 1 or > 5)
            {
                return false;
            }
        }

        return true;
    }

    private async Task ContinueAsync()
    {
        if (_busy || !PageComplete())
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var inputs = _pageKeys
                .Select(k => new PupilVakScoreInput(k, _scores[k].Leuk, _scores[k].Goed))
                .ToList();
            var result = await Api.PutPupilVakScoresAsync(inputs);
            if (result is null)
            {
                _error = Culture["Leerling.Vakken.SaveFailed"];
                return;
            }

            if (_page == 1)
            {
                Nav.NavigateTo("/leerling/vakken?page=2");
                return;
            }

            if (result.JourneyCompleted || string.Equals(result.NextStep, "done", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/leerling/dit-ben-jij");
                return;
            }

            Nav.NavigateTo("/leerling/reis");
        }
        catch
        {
            _error = Culture["Leerling.Vakken.SaveFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack()
    {
        if (_page == 2)
        {
            Nav.NavigateTo("/leerling/vakken");
            return;
        }

        Nav.NavigateTo("/leerling/reis");
    }

    private string VakkenBubbleText()
    {
        var remaining = RemainingSubjectsOnPage();
        if (remaining <= 0)
        {
            return Culture["Leerling.Vakken.Bubble.PageDone"];
        }

        return string.Format(Culture["Leerling.Vakken.PageRemaining"], remaining);
    }

    private int RemainingSubjectsOnPage()
        => _pageKeys.Count - DoneCountOnPage();

    private static string SubjectEmoji(string key) => key switch
    {
        "rekenen" => "🔢",
        "lezen" => "📖",
        "spelling" => "✏️",
        "taal" => "💬",
        "engels" => "🌍",
        "schrijven" => "📝",
        "aardrijkskunde" => "🗺️",
        "geschiedenis" => "🏛️",
        "natuur-techniek" => "🔬",
        "tekenen" => "🎨",
        "muziek" => "🎵",
        "gym" => "⚽",
        _ => "📚"
    };
}
