@page "/leerling/start"
@layout LeerlingLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Scholen
@using Jobsy.Core.Scholen.QuestionSets
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Scholen
@using Jobsy.Web.Services
@inject CultureState Culture
@inject NavigationManager Nav
@inject JobsyApiClient Api
@inject IPupilQuestionSetRegistry Registry

<PageTitle>@Culture["Leerling.Start.Title"] · Lobsy</PageTitle>

<div class="ll-start">
    <LeerlingCoachCue Text="@Culture["Leerling.Coach.Start"]" />
    <section class="ll-card">
        <h1>@Culture["Leerling.Start.Title"]</h1>
        <LeerlingSpeak Text="@Spoken" SpeechKey="ll-start" />
        <p class="muted">@Culture["Leerling.Start.Lead"]</p>
        <ol class="ll-worlds">
            @foreach (var plan in (_def?.Worlds ?? Array.Empty<PupilWorldPlan>()))
            {
                var w = PupilWorldCatalog.Find(plan.WorldKey);
                if (w is null)
                {
                    continue;
                }

                var n = PupilWorldCatalog.TestWorldNumber(w.Key);
                var titleKey = _visualTheme is not null
                    ? PupilJourneyTheme.WorldTitleKey(_visualTheme, w.Key)
                    : w.TitleKey;
                var subKey = _visualTheme is not null
                    ? PupilJourneyTheme.WorldSubtitleKey(_visualTheme, w.Key)
                    : w.SubtitleKey;
                <li>
                    <span class="ll-worlds__n">@n</span>
                    <div>
                        <strong>@Culture[titleKey]</strong>
                        <small>@Culture[subKey]</small>
                    </div>
                </li>
            }
        </ol>
        <ul class="ll-start__notes">
            <li>@Culture[_def?.StartTimeKey ?? "Leerling.Start.NoteTime"]</li>
            <li>@Culture["Leerling.Start.NoteNoWrong"]</li>
            <li>@Culture["Leerling.Start.NotePause"]</li>
        </ul>
        @if (_canChangeTheme)
        {
            <p class="ll-start__theme">
                <a href="/leerling/werelden">@Culture["Leerling.Theme.Change"]</a>
            </p>
        }
        <a class="btn-primary" href="/leerling/reis">@Culture["Leerling.Start.Begin"]</a>
    </section>
</div>

@code {
    private PupilQuestionSetDef? _def;
    private string? _visualTheme;
    private bool _canChangeTheme;

    private string Spoken => SpokenText.Join(
        Culture["Leerling.Start.Title"],
        Culture["Leerling.Start.Lead"],
        Culture[_def?.StartTimeKey ?? "Leerling.Start.NoteTime"],
        Culture["Leerling.Start.NoteNoWrong"],
        Culture["Leerling.Start.NotePause"]);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var progress = await Api.GetPupilProgressAsync();
            if (progress is not null)
            {
                _def = Registry.Get(progress.QuestionSet);
                if (PupilJourneyTheme.RequiresThemeChoice(progress.QuestionSet, progress.VisualThemeKey))
                {
                    Nav.NavigateTo("/leerling/werelden");
                    return;
                }

                _visualTheme = progress.VisualThemeKey;
                _canChangeTheme = progress.CanChangeVisualTheme;
            }
        }
        catch
        {
            _def = null;
        }

        _def ??= Registry.Get(Jobsy.Core.Enums.PupilQuestionSet.Vo);
    }
}
