@page "/leerling/droombaan"
@layout LeerlingLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Rules
@using Jobsy.Core.Scholen
@using Jobsy.Core.Scholen.QuestionSets
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Scholen
@using Jobsy.Web.Services
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IServiceProvider Services
@implements IDisposable
<PageTitle>@Culture["LeerlingDroom.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_sessionLost)
{
    <section class="ll-card">
        <p class="state-message error">@Culture["Leerling.Session.Lost"]</p>
    </section>
}
else if (_result is null)
{
    <LeerlingOfflineRetry OnRetry="RetryLoadAsync" />
}
else
{
    <div class="ll-reis ll-dream" data-testid="leerling-droombaan">
        <LeerlingCoachCue Text="@CoachHint" />

        <section class="ll-card">
            <p class="ll-question__world">@Culture["LeerlingDroom.Title"]</p>
            <h1>@Culture["LeerlingDroom.Lead"]</h1>
            <LeerlingSpeak Text="@Spoken" SpeechKey="ll-dream" />

            <label class="ll-field">
                <span class="visually-hidden">@Culture["LeerlingDroom.Search"]</span>
                <input type="search"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="@Culture["LeerlingDroom.Search"]"
                       autocomplete="off"
                       enterkeyhint="search"
                       data-testid="leerling-droombaan-search" />
            </label>

            @if (_matches.Count > 0)
            {
                <ul class="ll-dream__matches">
                    @foreach (var job in _matches)
                    {
                        <li>
                            <button type="button" class="ll-dream__pick" @onclick="() => SelectJob(job.Key)">
                                @job.TitleNl
                            </button>
                        </li>
                    }
                </ul>
            }

            <button type="button" class="btn-secondary ll-dream__undecided" @onclick="() => SelectJob(PupilDreamJobFit.UndecidedKey)">
                @Culture["LeerlingDroom.Undecided"]
            </button>

            @if (_dream is not null && !string.IsNullOrWhiteSpace(_dream.JobKey)
                 && !string.Equals(_dream.JobKey, PupilDreamJobFit.UndecidedKey, StringComparison.OrdinalIgnoreCase))
            {
                <h2 class="ll-result__sub">@Culture["LeerlingDroom.HaveTitle"]</h2>
                <ul class="ll-dream__list ll-dream__list--have">
                    @foreach (var item in _dream.HaveItems)
                    {
                        <li>@item</li>
                    }
                </ul>

                @if (_dream.LearnItems.Count > 0)
                {
                    <h2 class="ll-result__sub">@Culture["LeerlingDroom.NeedTitle"]</h2>
                    <ul class="ll-dream__list ll-dream__list--need">
                        @foreach (var item in _dream.LearnItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }

                @if (_dream.RouteSteps.Count > 0)
                {
                    <ul class="ll-dream__route">
                        @foreach (var step in _dream.RouteSteps)
                        {
                            <li>@step</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(_dream.Encouragement))
                {
                    <p class="ll-dream__cheer">@_dream.Encouragement</p>
                }
            }
            else if (string.Equals(_dream?.JobKey, PupilDreamJobFit.UndecidedKey, StringComparison.OrdinalIgnoreCase))
            {
                <h2 class="ll-result__sub">@Culture["LeerlingStory.JobsTitle"]</h2>
                <div class="ll-chips__row">
                    @foreach (var job in _result.Story.JobIdeas)
                    {
                        <span class="ll-job-idea">@job</span>
                    }
                </div>
                <p>@Culture[PupilCopy.Key(_result.QuestionSet, "LeerlingDroom.UndecidedHint")]</p>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="ll-error" role="alert">@_error</p>
            }
        </section>

        <div class="ll-result__actions">
            <a class="btn-secondary" href="/leerling/dit-ben-jij">@Culture["LeerlingDroom.OtherJob"]</a>
            @if (_result.QuestionSet == PupilQuestionSet.Vo)
            {
                <a class="btn-secondary" href="/leerling/vo-paspoort">@Culture["LeerlingPassport.Vo.Form.Title"]</a>
            }
            <a class="btn-primary" href="/leerling/pdf">@Culture["LeerlingDroom.SavePdf"]</a>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _sessionLost;
    private PupilResultPageDto? _result;
    private DreamJobRouteStubDto? _dream;
    private string _search = "";
    private bool _searchTouched;
    private bool _contentReady;
    private Task? _initialLoadTask;
    private IReadOnlyList<DreamJob> _matches = [];
    private string? _error;

    private string CoachHint =>
        !string.IsNullOrWhiteSpace(_dream?.JobTitle)
            ? $"{_dream.JobTitle}? Mooi."
            : Culture["Leerling.Coach.Dream"];

    private CancellationTokenSource? _matchDebounce;

    private string Spoken
    {
        get
        {
            var parts = new List<string> { Culture["LeerlingDroom.Lead"] };
            if (_dream?.HaveItems is { Count: > 0 })
            {
                parts.AddRange(_dream.HaveItems);
            }

            if (_dream?.LearnItems is { Count: > 0 })
            {
                parts.AddRange(_dream.LearnItems);
            }

            if (_result?.Story.JobIdeas is { Count: > 0 }
                && string.Equals(_dream?.JobKey, PupilDreamJobFit.UndecidedKey, StringComparison.OrdinalIgnoreCase))
            {
                parts.AddRange(_result.Story.JobIdeas);
            }

            return SpokenText.Join(parts.ToArray());
        }
    }

    protected override Task OnInitializedAsync()
        => _initialLoadTask ??= LoadAsync(isInitial: true);

    private Task RetryLoadAsync() => LoadAsync(isInitial: false);

    private async Task LoadAsync(bool isInitial = false)
    {
        if (isInitial && _contentReady)
        {
            return;
        }

        if (!_contentReady)
        {
            _loading = true;
        }

        _sessionLost = false;
        try
        {
            var outcome = await PupilLoadRetry.RunAsync(() => Api.GetPupilResultAsync(), Services, "droombaan");
            if (outcome.SessionLost)
            {
                _sessionLost = true;
                _result = null;
                _dream = null;
                return;
            }

            if (outcome.Value is null)
            {
                _result = null;
                _dream = null;
                return;
            }

            _result = outcome.Value;
            _dream = _result.DreamJob;
            _contentReady = true;
            HydrateSearchFromDream();
        }
        finally
        {
            _loading = false;
        }
    }

    private void HydrateSearchFromDream()
    {
        if (_searchTouched || !string.IsNullOrWhiteSpace(_search))
        {
            return;
        }

        var title = _dream?.JobTitle;
        if (!string.IsNullOrWhiteSpace(title))
        {
            _search = title;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTouched = true;
        _search = e.Value?.ToString() ?? "";
        ScheduleMatchUpdate();
    }

    private void ScheduleMatchUpdate()
    {
        _matchDebounce?.Cancel();
        _matchDebounce?.Dispose();
        _matchDebounce = new CancellationTokenSource();
        var token = _matchDebounce.Token;
        _ = UpdateMatchesDebouncedAsync(token);
    }

    private async Task UpdateMatchesDebouncedAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(200, cancellationToken);
            var query = _search;
            _matches = string.IsNullOrWhiteSpace(query) ? [] : DreamJobCatalog.Search(query, 8);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer keystroke
        }
    }

    private async Task SelectJob(string key)
    {
        _error = null;
        try
        {
            var resp = await Api.SavePupilDreamJobAsync(key);
            if (resp is null)
            {
                _error = "Kon droombaan niet bewaren.";
                return;
            }

            _dream = resp.DreamJob;
            if (!string.Equals(key, PupilDreamJobFit.UndecidedKey, StringComparison.OrdinalIgnoreCase))
            {
                _searchTouched = false;
                _search = resp.DreamJob.JobTitle ?? _search;
            }

            _matches = [];
        }
        catch
        {
            _error = "Kon droombaan niet bewaren.";
        }
    }

    public void Dispose()
    {
        _matchDebounce?.Cancel();
        _matchDebounce?.Dispose();
    }
}
