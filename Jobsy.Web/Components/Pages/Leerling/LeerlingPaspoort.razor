@page "/leerling/paspoort"
@layout LeerlingLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Features
@using Jobsy.Core.Scholen.PupilPassport
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Services
@implements IDisposable
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IFeatureFlags Features

<PageTitle>@Culture["LeerlingPassport.Page.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!_enabled)
{
    <div class="ll-reis" data-testid="leerling-paspoort-disabled">
        <section class="ll-card">
            <p class="muted">@Culture["LeerlingPassport.FeatureDisabled"]</p>
            <a class="btn-primary" href="/leerling/dit-ben-jij">@Culture["LeerlingPassport.Page.Back"]</a>
        </section>
    </div>
}
else if (_model is null)
{
    <section class="ll-card">
        <p class="ll-error" role="alert">@Culture["Leerling.Reis.ResultPending"]</p>
        <a class="btn-primary" href="/leerling/dit-ben-jij">@Culture["LeerlingPassport.Page.Back"]</a>
    </section>
}
else
{
    <div class="ll-reis" data-testid="leerling-paspoort-page">
        <div class="lp-g78-page-tools">
            <LanguageSelector />
        </div>
        <LeerlingPaspoortG78View Model="_model"
                                 AllowNameEdit="true"
                                 DisplayName="@_displayName"
                                 DisplayNameChanged="OnNameChanged" />
        <div class="ll-result__actions">
            <a class="btn-secondary" href="/leerling/dit-ben-jij">@Culture["LeerlingPassport.Page.Back"]</a>
            <a class="btn-secondary" href="@PdfHref">@Culture["LeerlingPassport.Page.Pdf"]</a>
            <a class="btn-primary" href="/leerling/droombaan">@Culture["LeerlingStory.CheckDream"]</a>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _enabled;
    private PupilG78PassportWebDto? _model;
    private string? _displayName;

    private string PdfHref
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_displayName))
            {
                parts.Add($"naam={Uri.EscapeDataString(_displayName)}");
            }

            if (!string.IsNullOrWhiteSpace(_languageQuery))
            {
                parts.Add($"lang={Uri.EscapeDataString(_languageQuery)}");
            }

            return parts.Count == 0 ? "/leerling/pdf" : $"/leerling/pdf?{string.Join("&", parts)}";
        }
    }

    private string? _languageQuery;

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        var flagsTask = Features.GetAsync();
        await Culture.InitializeAsync();
        var flags = await flagsTask;
        _enabled = flags.PupilPassportV2Enabled;
        if (!_enabled)
        {
            _loading = false;
            return;
        }

        await ReloadPassportAsync();
        _loading = false;
    }

    private async Task ReloadPassportAsync()
    {
        _languageQuery = Culture.Language;
        _model = await Api.GetPupilG78PassportAsync(language: _languageQuery);
        _enabled = _model?.Enabled == true;
        _displayName = _model?.DisplayName;
    }

    private Task OnNameChanged(string? name)
    {
        _displayName = name;
        return Task.CompletedTask;
    }

    private void OnCultureChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadPassportAsync();
        StateHasChanged();
    });

    public void Dispose() => Culture.Changed -= OnCultureChanged;
}
