@page "/leerling/eiland"
@page "/leerling/eiland/stap-2"
@layout LeerlingReisLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Enums
@using Jobsy.Core.Scholen
@using Jobsy.Core.Scholen.QuestionSets
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Scholen
@using Jobsy.Web.Services
@inject CultureState Culture
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject IPupilQuestionSetRegistry Registry
@inject IServiceProvider Services
@inject LeerlingReisShellState ShellState
@inject LeerlingGroep78ShellTheme ShellTheme
@implements IDisposable

<PageTitle>@(_partBreak ? Culture["Leerling.Vo.PartBreak.DocumentTitle"] : Culture["Leerling.Island.Title"]) · Lobsy</PageTitle>

@if (_windowClosed)
{
    <section class="ll-card">
        <h1>@Culture["Leerling.WindowClosed.Title"]</h1>
        <p>@Culture[PupilCopy.Key(_state?.QuestionSet ?? _def?.Set ?? PupilQuestionSet.Vo, "Leerling.WindowClosed.Body")]</p>
    </section>
}
else if (_partBreak)
{
    <LeerlingVoPartBreak />
}
else if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_sessionLost)
{
    <p class="state-message error">@Culture["Leerling.Session.Lost"]</p>
}
else if (_state is null)
{
    <LeerlingOfflineRetry OnRetry="Reload" />
}
else if (_themedGroep78 && !_step2)
{
    <LeerlingGroep78EilandLeuk State="_state"
                               JourneyThemeKey="@_journeyThemeKey"
                               Likes="_likes"
                               LikeOtherOpen="_likeOtherOpen"
                               LikeOther="_likeOther"
                               Busy="_busy"
                               Offline="_offline"
                               Error="_error"
                               OnToggleLike="ToggleLike"
                               OnToggleLikeOther="ToggleLikeOtherOpen"
                               OnLikeOtherChanged="SetLikeOther"
                               OnPrev="GoPrevThemed"
                               OnContinue="SaveStep1Themed"
                               OnReload="Reload" />
}
else
{
    <div class="ll-reis ll-island">
        <section class="ll-card ll-island-card">
            @if (!_themedGroep78)
            {
                <div class="ll-progress-bar" role="progressbar" aria-label="@Culture["Leerling.Island.ProgressLabel"]">
                    <span class="ll-progress-bar__fill" style="width:@IslandProgressPercent()"></span>
                </div>
                <p class="ll-question__meta ll-question__meta--muted">@IslandBetween()</p>
                <p class="ll-question__world">@Culture["Leerling.World.Island.Title"]</p>
            }

            @if (!_step2)
            {
                <h1 class="ll-question__text">@Culture["Leerling.Island.Lead"]</h1>
                @if (!_themedGroep78)
                {
                    <LeerlingCoachCue Text="@Culture["Leerling.Coach.Island"]" />
                    <LeerlingSpeak Text="@Culture["Leerling.Island.Lead"]" SpeechKey="ll-island" />
                }

                <fieldset class="ll-chips">
                    <legend>@Culture["Leerling.Island.Likes"]</legend>
                    <div class="ll-chips__row" role="group">
                        @foreach (var chip in PupilInterestChipCatalog.LikeChips)
                        {
                            var on = _likes.Contains(chip.Key);
                            <button type="button"
                                    class="ll-chip @(on ? "is-on is-like" : null)"
                                    aria-pressed="@on"
                                    @onclick="() => ToggleLike(chip.Key)">
                                @Culture[chip.LabelKey]
                            </button>
                        }
                        <button type="button"
                                class="ll-chip ll-chip--other @(_likeOtherOpen ? "is-on" : null)"
                                aria-expanded="@_likeOtherOpen"
                                @onclick="() => _likeOtherOpen = !_likeOtherOpen">
                            + @Culture["Leerling.Island.Other"]
                        </button>
                    </div>
                    @if (_likeOtherOpen)
                    {
                        <label class="ll-other">
                            <span class="visually-hidden">@Culture["Leerling.Island.Other"]</span>
                            <input maxlength="24"
                                   @bind="_likeOther"
                                   @bind:event="oninput"
                                   placeholder="@Culture["Leerling.Island.OtherPlaceholder"]"
                                   autocomplete="off" />
                        </label>
                    }
                </fieldset>
            }
            else
            {
                <h1 class="ll-question__text">@Culture["Leerling.Island.Lead"]</h1>
                @if (!_themedGroep78)
                {
                    <LeerlingCoachCue Text="@Culture["Leerling.Coach.Island"]" />
                    <LeerlingSpeak Text="@Culture["Leerling.Island.Lead"]" SpeechKey="ll-island" />
                }

                <fieldset class="ll-chips">
                    <legend>@Culture["Leerling.Island.Dislikes"]</legend>
                    <div class="ll-chips__row" role="group">
                        @foreach (var chip in PupilInterestChipCatalog.DislikeChips)
                        {
                            var on = _dislikes.Contains(chip.Key);
                            <button type="button"
                                    class="ll-chip @(on ? "is-on is-dislike" : null)"
                                    aria-pressed="@on"
                                    @onclick="() => ToggleDislike(chip.Key)">
                                @Culture[chip.LabelKey]
                            </button>
                        }
                        <button type="button"
                                class="ll-chip ll-chip--other @(_dislikeOtherOpen ? "is-on" : null)"
                                aria-expanded="@_dislikeOtherOpen"
                                @onclick="() => _dislikeOtherOpen = !_dislikeOtherOpen">
                            + @Culture["Leerling.Island.Other"]
                        </button>
                    </div>
                    @if (_dislikeOtherOpen)
                    {
                        <label class="ll-other">
                            <span class="visually-hidden">@Culture["Leerling.Island.Other"]</span>
                            <input maxlength="24"
                                   @bind="_dislikeOther"
                                   @bind:event="oninput"
                                   placeholder="@Culture["Leerling.Island.OtherPlaceholder"]"
                                   autocomplete="off" />
                        </label>
                    }
                </fieldset>
            }

            <p class="ll-island__warn" role="note">
                <span aria-hidden="true">!</span>
                @Culture["Leerling.Island.OtherHint"]
            </p>

            @if (_offline)
            {
                <p class="ll-error" role="alert">@Culture["Leerling.Reis.Offline"]</p>
                <button type="button" class="btn-secondary" disabled="@_busy" @onclick="Reload">
                    @Culture["Leerling.Reis.Retry"]
                </button>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <p class="ll-error" role="alert">@_error</p>
            }

            <div class="ll-question__nav">
                @if (_step2)
                {
                    <button type="button" class="btn-secondary" disabled="@_busy" @onclick="GoPrevStep">
                        @Culture["Leerling.Reis.Prev"]
                    </button>
                }
                else if (!_themedGroep78)
                {
                    <a class="btn-secondary" href="/leerling/reis">@Culture["Leerling.Reis.Prev"]</a>
                }

                @if (_step2 || !_themedGroep78)
                {
                    <button type="button" class="btn-primary" disabled="@_busy" @onclick="Save">
                        @Culture["Leerling.Island.Continue"]
                    </button>
                }
            </div>
        </section>
    </div>
}

@code {
    private PupilProgressStateDto? _state;
    private PupilQuestionSetDef? _def;
    private bool _loading = true;
    private bool _windowClosed;
    private bool _busy;
    private bool _partBreak;
    private bool _offline;
    private bool _sessionLost;
    private bool _step2;
    private bool _themedGroep78;
    private string _journeyThemeKey = PupilJourneyTheme.ZeeExpeditie;
    private string? _error;
    private readonly HashSet<string> _likes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _dislikes = new(StringComparer.Ordinal);
    private bool _likeOtherOpen;
    private bool _dislikeOtherOpen;
    private string _likeOther = "";
    private string _dislikeOther = "";

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        SyncStepFromUri();
        await Reload();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncStepFromUri();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncStepFromUri()
    {
        _step2 = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("leerling/eiland/stap-2", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private async Task Reload()
    {
        var previous = _state;
        _loading = previous is null;
        _offline = false;
        _sessionLost = false;
        var outcome = await PupilLoadRetry.RunAsync(() => Api.GetPupilProgressAsync(), Services, "eiland");
        if (outcome.SessionLost)
        {
            _sessionLost = true;
            _state = null;
            _def = null;
        }
        else if (outcome.Value is null)
        {
            if (previous is null)
            {
                _state = null;
                _def = null;
                _offline = true;
            }
            else
            {
                _state = previous;
                _offline = true;
            }
        }
        else
        {
            ApplyLoaded(outcome.Value);
        }

        _loading = false;
    }

    private void ApplyLoaded(PupilProgressStateDto state)
    {
        _state = state;
        _offline = false;
        _def = Registry.Get(state.QuestionSet);
        _themedGroep78 = IsThemedGroep78(state);
        _journeyThemeKey = state.JourneyThemeKey ?? PupilJourneyTheme.ZeeExpeditie;
        ApplyShell(state);

        if (state.Completed)
        {
            Nav.NavigateTo("/leerling/dit-ben-jij");
            return;
        }

        if (!state.WindowOpen)
        {
            _windowClosed = true;
            return;
        }

        var atIsland = state.NeedsIsland
                       || string.Equals(state.NextStep, "island", StringComparison.OrdinalIgnoreCase);
        if (!atIsland)
        {
            Nav.NavigateTo("/leerling/reis");
            return;
        }

        _likes.Clear();
        foreach (var k in state.Likes)
        {
            _likes.Add(k);
        }

        _dislikes.Clear();
        foreach (var k in state.Dislikes)
        {
            _dislikes.Add(k);
        }

        _likeOther = state.LikeOtherWord ?? "";
        _dislikeOther = state.DislikeOtherWord ?? "";
        _likeOtherOpen = !string.IsNullOrEmpty(_likeOther);
        _dislikeOtherOpen = !string.IsNullOrEmpty(_dislikeOther);
    }

    private static bool IsThemedGroep78(PupilProgressStateDto state)
    {
        if (state.QuestionSet != PupilQuestionSet.Groep78)
        {
            return false;
        }

        return string.Equals(state.JourneyThemeKey, PupilJourneyTheme.ZeeExpeditie, StringComparison.OrdinalIgnoreCase)
               || string.Equals(state.JourneyThemeKey, PupilJourneyTheme.Eilandtuin, StringComparison.OrdinalIgnoreCase)
               || string.Equals(state.JourneyThemeKey, PupilJourneyTheme.Sterrenkust, StringComparison.OrdinalIgnoreCase);
    }

    private void ApplyShell(PupilProgressStateDto state)
    {
        if (!_themedGroep78)
        {
            ShellState.Mode = LeerlingReisShellMode.Classic;
            ShellTheme.Reset();
            return;
        }

        ShellState.Mode = state.JourneyThemeKey switch
        {
            var k when string.Equals(k, PupilJourneyTheme.Eilandtuin, StringComparison.OrdinalIgnoreCase) =>
                LeerlingReisShellMode.Eilandtuin,
            var k when string.Equals(k, PupilJourneyTheme.Sterrenkust, StringComparison.OrdinalIgnoreCase) =>
                LeerlingReisShellMode.Sterrenkust,
            _ => LeerlingReisShellMode.ZeeExpeditie,
        };
        ShellTheme.ApplyJourney(_journeyThemeKey, routeHeader: false);
    }

    private string IslandProgressPercent()
    {
        if (_state is null || _state.TotalItems <= 0)
        {
            return "0%";
        }

        var pct = 100.0 * _state.AnsweredCount / _state.TotalItems;
        return pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string IslandBetween()
    {
        var before = 1;
        var keys = _def?.RailWorldKeys();
        if (keys is not null)
        {
            var count = 0;
            foreach (var key in keys)
            {
                if (string.Equals(key, "pauze-eiland", StringComparison.Ordinal))
                {
                    break;
                }

                count++;
            }

            before = Math.Max(1, count);
        }

        return string.Format(Culture["Leerling.Island.Between"], before, before + 1);
    }

    private void ToggleLike(string key)
    {
        if (_likes.Contains(key))
        {
            _likes.Remove(key);
        }
        else
        {
            _likes.Add(key);
            _dislikes.Remove(key);
        }
    }

    private void ToggleDislike(string key)
    {
        if (_dislikes.Contains(key))
        {
            _dislikes.Remove(key);
        }
        else
        {
            _dislikes.Add(key);
            _likes.Remove(key);
        }
    }

    private Task ToggleLikeOtherOpen()
    {
        _likeOtherOpen = !_likeOtherOpen;
        return Task.CompletedTask;
    }

    private Task SetLikeOther(string value)
    {
        _likeOther = value;
        return Task.CompletedTask;
    }

    private Task GoPrevThemed()
    {
        Nav.NavigateTo("/leerling/reis");
        return Task.CompletedTask;
    }

    private void GoPrevStep()
    {
        Nav.NavigateTo("/leerling/eiland");
    }

    private async Task SaveStep1Themed()
    {
        await SaveChipsAsync(finalizeIsland: false, navigateToStep2: true);
    }

    private async Task Save()
    {
        await SaveChipsAsync(finalizeIsland: true, navigateToStep2: false);
    }

    private async Task SaveChipsAsync(bool finalizeIsland, bool navigateToStep2)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.SavePupilChipsAsync(new PupilChipsRequest(
                _likes.ToList(),
                _dislikes.ToList(),
                string.IsNullOrWhiteSpace(_likeOther) ? null : _likeOther.Trim(),
                string.IsNullOrWhiteSpace(_dislikeOther) ? null : _dislikeOther.Trim(),
                finalizeIsland));
            if (result is null)
            {
                _error = Culture["Leerling.Reis.SaveFailed"];
                return;
            }

            if (navigateToStep2)
            {
                Nav.NavigateTo("/leerling/eiland/stap-2");
                return;
            }

            if (_def?.PartBreakAfterIsland == true)
            {
                _partBreak = true;
                return;
            }

            Nav.NavigateTo("/leerling/reis");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var body = ex.Message;
            _error = body.Contains("name_rejected", StringComparison.Ordinal)
                ? Culture["Leerling.Island.NameRejected"]
                : Culture["Leerling.Island.InvalidOther"];
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _windowClosed = true;
        }
        catch
        {
            _error = Culture["Leerling.Reis.SaveFailed"];
        }
        finally
        {
            _busy = false;
        }
    }
}
