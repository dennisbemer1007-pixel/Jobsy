@page "/leerling/mbo-hbo/paspoort"
@layout LeerlingMboHboLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Services
@inject JobsyApiClient Api

<PageTitle>Jouw Lobsy-paspoort · Lobsy</PageTitle>

@if (_model is null)
{
    <div class="mhbo-wrap"><p>Laden…</p></div>
}
else
{
    <div class="mhbo-wrap" style="padding-top:26px">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px">
            <div>
                <a class="mhbo-lnk" href="/leerling/mbo-hbo/overzicht">← Naar overzicht</a>
                <h1 style="margin-top:10px">Jouw Lobsy-paspoort</h1>
                <p class="mhbo-sub">Code @_model.CodeDisplay · @_model.SchoolName · @_model.ClassLabel</p>
            </div>
            <a class="mhbo-btn g" href="/leerling/pdf">Download als PDF</a>
        </div>
        <div class="mhbo-grid" style="grid-template-columns:repeat(3,1fr);margin-top:22px">
            @foreach (var sec in _model.Sections)
            {
                <div class="mhbo-card">
                    <h2 style="font-size:18px;color:#0f2747">@sec.Title</h2>
                    @((MarkupString)sec.BodyHtml)
                </div>
            }
        </div>
        <p class="mhbo-foot">@_model.FooterNote</p>
    </div>
}

@code {
    private PupilMboHboPassportDto? _model;

    protected override async Task OnInitializedAsync()
    {
        _model = await Api.GetMboHboPassportAsync();
    }
}
