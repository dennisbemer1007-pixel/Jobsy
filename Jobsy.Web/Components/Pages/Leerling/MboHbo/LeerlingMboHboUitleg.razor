@page "/leerling/mbo-hbo/uitleg"
@layout LeerlingMboHboLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Scholen.MboHbo
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject NavigationManager Nav

<PageTitle>Ontdek wat bij je past · Lobsy</PageTitle>

<div class="mhbo-wrap" style="max-width:860px;padding-top:56px">
    <div class="mhbo-card" style="padding:40px">
        <span class="mhbo-chip">Welkom</span>
        <h1 style="margin-top:14px">Ontdek wat bij je past</h1>
        <p class="mhbo-sub" style="font-size:16px">Met Lobsy kijk je naar je interesses, je sterke kanten en wat je belangrijk vindt. Zo krijg je ideeën voor je studie en je werk.</p>
        <div class="mhbo-grid" style="grid-template-columns:1fr 1fr;margin:28px 0">
            <div class="mhbo-card"><h2 style="font-size:18px;color:#0f2747">5 korte testen</h2><p class="mhbo-sub">Elke test heeft ongeveer 30 tot 50 vragen. Een test duurt ongeveer 10 minuten.</p></div>
            <div class="mhbo-card"><h2 style="font-size:18px;color:#0f2747">Geen goed of fout</h2><p class="mhbo-sub">Kies steeds wat het beste bij je past. Er zijn geen foute antwoorden.</p></div>
            <div class="mhbo-card"><h2 style="font-size:18px;color:#0f2747">Pauzeren mag</h2><p class="mhbo-sub">Je kunt stoppen wanneer je wilt. Je antwoorden worden bewaard en je gaat later verder.</p></div>
            <div class="mhbo-card"><h2 style="font-size:18px;color:#0f2747">Daarna je paspoort</h2><p class="mhbo-sub">Als alle 5 testen af zijn, zie je je paspoort met een overzicht van alle uitkomsten.</p></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
            <span class="mhbo-meta">Je doet mee met alleen je code. We vragen geen naam of andere gegevens.</span>
            <button type="button" class="mhbo-btn" disabled="@_busy" @onclick="StartAsync">Naar mijn testen →</button>
        </div>
    </div>
</div>

@code {
    private bool _busy;

    private async Task StartAsync()
    {
        _busy = true;
        var res = await Api.MarkMboHboIntroSeenAsync();
        Nav.NavigateTo(res?.RedirectPath ?? PupilMboHboEntryPaths.Overzicht);
    }
}
