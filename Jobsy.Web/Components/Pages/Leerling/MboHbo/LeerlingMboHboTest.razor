@page "/leerling/mbo-hbo/test/{BlockKey}"
@layout LeerlingMboHboLayout
@attribute [Authorize(Policy = JobsyPolicies.PupilSession)]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Scholen.MboHbo
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Components.Leerling
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_q?.BlockKey ?? "Test") · Lobsy</PageTitle>

@if (_loading)
{
    <div class="mhbo-wrap"><p>Laden…</p></div>
}
else if (_q is null)
{
    <div class="mhbo-wrap"><p>Vraag niet gevonden. <a class="mhbo-lnk" href="/leerling/mbo-hbo/overzicht">Naar overzicht</a></p></div>
}
else
{
    <div class="mhbo-wrap" style="max-width:880px;padding-top:40px">
        <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="mhbo-meta" style="font-weight:600;color:#0f2747">@BlockTitle(_q.Block)</span>
            <span class="mhbo-meta">Vraag @_q.Index van @_q.Total</span>
        </div>
        <div class="mhbo-bar" style="margin:10px 0 28px"><i style="width:@($"{Pct(_q.Index, _q.Total)}%")"></i></div>
        <div class="mhbo-card" style="padding:40px">
            <p class="mhbo-meta" style="text-transform:uppercase;letter-spacing:.6px">@PupilMboHboDimensionLabels.Display(_q.Dimension)</p>
            <div class="mhbo-speak-row">
                <h1 style="font-size:24px;margin:10px 0 8px;flex:1">@_q.Question</h1>
                <LeerlingSpeak Text="@SpeakText" SpeechKey="@($"mhbo-{_q.ItemId}")" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_q.Scenario))
            {
                <p class="mhbo-scenario">@_q.Scenario</p>
            }
            @if (_q.Scale == PupilMboHboScaleKind.SubjectLeukGoed)
            {
                <p class="mhbo-sub" style="margin-top:20px">Hoe leuk vind ik het?</p>
                <div class="mhbo-scale">@ScaleButtons(_leuk, v => _leuk = v)</div>
                <p class="mhbo-sub" style="margin-top:20px">Hoe goed ben ik erin?</p>
                <div class="mhbo-scale">@ScaleButtons(_goed, v => _goed = v)</div>
            }
            else
            {
                <p class="mhbo-sub" style="margin-top:12px">@Prompt(_q.Scale)</p>
                <div class="mhbo-scale">@ScaleButtons(_value, v => _value = v, _q.Scale)</div>
            }
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px;flex-wrap:wrap;gap:12px">
            <button type="button" class="mhbo-btn o" disabled="@(_busy || _q.Index <= 1)" @onclick="PrevAsync">← Vorige</button>
            <a class="mhbo-lnk" href="/leerling/mbo-hbo/overzicht">Pauzeer en terug naar overzicht</a>
            <button type="button" class="mhbo-btn" disabled="@(_busy || !CanContinue())" @onclick="NextAsync">@NextLabel</button>
        </div>
    </div>
}

@code {
    [Parameter] public string BlockKey { get; set; } = "";

    private PupilMboHboQuestionDto? _q;
    private bool _loading = true;
    private bool _busy;
    private int _value;
    private int _leuk;
    private int _goed;
    private readonly List<string> _history = [];

    private string SpeakText => _q is null ? "" : $"{_q.Question} {_q.Scenario}";

    private string NextLabel => _q is not null && _q.Index >= _q.Total ? "Afronden →" : "Volgende →";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _history.Clear();
        _q = await Api.GetMboHboQuestionAsync(BlockKey);
        ApplyCurrent(_q);
        _loading = false;
    }

    private void ApplyCurrent(PupilMboHboQuestionDto? q)
    {
        if (q is null)
        {
            return;
        }

        if (q.Scale == PupilMboHboScaleKind.SubjectLeukGoed)
        {
            _leuk = q.CurrentLeuk ?? 0;
            _goed = q.CurrentGoed ?? 0;
        }
        else
        {
            _value = q.CurrentValue ?? 0;
        }
    }

    private bool CanContinue()
    {
        if (_q is null)
        {
            return false;
        }

        if (_q.Scale == PupilMboHboScaleKind.SubjectLeukGoed)
        {
            return _leuk is >= 1 and <= 5 && _goed is >= 1 and <= 5;
        }

        return _value is >= 1 and <= 5;
    }

    private async Task NextAsync()
    {
        if (_q is null || !CanContinue())
        {
            return;
        }

        _busy = true;
        PupilMboHboAnswerResponse? res;
        if (_q.Scale == PupilMboHboScaleKind.SubjectLeukGoed)
        {
            res = await Api.SaveMboHboVakAnswerAsync(_q.ItemId, _leuk, _goed);
        }
        else
        {
            res = await Api.SaveMboHboAnswerAsync(BlockKey, _q.ItemId, _value);
        }

        if (res is null)
        {
            _busy = false;
            return;
        }

        if (res.BlockComplete)
        {
            Nav.NavigateTo(PupilMboHboEntryPaths.Uitkomst(ParseBlock()));
            return;
        }

        if (string.IsNullOrEmpty(res.NextItemId))
        {
            Nav.NavigateTo(PupilMboHboEntryPaths.Overzicht);
            return;
        }

        _history.Add(_q.ItemId);
        _q = await Api.GetMboHboQuestionAsync(BlockKey, res.NextItemId);
        ApplyCurrent(_q);
        _busy = false;
    }

    private async Task PrevAsync()
    {
        if (_history.Count == 0 || _q is null)
        {
            return;
        }

        var prevId = _history[^1];
        _history.RemoveAt(_history.Count - 1);
        _q = await Api.GetMboHboQuestionAsync(BlockKey, prevId);
        ApplyCurrent(_q);
    }

    private PupilMboHboBlock ParseBlock()
    {
        PupilMboHboEntryPaths.TryParseBlockRoute(BlockKey, out var block);
        return block;
    }

    private static int Pct(int index, int total)
        => total <= 0 ? 0 : (int)Math.Round(100d * index / total);

    private static string BlockTitle(PupilMboHboBlock block)
        => PupilMboHboCopy.BlockMeta(block).Title;

    private static string Prompt(PupilMboHboScaleKind scale)
        => scale switch
        {
            PupilMboHboScaleKind.Appeal => "Wat lijkt jou?",
            _ => "Hoe goed past deze zin bij jou?"
        };

    private RenderFragment ScaleButtons(int selected, Action<int> onPick, PupilMboHboScaleKind? scale = null)
        => builder =>
        {
            var labels = scale == PupilMboHboScaleKind.Appeal
                ? PupilMboHboScaleLabels.Appeal
                : scale == PupilMboHboScaleKind.Agreement || scale is null
                    ? PupilMboHboScaleLabels.Agreement
                    : Enumerable.Range(1, 5).Select(i => i.ToString()).ToArray();

            for (var i = 0; i < labels.Length; i++)
            {
                var val = i + 1;
                var seq = i * 4;
                builder.OpenElement(seq, "button");
                builder.AddAttribute(seq + 1, "type", "button");
                builder.AddAttribute(seq + 2, "class", $"mhbo-scale-opt {(selected == val ? "is-on" : null)}");
                builder.AddAttribute(seq + 3, "onclick", EventCallback.Factory.Create(this, () => onPick(val)));
                builder.OpenElement(seq + 4, "div");
                builder.AddAttribute(seq + 5, "class", "dot");
                builder.AddAttribute(seq + 6, "aria-hidden", "true");
                builder.CloseElement();
                builder.OpenElement(seq + 7, "div");
                builder.AddAttribute(seq + 8, "style", "font-size:13.5px");
                builder.AddContent(seq + 9, labels[i]);
                builder.CloseElement();
                builder.CloseElement();
            }
        };
}
