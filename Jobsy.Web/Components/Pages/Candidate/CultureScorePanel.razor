@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (Scores is { IsComplete: true } complete)
{
    <div class="competency-score-panel competency-score-panel--culture">
        <RadarChart AriaLabel="@Culture["CultureScan.RadarCulture"]"
                    LegendTitle="@Culture["CultureScan.RadarCultureLegend"]"
                    Axes="@CultureAxes(complete)" />
        <RadarChart AriaLabel="@Culture["CultureScan.RadarPersonality"]"
                    LegendTitle="@Culture["CultureScan.RadarPersonalityLegend"]"
                    Axes="@PersonalityAxes(complete)" />
        <ul class="competency-skill-list" aria-label="@Culture["Kompas.TabCulture"]">
            @foreach (var category in CulturePersonalityCatalog.CategoryCodes)
            {
                var value = Value(complete, category) ?? 0;
                <li class="competency-skill">
                    <details class="competency-skill__details">
                        <summary>
                            <span class="competency-skill__name">@Culture[$"CultureScan.Cat.{category}"]</span>
                            <span class="competency-skill__value">@value%</span>
                        </summary>
                        <div class="competency-skill__body">
                            <p class="competency-skill__meaning">@Culture[CultureTrainingCatalog.MeaningKey(category, value)]</p>
                            <p class="competency-skill__meaning">@Culture[CultureTrainingCatalog.DevelopKey(category)]</p>
                            <TrainingOffersBlock JobTitle="@CultureTrainingCatalog.SearchBlob(category)"
                                                 Campaign="@TrainingTracking.CampaignCulture"
                                                 Compact="true"
                                                 TitleKey="CultureScan.TrainingTitle" />
                        </div>
                    </details>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public CulturePersonalityScoreSet? Scores { get; set; }

    private IReadOnlyList<RadarChart.RadarAxis> CultureAxes(CulturePersonalityScoreSet s) =>
    [
        new(Culture["CultureScan.Cat.Autonomy"], s.Autonomy ?? 0),
        new(Culture["CultureScan.Cat.Informal"], s.Informal ?? 0),
        new(Culture["CultureScan.Cat.Collaboration"], s.Collaboration ?? 0),
        new(Culture["CultureScan.Cat.Flexibility"], s.Flexibility ?? 0),
        new(Culture["CultureScan.Cat.Innovation"], s.Innovation ?? 0),
        new(Culture["CultureScan.Cat.PeopleFirst"], s.PeopleFirst ?? 0)
    ];

    private IReadOnlyList<RadarChart.RadarAxis> PersonalityAxes(CulturePersonalityScoreSet s) =>
    [
        new(Culture["CultureScan.Cat.Openness"], s.Openness ?? 0),
        new(Culture["CultureScan.Cat.Conscientiousness"], s.Conscientiousness ?? 0),
        new(Culture["CultureScan.Cat.Extraversion"], s.Extraversion ?? 0),
        new(Culture["CultureScan.Cat.Agreeableness"], s.Agreeableness ?? 0),
        new(Culture["CultureScan.Cat.EmotionalStability"], s.EmotionalStability ?? 0)
    ];

    private static int? Value(CulturePersonalityScoreSet scores, string category) => category switch
    {
        CulturePersonalityCatalog.Autonomy => scores.Autonomy,
        CulturePersonalityCatalog.Informal => scores.Informal,
        CulturePersonalityCatalog.Collaboration => scores.Collaboration,
        CulturePersonalityCatalog.Flexibility => scores.Flexibility,
        CulturePersonalityCatalog.Innovation => scores.Innovation,
        CulturePersonalityCatalog.PeopleFirst => scores.PeopleFirst,
        CulturePersonalityCatalog.Openness => scores.Openness,
        CulturePersonalityCatalog.Conscientiousness => scores.Conscientiousness,
        CulturePersonalityCatalog.Extraversion => scores.Extraversion,
        CulturePersonalityCatalog.Agreeableness => scores.Agreeableness,
        CulturePersonalityCatalog.EmotionalStability => scores.EmotionalStability,
        _ => null
    };
}
