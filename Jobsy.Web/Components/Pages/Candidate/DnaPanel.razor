@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Shared.Charts
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture

<div class="dna-panel">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_loadFailed)
    {
        <div class="panel-inline-error" role="alert">
            <p class="panel-inline-error__text">@Culture["Panel.ErrorInline"]</p>
            <button type="button" class="btn-compact" @onclick="RetryLoadAsync">@Culture["Panel.ErrorRetry"]</button>
        </div>
    }
    else
    {
        <section class="dna-story" aria-labelledby="dna-story-title">
            <h3 id="dna-story-title" class="dna-section__title">@Culture["Dna.StoryTitle"]</h3>

            @if (string.IsNullOrWhiteSpace(_story))
            {
                <div class="dna-story__empty">
                    <p class="login-lead">@Culture["Dna.StoryEmpty"]</p>
                    <button type="button" class="login-submit" @onclick="GoTests">@Culture["Dna.StoryEmptyCta"]</button>
                </div>
            }
            else
            {
                @if (_storyUpdating)
                {
                    <p class="dna-story__updating" aria-live="polite">@Culture["Dna.StoryUpdating"]</p>
                }
                <div class="dna-story__body @(_storyExpanded ? "is-expanded" : "is-clamped")">
                    <div class="dna-story__text">
                        @foreach (var para in StoryParagraphs(_story))
                        {
                            <p>@para</p>
                        }
                    </div>
                    @if (!_storyExpanded)
                    {
                        <div class="dna-story__fade" aria-hidden="true"></div>
                    }
                </div>
                <button type="button"
                        class="dna-story__toggle"
                        @onclick="ToggleStory">
                    @(_storyExpanded ? Culture["Dna.StoryLess"] : Culture["Dna.StoryMore"])
                </button>

                @if (_keywords.Count > 0)
                {
                    <ul class="dna-story__chips" aria-label="@Culture["Dna.KeywordsLabel"]">
                        @foreach (var keyword in _keywords.Take(6))
                        {
                            <li>@keyword</li>
                        }
                    </ul>
                }

                @if (_storyExpanded && _storyGeneratedAt is DateTime generated)
                {
                    <p class="dna-story__meta">
                        @Culture.Format("Dna.StoryUpdated", generated.ToLocalTime().ToString("dd-MM-yyyy"))
                    </p>
                }
            }
        </section>

        @if (_highlights.Count > 0)
        {
            <section class="dna-highlights" aria-labelledby="dna-highlights-title">
                <div class="dna-section__head">
                    <h3 id="dna-highlights-title" class="dna-section__title">@Culture["Dna.HighlightsTitle"]</h3>
                    <span class="dna-section__aside">@Culture["Dna.HighlightsAside"]</span>
                </div>
                <div class="dna-highlights__grid">
                    @foreach (var h in _highlights)
                    {
                        <article class="dna-highlight">
                            <p class="dna-highlight__label">@Culture[h.LabelKey]</p>
                            <p class="dna-highlight__value">@h.Value</p>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="dna-carousel"
                 role="region"
                 aria-roledescription="carousel"
                 aria-label="@Culture["Dna.CarouselLabel"]"
                 aria-labelledby="dna-carousel-title">
            <h3 id="dna-carousel-title" class="visually-hidden">@Culture["Dna.CarouselLabel"]</h3>
            <div class="dna-carousel__track" @ref="_carouselTrack">
                @foreach (var slide in _slides)
                {
                    <article class="dna-carousel__slide @(slide.IsProvisional ? "dna-carousel__slide--provisional" : null) @(slide.IsGhost ? "dna-carousel__slide--ghost" : null)"
                             tabindex="0"
                             aria-label="@slide.AriaName">
                        <header class="dna-carousel__head">
                            <h4 class="dna-carousel__title">@Culture[slide.TitleKey]</h4>
                            @if (slide.IsGhost)
                            {
                                <span class="dna-card__badge dna-card__badge--empty">@Culture["Test.Status.NotDone"]</span>
                            }
                            else if (slide.Extended)
                            {
                                <span class="dna-card__badge dna-card__badge--success">@Culture["Test.Status.Extended"]</span>
                            }
                            else if (slide.Completed)
                            {
                                <span class="dna-card__badge dna-card__badge--success">@Culture["Dna.StatusComplete"]</span>
                            }
                            else if (slide.IsProvisional)
                            {
                                <span class="dna-card__badge dna-card__badge--provisional">@Culture["Onboarding.ProvisionalBadge"]</span>
                            }
                        </header>

                        @if (slide.IsGhost)
                        {
                            <div class="dna-carousel__body dna-carousel__body--ghost">
                                @if (slide.Kind == AssessmentKind.Career || slide.Kind == AssessmentKind.Competence)
                                {
                                    <RadarChart Axes="slide.Axes" Ghost="true" AriaLabel="@Culture[slide.ChartAltKey]" />
                                }
                                else if (slide.Kind == AssessmentKind.Culture)
                                {
                                    <PoleSliders Items="slide.Poles" Ghost="true" />
                                }
                                else
                                {
                                    <BarList Items="slide.Bars" Ghost="true" />
                                }
                                <p class="dna-teaser__text">@Culture[slide.TeaserKey]</p>
                                <a class="dna-teaser__btn" href="@slide.StartHref">@Culture.Format("Dna.TeaserStart", Culture[slide.TitleKey], slide.QuestionCount)</a>
                            </div>
                        }
                        else if (slide.Kind == AssessmentKind.Career)
                        {
                            <div class="dna-carousel__body dna-carousel__body--split">
                                <RadarChart Axes="slide.Axes" Dashed="slide.IsProvisional" AriaLabel="@Culture[slide.ChartAltKey]" />
                                <BarList Items="slide.Bars" ShowLetters="true" HighlightTop="3" />
                            </div>
                        }
                        else if (slide.Kind == AssessmentKind.Competence)
                        {
                            <div class="dna-carousel__body">
                                <RadarChart Axes="slide.Axes" Dashed="slide.IsProvisional" AriaLabel="@Culture[slide.ChartAltKey]" />
                            </div>
                        }
                        else if (slide.Kind == AssessmentKind.Culture)
                        {
                            <div class="dna-carousel__body">
                                <PoleSliders Items="slide.Poles" />
                            </div>
                        }
                        else if (slide.Kind == AssessmentKind.Values)
                        {
                            <div class="dna-carousel__body">
                                <BarList Items="slide.Bars" HighlightTop="3" />
                            </div>
                        }
                    </article>
                }
            </div>
            @if (_slides.Count > 1)
            {
                <div class="dna-carousel__dots" role="tablist" aria-label="@Culture["Dna.CarouselLabel"]">
                    @for (var i = 0; i < _slides.Count; i++)
                    {
                        var index = i;
                        <button type="button"
                                class="dna-carousel__dot @(_activeSlide == index ? "is-active" : null)"
                                role="tab"
                                aria-selected="@(_activeSlide == index)"
                                aria-label="@Culture.Format("Dna.CarouselDot", index + 1, _slides.Count)"
                                @onclick="() => ScrollToSlide(index)">
                        </button>
                    }
                </div>
            }
        </section>

        <section class="dna-tiles" aria-labelledby="dna-tiles-title">
            <div class="dna-section__head">
                <h3 id="dna-tiles-title" class="dna-section__title">@Culture["Dna.TestsTitle"]</h3>
                <span class="dna-section__aside">@Culture.Format("Dna.TestsProgress", _completedCount, _cards.Count)</span>
            </div>
            <div class="dna-tiles__grid">
                @foreach (var card in _cards)
                {
                    var href = card.Completed ? card.DetailHref : card.StartHref;
                    var statusText = card.Extended
                        ? Culture["Test.Status.Extended"]
                        : card.Completed
                            ? Culture["Dna.StatusComplete"]
                            : card.IsProvisional
                                ? Culture["Onboarding.ProvisionalBadge"]
                                : Culture["Test.Status.NotDone"];
                    var cta = card.Completed
                        ? Culture["Dna.ViewResult"]
                        : card.IsProvisional
                            ? Culture.Format("Dna.TileContinue", card.Remaining)
                            : Culture.Format("Dna.TileStart", card.MinutesApprox);
                    var a11y = Culture.Format(
                        "Dna.TileA11y",
                        Culture[card.TitleKey],
                        statusText,
                        card.Answered,
                        card.QuestionCount);
                    <a class="dna-tile @(card.Completed ? "dna-tile--complete" : null) @(card.IsProvisional ? "dna-tile--provisional" : null) @(!card.Completed && !card.IsProvisional ? "dna-tile--empty" : null)"
                       href="@href"
                       aria-label="@a11y">
                        <header class="dna-tile__head">
                            <h4 class="dna-tile__title">@Culture[card.TitleKey]</h4>
                            @if (card.Extended || card.Completed)
                            {
                                <span class="dna-card__badge dna-card__badge--success">✓ @statusText</span>
                            }
                            else if (card.IsProvisional)
                            {
                                <span class="dna-card__badge dna-card__badge--provisional">@statusText</span>
                            }
                            else
                            {
                                <span class="dna-card__badge dna-card__badge--empty">@statusText</span>
                            }
                        </header>
                        <ProgressRing Answered="card.Answered" Total="card.QuestionCount" Complete="card.Completed" Provisional="card.IsProvisional" />
                        <p class="dna-tile__summary">@card.Summary</p>
                        <span class="dna-tile__cta">@cta <span aria-hidden="true">›</span></span>
                    </a>
                }
            </div>
        </section>

        @if (_cultureDetail is { } cultureDetail)
        {
            <section class="dna-detail" aria-labelledby="dna-culture-detail-title">
                <div class="dna-section__head">
                    <h3 id="dna-culture-detail-title" class="dna-section__title">@Culture["Dna.CultureHomeTitle"]</h3>
                    <span class="dna-section__aside">@cultureDetail.Aside</span>
                </div>
                @if (cultureDetail.IsGhost)
                {
                    <PoleSliders Items="cultureDetail.Poles" Ghost="true" />
                    <p class="dna-teaser__text">@Culture["Dna.TeaserCulture"]</p>
                    <a class="dna-teaser__btn" href="@cultureDetail.StartHref">@Culture.Format("Dna.TeaserStart", Culture["Test.Culture.Title"], cultureDetail.QuestionCount)</a>
                }
                else
                {
                    <PoleSliders Items="cultureDetail.Poles" />
                }
            </section>
        }

        @if (_valuesDetail is { } valuesDetail)
        {
            <section class="dna-detail" aria-labelledby="dna-values-detail-title">
                <div class="dna-section__head">
                    <h3 id="dna-values-detail-title" class="dna-section__title">@Culture["Dna.ValuesWorkTitle"]</h3>
                    <span class="dna-section__aside">@valuesDetail.Aside</span>
                </div>
                @if (valuesDetail.IsGhost)
                {
                    <BarList Items="valuesDetail.Bars" Ghost="true" />
                    <p class="dna-teaser__text">@Culture["Dna.TeaserValues"]</p>
                    <a class="dna-teaser__btn" href="@valuesDetail.StartHref">@Culture.Format("Dna.TeaserStart", Culture["Test.Values.Title"], valuesDetail.QuestionCount)</a>
                }
                else
                {
                    <BarList Items="valuesDetail.Bars" HighlightTop="3" />
                }
            </section>
        }
    }
</div>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<string> OnOpenTab { get; set; }
    [Parameter] public CandidateKompasState? Snapshot { get; set; }
    [Parameter] public CandidateDnaSummary? DnaSnapshot { get; set; }
    [CascadingParameter] public CandidateKompasState? CascadedKompas { get; set; }

    private bool _loading = true;
    private bool _loaded;
    private bool _loadFailed;
    private bool _storyExpanded;
    private bool _storyUpdating;
    private string? _story;
    private DateTime? _storyGeneratedAt;
    private readonly List<string> _keywords = [];
    private readonly List<DnaCard> _cards = [];
    private readonly List<DnaHighlight> _highlights = [];
    private readonly List<DnaSlide> _slides = [];
    private DetailBlock? _cultureDetail;
    private DetailBlock? _valuesDetail;
    private int _completedCount;
    private int _activeSlide;
    private ElementReference _carouselTrack;

    protected override async Task OnParametersSetAsync()
    {
        if (!Active)
        {
            return;
        }

        var shared = Snapshot ?? CascadedKompas;
        if (shared is not null)
        {
            _loadFailed = false;
            ApplySnapshot(shared);
            return;
        }

        if (DnaSnapshot is not null)
        {
            _loadFailed = false;
            ApplyDnaSnapshot(DnaSnapshot);
            return;
        }

        if (!_loaded)
        {
            await LoadAsync();
        }
    }

    private void ApplySnapshot(CandidateKompasState kompas)
    {
        ApplyStory(kompas.WhoAmI);
        Paint(
            kompas.Competencies?.Status,
            kompas.Competencies?.Scores ?? kompas.Competencies?.PreviewScores,
            kompas.Competencies?.AnsweredCount ?? 0,
            kompas.CareerInterests?.Status,
            kompas.CareerInterests?.Scores ?? kompas.CareerInterests?.PreviewScores,
            kompas.CareerInterests?.AnsweredCount ?? 0,
            kompas.Culture?.Status,
            kompas.Culture?.Scores ?? kompas.Culture?.PreviewScores,
            kompas.Culture?.AnsweredCount ?? 0,
            kompas.Values?.Status,
            kompas.Values?.Scores ?? kompas.Values?.PreviewScores,
            kompas.Values?.AnsweredCount ?? 0,
            kompas.CompetenceDeep,
            kompas.CareerDeep,
            kompas.CultureDeep,
            kompas.ValuesDeep);
        _loaded = true;
        _loading = false;
    }

    private void ApplyDnaSnapshot(CandidateDnaSummary dna)
    {
        ApplyStory(dna.WhoAmI);
        var competence = dna.Competencies;
        var career = dna.CareerInterests;
        var culture = dna.Culture;
        var values = dna.Values;
        Paint(
            competence?.Status,
            competence?.Scores ?? competence?.PreviewScores,
            competence?.AnsweredCount ?? 0,
            career?.Status,
            career?.Scores ?? career?.PreviewScores,
            career?.AnsweredCount ?? 0,
            culture?.Status,
            culture?.Scores ?? culture?.PreviewScores,
            culture?.AnsweredCount ?? 0,
            values?.Status,
            values?.Scores ?? values?.PreviewScores,
            values?.AnsweredCount ?? 0,
            DeepStub(competence?.DeepCompleted ?? false),
            DeepStub(career?.DeepCompleted ?? false),
            DeepStub(culture?.DeepCompleted ?? false),
            DeepStub(values?.DeepCompleted ?? false));
        _loaded = true;
        _loading = false;
    }

    private static DeepAnalysisState? DeepStub(bool completed)
        => completed ? new DeepAnalysisState { IsCompleted = true } : null;

    private void ApplyStory(WhoAmIStorySummary? who)
    {
        _story = string.IsNullOrWhiteSpace(who?.Story) ? null : who!.Story;
        _storyGeneratedAt = who?.GeneratedAtUtc;
        _storyUpdating = string.Equals(who?.Status, WhoAmIStoryStatuses.Updating, StringComparison.OrdinalIgnoreCase);
        _keywords.Clear();
        if (who?.Keywords is { Count: > 0 })
        {
            _keywords.AddRange(who.Keywords.Where(k => !string.IsNullOrWhiteSpace(k)).Take(6));
        }
    }

    private Task RetryLoadAsync()
    {
        _loaded = false;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var result = await Api.GetMyKompasDnaResultAsync();
            if (result.TemporarilyUnavailable)
            {
                _loadFailed = true;
                return;
            }

            if (result.Value is not null)
            {
                ApplyDnaSnapshot(result.Value);
            }
        }
        catch (Exception ex) when (!CircuitInterop.IsCircuitGone(ex))
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
            _loaded = true;
        }
    }

    private void Paint(
        string? competenceStatus,
        CompetencyScoreSet? competenceScores,
        int competenceAnswered,
        string? careerStatus,
        RiasecScoreSet? careerScores,
        int careerAnswered,
        string? cultureStatus,
        CulturePersonalityScoreSet? cultureScores,
        int cultureAnswered,
        string? valuesStatus,
        SchwartzValuesScoreSet? valuesScores,
        int valuesAnswered,
        DeepAnalysisState? competenceDeep,
        DeepAnalysisState? careerDeep,
        DeepAnalysisState? cultureDeep,
        DeepAnalysisState? valuesDeep)
    {
        _cards.Clear();
        _highlights.Clear();
        _slides.Clear();
        _cultureDetail = null;
        _valuesDetail = null;

        var competence = BuildCompetence(competenceStatus, competenceScores, competenceAnswered, competenceDeep);
        var career = BuildCareer(careerStatus, careerScores, careerAnswered, careerDeep);
        var culture = BuildCulture(cultureStatus, cultureScores, cultureAnswered, cultureDeep);
        var values = BuildValues(valuesStatus, valuesScores, valuesAnswered, valuesDeep);

        _cards.Add(competence);
        _cards.Add(career);
        _cards.Add(culture);
        _cards.Add(values);
        _completedCount = _cards.Count(c => c.Completed);

        if (competence.TopLabel is { } strong)
        {
            _highlights.Add(new DnaHighlight("Dna.HighlightStrongest", strong));
        }

        if (career.TopLabel is { } work)
        {
            _highlights.Add(new DnaHighlight("Dna.HighlightWork", work));
        }

        if (values.TopLabel is { } important)
        {
            _highlights.Add(new DnaHighlight("Dna.HighlightImportant", important));
        }

        foreach (var card in _cards)
        {
            _slides.Add(BuildSlide(card));
        }

        _cultureDetail = BuildCultureDetail(culture);
        _valuesDetail = BuildValuesDetail(values);
        _activeSlide = 0;
    }

    private DnaSlide BuildSlide(DnaCard card)
    {
        var ghost = !card.Completed && !card.IsProvisional;
        return new DnaSlide(
            card.Kind,
            card.TitleKey,
            card.Completed,
            card.Extended,
            card.IsProvisional,
            ghost,
            card.StartHref,
            card.QuestionCount,
            card.Axes,
            card.Bars,
            card.Poles,
            ChartAltKey(card.Kind),
            TeaserKey(card.Kind),
            Culture.Format(
                "Dna.TileA11y",
                Culture[card.TitleKey],
                ghost
                    ? Culture["Test.Status.NotDone"]
                    : card.IsProvisional
                        ? Culture["Onboarding.ProvisionalBadge"]
                        : Culture["Dna.StatusComplete"],
                card.Answered,
                card.QuestionCount));
    }

    private DetailBlock BuildCultureDetail(DnaCard culture)
    {
        var aside = culture.Completed
            ? Culture["Dna.StatusComplete"]
            : culture.IsProvisional
                ? Culture["Onboarding.ProvisionalBadge"]
                : Culture["Test.Status.NotDone"];
        return new DetailBlock(
            culture.Poles.Count > 0 ? culture.Poles : GhostCulturePoles(),
            [],
            !culture.Completed && !culture.IsProvisional,
            culture.StartHref,
            culture.QuestionCount,
            aside);
    }

    private DetailBlock BuildValuesDetail(DnaCard values)
    {
        var aside = values.Completed
            ? Culture["Dna.StatusComplete"]
            : values.IsProvisional
                ? Culture["Onboarding.ProvisionalBadge"]
                : Culture["Test.Status.NotDone"];
        return new DetailBlock(
            [],
            values.Bars.Count > 0 ? values.Bars : GhostValueBars(),
            !values.Completed && !values.IsProvisional,
            values.StartHref,
            values.QuestionCount,
            aside);
    }

    private List<(string LowLabel, string HighLabel, int? Percent)> GhostCulturePoles()
        => CulturePersonalityCatalog.CultureDimensionCodes
            .Select(code =>
            {
                var (low, high) = DnaSummarySentences.CulturePoles(code);
                return (Culture[low], Culture[high], (int?)null);
            })
            .ToList();

    private static List<ChartAxisValue> GhostValueBars()
        => SchwartzValuesCatalog.CategoryCodes
            .Select(code => new ChartAxisValue(DimensionLabels.For(code), null))
            .ToList();

    private static string ChartAltKey(AssessmentKind kind) => kind switch
    {
        AssessmentKind.Competence => "Dna.ChartAlt.Competence",
        AssessmentKind.Career => "Dna.ChartAlt.Career",
        AssessmentKind.Culture => "Dna.ChartAlt.Culture",
        _ => "Dna.ChartAlt.Values"
    };

    private static string TeaserKey(AssessmentKind kind) => kind switch
    {
        AssessmentKind.Competence => "Dna.TeaserCompetence",
        AssessmentKind.Career => "Dna.TeaserCareer",
        AssessmentKind.Culture => "Dna.TeaserCulture",
        _ => "Dna.TeaserValues"
    };

    private DnaCard BuildCompetence(string? status, CompetencyScoreSet? scores, int answered, DeepAnalysisState? deep)
    {
        var def = AssessmentTestCatalog.TryGet(AssessmentKind.Competence)!;
        var freeDone = IsCompleted(status);
        var extended = deep is { IsCompleted: true };
        var completed = freeDone || extended;
        var provisional = !completed && answered > 0;
        var axes = new List<ChartAxisValue>();
        string? top = null;
        string summary = Culture["Dna.TileNotStarted"];

        if ((completed || provisional) && scores is not null)
        {
            var ranked = Rank(
                (CompetencyTestCatalog.Samenwerken, scores.Samenwerken),
                (CompetencyTestCatalog.Resultaatgerichtheid, scores.Resultaatgerichtheid),
                (CompetencyTestCatalog.Stressbestendigheid, scores.Stressbestendigheid),
                (CompetencyTestCatalog.Innovatie, scores.Innovatie),
                (CompetencyTestCatalog.Extraversie, scores.Extraversie));
            foreach (var code in new[]
                     {
                         CompetencyTestCatalog.Samenwerken,
                         CompetencyTestCatalog.Resultaatgerichtheid,
                         CompetencyTestCatalog.Stressbestendigheid,
                         CompetencyTestCatalog.Innovatie,
                         CompetencyTestCatalog.Extraversie
                     })
            {
                var pct = ranked.FirstOrDefault(r => r.Code == code).Percent;
                var has = ranked.Any(r => r.Code == code);
                axes.Add(new ChartAxisValue(DeepAnalysisQuestionHelp.DomainLabel(code), has ? pct : null));
            }

            if (ranked.Count > 0)
            {
                top = DeepAnalysisQuestionHelp.DomainLabel(ranked[0].Code);
                summary = Culture.Format("Dna.TileSummaryStrong", top);
            }
        }

        return new DnaCard(
            AssessmentKind.Competence,
            def.TitleKey,
            completed,
            extended,
            def.DetailHref,
            def.FreeStartHref,
            answered,
            def.FreeQuestionCount,
            def.FreeMinutesApprox,
            provisional,
            top,
            summary,
            axes,
            [],
            []);
    }

    private DnaCard BuildCareer(string? status, RiasecScoreSet? scores, int answered, DeepAnalysisState? deep)
    {
        var def = AssessmentTestCatalog.TryGet(AssessmentKind.Career)!;
        var freeDone = IsCompleted(status);
        var extended = deep is { IsCompleted: true };
        var completed = freeDone || extended;
        var provisional = !completed && answered > 0;
        var axes = new List<ChartAxisValue>();
        var bars = new List<ChartAxisValue>();
        string? top = null;
        string summary = Culture["Dna.TileNotStarted"];

        if ((completed || provisional) && scores is not null)
        {
            var ranked = Rank(
                (CareerTestCatalog.Realistic, scores.Realistic),
                (CareerTestCatalog.Investigative, scores.Investigative),
                (CareerTestCatalog.Artistic, scores.Artistic),
                (CareerTestCatalog.Social, scores.Social),
                (CareerTestCatalog.Enterprising, scores.Enterprising),
                (CareerTestCatalog.Conventional, scores.Conventional));
            foreach (var code in new[]
                     {
                         CareerTestCatalog.Realistic,
                         CareerTestCatalog.Investigative,
                         CareerTestCatalog.Artistic,
                         CareerTestCatalog.Social,
                         CareerTestCatalog.Enterprising,
                         CareerTestCatalog.Conventional
                     })
            {
                var hit = ranked.FirstOrDefault(r => r.Code == code);
                var has = ranked.Any(r => r.Code == code);
                axes.Add(new ChartAxisValue(CareerCompassBuilder.TypeLabel(code), has ? hit.Percent : null, code[..1]));
            }

            foreach (var (code, pct) in ranked.Take(3))
            {
                bars.Add(new ChartAxisValue(CareerCompassBuilder.TypeLabel(code), pct, code[..1]));
            }

            if (ranked.Count > 0)
            {
                top = CareerCompassBuilder.TypeLabel(ranked[0].Code);
                summary = Culture.Format(
                    "Dna.TileSummaryTop",
                    string.Join(" · ", ranked.Take(3).Select(r => r.Code[..1])));
            }
        }

        return new DnaCard(
            AssessmentKind.Career,
            def.TitleKey,
            completed,
            extended,
            def.DetailHref,
            def.FreeStartHref,
            answered,
            def.FreeQuestionCount,
            def.FreeMinutesApprox,
            provisional,
            top,
            summary,
            axes,
            bars,
            []);
    }

    private DnaCard BuildCulture(string? status, CulturePersonalityScoreSet? scores, int answered, DeepAnalysisState? deep)
    {
        var def = AssessmentTestCatalog.TryGet(AssessmentKind.Culture)!;
        var freeDone = IsCompleted(status);
        var extended = deep is { IsCompleted: true };
        var completed = freeDone || extended;
        var provisional = !completed && answered > 0;
        var poles = new List<(string LowLabel, string HighLabel, int? Percent)>();
        string? top = null;
        string summary = Culture["Dna.TileNotStarted"];

        if ((completed || provisional) && scores is not null)
        {
            var pairs = new (string Code, int? Value)[]
            {
                (CulturePersonalityCatalog.Autonomy, scores.Autonomy),
                (CulturePersonalityCatalog.Informal, scores.Informal),
                (CulturePersonalityCatalog.Collaboration, scores.Collaboration),
                (CulturePersonalityCatalog.Flexibility, scores.Flexibility),
                (CulturePersonalityCatalog.Innovation, scores.Innovation),
                (CulturePersonalityCatalog.PeopleFirst, scores.PeopleFirst)
            };
            foreach (var (code, value) in pairs)
            {
                var (low, high) = DnaSummarySentences.CulturePoles(code);
                poles.Add((Culture[low], Culture[high], value));
            }

            var ranked = Rank(pairs);
            if (ranked.Count > 0)
            {
                top = Culture[DnaSummarySentences.CulturePoles(ranked[0].Code).HighPoleKey];
                summary = string.Join(
                    " · ",
                    ranked.Take(2).Select(r => Culture[DnaSummarySentences.CulturePoles(r.Code).HighPoleKey]));
            }
        }
        else
        {
            poles = GhostCulturePoles();
        }

        return new DnaCard(
            AssessmentKind.Culture,
            def.TitleKey,
            completed,
            extended,
            def.DetailHref,
            def.FreeStartHref,
            answered,
            def.FreeQuestionCount,
            def.FreeMinutesApprox,
            provisional,
            top,
            summary,
            [],
            [],
            poles);
    }

    private DnaCard BuildValues(string? status, SchwartzValuesScoreSet? scores, int answered, DeepAnalysisState? deep)
    {
        var def = AssessmentTestCatalog.TryGet(AssessmentKind.Values)!;
        var freeDone = IsCompleted(status);
        var extended = deep is { IsCompleted: true };
        var completed = freeDone || extended;
        var provisional = !completed && answered > 0;
        var bars = new List<ChartAxisValue>();
        string? top = null;
        string summary = Culture["Dna.TileNotStarted"];

        if ((completed || provisional) && scores is not null)
        {
            var ranked = Rank(
                (SchwartzValuesCatalog.Autonomy, scores.Autonomy),
                (SchwartzValuesCatalog.Connection, scores.Connection),
                (SchwartzValuesCatalog.Achievement, scores.Achievement),
                (SchwartzValuesCatalog.Stability, scores.Stability),
                (SchwartzValuesCatalog.Impact, scores.Impact));
            // Strength order so the top 3 get brand colour in BarList.
            bars = ranked
                .Select(r => new ChartAxisValue(DimensionLabels.For(r.Code), r.Percent))
                .Concat(SchwartzValuesCatalog.CategoryCodes
                    .Where(c => ranked.All(r => r.Code != c))
                    .Select(c => new ChartAxisValue(DimensionLabels.For(c), null)))
                .ToList();

            if (ranked.Count > 0)
            {
                top = DimensionLabels.For(ranked[0].Code);
                summary = top;
            }
        }
        else
        {
            bars = GhostValueBars();
        }

        return new DnaCard(
            AssessmentKind.Values,
            def.TitleKey,
            completed,
            extended,
            def.DetailHref,
            def.FreeStartHref,
            answered,
            def.FreeQuestionCount,
            def.FreeMinutesApprox,
            provisional,
            top,
            summary,
            [],
            bars,
            []);
    }

    private static List<(string Code, int Percent)> Rank(params (string Code, int? Value)[] items)
        => items
            .Where(x => x.Value is not null)
            .Select(x => (x.Code, Percent: x.Value!.Value))
            .OrderByDescending(x => x.Percent)
            .ThenBy(x => x.Code, StringComparer.Ordinal)
            .ToList();

    private static bool IsCompleted(string? status)
        => string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<string> StoryParagraphs(string story)
        => story.Split(["\r\n\r\n", "\n\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void ToggleStory() => _storyExpanded = !_storyExpanded;

    private Task GoTests() => OnOpenTab.InvokeAsync(CandidateKompasTabs.Tests);

    private void ScrollToSlide(int index)
    {
        _activeSlide = Math.Clamp(index, 0, Math.Max(0, _slides.Count - 1));
    }

