@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture

<div class="dna-panel">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_completedCount == 0)
    {
        <div class="dna-empty">
            <div class="dna-empty__icon" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
                    <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity="0.35"/>
                    <path d="M24 14c6 6 6 30 0 36M40 14c-6 6-6 30 0 36" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M22 24h20M22 32h20M22 40h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
                </svg>
            </div>
            <p class="login-lead">@Culture["Dna.EmptyLead"]</p>
            <button type="button" class="login-submit" @onclick="GoTests">@Culture["Dna.ViewTests"]</button>
        </div>
    }
    else
    {
        <p class="login-lead">@Culture["Dna.Lead"]</p>
        @if (_completedCount < 4)
        {
            <p class="dna-incomplete">
                <span class="dna-incomplete__badge">@Culture["Dna.IncompleteBadge"]</span>
                @Culture.Format("Dna.IncompleteHint", _completedCount, 4)
            </p>
        }

        <ul class="dna-summary">
            @foreach (var item in _items.Where(i => i.Completed))
            {
                <li class="dna-summary__item">
                    <a class="dna-summary__link" href="@item.DetailHref">
                        <span class="dna-summary__title">@Culture[item.TitleKey]</span>
                        @if (!string.IsNullOrWhiteSpace(item.Outcome))
                        {
                            <span class="dna-summary__outcome">@item.Outcome</span>
                        }
                        <span class="dna-summary__status dna-summary__status--@item.StatusCss">@Culture[item.StatusKey]</span>
                    </a>
                </li>
            }
            @foreach (var item in _items.Where(i => !i.Completed))
            {
                <li class="dna-summary__item dna-summary__item--missing">
                    <span class="dna-summary__title">@Culture[item.TitleKey]</span>
                    <span class="dna-summary__status dna-summary__status--pending">@Culture["Test.Status.NotDone"]</span>
                </li>
            }
        </ul>

        <button type="button" class="engagement-btn" @onclick="GoTests">@Culture["Dna.ViewTests"]</button>
    }
</div>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<string> OnOpenTab { get; set; }
    [Parameter] public CandidateKompasState? Snapshot { get; set; }

    private bool _loading = true;
    private bool _loaded;
    private int _completedCount;
    private readonly List<DnaItem> _items = [];

    protected override async Task OnParametersSetAsync()
    {
        if (!Active)
        {
            return;
        }

        if (Snapshot is not null && !_loaded)
        {
            ApplySnapshot(Snapshot);
            return;
        }

        if (!_loaded)
        {
            await LoadAsync();
        }
        else if (Snapshot is not null)
        {
            ApplySnapshot(Snapshot);
        }
    }

    private void ApplySnapshot(CandidateKompasState kompas)
    {
        var competence = kompas.Competencies;
        var career = kompas.CareerInterests;
        var culture = kompas.Culture;
        var values = kompas.Values;
        Paint(
            competence?.Status,
            competence?.Scores,
            career?.Status,
            career?.Scores,
            culture?.Status,
            culture?.Scores,
            values?.Status,
            values?.Scores,
            kompas.CompetenceDeep,
            kompas.CareerDeep,
            kompas.CultureDeep,
            kompas.ValuesDeep);
        _loaded = true;
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var kompas = await Api.GetMyKompasAsync();
            if (kompas is not null)
            {
                ApplySnapshot(kompas);
                return;
            }

            var competence = await Api.GetMyCompetenciesAsync();
            var career = await Api.GetMyCareerInterestsAsync();
            var culture = await Api.GetMyCultureAsync();
            var values = await Api.GetMyValuesAsync();
            var competenceDeep = await Api.GetDeepAnalysisAsync("competence");
            var careerDeep = await Api.GetDeepAnalysisAsync("career");
            var cultureDeep = await Api.GetDeepAnalysisAsync("culture");
            var valuesDeep = await Api.GetDeepAnalysisAsync("values");
            Paint(
                competence?.Status,
                competence?.Scores,
                career?.Status,
                career?.Scores,
                culture?.Status,
                culture?.Scores,
                values?.Status,
                values?.Scores,
                competenceDeep,
                careerDeep,
                cultureDeep,
                valuesDeep);
            _loaded = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Paint(
        string? competenceStatus,
        CompetencyScoreSet? competenceScores,
        string? careerStatus,
        RiasecScoreSet? careerScores,
        string? cultureStatus,
        CulturePersonalityScoreSet? cultureScores,
        string? valuesStatus,
        SchwartzValuesScoreSet? valuesScores,
        DeepAnalysisState? competenceDeep,
        DeepAnalysisState? careerDeep,
        DeepAnalysisState? cultureDeep,
        DeepAnalysisState? valuesDeep)
    {
        _items.Clear();
        _items.Add(Build(
            AssessmentKind.Competence,
            "Test.Competence.Title",
            IsCompleted(competenceStatus),
            competenceDeep,
            AssessmentOutcomeLines.Competence(
                competenceScores?.Samenwerken,
                competenceScores?.Resultaatgerichtheid,
                competenceScores?.Stressbestendigheid,
                competenceScores?.Innovatie,
                competenceScores?.Extraversie)));
        _items.Add(Build(
            AssessmentKind.Career,
            "Test.Career.Title",
            IsCompleted(careerStatus),
            careerDeep,
            AssessmentOutcomeLines.Career(
                careerScores?.Realistic,
                careerScores?.Investigative,
                careerScores?.Artistic,
                careerScores?.Social,
                careerScores?.Enterprising,
                careerScores?.Conventional)));
        _items.Add(Build(
            AssessmentKind.Culture,
            "Test.Culture.Title",
            IsCompleted(cultureStatus),
            cultureDeep,
            AssessmentOutcomeLines.Culture(
                cultureScores?.Autonomy,
                cultureScores?.Informal,
                cultureScores?.Collaboration,
                cultureScores?.Flexibility,
                cultureScores?.Innovation,
                cultureScores?.PeopleFirst)));
        _items.Add(Build(
            AssessmentKind.Values,
            "Test.Values.Title",
            IsCompleted(valuesStatus),
            valuesDeep,
            AssessmentOutcomeLines.Values(
                valuesScores?.Autonomy,
                valuesScores?.Connection,
                valuesScores?.Achievement,
                valuesScores?.Stability,
                valuesScores?.Impact)));
        _completedCount = _items.Count(i => i.Completed);
    }

    private static bool IsCompleted(string? status)
        => string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase);

    private static DnaItem Build(
        AssessmentKind kind,
        string titleKey,
        bool freeDone,
        DeepAnalysisState? deep,
        string? outcome)
    {
        var deepDone = deep is { IsCompleted: true };
        var completed = freeDone || deepDone;
        var extended = deepDone;
        return new DnaItem(
            titleKey,
            AssessmentTestCatalog.DetailHref(kind),
            completed,
            outcome,
            extended ? "Test.Status.Extended" : "Test.Status.FreeDone",
            extended ? "gold" : "success");
    }

    private Task GoTests() => OnOpenTab.InvokeAsync(CandidateKompasTabs.Tests);

    private sealed record DnaItem(
        string TitleKey,
        string DetailHref,
        bool Completed,
        string? Outcome,
        string StatusKey,
        string StatusCss);
}
