@page "/candidate/paspoort"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [ExcludeFromInteractiveRouting]
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.CandidatePassport, FallbackPath = "/candidate/profile")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate
@using Jobsy.Web.Components.Candidate.Dna
@using Jobsy.Web.Components.Candidate.Passport
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Localization
@using Jobsy.Web.Features
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.Hosting
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject PersistentComponentState Persist
@inject IFeatureFlags FeatureFlags
@inject ICandidateHeroCompactPreviewGate HeroCompactPreview
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<PageTitle>@Culture["Passport.Title"] · Lobsy</PageTitle>

<div class="panel-page passport-page passport-page--illustrated @(HeroCompactPreview.Variant == CandidateHeroCompactPreviewVariant.C ? "passport-page--compact-preview-c" : null)"
     data-candidate-passport
     data-tab="@_tab">
    <h1 class="visually-hidden">@Culture["Passport.Title"]</h1>

    @if (_loading)
    {
        <PageContentSkeleton Variant="profile" LoadingLabel="@Culture["Common.Loading"]" />
    }
    else if (!string.IsNullOrWhiteSpace(_message) && _profile is null)
    {
        <p class="state-message">@_message</p>
    }
    else
    {
        <CandidateKompasGreetingBand FirstName="@_firstName" />

        <div class="passport-layout">
            <div class="passport-layout__sidebar passport-layout__card passport-layout__card--desktop">
                <PassportCard Compact="false"
                              DisplayName="@_displayName"
                              Initials="@_initials"
                              MemberNumber="@_memberNumber"
                              StartedStamp="@_startedStamp"
                              ShowOpenForWork="@_showOpenForWork"
                              Keywords="_keywords"
                              VerifiedCompetenceLabels="_verifiedCompetenceLabels"
                              CompletenessPercent="_completeness"
                              AboutMe="@_aboutMe"
                              City="@_city"
                              TravelLabel="@_travel"
                              HoursLabel="@_hours"
                              AvailableLabel="@_available"
                              LanguagesLabel="@_languages"
                              LookingFor="_lookingFor"
                              LicenseLabel="@_license"
                              DnaPassport="_flags.PassportPdfV2Enabled"
                              EditHref="@_dataTabHref"
                              CvDownloadHref="@CandidatePassportPdfEndpoints.LobsyCvPath" />
                <CandidateLobsyTipCard />
            </div>

            <div class="passport-layout__main">
                <div class="passport-layout__card passport-layout__card--mobile">
                    <PassportCard Compact="true"
                                  PdfDownloadTestId="passport-download-pdf-mobile"
                                  DisplayName="@_displayName"
                                  Initials="@_initials"
                                  MemberNumber="@_memberNumber"
                                  StartedStamp="@_startedStamp"
                                  ShowOpenForWork="@_showOpenForWork"
                                  Keywords="_keywords"
                                  VerifiedCompetenceLabels="_verifiedCompetenceLabels"
                                  CompletenessPercent="_completeness"
                                  OneLiner="@_oneLiner"
                                  DnaPassport="_flags.PassportPdfV2Enabled"
                                  EditHref="@_dataTabHref"
                                  CvDownloadHref="@CandidatePassportPdfEndpoints.LobsyCvPath" />
                </div>

                <PassportOverview CompetenceProgress="@Arc(AssessmentKind.Competence)"
                                  CareerProgress="@Arc(AssessmentKind.Career)"
                                  CultureProgress="@Arc(AssessmentKind.Culture)"
                                  ValuesProgress="@Arc(AssessmentKind.Values)"
                                  CompletedCount="@LobsterStage"
                                  Strongest="@_strongest"
                                  StrongestStatus="@_strongestStatus"
                                  WorkFit="@_workFit"
                                  WorkFitStatus="@_workFitStatus"
                                  CultureHome="@_cultureHome"
                                  CultureHomeStatus="@_cultureHomeStatus"
                                  Important="@_important"
                                  ImportantStatus="@_importantStatus"
                                  TestsHref="@PassportRedirects.BuildPassportUrl(PassportTabs.Tests)" />

                @if (_encourageContext is not null)
                {
                    <ProfileEncouragementNudge ScreenKey="paspoort-home"
                                               Context="_encourageContext"
                                               PreviewTipId="@_encouragePreviewTipId" />
                }

                <FeatureVisible Feature="PlatformFeature.ReferenceVerification">
                    @if (_refVerificationEligible)
                    {
                        <ReferenceVerificationTipCard ScreenKey="paspoort-home"
                                                      Eligible="true"
                                                      UserId="@_profile?.Id.ToString()"
                                                      FirstEntryId="_firstWorkEntryId"
                                                      HasConfirmedReference="_hasConfirmedReference"
                                                      HideConfirmedFollowUp="true" />
                    }
                </FeatureVisible>

                @if (_flags.ReferenceVerificationEnabled
                     && (_verifiedCompetences.Count > 0 || _refVerificationRows.Any(r => r.Active && string.Equals(r.DisplayStatus, "confirmed", StringComparison.OrdinalIgnoreCase))))
                {
                    <PassportEmployerPreview VerifiedCompetences="_verifiedCompetences"
                                             Employers="_employers"
                                             VerificationRows="_refVerificationRows"
                                             AskAnotherHref="@AskAnotherReferenceHref()" />
                }

                <div class="passport-tabs-shell">
                    <div class="passport-tabs" role="tablist" aria-label="@Culture["Passport.Title"]">
                        @foreach (var tab in VisibleTabs()) {
                            var id = $"passport-tab-{tab}"; var selected = _tab == tab;
                            <a id="@id" class="passport-tab @(selected ?"passport-tab--active" : null)" role="tab" aria-selected="@(selected ? "true" : "false")" aria-controls="@($"passport-panel-{tab}")" tabindex="@(selected ? 0 : -1)" href="@PassportRedirects.BuildPassportUrl(tab)">
                                <span class="passport-tabs__icon" aria-hidden="true">@((MarkupString)TabIcon(tab))</span>
                                <span>@Culture[TabLabelKey(tab)]</span>
                                @if (tab == PassportTabs.Tests && _testsNextStepCount > 0) { <span class="passport-tabs__pill">@_testsNextStepCount</span> }
                            </a>
                        }
                    </div>
                </div>
                                <div class="passport-panels">
                    @if (_tab == PassportTabs.Dna) {
                        <article id="passport-panel-dna" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-dna">
                            <PanelErrorBoundary Name="passport-dna">
                                <PassportDnaTab @rendermode="InteractiveTab" BubbleText="@BubbleFor(PassportTabs.Dna)" Highlights="_highlights" TestsComplete="@(_completedTests >= 4)" Story="@_story" StoryGeneratedAt="_storyAt" Keywords="_keywords" Hobbies="_hobbies" CultureDetail="_cultureDetail" ValuesDetail="_valuesDetail" Shells="_shells" TestsHref="@PassportRedirects.BuildPassportUrl(PassportTabs.Tests)" />
                            </PanelErrorBoundary>
                        </article>
                    } else if (_tab == PassportTabs.Tests) {
                        <article id="passport-panel-tests" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-tests">
                            <LobsyBubble Text="@BubbleFor(PassportTabs.Tests)" />
                            <PanelErrorBoundary Name="passport-tests"><PassportTestsTab @rendermode="InteractiveTab" Active="true" Snapshot="_kompas" /></PanelErrorBoundary>
                        </article>
                    } else if (_tab == PassportTabs.Fit) {
                        <article id="passport-panel-fit" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-fit">
                            @if (_flags.EmployersEnabled || _flags.FutureJobsForYouEnabled) {
                                <LobsyBubble Text="@BubbleFor(PassportTabs.Fit)" />
                                <PanelErrorBoundary Name="passport-fit"><PassportFitTab @rendermode="InteractiveTab" Active="true" Snapshot="_kompas" OpenForWork="@(_profile?.OpenForWork ?? true)" CheckTitle="@_fitCheck" /></PanelErrorBoundary>
                            } else { <p class="login-lead" data-testid="passport-fit-soon">@Culture["Passport.Fit.Soon"]</p> }
                        </article>
                    } else if (_tab == PassportTabs.Career) {
                        <article id="passport-panel-career" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-career">
                            <LobsyBubble Text="@BubbleFor(PassportTabs.Career)" />
                            <PanelErrorBoundary Name="passport-career"><PassportCareerTab @rendermode="InteractiveTab" Active="true" /></PanelErrorBoundary>
                        </article>
                    } else if (_tab == PassportTabs.Proof) {
                        <article id="passport-panel-proof" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-proof">
                            <LobsyBubble Text="@BubbleFor(PassportTabs.Proof)" />
                            <PanelErrorBoundary Name="passport-proof"><PassportProofTab @rendermode="InteractiveTab" Active="true" InitialItem="@_proofItem" /></PanelErrorBoundary>
                        </article>
                    } else if (_tab == PassportTabs.References) {
                        <article id="passport-panel-references" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-references">
                            <LobsyBubble Text="@BubbleFor(PassportTabs.References)" />
                            <PanelErrorBoundary Name="passport-references"><PassportReferenceVerificationTab @rendermode="InteractiveTab" Active="true" FirstWorkExperienceEntryId="_firstWorkEntryId" /></PanelErrorBoundary>
                        </article>
                    } else if (_tab == PassportTabs.Data) {
                        <article id="passport-panel-data" class="passport-panel" role="tabpanel" aria-labelledby="passport-tab-data">
                            <LobsyBubble Text="@BubbleFor(PassportTabs.Data)" />
                            <PanelErrorBoundary Name="passport-data"><PassportDataTab @rendermode="InteractiveTab" Active="true" DangerIntent="@_dataDangerIntent" Section="@_dataSection" SectionLinks="true" ExternalMotivationForm="true" /></PanelErrorBoundary>
                        </article>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string DnaPersistKey = "passport-dna";
    private const string KompasPersistKey = "passport-kompas";

    private static readonly InteractiveServerRenderMode InteractiveTab = new(prerender: false);

    private string _tab = PassportTabs.Dna;
    private string? _dataSection;
    private string _dataTabHref = PassportRedirects.BuildPassportUrl(PassportTabs.Data);
    private string? _dataDangerIntent;
    private string? _fitCheck;
    private string? _proofItem;
    private bool _freshLayer;
    private bool _loading = true;
    private string? _message;
    private FeatureFlagSnapshot _flags = FeatureFlagSnapshot.Defaults;

    private MeProfile? _profile;
    private ProfileEncouragementContext? _encourageContext;
    private string? _encouragePreviewTipId;
    private CandidateKompasState? _kompas;
    private CandidateDnaSummary? _dna;
    private CandidateDnaViewBuilder.DnaViewModel? _view;

    private string _displayName = "";
    private string? _firstName;
    private string _initials = "?";
    private string _memberNumber = "";
    private string? _startedStamp;
    private bool _showOpenForWork;
    private readonly List<string> _keywords = [];
    private int _completeness;
    private string? _aboutMe;
    private string? _city;
    private string? _travel;
    private string? _hours;
    private string? _available;
    private string? _languages;
    private readonly List<string> _lookingFor = [];
    private readonly List<string> _hobbies = [];
    private string? _license;
    private string _oneLiner = "";
    private int _completedTests;
    private int _testsNextStepCount;
    private string? _strongest;
    private string? _strongestStatus;
    private string? _workFit;
    private string? _workFitStatus;
    private string? _cultureHome;
    private string? _cultureHomeStatus;
    private string? _important;
    private string? _importantStatus;
    private string? _story;
    private DateTime? _storyAt;
    private CandidateDnaViewBuilder.DetailBlock? _cultureDetail;
    private CandidateDnaViewBuilder.DetailBlock? _valuesDetail;
    private List<CandidateDnaViewBuilder.DnaHighlight> _highlights = [];
    private PassportShellRules.ShellProgress _shells = new([], 0, 0, 0);
    private int _applicationCount;
    private bool _refVerificationEligible;
    private bool _hasConfirmedReference;
    private Guid? _firstWorkEntryId;
    private List<JobsyApiClient.VerifiedCompetenceItem> _verifiedCompetences = [];
    private IReadOnlyList<string> _verifiedCompetenceLabels = [];
    private List<JobsyApiClient.ReferenceVerificationListItem> _refVerificationRows = [];
    private List<CandidateEmployerHistory> _employers = [];
    private PersistingComponentStateSubscription _persistSubscription;

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistPassportState);
        if (Persist.TryTakeFromJson<CandidateDnaSummary>(DnaPersistKey, out var dna) && dna is not null)
        {
            _dna = dna;
        }

        if (Persist.TryTakeFromJson<CandidateKompasState>(KompasPersistKey, out var kompas) && kompas is not null)
        {
            _kompas = kompas;
        }

        ApplyTabFromUri();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _flags = await FeatureFlags.GetAsync();
            if (!_flags.CandidatePassportEnabled)
            {
                Navigation.NavigateTo(PassportRedirects.ToClassicProfileUrl(Navigation.Uri), replace: true);
                return;
            }

            var dnaTask = Api.GetMyKompasDnaResultAsync();
            var kompasTask = Api.GetMyKompasResultAsync();
            await Task.WhenAll(dnaTask, kompasTask);

            var dnaResult = await dnaTask;
            if (!dnaResult.TemporarilyUnavailable && dnaResult.Value is not null)
            {
                _dna = dnaResult.Value;
            }

            var kompasResult = await kompasTask;
            if (!kompasResult.TemporarilyUnavailable && kompasResult.Value is not null)
            {
                _kompas = kompasResult.Value;
            }

            ApplyModel();
        }
        catch (Exception)
        {
            _message = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }

        _ = LoadPassportSecondaryAsync();
    }

    private async Task LoadPassportSecondaryAsync()
    {
        try
        {
            _encourageContext = await ProfileEncouragementContextFactory.CreateAsync(Api, _profile);
            ApplyEncouragePreviewFromUri();
            try
            {
                var apps = await Api.GetMyApplicationsAsync();
                _applicationCount = apps?.Count ?? 0;
            }
            catch
            {
                _applicationCount = 0;
            }

            ApplyShells();
            await LoadReferenceVerificationAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Secondary blocks can hydrate later; core paspoort is already visible.
        }
    }

    private async Task LoadReferenceVerificationAsync()
    {
        if (!_flags.ReferenceVerificationEnabled)
        {
            return;
        }

        _refVerificationEligible = await Api.GetReferenceVerificationEligibleAsync();
        _verifiedCompetences = (await Api.GetVerifiedCompetencesAsync()).ToList();
        _verifiedCompetenceLabels = _verifiedCompetences
            .Select(c => c.Label)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        _refVerificationRows = (await Api.GetReferenceVerificationListAsync()).ToList();
        _hasConfirmedReference = _refVerificationRows.Any(r =>
            r.Active && string.Equals(r.DisplayStatus, "confirmed", StringComparison.OrdinalIgnoreCase));
        _employers = _profile?.Preferences?.Employers ?? [];
        _firstWorkEntryId = _employers
            .FirstOrDefault(e => !string.IsNullOrWhiteSpace(e.EmployerName))?.EntryId;
    }

    private string? AskAnotherReferenceHref()
        => _refVerificationEligible && _hasConfirmedReference && _firstWorkEntryId is Guid id
            ? $"/candidate/paspoort/referentie/vraag/{id:D}"
            : null;

    private IReadOnlyList<string> VisibleTabs()
        => PassportTabs.Visible(
            _flags.EmployersEnabled,
            _flags.FutureJobsForYouEnabled,
            _flags.ReferenceVerificationEnabled);

    private Task PersistPassportState()
    {
        if (_kompas is not null)
        {
            Persist.PersistAsJson(KompasPersistKey, _kompas);
        }

        if (_dna is not null)
        {
            Persist.PersistAsJson(DnaPersistKey, _dna);
        }

        return Task.CompletedTask;
    }

    public void Dispose() => _persistSubscription.Dispose();

    private void ApplyTabFromUri()
    {
        var query = HttpContextAccessor.HttpContext?.Request.Query;
        if (query is null || query.Count == 0)
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            query = new QueryCollection(QueryHelpers.ParseQuery(uri.Query));
        }

        var tab = PassportTabs.Dna;
        if (query.TryGetValue("tab", out var values)) tab = PassportTabs.Normalize(values.FirstOrDefault());
        _freshLayer = query.TryGetValue("laag", out var laag) && string.Equals(laag.FirstOrDefault(), "1", StringComparison.Ordinal);
        _proofItem = query.TryGetValue("item", out var item) ? item.FirstOrDefault() : null;
        _fitCheck = query.TryGetValue("check", out var check) ? check.FirstOrDefault() : null;
        _encouragePreviewTipId = query.TryGetValue("encouragePreview", out var preview) ? preview.FirstOrDefault() : null;
        _dataDangerIntent = query.TryGetValue("danger", out var danger) ? danger.FirstOrDefault() : null;
        _dataSection = query.TryGetValue("section", out var section) ? section.FirstOrDefault() : null;
        _tab = tab;
    }

    private void ApplyEncouragePreviewFromUri()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _encouragePreviewTipId = query.TryGetValue("encouragePreview", out var v)
            ? v.FirstOrDefault()
            : null;
    }

    private void ApplyModel()
    {
        _profile = _kompas?.Profile;
        _completeness = CandidateDnaViewBuilder.EffectiveCompletenessPercent(_kompas, _dna);
        var who = _kompas?.WhoAmI ?? _dna?.WhoAmI;
        _story = string.IsNullOrWhiteSpace(who?.Story) ? null : who!.Story;
        _storyAt = who?.GeneratedAtUtc;
        _keywords.Clear();
        if (who?.Keywords is { Count: > 0 })
        {
            _keywords.AddRange(who.Keywords.Where(k => !string.IsNullOrWhiteSpace(k)).Take(6));
        }

        _displayName = string.IsNullOrWhiteSpace(_profile?.FullName)
            ? Culture["Passport.Title"]
            : _profile!.FullName;
        _firstName = string.IsNullOrWhiteSpace(_profile?.FirstName)
            ? _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
            : _profile!.FirstName;
        _initials = InitialsFrom(_profile);
        _memberNumber = PassportMemberNumber.Format(_profile?.Id ?? Guid.Empty);
        // Account creation month is not on MeProfile yet — hide stamp rather than invent.
        _startedStamp = null;
        _showOpenForWork = _flags.EmployersEnabled && (_profile?.OpenForWork ?? false);
        _aboutMe = _profile?.Preferences?.AboutMe;
        _city = CityFromAddress(_profile?.Preferences?.HomeAddress);
        var prefs = _profile?.Preferences;
        var transportLabel = string.Join(
            " + ",
            TransportLabels.SplitMany(prefs?.PreferredTransport).Select(mode => UiLabels.Transport(Culture, mode)));
        _travel = prefs?.MaxTravelMinutes is int m && transportLabel.Length > 0
            ? $"{transportLabel} {m} min"
            : null;
        if (prefs?.MinHoursPerWeek is decimal || prefs?.MaxHoursPerWeek is decimal)
        {
            var min = prefs!.MinHoursPerWeek;
            var max = prefs.MaxHoursPerWeek;
            if (min is not null && max is not null)
            {
                _hours = $"{min:0}-{max:0} u";
            }
            else
            {
                _hours = $"{(max ?? min):0} u";
            }
        }
        else
        {
            _hours = null;
        }

        _available = FormatAvailability(prefs);
        _lookingFor.Clear();
        if (prefs?.Roles is { Count: > 0 })
        {
            _lookingFor.AddRange(prefs.Roles
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Select(r => UiLabels.WorkType(Culture, r.Trim())));
        }

        _license = DrivingLicenseLabels.Combine(prefs?.DrivingLicenses);
        _languages = FormatLanguages(prefs);
        _hobbies.Clear();
        foreach (var hobby in prefs?.Hobbies ?? [])
        {
            if (string.IsNullOrWhiteSpace(hobby))
            {
                continue;
            }

            _hobbies.Add(DiscoveryCatalogs.IsKnownHobby(hobby)
                ? Culture[DiscoveryCatalogs.HobbyLabelKey(hobby)]
                : hobby);
        }

        _oneLiner = string.Join(" · ", new[]
        {
            _city,
            _travel,
            _hours
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

        CandidateDnaViewBuilder.TextLookup t = k => Culture[k];
        CandidateDnaViewBuilder.TextFormat format = (k, args) => Culture.Format(k, args);
        _view = _kompas is not null
            ? CandidateDnaViewBuilder.FromKompas(_kompas, t, format, Culture.Language)
            : _dna is not null
                ? CandidateDnaViewBuilder.FromDnaSummary(_dna, t, format, Culture.Language)
                : null;

        _highlights = _view?.Highlights.ToList() ?? [];
        _completedTests = _view?.CompletedCount ?? 0;
        _cultureDetail = _view?.CultureDetail;
        _valuesDetail = _view?.ValuesDetail;
        _testsNextStepCount = _view?.Cards.Count(c => !c.Completed) ?? 0;

        ApplyStats();
    }

    private void ApplyStats()
    {
        _strongest = null;
        _strongestStatus = null;
        _workFit = null;
        _workFitStatus = null;
        _cultureHome = null;
        _cultureHomeStatus = null;
        _important = null;
        _importantStatus = null;
        if (_view is null)
        {
            return;
        }

        var competence = _view.Cards.FirstOrDefault(c => c.Kind == AssessmentKind.Competence);
        var career = _view.Cards.FirstOrDefault(c => c.Kind == AssessmentKind.Career);
        var culture = _view.Cards.FirstOrDefault(c => c.Kind == AssessmentKind.Culture);
        var values = _view.Cards.FirstOrDefault(c => c.Kind == AssessmentKind.Values);

        if (competence is { TopLabel: not null })
        {
            _strongest = competence.TopLabel;
            _strongestStatus = StatusLabel(competence);
        }

        if (career is { TopLabel: not null })
        {
            _workFit = career.TopLabel;
            _workFitStatus = career.Summary.Contains('·', StringComparison.Ordinal) ? career.Summary : null;
        }

        if (culture is { TopLabel: not null })
        {
            _cultureHome = culture.TopLabel;
            _cultureHomeStatus = StatusLabel(culture);
        }

        if (values is { TopLabel: not null })
        {
            _important = values.TopLabel;
            _importantStatus = StatusLabel(values);
        }
    }

    private void ApplyShells()
    {
        var extended = _view?.Cards.Count(c => c.Extended) ?? 0;
        var hasCv = _profile?.UploadedCv is not null;
        var remaining = _view is null ? 0 : CandidateDnaViewBuilder.NearestUnfinishedRemaining(_view.Cards);
        _shells = PassportShellRules.Evaluate(
            _completedTests,
            extended,
            hasCv,
            _applicationCount,
            _flags.EmployersEnabled,
            remaining);
    }

    private string StatusLabel(CandidateDnaViewBuilder.DnaCard card)
    {
        if (card.Extended)
        {
            return Culture["Test.Status.Extended"];
        }

        if (card.Completed)
        {
            return Culture["Dna.StatusComplete"];
        }

        if (card.IsProvisional)
        {
            return Culture["Onboarding.ProvisionalBadge"];
        }

        return Culture["Test.Status.NotDone"];
    }

    private int LobsterStage => PassportShellRules.LobsterStage(
        _completedTests,
        _view?.Cards.Any(c => c.IsProvisional || c.Answered > 0) == true);

    private double Arc(AssessmentKind kind)
    {
        var card = _view?.Cards.FirstOrDefault(c => c.Kind == kind);
        return card is null ? 0 : CandidateDnaViewBuilder.ArcProgress(card);
    }

    private string BubbleFor(string tab)
    {
        if (tab == PassportTabs.Dna && _completedTests == 0)
        {
            return Culture["Passport.Bubble.DnaEmpty"];
        }

        return Culture[tab switch
        {
            PassportTabs.Tests => "Passport.Bubble.Tests",
            PassportTabs.Fit => "Passport.Bubble.Fit",
            PassportTabs.Career => "Passport.Bubble.Career",
            PassportTabs.Proof => "Passport.Bubble.Proof",
            PassportTabs.References => "Passport.Bubble.References",
            PassportTabs.Data => "Passport.Bubble.Data",
            _ => _freshLayer ? "Passport.Bubble.Dna" : "Passport.Bubble.DnaSteady"
        }];
    }

    private static string TabLabelKey(string tab) => tab switch
    {
        PassportTabs.Tests => "Passport.Tab.Tests",
        PassportTabs.Fit => "Passport.Tab.Fit.Compact",
        PassportTabs.Career => "Passport.Tab.Career",
        PassportTabs.Proof => "Passport.Tab.Proof",
        PassportTabs.References => "Passport.Tab.References",
        PassportTabs.Data => "Passport.Tab.Data.Compact",
        _ => "Passport.Tab.Dna"
    };

    private static string TabIcon(string tab) => tab switch
    {
        PassportTabs.Tests => NavIcons.Vacancies,
        PassportTabs.Fit => NavIcons.Target,
        PassportTabs.Career => NavIcons.Career,
        PassportTabs.Proof => NavIcons.Stone,
        PassportTabs.References => NavIcons.Shared,
        PassportTabs.Data => NavIcons.Profile,
        _ => NavIcons.DnaHelix
    };

    private static string InitialsFrom(MeProfile? profile)
    {
        var first = profile?.FirstName?.Trim();
        var last = profile?.LastName?.Trim();
        if (!string.IsNullOrEmpty(first) || !string.IsNullOrEmpty(last))
        {
            var a = string.IsNullOrEmpty(first) ? "" : first[..1];
            var b = string.IsNullOrEmpty(last) ? "" : last[..1];
            return (a + b).ToUpperInvariant();
        }

        var name = profile?.FullName?.Trim();
        if (string.IsNullOrEmpty(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0][..1].ToUpperInvariant();
        }

        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string? CityFromAddress(string? address)
        => HomeAddressCity.From(address);

    private string? FormatLanguages(CandidatePreferences? prefs)
    {
        if (prefs is null)
        {
            return null;
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(prefs.DutchLevel)
            && DiscoveryCatalogs.IsKnownDutchLevel(prefs.DutchLevel))
        {
            parts.Add($"Nederlands: {Culture[DiscoveryCatalogs.DutchLabelKey(prefs.DutchLevel)].ToLowerInvariant()}");
        }

        var others = (prefs.SpokenLanguages ?? [])
            .Where(l => !string.IsNullOrWhiteSpace(l.Code)
                        && !string.Equals(l.Code, "nl", StringComparison.OrdinalIgnoreCase))
            .Take(2)
            .Select(l =>
            {
                var name = LanguageDisplayName(l.Code);
                if (!string.IsNullOrWhiteSpace(l.Level) && DiscoveryCatalogs.IsKnownDutchLevel(l.Level))
                {
                    return $"{name}: {Culture[DiscoveryCatalogs.DutchLabelKey(l.Level)].ToLowerInvariant()}";
                }

                return name;
            })
            .ToList();
        parts.AddRange(others);

        var extra = (prefs.SpokenLanguages?.Count ?? 0)
                    - (prefs.SpokenLanguages ?? []).Count(l => string.Equals(l.Code, "nl", StringComparison.OrdinalIgnoreCase))
                    - others.Count;
        if (extra > 0)
        {
            parts.Add($"+{extra}");
        }

        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    private static string LanguageDisplayName(string code)
    {
        try
        {
            var info = System.Globalization.CultureInfo.GetCultureInfo(code);
            var name = info.NativeName;
            if (string.IsNullOrWhiteSpace(name))
            {
                name = info.EnglishName;
            }

            return string.IsNullOrWhiteSpace(name)
                ? code.ToUpperInvariant()
                : char.ToUpperInvariant(name[0]) + name[1..];
        }
        catch (System.Globalization.CultureNotFoundException)
        {
            return code.ToUpperInvariant();
        }
    }

    private string? FormatAvailability(CandidatePreferences? prefs)
    {
        if (prefs is null)
        {
            return null;
        }

        if (_profile?.AvailableFromDate is DateOnly fromDate)
        {
            return fromDate.ToString("dd-MM-yyyy");
        }

        if (prefs.AvailabilityPresets is { Count: > 0 })
        {
            return string.Join(", ", prefs.AvailabilityPresets.Take(2));
        }

        return Culture["Profile.PresetImmediate"];
    }

}
