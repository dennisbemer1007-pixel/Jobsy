    private async Task<int> CountAnsweredAsync(OnboardingWizardCatalog.OnboardingTestKind kind)
    {
        Dictionary<string, int>? answers = kind switch
        {
            OnboardingWizardCatalog.OnboardingTestKind.Competency => (await Api.GetMyCompetenciesAsync())?.Answers,
            OnboardingWizardCatalog.OnboardingTestKind.Career => (await Api.GetMyCareerInterestsAsync())?.Answers,
            OnboardingWizardCatalog.OnboardingTestKind.Culture => (await Api.GetMyCultureAsync())?.Answers,
