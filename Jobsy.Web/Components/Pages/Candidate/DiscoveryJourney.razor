    private async Task DreamDebounceAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(350, cancellationToken);
            await SaveDreamAsync();
            _saveStatus = "saved";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            _saveStatus = "error";
        }
    }

