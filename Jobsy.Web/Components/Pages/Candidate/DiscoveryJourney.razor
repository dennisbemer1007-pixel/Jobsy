    private async Task SaveDebounceAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(400, cancellationToken);
            await FlushAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PrivateDebounceAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(400, cancellationToken);
            await FlushPrivateAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task FlushAsync()
    {
        _saveStatus = "saving";
        try
        {
            await Api.UpdateMyProfileAsync(
                firstName: Draft.FirstName.Trim(),
                lastName: Draft.LastName.Trim(),
                phoneNumber: string.IsNullOrWhiteSpace(Draft.Phone) ? null : Draft.Phone.Trim(),
                whatsAppContactAllowed: Draft.WhatsAppAllowed && !string.IsNullOrWhiteSpace(Draft.Phone),
                dateOfBirth: Draft.BirthDate,
                homeLatitude: Draft.HomeLat,
                homeLongitude: Draft.HomeLng,
                preferences: new CandidatePreferences
                {
                    HomeAddress = HomeAddress(),
                    MinHoursPerWeek = Draft.MinHours,
                    MaxHoursPerWeek = Draft.MaxHours,
                    MaxTravelMinutes = Draft.MaxTravel,
                    PreferredTransport = string.IsNullOrWhiteSpace(Draft.Transport) ? null : Draft.Transport,
                    AvailabilityPresets = Draft.Presets.ToList(),
                    AvailabilityPresetsOverridden = Draft.PresetsOverridden,
                    Availability = BuildAvailability(),
                    NoWorkExperience = Draft.NoWork,
                    Employers = Draft.Jobs.ToList(),
                    Educations = string.IsNullOrWhiteSpace(Draft.Education)
                        ? []
                        : [OnboardingWizardCatalog.FormatEducationLine(Draft.Education, Draft.EducationDirection)],
                    EducationDirection = Draft.EducationDirection,
                    DrivingLicenses = Draft.DrivingLicenses.OrderBy(x => x).ToList(),
                    Roles = Draft.Roles.OrderBy(r => r).ToList(),
                    AboutMe = string.IsNullOrWhiteSpace(Draft.AboutMe) ? null : Draft.AboutMe.Trim(),
                    Certificates = Draft.Certificates
                        .Where(c => !string.IsNullOrWhiteSpace(c.Name))
                        .Select(c => new CandidateCertificate { Name = c.Name.Trim(), Year = c.Year })
                        .ToList(),
                    SpokenLanguages = Draft.SpokenLanguages
                        .Where(l => !string.IsNullOrWhiteSpace(l.Code))
                        .Select(l => new CandidateLanguage { Code = l.Code, Level = l.Level })
                        .Take(DiscoveryCatalogs.MaxSpokenLanguages)
                        .ToList(),
                    DutchLevel = string.IsNullOrWhiteSpace(Draft.DutchLevel) ? null : Draft.DutchLevel.Trim(),
                    EmployerPreferences = Draft.EmployerPreferences.OrderBy(x => x).ToList(),
                    LearningGoals = Draft.LearningGoals
                        .Where(g => !string.IsNullOrWhiteSpace(g))
                        .Select(g => g.Trim())
                        .Take(DiscoveryCatalogs.MaxLearningGoals)
                        .ToList(),
                    Hobbies = Draft.Hobbies
                        .Concat(Draft.HobbyFreeText.Where(h => !string.IsNullOrWhiteSpace(h)).Select(h => h.Trim()))
                        .Take(DiscoveryCatalogs.MaxHobbies)
                        .ToList()
                },
                availableFromDate: Draft.Immediate ? null : Draft.AvailableFrom,
                clearAvailableFromDate: Draft.Immediate);
            _saveStatus = "saved";
        }
        catch
        {
            _saveStatus = "error";
            throw;
        }
    }

    private async Task FlushPrivateAsync()
    {
        _saveStatus = "saving";
        try
        {
            await Api.UpdateMyPrivatePreferencesAsync(
                Draft.Dislikes.OrderBy(x => x).ToList(),
                Draft.CustomDislikes
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Select(c => c.Trim())
                    .Take(DiscoveryCatalogs.MaxCustomDislikes)
                    .ToList());
            _saveStatus = "saved";
        }
        catch
        {
            _saveStatus = "error";
            throw;
        }
    }

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in Draft.Availability)
        {
            var pair = key.Split(':', 2);
            if (pair.Length != 2) continue;
            if (!result.TryGetValue(pair[0], out var values)) result[pair[0]] = values = [];
            values.Add(pair[1]);
        }

        return result;
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        _saveCts?.Cancel();
        _privateCts?.Cancel();
        _geocodeCts?.Cancel();
        _dreamCts?.Cancel();
        if (_autosave is not null) await _autosave.DisposeAsync();
    }
