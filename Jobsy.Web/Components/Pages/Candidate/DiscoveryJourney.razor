    private async Task FlushTestSaveAsync(bool completed)
    {
        if (_autosave is not null) await _autosave.FlushAsync();
        var merged = new Dictionary<int, int>(_serverAnswers);
        foreach (var a in _miniAnswers) merged[a.Key] = a.Value;
        switch (_countedStep)
        {
            case 7: await Api.SaveMyCompetenciesAsync(merged, completed); break;
            case 8: await Api.SaveMyCareerInterestsAsync(merged, completed); break;
            case 9: await Api.SaveMyCultureAsync(merged, completed); break;
            case 10: await Api.SaveMyValuesAsync(merged, completed); break;
        }
    }

    private async Task BuildOverviewAsync()
    {
        _overviewRows = [];
        foreach (var step in JourneyCatalog.Steps.Take(6))
        {
            var ev = _state?.Steps.FirstOrDefault(s => s.Step == step.Number);
            var filled = ev?.CompletedAtUtc is not null || ev?.SkippedAtUtc is not null;
            // Only a finished v2 journey left steps 3–6 empty. A finished v3 journey is done.
            var isNew = DiscoveryOverviewRules.StepLooksNew(
                _state?.IsComplete == true,
                _state?.WizardVersion ?? OnboardingWizardCatalog.WizardVersionV3,
                step.Number,
                filled);

            string status;
            string cls;
            if (ev?.SkippedAtUtc is not null)
            {
                status = Culture["Discovery.Overview.Skipped"];
                cls = "is-skipped";
            }
            else if (ev?.CompletedAtUtc is not null)
            {
                status = Culture["Discovery.Overview.Done"];
                cls = "is-done";
            }
            else if (isNew)
            {
                status = Culture["Discovery.Overview.New"];
                cls = "is-new";
            }
            else
            {
                status = Culture["Discovery.Overview.Done"];
                cls = "is-done";
            }

            _overviewRows.Add(new JourneyOverview.OverviewRow(
                step.Number, step.TitleKey, status, cls, Culture["Discovery.Overview.View"]));
        }

        if (!Draft.HasConsent)
        {
            _overviewRows.Add(new JourneyOverview.OverviewRow(
                0, "Discovery.Overview.Consent", Culture["Discovery.Overview.New"], "is-new",
                Culture["Discovery.Overview.GiveConsent"], IsConsent: true));
        }

        _overviewTests = [];
        foreach (var step in new[] { 7, 8, 9, 10 })
        {
            var kind = OnboardingWizardCatalog.TestKindForStep(step)!.Value;
            var answered = await CountAnsweredAsync(kind);
            var full = OnboardingWizardCatalog.FullLevelCount(kind);
            var complete = answered >= full;
            var next = new List<JourneyOverview.DepthButton>();
            if (!complete)
            {
                if (answered < OnboardingWizardCatalog.DeeperLevelCount)
                {
                    next.Add(new(OnboardingWizardCatalog.DeeperLevelCount, Culture["Discovery.Shed.Deeper"]));
                }

                next.Add(new(full, kind == OnboardingWizardCatalog.OnboardingTestKind.Culture
                    ? Culture["Discovery.Overview.All18"]
                    : Culture["Discovery.Shed.Deepest"]));
            }

            var report = step switch
            {
                7 => "/candidate/paspoort?tab=tests",
                8 => "/candidate/paspoort?tab=tests",
                9 => "/candidate/paspoort?tab=tests",
                _ => "/candidate/paspoort?tab=tests"
            };
            _overviewTests.Add(new JourneyOverview.TestRow(
                step,
                OnboardingWizardCatalog.TestNameKey(kind),
                Culture.Format("Discovery.Overview.Depth", answered, full),
                complete,
                report,
                next));
        }
    }

