    private async Task PrepareMiniAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
            _autosave = null;
        }

        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _miniQuestions = [];
        _currentQuestion = 0;
        if (_countedStep is < 7 or > 10 || !Draft.HasConsent) return;

        var kind = OnboardingWizardCatalog.TestKindForStep(_countedStep)!.Value;
        if (_targetLevel < OnboardingWizardCatalog.MiniLevelCount)
        {
            _targetLevel = OnboardingWizardCatalog.MiniLevelCount;
        }

        Dictionary<string, int>? answers;
        IEnumerable<(int Id, string Key)> catalog;
        switch (_countedStep)
        {
            case 7:
                answers = (await Api.GetMyCompetenciesAsync())?.Answers;
                catalog = CompetencyTestCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            case 8:
                answers = (await Api.GetMyCareerInterestsAsync())?.Answers;
                catalog = CareerTestCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            case 9:
                answers = (await Api.GetMyCultureAsync())?.Answers;
                catalog = CulturePersonalityCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            default:
                answers = (await Api.GetMyValuesAsync())?.Answers;
                catalog = SchwartzValuesCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
        }

        var questionIds = OnboardingWizardCatalog.QuestionIdsUpTo(kind, _targetLevel);

        foreach (var answer in answers ?? [])
        {
            if (int.TryParse(answer.Key, out var id) && answer.Value is >= 1 and <= 5)
            {
                _serverAnswers[id] = answer.Value;
            }
        }

        foreach (var id in questionIds)
        {
            if (_serverAnswers.ContainsKey(id)) _lockedIds.Add(id);
        }

        // Keep answered questions in the list so the counter stays "6 van 10".
        // Locked ids are the ones already saved; the first open question is where we start.
        var byId = catalog.ToDictionary(item => item.Id);
        _miniQuestions = questionIds
            .Where(id => byId.ContainsKey(id))
            .Select(id => new OnboardingMiniTest.MiniQuestion(id, byId[id].Key))
            .ToList();
        var open = catalog
            .Where(item => questionIds.Contains(item.Id) && !_lockedIds.Contains(item.Id))
            .Select(item => item.Id)
            .ToHashSet();
        var firstOpen = _miniQuestions.FindIndex(question => open.Contains(question.Id));
        _currentQuestion = firstOpen < 0 ? 0 : firstOpen;
        _autosave = new QuestionnaireAutosave(async (draft, cancellationToken) =>
        {
            var merged = new Dictionary<int, int>(_serverAnswers);
            foreach (var answer in draft) merged[answer.Key] = answer.Value;
            switch (_countedStep)
            {
                case 7:
                    await Api.SaveMyCompetenciesAsync(merged, false, cancellationToken);
                    break;
                case 8:
                    await Api.SaveMyCareerInterestsAsync(merged, false, cancellationToken);
                    break;
                case 9:
                    await Api.SaveMyCultureAsync(merged, false, cancellationToken);
                    break;
                case 10:
                    await Api.SaveMyValuesAsync(merged, false, cancellationToken);
                    break;
            }
        }, () => InvokeAsync(StateHasChanged), 150);
    }

    private async Task TryAutoAdvanceEmptyMiniStepAsync()
    {
        if (_miniArrivedViaBack || _screen == "start" || _screen == "toestemming") return;
        if (_countedStep is < 7 or > 10) return;
        if (!Draft.HasConsent) return;
        if (_miniQuestions.Any(q => !_serverAnswers.ContainsKey(q.Id) && !_miniAnswers.ContainsKey(q.Id))) return;

        _busy = true;
        try
        {
            // Already answered at/above target → shed (or next if fully done and continuing).
            await ShowShedAsync(_countedStep);
            return;
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveStatus = "error";
        }
        finally
        {
            _busy = false;
        }
    }

