    private void ApplyPresets()
    {
        var result = AvailabilityPresetRules.Compute(Draft.Presets, Draft.MinHours, Draft.MaxHours);
        Draft.MinHours = result.MinHours;
        Draft.MaxHours = result.MaxHours;
        Draft.Availability.Clear();
        foreach (var dayPart in result.DayParts) Draft.Availability.Add(dayPart);
        Draft.Immediate = result.Immediate;
        if (Draft.Immediate) Draft.AvailableFrom = null;
    }

