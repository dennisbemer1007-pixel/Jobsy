                return _shedStep >= 10
                    ? Culture["Discovery.Shed.ToLight"]
                    : Culture.Format("Discovery.Shed.NextTest", Culture[OnboardingWizardCatalog.TestNameKey(
                        OnboardingWizardCatalog.TestKindForStep(_shedStep + 1) ?? OnboardingWizardCatalog.OnboardingTestKind.Career)]);
            }

            return Culture["Discovery.Shed.DiveDeeper"];
        }
    }

