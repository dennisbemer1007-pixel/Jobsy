    private IEnumerable<string> AvailableLanguageCodes()
        => DiscoveryCatalogs.AddableSpokenLanguageCodes
            .Where(code => !Draft.SpokenLanguages.Any(l =>
                string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase)));

    private void OnAddLanguage(ChangeEventArgs e)
    {
        var code = DiscoveryCatalogs.CanonicalLanguage(e.Value?.ToString());
        if (code is null
            || string.Equals(code, "nl", StringComparison.OrdinalIgnoreCase)
            || Draft.SpokenLanguages.Count >= DiscoveryCatalogs.MaxSpokenLanguages) return;
        if (Draft.SpokenLanguages.Any(l => string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase))) return;
        Draft.SpokenLanguages.Add(new CandidateLanguage { Code = code });
        ScheduleProfileSave();
    }

    private void RemoveSpokenLanguage(string code)
    {
        Draft.SpokenLanguages.RemoveAll(l => string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase));
        ScheduleProfileSave();
    }

    private void SetSpokenLevel(string code, string? level)
    {
        var row = Draft.SpokenLanguages.FirstOrDefault(l => string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase));
        if (row is null) return;
        row.Level = string.IsNullOrWhiteSpace(level) ? null : level;
        ScheduleProfileSave();
    }

    private static string LanguageDisplay(string code)
    {
        try
        {
            var culture = System.Globalization.CultureInfo.GetCultureInfo(code);
            var name = culture.NativeName;
            if (string.IsNullOrWhiteSpace(name) || name.Equals(code, StringComparison.OrdinalIgnoreCase))
            {
                name = culture.EnglishName;
            }

            return string.IsNullOrWhiteSpace(name) ? code.ToUpperInvariant() : char.ToUpper(name[0]) + name[1..];
        }
        catch (System.Globalization.CultureNotFoundException)
        {
            return code.ToUpperInvariant();
        }
    }

