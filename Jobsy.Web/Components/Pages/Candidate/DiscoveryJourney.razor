    private void ChooseDream(DreamJob job)
    {
        Draft.Dream = job.TitleNl;
        Draft.DreamSearch = "";
        ScheduleDreamSave();
    }

    private void ChooseOwnDream()
    {
        var dream = Draft.DreamSearch.Trim();
        Draft.Dream = dream[..Math.Min(128, dream.Length)];
        Draft.DreamSearch = "";
        ScheduleDreamSave();
    }

    private Task DreamKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Draft.DreamSearch = "";
        else if (e.Key == "Enter" && Draft.DreamSearch.Length > 0) ChooseOwnDream();
        return Task.CompletedTask;
    }

