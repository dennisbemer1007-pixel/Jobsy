    private void SplitAddress(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var index = value.Trim().IndexOf(' ');
        Draft.Postcode = index > 0 ? value[..index].Trim() : value.Trim();
        Draft.City = index > 0 ? value[(index + 1)..].Trim() : "";
    }

    private string HomeAddress() => $"{NormalizePostcode(Draft.Postcode)} {Draft.City.Trim()}".Trim();

    private static string NormalizePostcode(string value)
    {
        var raw = value.Replace(" ", "").ToUpperInvariant();
        return raw.Length == 6 ? raw[..4] + " " + raw[4..] : value.Trim().ToUpperInvariant();
    }

    private void AddressChanged()
    {
        Draft.HomeLat = Draft.HomeLng = null;
        Draft.PostcodeResolved = false;
        ScheduleProfileSave();
        _geocodeCts?.Cancel();
        _geocodeCts = new();
        _ = GeocodeAsync(_geocodeCts.Token);
    }

    private async Task GeocodeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(350, cancellationToken);
            var postcode = NormalizePostcode(Draft.Postcode);
            if (!System.Text.RegularExpressions.Regex.IsMatch(postcode, "^[1-9][0-9]{3} [A-Z]{2}$")) return;
            var result = (await Geocoder.SuggestAsync(postcode, cancellationToken))
                .FirstOrDefault(item => item.Label.Replace(" ", "")
                    .StartsWith(postcode.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
            if (result is null)
            {
                Draft.PostcodeMissing = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            SelectAddress(result);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            Draft.PostcodeMissing = true;
        }
    }

    private void SelectAddress(AddressSuggestion item)
    {
        Draft.HomeLat = item.Latitude;
        Draft.HomeLng = item.Longitude;
        SplitAddress(item.Label);
        Draft.Postcode = NormalizePostcode(Draft.Postcode);
        Draft.PostcodeResolved = true;
        Draft.PostcodeMissing = false;
        ScheduleProfileSave();
    }

    private void BirthDateChanged()
    {
        Draft.BirthDate = int.TryParse(Draft.BirthDay, out var day)
            && int.TryParse(Draft.BirthMonth, out var month)
            && int.TryParse(Draft.BirthYear, out var year)
            && DateOnly.TryParse($"{year:D4}-{month:D2}-{day:D2}", out var date)
                ? date : null;
        ScheduleProfileSave();
    }

