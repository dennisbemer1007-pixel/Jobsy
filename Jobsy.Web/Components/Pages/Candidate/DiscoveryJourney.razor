    private bool IsLightScreen => _screen is "klaar" or "overview";

    private bool JourneyFinished => _state?.IsComplete == true || _state?.FinishReached == true;

    /// <summary>Finished journeys keep the 10/10 rail, including when consent is reopened.</summary>
    private bool ShowFinishedChrome => IsLightScreen || (_screen == "toestemming" && JourneyFinished);

    private int _platesShed => ShowFinishedChrome
        ? 10
        : _screen == "shed"
            ? _shedStep
            : Math.Max(RailStep - 1, 0);
    private int RailStep => _screen switch
    {
        "toestemming" when JourneyFinished => 11,
        "toestemming" => 6,
        "shed" => _shedStep + 1,
        "klaar" or "overview" => 11,
        _ => _countedStep
    };

    private string CurrentStepTitle => _screen switch
    {
        "toestemming" => Culture["Discovery.Consent.Eyebrow"],
        "shed" => Culture["Discovery.Shed.Title"],
        "klaar" => Culture["Discovery.End.Eyebrow"],
        "overview" => Culture["Discovery.Overview.Title"],
        _ when _countedStep is >= 1 and <= 10 => Culture[JourneyCatalog.Steps[_countedStep - 1].TitleKey],
        _ => Culture["Discovery.Eyebrow"]
    };

    private string LobsterSay => _screen == "shed"
        ? Culture["Discovery.Shed.Lobster"]
        : Culture[JourneyCatalog.SayKey(_depth)];

    private string ShedTestName => Culture[OnboardingWizardCatalog.TestNameKey(
        OnboardingWizardCatalog.TestKindForStep(_shedStep) ?? OnboardingWizardCatalog.OnboardingTestKind.Competency)];

