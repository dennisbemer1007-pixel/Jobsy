@page "/candidate/start/kompas"
@layout OnboardingStartSsrLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.Hosting
@using Jobsy.Web.Onboarding
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject IOnboardingRustigGate OnboardingRustig
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/onboarding-wizard-v3.css")" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/onboarding-finale-v2.css")" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/kreeft-reiskaart.css")" />
</HeadContent>

@if (_loading)
{
    <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p>
}
else
{
    var pageTitle = Culture.Format("Onboarding.Finish.Title", _firstName);
    var pageLead = Culture["Onboarding.FinaleV2.Lead"];
    var phaseTag = Culture[OnboardingV3LayoutCatalog.PhaseTagKey(11)];
    <div class="ob-wizard ob-wizard--richting-a ob-wizard--rustig ob-wizard--v3" data-ob-rustig-screen="kompas">
        <div class="ob-rustig ob-v3-layout">
            <div class="ob-v3-desktop ob-v3-desktop--with-rail">
                <OnboardingStartprofielSidebar CurrentStep="11" LaterHref="/home" />
                <div class="ob-v3-main-col">
                    <div class="ob-v3-main">
                        <OnboardingV3StepChrome Step="10"
                                               PhaseLabel="@phaseTag"
                                               LaterHref="/home" />
                        <OnboardingV3InfoBanner Text="@pageLead" />
                        <div class="ob-v3-step-wrap">
                            <article class="ob-v3-step-card ob-v3-step-card--kompas-ready">
                                <p class="ob-v3-step-card__tag">@phaseTag</p>
                                <h1 class="ob-v3-step__title" tabindex="-1">@pageTitle</h1>
                                <div class="ob-v3-step__fields">
                                    @((MarkupString)_bodyHtml)
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
                <OnboardingV3RightRail Step="10" />
                @((MarkupString)KreeftReiskaartMarkup.ForScreen(Culture, 15))
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string _firstName = "";
    private string _bodyHtml = "";

    protected override async Task OnInitializedAsync()
    {
        if (!OnboardingRustig.Enabled)
        {
            RedirectTo(OnboardingRoutes.WizardStartPath);
            return;
        }

        try
        {
            var data = await OnboardingKompasSsrData.LoadAsync(Api, FeatureFlags);
            if (data is null)
            {
                RedirectTo(OnboardingRoutes.ClassicStartPath);
                return;
            }

            if (!data.State.FinishReached)
            {
                RedirectTo(OnboardingRoutes.StepUrl(Math.Clamp(data.State.CurrentStep, 1, 10)));
                return;
            }

            _firstName = data.FirstName;
            var model = new OnboardingKompasSsrShells.ReadyModel(
                _firstName,
                data.Impression,
                data.MatchCount,
                data.MaxTravelMinutes,
                data.HomeLabel,
                data.CardsInput,
                OnboardingRoutes.KompasHubPath,
                OnboardingKompasSsrData.FullTestsUrl);
            _bodyHtml = OnboardingKompasSsrShells.BuildReadyBody(Culture, model);
        }
        catch
        {
            RedirectTo(OnboardingRoutes.ClassicStartPath);
            return;
        }
        finally
        {
            _loading = false;
        }
    }

    private void RedirectTo(string url)
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            return;
        }

        http.Response.Redirect(url);
    }
}