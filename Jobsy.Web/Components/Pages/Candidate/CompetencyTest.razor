@page "/candidate/competencies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["Competency.Title"] · Lobsy</PageTitle>

<div class="panel-page profile-page profile-page--candidate competency-test-page">
    <header class="saved-gate__header profile-page__header">
        <h1>@Culture["Competency.Title"]</h1>
        <p class="login-lead">@Culture["Competency.Lead"]</p>
    </header>

    <article class="detail-card">
        <p class="login-lead">@Culture["Competency.ScienceNote"]</p>
        <p class="login-lead competency-privacy-note">
            @Culture["Competency.PrivacyNote"]
            <a href="/privacy">@Culture["Legal.Privacy"]</a>
        </p>
        <p class="competency-test__progress" aria-live="polite">
            @Culture.Format("Competency.Progress", AnsweredCount, CompetencyTestCatalog.QuestionCount)
        </p>
        <div class="competency-test__meter" role="progressbar" aria-valuemin="0" aria-valuemax="@CompetencyTestCatalog.QuestionCount" aria-valuenow="@AnsweredCount">
            <span style="width: @((AnsweredCount * 100 / CompetencyTestCatalog.QuestionCount).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
        </div>

        @if (_loading)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (_loadFailed)
        {
            <p class="state-message">@_message</p>
            <a class="login-submit" href="/candidate/competencies">@Culture["Competency.Reload"]</a>
        }
        else
        {
            @foreach (var category in CompetencyTestCatalog.CategoryCodes)
            {
                var questions = QuestionsFor(category);
                var done = questions.Count(q => _answers.ContainsKey(q.Id));
                <fieldset class="competency-test__cat">
                    <legend>@Culture[$"Competency.Cat.{category}"]</legend>
                    <p class="profile-address__hint">@Culture[$"Competency.Cat.{category}.Hint"]</p>
                    <p class="profile-address__hint">@Culture.Format("Competency.CategoryProgress", Culture[$"Competency.Cat.{category}"], done, questions.Count)</p>
                    @foreach (var question in questions)
                    {
                        <div class="competency-question">
                            <p class="competency-question__text">@question.Id. @Culture[question.TextKey]</p>
                            <div class="competency-likert" role="radiogroup" aria-label="@Culture[question.TextKey]">
                                @for (var value = 1; value <= 5; value++)
                                {
                                    var current = value;
                                    var id = $"q{question.Id}-{current}";
                                    <label class="competency-likert__opt @(_answers.TryGetValue(question.Id, out var selected) && selected == current ? "is-on" : null)">
                                        <input type="radio"
                                               name="@($"q{question.Id}")"
                                               id="@id"
                                               value="@current"
                                               checked="@(_answers.TryGetValue(question.Id, out var v) && v == current)"
                                               @onchange="() => SetAnswer(question.Id, current)" />
                                        <span>@Culture[$"Competency.Likert.{current}"]</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
            }

            var riasecQuestions = _questions.Count > 0
                ? _questions.Where(q => q.IsRiasec).OrderBy(q => q.Id).ToList()
                : CompetencyTestCatalog.Questions.Where(q => q.IsRiasec)
                    .Select(q => new CompetencyQuestionItem { Id = q.Id, Category = q.Category, Reverse = q.Reverse, TextKey = q.TextKey, IsRiasec = true })
                    .ToList();
            var riasecDone = riasecQuestions.Count(q => _answers.ContainsKey(q.Id));
            <fieldset class="competency-test__cat">
                <legend>@Culture["Competency.Cat.RIASEC"]</legend>
                <p class="profile-address__hint">@Culture["Competency.Cat.RIASEC.Hint"]</p>
                <p class="profile-address__hint">@Culture.Format("Competency.CategoryProgress", Culture["Competency.Cat.RIASEC"], riasecDone, riasecQuestions.Count)</p>
                @foreach (var question in riasecQuestions)
                {
                    <div class="competency-question">
                        <p class="competency-question__text">@question.Id. @Culture[question.TextKey]</p>
                        <div class="competency-likert" role="radiogroup" aria-label="@Culture[question.TextKey]">
                            @for (var value = 1; value <= 5; value++)
                            {
                                var current = value;
                                var id = $"q{question.Id}-{current}";
                                <label class="competency-likert__opt @(_answers.TryGetValue(question.Id, out var selected) && selected == current ? "is-on" : null)">
                                    <input type="radio"
                                           name="@($"q{question.Id}")"
                                           id="@id"
                                           value="@current"
                                           checked="@(_answers.TryGetValue(question.Id, out var v) && v == current)"
                                           @onchange="() => SetAnswer(question.Id, current)" />
                                    <span>@Culture[$"Competency.Likert.{current}"]</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </fieldset>

            <div class="profile-save-bar">
                <button class="engagement-btn" type="button" disabled="@(_saving || _loadFailed)" @onclick="SaveDraftAsync">
                    @Culture["Competency.SaveDraft"]
                </button>
                <button class="login-submit" type="button" disabled="@(_saving || _loadFailed || AnsweredCount < CompetencyTestCatalog.QuestionCount)" @onclick="CompleteAsync">
                    @Culture["Competency.Complete"]
                </button>
                <a class="engagement-btn" href="/candidate/profile">@Culture["Competency.BackToProfile"]</a>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="state-message profile-save-bar__message">@_message</p>
                }
            </div>
        }
    </article>
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _loadFailed;
    private string? _message;
    private readonly Dictionary<int, int> _answers = [];
    private List<CompetencyQuestionItem> _questions = [];

    private int AnsweredCount => _answers.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Api.GetMyCompetenciesAsync();
            if (state is not null)
            {
                _questions = state.Questions;
                _answers.Clear();
                foreach (var (key, value) in state.Answers)
                {
                    if (int.TryParse(key, out var id))
                    {
                        _answers[id] = value;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<CompetencyQuestionItem> QuestionsFor(string category)
    {
        var list = _questions.Count > 0
            ? _questions.Where(q => q.Category == category).OrderBy(q => q.Id).ToList()
            : CompetencyTestCatalog.Questions
                .Where(q => q.Category == category)
                .Select(q => new CompetencyQuestionItem { Id = q.Id, Category = q.Category, Reverse = q.Reverse, TextKey = q.TextKey })
                .ToList();
        return list;
    }

    private void SetAnswer(int id, int value)
    {
        _answers[id] = value;
        _message = null;
    }

    private Task SaveDraftAsync() => PersistAsync(complete: false);

    private Task CompleteAsync() => PersistAsync(complete: true);

    private async Task PersistAsync(bool complete)
    {
        if (_loadFailed)
        {
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            var saved = await Api.SaveMyCompetenciesAsync(_answers, complete);
            _answers.Clear();
            foreach (var (key, value) in saved.Answers)
            {
                if (int.TryParse(key, out var id))
                {
                    _answers[id] = value;
                }
            }

            _message = complete ? Culture["Competency.SavedComplete"] : Culture["Competency.SavedDraft"];
            if (complete)
            {
                Navigation.NavigateTo("/candidate/profile");
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
