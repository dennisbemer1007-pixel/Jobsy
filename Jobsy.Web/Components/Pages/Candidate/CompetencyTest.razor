@page "/candidate/competencies"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject PersistentComponentState Persist
@implements IAsyncDisposable

<PageTitle>@Culture["Competency.Title"] · Lobsy</PageTitle>

<QuestionnaireShell Title="@Culture["Competency.Title"]"
                    Subtitle="@Subtitle"
                    BackHref="/candidate/profile"
                    PrivacyNote="@Culture["Competency.PrivacyNote"]"
                    PrivacyHref="/privacy"
                    AnsweredCount="@AnsweredCount"
                    TotalCount="@CompetencyTestCatalog.QuestionCount"
                    SaveStatus="@(_autosave?.Status ?? QuestionnaireSaveStatus.Saved)"
                    Loading="_loading"
                    LoadFailed="_loadFailed"
                    ErrorMessage="@_message"
                    ReloadHref="/candidate/competencies"
                    Message="@_banner"
                    Completing="_completing"
                    ScrollToQuestionId="_scrollToId"
                    SmoothScroll="_smoothScroll"
                    OnComplete="CompleteAsync"
                    OnRetrySave="RetrySaveAsync">
    @foreach (var category in CompetencyTestCatalog.QuickScanCategories)
    {
        var questions = QuestionsFor(category);
        <section class="questionnaire-section" aria-labelledby="@($"cat-{category}")">
            <h2 class="questionnaire-section__label" id="@($"cat-{category}")">@Culture[$"Competency.Cat.{category}"]</h2>
            @foreach (var question in questions)
            {
                var answered = _answers.ContainsKey(question.Id);
                <LikertScaleQuestion QuestionId="question.Id"
                                     Text="@($"{question.Id}. {Culture[question.TextKey]}")"
                                     Value="@(answered ? _answers[question.Id] : null)"
                                     IsAnswered="answered"
                                     IsCurrent="_currentId == question.Id"
                                     InputPrefix="q"
                                     ValueChanged="value => OnAnswerAsync(question.Id, value)" />
            }
        </section>
    }
</QuestionnaireShell>

@code {
    private const string PersistKey = "candidateCompetencyTest";
    private bool _loading = true;
    private bool _loadFailed;
    private bool _completing;
    private bool _smoothScroll;
    private bool _restored;
    private string? _message;
    private string? _banner;
    private int? _currentId;
    private int? _scrollToId;
    private readonly Dictionary<int, int> _answers = [];
    private List<CompetencyQuestionItem> _questions = [];
    private QuestionnaireAutosave? _autosave;
    private PersistingComponentStateSubscription _persistSubscription;

    private int AnsweredCount => _answers.Count;

    private string? Subtitle
    {
        get
        {
            if (_currentId is null)
            {
                return null;
            }

            var cat = QuestionsFlat().FirstOrDefault(q => q.Id == _currentId)?.Category;
            if (string.IsNullOrEmpty(cat))
            {
                return null;
            }

            var inCat = QuestionsFor(cat);
            var done = inCat.Count(q => _answers.ContainsKey(q.Id));
            return Culture.Format("Questionnaire.CategoryProgress", Culture[$"Competency.Cat.{cat}"], done, inCat.Count);
        }
    }

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<CandidateCompetencyState>(PersistKey, out var saved) && saved is not null)
        {
            ApplyState(saved);
            _restored = true;
            _loading = false;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, new CandidateCompetencyState
        {
            Questions = _questions,
            Answers = _answers.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value)
        });
        return Task.CompletedTask;
    }

    private void ApplyState(CandidateCompetencyState state)
    {
        _questions = state.Questions ?? [];
        _answers.Clear();
        foreach (var (key, value) in state.Answers ?? [])
        {
            if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
            {
                _answers[id] = value;
            }
        }

        _currentId = FirstUnanswered() ?? QuestionsFlat().FirstOrDefault()?.Id;
        _scrollToId = _currentId;
        _smoothScroll = false;
    }

    protected override async Task OnInitializedAsync()
    {
        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                await Api.SaveMyCompetenciesAsync(answers, complete: false, ct);
            },
            onChanged: () => InvokeAsync(StateHasChanged));

        if (_restored)
        {
            _autosave.ReplaceAll(_answers);
            return;
        }

        try
        {
            var state = await Api.GetMyCompetenciesAsync();
            if (state is not null)
            {
                ApplyState(state);
            }
            else
            {
                _currentId = FirstUnanswered() ?? QuestionsFlat().FirstOrDefault()?.Id;
                _scrollToId = _currentId;
            }

            _autosave.ReplaceAll(_answers);
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<CompetencyQuestionItem> QuestionsFor(string category)
    {
        var list = _questions.Count > 0
            ? _questions.Where(q => q.Category == category).OrderBy(q => q.Id).ToList()
            : CompetencyTestCatalog.Questions
                .Where(q => q.Category == category)
                .Select(q => new CompetencyQuestionItem { Id = q.Id, Category = q.Category, Reverse = q.Reverse, TextKey = q.TextKey })
                .ToList();
        return list;
    }

    private IEnumerable<CompetencyQuestionItem> QuestionsFlat()
        => CompetencyTestCatalog.QuickScanCategories.SelectMany(QuestionsFor);

    private int? FirstUnanswered()
    {
        foreach (var q in QuestionsFlat())
        {
            if (!_answers.ContainsKey(q.Id))
            {
                return q.Id;
            }
        }

        return null;
    }

    private async Task OnAnswerAsync(int id, int value)
    {
        _answers[id] = value;
        _banner = null;
        _currentId = NextUnansweredAfter(id) ?? id;
        _scrollToId = _currentId;
        _smoothScroll = true;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private int? NextUnansweredAfter(int answeredId)
    {
        var list = QuestionsFlat().ToList();
        var index = list.FindIndex(q => q.Id == answeredId);
        for (var i = index + 1; i < list.Count; i++)
        {
            if (!_answers.ContainsKey(list[i].Id))
            {
                return list[i].Id;
            }
        }

        return FirstUnanswered();
    }

    private async Task RetrySaveAsync()
    {
        if (_autosave is null)
        {
            return;
        }

        try
        {
            await _autosave.RetryAsync();
            _banner = null;
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private async Task CompleteAsync()
    {
        if (_loadFailed || AnsweredCount < CompetencyTestCatalog.QuestionCount)
        {
            return;
        }

        _completing = true;
        _banner = null;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            await Api.SaveMyCompetenciesAsync(_answers, complete: true);
            Navigation.NavigateTo("/candidate/profile");
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
        finally
        {
            _completing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _persistSubscription.Dispose();
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }
}
