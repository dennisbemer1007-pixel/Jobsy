@page "/candidate/competencies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Components.Shared.Questionnaire
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@Culture["Competency.Title"] · Lobsy</PageTitle>

<div class="test-page journey-page">
    <h1 tabindex="-1">@Culture["Competency.Title"]</h1>
    <p class="test-page__save" aria-live="polite">@_liveSave</p>
    @if (_loading)
    {
        <div class="test-skeleton" aria-busy="true">
            <span class="skeleton-line skeleton-line--title"></span>
            <span class="skeleton-line skeleton-line--row"></span>
        </div>
    }
    else if (_loadFailed)
    {
        <p>@Culture["Common.Error"]</p>
        <a href="/candidate/competencies">@Culture["Common.Retry"]</a>
    }
    else
    {
        <TestConsentGate GateChanged="OnGateChanged">
            @if (_gateOpen && _autosave is not null)
            {
                <TestQuestionFlow Kind="AssessmentKind.Competence"
                                  Questions="_flowQuestions"
                                  Answers="_autosave.Answers"
                                  Target="TestDepthLevel.Full"
                                  Autosave="_autosave"
                                  OnFinished="CompleteAsync"
                                  OnLater="LaterAsync"
                                  OnChanged="OnFlowChanged" />
            }
        </TestConsentGate>
    }
    @if (!string.IsNullOrEmpty(_banner))
    {
        <p class="form-error" role="alert">@_banner</p>
        <button type="button" class="engagement-btn" @onclick="RetrySaveAsync">@Culture["TestErr.Retry"]</button>
    }
</div>

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private bool _gateOpen;
    private string? _banner;
    private string? _liveSave;
    private QuestionnaireSaveStatus _lastAnnounced = QuestionnaireSaveStatus.Idle;
    private QuestionnaireAutosave? _autosave;
    private List<TestQuestionFlow.FlowQuestion> _flowQuestions = [];

    protected override async Task OnInitializedAsync()
    {
        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                try
                {
                    await Api.SaveMyCompetenciesAsync(answers, complete: false, ct);
                }
                catch (TestSaveClientException)
                {
                    throw;
                }
            },
            onChanged: OnAutosaveChanged,
            onFailed: err => InvokeAsync(() =>
            {
                _banner = MapSaveCode((err.Exception as TestSaveClientException)?.Code) ?? Culture["TestErr.SaveBanner"];
                AnnounceSave(QuestionnaireSaveStatus.Failed);
                return Task.CompletedTask;
            }));

        try
        {
            var state = await Api.GetMyCompetenciesAsync();
            var answers = new Dictionary<int, int>();
            if (state?.Answers is not null)
            {
                foreach (var (key, value) in state.Answers)
                {
                    if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
                    {
                        answers[id] = value;
                    }
                }
            }

            _flowQuestions = TestDepthRules.QuestionIdsFor(AssessmentKind.Competence, TestDepthLevel.Full)
                .Select(id =>
                {
                    var q = CompetencyTestCatalog.Questions.First(x => x.Id == id);
                    return new TestQuestionFlow.FlowQuestion(id, Culture[q.TextKey]);
                })
                .ToList();
            _autosave.ReplaceAll(answers);
        }
        catch
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnGateChanged(bool open)
    {
        _gateOpen = open;
        return Task.CompletedTask;
    }

    private Task OnAutosaveChanged()
    {
        AnnounceSave(_autosave?.Status ?? QuestionnaireSaveStatus.Idle);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnFlowChanged() => InvokeAsync(StateHasChanged);

    private void AnnounceSave(QuestionnaireSaveStatus status)
    {
        if (status == QuestionnaireSaveStatus.Saved && _lastAnnounced == QuestionnaireSaveStatus.Failed)
        {
            _liveSave = Culture["TestFlow.Saved"];
        }
        else if (status == QuestionnaireSaveStatus.Failed)
        {
            _liveSave = Culture["TestFlow.SaveFailed"];
        }
        else if (status == QuestionnaireSaveStatus.Saved)
        {
            _liveSave = Culture["TestFlow.Saved"];
        }

        _lastAnnounced = status;
    }

    private async Task RetrySaveAsync()
    {
        if (_autosave is null) return;
        _banner = null;
        await _autosave.RetryAsync();
    }

    private async Task LaterAsync()
    {
        if (_autosave is not null) await _autosave.FlushAsync();
        Navigation.NavigateTo("/profiel/tests/competence");
    }

    private async Task CompleteAsync()
    {
        _banner = null;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
                await Api.SaveMyCompetenciesAsync(_autosave.Answers, complete: true);
            }

            Navigation.NavigateTo("/profiel/tests/competence");
        }
        catch (TestSaveClientException ex)
        {
            _banner = MapSaveCode(ex.Code) ?? Culture["Common.Error"];
        }
        catch
        {
            _banner = Culture["Common.Error"];
        }
    }

    private string? MapSaveCode(string? code) => code switch
    {
        "unknown_question" => Culture["TestErr.unknown_question"],
        "invalid_answer" => Culture["TestErr.invalid_answer"],
        "consent_required" => Culture["TestErr.consent_required"],
        "parental_consent_required" => Culture["TestErr.parental_consent_required"],
        "assessment_adjustment_limit" => Culture["TestErr.Limit"],
        _ => null
    };

    public async ValueTask DisposeAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }
}
