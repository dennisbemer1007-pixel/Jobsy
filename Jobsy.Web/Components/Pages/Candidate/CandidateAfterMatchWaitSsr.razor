@page "/candidate/applications/{ApplicationId:guid}/after-match/wait-ssr"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["AfterMatch.Candidate.ProposalPending.Title"] · Lobsy</PageTitle>
<PageSeo Title="@Culture["AfterMatch.Candidate.ProposalPending.Title"]" />
<HeadContent>
<link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/sollicitaties-page.css")" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/na-de-match.css")" />
</HeadContent>

@if (_loading)
{
    <PageContentSkeleton Variant="apps" CardCount="2" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (_redirecting)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    [Parameter] public Guid ApplicationId { get; set; }

    private bool _loading = true;
    private bool _redirecting;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Apps.Sollicitation.Gone"];
                return;
            }

            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("return", out var returnValues);
            var returnUrl = returnValues.FirstOrDefault();

            var thread = await Api.GetAfterMatchForCandidateAsync(ApplicationId, http.RequestAborted);
            var dispatch = AfterMatchPanelRouting.DispatchSuffixForThread(thread);
            if (dispatch is not null && dispatch != AfterMatchPanelRouting.WaitSsrSuffix)
            {
                _redirecting = true;
                var target = $"/candidate/applications/{ApplicationId:D}/after-match{dispatch}";
                if (http.Request.QueryString.HasValue)
                {
                    target += http.Request.QueryString.Value;
                }

                http.Response.Redirect(target);
                return;
            }

            var data = await AfterMatchCandidateWaitSsrData.LoadAsync(
                Api,
                Culture,
                ApplicationId,
                returnUrl);

            if (data is null)
            {
                _fatalMessage = Culture["Apps.Sollicitation.Gone"];
                return;
            }

            _bodyHtml = AfterMatchCandidateWaitSsrShells.BuildBody(Culture, data, ApplicationId);
        }
        catch
        {
            _fatalMessage = Culture["Apps.Sollicitation.Gone"];
        }
        finally
        {
            _loading = false;
        }
    }
}
