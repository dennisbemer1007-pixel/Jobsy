@page "/carriere"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Features
@using Jobsy.Web.Components.Candidate
@using Jobsy.Web.Components.Candidate.Career
@using Jobsy.Web.Components.Candidate.Journey
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Services.Careers
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags

<PageTitle>@Culture["Career.Title"] · Lobsy</PageTitle>

<div class="journey-page career-page">
    <p class="career-live visually-hidden" role="status" aria-live="polite">@_announcement</p>

    @if (_bootstrapping)
    {
        <CareerStage Variant="ClimbVariant.Stones"
                     DesktopStones="@SceneStones"
                     CurrentIndex="0">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <section class="career-card career-card--skeleton" aria-busy="true" aria-live="polite">
                    <p class="visually-hidden">@Culture["Career.Loading"]</p>
                    <span class="career-skeleton career-skeleton--title"></span>
                    <span class="career-skeleton"></span>
                    <span class="career-skeleton"></span>
                </section>
            </ChildContent>
        </CareerStage>
    }
    else if (!_plan.HasPlan)
    {
        <CareerStage Variant="ClimbVariant.Listen"
                     DesktopStones="@SceneStones"
                     CurrentIndex="0"
                     PlatesShed="2"
                     LobsterSizeDesktop="124"
                     LobsterSizeMobile="66"
                     BubbleDesktop="@Culture["Career.Say.Empty"]"
                     BubbleMobile="@Culture["Career.Say.EmptyShort"]">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerEmptyCard Suggestions="@_suggestions"
                                 Busy="@_busy"
                                 HasChoice="@(_choice is not null)"
                                 ErrorText="@_error"
                                 DiscoveryHref="@DiscoveryHref"
                                 OnChoice="SetChoice"
                                 OnSearch="SearchDreamsAsync"
                                 OnSubmit="GeneratePlanAsync" />
            </ChildContent>
        </CareerStage>
    }
    else
    {
        <CareerStage Variant="ClimbVariant.Climb"
                     DesktopStones="@SceneStones"
                     CurrentIndex="@_plan.CurrentStoneIndex"
                     Celebrate="@_plan.GoalReached"
                     PlatesShed="@_plan.PlatesShed"
                     LobsterSizeDesktop="@_plan.LobsterSizeDesktop"
                     LobsterSizeMobile="@_plan.LobsterSizeMobile"
                     BubbleDesktop="@BubbleDesktop"
                     BubbleMobile="@BubbleMobile">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerOverviewCard Plan="@_plan"
                                    Busy="@_busy"
                                    EmployersOn="@_employersOn"
                                    PassportOn="@_passportOn"
                                    ShowCarriedOver="@_showCarriedOver"
                                    ErrorText="@_error"
                                    OnChangeDream="OpenDreamDialog"
                                    OnDismissCarriedOver="DismissCarriedOver"
                                    OnRegenerateLanguage="RegenerateForLanguageAsync" />

                <div class="career-stepper-row career-only-mobile">
                    <GrowingShellsStepper Stones="@_plan.Stones" Mobile="true" />
                </div>

                <CareerArchivedPlans Plans="@_archived" Busy="@_busy" OnRestore="RestoreAsync" />

                <div class="career-mobile-bar career-only-mobile">
                    <button type="button"
                            class="career-btn career-btn--icon"
                            aria-label="@Culture["Career.EditDream"]"
                            disabled="@_busy"
                            @onclick="OpenDreamDialog">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                        </svg>
                    </button>
                </div>
            </ChildContent>
        </CareerStage>

        <CareerDreamDialog IsOpen="@_dialogOpen"
                           Busy="@_busy"
                           HasChoice="@(_choice is not null)"
                           CurrentDream="@_plan.DreamTitle"
                           ProofCourseCount="@_plan.ProofCourseCount"
                           ProofHasExperience="@_plan.ProofHasExperience"
                           ErrorText="@_dialogError"
                           Suggestions="@DialogSuggestions"
                           OnChoice="SetChoice"
                           OnSearch="SearchDreamsAsync"
                           OnConfirm="ChangeDreamAsync"
                           OnCancel="CloseDreamDialog" />
    }
</div>

@code {
    private CareerPlanViewModel _plan = CareerPlanViewModel.Empty;
    private IReadOnlyList<CareerDreamOptionApiItem> _suggestions = [];
    private IReadOnlyList<ArchivedCareerPlanApiModel> _archived = [];
    private CareerDreamChoice? _choice;
    private string _nowLabel = "";
    private string? _error;
    private string? _dialogError;
    private string _announcement = "";
    private bool _bootstrapping = true;
    private bool _busy;
    private bool _dialogOpen;
    private bool _showCarriedOver;
    private bool _employersOn = true;
    private bool _passportOn;

    private string DiscoveryHref => _passportOn ? "/candidate/ontdekkingsreis" : "/candidate/profile";

    private IReadOnlyList<ClimbStone> SceneStones
    {
        get
        {
            if (!_plan.HasPlan)
            {
                return
                [
                    new ClimbStone(Culture["Career.Rail.Now"], ClimbStoneState.Now),
                    new ClimbStone("", ClimbStoneState.Todo),
                    new ClimbStone("", ClimbStoneState.Todo),
                    new ClimbStone("", ClimbStoneState.Dream)
                ];
            }

            return _plan.Stones
                .Select(s => new ClimbStone(
                    string.IsNullOrWhiteSpace(s.Label) && s.StateTextKey == "Career.Rail.Now"
                        ? Culture["Career.Rail.NowUnknown"]
                        : s.Label,
                    s.State,
                    s.StateTextKey is null ? s.Number?.ToString() : Culture[s.StateTextKey]))
                .ToList();
        }
    }

    private IReadOnlyList<CareerDreamOptionApiItem> DialogSuggestions
        => _suggestions
            .Where(s => !string.Equals(s.Title, _plan.DreamTitle, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private string BubbleDesktop => _plan.GoalReached
        ? Culture["Career.Say.Goal"]
        : Culture.Format("Career.Say.Climb", Math.Max(1, _plan.CurrentStepNumber));

    private string BubbleMobile => _plan.GoalReached
        ? Culture["Career.Say.Goal"]
        : Culture.Format("Career.Say.ClimbShort", Math.Max(1, _plan.CurrentStepNumber));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var flags = await FeatureFlags.GetAsync();
            _employersOn = flags.EmployersEnabled;
            _passportOn = flags.CandidatePassportEnabled;
        }
        catch (Exception)
        {
            _employersOn = true;
        }

        try
        {
            var plan = await Api.GetCareerPathAsync();
            ApplyPlan(plan);
            var options = await Api.GetCareerDreamOptionsAsync();
            _suggestions = options?.Suggestions ?? [];
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _bootstrapping = false;
        }
    }

    private void SetChoice(CareerDreamChoice? choice) => _choice = choice;

    private async Task<IReadOnlyList<CareerDreamOptionApiItem>> SearchDreamsAsync(string term, CancellationToken ct)
    {
        try
        {
            var options = await Api.GetCareerDreamOptionsAsync(term, ct);
            return options?.Results ?? [];
        }
        catch (Exception)
        {
            return [];
        }
    }

    private void OpenDreamDialog()
    {
        _choice = null;
        _dialogError = null;
        _dialogOpen = true;
    }

    /// <summary>Closing, Esc or an error keeps the current plan (no auto-yes, B2/D3).</summary>
    private void CloseDreamDialog()
    {
        if (_busy)
        {
            return;
        }

        _dialogOpen = false;
        _dialogError = null;
        _choice = null;
    }

    private void DismissCarriedOver() => _showCarriedOver = false;

    private async Task GeneratePlanAsync()
    {
        if (_busy || _choice is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        var choice = _choice;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                choice.CatalogKey,
                choice.FreeText,
                force: false,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _choice = null;
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeDreamAsync()
    {
        if (_busy || _choice is null)
        {
            return;
        }

        _busy = true;
        _dialogError = null;
        var choice = _choice;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                choice.CatalogKey,
                choice.FreeText,
                force: true,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _dialogError = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _showCarriedOver = plan.CarriedOverCount > 0;
            _announcement = Culture["CareerDream.Ready"];
            _dialogOpen = false;
            _choice = null;
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _dialogError = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateForLanguageAsync()
    {
        if (_busy || !_plan.HasPlan)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                catalogKey: null,
                freeText: _plan.DreamTitle,
                force: true,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync(Guid planId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.RestoreArchivedCareerPlanAsync(planId);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _announcement = Culture["CareerDream.Ready"];
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyPlan(CareerPathPlanApiModel? plan)
        => _plan = CareerPlanViewBuilder.BuildPage(plan, Culture.Language, _nowLabel);

    private string FailureMessage(Exception ex)
        => ex is CareerApiError api
            ? CareerPathService.ErrorMessage(key => Culture[key], api)
            : Culture["Common.Error"];
}
