@page "/carriere"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Careers
@using Jobsy.Core.Features
@using Jobsy.Web.Components.Candidate
@using Jobsy.Web.Components.Candidate.Career
@using Jobsy.Web.Components.Candidate.Journey
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Services.Careers
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject ICareerStepVacancyFit VacancyFit
@inject NavigationManager Navigation

<PageTitle>@Culture["Career.Title"] · Lobsy</PageTitle>

<div class="journey-page career-page">
    <p class="career-live visually-hidden" role="status" aria-live="polite">@_announcement</p>

    @if (_bootstrapping)
    {
        <CareerStage Variant="ClimbVariant.Stones"
                     DesktopStones="@SceneStones"
                     CurrentIndex="0">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <section class="career-card career-card--skeleton" aria-busy="true" aria-live="polite">
                    <p class="visually-hidden">@Culture["Career.Loading"]</p>
                    <span class="career-skeleton career-skeleton--title"></span>
                    <span class="career-skeleton"></span>
                    <span class="career-skeleton"></span>
                </section>
            </ChildContent>
        </CareerStage>
    }
    else if (!_plan.HasPlan)
    {
        <CareerStage Variant="ClimbVariant.Listen"
                     DesktopStones="@SceneStones"
                     CurrentIndex="0"
                     PlatesShed="2"
                     LobsterSizeDesktop="124"
                     LobsterSizeMobile="66"
                     BubbleDesktop="@(_suggestions.Count > 0 ? Culture["Career.Say.Empty"] : Culture["Career.Say.EmptyShort"])"
                     BubbleMobile="@Culture["Career.Say.EmptyShort"]">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerEmptyCard Suggestions="@_suggestions"
                                 Scores="@_careerScores"
                                 Education="@_educationLabel"
                                 Busy="@_busy"
                                 HasChoice="@(_choice is not null)"
                                 ErrorText="@_error"
                                 DiscoveryHref="@DiscoveryHref"
                                 ShowDiscoveryHint="@(!_journeyComplete)"
                                 OnChoice="SetChoice"
                                 OnSearch="SearchDreamsAsync"
                                 OnSubmit="GeneratePlanAsync" />
            </ChildContent>
        </CareerStage>
    }
    else if (_done is { } done)
    {
        <CareerStage Variant="ClimbVariant.Climb"
                     DesktopStones="@SceneStones"
                     CurrentIndex="@_plan.CurrentStoneIndex"
                     Celebrate="true"
                     PlatesShed="@_plan.PlatesShed"
                     FallingPlate="@FallingPlateIndex"
                     LobsterLabel="@Culture["Career.Lobster.Celebrate"]"
                     LobsterSizeDesktop="170"
                     LobsterSizeMobile="86"
                     BubbleDesktop="@Culture["Career.Say.NewShell"]"
                     BubbleMobile="@Culture["Career.Say.NewShellShort"]">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerStepDoneCard StepNumber="@done.Order"
                                    TotalSteps="@done.TotalSteps"
                                    StepTitle="@done.Title"
                                    ShortTitle="@done.ShortTitle"
                                    Busy="@_busy"
                                    PassportOn="@_passportOn"
                                    ErrorText="@_error"
                                    ProofName="@_doneGained.ProofName"
                                    GrownClaws="@_doneGained.GrownClaws"
                                    VacancyCount="@DoneVacancyCount"
                                    Stones="@_plan.Stones"
                                    NextTitle="@done.NextStep?.Title"
                                    NextNumber="@(done.NextStep?.Order ?? 0)"
                                    NextGapCount="@(done.NextStep?.GapCount ?? 0)"
                                    NextCourseCount="@(done.NextStep?.CourseCount ?? 0)"
                                    OnUndo="UndoStepAsync"
                                    OnNext="GoToNextStepAsync" />
            </ChildContent>
        </CareerStage>
    }
    else if (_step is { } step)
    {
        <CareerStage Variant="ClimbVariant.Climb"
                     DesktopStones="@SceneStones"
                     CurrentIndex="@_plan.CurrentStoneIndex"
                     PlatesShed="@_plan.PlatesShed"
                     LobsterSizeDesktop="@_plan.LobsterSizeDesktop"
                     LobsterSizeMobile="@_plan.LobsterSizeMobile"
                     BubbleDesktop="@BubbleDesktop"
                     BubbleMobile="@BubbleMobile">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerStepDetailCard Step="@step"
                                      Busy="@_busy"
                                      EmployersOn="@_employersOn"
                                      PassportOn="@_passportOn"
                                      ErrorText="@_error"
                                      CourseSlots="@_courseSlots"
                                      VacancyFit="@_stepFit"
                                      OnComplete="CompleteStepAsync"
                                      OnUndo="UndoStepAsync" />
            </ChildContent>
        </CareerStage>
    }
    else
    {
        <CareerStage Variant="ClimbVariant.Climb"
                     DesktopStones="@SceneStones"
                     CurrentIndex="@_plan.CurrentStoneIndex"
                     Celebrate="@_plan.GoalReached"
                     PlatesShed="@_plan.PlatesShed"
                     LobsterSizeDesktop="@_plan.LobsterSizeDesktop"
                     LobsterSizeMobile="@_plan.LobsterSizeMobile"
                     BubbleDesktop="@BubbleDesktop"
                     BubbleMobile="@BubbleMobile">
            <RailContent>
                <CareerRail Plan="@_plan" NowLabel="@_nowLabel" />
            </RailContent>
            <ChildContent>
                <CareerOverviewCard Plan="@_plan"
                                    Busy="@_busy"
                                    EmployersOn="@_employersOn"
                                    PassportOn="@_passportOn"
                                    ShowCarriedOver="@_showCarriedOver"
                                    ErrorText="@_error"
                                    OnChangeDream="OpenDreamDialog"
                                    OnClearDream="ClearDreamAsync"
                                    OnDismissCarriedOver="DismissCarriedOver"
                                    OnRegenerateLanguage="RegenerateForLanguageAsync" />

                <CareerArchivedPlans Plans="@_archived" Busy="@_busy" OnRestore="RestoreAsync" />
            </ChildContent>
        </CareerStage>

        <CareerDreamDialog IsOpen="@_dialogOpen"
                           Busy="@_busy"
                           HasChoice="@(_choice is not null)"
                           CurrentDream="@_plan.DreamTitle"
                           ProofCourseCount="@_plan.ProofCourseCount"
                           ProofHasExperience="@_plan.ProofHasExperience"
                           ErrorText="@_dialogError"
                           Suggestions="@DialogSuggestions"
                           Scores="@_careerScores"
                           Education="@_educationLabel"
                           OnChoice="SetChoice"
                           OnSearch="SearchDreamsAsync"
                           OnConfirm="ChangeDreamAsync"
                           OnCancel="CloseDreamDialog" />
    }
</div>

@code {
    /// <summary>Deep-linkable step detail: <c>/carriere?stap={order}</c> (03 §1). Invalid ⇒ overview.</summary>
    [SupplyParameterFromQuery(Name = "stap")] public int? Stap { get; set; }

    private CareerPathPlanApiModel? _planApi;
    private CareerStepDetailView? _step;
    private CareerStepDetailView? _done;
    private CareerStepDoneView _doneGained = new();
    private CareerStepVacancyFit _stepFit = CareerStepVacancyFit.None;
    private List<PassportCourseCard> _courseSlots = [];
    private string _stepContextId = "";
    private CareerPlanViewModel _plan = CareerPlanViewModel.Empty;
    private IReadOnlyList<CareerDreamOptionApiItem> _suggestions = [];
    private RiasecScores? _careerScores;
    private string? _educationLabel;
    private IReadOnlyList<ArchivedCareerPlanApiModel> _archived = [];
    private CareerDreamChoice? _choice;
    private string _nowLabel = "";
    private string _evidence = "";
    private int _experienceYears;
    private bool _journeyComplete;
    private string? _error;
    private string? _dialogError;
    private string _announcement = "";
    private bool _bootstrapping = true;
    private bool _planLoadStarted;
    private bool _busy;
    private bool _dialogOpen;
    private bool _showCarriedOver;
    private bool _employersOn = true;
    private bool _passportOn;

    private string DiscoveryHref => _passportOn ? "/candidate/ontdekkingsreis" : "/candidate/profile";

    private IReadOnlyList<ClimbStone> SceneStones
    {
        get
        {
            if (!_plan.HasPlan)
            {
                return
                [
                    new ClimbStone(Culture["Career.Rail.Now"], ClimbStoneState.Now, ShortMark: Culture["Career.Mark.Now"]),
                    new ClimbStone("", ClimbStoneState.Todo, ShortMark: "1"),
                    new ClimbStone("", ClimbStoneState.Todo, ShortMark: "2"),
                    new ClimbStone("", ClimbStoneState.Dream)
                ];
            }

            return _plan.Stones
                .Select(s => new ClimbStone(
                    string.IsNullOrWhiteSpace(s.Label) && s.StateTextKey == "Career.Rail.Now"
                        ? Culture["Career.Rail.NowUnknown"]
                        : s.Label,
                    s.State,
                    s.StateTextKey is null ? s.Number?.ToString() : Culture[s.StateTextKey],
                    ShortMark: s.State == ClimbStoneState.Dream
                        ? null
                        : s.Number?.ToString() ?? Culture["Career.Mark.Now"]))
                .ToList();
        }
    }

    private IReadOnlyList<CareerDreamOptionApiItem> DialogSuggestions
        => _suggestions
            .Where(s => !string.Equals(s.Title, _plan.DreamTitle, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private string BubbleDesktop => _plan.GoalReached
        ? Culture["Career.Say.Goal"]
        : Culture.Format("Career.Say.Climb", Math.Max(1, _plan.CurrentStepNumber));

    private string BubbleMobile => _plan.GoalReached
        ? Culture["Career.Say.Goal"]
        : Culture.Format("Career.Say.ClimbShort", Math.Max(1, _plan.CurrentStepNumber));

    /// <summary>One plate falls once during the moment (§S); the newest shed plate.</summary>
    private int FallingPlateIndex => Math.Clamp(_plan.PlatesShed - 1, 0, 9);

    private int DoneVacancyCount => _employersOn && _stepFit.ShowsCount ? _stepFit.GoodCount : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Prerender paints the skeleton. Load only after the interactive circuit
        // so the first HTML is not blank while the API responds.
        if (!firstRender || _planLoadStarted || !RendererInfo.IsInteractive)
        {
            return;
        }

        _planLoadStarted = true;
        try
        {
            var flags = await FeatureFlags.GetAsync();
            _employersOn = flags.EmployersEnabled;
            _passportOn = flags.CandidatePassportEnabled;
        }
        catch (Exception)
        {
            _employersOn = true;
        }

        try
        {
            var planTask = Api.GetCareerPathAsync();
            var profileTask = Api.GetMyProfileAsync();
            var onboardingTask = Api.GetMyOnboardingAsync();
            await Task.WhenAll(planTask, profileTask, onboardingTask);
            ApplyProfileEvidence(await profileTask);
            _journeyComplete = (await onboardingTask)?.IsComplete == true;
            var plan = await planTask;
            ApplyPlan(plan);
            var options = await Api.GetCareerDreamOptionsAsync();
            _suggestions = options?.Suggestions ?? [];
            _archived = await Api.GetArchivedCareerPlansAsync();
            try
            {
                ApplyCareerScores(await Api.GetMyCareerInterestsAsync());
            }
            catch (Exception)
            {
                _careerScores = null;
            }
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _bootstrapping = false;
        }

        await SyncStepAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_bootstrapping)
        {
            return;
        }

        await SyncStepAsync();
    }

    /// <summary>Resolves <c>?stap=</c> to a step; an unknown or foreign order falls back to the overview.</summary>
    private async Task SyncStepAsync()
    {
        if (_done is not null)
        {
            if (Stap == _done.Order)
            {
                return;
            }

            _done = null;
            _doneGained = new CareerStepDoneView();
        }

        if (Stap is not int order || !_plan.HasPlan)
        {
            ClearStep();
            return;
        }

        var next = CareerPlanViewBuilder.BuildStep(_planApi, order, _evidence, _experienceYears);
        if (next is null)
        {
            ClearStep();
            return;
        }

        _step = next;
        if (!string.Equals(_stepContextId, next.Id, StringComparison.Ordinal))
        {
            _stepContextId = next.Id;
            await LoadStepContextAsync(next);
        }
    }

    private void ClearStep()
    {
        _step = null;
        _stepContextId = "";
        _courseSlots = [];
        _stepFit = CareerStepVacancyFit.None;
    }

    /// <summary>Courses (D5) and vacancy fit (Dependency E). Read-only: nothing is seeded here.</summary>
    private async Task LoadStepContextAsync(CareerStepDetailView step)
    {
        _courseSlots = [];
        _stepFit = CareerStepVacancyFit.None;

        if (step.CourseSearchKeys.Count > 0)
        {
            try
            {
                _courseSlots = await Api.GetPassportTrainingOffersAsync(
                    string.Join(' ', step.CourseSearchKeys));
            }
            catch (Exception)
            {
                _courseSlots = [];
            }
        }

        if (_employersOn)
        {
            _stepFit = await VacancyFit.GetAsync([step.ShortTitle, step.Title]);
        }
    }

    private async Task CompleteStepAsync()
    {
        if (_busy || _step is not { Status: CareerStepStatus.Active } step)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.CompleteCareerStepAsync(step.Id);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            _doneGained = CareerPlanViewBuilder.BuildDone(step, plan, step.Order);
            ApplyPlan(plan);
            _done = step;
            _step = null;
            _announcement = Culture.Format("Career.Done.Announce", step.Order);
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UndoStepAsync()
    {
        var target = _done ?? _step;
        if (_busy || target is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.UncompleteCareerStepAsync(target.Id);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _done = null;
            _doneGained = new CareerStepDoneView();
            _step = CareerPlanViewBuilder.BuildStep(_planApi, target.Order, _evidence, _experienceYears);
            _announcement = Culture.Format("Career.Undo.Announce", target.Order);
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task GoToNextStepAsync()
    {
        var next = _done?.NextStep;
        if (next is null)
        {
            Navigation.NavigateTo("/carriere");
            return Task.CompletedTask;
        }

        Navigation.NavigateTo($"/carriere?stap={next.Order}");
        return Task.CompletedTask;
    }

    private void SetChoice(CareerDreamChoice? choice) => _choice = choice;

    private async Task<IReadOnlyList<CareerDreamOptionApiItem>> SearchDreamsAsync(string term, CancellationToken ct)
    {
        try
        {
            var options = await Api.GetCareerDreamOptionsAsync(term, ct);
            return options?.Results ?? [];
        }
        catch (Exception)
        {
            return [];
        }
    }

    private void OpenDreamDialog()
    {
        _choice = null;
        _dialogError = null;
        _dialogOpen = true;
    }

    /// <summary>Closing, Esc or an error keeps the current plan (no auto-yes, B2/D3).</summary>
    private void CloseDreamDialog()
    {
        if (_busy)
        {
            return;
        }

        _dialogOpen = false;
        _dialogError = null;
        _choice = null;
    }

    private void DismissCarriedOver() => _showCarriedOver = false;

    private async Task GeneratePlanAsync()
    {
        if (_busy || _choice is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        var choice = _choice;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                choice.CatalogKey,
                choice.FreeText,
                force: false,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _choice = null;
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearDreamAsync()
    {
        if (_busy || !_plan.HasPlan && string.IsNullOrWhiteSpace(_plan.DreamTitle))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Api.ClearCareerDreamAsync();
            _plan = CareerPlanViewModel.Empty;
            _archived = [];
            _choice = null;
            _dialogOpen = false;
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeDreamAsync()
    {
        if (_busy || _choice is null)
        {
            return;
        }

        _busy = true;
        _dialogError = null;
        var choice = _choice;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                choice.CatalogKey,
                choice.FreeText,
                force: true,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _dialogError = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _showCarriedOver = plan.CarriedOverCount > 0;
            _announcement = Culture["CareerDream.Ready"];
            _dialogOpen = false;
            _choice = null;
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _dialogError = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateForLanguageAsync()
    {
        if (_busy || !_plan.HasPlan)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(
                catalogKey: null,
                freeText: _plan.DreamTitle,
                force: true,
                planLanguage: Culture.Language);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync(Guid planId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var plan = await Api.RestoreArchivedCareerPlanAsync(planId);
            if (plan is null)
            {
                _error = Culture["Common.Error"];
                return;
            }

            ApplyPlan(plan);
            _announcement = Culture["CareerDream.Ready"];
            _archived = await Api.GetArchivedCareerPlansAsync();
        }
        catch (Exception ex)
        {
            _error = FailureMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyProfileEvidence(MeProfile? profile)
    {
        var prefs = profile?.Preferences;
        if (prefs is null)
        {
            return;
        }

        var current = prefs.Employers.FirstOrDefault(e => string.IsNullOrWhiteSpace(e.EndMonth))
                      ?? prefs.Employers.FirstOrDefault();
        _nowLabel = current?.Role?.Trim() ?? "";
        _evidence = CareerPlanViewBuilder.EvidenceFrom(prefs);
        _experienceYears = CareerPlanViewBuilder.ExperienceYears(prefs.Employers);
        _educationLabel = string.Join(
            " ",
            (prefs.Educations ?? []).Append(prefs.EducationDirection ?? "").Where(item => !string.IsNullOrWhiteSpace(item)));
    }

    private void ApplyCareerScores(CandidateCareerInterestState? state)
    {
        var scores = state?.Scores;
        _careerScores = scores is { IsComplete: true }
            ? new RiasecScores(
                scores.Realistic,
                scores.Investigative,
                scores.Artistic,
                scores.Social,
                scores.Enterprising,
                scores.Conventional)
            : null;
    }

    private void ApplyPlan(CareerPathPlanApiModel? plan)
    {
        _planApi = plan;
        _plan = CareerPlanViewBuilder.BuildPage(plan, Culture.Language, _nowLabel, _evidence, _experienceYears);
        if (!_plan.HasPlan && !string.IsNullOrWhiteSpace(_plan.DreamTitle))
        {
            var entry = CareerDreamCatalog.FindByTitleOrAlias(_plan.DreamTitle);
            _choice = new CareerDreamChoice(
                entry?.Key,
                entry is null ? _plan.DreamTitle : null,
                _plan.DreamTitle);
        }
    }

    private string FailureMessage(Exception ex)
        => ex is CareerApiErrorException api
            ? CareerPathService.ErrorMessage(key => Culture[key], api)
            : Culture["Common.Error"];
}
