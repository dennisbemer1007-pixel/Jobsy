@page "/carriere"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@inject CareerPathService CareerPaths
@inject JobsyApiClient Api
@inject CultureState Culture

<PageTitle>@Culture["CareerDash.Title"] · Lobsy</PageTitle>

<div class="panel-page career-dash">
    <header class="panel-header career-dash__page-header">
        <div>
            <h1>@Culture["CareerDash.Title"]</h1>
            <p class="login-lead">@Culture["CareerDash.Lead"]</p>
        </div>
    </header>

    @if (_model is null)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <section class="career-dash__hero" aria-labelledby="career-dash-horizon">
            <div class="career-dash__progress">
                <p class="career-dash__pct" id="career-dash-horizon">
                    <strong>@_model.MatchPercent%</strong>
                    <span>@Culture["CareerDash.Match"]</span>
                </p>
                <div class="career-dash__bar"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@_model.MatchPercent"
                     aria-label="@Culture["CareerDash.ProgressLabel"]">
                    <span class="career-dash__bar-fill" style="width: @_model.MatchPercent%"></span>
                </div>
                <p class="career-dash__summary">@_model.MatchSummary</p>
            </div>

            <div class="career-dash__horizon career-dash__horizon--solo">
                <div class="career-dash__role career-dash__role--dream">
                    <label class="career-dash__label" for="career-dream-input">@Culture["CareerDash.DreamRole"]</label>
                    <input id="career-dream-input"
                           class="career-dash__input"
                           type="text"
                           maxlength="80"
                           autocomplete="off"
                           list="career-dream-suggestions"
                           placeholder="@Culture["CareerDash.DreamPlaceholder"]"
                           value="@_dreamDraft"
                           disabled="@_busy"
                           @oninput="OnDreamInput"
                           @onkeydown="OnDreamKeyDown"
                           @onblur="CommitDreamAsync" />
                    <datalist id="career-dream-suggestions">
                        @foreach (var option in _model.DreamOptions)
                        {
                            <option value="@option.Title"></option>
                        }
                    </datalist>
                </div>
            </div>
            @if (_busy)
            {
                <p class="state-message" aria-live="polite">@Culture["CareerDash.Generating"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(_message))
            {
                <p class="state-message">@_message</p>
            }
        </section>

        <section class="career-dash__plan" aria-labelledby="career-dash-plan-title">
            <div class="career-dash__plan-head">
                <h2 id="career-dash-plan-title" class="career-dash__section-title">@Culture["CareerDash.PlanTitle"]</h2>
                <p class="login-lead career-dash__section-lead">@Culture["CareerDash.PlanLead"]</p>
            </div>

            <div class="career-accordion" role="list">
                @foreach (var step in _model.Steps)
                {
                    var open = string.Equals(_expandedStepId, step.Id, StringComparison.Ordinal);
                    <article class="career-accordion__item @StatusClass(step.Status) @(open ? "is-open" : null)" role="listitem">
                        <h3 class="career-accordion__heading">
                            <button type="button"
                                    class="career-accordion__toggle"
                                    id="@($"career-step-{step.Id}-btn")"
                                    aria-expanded="@open"
                                    aria-controls="@($"career-step-{step.Id}-panel")"
                                    @onclick="() => ToggleStep(step.Id)">
                                <span class="career-accordion__num" aria-hidden="true">@step.Order</span>
                                <span class="career-accordion__title-wrap">
                                    <span class="career-accordion__title">@step.Title</span>
                                    <span class="career-timeline__badge @StatusClass(step.Status)">@Culture[StatusKey(step.Status)]</span>
                                </span>
                                <span class="career-accordion__chevron" aria-hidden="true"></span>
                            </button>
                        </h3>

                        @if (open)
                        {
                            <div class="career-accordion__panel"
                                 id="@($"career-step-{step.Id}-panel")"
                                 role="region"
                                 aria-labelledby="@($"career-step-{step.Id}-btn")">
                                <p class="career-step-panel__summary">@step.Summary</p>

                                <div class="career-step-panel__grid">
                                    <div class="career-timeline__block">
                                        <h4>@Culture["CareerDash.SkillsGap"]</h4>
                                        @if (step.SkillsGap.Count > 0)
                                        {
                                            <ul>
                                                @foreach (var gap in step.SkillsGap)
                                                {
                                                    <li>@gap</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="muted">@Culture["CareerDash.SkillsGapNone"]</p>
                                        }
                                    </div>

                                    <div class="career-timeline__block">
                                        <h4>@Culture["CareerDash.Courses"]</h4>
                                        @if (step.Courses.Count > 0)
                                        {
                                            <ul>
                                                @foreach (var course in step.Courses)
                                                {
                                                    <li>@course</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="muted">@Culture["CareerDash.CoursesNone"]</p>
                                        }
                                    </div>

                                    <div class="career-timeline__block">
                                        <h4>@Culture["CareerDash.MinRequirements"]</h4>
                                        @if (step.MinRequirements.Count > 0)
                                        {
                                            <ul>
                                                @foreach (var req in step.MinRequirements)
                                                {
                                                    <li>@req</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="muted">@Culture["CareerDash.MinRequirementsNone"]</p>
                                        }
                                    </div>

                                    <div class="career-timeline__block">
                                        <h4>@Culture["CareerDash.YearsExperience"]</h4>
                                        <p>@Culture.Format("CareerDash.YearsExperienceValue", step.YearsExperienceNeeded)</p>
                                    </div>
                                </div>

                                <div class="career-timeline__action">
                                    <a class="login-submit" href="@step.ActionHref">@step.ActionLabel</a>
                                    @if (step.StepMatchPercent > 0 && step.StepMatchPercent < 100)
                                    {
                                        <p class="muted">@Culture.Format("CareerDash.StepMatch", step.StepMatchPercent)</p>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private CareerDashboardModel? _model;
    private string? _expandedStepId;
    private string _dreamDraft = CareerPathService.DefaultDreamTitle;
    private bool _busy;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        ApplyDashboard(CareerPaths.GetDashboard());
        await RefreshFromApiAsync(_dreamDraft);
    }

    private void OnDreamInput(ChangeEventArgs e)
        => _dreamDraft = e.Value?.ToString() ?? "";

    private async Task OnDreamKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            await CommitDreamAsync();
        }
    }

    private async Task CommitDreamAsync()
    {
        var next = (_dreamDraft ?? "").Trim();
        if (string.IsNullOrWhiteSpace(next))
        {
            _dreamDraft = _model?.DreamRoleTitle ?? CareerPathService.DefaultDreamTitle;
            return;
        }

        if (_model is not null
            && string.Equals(next, _model.DreamRoleTitle, StringComparison.OrdinalIgnoreCase)
            && !_busy)
        {
            return;
        }

        ApplyDashboard(CareerPaths.GetDashboard(next));
        await RefreshFromApiAsync(next);
    }

    private async Task RefreshFromApiAsync(string dream)
    {
        _busy = true;
        _message = null;
        try
        {
            var plan = await Api.GenerateCareerPathAsync(dream);
            if (plan is not null)
            {
                ApplyDashboard(CareerPaths.FromApi(plan));
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyDashboard(CareerDashboardModel model)
    {
        _model = model;
        _dreamDraft = model.DreamRoleTitle;
        _expandedStepId = model.Steps.FirstOrDefault(s => s.Status == CareerStepStatus.Active)?.Id
                          ?? model.Steps.FirstOrDefault()?.Id;
    }

    private void ToggleStep(string id)
        => _expandedStepId = string.Equals(_expandedStepId, id, StringComparison.Ordinal) ? null : id;

    private static string StatusClass(CareerStepStatus status) => status switch
    {
        CareerStepStatus.Completed => "is-completed",
        CareerStepStatus.Active => "is-active",
        _ => "is-open-step"
    };

    private static string StatusKey(CareerStepStatus status) => status switch
    {
        CareerStepStatus.Completed => "CareerDash.StatusCompleted",
        CareerStepStatus.Active => "CareerDash.StatusActive",
        _ => "CareerDash.StatusOpen"
    };
}
