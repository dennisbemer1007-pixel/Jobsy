@page "/candidate/liked"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Saved
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthState

<PageTitle>@Culture["Kb.Saved.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <PageContentSkeleton Variant="cards" CardCount="4" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    private bool _loading = true;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            var isCandidate = auth.User.Identity?.IsAuthenticated == true
                              && auth.User.IsInRole("Candidate");

            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("filter", out var filterValues);
            query.TryGetValue("sort", out var sortValues);
            query.TryGetValue("error", out var errorValues);
            query.TryGetValue("saved", out var savedValues);
            var error = errorValues.FirstOrDefault();
            var actionSaved = string.Equals(savedValues.FirstOrDefault(), "1", StringComparison.Ordinal);

            var data = await SavedSsrData.LoadAsync(
                Api,
                FeatureFlags,
                Culture,
                isCandidate,
                filterValues.FirstOrDefault(),
                sortValues.FirstOrDefault(),
                string.IsNullOrWhiteSpace(error) ? null : error,
                actionSaved);

            var tokens = Antiforgery.GetAndStoreTokens(http);
            _bodyHtml = SavedSsrShells.BuildBody(Culture, data, tokens.RequestToken ?? "", http);
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
