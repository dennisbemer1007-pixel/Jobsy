@page "/candidate/applications"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate,BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Authorization
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["Nav.MyApplications"] · Lobsy</PageTitle>

<div class="panel-page apps-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Nav.MyApplications"]</h1>
            <p class="login-lead">
                @(_readOnly ? Culture["Apps.LeadReadOnly"] : Culture["Apps.Lead"])
            </p>
        </div>
    </header>

    <div class="admin-sublinks pill-scroller apps-tabs" role="tablist" aria-label="@Culture["Nav.MyApplications"]">
        <button type="button" class="admin-sublink @(_tab == "all" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "all")" @onclick='() => SetTab("all")'>@Culture["Apps.TabAll"]</button>
        <button type="button" class="admin-sublink @(_tab == "open" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "open")" @onclick='() => SetTab("open")'>@Culture["Apps.TabOpen"]</button>
        <button type="button" class="admin-sublink @(_tab == "rejected" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "rejected")" @onclick='() => SetTab("rejected")'>@Culture["Apps.TabRejected"]</button>
        <button type="button" class="admin-sublink @(_tab == "matched" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "matched")" @onclick='() => SetTab("matched")'>@Culture["Apps.TabMatched"]</button>
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_filtered.Count == 0)
    {
        <p class="state-message">
            @if (_items.Count == 0)
            {
                @Culture["Apps.Empty"]
                @if (!_readOnly)
                {
                    <text> <a href="/">@Culture["Apps.BrowseMap"]</a>.</text>
                }
            }
            else
            {
                @Culture["Apps.EmptyTab"]
            }
        </p>
    }
    else
    {
        <div class="application-card-list">
            @foreach (var a in _filtered)
            {
                var steps = ApplicationStatusWizard.StepsFor(a.Status);
                var current = ApplicationStatusWizard.CurrentStepIndex(a.Status);
                var rejectedTrack = ApplicationStatusWizard.IsRejectedTrack(a.Status);
                var statusLabel = string.Format(Culture["Apps.StatusNow"], UiLabels.WizardStep(Culture, a.Status));
                <article class="application-card">
                    <header class="application-card__header">
                        <a class="application-card__link" href="@($"/vacancies/{a.VacancyId}")">
                            <h2 class="application-card__title">@a.VacancyTitle</h2>
                        </a>
                        <p class="application-card__meta">@LocationAndTravel(a)</p>
                        <p class="application-card__company">@a.CompanyName</p>
                        <p class="application-card__date">@AppliedOnLabel(a.CreatedAt)</p>
                    </header>
                    <p class="application-card__status">@statusLabel</p>
                    <ol class="application-stepper" aria-label="@Culture["Apps.StatusTrail"]">
                        @for (var i = 0; i < steps.Length; i++)
                        {
                            var done = i < current;
                            var isCurrent = i == current;
                            var rejected = rejectedTrack && i == current;
                            <li class="application-stepper__step @(done ? "is-done" : null) @(isCurrent ? "is-current" : null) @(rejected ? "is-rejected" : null)"
                                aria-current="@(isCurrent ? "step" : null)">
                                <span class="application-stepper__bar" aria-hidden="true"></span>
                                <span class="visually-hidden">@WizardStepName(steps[i], a.Status)</span>
                            </li>
                        }
                    </ol>
                    <div class="application-card__actions">
                        @if (!_readOnly)
                        {
                            <button type="button"
                                    class="btn-compact btn-compact--primary application-card__btn"
                                    disabled="@(_busyId == a.Id)"
                                    @onclick="() => DownloadCvAsync(a)">
                                @(_busyId == a.Id && _pdfBusy ? "…" : Culture["Apps.DownloadLobsyCv"])
                            </button>
                        }
                        @if (!_readOnly && CanWithdraw(a.Status))
                        {
                            <button type="button"
                                    class="btn-compact application-card__btn"
                                    disabled="@(_busyId == a.Id)"
                                    @onclick="() => WithdrawAsync(a)">
                                @(_busyId == a.Id && !_pdfBusy ? "…" : Culture["Apps.Withdraw"])
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
</div>

@code {
    private List<ApplicationItem> _items = [];
    private List<ApplicationItem> _filtered = [];
    private bool _loading = true;
    private bool _readOnly;
    private string _tab = "all";
    private Guid? _busyId;
    private bool _pdfBusy;
    private string? _message;
    private static readonly System.Globalization.CultureInfo Dutch = new("nl-NL");

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _readOnly = !RoleClaimMatching.HasRole(state.User, JobsyRoles.Candidate);

        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            ApplyTab();
        }
        catch
        {
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            ApplyTab();
        }
        catch
        {
            // keep current list
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private void SetTab(string tab)
    {
        _tab = tab;
        ApplyTab();
    }

    private void ApplyTab()
    {
        _filtered = _tab switch
        {
            "open" => _items.Where(IsOpen).ToList(),
            "rejected" => _items.Where(IsRejected).ToList(),
            "matched" => _items.Where(IsMatched).ToList(),
            _ => _items.ToList()
        };
    }

    private static bool IsOpen(ApplicationItem a)
        => a.Status is "Pending";

    private static bool IsRejected(ApplicationItem a)
        => a.Status is "Rejected" or "FilledElsewhere" or "Withdrawn";

    private static bool IsMatched(ApplicationItem a)
        => a.Status is "Accepted" or "EmployerContacting" or "Hired";

    private static bool CanWithdraw(string status)
        => status == "Pending";

    private string LocationAndTravel(ApplicationItem a)
    {
        var travel = $"{a.EstimatedTravelMinutes} {Culture["Discovery.Minutes"]}";
        var transport = UiLabels.Transport(Culture, a.PreferredTransport);
        var travelLine = string.IsNullOrWhiteSpace(transport) ? travel : $"{transport} · {travel}";
        return string.IsNullOrWhiteSpace(a.LocationLabel)
            ? travelLine
            : $"{a.LocationLabel} · {travelLine}";
    }

    private string WizardStepName(string dutchName, string status) => dutchName switch
    {
        "Gesolliciteerd" => Culture["Apps.Wizard.Applied"],
        "In behandeling" => Culture["Apps.Wizard.InReview"],
        "Contact" => Culture["Apps.Wizard.Contact"],
        "Gematched" => Culture["Apps.Wizard.Matched"],
        "Afgewezen" => UiLabels.ApplicationStatus(Culture, status),
        _ => dutchName
    };

    private string AppliedOnLabel(DateTime createdAt)
    {
        var local = createdAt.ToLocalTime();
        var culture = Culture.Language switch
        {
            "en" => new System.Globalization.CultureInfo("en-GB"),
            "pl" => new System.Globalization.CultureInfo("pl-PL"),
            "ro" => new System.Globalization.CultureInfo("ro-RO"),
            "ar" => new System.Globalization.CultureInfo("ar-SA"),
            _ => Dutch
        };
        var date = local.ToString("d MMM yyyy", culture).Replace(".", "");
        return string.Format(Culture["Apps.AppliedOn"], date);
    }

    private async Task WithdrawAsync(ApplicationItem item)
    {
        if (_readOnly)
        {
            return;
        }

        _busyId = item.Id;
        _pdfBusy = false;
        _message = null;
        try
        {
            await Api.WithdrawApplicationAsync(item.Id);
            item.Status = "Withdrawn";
            ApplyTab();
            _message = Culture["Apps.WithdrawnMsg"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task DownloadCvAsync(ApplicationItem item)
    {
        if (_readOnly)
        {
            return;
        }

        _busyId = item.Id;
        _pdfBusy = true;
        _message = null;
        try
        {
            await Api.DownloadApplicationLobsyCvPdfAsync(item.Id, Js);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
            _pdfBusy = false;
        }
    }
}
