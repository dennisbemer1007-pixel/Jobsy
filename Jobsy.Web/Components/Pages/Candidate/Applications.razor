@page "/candidate/applications"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate,BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using System.Security.Claims
@using Jobsy.Core.Authorization
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject JobsyApiClient Api
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Nav.MyApplications"] · Lobsy</PageTitle>

<div class="panel-page apps-page" @onkeydown="OnPageKeyDown">
    <header class="panel-header">
        <div>
            <h1>@Culture["Nav.MyApplications"]</h1>
            <p class="login-lead apps-page__lead">
                @if (_readOnly)
                {
                    @Culture["Apps.LeadReadOnly"]
                }
                else if (!string.IsNullOrWhiteSpace(_givenName))
                {
                    @string.Format(Culture["Apps.LeadFriendly"], _givenName)
                }
                else
                {
                    @Culture["Apps.LeadFriendlyNoName"]
                }
            </p>
        </div>
    </header>

    <div class="application-counters" role="group" aria-label="@Culture["Nav.MyApplications"]">
        <button type="button"
                class="application-counters__btn @(_filter == "open" ? "is-selected" : null)"
                aria-pressed="@(_filter == "open" ? "true" : "false")"
                aria-label="@($"{_countOpen} {Culture["Apps.TabOpen"]}")"
                @onclick='() => ToggleFilter("open")'>
            <span class="application-counters__n">@_countOpen</span>
            <span class="application-counters__label">@Culture["Apps.TabOpen"]</span>
        </button>
        <button type="button"
                class="application-counters__btn application-counters__btn--running @(_filter == "running" ? "is-selected" : null)"
                aria-pressed="@(_filter == "running" ? "true" : "false")"
                aria-label="@($"{_countRunning} {Culture["Apps.TabRunning"]}")"
                @onclick='() => ToggleFilter("running")'>
            <span class="application-counters__n">@_countRunning</span>
            <span class="application-counters__label">@Culture["Apps.TabRunning"]</span>
        </button>
        <button type="button"
                class="application-counters__btn @(_filter == "rejected" ? "is-selected" : null)"
                aria-pressed="@(_filter == "rejected" ? "true" : "false")"
                aria-label="@($"{_countRejected} {Culture["Apps.TabRejected"]}")"
                @onclick='() => ToggleFilter("rejected")'>
            <span class="application-counters__n">@_countRejected</span>
            <span class="application-counters__label">@Culture["Apps.TabRejected"]</span>
        </button>
    </div>
    @if (!string.IsNullOrEmpty(_filter))
    {
        <button type="button" class="application-counters__show-all" @onclick="ClearFilter">
            @Culture["Apps.TabAll"]
        </button>
    }

    @if (_loading)
    {
        <PageContentSkeleton Variant="apps" CardCount="3" LoadingLabel="@Culture["Common.Loading"]" />
    }
    else if (_filtered.Count == 0)
    {
        <div class="apps-empty">
            <p class="state-message">
                @if (_items.Count == 0)
                {
                    @Culture["Apps.Empty"]
                    @if (!_readOnly)
                    {
                        <text> <a href="/banenkaart">@Culture["Apps.BrowseMap"]</a>.</text>
                    }
                }
                else
                {
                    @Culture["Apps.EmptyTab"]
                }
            </p>
        </div>
    }
    else
    {
        <div class="application-card-list">
            @foreach (var a in _filtered)
            {
                var rejectedTrack = ApplicationStatusWizard.IsRejectedTrack(a.Status);
                var hired = string.Equals(a.Status, "Hired", StringComparison.OrdinalIgnoreCase);
                var current = ApplicationStatusWizard.CurrentStepIndex(a.Status);
                var menuOpen = _openMenuId == a.Id;
                var vacancyHref = $"/vacancies/{a.VacancyId}";
                var pictureKind = a.PictureKind ?? "placeholder";
                var pictureUrl = string.IsNullOrWhiteSpace(a.PictureUrl)
                    ? Jobsy.Core.Media.VacancyImageUrls.Placeholder(Guid.Empty, "flex")
                    : a.PictureUrl;
                <article class="application-card @(hired ? "application-card--hired" : "") @(rejectedTrack ? "application-card--closed" : "") @(menuOpen ? "is-menu-open" : "")">
                    <a class="application-card__img-link"
                       href="@vacancyHref"
                       tabindex="-1"
                       aria-hidden="true">
                        <img class="application-card__img @(pictureKind == "logo" ? "application-card__img--logo" : null)"
                             src="@pictureUrl"
                             alt=""
                             width="84"
                             height="84"
                             loading="lazy"
                             decoding="async" />
                    </a>
                    <div class="application-card__body">
                        <a class="application-card__link" href="@vacancyHref">
                            <h2 class="application-card__title">@a.VacancyTitle</h2>
                        </a>
                        <p class="application-card__company">@a.CompanyName</p>
                        <span class="visually-hidden">@string.Format(Culture["Apps.StatusNow"], StatusPillLabel(a.Status))</span>
                        <div class="application-card__footer">
                            <div class="application-card__status">
                                <span class="application-card__pill application-card__pill--@PillModifier(a.Status)">
                                    <span class="application-card__pill-dot" aria-hidden="true"></span>
                                    @StatusPillLabel(a.Status)
                                </span>
                                <span class="application-card__progress" aria-hidden="true">
                                    @if (rejectedTrack)
                                    {
                                        <span class="application-card__seg"></span>
                                        <span class="application-card__seg"></span>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < 4; i++)
                                        {
                                            <span class="application-card__seg @(i <= current ? "is-done" : null)"></span>
                                        }
                                    }
                                </span>
                            </div>
                            <time class="application-card__date"
                                  datetime="@a.CreatedAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")"
                                  title="@AppliedOnFullLabel(a.CreatedAt)"
                                  aria-label="@AppliedOnFullLabel(a.CreatedAt)">
                                @AppliedOnShortLabel(a.CreatedAt)
                            </time>
                        </div>
                    </div>

                    <div class="application-card__menu">
                        @{
                            var bindToggleRef = menuOpen || _focusMenuButtonId == a.Id;
                            var menuSlot = 0;
                            var vacancySlot = !_readOnly ? 1 : 0;
                            var withdrawSlot = vacancySlot + 1;
                            if (menuOpen)
                            {
                                _menuItemCount = (!_readOnly ? 1 : 0)
                                    + 1
                                    + (!_readOnly && CanWithdraw(a.Status) ? 1 : 0);
                            }
                        }
                        @if (bindToggleRef)
                        {
                            <button type="button"
                                    class="icon-btn application-card__menu-toggle @(menuOpen ? "is-open" : null)"
                                    aria-haspopup="menu"
                                    aria-expanded="@(menuOpen ? "true" : "false")"
                                    data-app-menu-btn="@a.Id"
                                    aria-label="@string.Format(Culture["Apps.ActionsFor"], a.VacancyTitle)"
                                    @ref="_menuToggleRef"
                                    @onclick="() => ToggleMenu(a.Id)"
                                    @onclick:stopPropagation="true">
                                @((MarkupString)ActionIcons.MoreHorizontal)
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="icon-btn application-card__menu-toggle"
                                    aria-haspopup="menu"
                                    aria-expanded="false"
                                    data-app-menu-btn="@a.Id"
                                    aria-label="@string.Format(Culture["Apps.ActionsFor"], a.VacancyTitle)"
                                    @onclick="() => ToggleMenu(a.Id)"
                                    @onclick:stopPropagation="true">
                                @((MarkupString)ActionIcons.MoreHorizontal)
                            </button>
                        }
                        @if (menuOpen)
                        {
                            <button type="button"
                                    class="application-card__menu-backdrop"
                                    tabindex="-1"
                                    aria-hidden="true"
                                    @onclick="CloseMenu"
                                    @onclick:stopPropagation="true"></button>
                            <div class="application-card__menu-panel"
                                 role="menu"
                                 data-app-menu-panel="@a.Id"
                                 @onkeydown="e => OnMenuKeyDown(e, a)">
                                @if (!_readOnly)
                                {
                                    <button type="button"
                                            role="menuitem"
                                            class="application-card__menu-item"
                                            disabled="@(_busyId == a.Id)"
                                            @ref="_menuItemRefs[menuSlot]"
                                            @onclick="() => OnMenuCvAsync(a)">
                                        <span class="application-card__menu-icon" aria-hidden="true">@((MarkupString)ActionIcons.Document)</span>
                                        @(_busyId == a.Id && _pdfBusy ? "…" : Culture["Apps.MenuCv"])
                                    </button>
                                }
                                <a role="menuitem"
                                   class="application-card__menu-item"
                                   href="@vacancyHref"
                                   @ref="_menuItemRefs[vacancySlot]"
                                   @onclick="CloseMenu">
                                    <span class="application-card__menu-icon" aria-hidden="true">@((MarkupString)ActionIcons.ExternalLink)</span>
                                    @Culture["Apps.MenuVacancy"]
                                </a>
                                @if (!_readOnly && CanWithdraw(a.Status))
                                {
                                    <hr class="application-card__menu-divider" />
                                    <button type="button"
                                            role="menuitem"
                                            class="application-card__menu-item application-card__menu-item--danger"
                                            @ref="_menuItemRefs[withdrawSlot]"
                                            @onclick="() => OpenWithdrawConfirm(a)">
                                        <span class="application-card__menu-icon" aria-hidden="true">@((MarkupString)ActionIcons.Withdraw)</span>
                                        @Culture["Apps.MenuWithdraw"]
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message apps-page__message">@_message</p>
    }
</div>

<LobsyFriendlyDialog IsOpen="@(_withdrawTarget is not null)"
                     Title="@Culture["Apps.WithdrawConfirm"]"
                     Lead="@Culture["Apps.WithdrawConfirmLead"]"
                     OnClose="CancelWithdraw">
    <div class="application-withdraw-actions">
        <button type="button" class="btn-compact" disabled="@(_busyId is not null)" @onclick="CancelWithdraw">
            @Culture["Common.Cancel"]
        </button>
        <button type="button"
                class="btn-compact application-withdraw-actions__danger"
                disabled="@(_busyId is not null)"
                @onclick="ConfirmWithdrawAsync">
            @(_busyId == _withdrawTarget?.Id ? "…" : Culture["Apps.Withdraw"])
        </button>
    </div>
</LobsyFriendlyDialog>

@code {
    private const string PersistKey = "candidateApplications";
    private List<ApplicationItem> _items = [];
    private List<ApplicationItem> _filtered = [];
    private bool _loading = true;
    private bool _disposed;
    private bool _restored;
    private bool _readOnly;
    private string? _filter;
    private string? _givenName;
    private Guid? _busyId;
    private Guid? _openMenuId;
    private bool _pdfBusy;
    private string? _message;
    private ApplicationItem? _withdrawTarget;
    private int _countOpen;
    private int _countRunning;
    private int _countRejected;
    private Guid? _focusMenuOnRender;
    private Guid? _focusMenuButtonId;
    private ElementReference _menuToggleRef;
    private readonly ElementReference[] _menuItemRefs = new ElementReference[3];
    private int _menuItemCount;
    private int _menuFocusIndex;
    private PersistingComponentStateSubscription _persistSubscription;
    private static readonly System.Globalization.CultureInfo Dutch = new("nl-NL");

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<List<ApplicationItem>>(PersistKey, out var saved) && saved is not null)
        {
            _items = saved;
            RefreshCounts();
            ApplyFilter();
            _loading = false;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, _items);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _readOnly = !RoleClaimMatching.HasRole(state.User, JobsyRoles.Candidate);
        _givenName = state.User.FindFirst(ClaimTypes.GivenName)?.Value
                     ?? state.User.FindFirst("given_name")?.Value;

        if (_restored)
        {
            return;
        }

        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            RefreshCounts();
            ApplyFilter();
        }
        catch
        {
            _items = [];
            _filtered = [];
            RefreshCounts();
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMenuOnRender is not null)
        {
            _focusMenuOnRender = null;
            _menuFocusIndex = 0;
            await FocusMenuItemAsync(0);
        }

        if (_focusMenuButtonId is not null)
        {
            _focusMenuButtonId = null;
            try
            {
                await _menuToggleRef.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            if (_disposed)
            {
                return;
            }

            _items = (await Api.GetMyApplicationsAsync()).ToList();
            RefreshCounts();
            ApplyFilter();
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch
        {
            // keep current list
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
    }

    private void ToggleFilter(string filter)
    {
        CloseMenu();
        _filter = string.Equals(_filter, filter, StringComparison.Ordinal) ? null : filter;
        ApplyFilter();
    }

    private void ClearFilter()
    {
        CloseMenu();
        _filter = null;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filtered = _filter switch
        {
            "open" => _items.Where(a => ApplicationStatusWizard.IsOpen(a.Status)).ToList(),
            "running" => _items.Where(a => ApplicationStatusWizard.IsRunning(a.Status)).ToList(),
            "rejected" => _items.Where(a => ApplicationStatusWizard.IsRejectedFilter(a.Status)).ToList(),
            _ => _items.ToList()
        };
    }

    private void RefreshCounts()
    {
        _countOpen = _items.Count(a => ApplicationStatusWizard.IsOpen(a.Status));
        _countRunning = _items.Count(a => ApplicationStatusWizard.IsRunning(a.Status));
        _countRejected = _items.Count(a => ApplicationStatusWizard.IsRejectedFilter(a.Status));
    }

    private static bool CanWithdraw(string status)
        => status == "Pending";

    private void ToggleMenu(Guid id)
    {
        if (_openMenuId == id)
        {
            _openMenuId = null;
            return;
        }

        _openMenuId = id;
        _focusMenuOnRender = id;
    }

    private void CloseMenu()
        => _openMenuId = null;

    private async Task OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _openMenuId is Guid id)
        {
            CloseMenu();
            await FocusMenuButtonAsync(id);
        }
    }

    private async Task OnMenuKeyDown(KeyboardEventArgs e, ApplicationItem a)
    {
        if (e.Key is "Escape")
        {
            CloseMenu();
            await FocusMenuButtonAsync(a.Id);
            return;
        }

        if (e.Key is not ("ArrowDown" or "ArrowUp") || _menuItemCount <= 0)
        {
            return;
        }

        var next = e.Key == "ArrowDown"
            ? (_menuFocusIndex + 1) % _menuItemCount
            : (_menuFocusIndex - 1 + _menuItemCount) % _menuItemCount;
        await FocusMenuItemAsync(next);
    }

    private async Task FocusMenuItemAsync(int index)
    {
        if (index < 0 || index >= _menuItemCount || index >= _menuItemRefs.Length)
        {
            return;
        }

        _menuFocusIndex = index;
        try
        {
            await _menuItemRefs[index].FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task FocusMenuButtonAsync(Guid id)
    {
        _focusMenuButtonId = id;
        return Task.CompletedTask;
    }

    private async Task OnMenuCvAsync(ApplicationItem a)
    {
        CloseMenu();
        await DownloadCvAsync(a);
    }

    private void OpenWithdrawConfirm(ApplicationItem a)
    {
        CloseMenu();
        _withdrawTarget = a;
    }

    private void CancelWithdraw()
        => _withdrawTarget = null;

    private async Task ConfirmWithdrawAsync()
    {
        if (_withdrawTarget is null)
        {
            return;
        }

        var target = _withdrawTarget;
        _withdrawTarget = null;
        await WithdrawAsync(target);
    }

    private string StatusPillLabel(string status) => status switch
    {
        "Pending" => Culture["Apps.Wizard.Applied"],
        "Accepted" => Culture["Apps.Wizard.InReview"],
        "EmployerContacting" => Culture["Apps.Wizard.Contact"],
        "Hired" => Culture["Apps.Wizard.Matched"],
        _ => UiLabels.ApplicationStatus(Culture, status)
    };

    private static string PillModifier(string status) => status switch
    {
        "Pending" => "pending",
        "Accepted" => "review",
        "EmployerContacting" => "contact",
        "Hired" => "hired",
        _ => "closed"
    };

    private string AppliedOnFullLabel(DateTime createdAt)
    {
        var local = createdAt.ToLocalTime();
        var culture = CultureInfoForUi();
        var date = local.ToString("d MMM yyyy", culture).Replace(".", "");
        return string.Format(Culture["Apps.AppliedOn"], date);
    }

    private string AppliedOnShortLabel(DateTime createdAt)
    {
        var local = createdAt.ToLocalTime();
        var culture = CultureInfoForUi();
        var now = DateTime.Now;
        var format = local.Year == now.Year ? "d MMM" : "d MMM yyyy";
        return local.ToString(format, culture).Replace(".", "");
    }

    private System.Globalization.CultureInfo CultureInfoForUi() => Culture.Language switch
    {
        "en" => new System.Globalization.CultureInfo("en-GB"),
        "pl" => new System.Globalization.CultureInfo("pl-PL"),
        "ro" => new System.Globalization.CultureInfo("ro-RO"),
        "ar" => new System.Globalization.CultureInfo("ar-SA"),
        _ => Dutch
    };

    private async Task WithdrawAsync(ApplicationItem item)
    {
        if (_readOnly)
        {
            return;
        }

        _busyId = item.Id;
        _pdfBusy = false;
        _message = null;
        try
        {
            await Api.WithdrawApplicationAsync(item.Id);
            item.Status = "Withdrawn";
            RefreshCounts();
            ApplyFilter();
            _message = Culture["Apps.WithdrawnMsg"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task DownloadCvAsync(ApplicationItem item)
    {
        if (_readOnly)
        {
            return;
        }

        _busyId = item.Id;
        _pdfBusy = true;
        _message = null;
        try
        {
            await Api.DownloadApplicationLobsyCvPdfAsync(item.Id, Js);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
            _pdfBusy = false;
        }
    }
}
