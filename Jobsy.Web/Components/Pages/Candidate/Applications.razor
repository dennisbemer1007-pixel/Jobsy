@page "/candidate/applications"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate,BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Authorization
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<PageTitle>@Culture["Nav.MyApplications"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Nav.MyApplications"]</h1>
            <p class="login-lead">
                @(_readOnly ? Culture["Apps.LeadReadOnly"] : Culture["Apps.Lead"])
            </p>
        </div>
    </header>

    <div class="admin-sublinks" role="tablist" aria-label="@Culture["Nav.MyApplications"]">
        <button type="button" class="admin-sublink @(_tab == "all" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "all")" @onclick='() => SetTab("all")'>@Culture["Apps.TabAll"]</button>
        <button type="button" class="admin-sublink @(_tab == "open" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "open")" @onclick='() => SetTab("open")'>@Culture["Apps.TabOpen"]</button>
        <button type="button" class="admin-sublink @(_tab == "rejected" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "rejected")" @onclick='() => SetTab("rejected")'>@Culture["Apps.TabRejected"]</button>
        <button type="button" class="admin-sublink @(_tab == "matched" ? "admin-sublink--active" : null)" role="tab" aria-selected="@(_tab == "matched")" @onclick='() => SetTab("matched")'>@Culture["Apps.TabMatched"]</button>
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_filtered.Count == 0)
    {
        <p class="state-message">
            @if (_items.Count == 0)
            {
                @Culture["Apps.Empty"]
                @if (!_readOnly)
                {
                    <text> <a href="/">@Culture["Apps.BrowseMap"]</a>.</text>
                }
            }
            else
            {
                @Culture["Apps.EmptyTab"]
            }
        </p>
    }
    else
    {
        <div class="table-list">
            @foreach (var a in _filtered)
            {
                <div class="table-row application-row">
                    <a class="application-row__link" href="@($"/vacancies/{a.VacancyId}")">
                        <strong>@a.VacancyTitle</strong>
                        <span class="muted">@a.CompanyName · @UiLabels.Transport(Culture, a.PreferredTransport) · @a.EstimatedTravelMinutes @Culture["Discovery.Minutes"]</span>
                    </a>
                    <div class="application-row__meta">
                        <span class="status-pill status-pill--@a.Status.ToLowerInvariant()">@UiLabels.ApplicationStatus(Culture, a.Status)</span>
                        @if (!_readOnly && CanWithdraw(a.Status))
                        {
                            <button type="button"
                                    class="btn-compact"
                                    disabled="@(_busyId == a.Id)"
                                    @onclick="() => WithdrawAsync(a)">
                                @(_busyId == a.Id ? "…" : Culture["Apps.Withdraw"])
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
</div>

@if (_showCelebration && !_readOnly)
{
    <div class="share-modal-backdrop"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="hired-title">
        <div class="share-modal__header">
            <h2 id="hired-title">@Culture["Apps.CongratsTitle"]</h2>
        </div>
        <p>@Culture["Apps.CongratsBody"]</p>
        <div class="inline-actions" style="margin-top:1rem">
            <button type="button" class="login-submit" @onclick="() => _showCelebration = false">@Culture["Common.Close"]</button>
        </div>
    </div>
}

@code {
    private List<ApplicationItem> _items = [];
    private List<ApplicationItem> _filtered = [];
    private bool _loading = true;
    private bool _readOnly;
    private bool _showCelebration;
    private string _tab = "all";
    private Guid? _busyId;
    private string? _message;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _readOnly = !RoleClaimMatching.HasRole(state.User, JobsyRoles.Candidate);

        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            _showCelebration = !_readOnly && _items.Any(x => x.Status == "Hired");
            ApplyTab();
        }
        catch
        {
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            ApplyTab();
        }
        catch
        {
            // keep current list
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private void SetTab(string tab)
    {
        _tab = tab;
        ApplyTab();
    }

    private void ApplyTab()
    {
        _filtered = _tab switch
        {
            "open" => _items.Where(IsOpen).ToList(),
            "rejected" => _items.Where(IsRejected).ToList(),
            "matched" => _items.Where(IsMatched).ToList(),
            _ => _items.ToList()
        };
    }

    private static bool IsOpen(ApplicationItem a)
        => a.Status is "Pending";

    private static bool IsRejected(ApplicationItem a)
        => a.Status is "Rejected" or "FilledElsewhere";

    private static bool IsMatched(ApplicationItem a)
        => a.Status is "Accepted" or "EmployerContacting" or "Hired";

    private static bool CanWithdraw(string status)
        => status == "Pending";

    private async Task WithdrawAsync(ApplicationItem item)
    {
        if (_readOnly)
        {
            return;
        }

        _busyId = item.Id;
        _message = null;
        try
        {
            await Api.WithdrawApplicationAsync(item.Id);
            _items.RemoveAll(x => x.Id == item.Id);
            ApplyTab();
            _message = Culture["Apps.WithdrawnMsg"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }
}
