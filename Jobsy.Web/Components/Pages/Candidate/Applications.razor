@page "/candidate/applications"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@inject JobsyApiClient Api

<PageTitle>Sollicitaties · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <a class="back-link" href="/home">← Terug</a>
            <h1>Mijn sollicitaties</h1>
            <p class="login-lead">Status van je reacties op vacatures.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">Laden…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="state-message">Nog geen sollicitaties. <a href="/">Bekijk de banenkaart</a>.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var a in _items)
            {
                <a class="table-row table-row--link" href="@($"/vacancies/{a.VacancyId}")">
                    <div>
                        <strong>@a.VacancyTitle</strong>
                        <span class="muted">@a.CompanyName · @a.PreferredTransport · @a.EstimatedTravelMinutes min</span>
                    </div>
                    <span class="status-pill status-pill--@a.Status.ToLowerInvariant()">@StatusLabel(a.Status)</span>
                </a>
            }
        </div>
    }
</div>

@if (_showCelebration)
{
    <div class="share-modal-backdrop"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="hired-title">
        <div class="share-modal__header">
            <h2 id="hired-title">Gefeliciteerd!</h2>
        </div>
        <p>Gefeliciteerd met je nieuwe baan!</p>
        <div class="inline-actions" style="margin-top:1rem">
            <button type="button" class="login-submit" @onclick="() => _showCelebration = false">Sluiten</button>
        </div>
    </div>
}

@code {
    private List<ApplicationItem> _items = [];
    private bool _loading = true;
    private bool _showCelebration;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Api.GetMyApplicationsAsync()).ToList();
            _showCelebration = _items.Any(x => x.Status == "Hired");
        }
        catch
        {
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        "Accepted" => "Geaccepteerd",
        "Rejected" => "Afgewezen",
        "PendingVerification" => "Wacht op e-mailverificatie",
        "EmployerContacting" => "Werkgever neemt contact op",
        "Hired" => "Aangenomen",
        "FilledElsewhere" => "De keuze is op een andere kandidaat gevallen",
        _ => "In behandeling"
    };
}
