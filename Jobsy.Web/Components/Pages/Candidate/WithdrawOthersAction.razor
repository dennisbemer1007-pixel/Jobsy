@page "/candidate/actions/withdraw-others"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<PageTitle>Andere sollicitaties intrekken · Lobsy</PageTitle>

<div class="panel candidate-action-page">
    @if (_busy && _phase == Phase.Working)
    {
        <div class="candidate-action-page__card">
            <p class="candidate-action-page__eyebrow">Even geduld</p>
            <h1>We trekken je overige sollicitaties in…</h1>
            <p class="muted">Dit duurt maar een moment.</p>
        </div>
    }
    else if (_phase == Phase.Confirm)
    {
        <div class="candidate-action-page__card">
            <p class="candidate-action-page__eyebrow">Netjes afronden</p>
            <h1>Andere sollicitaties intrekken?</h1>
            <p>
                Gefeliciteerd met je match. Wil je overige openstaande sollicitaties intrekken,
                zodat die werkgevers weten dat je al bent voorzien?
            </p>
            <ul class="candidate-action-page__bullets">
                <li>Je aangenomen sollicitatie blijft gewoon staan.</li>
                <li>Andere open sollicitaties krijgen de status <strong>Ingetrokken</strong>.</li>
                <li>Werkgevers ontvangen een korte, vriendelijke melding.</li>
            </ul>
            @if (!string.IsNullOrEmpty(_message) && _error)
            {
                <p class="state-message error">@_message</p>
            }
            <div class="inline-actions candidate-action-page__actions">
                <button type="button" class="login-submit" disabled="@_busy" @onclick="ConfirmAsync">
                    Ja, trek andere sollicitaties in
                </button>
                <a class="btn-compact" href="/candidate/applications">Liever niet</a>
            </div>
        </div>
    }
    else if (_phase == Phase.Success)
    {
        <div class="candidate-action-page__card candidate-action-page__card--success">
            <p class="candidate-action-page__eyebrow">Gelukt</p>
            <h1>Alles netjes afgerond</h1>
            <p>@_message</p>
            <p class="muted">Je vindt het overzicht terug bij Sollicitaties.</p>
            <div class="inline-actions candidate-action-page__actions">
                <a class="login-submit" href="/candidate/applications">Naar sollicitaties</a>
                <a class="btn-compact" href="/">Naar home</a>
            </div>
        </div>
    }
    else
    {
        <div class="candidate-action-page__card">
            <p class="candidate-action-page__eyebrow">Link niet geldig</p>
            <h1>Deze actie lukt niet meer</h1>
            <p class="@(_error ? "state-message error" : "muted")">@_message</p>
            <p class="muted">Je kunt openstaande sollicitaties ook handmatig intrekken via Sollicitaties.</p>
            <div class="inline-actions candidate-action-page__actions">
                <a class="login-submit" href="/candidate/applications">Naar sollicitaties</a>
                <a class="btn-compact" href="/">Naar home</a>
            </div>
        </div>
    }
</div>

@code {
    private enum Phase { Confirm, Working, Success, Failed }

    private Phase _phase = Phase.Confirm;
    private bool _busy;
    private bool _error;
    private string _message = "";
    private string? _token;
    private Guid? _hiredApplicationId;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("token", out var token) && !string.IsNullOrWhiteSpace(token))
        {
            _token = token!;
            _phase = Phase.Confirm;
            return;
        }

        if (query.TryGetValue("hiredApplicationId", out var hiredRaw)
            && Guid.TryParse(hiredRaw, out var hiredId)
            && hiredId != Guid.Empty)
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _hiredApplicationId = hiredId;
                _phase = Phase.Confirm;
                return;
            }

            _phase = Phase.Failed;
            _error = true;
            _message = "Log in om andere sollicitaties in te trekken, of open de link uit je e-mail.";
            return;
        }

        _phase = Phase.Failed;
        _error = true;
        _message = "Deze link is onvolledig of verlopen.";
    }

    private async Task ConfirmAsync()
    {
        if (_busy || (string.IsNullOrWhiteSpace(_token) && _hiredApplicationId is null))
        {
            return;
        }

        _busy = true;
        _phase = Phase.Working;
        _error = false;
        try
        {
            var result = _hiredApplicationId is Guid hiredId
                ? await Api.WithdrawOtherApplicationsAuthenticatedAsync(hiredId)
                : await Api.WithdrawOtherApplicationsViaTokenAsync(_token!);
            if (result?.Succeeded == true)
            {
                _phase = Phase.Success;
                var count = result.WithdrawnCount ?? 0;
                _message = count == 0
                    ? "Er stonden geen andere open sollicitaties meer. Je bent helemaal bij."
                    : count == 1
                        ? "1 andere sollicitatie is ingetrokken. De werkgever is netjes geïnformeerd."
                        : $"{count} andere sollicitaties zijn ingetrokken. De werkgevers zijn netjes geïnformeerd.";
            }
            else
            {
                _phase = Phase.Failed;
                _error = true;
                _message = result?.Message
                           ?? "Deze link is al gebruikt of verlopen.";
            }
        }
        catch (Exception ex)
        {
            _phase = Phase.Failed;
            _error = true;
            _message = FriendlyError(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FriendlyError(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "Er ging iets mis. Trek sollicitaties desnoods handmatig in via Sollicitaties.";
        }

        if (raw.Contains("ongeldig", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("gebruikt", StringComparison.OrdinalIgnoreCase))
        {
            return "Deze link is al gebruikt of niet meer geldig. Open Sollicitaties om het handmatig te doen.";
        }

        return raw;
    }
}
