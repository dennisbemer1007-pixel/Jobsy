@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (Scores is { IsComplete: true } complete)
{
    <div class="competency-score-panel">
        <svg class="competency-radar" viewBox="0 0 220 220" role="img" aria-label="@Culture["Competency.RadarLabel"]">
            <g transform="translate(110,110)">
                @for (var ring = 1; ring <= 4; ring++)
                {
                    <polygon class="competency-radar__grid" points="@RadarRing(ring * 25)" />
                }
                @for (var i = 0; i < 5; i++)
                {
                    var end = RadarPoint(100, i);
                    <line class="competency-radar__axis" x1="0" y1="0" x2="@end.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" y2="@end.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" />
                }
                <polygon class="competency-radar__fill" points="@RadarShape(complete)" />
            </g>
        </svg>
        <ul class="competency-skill-list" aria-label="@Culture["Kompas.TabCompetencies"]">
            @foreach (var category in CompetencyTestCatalog.QuickScanCategories)
            {
                var value = Value(complete, category) ?? 0;
                <li class="competency-skill">
                    <details class="competency-skill__details">
                        <summary>
                            <span class="competency-skill__name">@Culture[$"Competency.Cat.{category}"]</span>
                            <span class="competency-skill__value">@value%</span>
                        </summary>
                        <div class="competency-skill__body">
                            <p class="competency-skill__meaning">@Culture[CompetencyTrainingCatalog.MeaningKey(category, value)]</p>
                            <TrainingOffersBlock JobTitle="@CompetencyTrainingCatalog.SearchBlob(category)"
                                                 Campaign="@TrainingTracking.CampaignCompetence"
                                                 Compact="true"
                                                 TitleKey="Competency.TrainingTitle" />
                        </div>
                    </details>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public CompetencyScoreSet? Scores { get; set; }

    private static int? Value(CompetencyScoreSet scores, string category) => category switch
    {
        CompetencyTestCatalog.Samenwerken => scores.Samenwerken,
        CompetencyTestCatalog.Resultaatgerichtheid => scores.Resultaatgerichtheid,
        CompetencyTestCatalog.Stressbestendigheid => scores.Stressbestendigheid,
        CompetencyTestCatalog.Innovatie => scores.Innovatie,
        CompetencyTestCatalog.Extraversie => scores.Extraversie,
        _ => null
    };

    private static string RadarRing(double percent)
        => string.Join(" ", Enumerable.Range(0, AxisCount).Select(i => FormatPoint(RadarPoint(percent, i))));

    private const int AxisCount = 5;

    private static string RadarShape(CompetencyScoreSet scores)
    {
        var values = new[]
        {
            scores.Samenwerken ?? 0,
            scores.Resultaatgerichtheid ?? 0,
            scores.Stressbestendigheid ?? 0,
            scores.Innovatie ?? 0,
            scores.Extraversie ?? 0
        };
        return string.Join(" ", values.Select((v, i) => FormatPoint(RadarPoint(v, i))));
    }

    private static (double X, double Y) RadarPoint(double percent, int index)
    {
        var radius = 88 * Math.Clamp(percent, 0, 100) / 100.0;
        var angle = -Math.PI / 2 + index * (2 * Math.PI / AxisCount);
        return (radius * Math.Cos(angle), radius * Math.Sin(angle));
    }

    private static string FormatPoint((double X, double Y) p)
        => $"{p.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)},{p.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}";
}
