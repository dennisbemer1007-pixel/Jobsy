@page "/candidate/match"
@* KB-FALLBACK(C): gate with PlatformFeature.Employers when paspoort 01 lands *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@using Jobsy.Web.Components.Match
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Models
@using Jobsy.Web.Services
@inject MatchVacancyService MatchVacancies
@inject CandidateMatchProfileService MatchProfile
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Match.DialogTitle"] · Lobsy</PageTitle>

<div class="match-page match-page--shell @(_deck.Gate.IsProfileComplete && _deck.Gate.FitGateOpen ? null :"match-page--locked")"
     data-testid="match-page">
    <header class="match-page__top">
        <div class="match-page__brand">
            <img class="match-page__mascot"
                 src="/images/brand/mascot-128.png?v=20260828-mascot"
                 width="40"
                 height="40"
                 alt=""
                 aria-hidden="true" />
            <div>
                <h1 class="match-page__title">@Culture["Match.DialogTitle"]</h1>
                @if (_deck.Gate.IsProfileComplete && _deck.Gate.FitGateOpen && _deck.Count > 0 && !_deck.IsFinished)
                {
                    <p class="match-page__progress-text" aria-live="polite">
                        @Culture.Format("Match.DialogProgress", _deck.Position, _deck.Count)
                        <span> · @Culture["Kb.Match.NoWrongChoice"]</span>
                    </p>
                }
            </div>
        </div>
        <div class="match-page__top-actions">
            <a class="match-page__icon-btn" href="@KbRoutes.Map" title="@Culture["Discovery.BackToSearch"]" aria-label="@Culture["Discovery.BackToSearch"]">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m20 20-3.5-3.5"/>
                </svg>
            </a>
        </div>
    </header>

    @if (_deck.Gate.IsProfileComplete && _deck.Gate.FitGateOpen && _deck.Count > 0 && !_deck.IsFinished)
    {
        var progressPct = (int)Math.Round(100.0 * _deck.Position / _deck.Count);
        <div class="match-page__bar"
             role="progressbar"
             aria-valuemin="1"
             aria-valuemax="@_deck.Count"
             aria-valuenow="@_deck.Position">
            <svg class="match-page__bar-svg" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
                <rect class="match-page__bar-track" x="0" y="0" width="100" height="4" rx="2" />
                <rect class="match-page__bar-fill" x="0" y="0" width="@progressPct" height="4" rx="2" />
            </svg>
        </div>
    }

    <section class="match-page__body @(_deck.Gate.IsProfileComplete && _deck.Gate.FitGateOpen ?"match-page__panel--swipe" : "match-page__panel--gate")"
             aria-label="@Culture["Match.DialogTitle"]">
        @if (_loading)
        {
            <PageContentSkeleton Variant="match" />
        }
        else if (!_deck.Gate.IsProfileComplete)
        {
            <MatchUnlockPanel Gate="_deck.Gate" />
        }
        else if (!_deck.Gate.FitGateOpen)
        {
            <MatchUnlockPanel Gate="_deck.Gate" FitGateOnly="true" />
        }
        else if (_deck.IsFinished)
        {
            <div class="match-page__empty" data-testid="match-deck-done">
                <h2>@Culture["Match.DeckDone"]</h2>
                <div class="match-page__empty-actions">
                    <a class="match-page__cta" href="@KbRoutes.Saved">@Culture["Kb.Match.ViewSaved"]</a>
                    <a class="match-page__cta match-page__cta--ghost" href="@KbRoutes.Map">@Culture["Kb.Match.BackToMap"]</a>
                </div>
            </div>
        }
        else if (Current is null)
        {
            <div class="match-page__empty">
                <h2>@Culture["Kb.Match.EmptyTitle"]</h2>
                <p>@Culture["Kb.Match.EmptyLead"]</p>
                <div class="match-page__empty-actions">
                    <a class="match-page__cta" href="@KbRoutes.Map">@Culture["Discovery.BackToSearch"]</a>
                    <button type="button" class="match-page__cta match-page__cta--ghost" @onclick="() => ReloadDeckAsync()">@Culture["Kb.Match.Reload"]</button>
                </div>
            </div>
        }
        else
        {
            <div class="swipe-stack">
                @if (PeekNext is not null)
                {
                    <SwipeCard Model="PeekNext"
                               IsBackdrop="true"
                               AnimationDurationMs="0" />
                }

                <SwipeCard @key="Current.VacancyId ?? Guid.Empty"
                           Model="Current"
                           AnimationDurationMs="280"
                           OnReject="HandleReject"
                           OnInterest="HandleInterest"
                           OnMoreInfo="HandleMoreInfo"
                           OnSwipeComplete="HandleSwipeComplete" />
            </div>

            <p class="match-page__swipe-hint">@Culture["Kb.Match.SwipeHint"]</p>

            @if (PeekAfterNext?.ImageUrl is { Length: > 0 } prefetchUrl)
            {
                <img class="match-page__prefetch" src="@prefetchUrl" alt="" aria-hidden="true" />
            }
        }

        @if (!string.IsNullOrWhiteSpace(_toast))
        {
            <p class="match-page__toast" role="status">@_toast</p>
        }
    </section>
</div>

@code {
    private const string PersistKey = "candidateMatchDeck";
    private readonly MatchDeck _deck = new();
    private int _restoredIndex;
    private List<Guid> _restoredVacancyIds = [];
    private bool _loading = true;
    private bool _restored;
    private bool _heavyLoadStarted;
    private string? _toast;
    private CancellationTokenSource? _toastCts;
    private PersistingComponentStateSubscription _persistSubscription;

    private SwipeViewModel? Current => _deck.Current;
    private SwipeViewModel? PeekNext => _deck.PeekNext;
    private SwipeViewModel? PeekAfterNext =>
        _deck.Index + 2 < _deck.Count ? _deck.Items[_deck.Index + 2] : null;

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<MatchPagePersistState>(PersistKey, out var saved) && saved is not null)
        {
            _deck.SetGate(saved.Gate ?? new());
            _restoredVacancyIds = saved.VacancyIds ?? [];
            _restoredIndex = Math.Max(0, saved.Index);
            _loading = true;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, new MatchPagePersistState
        {
            Gate = SlimGate(_deck.Gate),
            VacancyIds = _deck.Items.Select(v => v.VacancyId).Where(id => id is Guid).Select(id => id!.Value).ToList(),
            Index = _deck.Index
        });
        return Task.CompletedTask;
    }

    private static MatchProfileGateViewModel SlimGate(MatchProfileGateViewModel gate) => new()
    {
        IsAuthenticated = gate.IsAuthenticated,
        ProfileBasicsFilled = gate.ProfileBasicsFilled,
        HasEducationLevel = gate.HasEducationLevel,
        WizardCompleted = gate.WizardCompleted,
        CompetencyCompleted = gate.CompetencyCompleted,
        CareerCompleted = gate.CareerCompleted,
        CultureCompleted = gate.CultureCompleted,
        ValuesCompleted = gate.ValuesCompleted,
        HasProvisionalScores = gate.HasProvisionalScores,
        IsProfileComplete = gate.IsProfileComplete,
        CompletedCount = gate.CompletedCount,
        RequiredCount = gate.RequiredCount,
        PreferredTransport = gate.PreferredTransport,
        MaxTravelMinutes = gate.MaxTravelMinutes
    };

    protected override Task OnInitializedAsync()
        => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _heavyLoadStarted || !RendererInfo.IsInteractive)
        {
            return;
        }

        _heavyLoadStarted = true;
        await ReloadDeckAsync(preserveProgress: _restored);
    }

    public void Dispose()
        => _persistSubscription.Dispose();

    private async Task ReloadDeckAsync(bool preserveProgress = false)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        await _deck.LoadAsync(MatchProfile, MatchVacancies, take: 24, orderByMatch: false);

        if (preserveProgress && _restoredVacancyIds.Count > 0)
        {
            _deck.RestoreIndex(_restoredVacancyIds, _restoredIndex);
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    internal sealed class MatchPagePersistState
    {
        public MatchProfileGateViewModel? Gate { get; set; }
        public List<Guid>? VacancyIds { get; set; }
        public int Index { get; set; }
    }

    private void HandleReject(SwipeViewModel model)
        => _ = ShowToastAsync(Culture["Kb.Match.Skipped"]);

    private void HandleInterest(SwipeViewModel model)
    {
        _ = _deck.LikeAsync(Api, model);
        _ = ShowToastAsync(Culture["Match.ToastLiked"]);
    }

    private void HandleMoreInfo(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id)
        {
            Navigation.NavigateTo($"/vacancies/{id}");
        }
    }

    private void HandleSwipeComplete((SwipeViewModel Model, SwipeDirection Direction) result)
    {
        if (result.Direction == SwipeDirection.Left && result.Model.VacancyId is Guid id)
        {
            _deck.Defer(id);
        }
        else
        {
            _deck.Advance();
        }
    }

    private async Task ShowToastAsync(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(1800, token);
            if (!token.IsCancellationRequested)
            {
                _toast = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }
}
