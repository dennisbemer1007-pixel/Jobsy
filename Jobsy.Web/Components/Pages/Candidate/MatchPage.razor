@page "/candidate/match"
@layout MatchMobileLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Web.Components.Match
@using Jobsy.Web.Components.Layout
@using Jobsy.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<PageTitle>Match · Lobsy</PageTitle>

<div class="match-page">
    <header class="match-page__top">
        <div class="match-page__brand">
            <LobsyMark Compact="true" />
            <span>Match</span>
        </div>
        <div class="match-page__top-actions">
            <button type="button" class="match-page__icon-btn" title="Geschiedenis" @onclick="ShowHistoryHint">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7v5l3 2"/>
                </svg>
            </button>
            <button type="button" class="match-page__icon-btn" title="Filters" @onclick="() => _activeTab = MatchTab.Vacatures">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"/>
                    <line x1="8" y1="12" x2="20" y2="12"/>
                    <line x1="4" y1="18" x2="16" y2="18"/>
                    <circle cx="6" cy="12" r="2"/>
                    <circle cx="18" cy="18" r="2"/>
                </svg>
            </button>
        </div>
    </header>

    <div class="match-page__body">
        @if (_activeTab == MatchTab.Match)
        {
            <section class="match-page__panel match-page__panel--swipe" aria-label="Match swipen">
                @if (_loading)
                {
                    <p class="match-page__state">Vacatures laden…</p>
                }
                else if (_current is null)
                {
                    <div class="match-page__empty">
                        <h2>Alles gezien</h2>
                        <p>Er liggen nu geen nieuwe matches klaar. Kom later terug of bekijk vacatures.</p>
                        <button type="button" class="match-page__cta" @onclick="ReloadDeckAsync">Opnieuw laden</button>
                    </div>
                }
                else
                {
                    <SwipeCard @key="_current.VacancyId"
                               Model="_current"
                               AnimationDurationMs="360"
                               OnReject="HandleRejectAsync"
                               OnInterest="HandleInterestAsync"
                               OnMoreInfo="HandleMoreInfo"
                               OnSwipeComplete="HandleSwipeCompleteAsync" />
                }

                @if (!string.IsNullOrWhiteSpace(_toast))
                {
                    <p class="match-page__toast" role="status">@_toast</p>
                }
            </section>
        }
        else if (_activeTab == MatchTab.Vacatures)
        {
            <section class="match-page__panel" aria-label="Vacatures">
                <h2 class="match-page__panel-title">Vacatures</h2>
                <p class="match-page__panel-lead">Bekijk alle openstaande banen op de kaart of in je overzicht.</p>
                <div class="match-page__panel-actions">
                    <a class="match-page__cta" href="/">Banenkaart</a>
                    <a class="match-page__cta match-page__cta--ghost" href="/candidate/vacancies">Mijn vacatures</a>
                </div>
            </section>
        }
        else if (_activeTab == MatchTab.Chat)
        {
            <section class="match-page__panel" aria-label="Chat">
                <h2 class="match-page__panel-title">Chat</h2>
                <p class="match-page__panel-lead">Gesprekken met werkgevers verschijnen hier zodra je “Koffie doen” hebt gekozen en zij reageren.</p>
            </section>
        }
        else if (_activeTab == MatchTab.Bedrijven)
        {
            <section class="match-page__panel" aria-label="Bedrijven">
                <h2 class="match-page__panel-title">Bedrijven</h2>
                <p class="match-page__panel-lead">Ontdek werkgevers in jouw regio. Swipe eerst op Match om bedrijven te bewaren.</p>
                <a class="match-page__cta" href="/">Ontdek via de kaart</a>
            </section>
        }
        else
        {
            <section class="match-page__panel" aria-label="Profiel">
                <h2 class="match-page__panel-title">Profiel</h2>
                <p class="match-page__panel-lead">Beheer je Lobsy-profiel, beschikbaarheid en matchvoorkeuren.</p>
                <a class="match-page__cta" href="/candidate/profile">Naar mijn profiel</a>
            </section>
        }
    </div>

    <nav class="match-tabs" aria-label="Match-navigatie">
        @foreach (var tab in _tabs)
        {
            <button type="button"
                    class="match-tabs__item @(_activeTab == tab.Id ? "is-active" : null)"
                    @onclick="() => _activeTab = tab.Id"
                    aria-current="@(_activeTab == tab.Id ? "page" : null)">
                <span class="match-tabs__icon" aria-hidden="true">@((MarkupString)tab.Svg)</span>
                <span class="match-tabs__label">@tab.Label</span>
                @if (tab.Id == MatchTab.Profiel && _profileDot)
                {
                    <span class="match-tabs__dot" aria-hidden="true"></span>
                }
            </button>
        }
    </nav>
</div>

@code {
    private enum MatchTab { Match, Vacatures, Chat, Bedrijven, Profiel }

    private sealed record TabDef(MatchTab Id, string Label, string Svg);

    private static readonly TabDef[] _tabs =
    [
        new(MatchTab.Match, "Match",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"4\" width=\"11\" height=\"14\" rx=\"2\"/><rect x=\"8\" y=\"6\" width=\"11\" height=\"14\" rx=\"2\"/></svg>"),
        new(MatchTab.Vacatures, "Vacatures",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z\"/></svg>"),
        new(MatchTab.Chat, "Chat",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0Z\"/></svg>"),
        new(MatchTab.Bedrijven, "Bedrijven",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h18\"/><path d=\"M5 21V7l7-4 7 4v14\"/><path d=\"M9 21v-6h6v6\"/></svg>"),
        new(MatchTab.Profiel, "Profiel",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1\"/></svg>")
    ];

    private MatchTab _activeTab = MatchTab.Match;
    private readonly Queue<SwipeViewModel> _deck = new();
    private SwipeViewModel? _current;
    private bool _loading = true;
    private bool _profileDot;
    private string? _toast;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _profileDot = state.User.Identity?.IsAuthenticated != true;
        await ReloadDeckAsync();
    }

    private async Task ReloadDeckAsync()
    {
        _loading = true;
        _deck.Clear();
        _current = null;
        StateHasChanged();

        try
        {
            var items = await Api.DiscoverVacanciesAsync(
                originLat: null,
                originLng: null,
                transport: "Auto",
                maxMinutes: 60,
                radiusKm: null,
                take: 12);

            foreach (var item in items.Take(12))
            {
                _deck.Enqueue(SwipeViewModel.FromVacancy(item, showMatchPercentage: true));
            }
        }
        catch
        {
            // Offline / unauthorized → demo deck so the UI is instantly testable.
        }

        if (_deck.Count == 0)
        {
            foreach (var demo in SwipeViewModel.CreateDemoDeck())
            {
                _deck.Enqueue(demo);
            }
        }

        _current = _deck.Count > 0 ? _deck.Dequeue() : null;
        _loading = false;
    }

    private async Task HandleRejectAsync(SwipeViewModel model)
    {
        await ShowToastAsync("Overgeslagen");
    }

    private async Task HandleInterestAsync(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id
            && id != Guid.Parse("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee")
            && id != Guid.Parse("bbbbbbbb-cccc-dddd-eeee-ffffffffffff")
            && id != Guid.Parse("cccccccc-dddd-eeee-ffff-aaaaaaaaaaaa"))
        {
            try
            {
                await Api.SetLikedAsync(id, liked: true);
                await ShowToastAsync("Opgeslagen — koffie!");
                return;
            }
            catch
            {
                // Fall through to local toast when not logged in.
            }
        }

        await ShowToastAsync("Koffie genoteerd (demo)");
    }

    private void HandleMoreInfo(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id
            && id != Guid.Parse("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee")
            && id != Guid.Parse("bbbbbbbb-cccc-dddd-eeee-ffffffffffff")
            && id != Guid.Parse("cccccccc-dddd-eeee-ffff-aaaaaaaaaaaa"))
        {
            Navigation.NavigateTo($"/vacancies/{id}");
            return;
        }

        _ = ShowToastAsync("Meer info (demo-card)");
    }

    private Task HandleSwipeCompleteAsync((SwipeViewModel Model, SwipeDirection Direction) result)
    {
        _current = _deck.Count > 0 ? _deck.Dequeue() : null;
        return Task.CompletedTask;
    }

    private void ShowHistoryHint()
        => _ = ShowToastAsync("Geschiedenis volgt binnenkort");

    private async Task ShowToastAsync(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        try
        {
            await Task.Delay(2200, token);
            if (!token.IsCancellationRequested)
            {
                _toast = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // replaced by a newer toast
        }
    }
}
