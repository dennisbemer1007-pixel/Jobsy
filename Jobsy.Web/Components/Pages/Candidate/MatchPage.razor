@page "/candidate/match"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Web.Components.Match
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Models
@using Jobsy.Web.Services
@inject MatchVacancyService MatchVacancies
@inject CandidateMatchProfileService MatchProfile
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Nav.Match"] · Lobsy</PageTitle>

<div class="match-page match-page--shell @(_gate.IsProfileComplete ? null : "match-page--locked")">
    <header class="match-page__top">
        <span class="match-page__title">Match</span>
        <div class="match-page__top-actions">
            <button type="button" class="match-page__icon-btn" title="Geschiedenis" @onclick="ShowHistoryHint">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7v5l3 2"/>
                </svg>
            </button>
            <a class="match-page__icon-btn" href="/" title="@Culture["Discovery.BackToSearch"]" aria-label="@Culture["Discovery.BackToSearch"]">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m20 20-3.5-3.5"/>
                </svg>
            </a>
        </div>
    </header>

    <section class="match-page__body @(_gate.IsProfileComplete ? "match-page__panel--swipe" : "match-page__panel--gate")"
             aria-label="@(_gate.IsProfileComplete ? "Match swipen" : "Match ontgrendelen")">
        @if (_loading)
        {
            <PageContentSkeleton Variant="match" LoadingLabel="Bezig met laden…" />
        }
        else if (!_gate.IsProfileComplete)
        {
            <MatchUnlockPanel Gate="_gate" />
        }
        else if (Current is null)
        {
            <div class="match-page__empty">
                <h2>Geen passende matches</h2>
                <p>Er liggen nu geen vacatures die bij jouw opleiding en reistijd passen.</p>
                <p class="match-gate__hint">
                    Wil je breder zoeken of andere typen vacatures vinden? Ga dan naar de banenkaart.
                </p>
                <div class="match-page__empty-actions">
                    <a class="match-page__cta" href="/">@Culture["Discovery.BackToSearch"]</a>
                    <button type="button" class="match-page__cta match-page__cta--ghost" @onclick="ReloadDeckAsync">Opnieuw laden</button>
                </div>
            </div>
        }
        else
        {
            <div class="swipe-stack">
                @if (PeekNext is not null)
                {
                    <SwipeCard Model="PeekNext"
                               IsBackdrop="true"
                               AnimationDurationMs="0" />
                }

                <SwipeCard @key="Current.VacancyId ?? Guid.Empty"
                           Model="Current"
                           AnimationDurationMs="280"
                           OnReject="HandleReject"
                           OnInterest="HandleInterest"
                           OnMoreInfo="HandleMoreInfo"
                           OnSwipeComplete="HandleSwipeComplete" />
            </div>

            @if (PeekAfterNext?.ImageUrl is { Length: > 0 } prefetchUrl)
            {
                <img class="match-page__prefetch" src="@prefetchUrl" alt="" aria-hidden="true" />
            }
        }

        @if (!string.IsNullOrWhiteSpace(_toast))
        {
            <p class="match-page__toast" role="status">@_toast</p>
        }
    </section>
</div>

@code {
    private const string PersistKey = "candidateMatchDeck";
    private readonly List<SwipeViewModel> _deck = [];
    private MatchProfileGateViewModel _gate = new();
    private int _index;
    private bool _loading = true;
    private bool _restored;
    private string? _toast;
    private CancellationTokenSource? _toastCts;
    private PersistingComponentStateSubscription _persistSubscription;

    private SwipeViewModel? Current =>
        _index >= 0 && _index < _deck.Count ? _deck[_index] : null;

    private SwipeViewModel? PeekNext =>
        _index + 1 < _deck.Count ? _deck[_index + 1] : null;

    private SwipeViewModel? PeekAfterNext =>
        _index + 2 < _deck.Count ? _deck[_index + 2] : null;

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<MatchPagePersistState>(PersistKey, out var saved) && saved is not null)
        {
            _gate = saved.Gate ?? new();
            _deck.Clear();
            _deck.AddRange(saved.Deck ?? []);
            _index = Math.Clamp(saved.Index, 0, Math.Max(0, _deck.Count));
            _loading = false;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, new MatchPagePersistState
        {
            Gate = _gate,
            Deck = _deck.ToList(),
            Index = _index
        });
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_restored)
        {
            return;
        }

        await ReloadDeckAsync();
    }

    public void Dispose()
        => _persistSubscription.Dispose();

    private async Task ReloadDeckAsync()
    {
        _loading = true;
        _deck.Clear();
        _index = 0;
        await InvokeAsync(StateHasChanged);

        _gate = await MatchProfile.RefreshAsync();

        if (_gate.IsProfileComplete)
        {
            var items = await MatchVacancies.GetRelevantSwipeVacanciesAsync(_gate, take: 24);
            foreach (var item in items)
            {
                _deck.Add(SwipeViewModel.FromVacancy(item, showMatchPercentage: true));
            }
        }

        _index = 0;
        _loading = false;
    }

    private sealed class MatchPagePersistState
    {
        public MatchProfileGateViewModel? Gate { get; set; }
        public List<SwipeViewModel>? Deck { get; set; }
        public int Index { get; set; }
    }

    private void HandleReject(SwipeViewModel model)
        => _ = ShowToastAsync("Overgeslagen");

    private void HandleInterest(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id)
        {
            _ = PersistLikeAsync(id);
        }

        _ = ShowToastAsync("Interesse genoteerd");
    }

    private async Task PersistLikeAsync(Guid vacancyId)
    {
        try
        {
            await Api.SetLikedAsync(vacancyId, liked: true);
        }
        catch
        {
            // Guest / network — swipe UX must stay instant.
        }
    }

    private void HandleMoreInfo(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id)
        {
            Navigation.NavigateTo($"/vacancies/{id}");
        }
    }

    private void HandleSwipeComplete((SwipeViewModel Model, SwipeDirection Direction) result)
    {
        if (_index < _deck.Count)
        {
            _index++;
        }
    }

    private void ShowHistoryHint()
        => _ = ShowToastAsync("Geschiedenis volgt binnenkort");

    private async Task ShowToastAsync(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(1800, token);
            if (!token.IsCancellationRequested)
            {
                _toast = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // replaced by a newer toast
        }
    }
}
