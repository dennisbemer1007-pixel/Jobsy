@page "/candidate/match"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Web.Components.Match
@using Jobsy.Web.Models
@inject JobsyApiClient Api
@inject NavigationManager Navigation

<PageTitle>Match · Lobsy</PageTitle>

<div class="match-page match-page--shell">
    <header class="match-page__top">
        <span class="match-page__title">Match</span>
        <div class="match-page__top-actions">
            <button type="button" class="match-page__icon-btn" title="Geschiedenis" @onclick="ShowHistoryHint">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7v5l3 2"/>
                </svg>
            </button>
            <a class="match-page__icon-btn" href="/" title="Filters / banenkaart" aria-label="Filters">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="4" y1="6" x2="20" y2="6"/>
                    <line x1="8" y1="12" x2="20" y2="12"/>
                    <line x1="4" y1="18" x2="16" y2="18"/>
                    <circle cx="6" cy="12" r="2"/>
                    <circle cx="18" cy="18" r="2"/>
                </svg>
            </a>
        </div>
    </header>

    <section class="match-page__body match-page__panel--swipe" aria-label="Match swipen">
        @if (_loading)
        {
            <p class="match-page__state">Vacatures laden…</p>
        }
        else if (Current is null)
        {
            <div class="match-page__empty">
                <h2>Alles gezien</h2>
                <p>Er liggen nu geen nieuwe matches klaar. Kom later terug of bekijk vacatures.</p>
                <button type="button" class="match-page__cta" @onclick="ReloadDeckAsync">Opnieuw laden</button>
            </div>
        }
        else
        {
            <div class="swipe-stack">
                @* Next card already mounted underneath for instant reveal after swipe. *@
                @if (PeekNext is not null)
                {
                    <SwipeCard Model="PeekNext"
                               IsBackdrop="true"
                               AnimationDurationMs="0" />
                }

                <SwipeCard @key="Current.VacancyId ?? Guid.Empty"
                           Model="Current"
                           AnimationDurationMs="280"
                           OnReject="HandleReject"
                           OnInterest="HandleInterest"
                           OnMoreInfo="HandleMoreInfo"
                           OnSwipeComplete="HandleSwipeComplete" />
            </div>

            @* Warm browser image cache for the card after next. *@
            @if (PeekAfterNext?.ImageUrl is { Length: > 0 } prefetchUrl)
            {
                <img class="match-page__prefetch" src="@prefetchUrl" alt="" aria-hidden="true" />
            }
        }

        @if (!string.IsNullOrWhiteSpace(_toast))
        {
            <p class="match-page__toast" role="status">@_toast</p>
        }
    </section>
</div>

@code {
    private static readonly HashSet<Guid> DemoIds =
    [
        Guid.Parse("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"),
        Guid.Parse("bbbbbbbb-cccc-dddd-eeee-ffffffffffff"),
        Guid.Parse("cccccccc-dddd-eeee-ffff-aaaaaaaaaaaa")
    ];

    /// <summary>Preloaded deck — advances by index only (no network between swipes).</summary>
    private readonly List<SwipeViewModel> _deck = [];
    private int _index;
    private bool _loading = true;
    private string? _toast;
    private CancellationTokenSource? _toastCts;

    private SwipeViewModel? Current =>
        _index >= 0 && _index < _deck.Count ? _deck[_index] : null;

    private SwipeViewModel? PeekNext =>
        _index + 1 < _deck.Count ? _deck[_index + 1] : null;

    private SwipeViewModel? PeekAfterNext =>
        _index + 2 < _deck.Count ? _deck[_index + 2] : null;

    protected override async Task OnInitializedAsync()
        => await ReloadDeckAsync();

    private async Task ReloadDeckAsync()
    {
        _loading = true;
        _deck.Clear();
        _index = 0;
        StateHasChanged();

        try
        {
            var items = await Api.DiscoverVacanciesAsync(
                originLat: null,
                originLng: null,
                transport: "Auto",
                maxMinutes: 60,
                radiusKm: null,
                take: 24);

            foreach (var item in items.Take(24))
            {
                _deck.Add(SwipeViewModel.FromVacancy(item, showMatchPercentage: true));
            }
        }
        catch
        {
            // Offline / unauthorized → demo deck so the UI is instantly testable.
        }

        if (_deck.Count == 0)
        {
            _deck.AddRange(SwipeViewModel.CreateDemoDeck());
        }

        _index = 0;
        _loading = false;
    }

    /// <summary>Non-blocking — must not delay the swipe animation or next-card reveal.</summary>
    private void HandleReject(SwipeViewModel model)
        => _ = ShowToastAsync("Overgeslagen");

    /// <summary>Like is fired in the background so the next card appears instantly.</summary>
    private void HandleInterest(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id && !DemoIds.Contains(id))
        {
            _ = PersistLikeAsync(id);
        }

        _ = ShowToastAsync("Interesse genoteerd");
    }

    private async Task PersistLikeAsync(Guid vacancyId)
    {
        try
        {
            await Api.SetLikedAsync(vacancyId, liked: true);
        }
        catch
        {
            // Guest / network — swipe UX must stay instant.
        }
    }

    private void HandleMoreInfo(SwipeViewModel model)
    {
        if (model.VacancyId is Guid id && !DemoIds.Contains(id))
        {
            Navigation.NavigateTo($"/vacancies/{id}");
            return;
        }

        _ = ShowToastAsync("Meer info (demo-card)");
    }

    private void HandleSwipeComplete((SwipeViewModel Model, SwipeDirection Direction) result)
    {
        // Instant advance from the in-memory list — no await, no API call.
        if (_index < _deck.Count)
        {
            _index++;
        }
    }

    private void ShowHistoryHint()
        => _ = ShowToastAsync("Geschiedenis volgt binnenkort");

    private async Task ShowToastAsync(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(1800, token);
            if (!token.IsCancellationRequested)
            {
                _toast = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // replaced by a newer toast
        }
    }
}
