@page "/profiel/tests/{TestKey}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using System.Globalization
@using Jobsy.Core.Enums
@using Jobsy.Core.Reports
@using Jobsy.Core.Reports.Career
@using Jobsy.Core.Reports.Competence
@using Jobsy.Core.Reports.Culture
@using Jobsy.Core.Reports.Values
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Core.Options
@using Jobsy.Web.Components.Candidate.TestResult
@using Jobsy.Web.Components.Pages.Candidate.DeepReport
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Components.Shared
@using Microsoft.Extensions.Options
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject PersistentComponentState Persist
@inject IOptionsSnapshot<JobsyFeatureOptions> FeatureOptions
@implements IDisposable

<PageTitle>@(_def is null ? Culture["Kompas.TabTests"] : Culture[_def.TitleKey]) · Lobsy</PageTitle>

<div class="panel-page profile-page profile-page--candidate test-detail-page pb-28">
    <p class="test-detail__back">
        <a href="/candidate/profile?tab=tests" class="test-detail__back-link">← @Culture["Tests.BackToOverview"]</a>
    </p>

    @if (_loading)
    {
        <PageContentSkeleton Variant="test-detail" LoadingLabel="@Culture["Common.Loading"]" />
    }
    else if (_def is null)
    {
        <p class="state-message">@Culture["Tests.Unknown"]</p>
        <a class="engagement-btn" href="/candidate/profile?tab=tests">@Culture["Tests.BackToOverview"]</a>
    }
    else if (_freeDone || _deepCompleted)
    {
        @if (!string.IsNullOrWhiteSpace(_payError))
        {
            <div class="test-detail__pay-error" role="alert">
                <p class="state-message error">@_payError</p>
                <button type="button" class="engagement-btn" @onclick="ClearPayError">@Culture["Common.Retry"]</button>
            </div>
        }

        <header class="test-result-header">
            <div class="test-result-header__main">
                <h1>@Culture[_def.TitleKey]</h1>
                <p class="test-detail__status-row">
                    <span class="test-status-badge test-status-badge--@(_deepCompleted ? "gold" : "success")">
                        <span aria-hidden="true">@(_deepCompleted ? "★" : "✓")</span>
                        @Culture[_deepCompleted ? "Test.Status.Extended" : "Test.Status.FreeDone"]
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_completedMeta))
                    {
                        <span class="muted">@_completedMeta · @Culture.Format("TestResult.ScoresCount", _scoreBars.Count)</span>
                    }
                </p>
            </div>
            <div class="test-result-actions">
                <div class="test-result-actions__btns">
                    @if (_editModeEnabled)
                    {
                        <button type="button"
                                class="btn-outline-brand"
                                disabled="@(_busy || _adjustments.Remaining <= 0)"
                                aria-describedby="test-result-quota"
                                @onclick="BeginEditAsync">
                            ✎ @Culture["TestResult.EditAnswers"]
                        </button>
                    }
                    <button type="button"
                            class="test-result-actions__ghost"
                            disabled="@(_busy || _adjustments.Remaining <= 0)"
                            aria-describedby="test-result-quota"
                            @onclick="() => _redoOpen = true">
                        ↻ @Culture["TestResult.Retake"]
                    </button>
                </div>
                @if (_adjustments.Remaining <= 0)
                {
                    <p id="test-result-quota" class="test-result-quota test-result-quota--zero" role="status">
                        <span class="test-result-quota__icon" aria-hidden="true">ⓘ</span>
                        @Culture.Format("TestResult.Quota.Zero", _adjustments.Max)
                    </p>
                }
                else
                {
                    <p id="test-result-quota" class="test-result-quota" role="status">
                        <span aria-hidden="true">ⓘ</span>
                        @if (_adjustments.Remaining == 1)
                        {
                            @Culture.Format("TestResult.Quota.LineOne", _adjustments.Max)
                        }
                        else
                        {
                            @Culture.Format("TestResult.Quota.Line", _adjustments.Remaining, _adjustments.Max)
                        }
                    </p>
                }
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_headline))
        {
            <article class="test-result-card">
                <h2 class="test-result-card__title">@_headline</h2>
                @if (!string.IsNullOrWhiteSpace(_headlineLead))
                {
                    <p>@_headlineLead</p>
                }
            </article>
        }

        @if (_scoreBars.Count > 0)
        {
            <ul class="test-score-bars" aria-label="@Culture["Tests.ScoresLabel"]">
                @foreach (var bar in _scoreBars)
                {
                    <li>
                        <div class="test-score-bars__row">
                            <span>@bar.Label</span>
                            <strong>@bar.Percent%</strong>
                        </div>
                        <div class="test-score-bars__track" role="presentation">
                            <span style="width: @(bar.Percent.ToString(CultureInfo.InvariantCulture))%"></span>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (_personalityBars.Count > 0)
        {
            <h2 class="test-detail__section-title">@Culture["Tests.PersonalityScores"]</h2>
            <ul class="test-score-bars" aria-label="@Culture["Tests.PersonalityScores"]">
                @foreach (var bar in _personalityBars)
                {
                    <li>
                        <div class="test-score-bars__row">
                            <span>@bar.Label</span>
                            <strong>@bar.Percent%</strong>
                        </div>
                        <div class="test-score-bars__track" role="presentation">
                            <span style="width: @(bar.Percent.ToString(CultureInfo.InvariantCulture))%"></span>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (_careerCompass is not null && (_careerCompass.HasOccupations || _careerCompass.Strengths.Count > 0 || _careerCompass.PracticalNotes.Count > 0))
        {
            <section class="test-detail__compass" aria-label="@Culture["Kompas.Career"]">
                <CareerCompassPanel Compass="_careerCompass"
                                    Competencies="_competencyScores"
                                    CareerDirection="_riasecScores" />
                <p class="career-dash-link-row">
                    <a class="engagement-btn" href="/carriere">@Culture["CareerDash.OpenLink"]</a>
                </p>
            </section>
        }

        <details class="test-detail__accordion">
            <summary>@Culture["Tests.WhatItMeans"]</summary>
            <p class="login-lead">@Culture[_def.ScienceNoteKey]</p>
            <p class="whoami-model muted">
                @Culture["Tests.ModelLabel"]: @_def.ModelName.
                <a href="@_def.ModelUrl" target="_blank" rel="noopener noreferrer">@Culture["Tests.MoreAboutModel"]</a>
            </p>
        </details>

        @if (_deepCompleted)
        {
            @if (_def.Kind == AssessmentKind.Competence && _competenceReport is not null)
            {
                <CompetenceDeepReportView Report="_competenceReport"
                                          CompletedAtUtc="@_deepState?.CompletedAtUtc"
                                          QuestionCount="@(_deepState?.QuestionCount ?? 150)"
                                          Busy="_busy"
                                          OnDownloadPdf="DownloadPdfAsync" />
            }
            else if (_def.Kind == AssessmentKind.Career && _careerReport is not null)
            {
                <CareerDeepReportView Report="_careerReport" Busy="_busy" OnDownloadPdf="DownloadPdfAsync" />
            }
            else if (_def.Kind == AssessmentKind.Culture && _cultureReport is not null)
            {
                <CultureDeepReportView Report="_cultureReport" Busy="_busy" OnDownloadPdf="DownloadPdfAsync" />
            }
            else if (_def.Kind == AssessmentKind.Values && _valuesReport is not null)
            {
                <ValuesDeepReportView Report="_valuesReport" Busy="_busy" OnDownloadPdf="DownloadPdfAsync" />
            }
            else
            {
                <button type="button" class="engagement-btn" disabled="@_busy" @onclick="DownloadPdfAsync">
                    @Culture["Deep.DownloadPdf"]
                </button>
            }
        }
        else
        {
            <TestResultLockedPreview Kind="_def.Kind"
                                    TitleKey="@_def.TitleKey"
                                    QuestionCount="_def.DeepQuestionCount"
                                    PriceEuro="_priceEuro"
                                    MinutesApprox="@TestDepthRules.MinutesFor(_def.Kind, TestDepthLevel.Bottom)"
                                    Busy="_busy"
                                    IsUnlockedNotCompleted="_deepUnlocked && !_deepCompleted"
                                    DeepStartHref="@_def.DeepStartHref"
                                    ProgressCurrent="@(_deepState?.AnsweredCount ?? 0)"
                                    ProgressTotal="@_def.DeepQuestionCount"
                                    ShowSamplePdf="_samplePdfEnabled"
                                    ShowHeading="false"
                                    OnStart="GoToOfferAsync"
                                    OnSamplePdf="OpenSamplePdfAsync" />
        }

        @if (_history.Count > 0)
        {
            <section class="test-result-history" aria-labelledby="test-result-history-title">
                <h2 id="test-result-history-title">@Culture["TestResult.History.Title"]</h2>
                <ul>
                    @foreach (var item in _history)
                    {
                        <li>
                            <span>
                                @(item.CompletedAtUtc?.ToLocalTime().ToString("d MMM yyyy", CultureInfo.GetCultureInfo("nl-NL"))
                                  ?? item.StartedAtUtc.ToLocalTime().ToString("d MMM yyyy", CultureInfo.GetCultureInfo("nl-NL")))
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        <TestResultRedoDialog Open="_redoOpen"
                              Busy="_busy"
                              EditEnabled="_editModeEnabled"
                              RemainingAfter="@(Math.Max(0, _adjustments.Remaining - 1))"
                              OnConfirm="ConfirmRetakeAsync"
                              OnPreferEdit="BeginEditAsync"
                              OnCancel="() => _redoOpen = false" />

        <TestResultSamplePdfDialog Open="_samplePdfOpen"
                                   Busy="_busy"
                                   Loading="_samplePdfLoading"
                                   TestTitle="@Culture[_def.TitleKey]"
                                   PriceEuro="_priceEuro"
                                   QuestionCount="_def.DeepQuestionCount"
                                   MinutesApprox="@TestDepthRules.MinutesFor(_def.Kind, TestDepthLevel.Bottom)"
                                   TotalPages="_samplePdfTotalPages"
                                   PagePngBase64="_samplePdfPages"
                                   OnClose="CloseSamplePdf"
                                   OnDownload="DownloadSamplePdfAsync"
                                   OnStart="StartExtendedFromSampleAsync" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_payError))
        {
            <div class="test-detail__pay-error" role="alert">
                <p class="state-message error">@_payError</p>
                <button type="button" class="engagement-btn" @onclick="ClearPayError">@Culture["Common.Retry"]</button>
            </div>
        }

        <header class="test-detail__header">
            <h1>@Culture[_def.TitleKey]</h1>
            <p class="test-detail__status-row">
                <span class="test-status-badge test-status-badge--pending">
                    <span aria-hidden="true">○</span>
                    @Culture["Test.Status.NotDone"]
                </span>
                <span class="muted">@Culture.Format("Tests.MetaFree", _def.FreeQuestionCount, _def.FreeMinutesApprox)</span>
            </p>
        </header>

        <section class="test-detail__section">
            <h2>@Culture["Tests.WhatIsIt"]</h2>
            <p>@Culture[_def.LeadKey]</p>
        </section>
        <section class="test-detail__section">
            <h2>@Culture["Tests.WhyThis"]</h2>
            <p>@Culture[_def.ScienceNoteKey]</p>
        </section>
        <section class="test-detail__section">
            <h2>@Culture["Tests.ScienceModel"]</h2>
            <p>@_def.ModelName. @_def.ModelSource</p>
            <p>
                <a href="@_def.ModelUrl" target="_blank" rel="noopener noreferrer">
                    @Culture["Tests.MoreAboutModel"]
                    <span class="visually-hidden"> (@Culture["Common.OpensNewTab"])</span>
                </a>
            </p>
        </section>

        <div class="test-detail__choices">
            <a class="engagement-btn btn-outline-brand--split" href="@_def.FreeStartHref">
                <span>@Culture["Tests.StartFree"]</span>
                <span class="btn-outline-brand__meta">@Culture.Format("Tests.FreeMeta", _def.FreeQuestionCount)</span>
            </a>
            @if (_paymentMode != "unavailable")
            {
                <button type="button"
                        class="btn-gold btn-gold--split"
                        disabled="@_busy"
                        @onclick="GoToOfferAsync">
                    <span>@Culture["Tests.ExtendedLabel"]</span>
                    <span class="btn-gold__meta">@Culture.Format("Tests.ExtendedMeta", _def.DeepQuestionCount, FormatPrice(_priceEuro))</span>
                </button>
            }
        </div>
        @if (_paymentMode == "mollie")
        {
            <p class="test-detail__secure muted">
                <span aria-hidden="true">🔒</span>
                @Culture["DeepPay.SecureMollie"]
            </p>
        }
        else if (_paymentMode == "stub")
        {
            <p class="test-detail__secure muted">@Culture["DeepPay.StubHint"]</p>
        }
        else if (_paymentMode == "unavailable")
        {
            <p class="test-detail__secure muted">@Culture["DeepPay.Err.payments_unavailable"]</p>
        }
    }
</div>

@code {
    [Parameter] public string? TestKey { get; set; }
    [SupplyParameterFromQuery] public string? PaymentError { get; set; }
    [SupplyParameterFromQuery] public string? Buy { get; set; }

    private const string PersistKeyPrefix = "candidateTestDetail:";
    private bool _loading = true;
    private bool _busy;
    private AssessmentTestDefinition? _def;
    private bool _freeDone;
    private bool _deepUnlocked;
    private bool _deepCompleted;
    private decimal _priceEuro = 2.99m;
    private string? _payError;
    private string _paymentMode = "unavailable";
    private string? _headline;
    private string? _headlineLead;
    private string? _completedMeta;
    private readonly List<ScoreBar> _scoreBars = [];
    private readonly List<ScoreBar> _personalityBars = [];
    private CareerCompassModel? _careerCompass;
    private RiasecScoreSet? _riasecScores;
    private CompetencyScoreSet? _competencyScores;
    private DeepAnalysisState? _deepState;
    private CompetenceDeepReport? _competenceReport;
    private CareerDeepReport? _careerReport;
    private CultureDeepReport? _cultureReport;
    private ValuesDeepReport? _valuesReport;
    private bool _heavyLoadStarted;
    private PersistingComponentStateSubscription _persistSubscription;
    private AssessmentAdjustmentState _adjustments = new() { Remaining = AssessmentAdjustmentRules.MaxAdjustments, Max = AssessmentAdjustmentRules.MaxAdjustments };
    private List<AssessmentHistoryItem> _history = [];
    private bool _redoOpen;
    private bool _editModeEnabled;
    private bool _samplePdfEnabled;
    private bool _samplePdfOpen;
    private bool _samplePdfLoading;
    private int _samplePdfTotalPages;
    private IReadOnlyList<string> _samplePdfPages = Array.Empty<string>();

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        var key = PersistKeyPrefix + (TestKey ?? "");
        if (Persist.TryTakeFromJson<TestDetailPersistState>(key, out var saved)
            && saved is not null
            && string.Equals(saved.TestKey, TestKey, StringComparison.OrdinalIgnoreCase))
        {
            // Slim DTO only — never restore CareerCompass / DeepState / reports
            // (those blew past 100 KB HTML + hundreds of KB on the SignalR uplink).
            _freeDone = saved.FreeDone;
            _deepUnlocked = saved.DeepUnlocked;
            _deepCompleted = saved.DeepCompleted;
            _priceEuro = saved.PriceEuro > 0 ? saved.PriceEuro : _priceEuro;
            _loading = true;
        }
    }

    private Task PersistState()
    {
        if (_def is null)
        {
            return Task.CompletedTask;
        }

        Persist.PersistAsJson(PersistKeyPrefix + (TestKey ?? ""), new TestDetailPersistState
        {
            TestKey = TestKey,
            FreeDone = _freeDone,
            DeepUnlocked = _deepUnlocked,
            DeepCompleted = _deepCompleted,
            PriceEuro = _priceEuro
        });
        return Task.CompletedTask;
    }

    public void Dispose()
        => _persistSubscription.Dispose();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(PaymentError))
        {
            _payError = Culture["Tests.PaymentFailed"];
        }

        _def = AssessmentTestCatalog.TryGetByKey(TestKey);
        _paymentMode = await Api.GetDeepAnalysisPaymentModeAsync();
        if (string.Equals(Buy, "1", StringComparison.Ordinal))
        {
            await GoToOfferAsync();
        }
        if (_def is null)
        {
            _loading = false;
        }

        // Heavy report/career payloads load after the circuit is interactive
        // (see OnAfterRenderAsync) so prerender HTML and StartCircuit stay small.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _heavyLoadStarted || _def is null || !RendererInfo.IsInteractive)
        {
            return;
        }

        _heavyLoadStarted = true;
        await LoadHeavyStateAsync();
    }

    private async Task LoadHeavyStateAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var deep = await Api.GetDeepAnalysisAsync(_def!.Key);
            _deepState = deep;
            _deepUnlocked = deep?.IsUnlocked == true;
            _deepCompleted = deep?.IsCompleted == true;
            _priceEuro = deep?.PriceEuro > 0 ? deep.PriceEuro : 2.99m;
            _competenceReport = deep?.CompetenceReport;
            _careerReport = deep?.CareerReport;
            _cultureReport = deep?.CultureReport;
            _valuesReport = deep?.ValuesReport;
            _editModeEnabled = FeatureOptions.Value.TestEditMode;
            _samplePdfEnabled = FeatureOptions.Value.SamplePdf;

            var variant = _deepCompleted ? "deep" : "quick";
            _adjustments = await Api.GetAssessmentAdjustmentsAsync(_def.Key, variant)
                           ?? new AssessmentAdjustmentState
                           {
                               Remaining = AssessmentAdjustmentRules.MaxAdjustments,
                               Max = AssessmentAdjustmentRules.MaxAdjustments
                           };
            _history = (await Api.GetAssessmentHistoryAsync(_def.Key, variant)).ToList();

            _headline = null;
            _headlineLead = null;
            _completedMeta = null;
            _scoreBars.Clear();
            _personalityBars.Clear();
            _careerCompass = null;
            _riasecScores = null;
            _competencyScores = null;

            switch (_def.Kind)
            {
                case AssessmentKind.Competence:
                    await LoadCompetenceAsync();
                    break;
                case AssessmentKind.Career:
                    await LoadCareerAsync();
                    break;
                case AssessmentKind.Culture:
                    await LoadCultureAsync();
                    break;
                case AssessmentKind.Values:
                    await LoadValuesAsync();
                    break;
            }
        }
        catch (Exception)
        {
            // Keep any payment query error; surface load failures without wiping completed results.
            _payError ??= Culture["Common.Error"];
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Circuit-persist payload — flags only (&lt; 1 KB). Heavy models reload after interactivity.
    /// </summary>
    internal sealed class TestDetailPersistState
    {
        public string? TestKey { get; set; }
        public bool FreeDone { get; set; }
        public bool DeepUnlocked { get; set; }
        public bool DeepCompleted { get; set; }
        public decimal PriceEuro { get; set; }
    }

    private async Task LoadCompetenceAsync()
    {
        var state = await Api.GetMyCompetenciesAsync();
        _freeDone = IsCompleted(state?.Status);
        var scores = state?.Scores;
        if (scores is null)
        {
            return;
        }

        _headline = AssessmentOutcomeLines.Competence(
            scores.Samenwerken, scores.Resultaatgerichtheid, scores.Stressbestendigheid,
            scores.Innovatie, scores.Extraversie);
        AddBar("Samenwerken", scores.Samenwerken);
        AddBar("Resultaatgerichtheid", scores.Resultaatgerichtheid);
        AddBar("Stressbestendigheid", scores.Stressbestendigheid);
        AddBar("Innovatie", scores.Innovatie);
        AddBar("Extraversie", scores.Extraversie);
        _completedMeta = FormatCompleted(state?.CompletedAtUtc, _deepCompleted);
    }

    private async Task LoadCareerAsync()
    {
        var state = await Api.GetMyCareerInterestsAsync();
        _freeDone = IsCompleted(state?.Status);
        _careerCompass = state?.Compass;
        _riasecScores = state?.Scores;

        try
        {
            var competencies = await Api.GetMyCompetenciesAsync();
            _competencyScores = competencies?.Scores;
        }
        catch
        {
            // Optional for RoleFit insight inside CareerCompassPanel.
        }

        var scores = state?.Scores;
        if (scores is null)
        {
            return;
        }

        var topCodes = RiasecRanking.TopCodes(
            scores.Realistic, scores.Investigative, scores.Artistic,
            scores.Social, scores.Enterprising, scores.Conventional);
        _headline = topCodes.Count == 0
            ? null
            : topCodes.Count == 1
                ? $"{RiasecRanking.FormatTopEqualOrLabel(topCodes)} past het best"
                : RiasecRanking.FormatTopEqualOrLabel(topCodes);
        _headlineLead = Culture["Tests.CareerResultLead"];
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Social), scores.Social);
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Conventional), scores.Conventional);
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Enterprising), scores.Enterprising);
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Realistic), scores.Realistic);
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Investigative), scores.Investigative);
        AddBar(CareerCompassBuilder.TypeLabel(CareerTestCatalog.Artistic), scores.Artistic);
        _scoreBars.Sort((a, b) => b.Percent.CompareTo(a.Percent));
        _completedMeta = FormatCompleted(state?.CompletedAtUtc, _deepCompleted);
    }

    private async Task LoadCultureAsync()
    {
        var state = await Api.GetMyCultureAsync();
        _freeDone = IsCompleted(state?.Status);
        var scores = state?.Scores;
        if (scores is null)
        {
            return;
        }

        _headline = AssessmentOutcomeLines.Culture(
            scores.Autonomy, scores.Informal, scores.Collaboration,
            scores.Flexibility, scores.Innovation, scores.PeopleFirst);
        foreach (var code in CulturePersonalityCatalog.CultureDimensionCodes)
        {
            AddBar(CulturePersonalityCatalog.EverydayLabel(code), ScoreForCulture(scores, code));
        }

        foreach (var code in CulturePersonalityCatalog.PersonalityFacetCodes)
        {
            AddPersonalityBar(CulturePersonalityCatalog.EverydayLabel(code), ScoreForCulture(scores, code));
        }

        _scoreBars.Sort((a, b) => b.Percent.CompareTo(a.Percent));
        _personalityBars.Sort((a, b) => b.Percent.CompareTo(a.Percent));
        _completedMeta = FormatCompleted(state?.CompletedAtUtc, _deepCompleted);
    }

    private async Task LoadValuesAsync()
    {
        var state = await Api.GetMyValuesAsync();
        _freeDone = IsCompleted(state?.Status);
        var scores = state?.Scores;
        if (scores is null)
        {
            return;
        }

        _headline = AssessmentOutcomeLines.Values(
            scores.Autonomy, scores.Connection, scores.Achievement,
            scores.Stability, scores.Impact);
        AddBar(SchwartzValuesCatalog.EverydayLabel(SchwartzValuesCatalog.Autonomy), scores.Autonomy);
        AddBar(SchwartzValuesCatalog.EverydayLabel(SchwartzValuesCatalog.Connection), scores.Connection);
        AddBar(SchwartzValuesCatalog.EverydayLabel(SchwartzValuesCatalog.Achievement), scores.Achievement);
        AddBar(SchwartzValuesCatalog.EverydayLabel(SchwartzValuesCatalog.Stability), scores.Stability);
        AddBar(SchwartzValuesCatalog.EverydayLabel(SchwartzValuesCatalog.Impact), scores.Impact);
        _scoreBars.Sort((a, b) => b.Percent.CompareTo(a.Percent));
        _completedMeta = FormatCompleted(state?.CompletedAtUtc, _deepCompleted);
    }

    private void AddBar(string label, int? percent)
    {
        if (percent is int p)
        {
            _scoreBars.Add(new ScoreBar(FormatBarLabel(label), p));
        }
    }

    private void AddPersonalityBar(string label, int? percent)
    {
        if (percent is int p)
        {
            _personalityBars.Add(new ScoreBar(FormatBarLabel(label), p));
        }
    }

    private static string FormatBarLabel(string label)
        => string.IsNullOrWhiteSpace(label)
            ? label
            : char.ToUpperInvariant(label[0]) + label[1..];

    private static int? ScoreForCulture(CulturePersonalityScoreSet scores, string code) => code switch
    {
        CulturePersonalityCatalog.Autonomy => scores.Autonomy,
        CulturePersonalityCatalog.Informal => scores.Informal,
        CulturePersonalityCatalog.Collaboration => scores.Collaboration,
        CulturePersonalityCatalog.Flexibility => scores.Flexibility,
        CulturePersonalityCatalog.Innovation => scores.Innovation,
        CulturePersonalityCatalog.PeopleFirst => scores.PeopleFirst,
        CulturePersonalityCatalog.Openness => scores.Openness,
        CulturePersonalityCatalog.Conscientiousness => scores.Conscientiousness,
        CulturePersonalityCatalog.Extraversion => scores.Extraversion,
        CulturePersonalityCatalog.Agreeableness => scores.Agreeableness,
        CulturePersonalityCatalog.EmotionalStability => scores.EmotionalStability,
        _ => null
    };

    private string FormatCompleted(DateTime? completedAtUtc, bool deep)
    {
        var date = completedAtUtc is DateTime dt
            ? dt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.GetCultureInfo("nl-NL"))
            : null;
        var scan = deep ? Culture["Tests.ScanExtended"] : Culture["Tests.ScanQuick"];
        return string.IsNullOrWhiteSpace(date) ? scan : $"{date} · {scan}";
    }

    private static bool IsCompleted(string? status)
        => string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase);

    private static string FormatPrice(decimal euro)
        => euro.ToString("0.00", CultureInfo.GetCultureInfo("nl-NL"));

    private void ClearPayError() => _payError = null;

    private Task BeginEditAsync()
    {
        _redoOpen = false;
        if (!_editModeEnabled || _def is null)
        {
            _payError = Culture["TestResult.Edit.FlagOff"];
            return Task.CompletedTask;
        }

        if (_adjustments.Remaining <= 0)
        {
            _payError = Culture["TestResult.Limit.Dialog"];
            return Task.CompletedTask;
        }

        var href = _deepCompleted
            ? $"/candidate/deep-analysis/{_def.Key}?mode=edit"
            : $"{_def.FreeStartHref}?mode=edit";
        Navigation.NavigateTo(href);
        return Task.CompletedTask;
    }

    private async Task ConfirmRetakeAsync()
    {
        if (_def is null)
        {
            return;
        }

        _busy = true;
        _payError = null;
        try
        {
            var variant = _deepCompleted ? "deep" : "quick";
            await Api.StartAssessmentRetakeAsync(_def.Key, variant);
            _redoOpen = false;
            Navigation.NavigateTo(_deepCompleted ? _def.DeepStartHref : _def.FreeStartHref);
        }
        catch (AssessmentAdjustmentLimitClientException)
        {
            _payError = Culture["TestResult.Limit.Dialog"];
            _adjustments = new AssessmentAdjustmentState { Used = AssessmentAdjustmentRules.MaxAdjustments, Remaining = 0, Max = AssessmentAdjustmentRules.MaxAdjustments };
            _redoOpen = false;
        }
        catch (Exception)
        {
            _payError = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private Task<Models.DeepAnalysisCheckout> StartDeepAnalysisCheckoutAsync(bool waiverAccepted)
        => Api.StartDeepAnalysisCheckoutAsync(_def!.Key, waiverAccepted, Culture.Language);

    private async Task GoToOfferAsync()
    {
        if (_def is null)
        {
            return;
        }

        _paymentMode = await Api.GetDeepAnalysisPaymentModeAsync();
        if (_paymentMode == "unavailable" && !_deepUnlocked)
        {
            _payError = Culture["DeepPay.Err.payments_unavailable"];
            return;
        }

        Navigation.NavigateTo(_def.DeepStartHref);
    }

    private Task StartExtendedAsync() => GoToOfferAsync();

    private async Task DownloadPdfAsync()
    {
        if (_def is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.DownloadDeepAnalysisReportAsync(Js, _def.Key, Culture.Language);
        }
        catch (Exception)
        {
            _payError = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenSamplePdfAsync()
    {
        if (_def is null)
        {
            return;
        }

        _samplePdfOpen = true;
        _samplePdfLoading = true;
        _samplePdfPages = Array.Empty<string>();
        _payError = null;
        try
        {
            var preview = await Api.GetSampleAssessmentReportPreviewAsync(_def.Key, Culture.Language);
            if (preview is null || preview.PagePngBase64.Count == 0)
            {
                // Fallback: open/download the PDF directly when image export is unavailable.
                await Api.DownloadSampleAssessmentReportAsync(Js, _def.Key, Culture.Language);
                _samplePdfOpen = false;
                return;
            }

            _samplePdfPages = preview.PagePngBase64;
            _samplePdfTotalPages = preview.TotalPages > 0
                ? preview.TotalPages
                : DeepReportCapabilities.For(_def.Kind).PdfPageCount;
        }
        catch (Exception)
        {
            _payError = Culture["Common.Error"];
            _samplePdfOpen = false;
        }
        finally
        {
            _samplePdfLoading = false;
        }
    }

    private void CloseSamplePdf()
    {
        _samplePdfOpen = false;
        _samplePdfLoading = false;
    }

    private async Task DownloadSamplePdfAsync()
    {
        if (_def is null)
