@page "/candidate/career"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject PersistentComponentState Persist
@implements IAsyncDisposable

<PageTitle>@Culture["Career.Title"] · Lobsy</PageTitle>

<QuestionnaireShell Title="@Culture["Career.Title"]"
                    Subtitle="@Subtitle"
                    BackHref="/candidate/profile"
                    PrivacyNote="@Culture["Competency.PrivacyNote"]"
                    PrivacyHref="/privacy"
                    AnsweredCount="@AnsweredCount"
                    TotalCount="@CareerTestCatalog.QuestionCount"
                    SaveStatus="@(_autosave?.Status ?? QuestionnaireSaveStatus.Saved)"
                    Loading="_loading"
                    LoadFailed="_loadFailed"
                    ErrorMessage="@_message"
                    ReloadHref="/candidate/career"
                    Message="@_banner"
                    Completing="_completing"
                    ScrollToQuestionId="_focus.ScrollToId"
                    SmoothScroll="_focus.SmoothScroll"
                    ScrollRequestVersion="_focus.ScrollRequestVersion"
                    OnComplete="CompleteAsync"
                    OnNext="GoNextAsync"
                    OnRetrySave="RetrySaveAsync">
    <QuestionnairePageBody Categories="@CategoryGroups"
                           Answers="_answers"
                           CurrentId="_focus.CurrentId"
                           DimmedId="_focus.DimmedId"
                           ExpandedId="_focus.ExpandedId"
                           InputPrefix="cq"
                           OnAnswer="OnAnswerAsync"
                           OnExpand="ExpandQuestion" />
</QuestionnaireShell>

@if (_matches.Count > 0 && !_loading && !_loadFailed && AnsweredCount >= CareerTestCatalog.QuestionCount)
{
    <article class="detail-card questionnaire-matches">
        <CompetencyMatchPanel Items="_matches" Loading="false" />
    </article>
}

@code {
    private const string PersistKey = "candidateCareerTest";
    private bool _loading = true;
    private bool _loadFailed;
    private bool _completing;
    private bool _restored;
    private string? _message;
    private string? _banner;
    private readonly Dictionary<int, int> _answers = [];
    private readonly QuestionnaireFocus _focus = new();
    private List<CompetencyQuestionItem> _questions = [];
    private List<CandidateMatchedVacancy> _matches = [];
    private QuestionnaireAutosave? _autosave;
    private PersistingComponentStateSubscription _persistSubscription;

    private int AnsweredCount => _answers.Count;

    private IReadOnlyList<QuestionnaireCategoryGroup> CategoryGroups
        => BuildCategoryGroups();

    private string? Subtitle
    {
        get
        {
            if (_focus.CurrentId is null)
            {
                return null;
            }

            var cat = QuestionsFlat().FirstOrDefault(q => q.Id == _focus.CurrentId)?.Category;
            if (string.IsNullOrEmpty(cat))
            {
                return null;
            }

            var inCat = QuestionsFor(cat);
            var done = inCat.Count(q => _answers.ContainsKey(q.Id));
            return Culture.Format("Questionnaire.CategoryProgress", Culture[$"Career.Cat.{cat}"], done, inCat.Count);
        }
    }

    protected override void OnInitialized()
    {
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<CandidateCareerInterestState>(PersistKey, out var saved) && saved is not null)
        {
            ApplyState(saved);
            _restored = true;
            _loading = false;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, new CandidateCareerInterestState
        {
            Questions = _questions,
            Answers = _answers.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value),
            TopVacancies = _matches
        });
        return Task.CompletedTask;
    }

    private void ApplyState(CandidateCareerInterestState state)
    {
        _questions = state.Questions ?? [];
        _matches = state.TopVacancies ?? [];
        _answers.Clear();
        foreach (var (key, value) in state.Answers ?? [])
        {
            if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
            {
                _answers[id] = value;
            }
        }

        _focus.Initialize(OrderedIds(), _answers);
    }

    protected override async Task OnInitializedAsync()
    {
        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                var saved = await Api.SaveMyCareerInterestsAsync(answers, complete: false, ct);
                _matches = saved.TopVacancies ?? [];
            },
            onChanged: () => InvokeAsync(StateHasChanged));

        if (_restored)
        {
            _autosave.ReplaceAll(_answers);
            return;
        }

        try
        {
            var state = await Api.GetMyCareerInterestsAsync();
            if (state is not null)
            {
                ApplyState(state);
            }
            else
            {
                _focus.Initialize(OrderedIds(), _answers);
            }

            _autosave.ReplaceAll(_answers);
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = Culture["Common.Error"];
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<QuestionnaireCategoryGroup> BuildCategoryGroups()
        => CareerTestCatalog.RiasecCodes
            .Select(category =>
            {
                var questions = QuestionsFor(category);
                var letterPrefix = CareerTestCatalog.HollandLetter.TryGetValue(category, out var letter)
                    ? $"{letter} — "
                    : null;
                var label = $"{letterPrefix}{Culture[$"Career.Cat.{category}"]}";
                return new QuestionnaireCategoryGroup
                {
                    Key = category,
                    Label = label,
                    Questions = questions
                        .Select(q => new QuestionnaireQuestion
                        {
                            Id = q.Id,
                            Text = $"{q.Id}. {Culture[q.TextKey]}",
                            CategoryKey = category,
                            CategoryLabel = label
                        })
                        .ToList()
                };
            })
            .ToList();

    private IReadOnlyList<CompetencyQuestionItem> QuestionsFor(string category)
    {
        var list = _questions.Count > 0
            ? _questions.Where(q => q.Category == category).OrderBy(q => q.Id).ToList()
            : CareerTestCatalog.Questions
                .Where(q => q.Category == category)
                .Select(q => new CompetencyQuestionItem { Id = q.Id, Category = q.Category, Reverse = q.Reverse, TextKey = q.TextKey })
                .ToList();
        return list;
    }

    private IEnumerable<CompetencyQuestionItem> QuestionsFlat()
        => CareerTestCatalog.RiasecCodes.SelectMany(QuestionsFor);

    private IReadOnlyList<int> OrderedIds()
        => QuestionsFlat().Select(q => q.Id).ToList();

    private async Task OnAnswerAsync((int Id, int Value) answer)
    {
        var (id, value) = answer;
        _answers[id] = value;
        _banner = null;
        _focus.AfterAnswer(id, OrderedIds(), _answers);
        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch (Exception ex)
        {
            _banner = Culture["Common.Error"];
        }
    }

    private void ExpandQuestion(int id)
        => _focus.Expand(id, OrderedIds(), _answers);

    private Task GoNextAsync()
    {
        _focus.GoNext(OrderedIds(), _answers);
        return Task.CompletedTask;
    }

    private async Task RetrySaveAsync()
    {
        if (_autosave is null)
        {
            return;
        }

        try
        {
            await _autosave.RetryAsync();
            _banner = null;
        }
        catch (Exception ex)
        {
            _banner = Culture["Common.Error"];
        }
    }

    private async Task CompleteAsync()
    {
        if (_loadFailed || AnsweredCount < CareerTestCatalog.QuestionCount)
        {
            return;
        }

        _completing = true;
        _banner = null;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            var saved = await Api.SaveMyCareerInterestsAsync(_answers, complete: true);
            _matches = saved.TopVacancies ?? [];
            Navigation.NavigateTo("/candidate/profile");
        }
        catch (Exception ex)
        {
            _banner = Culture["Common.Error"];
        }
        finally
        {
            _completing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _persistSubscription.Dispose();
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }
}
