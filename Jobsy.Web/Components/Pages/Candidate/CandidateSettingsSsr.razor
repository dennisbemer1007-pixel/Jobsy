@page "/candidate/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Jobsy.Web.Settings
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["CandidateSettings.Title"] · Lobsy</PageTitle>
<HeadContent>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/candidate-settings.js")}")" defer></script>
</HeadContent>

@if (_loading)
{
    <PageContentSkeleton Variant="apps" CardCount="1" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    private bool _loading = true;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            http.Response.Headers.CacheControl = "no-store";

            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("pane", out var paneValues);
            query.TryGetValue("saved", out var savedValues);
            var saved = string.Equals(savedValues.FirstOrDefault(), "1", StringComparison.Ordinal);

            var data = await SettingsSsrData.LoadAsync(
                Api,
                FeatureFlags,
                paneValues.FirstOrDefault(),
                saved,
                http.RequestAborted);

            var tokens = Antiforgery.GetAndStoreTokens(http);
            _bodyHtml = SettingsSsrShells.BuildBody(
                Culture,
                data,
                tokens.FormFieldName,
                tokens.RequestToken ?? "");
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
