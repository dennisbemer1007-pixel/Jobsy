@page "/candidate/ontdekkingsreis"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [RequiresFeature(PlatformFeature.CandidatePassport, FallbackPath = "/candidate/start")]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Discovery
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject DiscoveryOverviewCache OverviewCache
@inject DiscoverySsrDepthStore DepthStore
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["Discovery.PageTitle"] · Lobsy</PageTitle>


@if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            return;
        }

        http.Response.Headers.CacheControl = "no-store";

        var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
        query.TryGetValue("stap", out var stapValues);
        query.TryGetValue("diepte", out var diepteValues);
        query.TryGetValue("fase", out var faseValues);
        query.TryGetValue("q", out var qValues);
        query.TryGetValue("error", out var errorValues);

        var bootstrap = await DiscoverySsrData.LoadBootstrapAsync(Api, http.RequestAborted);
        if (bootstrap is null)
        {
            _bodyHtml = DiscoverySsrShells.BuildPage(
                Culture,
                "",
                "error",
                null,
                null,
                null,
                Culture["Common.Error.TryAgain"]);
            return;
        }

        var redirectUrl = await DiscoverySsrRedirect.TryGetRedirectUrlAsync(
            http.Request,
            Api,
            FeatureFlags,
            Culture,
            OverviewCache,
            bootstrap.State,
            bootstrap.Draft,
            stapValues.FirstOrDefault(),
            faseValues.FirstOrDefault(),
            diepteValues.FirstOrDefault(),
            http.RequestAborted);

        if (!string.IsNullOrEmpty(redirectUrl)
            && !DiscoverySsrRedirect.IsSameLocation(http.Request, redirectUrl))
        {
            http.Response.StatusCode = StatusCodes.Status303SeeOther;
            http.Response.Headers.Location = redirectUrl;
            return;
        }

        var userId = http.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        var tokens = Antiforgery.GetAndStoreTokens(http);
        var token = tokens.RequestToken ?? "";

        var load = await DiscoverySsrData.LoadAsync(
            Api,
            FeatureFlags,
            Culture,
            OverviewCache,
            DepthStore,
            userId,
            bootstrap,
            stapValues.FirstOrDefault(),
            diepteValues.FirstOrDefault(),
            faseValues.FirstOrDefault(),
            qValues.FirstOrDefault(),
            errorValues.FirstOrDefault(),
            http.RequestAborted);

        if (string.Equals(load.Screen, "redirect-start", StringComparison.OrdinalIgnoreCase))
        {
            http.Response.StatusCode = StatusCodes.Status303SeeOther;
            http.Response.Headers.Location = DiscoverySsrUrls.Overview();
            return;
        }

        _bodyHtml = DiscoverySsrShells.BuildPage(
            Culture,
            token,
            load.Screen,
            load.Overview,
            load.Shed,
            load.Test,
            load.ErrorMessage);
    }
}
