@page "/candidate/deep-analysis"
@page "/candidate/deep-analysis/{Kind}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using System.Globalization
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Components.Shared.Questionnaire
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IFeatureFlags FeatureFlags
@implements IAsyncDisposable

<PageTitle>@(_kindOk ? Culture[_titleKey] : Culture["Deep.UnknownTitle"]) · Lobsy</PageTitle>

@if (_loading)
{
    <div class="test-page journey-page"><div class="test-skeleton" aria-busy="true"><span class="skeleton-line skeleton-line--title"></span></div></div>
}
else if (!_kindOk)
{
    <div class="test-page journey-page">
        <div class="test-shell__card">
            <h1 tabindex="-1">@Culture["Deep.UnknownTitle"]</h1>
            <p class="test-shell__lead">@Culture["Deep.UnknownLead"]</p>
            <p><a class="engagement-btn" href="/profiel">@Culture["DeepPay.ToMyTests"]</a></p>
        </div>
    </div>
}
else if (_loadFailed)
{
    <div class="test-page"><p>@Culture["Common.Error"]</p><a href="@($"/candidate/deep-analysis/{_slug}")">@Culture["Common.Retry"]</a></div>
}
else
{
    <TestConsentGate GateChanged="OnGateChanged">
        @if (_gateOpen)
        {
            @if (_view == View.Offer)
            {
                <TestPageShell Kind="_kind"
                               Mode="TestPageShell.ShellMode.Offer"
                               Deep="true"
                               Eyebrow="@Culture["Deep.Offer.Eyebrow"]"
                               H1="@Culture["Deep.Offer.Title"]"
                               Lead="@Culture.Format("Deep.Offer.Lead", _questionCount, Culture[_titleKey])"
                               TestName="@Culture[_titleKey]"
                               Answered="0"
                               TargetCount="_questionCount"
                               BubbleText="@Culture["Deep.Offer.Bubble"]">
                    <RailContent>@RenderRail(offer: true)</RailContent>
                    <ChildContent>
                        <section class="deep-offer">
                            <h2 class="visually-hidden">@Culture["Deep.Offer.WhatTitle"]</h2>
                            <ul class="deep-offer__get">
                                <li>✓ @Culture["DeepPay.Get.1"]</li>
                                <li>✓ @Culture["DeepPay.Get.2"]</li>
                                <li>✓ @(_employersOn ? Culture["DeepPay.Get.3"] : Culture["CareerStep.Band.EyebrowOff"])</li>
                                <li>✓ @Culture["DeepPay.Get.4"]</li>
                            </ul>
                            <p>
                                <button type="button" class="btn-link" disabled="@_saving" @onclick="OpenSampleAsync">
                                    @Culture["Deep.Offer.Sample"]
                                </button>
                            </p>
                            <div class="deep-offer__tiles">
                                <div>
                                    <strong>@Culture.Format("Deep.Offer.TileMin", TestDepthRules.MinutesFor(_kind, TestDepthLevel.Bottom))</strong>
                                    <span>@Culture["Deep.Offer.TileParts"]</span>
                                </div>
                                <div>
                                    <strong>@Culture["Deep.Offer.TileFreeKeep"]</strong>
                                    <span>@Culture.Format("Deep.Offer.TileFreeKeepLead", TestDepthRules.FullCount(_kind))</span>
                                </div>
                            </div>
                            @if (_paymentMode == DeepTestFinanceRules.TestUnlockMethod)
                            {
                                <p class="deep-offer__price">
                                    <strong>@Culture["DeepPay.TestAccountFree"]</strong>
                                </p>
                                <p class="muted">@Culture["DeepPay.TestAccountNote"]</p>
                            }
                            else
                            {
                                <div class="deep-offer__price">
                                    <strong>€ @_priceLabel</strong>
                                    <span>@Culture["DeepPay.PriceOnce"]</span>
                                </div>
                                <p class="muted">
                                    @Culture["DeepPay.Methods"]:
                                    @string.Join(" · ", MolliePaymentMethods.PrimaryMethods.Select(MolliePaymentMethods.DisplayName))
                                </p>
                                @if (_paymentMode == "mollie")
                                {
                                    <p class="muted">@Culture["DeepPay.SecureMollie"]</p>
                                }
                                else if (_paymentMode == "stub")
                                {
                                    <p class="muted">@Culture["DeepPay.StubHint"]</p>
                                }
                            }
                            @if (_paymentMode != DeepTestFinanceRules.TestUnlockMethod)
                            {
                                <label class="deep-pay-waiver">
                                    <input type="checkbox" @bind="_waiverAccepted" />
                                    @Culture["Terms.Waiver.Checkbox"]
                                </label>
                                <p class="muted deep-pay-waiver__link">
                                    <a href="/gebruiksvoorwaarden#bedenktijd">@Culture["DeepPay.WaiverReadMore"]</a>
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(_orderErrorKey))
                            {
                                <p class="state-message error" role="alert">@Culture[_orderErrorKey]</p>
                            }
                            <footer class="test-shell__footer">
                                <a href="@($"/profiel/tests/{_slug}")">@Culture["DeepPay.NotNow"]</a>
                                <button type="button"
                                        class="engagement-btn"
                                        disabled="@((NeedsWaiver && !_waiverAccepted) || _saving || _paymentMode == "unavailable")"
                                        @onclick="ConfirmOrderAsync">
                                    @(_paymentMode == DeepTestFinanceRules.TestUnlockMethod
                                        ? Culture["DeepPay.TestAccountCta"]
                                        : Culture.Format("DeepPay.PayCta", _priceLabel))
                                </button>
                            </footer>
                        </section>
                    </ChildContent>
                </TestPageShell>
            }
            else if (_view == View.Done)
            {
                <TestPageShell Kind="_kind"
                               Mode="TestPageShell.ShellMode.Done"
                               Deep="true"
                               Eyebrow="@Culture.Format("Deep.Done.Eyebrow", _questionCount, _questionCount)"
                               H1="@Culture["TestDone.Title"]"
                               DoneLead="@Culture["Deep.Done.Lead"]"
                               TestName="@Culture[_titleKey]"
                               LevelName="@Culture["TestDepth.Bottom"]"
                               Answered="_questionCount"
                               TargetCount="_questionCount"
                               BubbleText="@Culture["Deep.Done.Bubble"]">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <footer class="test-shell__footer">
                            <a href="@($"/profiel/tests/{_slug}")">@Culture["Deep.Done.DownloadPdf"]</a>
                            <a class="engagement-btn" href="@($"/profiel/tests/{_slug}")">@Culture["Deep.Done.ViewReport"]</a>
                        </footer>
                    </ChildContent>
                </TestPageShell>
            }
            else if (_view == View.Pause && _pausePart is TestDepthPart pausePart)
            {
                var next = _parts.FirstOrDefault(p => p.Index == pausePart.Index + 1);
                <TestPageShell Kind="_kind"
                               Mode="TestPageShell.ShellMode.Pause"
                               Deep="true"
                               Eyebrow="@Culture.Format("Deep.Eyebrow.Part", Culture[_titleKey], pausePart.Index)"
                               H1="@Culture["Deep.Pause.Title"]"
                               Lead="@Culture.Format("Deep.Pause.Lead", pausePart.Index, _answered, _questionCount)"
                               TestName="@Culture[_titleKey]"
                               Answered="_answered"
                               TargetCount="_questionCount"
                               BubbleText="@Culture["Deep.Pause.Bubble"]">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <div class="deep-pause" aria-live="polite">
                            <p>@Culture.Format("Deep.Pause.Live", pausePart.Index)</p>
                            @if (next is not null)
                            {
                                <p class="deep-pause__next">@DeepTestMotivation.PartDisplayName(_kind, next)</p>
                            }
                        </div>
                        <footer class="test-shell__footer">
                            <a href="@($"/profiel/tests/{_slug}")" @onclick="FlushLaterAsync" @onclick:preventDefault>@Culture["TestFlow.Later"]</a>
                            <button type="button" class="engagement-btn" @onclick="ContinueAfterPause">
                                @Culture.Format("Deep.Pause.Continue", pausePart.Index + 1)
                            </button>
                        </footer>
                    </ChildContent>
                </TestPageShell>
            }
            else if (_view == View.Question && _autosave is not null)
            {
                var part = CurrentPart;
                var partName = part is null ? "" : DeepTestMotivation.PartDisplayName(_kind, part);
                var motivationKey = part is null
                    ? null
                    : DeepTestMotivation.ForProgress(_kind, _answered, _questionCount, part.Index);
                <TestPageShell Kind="_kind"
                               Mode="TestPageShell.ShellMode.Question"
                               Deep="true"
                               Eyebrow="@ChromeEyebrow(part)"
                               H1="@partName"
                               Lead="@Culture["TestFlow.QuestionLead"]"
                               TestName="@Culture[_titleKey]"
                               LevelName="@Culture["TestDepth.Bottom"]"
                               Answered="_answered"
                               TargetCount="_questionCount"
                               BubbleText="@Culture["Deep.Bubble.Question"]">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <ol class="deep-topic-chips" aria-label="@Culture["Deep.TopicsLabel"]">
                            @foreach (var chip in _parts)
                            {
                                var done = PartAnswered(chip);
                                var status = done >= chip.Size ? "done" : (chip.Index == part?.Index ? "now" : "todo");
                                <li class="deep-topic-chips__item deep-topic-chips__item--@status">
                                    <span>@DeepTestMotivation.PartDisplayName(_kind, chip)</span>
                                    <small>@done/@chip.Size</small>
                                </li>
                            }
                        </ol>
                        @if (!string.IsNullOrWhiteSpace(motivationKey) && ShouldShowMotivation(motivationKey, part!.Index))
                        {
                            <p class="deep-motivation" data-cue="@motivationKey">
                                @FormatMotivation(motivationKey, part)
                            </p>
                        }
                        <p class="test-page__save" aria-live="polite">@_liveSave</p>
                        <TestQuestionFlow Kind="_kind"
                                          Questions="_flowQuestions"
                                          Answers="_autosave.Answers"
                                          Target="TestDepthLevel.Bottom"
                                          Autosave="_autosave"
                                          Compact="false"
                                          InputPrefix="@($"d{_slug}")"
                                          ShouldPauseAfterIndex="ShouldPauseAfter"
                                          OnPauseAfter="OnPauseAfterAsync"
                                          OnFinished="OnFinishedAsync"
                                          OnLater="LaterAsync"
                                          OnChanged="OnFlowChanged" />
                    </ChildContent>
                </TestPageShell>
            }
        }
    </TestConsentGate>
}

@code {
    private enum View { Offer, Question, Pause, Done }

    [Parameter] public string? Kind { get; set; }

    private bool _loading = true;
    private bool _loadFailed;
    private bool _kindOk;
    private bool _gateOpen;
    private bool _saving;
    private bool _waiverAccepted;
    private bool _employersOn = true;
    private string? _orderErrorKey;
    private string _paymentMode = "unavailable";
    private string _slug = "competence";
    private string _titleKey = "Deep.CompetenceTitle";
    private AssessmentKind _kind = AssessmentKind.Competence;
    private View _view = View.Offer;
    private int _questionCount = 150;
    private int _answered;
    private decimal _priceEuro = 2.99m;
    private string _priceLabel = "2,99";
    private string? _liveSave;
    private DeepAnalysisState? _state;
    private QuestionnaireAutosave? _autosave;
    private List<TestQuestionFlow.FlowQuestion> _flowQuestions = [];
    private IReadOnlyList<TestDepthPart> _parts = [];
    private TestDepthPart? _pausePart;
    private int _resumeIndex;
    private readonly HashSet<string> _shownCues = [];
    private QuestionnaireSaveStatus _lastAnnounced = QuestionnaireSaveStatus.Idle;

    private bool NeedsWaiver => _paymentMode != DeepTestFinanceRules.TestUnlockMethod;

    private string ChromeEyebrow(TestDepthPart? part)
    {
        var index = part?.Index ?? 1;
        var size = part?.Size ?? 1;
        var inPart = part is null ? 1 : Math.Clamp(PartAnswered(part) + 1, 1, size);
        return Culture.Format("Deep.Chrome", index, Math.Max(1, _parts.Count), inPart, size);
    }

    private TestDepthPart? CurrentPart
    {
        get
        {
            if (_parts.Count == 0) return null;
            return _parts.FirstOrDefault(p => PartAnswered(p) < p.Size) ?? _parts[^1];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Kind))
        {
            Navigation.NavigateTo("/candidate/deep-analysis/competence", replace: true);
            return;
        }

        if (!AssessmentKindLabels.TryParse(Kind, out _kind))
        {
            _kindOk = false;
            _loading = false;
            return;
        }

        _kindOk = true;
        _slug = AssessmentKindLabels.ToSlug(_kind);
        if (!string.Equals(Kind, _slug, StringComparison.Ordinal))
        {
            Navigation.NavigateTo($"/candidate/deep-analysis/{_slug}", replace: true);
            return;
        }
        _titleKey = _slug switch
        {
            "career" => "Deep.CareerTitle",
            "values" => "Deep.ValuesTitle",
            "culture" => "Deep.CultureTitle",
            _ => "Deep.CompetenceTitle"
        };
        _parts = TestDepthRules.Parts(_kind);
        _questionCount = TestDepthRules.Bottom(_kind);

        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                _state = await Api.SaveDeepAnalysisAsync(_slug, answers, complete: false, ct);
            },
            onChanged: () => InvokeAsync(StateHasChanged));

        try
        {
            try
            {
                _employersOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.Employers);
            }
            catch
            {
                _employersOn = true;
            }

            _paymentMode = await Api.GetDeepAnalysisPaymentModeAsync();
            _state = await Api.GetDeepAnalysisAsync(_slug);
            _priceEuro = _state?.PriceEuro > 0 ? _state.PriceEuro : _priceEuro;
            _priceLabel = _priceEuro.ToString("0.00", CultureInfo.GetCultureInfo("nl-NL"));
            _questionCount = _state?.QuestionCount > 0 ? _state.QuestionCount : _questionCount;

            var answers = new Dictionary<int, int>();
            if (_state?.Answers is not null)
            {
                foreach (var (key, value) in _state.Answers)
                {
                    if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
                    {
                        answers[id] = value;
                    }
                }
            }

            _autosave.ReplaceAll(answers);
            _answered = answers.Count;

            var ordered = DeepAnalysisScreenOrder.For(_kind);
            // Prefer Parts order for question ids.
            var partOrder = _parts.SelectMany(p => p.QuestionIds).ToList();
            var byId = ordered.ToDictionary(q => q.Id);
            _flowQuestions = partOrder
                .Where(byId.ContainsKey)
                .Select(id =>
                {
                    var q = byId[id];
                    var lang = Culture.Language;
                    return new TestQuestionFlow.FlowQuestion(
                        q.Id,
                        q.Prompt(lang),
                        q.Example(lang));
                })
                .ToList();

            if (_state is { IsCompleted: true })
            {
                _view = View.Done;
            }
            else if (_state is not { IsUnlocked: true })
            {
                _view = View.Offer;
            }
            else
            {
                _view = View.Question;
            }
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnGateChanged(bool open) => _gateOpen = open;

    private int PartAnswered(TestDepthPart part)
    {
        if (_autosave is null) return 0;
        return part.QuestionIds.Count(id => _autosave.Answers.ContainsKey(id));
    }

    private bool ShouldPauseAfter(int index)
    {
        // Pause after completing the last question of parts 1–4.
        var answeredAfter = index + 1; // 1-based count if sequential from start
        // Prefer answer-count based pause when autosave count matches part boundary.
        if (_autosave is not null && DeepTestMotivation.IsPausePoint(_kind, _autosave.AnsweredCount))
        {
            return true;
        }

        var running = 0;
        for (var i = 0; i < _parts.Count - 1; i++)
        {
            running += _parts[i].Size;
            if (index + 1 == running)
            {
                return true;
            }
        }

        return false;
    }

    private Task OnPauseAfterAsync(int index)
    {
        var partIndex = DeepTestMotivation.PartIndexForGlobalIndex(_kind, index);
        _pausePart = _parts.FirstOrDefault(p => p.Index == partIndex);
        _resumeIndex = index + 1;
        _answered = _autosave?.AnsweredCount ?? _answered;
        _view = View.Pause;
        return Task.CompletedTask;
    }

    private void ContinueAfterPause()
    {
        _view = View.Question;
        _pausePart = null;
    }

    private async Task OnFinishedAsync()
    {
        if (_autosave is null) return;
        try
        {
            await _autosave.FlushAsync();
            _state = await Api.SaveDeepAnalysisAsync(_slug, _autosave.Answers, complete: true);
            _answered = _questionCount;
            _view = View.Done;
        }
        catch (Exception)
        {
            _liveSave = Culture["Common.Error"];
        }
    }

    private async Task LaterAsync()
    {
        if (_autosave is not null) await _autosave.FlushAsync();
        Navigation.NavigateTo($"/profiel/tests/{_slug}");
    }

    private async Task FlushLaterAsync()
    {
        if (_autosave is not null) await _autosave.FlushAsync();
        Navigation.NavigateTo($"/profiel/tests/{_slug}");
    }

    private Task OnFlowChanged()
    {
        _answered = _autosave?.AnsweredCount ?? _answered;
        if (_autosave is not null && _autosave.Status != _lastAnnounced)
        {
            _lastAnnounced = _autosave.Status;
            _liveSave = _autosave.Status switch
            {
                QuestionnaireSaveStatus.Saved => Culture["TestFlow.Saved"],
                QuestionnaireSaveStatus.Failed => Culture["TestFlow.SaveFailed"],
                _ => _liveSave
            };
        }

        return Task.CompletedTask;
    }

    private bool ShouldShowMotivation(string key, int partIndex)
    {
        var token = $"{partIndex}:{key}";
        if (_shownCues.Contains(token)) return true; // keep visible while on this question
        _shownCues.Add(token);
        // Only one cue type per part (except Halfway which is global once).
        if (key != DeepTestMotivation.Halfway)
        {
            foreach (var existing in _shownCues.Where(c => c.StartsWith($"{partIndex}:", StringComparison.Ordinal)).ToList())
            {
                if (existing != token && !existing.EndsWith(DeepTestMotivation.Halfway, StringComparison.Ordinal))
                {
                    // keep first cue of part; still show current if it's BeforePause
                    if (key != DeepTestMotivation.BeforePause && existing.EndsWith(DeepTestMotivation.PartStart, StringComparison.Ordinal))
                    {
                        return false;
                    }
                }
            }
        }

        return true;
    }

    private string FormatMotivation(string key, TestDepthPart part)
    {
        var name = DeepTestMotivation.PartDisplayName(_kind, part);
        return key switch
        {
            DeepTestMotivation.PartStart => Culture.Format("Deep.Motivation.PartStart", part.Index, name),
            DeepTestMotivation.Halfway => Culture["Deep.Motivation.Halfway"],
            DeepTestMotivation.LastPart => Culture["Deep.Motivation.LastPart"],
            DeepTestMotivation.BeforePause => Culture["Deep.Motivation.BeforePause"],
            _ => ""
        };
    }

    private async Task OpenSampleAsync()
    {
        try
        {
            await Api.DownloadSampleAssessmentReportAsync(Js, _slug, Culture.Language);
        }
        catch (Exception)
        {
            _orderErrorKey = "Common.Error";
        }
    }

    private async Task ConfirmOrderAsync()
    {
        _saving = true;
        _orderErrorKey = null;
        try
        {
            var checkout = await Api.StartDeepAnalysisCheckoutAsync(_slug, _waiverAccepted, Culture.Language);
            Navigation.NavigateTo(
                checkout.CheckoutUrl,
                forceLoad: checkout.CheckoutUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase));
        }
        catch (DeepPayClientException ex)
        {
            _orderErrorKey = ex.Code switch
            {
                "waiver_required" => "DeepPay.Err.waiver_required",
                "already_unlocked" => "DeepPay.Err.already_unlocked",
                "payments_unavailable" => "DeepPay.Err.payments_unavailable",
                "consent_required" or "parental_consent_required" or "test_consent_required"
                    => "DeepPay.Err.consent_required",
                _ => "Common.Error"
            };
        }
        catch (Exception)
        {
            _orderErrorKey = "Common.Error";
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment RenderRail(bool offer = false) => __builder =>
    {
        var freeFull = TestDepthRules.FullCount(_kind);
        <div class="test-rail">
            @if (offer)
            {
                <p class="test-rail__free">
                    @Culture.Format("Deep.Rail.FreeDone", freeFull)
                </p>
            }
            <p class="test-rail__zone">@Culture["Deep.Rail.BottomZone"]</p>
            <ol class="test-rail__parts">
                @foreach (var p in _parts)
                {
                    var done = PartAnswered(p);
                    var status = offer ? "todo" : done >= p.Size ? "done" : (p.Index == CurrentPart?.Index ? "now" : "todo");
                    <li class="test-rail__part test-rail__part--@status">
                        <span>@DeepTestMotivation.PartDisplayName(_kind, p)</span>
                        @if (status == "now")
                        {
                                <small> · @Culture.Format("Deep.Rail.PartProgress", done + 1, p.Size)</small>
                        }
                    </li>
                }
            </ol>
            @if (!offer)
            {
                var left = Math.Max(0, _questionCount - _answered);
                var mins = Math.Max(1, (int)Math.Ceiling(left * 12 / 60.0));
                <p class="test-rail__footer">@Culture.Format("Deep.Rail.Footer", _answered, _questionCount, mins)</p>
            }
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }
}
