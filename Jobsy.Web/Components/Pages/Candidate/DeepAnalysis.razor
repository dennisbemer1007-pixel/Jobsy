@page "/candidate/deep-analysis"
@page "/candidate/deep-analysis/{Kind}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@Culture[_titleKey] · Lobsy</PageTitle>

<div class="panel-page profile-page profile-page--candidate competency-test-page deep-analysis-page">
    <header class="saved-gate__header profile-page__header">
        <h1>@Culture[_titleKey]</h1>
        <p class="login-lead">@_upsell</p>
    </header>

    <article class="detail-card">
        @if (_loading)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (_loadFailed)
        {
            <p class="state-message">@_message</p>
        }
        else if (_state is { IsUnlocked: false })
        {
            <p class="login-lead">@_upsell</p>
            <button class="login-submit" type="button" disabled="@_saving" @onclick="StartCheckoutAsync">
                @Culture["Competency.DeepUnlock"]
            </button>
            <a class="engagement-btn" href="/candidate/profile">@Culture["Competency.BackToProfile"]</a>
        }
        else if (_state is { IsCompleted: true })
        {
            <p class="login-lead">@Culture["Deep.Completed"]</p>
            <button class="login-submit" type="button" disabled="@_saving" @onclick="DownloadPdfAsync">
                @Culture["Deep.DownloadPdf"]
            </button>
            <a class="engagement-btn" href="/candidate/profile">@Culture["Competency.BackToProfile"]</a>
        }
        else
        {
            <div class="deep-analysis-chrome" aria-label="@Culture["Deep.ChromeLabel"]">
                <div class="deep-analysis-chrome__progress">
                    <p class="competency-test__progress" aria-live="polite">
                        @Culture.Format("Deep.ProgressPercent", ProgressPercent)
                        <span class="muted">· @Culture.Format("Competency.Progress", AnsweredCount, QuestionCount)</span>
                    </p>
                    <div class="competency-test__meter"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-valuenow="@ProgressPercent"
                         aria-label="@Culture.Format("Deep.ProgressPercent", ProgressPercent)">
                        <span style="width: @(ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                    </div>
                </div>
                <ol class="deep-analysis-topics" aria-label="@Culture["Deep.TopicsLabel"]">
                    @foreach (var topic in Topics)
                    {
                        <li class="deep-analysis-topics__item deep-analysis-topics__item--@topic.Status"
                            title="@topic.Label">
                            @if (topic.Status == "done")
                            {
                                <span class="deep-analysis-topics__check" aria-hidden="true">✓</span>
                            }
                            else if (topic.Status == "current")
                            {
                                <span class="deep-analysis-topics__dot" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span class="deep-analysis-topics__soon" aria-hidden="true">·</span>
                            }
                            <span class="deep-analysis-topics__label">@topic.Label</span>
                            <span class="visually-hidden">
                                @topic.Label — @Culture[$"Deep.Topic.{topic.Status}"] (@topic.Done/@topic.Total)
                            </span>
                        </li>
                    }
                </ol>
            </div>

            @foreach (var group in QuestionGroups)
            {
                var domainLabel = group.FirstOrDefault()?.DomainLabel;
                if (string.IsNullOrWhiteSpace(domainLabel))
                {
                    domainLabel = DeepAnalysisQuestionHelp.DomainLabel(group.Key);
                }
                <fieldset class="competency-test__cat" id="@($"deep-topic-{Slug(group.Key)}")">
                    <legend>@domainLabel</legend>
                    @foreach (var question in group)
                    {
                        <div class="competency-question">
                            <div class="competency-question__head">
                                <p class="competency-question__text">@question.Id. @question.PromptNl</p>
                                <button type="button"
                                        class="competency-help deep-analysis-info"
                                        title="@Culture["Deep.InfoTitle"]"
                                        aria-label="@Culture.Format("Deep.InfoAria", question.Id)"
                                        @onclick="() => OpenExample(question)">
                                    ?
                                </button>
                            </div>
                            <div class="competency-likert" role="radiogroup" aria-label="@question.PromptNl">
                                @for (var value = 1; value <= 5; value++)
                                {
                                    var current = value;
                                    var id = $"d{_slug}{question.Id}-{current}";
                                    <label class="competency-likert__opt @(_answers.TryGetValue(question.Id, out var selected) && selected == current ? "is-on" : null)">
                                        <input type="radio"
                                               name="@($"d{question.Id}")"
                                               id="@id"
                                               value="@current"
                                               checked="@(_answers.TryGetValue(question.Id, out var v) && v == current)"
                                               @onchange="() => SetAnswer(question.Id, current)" />
                                        <span>@Culture[$"Competency.Likert.{current}"]</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
            }

            <div class="profile-save-bar">
                <button class="engagement-btn" type="button" disabled="@_saving" @onclick="() => PersistAsync(false)">
                    @Culture["Competency.SaveDraft"]
                </button>
                <button class="login-submit" type="button" disabled="@(_saving || AnsweredCount < QuestionCount)" @onclick="() => PersistAsync(true)">
                    @Culture["Competency.Complete"]
                </button>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="state-message profile-save-bar__message">@_message</p>
                }
            </div>
        }
    </article>
</div>

@if (_exampleQuestion is not null)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="@Culture["Deep.InfoTitle"]"
                         TitleId="deep-example-title"
                         Lead="@Culture.Format("Deep.InfoLead", _exampleQuestion.Id)"
                         OnClose="CloseExample">
        <p>@_exampleQuestion.ExampleNl</p>
        <button class="login-submit" type="button" @onclick="CloseExample">@Culture["Common.Close"]</button>
    </LobsyFriendlyDialog>
}

@if (_boosterMilestone is int boosterAt)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Mood="LobsyDialogMood.Celebrate"
                         Title="@DeepAnalysisBoosters.TitleFor(boosterAt)"
                         TitleId="deep-booster-title"
                         Lead="@DeepAnalysisBoosters.TryMessage(boosterAt, QuestionCount)"
                         OnClose="CloseBooster">
        <button class="login-submit" type="button" @onclick="CloseBooster">@Culture["Deep.BoosterContinue"]</button>
    </LobsyFriendlyDialog>
}

@code {
    [Parameter] public string? Kind { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _loadFailed;
    private string? _message;
    private string _upsell = "";
    private string _slug = "competence";
    private string _titleKey = "Deep.CompetenceTitle";
    private DeepAnalysisState? _state;
    private readonly Dictionary<int, int> _answers = [];
    private readonly HashSet<int> _seenBoosters = [];
    private DeepAnalysisQuestionItem? _exampleQuestion;
    private int? _boosterMilestone;

    private int AnsweredCount => _answers.Count;
    private int QuestionCount => _state?.QuestionCount ?? DeepAnalysisCatalog.QuestionCount;
    private int ProgressPercent => QuestionCount <= 0
        ? 0
        : (int)Math.Clamp(Math.Round(100.0 * AnsweredCount / QuestionCount), 0, 100);

    private IEnumerable<IGrouping<string, DeepAnalysisQuestionItem>> QuestionGroups =>
        (_state?.Questions ?? []).GroupBy(q => q.Domain);

    private IReadOnlyList<TopicChip> Topics
    {
        get
        {
            var groups = (_state?.Questions ?? [])
                .GroupBy(q => q.Domain, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var chips = new List<TopicChip>(groups.Count);
            var foundCurrent = false;
            foreach (var group in groups)
            {
                var total = group.Count();
                var done = group.Count(q => _answers.ContainsKey(q.Id));
                string status;
                if (done >= total)
                {
                    status = "done";
                }
                else if (!foundCurrent)
                {
                    status = "current";
                    foundCurrent = true;
                }
                else
                {
                    status = "upcoming";
                }

                var label = group.FirstOrDefault()?.DomainLabel;
                if (string.IsNullOrWhiteSpace(label))
                {
                    label = DeepAnalysisQuestionHelp.DomainLabel(group.Key);
                }

                chips.Add(new TopicChip(label, status, done, total));
            }

            return chips;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _slug = AssessmentKindLabels.ToSlug(AssessmentKindLabels.ParseOrDefault(Kind));
        _titleKey = _slug switch
        {
            "career" => "Deep.CareerTitle",
            "values" => "Deep.ValuesTitle",
            "disc" or "culture" => "Deep.CultureTitle",
            _ => "Deep.CompetenceTitle"
        };
        try
        {
            _state = await Api.GetDeepAnalysisAsync(_slug);
            _upsell = _state?.UpsellCopy ?? "";
            _answers.Clear();
            if (_state?.Answers is not null)
            {
                foreach (var (key, value) in _state.Answers)
                {
                    if (int.TryParse(key, out var id))
                    {
                        _answers[id] = value;
                    }
                }
            }

            foreach (var milestone in DeepAnalysisBoosters.Milestones)
            {
                if (AnsweredCount >= milestone)
                {
                    _seenBoosters.Add(milestone);
                }
            }
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetAnswer(int id, int value)
    {
        var before = AnsweredCount;
        var wasNew = !_answers.ContainsKey(id);
        _answers[id] = value;
        if (!wasNew)
        {
            return;
        }

        var after = AnsweredCount;
        foreach (var milestone in DeepAnalysisBoosters.Milestones)
        {
            if (before < milestone && after >= milestone && _seenBoosters.Add(milestone))
            {
                _boosterMilestone = milestone;
                break;
            }
        }
    }

    private void OpenExample(DeepAnalysisQuestionItem question) => _exampleQuestion = question;

    private void CloseExample() => _exampleQuestion = null;

    private void CloseBooster() => _boosterMilestone = null;

    private static string Slug(string value)
        => string.Concat((value ?? "").Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private async Task StartCheckoutAsync()
    {
        _saving = true;
        try
        {
            var checkout = await Api.StartDeepAnalysisCheckoutAsync(_slug);
            Navigation.NavigateTo(checkout.CheckoutUrl);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            await Api.DownloadDeepAnalysisReportAsync(Js, _slug);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PersistAsync(bool complete)
    {
        _saving = true;
        _message = null;
        try
        {
            _state = await Api.SaveDeepAnalysisAsync(_slug, _answers, complete);
            _message = complete ? Culture["Deep.SavedComplete"] : Culture["Competency.SavedDraft"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record TopicChip(string Label, string Status, int Done, int Total);
}
