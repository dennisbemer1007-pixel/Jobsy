@page "/candidate/deep-analysis"
@page "/candidate/deep-analysis/{Kind}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@Culture[_titleKey] · Lobsy</PageTitle>

@if (_loading)
{
    <div class="questionnaire">
        <p class="state-message">@Culture["Common.Loading"]</p>
    </div>
}
else if (_loadFailed)
{
    <div class="questionnaire">
        <p class="state-message">@_message</p>
        <a class="questionnaire__close" href="/candidate/profile" aria-label="@Culture["Questionnaire.BackAria"]">×</a>
    </div>
}
else if (_state is { IsUnlocked: false })
{
    <div class="questionnaire questionnaire--upsell">
        <header class="questionnaire__header">
            <div class="questionnaire__top">
                <a class="questionnaire__close" href="/candidate/profile" aria-label="@Culture["Questionnaire.BackAria"]">
                    <span aria-hidden="true">×</span>
                </a>
                <div class="questionnaire__titles">
                    <h1 class="questionnaire__title">@Culture[_titleKey]</h1>
                </div>
            </div>
        </header>
        <div class="questionnaire__body">
            <p class="login-lead">@_upsell</p>
            <button class="login-submit" type="button" disabled="@_saving" @onclick="StartCheckoutAsync">
                @Culture["Competency.DeepUnlock"]
            </button>
        </div>
    </div>
}
else if (_state is { IsCompleted: true } completedState)
{
    <div class="questionnaire questionnaire--report">
        <header class="questionnaire__header">
            <div class="questionnaire__top">
                <a class="questionnaire__close" href="/candidate/profile" aria-label="@Culture["Questionnaire.BackAria"]">
                    <span aria-hidden="true">×</span>
                </a>
                <div class="questionnaire__titles">
                    <h1 class="questionnaire__title">@Culture[_titleKey]</h1>
                </div>
            </div>
        </header>
        <div class="questionnaire__body">
            @if (_slug == "competence" && completedState.CompetenceReport is not null)
            {
                <CompetenceDeepReportView Report="completedState.CompetenceReport"
                                          CompletedAtUtc="@completedState.CompletedAtUtc"
                                          QuestionCount="@completedState.QuestionCount"
                                          Busy="_saving"
                                          OnDownloadPdf="DownloadPdfAsync" />
            }
            else
            {
                <p class="login-lead">@Culture["Deep.Completed"]</p>
                <button class="login-submit" type="button" disabled="@_saving" @onclick="DownloadPdfAsync">
                    @Culture["Deep.DownloadPdf"]
                </button>
            }
        </div>
    </div>
}
else
{
    <QuestionnaireShell Title="@Culture[_titleKey]"
                        Subtitle="@Subtitle"
                        BackHref="/candidate/profile"
                        AnsweredCount="@AnsweredCount"
                        TotalCount="@QuestionCount"
                        SaveStatus="@(_autosave?.Status ?? QuestionnaireSaveStatus.Saved)"
                        Loading="false"
                        LoadFailed="false"
                        Message="@_banner"
                        Completing="_completing"
                        ScrollToQuestionId="_scrollToId"
                        SmoothScroll="_smoothScroll"
                        CssClass="questionnaire--deep"
                        OnComplete="CompleteAsync"
                        OnRetrySave="RetrySaveAsync">
        <HeaderExtra>
            <div class="deep-analysis-chrome deep-analysis-chrome--compact" aria-label="@Culture["Deep.ChromeLabel"]">
                <ol class="deep-analysis-topics" aria-label="@Culture["Deep.TopicsLabel"]">
                    @foreach (var topic in Topics)
                    {
                        <li class="deep-analysis-topics__item deep-analysis-topics__item--@topic.Status"
                            title="@topic.Label">
                            @if (topic.Status == "done")
                            {
                                <span class="deep-analysis-topics__check" aria-hidden="true">✓</span>
                            }
                            else if (topic.Status == "current")
                            {
                                <span class="deep-analysis-topics__dot" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span class="deep-analysis-topics__soon" aria-hidden="true">·</span>
                            }
                            <span class="deep-analysis-topics__label">@topic.Label</span>
                            <span class="visually-hidden">
                                @topic.Label — @Culture[$"Deep.Topic.{topic.Status}"] (@topic.Done/@topic.Total)
                            </span>
                        </li>
                    }
                </ol>
            </div>
        </HeaderExtra>

        <ChildContent>
        @foreach (var group in QuestionGroups)
        {
            var domainLabel = group.FirstOrDefault()?.DomainLabel;
            if (string.IsNullOrWhiteSpace(domainLabel))
            {
                domainLabel = DeepAnalysisQuestionHelp.DomainLabel(group.Key);
            }
            <section class="questionnaire-section" id="@($"deep-topic-{Slug(group.Key)}")" aria-labelledby="@($"deep-legend-{Slug(group.Key)}")">
                <h2 class="questionnaire-section__label" id="@($"deep-legend-{Slug(group.Key)}")">@domainLabel</h2>
                @foreach (var question in group)
                {
                    var answered = _answers.ContainsKey(question.Id);
                    var q = question;
                    <LikertScaleQuestion QuestionId="question.Id"
                                         Text="@($"{question.Id}. {question.PromptNl}")"
                                         Value="@(answered ? _answers[question.Id] : null)"
                                         IsAnswered="answered"
                                         IsCurrent="_currentId == question.Id"
                                         InputPrefix="@($"d{_slug}")"
                                         ValueChanged="value => OnAnswerAsync(q.Id, value)">
                        <Extra>
                            <button type="button"
                                    class="q-likert__example"
                                    aria-label="@Culture.Format("Deep.InfoAria", question.Id)"
                                    @onclick="() => OpenExample(q)">
                                @Culture["Questionnaire.ExampleLink"]
                            </button>
                        </Extra>
                    </LikertScaleQuestion>
                }
            </section>
        }
        </ChildContent>
    </QuestionnaireShell>
}

@if (_exampleQuestion is not null)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="@Culture["Deep.InfoTitle"]"
                         TitleId="deep-example-title"
                         Lead="@Culture.Format("Deep.InfoLead", _exampleQuestion.Id)"
                         OnClose="CloseExample">
        <p>@_exampleQuestion.ExampleNl</p>
        <button class="login-submit" type="button" @onclick="CloseExample">@Culture["Common.Close"]</button>
    </LobsyFriendlyDialog>
}

@if (_boosterMilestone is int boosterAt)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Mood="LobsyDialogMood.Celebrate"
                         Title="@DeepAnalysisBoosters.TitleFor(boosterAt)"
                         TitleId="deep-booster-title"
                         Lead="@DeepAnalysisBoosters.TryMessage(boosterAt, QuestionCount)"
                         OnClose="CloseBooster">
        <button class="login-submit" type="button" @onclick="CloseBooster">@Culture["Deep.BoosterContinue"]</button>
    </LobsyFriendlyDialog>
}

@code {
    [Parameter] public string? Kind { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _completing;
    private bool _loadFailed;
    private bool _smoothScroll;
    private string? _message;
    private string? _banner;
    private string _upsell = "";
    private string _slug = "competence";
    private string _titleKey = "Deep.CompetenceTitle";
    private DeepAnalysisState? _state;
    private readonly Dictionary<int, int> _answers = [];
    private readonly HashSet<int> _seenBoosters = [];
    private DeepAnalysisQuestionItem? _exampleQuestion;
    private int? _boosterMilestone;
    private int? _currentId;
    private int? _scrollToId;
    private QuestionnaireAutosave? _autosave;

    private int AnsweredCount => _answers.Count;
    private int QuestionCount => _state?.QuestionCount ?? DeepAnalysisCatalog.QuestionCount;

    private string? Subtitle
    {
        get
        {
            if (_currentId is null || _state?.Questions is null)
            {
                return null;
            }

            var current = _state.Questions.FirstOrDefault(q => q.Id == _currentId);
            if (current is null)
            {
                return null;
            }

            var label = current.DomainLabel;
            if (string.IsNullOrWhiteSpace(label))
            {
                label = DeepAnalysisQuestionHelp.DomainLabel(current.Domain);
            }

            var inDomain = _state.Questions.Where(q => q.Domain == current.Domain).ToList();
            var done = inDomain.Count(q => _answers.ContainsKey(q.Id));
            return Culture.Format("Questionnaire.CategoryProgress", label, done, inDomain.Count);
        }
    }

    private IEnumerable<IGrouping<string, DeepAnalysisQuestionItem>> QuestionGroups =>
        (_state?.Questions ?? []).GroupBy(q => q.Domain);

    private IReadOnlyList<TopicChip> Topics
    {
        get
        {
            var groups = (_state?.Questions ?? [])
                .GroupBy(q => q.Domain, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var chips = new List<TopicChip>(groups.Count);
            var foundCurrent = false;
            foreach (var group in groups)
            {
                var total = group.Count();
                var done = group.Count(q => _answers.ContainsKey(q.Id));
                string status;
                if (done >= total)
                {
                    status = "done";
                }
                else if (!foundCurrent)
                {
                    status = "current";
                    foundCurrent = true;
                }
                else
                {
                    status = "upcoming";
                }

                var label = group.FirstOrDefault()?.DomainLabel;
                if (string.IsNullOrWhiteSpace(label))
                {
                    label = DeepAnalysisQuestionHelp.DomainLabel(group.Key);
                }

                chips.Add(new TopicChip(label, status, done, total));
            }

            return chips;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _slug = AssessmentKindLabels.ToSlug(AssessmentKindLabels.ParseOrDefault(Kind));
        _titleKey = _slug switch
        {
            "career" => "Deep.CareerTitle",
            "values" => "Deep.ValuesTitle",
            "disc" or "culture" => "Deep.CultureTitle",
            _ => "Deep.CompetenceTitle"
        };

        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                _state = await Api.SaveDeepAnalysisAsync(_slug, answers, complete: false, ct);
            },
            onChanged: () => InvokeAsync(StateHasChanged));

        try
        {
            _state = await Api.GetDeepAnalysisAsync(_slug);
            _upsell = _state?.UpsellCopy ?? "";
            _answers.Clear();
            if (_state?.Answers is not null)
            {
                foreach (var (key, value) in _state.Answers)
                {
                    if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
                    {
                        _answers[id] = value;
                    }
                }
            }

            _autosave.ReplaceAll(_answers);

            foreach (var milestone in DeepAnalysisBoosters.Milestones)
            {
                if (AnsweredCount >= milestone)
                {
                    _seenBoosters.Add(milestone);
                }
            }

            if (_state is { IsUnlocked: true, IsCompleted: false })
            {
                _currentId = FirstUnanswered() ?? (_state.Questions?.LastOrDefault()?.Id);
                _scrollToId = _currentId;
                _smoothScroll = false;
            }
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private int? FirstUnanswered()
    {
        foreach (var q in _state?.Questions ?? [])
        {
            if (!_answers.ContainsKey(q.Id))
            {
                return q.Id;
            }
        }

        return null;
    }

    private int? NextUnansweredAfter(int answeredId)
    {
        var list = (_state?.Questions ?? []).ToList();
        var index = list.FindIndex(q => q.Id == answeredId);
        for (var i = index + 1; i < list.Count; i++)
        {
            if (!_answers.ContainsKey(list[i].Id))
            {
                return list[i].Id;
            }
        }

        return FirstUnanswered();
    }

    private async Task OnAnswerAsync(int id, int value)
    {
        var before = AnsweredCount;
        var wasNew = !_answers.ContainsKey(id);
        _answers[id] = value;
        _banner = null;
        _currentId = NextUnansweredAfter(id) ?? id;
        _scrollToId = _currentId;
        _smoothScroll = true;

        if (wasNew)
        {
            var after = AnsweredCount;
            foreach (var milestone in DeepAnalysisBoosters.Milestones)
            {
                if (before < milestone && after >= milestone && _seenBoosters.Add(milestone))
                {
                    _boosterMilestone = milestone;
                    break;
                }
            }
        }

        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private void OpenExample(DeepAnalysisQuestionItem question) => _exampleQuestion = question;

    private void CloseExample() => _exampleQuestion = null;

    private void CloseBooster() => _boosterMilestone = null;

    private static string Slug(string value)
        => string.Concat((value ?? "").Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private async Task StartCheckoutAsync()
    {
        _saving = true;
        try
        {
            var checkout = await Api.StartDeepAnalysisCheckoutAsync(_slug);
            Navigation.NavigateTo(checkout.CheckoutUrl);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        _saving = true;
        _banner = null;
        try
        {
            await Api.DownloadDeepAnalysisReportAsync(Js, _slug);
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RetrySaveAsync()
    {
        if (_autosave is null)
        {
            return;
        }

        try
        {
            await _autosave.RetryAsync();
            _banner = null;
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private async Task CompleteAsync()
    {
        if (AnsweredCount < QuestionCount)
        {
            return;
        }

        _completing = true;
        _banner = null;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            _state = await Api.SaveDeepAnalysisAsync(_slug, _answers, complete: true);
            _banner = Culture["Deep.SavedComplete"];
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
        finally
        {
            _completing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }

    private sealed record TopicChip(string Label, string Status, int Done, int Total);
}
