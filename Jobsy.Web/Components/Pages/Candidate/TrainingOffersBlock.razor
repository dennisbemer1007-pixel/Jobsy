@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture

@if (_offers.Count == 0 && string.IsNullOrWhiteSpace(_message))
{
    return;
}

<section class="training-offers training-offers--subtle @(Compact ? "training-offers--compact" : null)"
         aria-label="@Culture[string.IsNullOrWhiteSpace(TitleKey) ? "Fit.TrainingTitle" : TitleKey]">
    @if (!Compact)
    {
        <p class="training-offers__lead muted">@Culture["Fit.TrainingLead"]</p>
    }
    else
    {
        <p class="training-offers__lead muted">@Culture[string.IsNullOrWhiteSpace(TitleKey) ? "Fit.TrainingTitle" : TitleKey]</p>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="state-message">@_message</p>
    }
    <ul class="training-offers__list">
        @foreach (var offer in _offers)
        {
            <li class="training-offers__item">
                <p class="training-offers__advice muted">@offer.Advice</p>
                <p class="training-offers__meta">
                    <button class="training-offers__link" type="button" disabled="@_busy" @onclick="() => OpenAsync(offer)">
                        @offer.Title
                    </button>
                    <span class="muted">@offer.ProviderName</span>
                    @if (!string.IsNullOrWhiteSpace(offer.Region))
                    {
                        <span class="muted">· @offer.Region</span>
                    }
                </p>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter] public IReadOnlyList<TrainingOfferCard>? Offers { get; set; }
    [Parameter] public string? JobTitle { get; set; }
    [Parameter] public string Campaign { get; set; } = "functie_fit";
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? TitleKey { get; set; }

    private List<TrainingOfferCard> _offers = [];
    private bool _busy;
    private string? _message;
    private string? _lastFetchKey;

    protected override async Task OnParametersSetAsync()
    {
        if (Offers is { Count: > 0 })
        {
            _offers = Offers.ToList();
            _lastFetchKey = null;
            return;
        }

        var key = $"{JobTitle ?? ""}|{Campaign ?? ""}";
        if (string.Equals(key, _lastFetchKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastFetchKey = key;
        _offers = await Api.GetTrainingOffersAsync(JobTitle, Campaign ?? "functie_fit");
    }

    private async Task OpenAsync(TrainingOfferCard offer)
    {
        _busy = true;
        _message = null;
        try
        {
            var tracked = await Api.TrackTrainingOfferAsync(offer.OfferId, Campaign);
            if (string.IsNullOrWhiteSpace(tracked.Url)
                || tracked.Url.Contains('@', StringComparison.Ordinal)
                || !TrainingDeepLinkRules.IsCourseDeepLink(tracked.Url))
            {
                _message = Culture["Common.Error"];
                return;
            }

            Navigation.NavigateTo(tracked.Url, forceLoad: true);
        }
        catch (Exception ex)
        {
            _message = string.IsNullOrWhiteSpace(ex.Message) ? Culture["Common.Error"] : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
