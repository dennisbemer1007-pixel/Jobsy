@using Jobsy.Web.Localization
@inject CultureState Culture

@if (Compass is null)
{
    return;
}

@if (Compass.Strengths.Count > 0)
{
    <p class="login-lead">@Culture["Kompas.CareerStrengths"]: @string.Join(" · ", Compass.Strengths)</p>
}

@if (Compass.HasOccupations)
{
    <div class="kompas-occupations" aria-label="@Culture["Kompas.Career"]">
        @if (Compass.SuperMatches.Count > 0)
        {
            <section class="kompas-band kompas-band--super">
                <h4>@Culture["Kompas.BandSuper"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in Compass.SuperMatches)
                    {
                        <li class="kompas-occupation">
                            <span class="kompas-occupation__title">@item.Title</span>
                            <span class="kompas-occupation__pct">@item.Percent%</span>
                            @if (!string.IsNullOrWhiteSpace(item.Why))
                            {
                                <span class="kompas-occupation__why">@item.Why</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (Compass.StrongChoices.Count > 0)
        {
            <section class="kompas-band kompas-band--strong">
                <h4>@Culture["Kompas.BandStrong"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in Compass.StrongChoices)
                    {
                        <li class="kompas-occupation">
                            <span class="kompas-occupation__title">@item.Title</span>
                            <span class="kompas-occupation__pct">@item.Percent%</span>
                            @if (!string.IsNullOrWhiteSpace(item.Why))
                            {
                                <span class="kompas-occupation__why">@item.Why</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (Compass.Broadening.Count > 0)
        {
            <section class="kompas-band kompas-band--broaden">
                <h4>@Culture["Kompas.BandBroaden"]</h4>
                <ul class="kompas-occupation-list">
                    @foreach (var item in Compass.Broadening)
                    {
                        <li class="kompas-occupation">
                            <span class="kompas-occupation__title">@item.Title</span>
                            <span class="kompas-occupation__pct">@item.Percent%</span>
                            @if (!string.IsNullOrWhiteSpace(item.Why))
                            {
                                <span class="kompas-occupation__why">@item.Why</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}

@if (Compass.PracticalNotes.Count > 0)
{
    <div class="kompas-practical">
        <h4>@Culture["Kompas.PracticalTitle"]</h4>
        @foreach (var note in Compass.PracticalNotes)
        {
            <p>@note</p>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Compass.SuperMatches.FirstOrDefault()?.Title)
     || !string.IsNullOrWhiteSpace(Compass.StrongChoices.FirstOrDefault()?.Title)
     || !string.IsNullOrWhiteSpace(Compass.Broadening.FirstOrDefault()?.Title))
{
    <TrainingOffersBlock JobTitle="@(Compass.SuperMatches.FirstOrDefault()?.Title ?? Compass.StrongChoices.FirstOrDefault()?.Title ?? Compass.Broadening.FirstOrDefault()?.Title)" Campaign="career_compass" />
}

@code {
    [Parameter] public CareerCompassModel? Compass { get; set; }
}
