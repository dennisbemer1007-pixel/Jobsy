@page "/candidate/profile"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.ProfileSections
@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IJSRuntime Js
@inject PersistentComponentState Persist
@inject Jobsy.Web.Services.ApiCallTracker ApiCalls
@inject Jobsy.Core.Features.IFeatureFlags FeatureFlags
@inject CandidateProfileEditor Editor
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Components.Shared
@implements IAsyncDisposable

<PageTitle>@Culture["Profile.Title"] · Lobsy</PageTitle>

<div class="panel-page profile-page profile-page--candidate">
    <header class="saved-gate__header profile-page__header">
        <h1>@Culture["Profile.Title"]</h1>
        @if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            <p class="login-lead">@Culture["Profile.ReturnHint"]</p>
        }
    </header>
        <CascadingValue Value="_kompasState">
        <CascadingValue Value="Editor">
        <CandidateKompas SharedKompas="_kompasState"
                         SharedDna="_dnaState"
                         TabChanged="OnKompasTabChangedAsync"
                         WideViewportChanged="OnKompasWideChanged">
            <ProfileTab>
        <p class="login-lead">@Culture["Profile.Lead"]</p>
        @if (string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            <p class="state-message" aria-live="polite">@Culture["Insights.Updating"]</p>
        }
        @if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            <p class="login-lead profile-return-hint">@Culture["Profile.ReturnHint"]</p>
        }

        @if (_loading)
        {
            <PageContentSkeleton Variant="profile" LoadingLabel="@Culture["Common.Loading"]" />
        }
        else
        {
            <div class="profile-form competency-profile-card">
                <nav class="profile-section-nav pill-scroller" aria-label="@Culture["Profile.Lead"]">
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("personal") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("personal") ? "true" : "false")"
                            aria-controls="profile-section-personal"
                            @onclick='() => ToggleSection("personal")'>@Culture["Profile.Section.Personal"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("preferences") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("preferences") ? "true" : "false")"
                            @onclick='() => ToggleSection("preferences")'>@Culture["Profile.Section.Preferences"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("availability") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("availability") ? "true" : "false")"
                            @onclick='() => ToggleSection("availability")'>@Culture["Profile.Section.Availability"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("experience") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("experience") ? "true" : "false")"
                            @onclick='() => ToggleSection("experience")'>@Culture["Profile.Section.Experience"]</button>
                </nav>
                <div class="profile-accordion">
                    <h2 class="visually-hidden" id="profile-section-personal-btn">@Culture["Profile.Section.Personal"]</h2>
                    @if (IsSectionOpen("personal"))
                    {
                        <div class="profile-accordion__body" id="profile-section-personal" role="region" aria-labelledby="profile-section-personal-btn">
                            <PersonalSection />
                            <DevicesSection />
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-preferences-btn">@Culture["Profile.Section.Preferences"]</h2>
                    @if (IsSectionOpen("preferences"))
                    {
                        <div class="profile-accordion__body" id="profile-section-preferences" role="region" aria-labelledby="profile-section-preferences-btn">
                            <PreferencesSection />
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-availability-btn">@Culture["Profile.Section.Availability"]</h2>
                    @if (IsSectionOpen("availability"))
                    {
                        <div class="profile-accordion__body" id="profile-section-availability" role="region" aria-labelledby="profile-section-availability-btn">
                            <AvailabilitySection />
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-experience-btn">@Culture["Profile.Section.Experience"]</h2>
                    @if (IsSectionOpen("experience"))
                    {
                        <div class="profile-accordion__body" id="profile-section-experience" role="region" aria-labelledby="profile-section-experience-btn">
                            <MotivationSection />
                            <CvSection />
                            <ExperienceSection />
                            <EducationSection />
                            <CertificatesSection />
                            <ReferencesSection />
                        </div>
                    }
                </div>

                <ProfileSaveBar />
            </div>
        }

        @if (!_loading)
        {
            <ConsentSection />
        }

        @* D18: with Werkgevers off there are no contact requests, so the link is hidden too. *@
        <FeatureVisible Feature="PlatformFeature.Employers">
            <section class="profile-contacts-mini" aria-labelledby="talent-contacts-title">
                <h2 id="talent-contacts-title" class="profile-page__title">@Culture["Talent.CandidateTitle"]</h2>
                <p class="login-lead">@Culture["Talent.CandidateLead"]</p>
                <a class="btn btn-primary" href="/candidate/talent-contacts">@Culture["Talent.CandidateOpen"]</a>
            </section>
        </FeatureVisible>

        @if (!_loading)
        {
            <DeleteAccountSection />
        }
            </ProfileTab>
            <Side>
                <FeatureVisible Feature="PlatformFeature.Employers">
                    <PanelErrorBoundary Name="matched-vacancies">
                        <div class="profile-layout__matches">
                            <div class="detail-card">
                                <CompetencyMatchPanel Items="_matchedVacancies" Loading="_matchesLoading" />
                            </div>
                        </div>
                    </PanelErrorBoundary>
                </FeatureVisible>
            </Side>
        </CandidateKompas>
        </CascadingValue>
        </CascadingValue>
</div>

<UnsubscribeDialog IsOpen="Editor.UnsubscribeOpen"
                   OnClose="Editor.CloseUnsubscribe"
                   OnCompleted="Editor.OnUnsubscribeCompleted" />


@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool _loading = true;
    private string? _returnUrl;
    private string _openSection = "personal";
    private bool _matchesLoading = true;
    private IReadOnlyList<CandidateMatchedVacancy> _matchedVacancies = [];
    private bool _isWideViewport;
    private string _insightsStatus = "Ready";
    private CandidateKompasState? _kompasState;
    private CandidateDnaSummary? _dnaState;
    private int _insightsRefreshAttempts;
    private CancellationTokenSource? _insightsCts;
    private CancellationTokenSource? _geocodeCts;
    private bool _kompasLoadStarted;
    private bool _pendingGeocode;
    private double? _pendingGeocodeLat;
    private double? _pendingGeocodeLng;
    private const string DnaPersistKey = "candidateProfileDna";
    private bool _restored;
    private PersistingComponentStateSubscription _persistSubscription;

    private bool IsSectionOpen(string id)
        => string.Equals(_openSection, id, StringComparison.Ordinal);

    private void ToggleSection(string id)
        => _openSection = id;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        Editor.Changed += OnEditorChanged;
        Editor.AfterSaveAsync = LoadMatchedVacanciesAsync;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<CandidateDnaSummary>(DnaPersistKey, out var dna) && dna is not null)
        {
            _dnaState = dna;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        if (_dnaState is not null)
        {
            Persist.PersistAsJson(DnaPersistKey, _dnaState);
        }

        return Task.CompletedTask;
    }

    private void OnEditorChanged()
        => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        ApiCalls.SetPath("/candidate/profile");
        _returnUrl = SanitizeReturnUrl(ReturnUrl);
        Editor.ReturnUrl = _returnUrl;

        try
        {
            var flags = await FeatureFlags.GetAsync();
            if (flags.CandidatePassportEnabled)
            {
                var target = PassportRedirects.TryToPassportUrl(Navigation.Uri);
                if (target is not null)
                {
                    Navigation.NavigateTo(target, replace: true);
                    return;
                }
            }
        }
        catch
        {
            // Fall through to classic profile on flag lookup failure.
        }

        try
        {
            if (_restored && _dnaState is not null)
            {
                await Editor.LoadMasterdataAsync();
                return;
            }

            var masterdataTask = Editor.LoadMasterdataAsync();
            var dnaTask = Api.GetMyKompasDnaResultAsync();
            await Task.WhenAll(masterdataTask, dnaTask);
            var dnaResult = await dnaTask;
            if (dnaResult.TemporarilyUnavailable)
            {
                Editor.Message = Culture["Panel.ErrorInline"];
                _matchedVacancies = [];
                return;
            }

            _dnaState = dnaResult.Value;
            if (_isWideViewport)
            {
                await LoadMatchedVacanciesAsync();
            }
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            Editor.Message = Culture["Panel.ErrorInline"];
            _matchedVacancies = [];
        }
        finally
        {
            _loading = false;
            _matchesLoading = false;
            ApiCalls.Flush("/candidate/profile");
        }
    }

    private async Task ApplyKompasAsync(CandidateKompasState? kompas, bool allowGeocode)
    {
        var profile = kompas?.Profile;
        if (profile is null)
        {
            Editor.Message = Culture["Profile.NotFound"];
            _matchesLoading = false;
            return;
        }

        Editor.ApplyFromProfile(profile);
        _insightsStatus = kompas?.InsightsStatus ?? "Ready";
        if (_isWideViewport && kompas?.TopMatches is { Count: > 0 } matches)
        {
            _matchedVacancies = matches;
            _matchesLoading = false;
        }
        else if (!_isWideViewport || string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _matchedVacancies = [];
            _matchesLoading = false;
        }

        if (_isWideViewport
            && _matchedVacancies.Count == 0
            && !string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase)
            && allowGeocode)
        {
            await LoadMatchedVacanciesAsync();
        }

        await InvokeAsync(StateHasChanged);
        if (string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _ = RefreshInsightsLaterAsync();
        }

        // Reverse-geocode only when the stored address is missing (not every open).
        var prefs = profile.Preferences ?? new CandidatePreferences();
        if (Editor.HomeLat is not null && Editor.HomeLng is not null)
        {
            if (!string.IsNullOrWhiteSpace(prefs.HomeAddress) && !CandidateProfileEditor.LooksLikeCoordinates(prefs.HomeAddress))
            {
                Editor.HomeAddress = prefs.HomeAddress!;
            }
            else if (string.IsNullOrWhiteSpace(prefs.HomeAddress) && allowGeocode)
            {
                Editor.HomeAddress = CandidateProfileEditor.FormatCoordinateFallback(Editor.HomeLat.Value, Editor.HomeLng.Value);
                _pendingGeocode = true;
                _pendingGeocodeLat = Editor.HomeLat;
                _pendingGeocodeLng = Editor.HomeLng;
            }
            else if (!string.IsNullOrWhiteSpace(prefs.HomeAddress))
            {
                Editor.HomeAddress = prefs.HomeAddress!;
            }
            else
            {
                Editor.HomeAddress = CandidateProfileEditor.FormatCoordinateFallback(Editor.HomeLat.Value, Editor.HomeLng.Value);
            }
        }
    }

    private async Task LoadMatchedVacanciesAsync()
    {
        _matchesLoading = true;
        try
        {
            _matchedVacancies = await Api.GetMyMatchedVacanciesAsync();
        }
        catch
        {
            _matchedVacancies = [];
        }
        finally
        {
            _matchesLoading = false;
        }
    }

    private async Task OnKompasTabChangedAsync(string tab)
    {
        if (string.Equals(CandidateKompasTabs.Normalize(tab), CandidateKompasTabs.Dna, StringComparison.Ordinal))
        {
            return;
        }

        if (_kompasState is not null || _kompasLoadStarted)
        {
            return;
        }

        _kompasLoadStarted = true;
        _loading = true;
        try
        {
            await EnsureFullKompasLoadedAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnsureFullKompasLoadedAsync()
    {
        var kompasResult = await Api.GetMyKompasResultAsync();
        if (kompasResult.TemporarilyUnavailable)
        {
            Editor.Message = Culture["Panel.ErrorInline"];
            return;
        }

        var kompas = kompasResult.Value;
        if (kompas is null)
        {
            Editor.Message = Culture["Profile.NotFound"];
            return;
        }

        _kompasState = kompas;
        await ApplyKompasAsync(kompas, allowGeocode: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingGeocode || _pendingGeocodeLat is null || _pendingGeocodeLng is null)
        {
            return;
        }

        var lat = _pendingGeocodeLat.Value;
        var lng = _pendingGeocodeLng.Value;
        _pendingGeocode = false;
        _geocodeCts?.Cancel();
        _geocodeCts?.Dispose();
        _geocodeCts = new CancellationTokenSource();
        var ct = _geocodeCts.Token;
        _ = ReverseGeocodeInBackgroundAsync(lat, lng, ct);
        await Task.CompletedTask;
    }

    private async Task ReverseGeocodeInBackgroundAsync(double lat, double lng, CancellationToken ct)
    {
        try
        {
            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
            timeout.CancelAfter(TimeSpan.FromSeconds(5));
            var label = await Geocoder.ReverseAsync(lat, lng, timeout.Token);
            if (string.IsNullOrWhiteSpace(label))
            {
                return;
            }

            Editor.HomeAddress = label;
            var prefs = new CandidatePreferences { HomeAddress = label };
            await Api.UpdateMyProfileAsync(preferences: prefs, ct: ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch
        {
            // keep coordinate fallback
        }
    }

    private async Task RefreshInsightsLaterAsync()
    {
        if (_insightsRefreshAttempts >= 1
            || !string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _insightsRefreshAttempts++;
        _insightsCts?.Cancel();
        _insightsCts?.Dispose();
        _insightsCts = new CancellationTokenSource();
        var ct = _insightsCts.Token;
        try
        {
            await Task.Delay(3000, ct);
            await LoadMatchedVacanciesAsync();
            if (_matchedVacancies.Count > 0)
            {
                _insightsStatus = "Ready";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
        }
        catch
        {
        }
    }

    private async Task OnKompasWideChanged(bool isWide)
    {
        if (_isWideViewport == isWide)
        {
            return;
        }

        _isWideViewport = isWide;
        if (!isWide)
        {
            _matchedVacancies = [];
            _matchesLoading = false;
            return;
        }

        if (_matchedVacancies.Count == 0
            && _kompasState?.TopMatches is { Count: > 0 } snapshot)
        {
            _matchedVacancies = snapshot;
            _matchesLoading = false;
        }
        else if (_matchedVacancies.Count == 0
                 && !string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            await LoadMatchedVacanciesAsync();
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private static string? SanitizeReturnUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        if (!raw.StartsWith('/') || raw.StartsWith("//", StringComparison.Ordinal))
        {
            return null;
        }

        if (raw.Contains('\\', StringComparison.Ordinal)
            || raw.Contains("://", StringComparison.Ordinal))
        {
            return null;
        }

        return raw;
    }

    public ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        Editor.Changed -= OnEditorChanged;
        Editor.DisposeSuggest();
        _persistSubscription.Dispose();
        _insightsCts?.Cancel();
        _insightsCts?.Dispose();
        _geocodeCts?.Cancel();
        _geocodeCts?.Dispose();
        ApiCalls.Flush("/candidate/profile");
        return ValueTask.CompletedTask;
    }
}
