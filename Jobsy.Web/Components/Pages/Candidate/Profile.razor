@page "/candidate/profile"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Profiel · Lobsy</PageTitle>

<div class="panel-page profile-page">
    <header class="saved-gate__header profile-page__header">
        <h1>Profiel</h1>
        @if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            <p class="login-lead">Vul je gegevens aan en ga daarna terug naar solliciteren.</p>
        }
    </header>
    <article class="detail-card">
        <h1 class="profile-page__title">Mijn profiel</h1>
        <p class="login-lead">Open for work, voorkeuren, thuisadres (PushBom) en geboortedatum (voor leeftijdsloon).</p>

        @if (_loading)
        {
            <p class="state-message">Laden…</p>
        }
        else
        {
            <div class="profile-form">
                <label class="profile-toggle">
                    <input type="checkbox" @bind="_openForWork" />
                    <span>Open for work</span>
                </label>

                <label>
                    Geboortedatum
                    <input type="date" @bind="_dobInput" />
                </label>

                <div class="profile-address">
                    <label for="profile-home-address">Thuisadres</label>
                    <div class="address-field">
                        <input id="profile-home-address"
                               type="text"
                               autocomplete="off"
                               placeholder="Straat, postcode of plaats…"
                               value="@_homeAddress"
                               @oninput="OnAddressInputAsync"
                               @onfocus="OnAddressFocus"
                               @onkeydown="OnAddressKeyDown" />
                        @if (!string.IsNullOrWhiteSpace(_homeAddress) || _homeLat is not null)
                        {
                            <button type="button"
                                    class="engagement-btn address-field__clear"
                                    @onclick="ClearHomeAddress">
                                Wissen
                            </button>
                        }
                    </div>
                    @if (_showSuggestions)
                    {
                        <ul class="address-suggestions" role="listbox">
                            @if (_suggesting)
                            {
                                <li class="address-suggestions__status">Laden…</li>
                            }
                            else if (_suggestions.Count == 0 && _homeAddress.Trim().Length >= 3)
                            {
                                <li class="address-suggestions__status">Geen adressen gevonden</li>
                            }
                            else
                            {
                                @foreach (var suggestion in _suggestions)
                                {
                                    <li>
                                        <button type="button"
                                                class="address-suggestions__item"
                                                @onclick="() => SelectSuggestion(suggestion)">
                                            @suggestion.Label
                                        </button>
                                    </li>
                                }
                            }
                        </ul>
                    }
                    <p class="profile-address__hint">Typ minstens 3 tekens en kies een adres uit de suggesties.</p>
                </div>

                <label>
                    Max. reistijd (minuten)
                    <input type="number" min="1" max="180" @bind="_maxTravel" />
                </label>

                <label>
                    Voorkeursvervoer
                    <select @bind="_preferredTransport">
                        <option value="">—</option>
                        <option>Fiets</option>
                        <option>Auto</option>
                        <option>OV</option>
                        <option>Lopend</option>
                    </select>
                </label>

                <fieldset class="profile-roles">
                    <legend>Interessedomeinen</legend>
                    @foreach (var role in RoleOptions)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@_selectedRoles.Contains(role)"
                                   @onchange="e => ToggleRole(role, (bool)(e.Value ?? false))" />
                            @role
                        </label>
                    }
                </fieldset>

                <fieldset class="profile-roles">
                    <legend>Rijbewijzen</legend>
                    @foreach (var license in LicenseOptions)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@_selectedLicenses.Contains(license)"
                                   @onchange="e => ToggleLicense(license, (bool)(e.Value ?? false))" />
                            @license
                        </label>
                    }
                </fieldset>

                <label>
                    Vertel wat over jezelf
                    <textarea rows="4" @bind="_aboutMe"></textarea>
                </label>

                <fieldset class="profile-roles">
                    <legend>Beschikbaarheid</legend>
                    <table class="wage-table">
                        <thead>
                            <tr>
                                <th>Dag</th>
                                @foreach (var slot in AvailabilitySlots)
                                {
                                    <th>@slot</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in AvailabilityDays)
                            {
                                <tr>
                                    <th>@day</th>
                                    @foreach (var slot in AvailabilitySlots)
                                    {
                                        var key = $"{day}:{slot}";
                                        <td>
                                            <input type="checkbox"
                                                   checked="@_availability.Contains(key)"
                                                   @onchange="e => ToggleAvailability(key, (bool)(e.Value ?? false))" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </fieldset>

                <fieldset class="profile-roles">
                    <legend>Werkervaring (werkgevers)</legend>
                    @for (var i = 0; i < _employers.Count; i++)
                    {
                        var idx = i;
                        <div class="inline-actions">
                            <input placeholder="Werkgever" @bind="_employers[idx].EmployerName" />
                            <input placeholder="Functie" @bind="_employers[idx].Role" />
                            <input type="number" min="0" max="80" placeholder="Jaren" @bind="_employers[idx].Years" />
                            <button type="button" class="engagement-btn" @onclick="() => RemoveEmployer(idx)">Verwijder</button>
                        </div>
                    }
                    <button type="button" class="engagement-btn" @onclick="AddEmployer">Werkgever toevoegen</button>
                </fieldset>

                <fieldset class="profile-roles">
                    <legend>Diploma/Opleiding</legend>
                    @for (var i = 0; i < _educations.Count; i++)
                    {
                        var idx = i;
                        <div class="inline-actions">
                            <input placeholder="Bijv. MBO Logistiek" @bind="_educations[idx]" />
                            <button type="button" class="engagement-btn" @onclick="() => RemoveEducation(idx)">Verwijder</button>
                        </div>
                    }
                    <button type="button" class="engagement-btn" @onclick="AddEducation">Opleiding toevoegen</button>
                </fieldset>

                @if (_authenticatorEnabled)
                {
                    <p class="login-lead">Authenticator-optie is beschikbaar als stub bij solliciteren.</p>
                }

                <button class="login-submit" type="button" disabled="@_saving" @onclick="SaveAsync">
                    Opslaan
                </button>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="state-message">@_message</p>
                }
            </div>
        }
    </article>
</div>

@code {
    private static readonly string[] RoleOptions = ["horeca", "retail", "logistiek", "tuinbouw", "zorg", "kantoor"];
    private static readonly string[] LicenseOptions = ["B", "A", "AM", "T", "Heftruck", "BE", "C", "CE", "D"];
    private static readonly string[] AvailabilityDays = ["Ma", "Di", "Wo", "Do", "Vr", "Za", "Zo"];
    private static readonly string[] AvailabilitySlots = ["Ochtend", "Middag", "Avond", "Nacht"];

    private bool _loading = true;
    private bool _saving;
    private bool _openForWork;
    private bool _authenticatorEnabled;
    private DateOnly? _dobInput;
    private string _homeAddress = string.Empty;
    private double? _homeLat;
    private double? _homeLng;
    private bool _homeLocationDirty;
    private int? _maxTravel = 30;
    private string _preferredTransport = "";
    private readonly HashSet<string> _selectedRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedLicenses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _availability = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<CandidateEmployerHistory> _employers = [];
    private readonly List<string> _educations = [];
    private string? _aboutMe;
    private string? _message;
    private string? _returnUrl;

    private List<AddressSuggestion> _suggestions = [];
    private bool _showSuggestions;
    private bool _suggesting;
    private CancellationTokenSource? _suggestCts;
    private int _suggestGeneration;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = SanitizeReturnUrl(ReturnUrl);
        try
        {
            var profile = await Api.GetMyProfileAsync();
            if (profile is null)
            {
                _message = "Profiel niet gevonden.";
                return;
            }

            var prefs = profile.Preferences ?? new CandidatePreferences();
            _dobInput = profile.DateOfBirth;
            _openForWork = profile.OpenForWork;
            _authenticatorEnabled = profile.AuthenticatorEnabled;
            _homeLat = profile.HomeLatitude;
            _homeLng = profile.HomeLongitude;
            _maxTravel = prefs.MaxTravelMinutes ?? 30;
            _preferredTransport = prefs.PreferredTransport ?? "";
            _selectedRoles.Clear();
            foreach (var role in prefs.Roles ?? [])
            {
                _selectedRoles.Add(role);
            }
            _selectedLicenses.Clear();
            foreach (var license in prefs.DrivingLicenses ?? [])
            {
                _selectedLicenses.Add(license);
            }
            _aboutMe = prefs.AboutMe;
            _availability.Clear();
            foreach (var day in prefs.Availability ?? [])
            {
                foreach (var slot in day.Value ?? [])
                {
                    _availability.Add($"{day.Key}:{slot}");
                }
            }
            _employers.Clear();
            _employers.AddRange(prefs.Employers ?? []);
            _educations.Clear();
            _educations.AddRange(prefs.Educations ?? []);

            if (_homeLat is not null && _homeLng is not null)
            {
                try
                {
                    var label = await Geocoder.ReverseAsync(_homeLat.Value, _homeLng.Value);
                    _homeAddress = string.IsNullOrWhiteSpace(label)
                        ? $"{_homeLat.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}, {_homeLng.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}"
                        : label;
                }
                catch
                {
                    _homeAddress = $"{_homeLat.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}, {_homeLng.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}";
                }
            }
        }
        catch (Exception ex)
        {
            _message = $"Profiel laden mislukt: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private void ToggleLicense(string license, bool selected)
    {
        if (selected)
        {
            _selectedLicenses.Add(license);
        }
        else
        {
            _selectedLicenses.Remove(license);
        }
    }

    private void ToggleAvailability(string key, bool selected)
    {
        if (selected)
        {
            _availability.Add(key);
        }
        else
        {
            _availability.Remove(key);
        }
    }

    private void AddEmployer() => _employers.Add(new CandidateEmployerHistory());
    private void RemoveEmployer(int index) => _employers.RemoveAt(index);
    private void AddEducation() => _educations.Add(string.Empty);
    private void RemoveEducation(int index) => _educations.RemoveAt(index);

    private async Task OnAddressInputAsync(ChangeEventArgs e)
    {
        _homeAddress = e.Value?.ToString() ?? string.Empty;
        _homeLat = null;
        _homeLng = null;
        _homeLocationDirty = true;
        _message = null;
        await SuggestAddressesAsync(_homeAddress);
    }

    private void OnAddressFocus()
    {
        if (_suggestions.Count > 0 || (_homeAddress.Trim().Length >= 3 && _suggesting))
        {
            _showSuggestions = true;
        }
    }

    private void OnAddressKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showSuggestions = false;
        }
    }

    private async Task SuggestAddressesAsync(string query)
    {
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _suggestCts = new CancellationTokenSource();
        var token = _suggestCts.Token;
        var generation = ++_suggestGeneration;

        var trimmed = query.Trim();
        if (trimmed.Length < 3)
        {
            _suggestions = [];
            _showSuggestions = false;
            _suggesting = false;
            return;
        }

        _showSuggestions = true;
        _suggesting = true;

        try
        {
            await Task.Delay(280, token);
            var results = await Geocoder.SuggestAsync(trimmed, token);
            if (generation != _suggestGeneration || token.IsCancellationRequested)
            {
                return;
            }

            _suggestions = results.ToList();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            if (generation == _suggestGeneration)
            {
                _suggestions = [];
            }
        }
        finally
        {
            if (generation == _suggestGeneration)
            {
                _suggesting = false;
            }
        }
    }

    private void SelectSuggestion(AddressSuggestion suggestion)
    {
        _showSuggestions = false;
        _suggestions = [];
        _homeAddress = suggestion.Label;
        _homeLat = suggestion.Latitude;
        _homeLng = suggestion.Longitude;
        _homeLocationDirty = true;
        _message = null;
    }

    private void ClearHomeAddress()
    {
        _homeAddress = string.Empty;
        _homeLat = null;
        _homeLng = null;
        _homeLocationDirty = true;
        _suggestions = [];
        _showSuggestions = false;
        _message = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            if (_homeLocationDirty
                && !string.IsNullOrWhiteSpace(_homeAddress)
                && (_homeLat is null || _homeLng is null))
            {
                _message = "Kies een adres uit de suggesties.";
                return;
            }

            var clearHome = _homeLocationDirty && string.IsNullOrWhiteSpace(_homeAddress);
            await Api.UpdateMyProfileAsync(
                openForWork: _openForWork,
                dateOfBirth: _dobInput,
                preferences: new CandidatePreferences
                {
                    Roles = _selectedRoles.OrderBy(r => r).ToList(),
                    MaxTravelMinutes = _maxTravel,
                    PreferredTransport = string.IsNullOrWhiteSpace(_preferredTransport) ? null : _preferredTransport,
                    AboutMe = string.IsNullOrWhiteSpace(_aboutMe) ? null : _aboutMe.Trim(),
                    DrivingLicenses = _selectedLicenses.OrderBy(x => x).ToList(),
                    Availability = BuildAvailability(),
                    Employers = _employers.Where(e => !string.IsNullOrWhiteSpace(e.EmployerName)).ToList(),
                    Educations = _educations.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()).ToList()
                },
                homeLatitude: clearHome || !_homeLocationDirty ? null : _homeLat,
                homeLongitude: clearHome || !_homeLocationDirty ? null : _homeLng,
                clearHomeLocation: clearHome);
            _homeLocationDirty = false;
            _message = "Profiel opgeslagen.";
            if (!string.IsNullOrWhiteSpace(_returnUrl))
            {
                Navigation.NavigateTo(_returnUrl);
                return;
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? SanitizeReturnUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        // Only local relative paths such as /vacancies/{id}#apply
        if (!raw.StartsWith('/') || raw.StartsWith("//", StringComparison.Ordinal))
        {
            return null;
        }

        if (raw.Contains('\\', StringComparison.Ordinal)
            || raw.Contains("://", StringComparison.Ordinal))
        {
            return null;
        }

        return raw;
    }

    public ValueTask DisposeAsync()
    {
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in _availability)
        {
            var parts = key.Split(':', 2);
            if (parts.Length != 2)
            {
                continue;
            }

            if (!map.TryGetValue(parts[0], out var slots))
            {
                slots = [];
                map[parts[0]] = slots;
            }

            if (!slots.Contains(parts[1], StringComparer.OrdinalIgnoreCase))
            {
                slots.Add(parts[1]);
            }
        }

        return map;
    }
}
