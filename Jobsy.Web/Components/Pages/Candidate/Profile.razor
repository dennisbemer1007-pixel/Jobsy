@page "/candidate/profile"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IJSRuntime Js
@inject PersistentComponentState Persist
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Components.Shared
@implements IAsyncDisposable

<PageTitle>@Culture["Profile.Title"] · Lobsy</PageTitle>

<div class="panel-page profile-page profile-page--candidate">
    <header class="saved-gate__header profile-page__header">
        <h1>@Culture["Profile.Title"]</h1>
        @if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            <p class="login-lead">@Culture["Profile.ReturnHint"]</p>
        }
    </header>
        <CandidateKompas SharedKompas="_kompasState">
            <ProfileTab>
        <p class="login-lead">@Culture["Profile.Lead"]</p>
        @if (string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            <p class="state-message" aria-live="polite">@Culture["Insights.Updating"]</p>
        }
        @if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            <p class="login-lead profile-return-hint">@Culture["Profile.ReturnHint"]</p>
        }

        @if (_loading)
        {
            <PageContentSkeleton Variant="profile" LoadingLabel="@Culture["Common.Loading"]" />
        }
        else
        {
            <div class="profile-form competency-profile-card">
                <nav class="profile-section-nav pill-scroller" aria-label="@Culture["Profile.Lead"]">
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("personal") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("personal") ? "true" : "false")"
                            aria-controls="profile-section-personal"
                            @onclick='() => ToggleSection("personal")'>@Culture["Profile.Section.Personal"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("preferences") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("preferences") ? "true" : "false")"
                            @onclick='() => ToggleSection("preferences")'>@Culture["Profile.Section.Preferences"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("availability") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("availability") ? "true" : "false")"
                            @onclick='() => ToggleSection("availability")'>@Culture["Profile.Section.Availability"]</button>
                    <button type="button"
                            class="admin-sublink @(IsSectionOpen("experience") ? "admin-sublink--active" : null)"
                            aria-expanded="@(IsSectionOpen("experience") ? "true" : "false")"
                            @onclick='() => ToggleSection("experience")'>@Culture["Profile.Section.Experience"]</button>
                </nav>
                <div class="profile-accordion">
                    <h2 class="visually-hidden" id="profile-section-personal-btn">@Culture["Profile.Section.Personal"]</h2>
                    @if (IsSectionOpen("personal"))
                    {
                        <div class="profile-accordion__body" id="profile-section-personal" role="region" aria-labelledby="profile-section-personal-btn">
                            <label class="profile-toggle">
                                <input type="checkbox" @bind="_openForWork" />
                                <span>@Culture["Profile.OpenForWork"]</span>
                            </label>

                            <fieldset class="profile-contact">
                                <legend>@Culture["Profile.ContactDetails"]</legend>
                                <div class="profile-contact__names">
                                    <label>
                                        @Culture["Profile.FirstName"]
                                        <input type="text" maxlength="128" @bind="_firstName" autocomplete="given-name" />
                                    </label>
                                    <label>
                                        @Culture["Profile.LastName"]
                                        <input type="text" maxlength="128" @bind="_lastName" autocomplete="family-name" />
                                    </label>
                                </div>
                                <label>
                                    @Culture["Profile.Phone"]
                                    <input type="tel"
                                           maxlength="32"
                                           placeholder="@Culture["Profile.PhonePlaceholder"]"
                                           @bind="_phoneNumber"
                                           autocomplete="tel" />
                                </label>
                                <label class="profile-toggle">
                                    <input type="checkbox"
                                           disabled="@string.IsNullOrWhiteSpace(_phoneNumber)"
                                           @bind="_whatsAppAllowed" />
                                    <span>@Culture["Profile.WhatsAppAllowed"]</span>
                                </label>
                                <p class="profile-address__hint">@Culture["Profile.ContactHint"]</p>
                            </fieldset>

                            <section class="profile-devices" aria-labelledby="profile-devices-title">
                                <h3 id="profile-devices-title">@Culture["Profile.Devices.Title"]</h3>
                                <p class="login-lead">@Culture["Profile.Devices.Lead"]</p>
                                @if (_devicesLoading)
                                {
                                    <p class="state-message">@Culture["Common.Loading"]</p>
                                }
                                else if (_devices.Count == 0)
                                {
                                    <p class="state-message">@Culture["Profile.Devices.Empty"]</p>
                                }
                                else
                                {
                                    <ul class="profile-devices__list">
                                        @foreach (var device in _devices)
                                        {
                                            <li class="profile-devices__item">
                                                <div>
                                                    <strong>@device.DeviceName</strong>
                                                    @if (device.IsCurrent)
                                                    {
                                                        <span class="profile-devices__current"> · @Culture["Profile.Devices.Current"]</span>
                                                    }
                                                    <p class="profile-address__hint">
                                                        @Culture["Profile.Devices.LastUsed"]: @device.LastUsedAtUtc.ToLocalTime().ToString("g")
                                                    </p>
                                                </div>
                                                <button type="button"
                                                        class="engagement-btn"
                                                        disabled="@_devicesBusy"
                                                        @onclick="() => RevokeDeviceAsync(device.Id)">
                                                    @Culture["Profile.Devices.Logout"]
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    <button type="button"
                                            class="engagement-btn"
                                            disabled="@_devicesBusy"
                                            @onclick="RevokeAllDevicesAsync">
                                        @Culture["Profile.Devices.LogoutAll"]
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_devicesMessage))
                                {
                                    <p class="state-message" aria-live="polite">@_devicesMessage</p>
                                }
                            </section>

                            <label>
                                @Culture["Profile.DateOfBirth"]
                                <input type="date" @bind="_dobInput" />
                            </label>

                            <div class="profile-address">
                                <label for="profile-home-address">@Culture["Profile.HomeAddress"]</label>
                                <div class="address-field">
                                    <input id="profile-home-address"
                                           type="text"
                                           autocomplete="off"
                                           placeholder="@Culture["Discovery.AddressPlaceholder"]"
                                           value="@_homeAddress"
                                           @oninput="OnAddressInputAsync"
                                           @onfocus="OnAddressFocus"
                                           @onkeydown="OnAddressKeyDown" />
                                    @if (!string.IsNullOrWhiteSpace(_homeAddress) || _homeLat is not null)
                                    {
                                        <button type="button"
                                                class="engagement-btn address-field__clear"
                                                @onclick="ClearHomeAddress">
                                            @Culture["Common.Clear"]
                                        </button>
                                    }
                                </div>
                                @if (_showSuggestions)
                                {
                                    <ul class="address-suggestions" role="listbox">
                                        @if (_suggesting)
                                        {
                                            <li class="address-suggestions__status">@Culture["Common.Loading"]</li>
                                        }
                                        else if (_suggestions.Count == 0 && _homeAddress.Trim().Length >= 3)
                                        {
                                            <li class="address-suggestions__status">@Culture["Discovery.AddressNoResults"]</li>
                                        }
                                        else
                                        {
                                            @foreach (var suggestion in _suggestions)
                                            {
                                                <li>
                                                    <button type="button"
                                                            class="address-suggestions__item"
                                                            @onclick="() => SelectSuggestion(suggestion)">
                                                        @suggestion.Label
                                                    </button>
                                                </li>
                                            }
                                        }
                                    </ul>
                                }
                                <p class="profile-address__hint">@Culture["Profile.AddressHint"]</p>
                                <p class="profile-address__hint">@Culture["Profile.CvMapPrivacyHint"]</p>
                            </div>
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-preferences-btn">@Culture["Profile.Section.Preferences"]</h2>
                    @if (IsSectionOpen("preferences"))
                    {
                        <div class="profile-accordion__body" id="profile-section-preferences" role="region" aria-labelledby="profile-section-preferences-btn">
                            <label>
                                @Culture["Profile.MaxTravel"]
                                <input type="number" min="1" max="180" @bind="_maxTravel" />
                            </label>

                            <label>
                                @Culture["Profile.PreferredTransport"]
                                <select @bind="_preferredTransport">
                                    <option value="">—</option>
                                    <option value="Fiets">@Culture["Transport.Bike"]</option>
                                    <option value="E-bike">@Culture["Transport.EBike"]</option>
                                    <option value="Auto">@Culture["Transport.Car"]</option>
                                    <option value="OV">@Culture["Transport.Transit"]</option>
                                    <option value="Lopend">@Culture["Transport.Walk"]</option>
                                </select>
                            </label>

                            <fieldset class="profile-roles profile-check-grid">
                                <legend>@Culture["Profile.Interests"]</legend>
                                @foreach (var role in _branchOptions)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@_selectedRoles.Contains(role)"
                                               @onchange="e => ToggleRole(role, (bool)(e.Value ?? false))" />
                                        @UiLabels.WorkType(Culture, role)
                                    </label>
                                }
                            </fieldset>

                            <fieldset class="profile-roles profile-check-grid">
                                <legend>@Culture["Profile.Licenses"]</legend>
                                @foreach (var license in _licenseOptions)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@_selectedLicenses.Contains(license)"
                                               @onchange="e => ToggleLicense(license, (bool)(e.Value ?? false))" />
                                        @UiLabels.License(Culture, license)
                                    </label>
                                }
                            </fieldset>
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-availability-btn">@Culture["Profile.Section.Availability"]</h2>
                    @if (IsSectionOpen("availability"))
                    {
                        <div class="profile-accordion__body" id="profile-section-availability" role="region" aria-labelledby="profile-section-availability-btn">
                            <fieldset class="vacancy-hours profile-hours">
                                <legend class="visually-hidden">@Culture["Vacancy.HoursPerWeek"]</legend>
                                <div class="vacancy-hours__row">
                                    <span class="vacancy-hours__title">@Culture["Vacancy.HoursPerWeek"]</span>
                                    <label>
                                        Min.
                                        <input type="number" min="1" max="60" step="0.5" @bind="_minHours" />
                                    </label>
                                    <span class="vacancy-hours__sep" aria-hidden="true">–</span>
                                    <label>
                                        Max.
                                        <input type="number" min="1" max="60" step="0.5" @bind="_maxHours" />
                                    </label>
                                    @if (_minHours is decimal minH && _maxHours is decimal maxH && maxH >= minH)
                                    {
                                        <span class="vacancy-hours__meta muted">@HoursRangeRules.CategoryLabel(new HoursRange(minH, maxH).Category)</span>
                                    }
                                </div>
                            </fieldset>

                            <fieldset class="profile-availability">
                                <legend>@Culture["Profile.Availability"]</legend>
                                <div class="availability-presets" role="group" aria-label="@Culture["Profile.Availability"]">
                                    <button type="button"
                                            class="availability-presets__btn @(_flexibleTimes && AvailabilityKind is null ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("flexible")'>
                                        @Culture["Profile.PresetFlexible"]
                                    </button>
                                    <button type="button"
                                            class="availability-presets__btn @(AvailabilityKind == CandidateAvailabilityPresets.Immediate ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("immediate")'>
                                        @Culture["Profile.PresetImmediate"]
                                    </button>
                                    <button type="button"
                                            class="availability-presets__btn @(AvailabilityKind == CandidateAvailabilityPresets.PartTime ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("parttime")'>
                                        @Culture["Profile.PresetPartTime"]
                                    </button>
                                    <button type="button"
                                            class="availability-presets__btn @(AvailabilityKind == CandidateAvailabilityPresets.Seasonal ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("seasonal")'>
                                        @Culture["Profile.PresetSeasonal"]
                                    </button>
                                    <button type="button"
                                            class="availability-presets__btn @(!_flexibleTimes && IsOfficeHoursPreset() ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("office")'>
                                        @Culture["Profile.PresetOffice"]
                                    </button>
                                    <button type="button"
                                            class="availability-presets__btn @(!_flexibleTimes && IsEveningsPreset() ? "is-active" : null)"
                                            @onclick='() => ApplyAvailabilityPreset("evenings")'>
                                        @Culture["Profile.PresetEvenings"]
                                    </button>
                                </div>
                                @if (!_flexibleTimes)
                                {
                                    <div class="availability-matrix" role="grid" aria-label="@Culture["Profile.Availability"]">
                                        <div class="availability-matrix__corner" role="columnheader"></div>
                                        @foreach (var slot in AvailabilitySlots)
                                        {
                                            <div class="availability-matrix__slot" role="columnheader">
                                                @UiLabels.AvailabilitySlot(Culture, slot)
                                            </div>
                                        }
                                        @foreach (var day in AvailabilityDays)
                                        {
                                            <div class="availability-matrix__day" role="rowheader">@UiLabels.Weekday(Culture, day)</div>
                                            @foreach (var slot in AvailabilitySlots)
                                            {
                                                var key = $"{day}:{slot}";
                                                var on = _availability.Contains(key);
                                                <label class="availability-matrix__cell @(on ? "is-on" : null)">
                                                    <input type="checkbox"
                                                           checked="@on"
                                                           @onchange="e => ToggleAvailability(key, (bool)(e.Value ?? false))" />
                                                    <span class="visually-hidden">@UiLabels.Weekday(Culture, day) @UiLabels.AvailabilitySlot(Culture, slot)</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                }
                            </fieldset>
                        </div>
                    }

                    <h2 class="visually-hidden" id="profile-section-experience-btn">@Culture["Profile.Section.Experience"]</h2>
                    @if (IsSectionOpen("experience"))
                    {
                        <div class="profile-accordion__body" id="profile-section-experience" role="region" aria-labelledby="profile-section-experience-btn">
                            <label>
                                @Culture["Profile.AboutMe"]
                                <textarea rows="4" @bind="_aboutMe"></textarea>
                            </label>

                            <label>
                                @Culture["Profile.DefaultMotivation"]
                                <textarea rows="4" maxlength="500" @bind="_defaultMotivation"></textarea>
                                <span class="profile-address__hint">@Culture["Profile.DefaultMotivationHint"]</span>
                            </label>

                            <fieldset class="profile-employers">
                                <legend>@Culture["Profile.OwnCv"]</legend>
                                <p class="profile-employers__hint">@Culture["Profile.OwnCvLead"]</p>
                                @if (_uploadedCv is not null)
                                {
                                    <p class="profile-cv__file">@Culture.Format("Profile.OwnCvPresent", _uploadedCv.FileName)</p>
                                }
                                <div class="profile-cv__actions">
                                    <label class="engagement-btn">
                                        @(_cvBusy ? Culture["Profile.CvUploading"] : _uploadedCv is null ? Culture["Profile.UploadCv"] : Culture["Profile.ReplaceCv"])
                                        <InputFile OnChange="OnCvSelectedAsync" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                                    </label>
                                    @if (_uploadedCv is not null)
                                    {
                                        <button class="engagement-btn" type="button" disabled="@_cvBusy" @onclick="DownloadOwnCvAsync">
                                            @Culture["Profile.DownloadOwnCv"]
                                        </button>
                                        <button class="engagement-btn" type="button" disabled="@_cvBusy" @onclick="DeleteOwnCvAsync">
                                            @Culture["Profile.RemoveOwnCv"]
                                        </button>
                                    }
                                </div>
                            </fieldset>

                            <fieldset class="profile-employers">
                                <legend>@Culture["Profile.Experience"]</legend>
                                <p class="profile-employers__hint">@Culture["Profile.EmployerDatesHint"]</p>
                                @for (var i = 0; i < _employers.Count; i++)
                                {
                                    var idx = i;
                                    <div class="profile-employer-card">
                                        <div class="profile-employer-card__top">
                                            <label class="profile-employer-card__field profile-employer-card__field--employer">
                                                <span>@Culture["Profile.Employer"]</span>
                                                <input placeholder="@Culture["Profile.EmployerName"]" @bind="_employers[idx].EmployerName" />
                                            </label>
                                            <label class="profile-employer-card__field profile-employer-card__field--role">
                                                <span>@Culture["Profile.Role"]</span>
                                                <input placeholder="@Culture["Profile.RolePlaceholder"]" @bind="_employers[idx].Role" />
                                            </label>
                                            <button type="button"
                                                    class="icon-btn icon-btn--danger"
                                                    title="@Culture["Profile.RemoveEmployer"]"
                                                    aria-label="@Culture["Profile.RemoveEmployer"]"
                                                    @onclick="() => RemoveEmployer(idx)">
                                                @((MarkupString)ActionIcons.Trash)
                                            </button>
                                        </div>
                                        <div class="profile-employer-card__dates">
                                            <label class="profile-employer-card__field profile-employer-card__field--start">
                                                <span>@Culture["Profile.EmployerFrom"]</span>
                                                <input type="month"
                                                       min="1950-01"
                                                       max="2100-12"
                                                       value="@(_employers[idx].StartMonth ?? "")"
                                                       @onchange="e => SetEmployerStartMonth(idx, e.Value?.ToString())" />
                                            </label>
                                            <label class="profile-employer-card__field profile-employer-card__field--end">
                                                <span>@Culture["Profile.EmployerTo"]</span>
                                                <input type="month"
                                                       min="1950-01"
                                                       max="2100-12"
                                                       value="@(_employers[idx].EndMonth ?? "")"
                                                       @onchange="e => SetEmployerEndMonth(idx, e.Value?.ToString())" />
                                            </label>
                                            <p class="profile-employer-card__dates-hint">@Culture["Profile.EmployerToHint"]</p>
                                        </div>
                                        <label class="profile-employer-card__field profile-employer-card__field--description">
                                            <span>@Culture["Profile.WhatDidYouDo"]</span>
                                            <textarea rows="3"
                                                      maxlength="1000"
                                                      placeholder="@Culture["Profile.DutiesPlaceholder"]"
                                                      @bind="_employers[idx].Description"></textarea>
                                        </label>
                                    </div>
                                }
                                <button type="button" class="icon-btn icon-btn--add" title="@Culture["Profile.AddEmployer"]" aria-label="@Culture["Profile.AddEmployer"]" @onclick="AddEmployer">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                                        <path d="M12 5v14" /><path d="M5 12h14" />
                                    </svg>
                                </button>
                            </fieldset>

                            <fieldset class="profile-roles profile-check-grid">
                                <legend>@Culture["Profile.Education"]</legend>
                                @foreach (var level in _educationOptions)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@_selectedEducations.Contains(level)"
                                               @onchange="e => ToggleEducation(level, (bool)(e.Value ?? false))" />
                                        @UiLabels.Education(Culture, level)
                                    </label>
                                }
                            </fieldset>

                            <fieldset class="profile-certificates">
                                <legend>@Culture["Profile.Certificates"]</legend>
                                @for (var i = 0; i < _certificates.Count; i++)
                                {
                                    var idx = i;
                                    <div class="profile-cert-row">
                                        <label class="profile-cert-row__year">
                                            <span class="visually-hidden">@Culture["Profile.CertificateYear"]</span>
                                            <input type="number"
                                                   min="1950"
                                                   max="2100"
                                                   placeholder="@Culture["Profile.CertificateYear"]"
                                                   @bind="_certificates[idx].Year" />
                                        </label>
                                        <label class="profile-cert-row__name">
                                            <span class="visually-hidden">@Culture["Profile.CertificateName"]</span>
                                            <input type="text"
                                                   maxlength="200"
                                                   placeholder="@Culture["Profile.CertificateName"]"
                                                   @bind="_certificates[idx].Name" />
                                        </label>
                                        <button type="button"
                                                class="icon-btn icon-btn--danger"
                                                title="@Culture["Profile.RemoveCertificate"]"
                                                aria-label="@Culture["Profile.RemoveCertificate"]"
                                                @onclick="() => RemoveCertificate(idx)">
                                            @((MarkupString)ActionIcons.Trash)
                                        </button>
                                    </div>
                                }
                                <button type="button"
                                        class="icon-btn icon-btn--add"
                                        title="@Culture["Profile.AddCertificate"]"
                                        aria-label="@Culture["Profile.AddCertificate"]"
                                        @onclick="AddCertificate">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                                        <path d="M12 5v14" /><path d="M5 12h14" />
                                    </svg>
                                </button>
                            </fieldset>

                            <fieldset class="profile-employers">
                                <legend>@Culture["Profile.References"]</legend>
                                <p class="profile-employers__hint">@Culture["Profile.ReferencesLead"]</p>
                                @for (var i = 0; i < _references.Count; i++)
                                {
                                    var idx = i;
                                    <div class="profile-employer-card">
                                        <div class="profile-employer-card__top">
                                            <label class="profile-employer-card__field profile-employer-card__field--employer">
                                                <span>@Culture["Profile.ReferenceEmployer"]</span>
                                                <input @bind="_references[idx].EmployerName" />
                                            </label>
                                            <label class="profile-employer-card__field profile-employer-card__field--role">
                                                <span>@Culture["Profile.ReferenceContact"]</span>
                                                <input @bind="_references[idx].ContactName" />
                                            </label>
                                            <button type="button"
                                                    class="icon-btn icon-btn--danger"
                                                    title="@Culture["Profile.RemoveReference"]"
                                                    aria-label="@Culture["Profile.RemoveReference"]"
                                                    @onclick="() => RemoveReference(idx)">
                                                @((MarkupString)ActionIcons.Trash)
                                            </button>
                                        </div>
                                        <div class="profile-employer-card__dates">
                                            <label class="profile-employer-card__field">
                                                <span>@Culture["Profile.ReferenceEmail"]</span>
                                                <input type="email" @bind="_references[idx].Email" />
                                            </label>
                                            <label class="profile-employer-card__field">
                                                <span>@Culture["Profile.ReferencePhone"]</span>
                                                <input type="tel" @bind="_references[idx].Phone" />
                                            </label>
                                        </div>
                                    </div>
                                }
                                <button type="button"
                                        class="icon-btn icon-btn--add"
                                        title="@Culture["Profile.AddReference"]"
                                        aria-label="@Culture["Profile.AddReference"]"
                                        @onclick="AddReference"
                                        disabled="@(_references.Count >= CandidateReferenceRules.MaxPerCandidate)">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                                        <path d="M12 5v14" /><path d="M5 12h14" />
                                    </svg>
                                </button>
                            </fieldset>

                            @if (_authenticatorEnabled)
                            {
                                <p class="login-lead">@Culture["Profile.AuthenticatorHint"]</p>
                            }

                            <button class="engagement-btn" type="button" disabled="@(_saving || _pdfBusy)" @onclick="DownloadLobsyCvAsync">
                                @(_pdfBusy ? Culture["Common.Loading"] : Culture["Profile.DownloadLobsyCv"])
                            </button>
                            <p class="profile-address__hint">@Culture["Profile.LobsyCvHint"]</p>
                        </div>
                    }
                </div>

                <div class="profile-save-bar">
                    <button class="login-submit" type="button" disabled="@_saving" @onclick="SaveAsync">
                        @Culture["Common.Save"]
                    </button>
                    @if (!string.IsNullOrEmpty(_message))
                    {
                        <p class="state-message profile-save-bar__message">@_message</p>
                    }
                </div>
            </div>
        }

        @if (!_loading)
        {
            <section class="profile-unsubscribe" aria-labelledby="profile-privacy-title">
                <h2 id="profile-privacy-title" class="profile-page__title">Privacy en toestemming</h2>
                <p class="login-lead">Je kiest zelf of we je tests en AI-analyse gebruiken. De talentpool staat standaard uit.</p>

                <h3>Tests en AI-analyse</h3>
                <p class="profile-address__hint">
                    @(_testAiConsentAt is null
                        ? "Je hebt nog geen toestemming gegeven."
                        : $"Toestemming gegeven op {_testAiConsentAt.Value.ToLocalTime():dd-MM-yyyy}.")
                </p>
                @if (_testAiConsentAt is null)
                {
                    <button class="engagement-btn" type="button" disabled="@_consentBusy" @onclick="AcceptTestConsentAsync">Toestemming geven</button>
                }
                else
                {
                    <button class="engagement-btn" type="button" disabled="@_consentBusy" @onclick="() => WithdrawTestConsentAsync(false)">Toestemming intrekken</button>
                    <button class="provider-btn provider-btn--danger" type="button" disabled="@_consentBusy" @onclick="() => WithdrawTestConsentAsync(true)">Intrekken en testresultaten verwijderen</button>
                }

                <h3>Anonieme talentpool</h3>
                <p class="profile-address__hint">
                    @(_talentPoolConsentAt is null
                        ? "Je profiel is niet zichtbaar in de talentpool."
                        : "Je profiel is anoniem zichtbaar in de talentpool.")
                </p>
                @if (_talentPoolConsentAt is null)
                {
                    <button class="engagement-btn" type="button" disabled="@_consentBusy" @onclick="AcceptTalentPoolConsentAsync">Anoniem zichtbaar worden</button>
                }
                else
                {
                    <button class="provider-btn provider-btn--danger" type="button" disabled="@_consentBusy" @onclick="WithdrawTalentPoolConsentAsync">Talentpooltoestemming intrekken</button>
                }

                @if (IsUnder16 && _parentalConsentAt is null)
                {
                    <h3>Toestemming ouder of voogd</h3>
                    <p class="profile-address__hint">Voor tests, AI en solliciteren hebben we eerst toestemming van je ouder of voogd nodig.</p>
                    <label>
                        E-mailadres van ouder of voogd
                        <input type="email" @bind="_parentalConsentEmail" autocomplete="email" />
                    </label>
                    <button class="engagement-btn" type="button" disabled="@_consentBusy" @onclick="RequestParentalConsentAsync">Bevestigingslink sturen</button>
                }
                @if (!string.IsNullOrWhiteSpace(_consentMessage))
                {
                    <p class="state-message" aria-live="polite">@_consentMessage</p>
                }
            </section>
        }

        <section class="profile-contacts-mini" aria-labelledby="talent-contacts-title">
            <h2 id="talent-contacts-title" class="profile-page__title">@Culture["Talent.CandidateTitle"]</h2>
            <p class="login-lead">@Culture["Talent.CandidateLead"]</p>
            <a class="engagement-btn" href="/candidate/talent-contacts">@Culture["Talent.CandidateOpen"]</a>
        </section>

        @if (!_loading)
        {
            <section class="profile-unsubscribe" aria-labelledby="profile-unsubscribe-title">
                <h2 id="profile-unsubscribe-title" class="profile-page__title">@Culture["Profile.UnsubscribeTitle"]</h2>
                <p class="login-lead">@Culture["Profile.UnsubscribeLead"]</p>
                <button class="provider-btn provider-btn--danger" type="button" @onclick="OpenUnsubscribe">
                    @Culture["Profile.Unsubscribe"]
                </button>
            </section>
        }
            </ProfileTab>
            <Side>
                <div class="profile-layout__matches">
                    <div class="detail-card">
                        <CompetencyMatchPanel Items="_matchedVacancies" Loading="_matchesLoading" />
                    </div>
                </div>
            </Side>
        </CandidateKompas>
</div>

<UnsubscribeDialog IsOpen="_unsubscribeOpen"
                   OnClose="CloseUnsubscribe"
                   OnCompleted="OnUnsubscribeCompleted" />

@code {
    private static readonly string[] AvailabilityDays = DayPartMatrix.DayCodes;
    private static readonly string[] AvailabilitySlots = DayPartMatrix.DayPartCodes;

    private bool _loading = true;
    private bool _saving;
    private bool _pdfBusy;
    private bool _openForWork;
    private bool _devicesLoading;
    private bool _devicesBusy;
    private string? _devicesMessage;
    private List<JobsyApiClient.DeviceSessionItem> _devices = [];
    private string _firstName = "";
    private string _lastName = "";
    private string _phoneNumber = "";
    private bool _whatsAppAllowed;
    private bool _authenticatorEnabled;
    private bool _consentBusy;
    private DateTime? _talentPoolConsentAt;
    private DateTime? _testAiConsentAt;
    private DateTime? _parentalConsentAt;
    private string _parentalConsentEmail = "";
    private string? _consentMessage;
    private bool _unsubscribeOpen;
    private DateOnly? _dobInput;
    private string _homeAddress = string.Empty;
    private double? _homeLat;
    private double? _homeLng;
    private bool _homeLocationDirty;
    private int? _maxTravel = 30;
    private string _preferredTransport = "";
    private decimal? _minHours = 8;
    private decimal? _maxHours = 24;
    private bool _flexibleTimes;
    private readonly HashSet<string> _selectedRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedLicenses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedEducations = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _availability = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<CandidateEmployerHistory> _employers = [];
    private readonly List<CandidateCertificate> _certificates = [];
    private readonly List<CandidateReferenceItem> _references = [];
    private CandidateUploadedCvInfo? _uploadedCv;
    private bool _cvBusy;
    private List<string> _branchOptions = WorkTypeLabels.All.ToList();
    private List<string> _licenseOptions = DrivingLicenseLabels.All.ToList();
    private List<string> _educationOptions = EducationLevelLabels.ProfileAll.ToList();
    private string? _aboutMe;
    private string? _defaultMotivation;
    private string? _message;
    private string? _returnUrl;

    private bool IsUnder16 => _dobInput is DateOnly dob
                              && AgeRules.AgeYearsFromDateOfBirth(dob) is int age
                              && age < 16;

    private List<AddressSuggestion> _suggestions = [];
    private bool _showSuggestions;
    private bool _suggesting;
    private CancellationTokenSource? _suggestCts;
    private int _suggestGeneration;
    private string _openSection = "personal";
    private static readonly string[] WeekdayCodes = ["Ma", "Di", "Wo", "Do", "Vr"];
    private bool _matchesLoading = true;
    private IReadOnlyList<CandidateMatchedVacancy> _matchedVacancies = [];
    private string _insightsStatus = "Ready";
    private CandidateKompasState? _kompasState;
    private int _insightsRefreshAttempts;
    private const string PersistKey = "candidateProfileKompas";
    private bool _restored;
    private PersistingComponentStateSubscription _persistSubscription;

    private string? AvailabilityKind =>
        CandidateAvailabilityPresets.Detect(_minHours, _maxHours, _flexibleTimes);

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<CandidateKompasState>(PersistKey, out var saved) && saved is not null)
        {
            _kompasState = saved;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        if (_kompasState is not null)
        {
            Persist.PersistAsJson(PersistKey, _kompasState);
        }

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = SanitizeReturnUrl(ReturnUrl);
        try
        {
            if (_restored && _kompasState is not null)
            {
                await LoadMasterdataAsync();
                await ApplyKompasAsync(_kompasState, allowGeocode: false);
                return;
            }

            var masterdataTask = LoadMasterdataAsync();
            var kompasTask = Api.GetMyKompasAsync();
            await Task.WhenAll(masterdataTask, kompasTask);
            var kompas = kompasTask.Result;
            _kompasState = kompas;
            await ApplyKompasAsync(kompas, allowGeocode: true);
        }
        catch (Exception ex)
        {
            _message = Culture.Format("Profile.LoadFailed", ex.Message);
            _matchedVacancies = [];
        }
        finally
        {
            _loading = false;
            _matchesLoading = false;
        }
    }

    private async Task ApplyKompasAsync(CandidateKompasState? kompas, bool allowGeocode)
    {
        var profile = kompas?.Profile;
        if (profile is null)
        {
            _message = Culture["Profile.NotFound"];
            _matchesLoading = false;
            return;
        }

        var prefs = profile.Preferences ?? new CandidatePreferences();
        _dobInput = profile.DateOfBirth;
        _openForWork = profile.OpenForWork;
        _firstName = profile.FirstName ?? "";
        _lastName = profile.LastName ?? "";
        _phoneNumber = profile.PhoneNumber ?? "";
        _whatsAppAllowed = profile.WhatsAppContactAllowed;
        _authenticatorEnabled = profile.AuthenticatorEnabled;
        _talentPoolConsentAt = profile.TalentPoolConsentAt;
        _testAiConsentAt = profile.TestAiConsentAt;
        _parentalConsentAt = profile.ParentalConsentAt;
        _parentalConsentEmail = profile.ParentalConsentEmail ?? "";
        _homeLat = profile.HomeLatitude;
        _homeLng = profile.HomeLongitude;
        _ = LoadDevicesAsync();
        _insightsStatus = kompas?.InsightsStatus ?? "Ready";
        if (kompas?.TopMatches is { Count: > 0 } matches)
        {
            _matchedVacancies = matches;
            _matchesLoading = false;
        }
        else if (string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _matchedVacancies = [];
            _matchesLoading = false;
        }
        _maxTravel = prefs.MaxTravelMinutes ?? 30;
        _preferredTransport = string.IsNullOrWhiteSpace(prefs.PreferredTransport)
            ? ""
            : TransportLabels.Canonical(prefs.PreferredTransport);
        _selectedRoles.Clear();
        foreach (var role in prefs.Roles ?? [])
        {
            var label = WorkTypeLabels.Expand(WorkTypeLabels.Parse(role)).FirstOrDefault()
                ?? _branchOptions.FirstOrDefault(b => string.Equals(b, role, StringComparison.OrdinalIgnoreCase))
                ?? role;
            if (!string.IsNullOrWhiteSpace(label))
            {
                _selectedRoles.Add(label);
            }
        }
        _selectedLicenses.Clear();
        foreach (var license in prefs.DrivingLicenses ?? [])
        {
            foreach (var normalized in DrivingLicenseLabels.Split(license))
            {
                _selectedLicenses.Add(normalized);
            }
        }
        _aboutMe = prefs.AboutMe;
        _defaultMotivation = prefs.DefaultMotivation;
        _availability.Clear();
        foreach (var day in prefs.Availability ?? [])
        {
            foreach (var slot in day.Value ?? [])
            {
                _availability.Add($"{day.Key}:{slot}");
            }
        }

        _minHours = prefs.MinHoursPerWeek ?? 8;
        _maxHours = prefs.MaxHoursPerWeek ?? 24;
        _flexibleTimes = prefs.FlexibleTimes == true;
        _employers.Clear();
        _employers.AddRange(prefs.Employers ?? []);
        _certificates.Clear();
        _certificates.AddRange(prefs.Certificates ?? []);
        ApplyCvAndReferences(profile);

        // Paint Top 10 from kompas snapshot — fallback GET only when Ready and empty.
        if (_matchedVacancies.Count == 0
            && !string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase)
            && allowGeocode)
        {
            await LoadMatchedVacanciesAsync();
        }

        await InvokeAsync(StateHasChanged);
        if (string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _ = RefreshInsightsLaterAsync();
        }

        _selectedEducations.Clear();
        foreach (var education in prefs.Educations ?? [])
        {
            foreach (var level in EducationLevelLabels.Split(education))
            {
                _selectedEducations.Add(level);
            }

            // Legacy free-text: map if it clearly mentions a known level.
            foreach (var level in EducationLevelLabels.ProfileAll)
            {
                if (string.Equals(level, EducationLevelLabels.None, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                if (education.Contains(level, StringComparison.OrdinalIgnoreCase))
                {
                    _selectedEducations.Add(level);
                }
            }
        }

        // Reverse-geocode only when the stored address is missing (not every open).
        if (_homeLat is not null && _homeLng is not null)
        {
            if (!string.IsNullOrWhiteSpace(prefs.HomeAddress) && !LooksLikeCoordinates(prefs.HomeAddress))
            {
                _homeAddress = prefs.HomeAddress!;
            }
            else if (string.IsNullOrWhiteSpace(prefs.HomeAddress) && allowGeocode)
            {
                try
                {
                    using var geoCts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                    var label = await Geocoder.ReverseAsync(_homeLat.Value, _homeLng.Value, geoCts.Token);
                    _homeAddress = string.IsNullOrWhiteSpace(label)
                        ? FormatCoordinateFallback(_homeLat.Value, _homeLng.Value)
                        : label;
                }
                catch
                {
                    _homeAddress = FormatCoordinateFallback(_homeLat.Value, _homeLng.Value);
                }
            }
            else if (!string.IsNullOrWhiteSpace(prefs.HomeAddress))
            {
                _homeAddress = prefs.HomeAddress!;
            }
            else
            {
                _homeAddress = FormatCoordinateFallback(_homeLat.Value, _homeLng.Value);
            }
        }
    }

    private async Task LoadMatchedVacanciesAsync()
    {
        _matchesLoading = true;
        try
        {
            _matchedVacancies = await Api.GetMyMatchedVacanciesAsync();
        }
        catch
        {
            _matchedVacancies = [];
        }
        finally
        {
            _matchesLoading = false;
        }
    }

    private async Task RefreshInsightsLaterAsync()
    {
        while (_insightsRefreshAttempts < 3
               && string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _insightsRefreshAttempts++;
            try
            {
                await Task.Delay(3000);
                var kompas = await Api.GetMyKompasAsync();
                if (kompas is null)
                {
                    continue;
                }

                _kompasState = kompas;
                _insightsStatus = kompas.InsightsStatus ?? "Ready";
                if (kompas.TopMatches is { Count: > 0 })
                {
                    _matchedVacancies = kompas.TopMatches;
                }

                await InvokeAsync(StateHasChanged);
                if (!string.Equals(_insightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                {
                    break;
                }
            }
            catch
            {
                break;
            }
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void OpenUnsubscribe() => _unsubscribeOpen = true;
    private void CloseUnsubscribe() => _unsubscribeOpen = false;
    private void OnUnsubscribeCompleted() => _unsubscribeOpen = true;

    private async Task LoadMasterdataAsync()
    {
        try
        {
            var options = await Api.GetMasterdataAsync(audience: "candidate");
            var branches = options.Where(o => o.Category == MasterdataCategories.Branch).Select(o => o.Label).ToList();
            var licenses = options.Where(o => o.Category == MasterdataCategories.DrivingLicense).Select(o => o.Label).ToList();
            var education = options.Where(o => o.Category == MasterdataCategories.EducationLevel).Select(o => o.Label).ToList();
            if (branches.Count > 0) _branchOptions = branches;
            if (licenses.Count > 0) _licenseOptions = licenses;
            if (education.Count > 0) _educationOptions = education;
        }
        catch
        {
            // keep built-in fallbacks
        }
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private void ToggleLicense(string license, bool selected)
    {
        if (selected)
        {
            _selectedLicenses.Add(license);
        }
        else
        {
            _selectedLicenses.Remove(license);
        }
    }

    private void ToggleAvailability(string key, bool selected)
    {
        if (selected)
        {
            _flexibleTimes = false;
            _availability.Add(key);
        }
        else
        {
            _availability.Remove(key);
        }
