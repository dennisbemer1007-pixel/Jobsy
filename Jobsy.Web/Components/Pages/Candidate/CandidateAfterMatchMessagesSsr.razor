@page "/candidate/applications/{ApplicationId:guid}/after-match/messages-ssr"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment

<PageTitle>@Culture["AfterMatch.Screen10.Hero.Title"] · Lobsy</PageTitle>
<PageSeo Title="@Culture["AfterMatch.Screen10.Hero.Title"]" />
<HeadContent>
    @foreach (var href in PageAssetCatalog.StylesheetsFor(
                  PageAssetCatalog.Area.CandidatePublic | PageAssetCatalog.Area.CandidateApp,
                  "/candidate/applications"))
    {
        <link rel="stylesheet" href="@href" />
    }
    <link rel="stylesheet" href="css/features/sollicitaties-page.css?v=20261024-ndm-pick-slot2" />
    <link rel="stylesheet" href="css/features/na-de-match.css?v=20261027-ndm-messages4" />
    <script src="/js/ndm-messages.js?v=20261027-ndm-messages4" defer></script>
</HeadContent>

@if (_loading)
{
    <PageContentSkeleton Variant="apps" CardCount="2" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (_redirecting)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    [Parameter] public Guid ApplicationId { get; set; }

    private bool _loading = true;
    private bool _redirecting;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        ?? auth.User.FindFirst("email")?.Value;

            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("return", out var returnValues);
            var returnUrl = returnValues.FirstOrDefault();
            query.TryGetValue("thread", out var threadValues);
            Guid? threadId = Guid.TryParse(threadValues.FirstOrDefault(), out var parsedThread)
                ? parsedThread
                : null;

            var data = await AfterMatchMessagesSsrData.LoadAsync(
                Api,
                FeatureFlags,
                Culture,
                Configuration,
                HostEnvironment,
                ApplicationId,
                returnUrl,
                threadId,
                email,
                http.RequestAborted);

            if (data is null)
            {
                _redirecting = true;
                var blazorPath =
                    $"/candidate/applications/{ApplicationId:D}/after-match/blazor?panel=messages";
                http.Response.Redirect(blazorPath);
                return;
            }

            _bodyHtml = AfterMatchMessagesSsrShells.BuildBody(Culture, data, ApplicationId);
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
