@page "/candidate/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Features
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags

<PageTitle>@Culture["CandidateSettings.Title"] · Lobsy</PageTitle>

<div class="panel-page candidate-hub">
    <header class="panel-header">
        <h1>@Culture["CandidateSettings.Title"]</h1>
        <p class="candidate-hub__lead">@Culture["CandidateSettings.Lead"]</p>
    </header>

    <ul class="candidate-hub__list">
        <li>
            <a class="candidate-hub__link" href="/account/mail-instellingen">
                <span class="candidate-hub__link-title">@Culture["CandidateSettings.Mail.Title"]</span>
                <span class="candidate-hub__link-desc">@Culture["CandidateSettings.Mail.Desc"]</span>
            </a>
        </li>
        @if (_proactiveOn)
        {
            <li>
                <a class="candidate-hub__link" href="/candidate/proactive-matching">
                    <span class="candidate-hub__link-title">@Culture["CandidateSettings.Proactive.Title"]</span>
                    <span class="candidate-hub__link-desc">@Culture["CandidateSettings.Proactive.Desc"]</span>
                </a>
            </li>
        }
        @if (_kandidatenkaartOn)
        {
            <li>
                <a class="candidate-hub__link" href="/candidate/kandidatenkaart-instellingen">
                    <span class="candidate-hub__link-title">@Culture["CandidateSettings.Kk.Title"]</span>
                    <span class="candidate-hub__link-desc">@Culture["CandidateSettings.Kk.Desc"]</span>
                </a>
            </li>
        }
        <li>
            <a class="candidate-hub__link" href="/candidate/paspoort?tab=data">
                <span class="candidate-hub__link-title">@Culture["CandidateSettings.Profile.Title"]</span>
                <span class="candidate-hub__link-desc">@Culture["CandidateSettings.Profile.Desc"]</span>
            </a>
        </li>
        <li>
            <a class="candidate-hub__link" href="/candidate/hoe-werkt-lobsy">
                <span class="candidate-hub__link-title">@Culture["CandidateSettings.How.Title"]</span>
                <span class="candidate-hub__link-desc">@Culture["CandidateSettings.How.Desc"]</span>
            </a>
        </li>
    </ul>
</div>

@code {
    private bool _proactiveOn;
    private bool _kandidatenkaartOn;

    protected override async Task OnInitializedAsync()
    {
        var flags = await FeatureFlags.GetAsync();
        _proactiveOn = flags.IsEnabled(PlatformFeature.ProactiveMatching);
        _kandidatenkaartOn = flags.IsEnabled(PlatformFeature.Kandidatenkaart);
    }
}
