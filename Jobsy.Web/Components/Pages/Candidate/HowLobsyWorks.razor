@page "/candidate/hoe-werkt-lobsy"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate,BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Web.Help
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture

<PageTitle>@Culture[HowLobsyRoleGuides.Candidate.TitleKey] · Lobsy</PageTitle>

<HowLobsyGuidePanel Guide="HowLobsyRoleGuides.Candidate"
                    Busy="_busy"
                    Message="_message"
                    OnPrimaryClick="FinishAsync" />

@code {
    private bool _busy;
    private string? _message;

    private async Task FinishAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            await Api.CompleteCandidateHowToAsync();
        }
        catch (Exception ex)
        {
            // Still allow navigation; how-to can be completed later.
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        Navigation.NavigateTo("/");
    }
}
