@page "/candidate/deep-analysis/checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using System.Globalization
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@implements IAsyncDisposable

<PageTitle>@Culture["Deep.Checkout"] · Lobsy</PageTitle>

@{
    var kind = AssessmentKindLabels.ParseOrDefault(_testSlug);
    var qCount = TestDepthRules.Bottom(kind);
    var mins = TestDepthRules.MinutesFor(kind, TestDepthLevel.Bottom);
}

@if (_state is "loading" or "pending")
{
    <TestPageShell Kind="kind"
                   Mode="TestPageShell.ShellMode.Checkout"
                   Deep="true"
                   Eyebrow="@Culture["DeepPay.Title"]"
                   H1="@Culture["DeepPay.Checking"]"
                   Lead="@(_timedOut ? Culture["DeepPay.CheckingLong"] : Culture["DeepPay.CheckingLead"])"
                   TestName="@_testName"
                   Answered="0"
                   TargetCount="qCount"
                   BubbleText="@Culture["Deep.Checkout.Bubble.Checking"]">
        <RailContent>
            <p class="test-rail__zone">@Culture["Deep.Rail.BottomZone"]</p>
        </RailContent>
        <ChildContent>
            <div class="deep-checkout deep-checkout--checking" role="status">
                <div class="deep-checkout__spinner" aria-hidden="true"></div>
                <p class="muted">@Culture["Deep.Checkout.NoDouble"]</p>
                @if (_timedOut && !string.IsNullOrWhiteSpace(_testSlug))
                {
                    <p><a href="@($"/profiel/tests/{_testSlug}")">@Culture["DeepPay.BackToTest"]</a></p>
                }
                @if (_isStub && _checkoutId is Guid stubId)
                {
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => StubPayAsync(stubId)">
                        @Culture["DeepPay.StubFinish"]
                    </button>
                }
            </div>
        </ChildContent>
    </TestPageShell>
}
else if (_state == "paid")
{
    <TestPageShell Kind="kind"
                   Mode="TestPageShell.ShellMode.Checkout"
                   Deep="true"
                   Eyebrow="@Culture["DeepPay.Title"]"
                   H1="@(_isTestUnlock ? Culture["DeepPay.OpenedTitle"] : Culture["DeepPay.PaidTitle"])"
                   Lead="@Culture.Format("Deep.Checkout.PaidLead", _testName)"
                   TestName="@_testName"
                   Answered="0"
                   TargetCount="qCount"
                   BubbleText="@Culture["Deep.Checkout.Bubble.Paid"]">
        <RailContent>
            <p class="test-rail__zone">@(_isTestUnlock ? Culture["Deep.Rail.OpenedReady"] : Culture["Deep.Rail.PaidReady"])</p>
        </RailContent>
        <ChildContent>
            <div class="deep-checkout deep-checkout--paid">
                <span class="deep-checkout__check" aria-hidden="true">✓</span>
                <dl class="deep-pay-receipt">
                    <div><dt>@Culture["DeepPay.Fact.What"]</dt><dd>@Culture.Format("DeepPay.What", _testName)</dd></div>
                    @if (_isTestUnlock)
                    {
                        <div><dt class="visually-hidden">@Culture["DeepPay.Fact.Amount"]</dt><dd>@Culture["DeepPay.PriceFree"]</dd></div>
                    }
                    else
                    {
                        <div><dt>@Culture["DeepPay.Fact.Amount"]</dt><dd>€ @_amountLabel</dd></div>
                    }
                    <div><dt>@Culture["DeepPay.Fact.Date"]</dt><dd>@_paidLocal</dd></div>
                    @if (!string.IsNullOrWhiteSpace(_invoiceNumber))
                    {
                        <div><dt>@Culture["DeepPay.Fact.Invoice"]</dt><dd>@_invoiceNumber</dd></div>
                    }
                </dl>
                @if (_isTestUnlock)
                {
                    <p>@Culture["DeepPay.TestAccountNote"]</p>
                }
                else
                {
                    <p>@Culture["DeepPay.PaidMail"]</p>
                }
                <div class="deep-offer__tiles">
                    <div>
                        <strong>@Culture.Format("Deep.Checkout.TileQs", qCount, mins)</strong>
                        <span>@Culture["Deep.Checkout.TileParts"]</span>
                    </div>
                    <div>
                        <strong>@Culture["Deep.Checkout.TileStop"]</strong>
                        <span>@Culture["Deep.Checkout.TileStopLead"]</span>
                    </div>
                </div>
                <footer class="test-shell__footer">
                    <a href="@($"/profiel/tests/{_testSlug}")">@Culture["DeepPay.Later"]</a>
                    <a class="btn btn-primary" href="@($"/candidate/deep-analysis/{_testSlug}")">@Culture["DeepPay.StartQ1"]</a>
                </footer>
            </div>
        </ChildContent>
    </TestPageShell>
}
else if (_state is "failed" or "cancelled" or "expired")
{
    <TestPageShell Kind="kind"
                   Mode="TestPageShell.ShellMode.Checkout"
                   Deep="true"
                   Eyebrow="@Culture["DeepPay.Title"]"
                   H1="@Culture["DeepPay.FailedTitle"]"
                   Lead="@Culture["Deep.Checkout.FailedLead"]"
                   TestName="@_testName"
                   Answered="0"
                   TargetCount="qCount"
                   BubbleText="@Culture["Deep.Checkout.Bubble.Failed"]">
        <RailContent>
            <p class="test-rail__zone">@Culture["Deep.Rail.BottomZone"]</p>
        </RailContent>
        <ChildContent>
            <div class="deep-checkout deep-checkout--failed">
                <span class="deep-checkout__warn" aria-hidden="true">!</span>
                <ul class="deep-checkout__tips">
                    <li>@Culture["Deep.Checkout.TipRetry"]</li>
                    <li>@Culture["Deep.Checkout.TipKept"]</li>
                    <li>@Culture["Deep.Checkout.TipHelp"]</li>
                </ul>
                <footer class="test-shell__footer">
                    <a href="@($"/profiel/tests/{_testSlug}")">@Culture["DeepPay.BackToTest"]</a>
                    <a class="btn btn-primary" href="@($"/candidate/deep-analysis/{_testSlug}")">@Culture["DeepPay.RetryPay"]</a>
                </footer>
            </div>
        </ChildContent>
    </TestPageShell>
}
else
{
    <div class="test-page journey-page">
        <div class="test-shell__card">
            <h1>@Culture["DeepPay.NotFound"]</h1>
            <p><a href="/profiel">@Culture["DeepPay.ToMyTests"]</a></p>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public Guid? CheckoutId { get; set; }
    [SupplyParameterFromQuery] public string? PaymentId { get; set; }
    [SupplyParameterFromQuery] public string? Kind { get; set; }

    private string _state = "loading";
    private string _testSlug = "competence";
    private string _testName = "";
    private string _amountLabel = "";
    private string? _invoiceNumber;
    private string _paidLocal = "";
    private bool _isStub;
    private bool _isTestUnlock;
    private bool _busy;
    private bool _timedOut;
    private Guid? _checkoutId;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        _pollCts = new CancellationTokenSource();
        try
        {
            if (CheckoutId is Guid id)
            {
                _checkoutId = id;
            }
            else if (!string.IsNullOrWhiteSpace(PaymentId))
            {
                var shim = await Api.GetDeepAnalysisCheckoutByPaymentIdAsync(PaymentId);
                if (shim is null)
                {
                    _state = "not_found";
                    return;
                }

                _checkoutId = shim.CheckoutId;
            }
            else
            {
                _state = "not_found";
                return;
            }

            await RefreshAsync(_pollCts.Token);
            if (_state == "pending")
            {
                _ = PollAsync(_pollCts.Token);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            _state = "not_found";
        }
    }

    private async Task PollAsync(CancellationToken ct)
    {
        var started = DateTime.UtcNow;
        while (!ct.IsCancellationRequested && _state == "pending")
        {
            if (DateTime.UtcNow - started > TimeSpan.FromSeconds(60))
            {
                _timedOut = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            try
            {
                await Task.Delay(2000, ct);
                await RefreshAsync(ct);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
                return;
            }
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        if (_checkoutId is not Guid id)
        {
            _state = "not_found";
            return;
        }

        var status = await Api.GetDeepAnalysisCheckoutStatusAsync(id, ct);
        if (status is null)
        {
            _state = "not_found";
            return;
        }

        _state = status.Status;
        _testSlug = status.TestSlug;
        _testName = AssessmentKindLabels.ToDutch(AssessmentKindLabels.ParseOrDefault(status.TestSlug));
        _amountLabel = (status.TotalCents / 100m).ToString("0.00", CultureInfo.GetCultureInfo("nl-NL"));
        _invoiceNumber = status.InvoiceNumber;
        _isStub = status.IsStub;
        _isTestUnlock = DeepTestFinanceRules.IsTestUnlock(status.PaymentMethod);
        if (status.PaidAtUtc is DateTime paid)
        {
            var amsterdam = TimeZoneInfo.FindSystemTimeZoneById(
                OperatingSystem.IsWindows() ? "W. Europe Standard Time" : "Europe/Amsterdam");
            _paidLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(paid, DateTimeKind.Utc), amsterdam)
                .ToString("dd-MM-yyyy HH:mm", CultureInfo.GetCultureInfo("nl-NL"));
        }
    }

    private async Task StubPayAsync(Guid checkoutId)
    {
        _busy = true;
        try
        {
            await Api.StubPayDeepAnalysisCheckoutAsync(checkoutId);
            await RefreshAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            _state = "failed";
        }
        finally
        {
            _busy = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
