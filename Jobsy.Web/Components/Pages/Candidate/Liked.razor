@page "/candidate/liked"
@* KB-FALLBACK(C): gate with PlatformFeature.Employers when paspoort 01 lands; 07 redesigns in place (no CandidateJobListTabs) *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Core.Rules.KandidaatBanen
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Kb.Saved.Title"] · Lobsy</PageTitle>

<AuthorizeView Roles="Candidate">
    <Authorized>
        <div class="panel-page kb-saved">
            <header class="panel-header">
                <div>
                    <h1>@Culture["Kb.Saved.Title"]</h1>
                    <p class="login-lead">@Culture["Kb.Saved.Lead"]</p>
                </div>
            </header>

            <CandidateJobListTabs />
            <CandidateSavedSubnav />

            @if (_loading)
            {
                <PageContentSkeleton Variant="cards" CardCount="4" LoadingLabel="@Culture["Common.Loading"]" />
            }
            else if (_items.Count == 0)
            {
                <p class="state-message">@Culture["Saved.EmptyLikes"] <a href="@KbRoutes.Map">@Culture["Saved.Discover"]</a>.</p>
            }
            else
            {
                <div class="kb-saved__toolbar">
                    <div class="kb-saved__filters" role="group">
                        <button type="button" class="kb-chip @(_filter == "all" ? "is-selected" : null)" @onclick='() => SetFilter("all")'>
                            @Culture["Kb.Saved.FilterAll"] · @_items.Count
                        </button>
                        <button type="button" class="kb-chip @(_filter == "open" ? "is-selected" : null)" @onclick='() => SetFilter("open")'>
                            @Culture["Kb.Saved.FilterOpen"] · @_countOpen
                        </button>
                        <button type="button" class="kb-chip @(_filter == "closed" ? "is-selected" : null)" @onclick='() => SetFilter("closed")'>
                            @Culture["Kb.Saved.FilterClosed"] · @_countClosed
                        </button>
                    </div>
                    <label class="kb-saved__sort">
                        <span class="visually-hidden">@Culture["Kb.Saved.SortBestFit"]</span>
                        <select @bind="_sort" @bind:after="ApplyFilter">
                            <option value="fit">@Culture["Kb.Saved.SortBestFit"]</option>
                            <option value="newest">@Culture["Kb.Saved.SortNewest"]</option>
                            <option value="closing">@Culture["Kb.Saved.SortClosing"]</option>
                        </select>
                    </label>
                </div>

                <div class="kb-saved__grid">
                    @foreach (var item in _filtered)
                    {
                        var closed = IsClosed(item);
                        <article class="kb-saved-card @(closed ? "kb-saved-card--closed" : null)">
                            <div class="kb-saved-card__media">
                                <a href="@($"/vacancies/{item.VacancyId}")">
                                    <VacancyPhoto Src="@item.ImageUrl"
                                                  FallbackSrc="@item.CompanyLogoUrl"
                                                  VacancyId="item.VacancyId"
                                                  Class="kb-saved-card__photo"
                                                  Sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.SavedStateKind)
                                     && !string.Equals(item.SavedStateKind, nameof(KbSavedJobStateKind.Hidden), StringComparison.Ordinal))
                                {
                                    <span class="kb-saved-card__state kb-saved-card__state--@KbLabels.SavedStateCss(item.SavedStateKind)">
                                        @KbLabels.SavedStateLabel(Culture, item.SavedStateKind, item.DaysUntilEnd)
                                    </span>
                                }
                                <button type="button"
                                        class="kb-saved-card__heart"
                                        aria-label="@Culture["Kb.Saved.Remove"]"
                                        @onclick="() => UnsaveAsync(item)">
                                    ♥
                                </button>
                            </div>
                            <div class="kb-saved-card__body">
                                <h2 class="kb-saved-card__title">
                                    <a href="@($"/vacancies/{item.VacancyId}")">@item.VacancyTitle</a>
                                </h2>
                                <p class="kb-saved-card__company">
                                    @item.CompanyName@(string.IsNullOrWhiteSpace(item.LocationLabel) ? "" : $" · {item.LocationLabel}")
                                </p>
                                <p class="kb-saved-card__meta">
                                    @if (item.HoursPerWeekMin.HasValue || item.HoursPerWeekMax.HasValue)
                                    {
                                        <span>@FormatHours(item.HoursPerWeekMin, item.HoursPerWeekMax)</span>
                                    }
                                    <span>@string.Format(Culture["Kb.Saved.SavedOn"], ShortDate(item.CreatedAt))</span>
                                </p>
                                @if (item.FitGateClosed)
                                {
                                    <a class="kb-fit kb-fit--gate" href="@KbRoutes.PaspoortTests">@Culture["Kb.Fit.Gate"]</a>
                                }
                                else if (item.FitPercent is int pct)
                                {
                                    <span class="kb-fit kb-fit--@(item.FitBand?.ToLowerInvariant() ?? "some")">
                                        @string.Format(Culture["Kb.Fit.Percent"], pct)
                                    </span>
                                }
                            </div>
                            <div class="kb-saved-card__footer">
                                @if (closed)
                                {
                                    <a class="kb-saved-card__action" href="@SimilarHref(item)">@Culture["Kb.Saved.Similar"]</a>
                                    <button type="button" class="kb-saved-card__remove" @onclick="() => UnsaveAsync(item)">@Culture["Kb.Saved.Remove"]</button>
                                }
                                else if (item.HasApplied)
                                {
                                    <span class="kb-saved-card__applied">@Culture["Kb.Saved.Applied"]</span>
                                    <a class="kb-saved-card__link" href="@KbRoutes.Applications">@Culture["Kb.Saved.View"]</a>
                                }
                                else
                                {
                                    <a class="btn-compact kb-saved-card__apply" href="@($"/vacancies/{item.VacancyId}")">@Culture["Kb.Saved.Apply"]</a>
                                    <a class="kb-saved-card__link" href="@($"/vacancies/{item.VacancyId}")">@Culture["Kb.Saved.View"]</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (_undoItem is not null)
            {
                <div class="kb-saved__toast" role="status">
                    <span>@Culture["Kb.Saved.UndoToast"]</span>
                    <button type="button" @onclick="UndoUnsaveAsync">@Culture["Kb.Saved.Undo"]</button>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="saved-gate">
            <header class="saved-gate__header">
                <h1>@Culture["Kb.Saved.Title"]</h1>
            </header>
            <div class="saved-gate__body">
                <div class="saved-gate__hero" aria-hidden="true">
                    <div class="saved-gate__door">
                        <span class="saved-gate__sofa"></span>
                    </div>
                </div>
                <h2>@Culture["Saved.Headline"]</h2>
                <p>@Culture["Saved.Lead"]</p>
                <div class="saved-gate__actions">
                    <a class="provider-btn provider-btn--google"
                       href="@($"/account/external/google?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">G</span>
                        @Culture["Saved.ContinueGoogle"]
                    </a>
                    <a class="provider-btn"
                       href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        @Culture["Saved.ContinueApple"]
                    </a>
                    <a class="login-submit saved-gate__email"
                       href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        @Culture["Saved.ContinueEmail"]
                    </a>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string PersistKey = "candidateLiked";
    private List<CandidateEngagementItem> _items = [];
    private List<CandidateEngagementItem> _filtered = [];
    private bool _loading = true;
    private bool _restored;
    private string _filter = "all";
    private string _sort = "newest";
    private int _countOpen;
    private int _countClosed;
    private CandidateEngagementItem? _undoItem;
    private PersistingComponentStateSubscription _persistSubscription;
    private static readonly System.Globalization.CultureInfo Dutch = new("nl-NL");

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<List<CandidateEngagementItem>>(PersistKey, out var saved) && saved is not null)
        {
            _items = saved;
            RefreshCounts();
            ApplyFilter();
            _loading = false;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, _items);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true || !state.User.IsInRole("Candidate"))
        {
            _loading = false;
            return;
        }

        if (_restored) return;

        try
        {
            _items = (await Api.GetMyLikesAsync()).ToList();
            RefreshCounts();
            ApplyFilter();
        }
        catch { _items = []; }
        finally { _loading = false; }
    }

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMyLikesAsync()).ToList();
            RefreshCounts();
            ApplyFilter();
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
        ApplyFilter();
    }

    private void RefreshCounts()
    {
        _countOpen = _items.Count(i => !IsClosed(i));
        _countClosed = _items.Count(IsClosed);
    }

    private void ApplyFilter()
    {
        IEnumerable<CandidateEngagementItem> q = _filter switch
        {
            "open" => _items.Where(i => !IsClosed(i)),
            "closed" => _items.Where(IsClosed),
            _ => _items
        };

        q = _sort switch
        {
            "fit" => q.OrderByDescending(i => i.FitPercent ?? 0),
            "closing" => q.OrderBy(i => i.DaysUntilEnd ?? int.MaxValue),
            _ => q.OrderByDescending(i => i.CreatedAt)
        };

        _filtered = q.ToList();
    }

    private static bool IsClosed(CandidateEngagementItem item)
        => string.Equals(item.SavedStateKind, nameof(KbSavedJobStateKind.Closed), StringComparison.OrdinalIgnoreCase)
           || string.Equals(item.SavedStateKind, nameof(KbSavedJobStateKind.Fulfilled), StringComparison.OrdinalIgnoreCase);

    private string SimilarHref(CandidateEngagementItem item)
        => item.CategoryId is Guid cat
            ? $"{KbRoutes.Map}?categorie={cat:D}"
            : KbRoutes.Map;

    private async Task UnsaveAsync(CandidateEngagementItem item)
    {
        _undoItem = item;
        _items.Remove(item);
        RefreshCounts();
        ApplyFilter();
        try { await Api.SetLikedAsync(item.VacancyId, liked: false); }
        catch { /* toast still allows undo */ }
    }

    private async Task UndoUnsaveAsync()
    {
        if (_undoItem is null) return;
        var item = _undoItem;
        _undoItem = null;
        _items.Insert(0, item);
        RefreshCounts();
        ApplyFilter();
        try { await Api.SetLikedAsync(item.VacancyId, liked: true); }
        catch { }
    }

    private static string FormatHours(int? min, int? max)
    {
        if (min is int a && max is int b && a != b) return $"{a}-{b} uur";
        return $"{min ?? max} uur";
    }

    private string ShortDate(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var culture = Culture.Language switch
        {
            "en" => new System.Globalization.CultureInfo("en-GB"),
            "pl" => new System.Globalization.CultureInfo("pl-PL"),
            "ro" => new System.Globalization.CultureInfo("ro-RO"),
            "ar" => new System.Globalization.CultureInfo("ar-SA"),
            _ => Dutch
        };
        return local.ToString("d MMM", culture).Replace(".", "");
    }
}
