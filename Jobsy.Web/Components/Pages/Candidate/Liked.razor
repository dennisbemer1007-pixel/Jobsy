@page "/candidate/liked"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Saved.Title"] · Lobsy</PageTitle>

<AuthorizeView Roles="Candidate">
    <Authorized>
        <div class="panel-page">
            <header class="panel-header">
                <div>
                    <h1>@Culture["Saved.Title"]</h1>
                    <p class="login-lead">@Culture["Saved.LeadLoggedIn"]</p>
                </div>
            </header>

            <CandidateSavedSubnav />

            @if (_loading)
            {
                <PageContentSkeleton Variant="cards" CardCount="4" LoadingLabel="@Culture["Common.Loading"]" />
            }
            else if (_items.Count == 0)
            {
                <p class="state-message">@Culture["Saved.EmptyLikes"] <a href="/">@Culture["Saved.Discover"]</a>.</p>
            }
            else
            {
                <div class="vacancy-list vacancy-list--cards vacancy-list--saved">
                    @foreach (var item in _items)
                    {
                        <article class="job-card">
                            <a class="job-card__stretch-link" href="@($"/vacancies/{item.VacancyId}")" aria-label="@item.VacancyTitle"></a>
                            <a class="job-card__media" href="@($"/vacancies/{item.VacancyId}")">
                                <VacancyPhoto Src="@item.ImageUrl"
                                              FallbackSrc="@item.CompanyLogoUrl"
                                              VacancyId="item.VacancyId"
                                              Class="job-card__photo"
                                              Sizes="(max-width: 700px) 50vw, 360px" />
                                <div class="job-card__overlay">
                                    <h2>@item.VacancyTitle</h2>
                                </div>
                            </a>
                            <div class="job-card__footer">
                                <p class="job-card__company">@item.CompanyName</p>
                                <p class="job-card__location">@Culture.Format("Saved.LikedOn", item.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy"))</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="saved-gate">
            <header class="saved-gate__header">
                <h1>@Culture["Saved.Title"]</h1>
            </header>
            <div class="saved-gate__body">
                <div class="saved-gate__hero" aria-hidden="true">
                    <div class="saved-gate__door">
                        <span class="saved-gate__sofa"></span>
                    </div>
                </div>
                <h2>@Culture["Saved.Headline"]</h2>
                <p>@Culture["Saved.Lead"]</p>
                <div class="saved-gate__actions">
                    <a class="provider-btn provider-btn--google"
                       href="@($"/account/external/google?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        <span class="provider-btn__icon provider-btn__icon--google" aria-hidden="true">G</span>
                        @Culture["Saved.ContinueGoogle"]
                    </a>
                    <a class="provider-btn"
                       href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        @Culture["Saved.ContinueApple"]
                    </a>
                    <a class="login-submit saved-gate__email"
                       href="@($"/login?returnUrl={Uri.EscapeDataString("/candidate/liked")}")">
                        @Culture["Saved.ContinueEmail"]
                    </a>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string PersistKey = "candidateLiked";
    private List<CandidateEngagementItem> _items = [];
    private bool _loading = true;
    private bool _restored;
    private PersistingComponentStateSubscription _persistSubscription;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<List<CandidateEngagementItem>>(PersistKey, out var saved) && saved is not null)
        {
            _items = saved;
            _loading = false;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, _items);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true || !state.User.IsInRole("Candidate"))
        {
            _loading = false;
            return;
        }

        if (_restored)
        {
            return;
        }

        try
        {
            _items = (await Api.GetMyLikesAsync()).ToList();
        }
        catch
        {
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMyLikesAsync()).ToList();
        }
        catch
        {
            // keep current list
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
    }
}
