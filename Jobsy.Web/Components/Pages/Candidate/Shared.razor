@page "/candidate/shared"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Saved.TabShared"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Saved.Title"]</h1>
            <p class="login-lead">@Culture["Saved.SharedLead"]</p>
        </div>
    </header>

    <CandidateSavedSubnav />

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="state-message">@Culture["Saved.EmptyShared"] <a href="/">@Culture["Saved.ToMap"]</a>.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var item in _items)
            {
                <a class="table-row table-row--link" href="@($"/vacancies/{item.VacancyId}")">
                    <div>
                        <strong>@item.VacancyTitle</strong>
                        <span class="muted">@item.CompanyName · @(item.Channel ?? "—")</span>
                    </div>
                    <span class="muted">@item.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<CandidateEngagementItem> _items = [];
    private bool _loading = true;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Api.GetMySharesAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMySharesAsync()).ToList();
        }
        catch
        {
            // keep current list
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
