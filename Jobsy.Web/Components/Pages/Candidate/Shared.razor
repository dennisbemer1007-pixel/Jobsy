@page "/candidate/shared"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Web.Localization
@using Jobsy.Web.Components.Shared
@inject JobsyApiClient Api
@inject CultureState Culture
@inject PersistentComponentState Persist
@implements IDisposable

<PageTitle>@Culture["Saved.TabShared"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Saved.Title"]</h1>
            <p class="login-lead">@Culture["Saved.SharedLead"]</p>
        </div>
    </header>

    <CandidateSavedSubnav />

    @if (_loading)
    {
        <PageContentSkeleton Variant="apps" CardCount="3" LoadingLabel="@Culture["Common.Loading"]" />
    }
    else if (_groups.Count == 0)
    {
        <p class="state-message">@Culture["Saved.EmptyShared"] <a href="/">@Culture["Saved.ToMap"]</a>.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var group in _groups)
            {
                <a class="table-row table-row--link" href="@($"/vacancies/{group.VacancyId}")">
                    <div>
                        <strong>@group.VacancyTitle</strong>
                        <span class="muted">@group.CompanyName · @SharedWithLabel(group.ShareCount)</span>
                    </div>
                    <span class="muted">@group.LastSharedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private const string PersistKey = "candidateShared";
    private List<CandidateEngagementItem> _items = [];
    private List<SharedVacancyGroup> _groups = [];
    private bool _loading = true;
    private bool _restored;
    private PersistingComponentStateSubscription _persistSubscription;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _persistSubscription = Persist.RegisterOnPersisting(PersistState);
        if (Persist.TryTakeFromJson<List<CandidateEngagementItem>>(PersistKey, out var saved) && saved is not null)
        {
            _items = saved;
            _groups = GroupShares(_items);
            _loading = false;
            _restored = true;
        }
    }

    private Task PersistState()
    {
        Persist.PersistAsJson(PersistKey, _items);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_restored)
        {
            return;
        }

        try
        {
            _items = (await Api.GetMySharesAsync()).ToList();
            _groups = GroupShares(_items);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Groups share rows by vacancy id for “gedeeld met N personen”.</summary>
    internal static List<SharedVacancyGroup> GroupShares(IEnumerable<CandidateEngagementItem> items)
        => items
            .GroupBy(i => i.VacancyId)
            .Select(g =>
            {
                var first = g.OrderByDescending(x => x.CreatedAt).First();
                return new SharedVacancyGroup(
                    g.Key,
                    first.VacancyTitle,
                    first.CompanyName,
                    g.Count(),
                    g.Max(x => x.CreatedAt));
            })
            .OrderByDescending(g => g.LastSharedAt)
            .ToList();

    private string SharedWithLabel(int count)
        => count <= 1
            ? Culture["Saved.SharedWithOne"]
            : Culture.Format("Saved.SharedWithMany", count);

    private async void OnCultureChanged()
    {
        try
        {
            _items = (await Api.GetMySharesAsync()).ToList();
            _groups = GroupShares(_items);
        }
        catch
        {
            // keep current list
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _persistSubscription.Dispose();
    }

    internal sealed record SharedVacancyGroup(
        Guid VacancyId,
        string VacancyTitle,
        string CompanyName,
        int ShareCount,
        DateTime LastSharedAt);
}
