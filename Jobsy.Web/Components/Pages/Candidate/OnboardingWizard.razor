    private void ClearMiniAnswersBeforeStepChange()
    {
        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _currentQuestion = 0;
    }

    private async Task PrepareMiniAsync()
    {
        await DisposeMiniAutosaveAsync();
        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _miniBlockQuestionIds = [];
        _miniQuestions = [];
        _currentQuestion = 0;
        if (_step is < 7 or > 10)
        {
            _preparedMiniStep = 0;
            return;
        }

        var miniAutosaveEnabled = Draft.HasConsent;
        if (_step == 7 && !Draft.HasConsent)
        {
            miniAutosaveEnabled = false;
        }
        else if (!Draft.HasConsent)
        {
            _preparedMiniStep = 0;
            return;
        }

        if (_preparedMiniStep != _step)
        {
            _miniFlowEpoch++;
            _preparedMiniStep = _step;
        }

        Dictionary<string, int>? answers;
        IEnumerable<(int Id, string Key)> catalog;
        int[] questionIds;
        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        switch (_step)
        {
            case 7:
                var competency = await Api.GetMyCompetenciesAsync();
                answers = competency?.Answers;
                var compVersion = ResolveQuickScanVersion(competency?.QuickScanVersion, testsV2);
                _miniQuickScanVersion = compVersion;
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Competence, compVersion);
                catalog = AssessmentQuickScanCatalog.CompetenceQuestions(compVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            case 8:
                var career = await Api.GetMyCareerInterestsAsync();
                answers = career?.Answers;
                var careerVersion = ResolveQuickScanVersion(career?.QuickScanVersion, testsV2);
                _miniQuickScanVersion = careerVersion;
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Career, careerVersion);
                catalog = AssessmentQuickScanCatalog.CareerQuestions(careerVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            case 9:
                var culture = await Api.GetMyCultureAsync();
                answers = culture?.Answers;
                var cultureVersion = ResolveQuickScanVersion(culture?.QuickScanVersion, testsV2);
                _miniQuickScanVersion = cultureVersion;
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Culture, cultureVersion);
                catalog = AssessmentQuickScanCatalog.CultureQuestions(cultureVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            default:
                var values = await Api.GetMyValuesAsync();
                answers = values?.Answers;
                var valuesVersion = ResolveQuickScanVersion(values?.QuickScanVersion, testsV2);
                _miniQuickScanVersion = valuesVersion;
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Values, valuesVersion);
                catalog = AssessmentQuickScanCatalog.ValuesQuestions(valuesVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
        }

        foreach (var answer in answers ?? [])
        {
            if (int.TryParse(answer.Key, out var id)
                && questionIds.Contains(id)
                && answer.Value is >= 1 and <= 5)
            {
                _serverAnswers[id] = answer.Value;
            }
        }
        _miniBlockQuestionIds = questionIds;
        foreach (var id in questionIds)
        {
            if (_serverAnswers.ContainsKey(id)) _lockedIds.Add(id);
        }

        var catalogById = catalog.ToDictionary(item => item.Id);
        _miniQuestions = questionIds
            .Where(catalogById.ContainsKey)
            .Select(id => new OnboardingMiniTest.MiniQuestion(id, catalogById[id].Key))
            .ToList();
        var visible = OnboardingMiniBlockCompletion.MergeVisible(_step, _miniQuickScanVersion, _serverAnswers, _miniAnswers);
        if (_miniArrivedViaBack && _miniQuestions.Count > 0)
        {
            _currentQuestion = _miniQuestions.Count - 1;
        }
        else
        {
            _currentQuestion = OnboardingMiniBlockCompletion.FirstUnansweredMiniIndex(_step, _miniQuickScanVersion, visible);
        }
        if (miniAutosaveEnabled)
        {
            var kind = OnboardingMiniBlockCompletion.AssessmentKindForWizardStep(_step);
            var autosaveContext = new MiniBlockAutosaveContext(
                _step,
                kind,
                _miniQuickScanVersion,
                new Dictionary<int, int>(_serverAnswers));
            _autosave = new QuestionnaireAutosave(async (draft, cancellationToken) =>
            {
                await PersistMiniBlockAnswersAsync(autosaveContext, draft, cancellationToken);
            }, onChanged: null, debounceMs: QuestionnaireAutosave.DefaultDebounceMs);
        }
        else
        {
            _autosave = null;
        }
    }

    private async Task DisposeMiniAutosaveAsync()
    {
        if (_autosave is null)
        {
            return;
        }

        var autosave = _autosave;
        _autosave = null;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(12));
            await autosave.FlushAsync(timeout.Token);
        }
        catch
        {
            // Best effort; step transition must not hang the circuit.
        }

        try
        {
            await autosave.DisposeAsync();
        }
        catch
        {
        }
    }

    private Task DeferredTryAutoAdvanceAsync()
    {
        var generation = Volatile.Read(ref _stepTransitionGeneration);
        return InvokeAsync(async () =>
        {
            if (generation != Volatile.Read(ref _stepTransitionGeneration))
            {
                return;
            }

            try
            {
                await TryAutoAdvanceEmptyMiniStepAsync();
            }
            catch (Exception ex)
            {
                _error = UserFacing.Describe(ex);
                _saveError = true;
                await SafeStateHasChangedAsync();
            }
        });
    }

    private async Task<bool> FlushBeforeLeavingStepAsync()
    {
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
        var token = timeout.Token;
        var pending = new List<Task>();
        if (_step <= 6)
        {
            pending.Add(SaveProfileAsync(token));
        }

        if (_step == 6)
        {
            pending.Add(SaveDreamAsync());
        }

        if (_step >= 7 && _autosave is not null)
        {
            pending.Add(_autosave.FlushAsync(token));
        }

        if (pending.Count == 0)
        {
            return true;
        }

        try
        {
            await Task.WhenAll(pending);
            return true;
        }
        catch (OperationCanceledException)
        {
            // Proceed with navigation; autosave will retry on next edit or dispose flush.
            return true;
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
            return false;
        }
    }

    private async Task TryAutoAdvanceEmptyMiniStepAsync()
    {
        if (_miniArrivedViaBack || _welcome || _finish)
        {
            return;
        }

        if (_step is < 7 or > 10)
        {
            return;
        }

        if (_step == 7 && !Draft.HasConsent)
        {
            return;
        }

        if (_miniQuestions.Count > 0)
        {
            if (OnboardingMiniBlockCompletion.IsMiniBlockComplete(_step, _miniQuickScanVersion, MiniVisibleAnswers))
            {
                if (_step == 7)
                {
                    await LoadEarlyStrengthAsync();
                    _earlyMoment = EarlyRewardMoment.FirstInsight;
                    RequestStepScrollReset();
                    return;
                }

                await FinishMiniAsync();
            }

            return;
        }

        if (_step == 7 && Draft.HasConsent && await CompetencyMiniCompleteAsync())
        {
            await LoadEarlyStrengthAsync();
            _earlyMoment = EarlyRewardMoment.FirstInsight;
            RequestStepScrollReset();
            return;
        }

        _busy = true;
        try
        {
            if (_step == 10)
            {
                if (!await TryEnterKompasWhenAllMiniTestsCompleteAsync())
                {
                    return;
                }

                return;
            }

            _step++;
            _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
            await PrepareMiniAsync();
            RequestStepScrollReset();
            await DeferredTryAutoAdvanceAsync();
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// When saved progress points at a finished mini block, move to the first open block (7→10).
    /// Never leaves the candidate on a completed test after reload.
    /// </summary>
    private async Task EnsureOnFirstIncompleteMiniBlockAsync()
    {
        if (_welcome || _finish || _step is < 7 or > 10 || !Draft.HasConsent)
        {
            return;
        }

        if (_autosave is not null)
        {
            await _autosave.FlushAsync();
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        var firstOpen = await FindFirstIncompleteMiniWizardStepAsync(testsV2);
        if (firstOpen is null)
        {
            await EnterKompasFromCompletedMiniTestsAsync();
            return;
        }

        if (_step == firstOpen.Value)
        {
            return;
        }

        var currentComplete = await IsMiniBlockCompleteForRoutingAsync(_step, testsV2);
        if (!currentComplete && _step < firstOpen.Value)
        {
            return;
        }

        ClearMiniAnswersBeforeStepChange();
        _step = firstOpen.Value;
        _state = await Api.SaveMyOnboardingProgressAsync(_step);
        await PrepareMiniAsync();
        RequestStepScrollReset();
    }

    private async Task<int?> FindFirstIncompleteMiniWizardStepAsync(bool testsV2)
    {
        foreach (var step in new[] { 7, 8, 9, 10 })
        {
            if (!await IsMiniBlockCompleteForRoutingAsync(step, testsV2))
            {
                return step;
            }
        }

        return null;
    }

    private async Task<bool> TryEnterKompasWhenAllMiniTestsCompleteAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.FlushAsync();
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        if (!OnboardingMiniBlockCompletion.IsMiniBlockComplete(_step, _miniQuickScanVersion, MiniVisibleAnswers))
        {
            return false;
        }

        var firstOpen = await FindFirstIncompleteMiniWizardStepAsync(testsV2);
        if (firstOpen is int step)
        {
            ClearMiniAnswersBeforeStepChange();
            _step = step;
            await PrepareMiniAsync();
            RequestStepScrollReset();
            return false;
        }

        await EnterKompasFromCompletedMiniTestsAsync();
        return true;
    }

    private async Task EnterKompasFromCompletedMiniTestsAsync()
    {
        await FinalizeApplyReadinessAsync();
        _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
        _finish = true;
        _state = await Api.GetMyOnboardingAsync() ?? _state;
        if (_finaleV2)
        {
            await LoadFinaleContextAsync();
        }
    }

    private async Task<bool> IsMiniBlockCompleteForRoutingAsync(int step, bool testsV2)
    {
        if (_step == step && _miniBlockQuestionIds.Length > 0 && Draft.HasConsent)
        {
            if (OnboardingMiniBlockCompletion.IsMiniBlockComplete(step, _miniQuickScanVersion, MiniVisibleAnswers))
            {
                return true;
            }
        }

        var answers = await LoadMiniAnswersForStepAsync(step);
        var version = ResolveQuickScanVersion(answers.version, testsV2);
        return OnboardingMiniBlockCompletion.IsMiniBlockComplete(step, version, answers.answers);
    }

    private async Task<(Dictionary<int, int> answers, int? version)> LoadMiniAnswersForStepAsync(int step)
    {
        switch (step)
        {
            case 8:
            {
                var row = await Api.GetMyCareerInterestsAsync();
                return (ParseMiniAnswers(row?.Answers), row?.QuickScanVersion);
            }
            case 9:
            {
                var row = await Api.GetMyCultureAsync();
                return (ParseMiniAnswers(row?.Answers), row?.QuickScanVersion);
            }
            case 10:
            {
                var row = await Api.GetMyValuesAsync();
                return (ParseMiniAnswers(row?.Answers), row?.QuickScanVersion);
            }
            default:
            {
                var row = await Api.GetMyCompetenciesAsync();
                return (ParseMiniAnswers(row?.Answers), row?.QuickScanVersion);
            }
        }
    }

    private string QuestionText(OnboardingMiniTest.MiniQuestion question) => Culture[question.TextKey];

    private IReadOnlyDictionary<int, int> MiniVisibleAnswers
    {
        get
        {
            if (_step is < 7 or > 10 || _miniBlockQuestionIds.Length == 0)
            {
                return _miniAnswers;
            }

            return OnboardingMiniBlockCompletion.MergeVisible(_step, _miniQuickScanVersion, _serverAnswers, _miniAnswers);
        }
    }

    private static IReadOnlyDictionary<int, int> FilterMiniAnswers(
        IReadOnlyDictionary<int, int> source,
        IReadOnlySet<int> allowed)
    {
        if (allowed.Count == 0)
        {
            return source;
        }

        var filtered = new Dictionary<int, int>();
        foreach (var (id, value) in source)
        {
            if (allowed.Contains(id))
            {
                filtered[id] = value;
            }
        }

        return filtered;
    }

    private Task AnswerAsync(int id, int value)
    {
        _miniAnswers[id] = value;
        if (_autosave is not null)
        {
            _ = SaveMiniQuietAsync(id, value);
        }

        _ = InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async Task FinishMiniAsync()
    {
        if (_step == 7)
        {
            _busy = true;
            try
            {
                if (_autosave is not null)
                {
                    await _autosave.FlushAsync();
                }

                await LoadEarlyStrengthAsync();
                _earlyMoment = EarlyRewardMoment.FirstInsight;
                RequestStepScrollReset();
            }
            catch (Exception ex)
            {
                _error = UserFacing.Describe(ex);
            }
            finally
            {
                _busy = false;
            }

            return;
        }

        if (_autosave is not null)
        {
            await _autosave.FlushAsync();
        }

        await NextAsync(fromMiniTestFinish: true);
    }

    private async Task SaveMiniQuietAsync(int id, int value)
    {
        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch
        {
            // The answer is already on screen; leaving the step still flushes.
        }
    }

    private void ExpandQuestion(int index) => _currentQuestion = index;

    private async Task AcceptConsentAsync()
    {
        var profile = await Api.AcceptTestAiConsentAsync();
        Draft.HasConsent = profile?.TestAiConsentAt is not null;
        if (Draft.HasConsent)
        {
            Interlocked.Increment(ref _stepTransitionGeneration);
            await PrepareMiniAsync();
            await EnsureOnFirstIncompleteMiniBlockAsync();
            RequestStepScrollReset();
            await DeferredTryAutoAdvanceAsync();
        }
        else _error = Culture["Onboarding.Consent.Failed"];
    }

    private async void OnGratisDnaMerged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    Draft.HasConsent = profile.TestAiConsentAt is not null;
                }

                if (!_loading && !_welcome && !_finish && _step is >= 7 and <= 10)
                {
                    await RefreshJourneyCompletionAsync();
                    await PrepareMiniAsync();
                    await DeferredTryAutoAdvanceAsync();
                }

                await SafeStateHasChangedAsync();
            });
        }
        catch
        {
            // Reload is best effort.
        }
    }

    private void ScheduleProfileSave()
    {
        if (_loading || _profileAutosave is null || _step <= 10)
        {
            return;
        }

        _profileAutosave.ScheduleSave();
    }

    private async Task<bool> TryImportClientStepAsync()
    {
        try
        {
            var mounted = await Js.InvokeAsync<bool>("jobsyOnboardingClient.isStepMounted", _step);
            if (!mounted)
            {
                _error = Culture["Onboarding.ClientFormNotReady"];
                return false;
            }

            var json = await Js.InvokeAsync<string>("jobsyOnboardingClient.collect", _step);
            if (string.IsNullOrWhiteSpace(json))
            {
                _error = Culture["Onboarding.ClientFormNotReady"];
                return false;
            }

            if (_step is >= 1 and <= 6)
            {
                OnboardingClientStepBridge.Apply(_step, Draft, json);
            }
            else if (_step == 7 && !Draft.HasConsent)
            {
                Draft.ConsentRequested = OnboardingClientStepBridge.ParseStep7Consent(json);
            }
            else if (_step is >= 7 and <= 10 && Draft.HasConsent)
            {
                foreach (var (id, value) in OnboardingClientStepBridge.ParseMiniAnswers(json))
                {
                    _miniAnswers[id] = value;
                }
            }

            return true;
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            return false;
        }
    }

    private OnboardingClientStepSeed ClientStepSeed => new()
    {
        DreamTitles = DreamStepRegionalTitles,
        DreamCurrent = Draft.Dream,
        ConsentRequested = Draft.ConsentRequested,
        HasConsent = Draft.HasConsent,
        MiniQuestions = _miniQuestions
            .Select(q => new OnboardingClientStepSeed.MiniQuestionSeed(q.Id, QuestionText(q)))
            .ToList(),
        MiniAnswers = MiniVisibleAnswers.ToDictionary(static pair => pair.Key, static pair => pair.Value),
    };

    private Task PersistProfileDraftAsync(CancellationToken cancellationToken)
    {
        _saveError = false;
        return SaveProfileAsync(cancellationToken);
    }

    private void OnProfilePersistEnded(bool succeeded)
    {
        _profilePersistInFlight = false;
        if (succeeded)
        {
            _error = null;
            return;
        }

        _saveError = true;
        _ = SafeStateHasChangedAsync();
