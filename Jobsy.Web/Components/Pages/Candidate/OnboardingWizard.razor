@page "/candidate/start/wizard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject GratisDnaMergeService GratisDnaMerge
@inject Jobsy.Core.Features.IFeatureFlags FeatureFlags
@inject IConfiguration Configuration
@inject IReferenceVerificationFeatureGate ReferenceVerificationGate
@inject Jobsy.Web.Features.ITestJourneyIllustrationGate TestJourneyIllustration
@inject Jobsy.Web.Features.IOnboardingFinaleV2Gate OnboardingFinaleV2
@inject UserFacingError UserFacing
@inject ICandidateHeroCompactPreviewGate HeroCompactPreview
@inject IOnboardingRustigGate OnboardingRustig
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@using Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Web.Onboarding
@using Jobsy.Web.Components.Shared.Questionnaire
@using Jobsy.Web.Features
@using Microsoft.AspNetCore.WebUtilities
@using Jobsy.Web.Media
@using Jobsy.Web.KandidaatBanen
@implements IAsyncDisposable

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/features/onboarding-wizard-mobile-bar.css?v=20261016-02" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-richting-a.css?v=20261019-r25" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-vroeg-resultaat.css?v=20261017-01" />
    <link rel="stylesheet" href="css/features/onboarding-work-history.css?v=20261018-08" />
    <link rel="stylesheet" href="css/features/onboarding-illustrated-step.css?v=20261019-r24" />
    <link rel="stylesheet" href="css/features/onboarding-test-blocks.css?v=20261018-r2" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-nearby-panel.css?v=20261018-r4" />
    @if (TestJourneyIllustration.Enabled)
    {
        <link rel="stylesheet" href="css/features/onboarding-wizard-test-journey.css?v=20261018-07" />
    }
    @if (_finaleV2)
    {
        <link rel="stylesheet" href="css/features/onboarding-finale-v2.css?v=20261018-15" />
    }
    @if (OnboardingRustig.Enabled)
    {
        <link rel="stylesheet" href="css/features/onboarding-rustig.css?v=20261020-21" />
    }
    <link rel="stylesheet" href="css/features/onboarding-client-nav.css?v=20261022-nav" />
</HeadContent>

<div class="ob-wizard ob-wizard--richting-a @(OnboardingRustig.Enabled ? "ob-wizard--rustig" : null) @(ShowJourneyConsent ? "ob-wizard--journey-consent" : null) @(HeroCompactPreview.Variant == CandidateHeroCompactPreviewVariant.C ? "ob-wizard--compact-preview-c" : null)"
     data-ob-antiforgery-header="@_antiforgeryHeader"
     data-ob-antiforgery-token="@_antiforgeryToken"
     data-ob-active-step="@(_loading ? null : _step.ToString())">
    @if (!_loading)
    {
        <p class="state-message error ob-wizard__nav-error" data-ob-wizard-nav-error hidden aria-live="polite"></p>
    }
    @if (_loading)
    {
        <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p>
    }
    else if (_phase == WizardPhase.Install)
    {
        <section class="ob-wizard__install">
            <div class="push-prompt push-prompt--onboarding" role="dialog" aria-labelledby="onboarding-push-title" aria-describedby="onboarding-push-body">
                <div class="push-prompt__card">
                    <h1 id="onboarding-push-title" class="push-prompt__title">@Culture["Push.PromptTitle"]</h1>
                    <p id="onboarding-push-body" class="push-prompt__body">@Culture["Push.PromptBody"]</p>
                    <p class="ob-wizard__hint">@Culture["Onboarding.Install.Lead"]</p>
                    <div class="push-prompt__actions">
                        @if (_installIos)
                        {
                            <p class="ob-install__hint">@Culture["Pwa.IosHint"]</p>
                        }
                        else if (_installCanPrompt)
                        {
                            <button type="button" class="engagement-btn" @onclick="InstallAsync">
                                @Culture["Onboarding.Install.AddApp"]
                            </button>
                        }
                        <button type="button" class="login-submit" @onclick="EnablePushAsync">
                            @Culture["Onboarding.Install.EnablePush"]
                        </button>
                        <button type="button" class="engagement-btn" @onclick="InstallLaterAsync">
                            @Culture["Onboarding.Install.Later"]
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_installMessage))
                    {
                        <p aria-live="polite">@_installMessage</p>
                    }
                </div>
            </div>
        </section>
    }
    else if (_finish || _state?.FinishReached == true)
    {
        if (_finaleV2 && OnboardingRustig.Enabled)
        {
            <OnboardingRustigKompasStep FirstName="@Draft.FirstName"
                                        Impression="_state?.Impression"
                                        MatchCount="@(_state?.Impression?.MatchingVacancyCount ?? 0)"
                                        MaxTravelMinutes="@_finaleMaxTravel"
                                        HomeLabel="@_finaleHomeLabel"
                                        DreamJob="@(string.IsNullOrWhiteSpace(Draft.Dream) ? null : Draft.Dream)"
                                        CardsInput="_finaleCardsInput"
                                        SaveStatus="@RustigSaveStatus"
                                        OnComplete="CompleteAsync"
                                        OnLater="LaterAsync" />
        }
        else if (_finaleV2)
        {
            <OnboardingFinaleV2 FirstName="@Draft.FirstName"
                                Impression="_state?.Impression"
                                MatchCount="@(_state?.Impression?.MatchingVacancyCount ?? 0)"
                                MaxTravelMinutes="@_finaleMaxTravel"
                                HomeLabel="@_finaleHomeLabel"
                                DreamJob="@(string.IsNullOrWhiteSpace(Draft.Dream) ? null : Draft.Dream)"
                                CardsInput="_finaleCardsInput"
                                OnComplete="CompleteAsync" />
        }
        else
        {
        <section class="ob-wizard__finish">
            <LineIcon Name="compass" CssClass="ob-wizard__compass line-icon--md" />
            <span class="ob-wizard__badge">@Culture["Onboarding.Finish.Badge"]</span>
            <h1>@Culture.Format("Onboarding.Finish.Title", Draft.FirstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Finish.Lead"]</p>
            @if (_state?.Impression is { } impression)
            {
                <div class="ob-wizard__highlights">
                    @if (impression.Strengths.FirstOrDefault() is { } strength)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Strength"]</small>
                            <strong>@strength.Sentence</strong>
                        </article>
                    }
                    @if (impression.Riasec.Take(2).ToList() is { Count: > 0 } riasec)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Work"]</small>
                            <strong>@string.Join(AndSeparator, riasec.Select(item => item.Label))</strong>
                        </article>
                    }
                    @if (impression.TopValue is { } value)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Value"]</small>
                            <strong>@value.Label</strong>
                        </article>
                    }
                </div>
                @if (impression.MatchingVacancyCount > 0)
                {
                    <p class="ob-wizard__figure">
                        <strong>@impression.MatchingVacancyCount</strong> @Culture["Onboarding.Finish.Matches"]
                    </p>
                }
            }
            <button type="button" class="btn btn-primary ob-wizard__cta" data-ob-kompas-complete data-testid="onboarding-kompas-complete" @onclick="CompleteAsync">
                @Culture["Onboarding.Finish.Cta"]
            </button>
            <a class="ob-wizard__ghost" href="/home?tab=tests">@Culture["Onboarding.Finish.FullTests"]</a>
        </section>
        }
    }
    else if (_welcome)
    {
        @if (OnboardingRustig.Enabled)
        {
            <OnboardingRustigWelcome Title="@WelcomeTitle"
                                     Lead="@Culture["Onboarding.Rustig.WelcomeLead"]"
                                     Hint="@Culture["Onboarding.Welcome.Hint"]"
                                     Cta="@Culture["Onboarding.Welcome.CtaRustig"]"
                                     Error="@_error"
                                     Busy="@(_busy || _loading)"
                                     OnBegin="BeginAsync"
                                     OnLater="LaterAsync" />
        }
        else
        {
            <section class="ob-wizard__welcome">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="state-message error">@_error</p>
                }
                <LobsyLogo Variant="LobsyLogoVariant.Stacked" Alt="" />
                <h1>@WelcomeTitle</h1>
                <p class="ob-wizard__lead">@Culture["Onboarding.Welcome.Lead"]</p>
                <div class="ob-wizard__phase-cards">
                    @foreach (var item in WelcomePhases)
                    {
                        <article>
                            <span>@item.Number</span>
                            <div>
                                <strong>@Culture[item.Title]</strong>
                                <small>@Culture[item.Lead]</small>
                            </div>
                            <small>@Culture[item.Time]</small>
                        </article>
                    }
                </div>
                <p class="ob-wizard__hint">@Culture["Onboarding.Welcome.Hint"]</p>
                <button type="button"
                        class="btn btn-primary ob-wizard__cta"
                        data-ob-welcome-begin
                        data-testid="onboarding-begin"
                        disabled="@(_busy || _loading)"
                        @onclick="BeginAsync">
                    @Culture["Onboarding.Welcome.Cta"]
                </button>
            </section>
        }
    }
    else if (RustigPersonalSteps)
    {
        var rustigPhase = OnboardingWizardCatalog.PhaseForStep(_step);
        var rustigJobsRail = ShowNearbyPanel && _step is 2 or 3;
        <OnboardingRustigShell ScreenId="@($"step-{_step:D2}")"
                               Step="_step"
                               PhaseLabel="@Culture[rustigPhase.NameKey]"
                               MinutesLeft="@OnboardingWizardCatalog.V3RemainingMinutes(_step)"
                               ShowSaved="true"
                               SaveStatus="@RustigSaveStatus"
                               ShowOptionalBadge="@(_step is 4 or 5)"
                               Title="@Culture[$"Onboarding.Step{_step}.Title"]"
                               Lead="@Culture[$"Onboarding.Step{_step}.Lead"]"
                               PanoramaDesktop="@OnboardingRustigPanoramaAssets.Desktop(_step)"
                               PanoramaMobile="@OnboardingRustigPanoramaAssets.Mobile(_step)"
                               ShowJobsRail="rustigJobsRail"
                               BackDisabled="@(_step == 1)"
                               HeaderBackEnabled="true"
                               OnBack="BackAsync"
                               OnLater="LaterAsync">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="state-message error">@_error</p>
                }
                <OnboardingRustigPersonalStepBody Step="_step"
                                                   Draft="Draft"
                                                   ShowValidation="_showValidation"
                                                   Presets="PresetItems"
                                                   ClientSeed="ClientStepSeed"
                                                   AddressChanged="AddressChanged"
                                                   ShowCity="ShowCity"
                                                   SelectAddress="SelectAddress"
                                                   TogglePreset="TogglePreset"
                                                   ToggleFineTune="ToggleFineTune"
                                                   SetMinHours="SetMinHoursAsync"
                                                   SetMaxHours="SetMaxHoursAsync"
                                                   ManualAvailability="ManualAvailabilityAsync"
                                                   ToggleAvailability="ToggleAvailability"
                                                   ResetPresets="ResetPresets"
                                                   SelectTransport="SelectTransport"
                                                   SelectTravelTime="SelectTravelTime"
                                                   ShowCustomTravel="ShowCustomTravel"
                                                   AddJob="AddJob"
                                                   RemoveJob="RemoveJob"
                                                   SetJobStart="OnSetJobStart"
                                                   SetJobEnd="OnSetJobEnd"
                                                   SelectEducation="SelectEducation" />
                <div class="ob-rustig__footer-actions">
                    @if (_step is 1 or 2)
                    {
                        <button type="button"
                                class="ob-rustig__btn"
                                data-ob-nav-back
                                data-ob-nav-step="@_step"
                                data-testid="onboarding-back"
                                disabled="@(_busy || _step == 1)">@Culture["Onboarding.Back"]</button>
                    }
                    else
                    {
                        <button type="button"
                                class="ob-rustig__btn"
                                data-testid="onboarding-back"
                                disabled="@(_busy || _step == 1)"
                                @onclick="BackAsync">@Culture["Onboarding.Back"]</button>
                    }
                    @if (_step is 4 or 5)
                    {
                        <button type="button"
                                class="ob-rustig__btn"
                                data-testid="onboarding-skip-optional"
                                disabled="@_busy"
                                @onclick="SkipOptionalAsync">@Culture["Onboarding.Skip"]</button>
                    }
                    @if (_step is 1 or 2)
                    {
                        <button type="button"
                                class="ob-rustig__btn ob-rustig__btn--primary"
                                data-ob-nav-next
                                data-ob-nav-step="@_step"
                                data-testid="onboarding-next">@Culture["Onboarding.Next"]</button>
                    }
                    else if (_step > 10)
                    {
                        <button type="button"
                                class="ob-rustig__btn ob-rustig__btn--primary"
                                data-testid="onboarding-next"
                                disabled="@_busy"
                                @onclick="@(() => NextAsync())">@NextLabel</button>
                    }
                </div>
            </ChildContent>
            <JobsRail>
                <OnboardingNearbyPanel Layout="OnboardingNearbyPanel.NearbyPanelLayout.Desktop"
                                       Signal="_nearbySignal"
                                       TransportLabel="@Draft.Transport"
                                       RefinedHeadline="NearbyRefinedHeadline" />
            </JobsRail>
        </OnboardingRustigShell>
    }
    else if (OnboardingRustig.Enabled && _earlyMoment == EarlyRewardMoment.None && _step == 7 && !Draft.HasConsent)
    {
        <OnboardingRustigTestConsentStep Draft="Draft"
                                         ShowValidation="_showValidation"
                                         TestTabs="ConsentTabs"
                                         ConsentChanged="OnConsentChanged"
                                         ClientSeed="ClientStepSeed"
                                         Error="@_error"
                                         Busy="@_busy"
                                         SaveStatus="@RustigSaveStatus"
                                         OnBack="BackAsync"
                                         OnNext="@(() => NextAsync())"
                                         OnLater="LaterAsync" />
    }
    else if (OnboardingRustig.Enabled && _earlyMoment == EarlyRewardMoment.None && _step is >= 7 and <= 10 && Draft.HasConsent)
    {
        <OnboardingRustigMiniTestStep Step="_step"
                                      Draft="Draft"
                                      ClientSeed="ClientStepSeed"
                                      Busy="@_busy"
                                      OnNext="@(() => NextAsync())"
                                      FlowEpoch="_miniFlowEpoch"
                                      CurrentQuestion="_currentQuestion"
                                      TestTabs="MiniTestTabs"
                                      Questions="_miniQuestions"
                                      Answers="MiniVisibleAnswers"
                                      Depth="TestDepthLevel.First"
                                      InputPrefix="@MiniPrefix"
                                      LaterLabel="@Culture["Onboarding.Tests.LaterDoen"]"
                                      Error="@_error"
                                      SaveStatus="@RustigSaveStatus"
                                      Answer="OnMiniAnswer"
                                      OnFinished="FinishMiniAsync"
                                      OnLeave="BackAsync"
                                      OnTestsLater="SkipTestsLaterAsync"
                                      ExpandQuestion="ExpandQuestion"
                                      ResolveQuestionText="QuestionText"
                                      OnLater="LaterAsync" />
    }
    else if (OnboardingRustig.Enabled && _earlyMoment == EarlyRewardMoment.None && _step == 6)
    {
        <OnboardingRustigDreamStep Draft="Draft"
                                   ShowValidation="_showValidation"
                                   Young="@IsYoungCandidate"
                                   RegionalVacancyTitles="@DreamStepRegionalTitles"
                                   ClientSeed="ClientStepSeed"
                                   Error="@_error"
                                   Busy="@_busy"
                                   SaveStatus="@RustigSaveStatus"
                                   ChooseDream="ChooseDream"
                                   ChooseTitle="ChooseDreamTitle"
                                   ChooseOwnDream="ChooseOwnDream"
                                   DreamKeyDown="DreamKeyDown"
                                   OnBack="BackAsync"
                                   OnNext="@(() => NextAsync())"
                                   OnDreamUnknown="DreamUnknownAsync"
                                   OnLater="LaterAsync" />
    }
    else
    {
        var currentPhase = OnboardingWizardCatalog.PhaseForStep(_step);
        <div class="ob-wizard__layout @(ShowNearbyPanel ? "ob-wizard__layout--with-nearby" : null)">
            <aside class="ob-wizard__sidebar">
                <LobsyLogo Variant="LobsyLogoVariant.Mark" Alt="" />
                @foreach (var item in Sidebar)
                {
                    var isCurrent = item.First <= _step && _step <= item.Last;
                    var isDone = _step > item.Last;
                    <div class="ob-wizard__side-item @(isCurrent ?"is-current" : null) @(isDone ? "is-done" : null)">
                        <span>@(isDone ? "✓" : item.Number)</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                    </div>
                }
                @if (SoftIllustratedStep && IllustratedSidebarNote is not null)
                {
                    <div class="ob-wizard__sidebar-note">
                        <strong>@Culture["Onboarding.IllustratedSidebarTitle"]</strong>
                        @IllustratedSidebarNote
                    </div>
                    <ul class="ob-wizard__sidebar-substeps" aria-label="@Culture["Onboarding.IllustratedSidebar.SubstepsAria"]">
                        @for (var sub = 1; sub <= 6; sub++)
                        {
                            <li class="ob-wizard__sidebar-substep @(sub == _step ? "is-current" : null)">
                                @Culture[$"Onboarding.Step{sub}.Title"]
                            </li>
                        }
                    </ul>
                }
                <p class="ob-wizard__saved">✓ @Culture["Onboarding.AllSaved"]</p>
            </aside>

            <main class="ob-wizard__main">
                <div class="ob-wizard__mobile-top">
                    <div class="ob-wizard__topbar">
                        <div class="ob-wizard__topbar-brand">
                            <LobsyLogo Class="ob-wizard__topbar-logo" Alt="" Variant="LobsyLogoVariant.Horizontal" />
                        </div>
                        <div class="ob-wizard__topbar-actions">
                            <p class="ob-wizard__topbar-meta">@MobileTopMeta</p>
                            <div class="ob-wizard__topbar-links">
                                <button type="button" class="ob-wizard__topbar-later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                                <a class="ob-wizard__topbar-privacy"
                                   href="/privacy/data"
                                   title="@Culture["Onboarding.AccountPrivacyLink"]">@Culture["Onboarding.AccountPrivacyLink"]</a>
                            </div>
                        </div>
                    </div>
                    <p class="ob-wizard__mobile-privacy">
                        <a href="/privacy/data"
                           title="@Culture["Onboarding.AccountPrivacyLink"]">@Culture["Onboarding.AccountPrivacyLink"]</a>
                    </p>
                    <div class="ob-wizard__progress-thin"
                         role="progressbar"
                         aria-valuemin="1"
                         aria-valuemax="10"
                         aria-valuenow="@_step"
                         aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                        <span style="width:@(_step * 10)%"></span>
                    </div>
                </div>
                <header class="ob-wizard__header">
                    <div class="ob-wizard__header-row">
                        <button type="button"
                                class="icon-btn ob-wizard__back"
                                disabled="@(_step == 1)"
                                aria-label="@Culture["Onboarding.BackAria"]"
                                @onclick="BackAsync">‹</button>
                        <div class="ob-wizard__segments"
                             role="progressbar"
                             aria-valuemin="1"
                             aria-valuemax="10"
                             aria-valuenow="@_step"
                             aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                            @foreach (var phase in OnboardingWizardCatalog.Phases)
                            {
                                <span>
                                    <i style="--w:@(OnboardingWizardCatalog.PhaseFill(phase, _step) * 100)%"></i>
                                </span>
                            }
                        </div>
                        <div class="ob-wizard__header-actions">
                            <button type="button" class="ob-wizard__later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                            <a class="ob-wizard__later ob-wizard__privacy-link"
                               href="/privacy/data"
                               title="@Culture["Onboarding.AccountPrivacyLink"]">@Culture["Onboarding.AccountPrivacyLink"]</a>
                        </div>
                    </div>
                    <div class="ob-wizard__status-row">
                        <span>
                            <strong>@Culture[currentPhase.NameKey]</strong> ·
                            @Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
                        </span>
                        <span aria-live="polite" class="@(_saveError ?"is-error" : null)">@SaveText</span>
                    </div>
                </header>

                <section class="ob-wizard__content @(SoftIllustratedStep ? "ob-wizard__content--illustrated" : null)"
                         data-onboarding-step="@_step">
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="state-message error">@_error</p>
                    }

                    <p class="ob-wizard__step-pill @(SoftIllustratedStep ? "ob-wizard__step-pill--illustrated-hero" : null)">@MobileStepBadge</p>

                    @if (_earlyMoment == EarlyRewardMoment.FirstInsight)
                    {
                        <EarlyRewardFirstInsightStep TestTabs="MiniTestTabs"
                                                     CompletedTestStep="7"
                                                     Strength="_earlyStrength" />
                    }
                    else
                    {
                    @switch (_step)
                    {
                        case 1:
                            <OnboardingIllustratedStep WebpSrc="@Step1HeroWebp"
                                                       JpgSrc="@Step1HeroJpg"
                                                       MobileHeroWebp="@Step1MobileHeroWebp"
                                                       MobileHeroJpg="@Step1MobileHeroJpg"
                                                       MobileHeroSlug="kennismaken"
                                                       Eyebrow="@MobileStepBadge"
                                                       HeroTitle="@Culture["Onboarding.Step1.Title"]"
                                                       HeroLead="@Culture["Onboarding.Step1.Lead"]"
                                                       CompactPreviewClass="@HeroCompactPreview.OnboardingStepCssClass"
                                                       TestId="onboarding-step-1-illustrated">
                                <HeadContent>
                                    <h1 tabindex="-1">@Culture["Onboarding.Step1.Title"]</h1>
                                    <p class="ob-wizard__lead">@Culture["Onboarding.Step1.Lead"]</p>
                                </HeadContent>
                                <ChildContent>
                                    <div class="ob-illustrated-step__form">
                                        <OnboardingClientStepIsland Step="1"
                                                                    Draft="Draft"
                                                                    Presets="IllustratedPresetTuples"
                                                                    Seed="ClientStepSeed" />
                                    </div>
                                </ChildContent>
                            </OnboardingIllustratedStep>
                            break;

                        case 2:
                            <OnboardingIllustratedStep WebpSrc="@OnboardingIllustrationAssets.BeschikbaarheidWebp"
                                                       JpgSrc="@OnboardingIllustrationAssets.BeschikbaarheidJpg"
                                                       MobileHeroWebp="@OnboardingIllustrationAssets.MobileHeroWebp("beschikbaarheid")"
                                                       MobileHeroJpg="@OnboardingIllustrationAssets.MobileHeroJpg("beschikbaarheid")"
                                                       MobileHeroSlug="beschikbaarheid"
                                                       Eyebrow="@MobileStepBadge"
                                                       HeroTitle="@Culture["Onboarding.Step2.Title"]"
                                                       HeroLead="@Culture["Onboarding.Step2.Lead"]"
                                                       TestId="onboarding-step-2-illustrated">
                                <HeadContent>
                                    <h1 tabindex="-1">@Culture["Onboarding.Step2.Title"]</h1>
                                    <p class="ob-wizard__lead">@Culture["Onboarding.Step2.Lead"]</p>
                                </HeadContent>
                                <ChildContent>
                                    <div class="ob-illustrated-step__form">
                                        <OnboardingClientStepIsland Step="2"
                                                                    Draft="Draft"
                                                                    Presets="IllustratedPresetTuples"
                                                                    Seed="ClientStepSeed" />
                                    </div>
                                </ChildContent>
                            </OnboardingIllustratedStep>
                            break;

                        case 4:
                            <OnboardingIllustratedStep WebpSrc="@OnboardingIllustrationAssets.WerkervaringWebp"
                                                       JpgSrc="@OnboardingIllustrationAssets.WerkervaringJpg"
                                                       MobileHeroWebp="@OnboardingIllustrationAssets.MobileHeroWebp("werkervaring")"
                                                       MobileHeroJpg="@OnboardingIllustrationAssets.MobileHeroJpg("werkervaring")"
                                                       MobileHeroSlug="werkervaring"
                                                       Eyebrow="@MobileStepBadge"
                                                       HeroTitle="@Culture["Onboarding.Step4.Title"]"
                                                       HeroLead="@Culture["Onboarding.Step4.Lead"]"
                                                       TestId="onboarding-step-4-illustrated">
                                <HeroExtra>
                                    <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
                                </HeroExtra>
                                <HeadContent>
                                    <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
                                    <h1 tabindex="-1">@Culture["Onboarding.Step4.Title"]</h1>
                                    <p class="ob-wizard__lead">@Culture["Onboarding.Step4.Lead"]</p>
                                </HeadContent>
                                <ChildContent>
                                    <div class="ob-illustrated-step__form">
                                        <OnboardingClientStepIsland Step="4"
                                                                    Draft="Draft"
                                                                    Presets="IllustratedPresetTuples"
                                                                    Seed="ClientStepSeed" />
                                    </div>
                                </ChildContent>
                            </OnboardingIllustratedStep>
                            break;

                        case 5:
                            <OnboardingIllustratedStep WebpSrc="@OnboardingIllustrationAssets.OpleidingWebp"
                                                       JpgSrc="@OnboardingIllustrationAssets.OpleidingJpg"
                                                       MobileHeroWebp="@OnboardingIllustrationAssets.MobileHeroWebp("opleiding")"
                                                       MobileHeroJpg="@OnboardingIllustrationAssets.MobileHeroJpg("opleiding")"
