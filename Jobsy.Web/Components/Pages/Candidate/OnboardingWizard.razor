@page "/candidate/start"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Features
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject GratisDnaMergeService GratisDnaMerge
@inject Jobsy.Core.Features.IFeatureFlags FeatureFlags
@inject Jobsy.Web.Features.ITestJourneyIllustrationGate TestJourneyIllustration
@inject UserFacingError UserFacing
@using Jobsy.Web.Components.Candidate.Onboarding
@using Jobsy.Web.KandidaatBanen
@implements IAsyncDisposable

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/features/onboarding-wizard-mobile-bar.css?v=20261016-02" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-richting-a.css?v=20261017-01" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-vroeg-resultaat.css?v=20261017-01" />
    <link rel="stylesheet" href="css/features/onboarding-wizard-nearby-panel.css?v=20261018-01" />
    <link rel="stylesheet" href="css/features/onboarding-work-history.css?v=20261018-07" />
    @if (TestJourneyIllustration.Enabled)
    {
        <link rel="stylesheet" href="css/features/onboarding-wizard-test-journey.css?v=20261018-07" />
    }
</HeadContent>

<div class="ob-wizard ob-wizard--richting-a @(ShowJourneyConsent ? "ob-wizard--journey-consent" : null)">
    @if (_loading)
    {
        <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p>
    }
    else if (_phase == WizardPhase.Install)
    {
        <section class="ob-wizard__install">
            <h1>@Culture["Onboarding.Install.Title"]</h1>
            <p>@Culture["Onboarding.Install.Lead"]</p>
            <div class="ob-install">
                @if (_installIos)
                {
                    <p class="ob-install__hint">@Culture["Pwa.IosHint"]</p>
                }
                else if (_installCanPrompt)
                {
                    <button type="button" class="btn btn-primary" @onclick="InstallAsync">
                        @Culture["Onboarding.Install.AddApp"]
                    </button>
                }
                <button type="button" class="btn btn-primary" @onclick="EnablePushAsync">
                    @Culture["Onboarding.Install.EnablePush"]
                </button>
                @if (!string.IsNullOrEmpty(_installMessage))
                {
                    <p aria-live="polite">@_installMessage</p>
                }
            </div>
            <button type="button" class="ob-wizard__ghost" @onclick="InstallLaterAsync">
                @Culture["Onboarding.Install.Later"]
            </button>
        </section>
    }
    else if (_finish || _state?.FinishReached == true)
    {
        <section class="ob-wizard__finish">
            <div class="ob-wizard__compass" aria-hidden="true">⌾</div>
            <span class="ob-wizard__badge">@Culture["Onboarding.Finish.Badge"]</span>
            <h1>@Culture.Format("Onboarding.Finish.Title", Draft.FirstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Finish.Lead"]</p>
            @if (_state?.Impression is { } impression)
            {
                <div class="ob-wizard__highlights">
                    @if (impression.Strengths.FirstOrDefault() is { } strength)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Strength"]</small>
                            <strong>@strength.Sentence</strong>
                        </article>
                    }
                    @if (impression.Riasec.Take(2).ToList() is { Count: > 0 } riasec)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Work"]</small>
                            <strong>@string.Join(AndSeparator, riasec.Select(item => item.Label))</strong>
                        </article>
                    }
                    @if (impression.TopValue is { } value)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Value"]</small>
                            <strong>@value.Label</strong>
                        </article>
                    }
                </div>
                @if (impression.MatchingVacancyCount > 0)
                {
                    <p class="ob-wizard__figure">
                        <strong>@impression.MatchingVacancyCount</strong> @Culture["Onboarding.Finish.Matches"]
                    </p>
                }
            }
            <button type="button" class="btn btn-primary ob-wizard__cta" @onclick="CompleteAsync">
                @Culture["Onboarding.Finish.Cta"]
            </button>
            <a class="ob-wizard__ghost" href="/home?tab=tests">@Culture["Onboarding.Finish.FullTests"]</a>
        </section>
    }
    else if (_welcome)
    {
        <section class="ob-wizard__welcome">
            <div class="lobsy-logo">
                <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
            </div>
            <h1>@Culture.Format("Onboarding.Welcome.Title", Draft.FirstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Welcome.Lead"]</p>
            <div class="ob-wizard__phase-cards">
                @foreach (var item in WelcomePhases)
                {
                    <article>
                        <span>@item.Number</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                        <small>@Culture[item.Time]</small>
                    </article>
                }
            </div>
            <p class="ob-wizard__hint">@Culture["Onboarding.Welcome.Hint"]</p>
            <button type="button" class="btn btn-primary ob-wizard__cta" @onclick="BeginAsync">
                @Culture["Onboarding.Welcome.Cta"]
            </button>
        </section>
    }
    else
    {
        var currentPhase = OnboardingWizardCatalog.PhaseForStep(_step);
        <div class="ob-wizard__layout @(ShowNearbyPanel ? "ob-wizard__layout--with-nearby" : null)">
            <aside class="ob-wizard__sidebar">
                <div class="lobsy-logo">
                    <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
                </div>
                @foreach (var item in Sidebar)
                {
                    var isCurrent = item.First <= _step && _step <= item.Last;
                    var isDone = _step > item.Last;
                    <div class="ob-wizard__side-item @(isCurrent ?"is-current" : null) @(isDone ? "is-done" : null)">
                        <span>@(isDone ? "✓" : item.Number)</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                    </div>
                }
                <p class="ob-wizard__saved">✓ @Culture["Onboarding.AllSaved"]</p>
                <button type="button" class="ob-wizard__ghost" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
            </aside>

            <main class="ob-wizard__main">
                <div class="ob-wizard__mobile-top">
                    <div class="ob-wizard__topbar">
                        <div class="ob-wizard__topbar-brand">
                            <img src="/images/brand/lobsy-128.png" width="36" height="36" alt="" />
                            <span>Lobsy</span>
                        </div>
                        <div class="ob-wizard__topbar-actions">
                            <p class="ob-wizard__topbar-meta">@MobileTopMeta</p>
                            <button type="button" class="ob-wizard__topbar-later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                        </div>
                    </div>
                    <div class="ob-wizard__progress-thin"
                         role="progressbar"
                         aria-valuemin="1"
                         aria-valuemax="10"
                         aria-valuenow="@_step"
                         aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                        <span style="width:@(_step * 10)%"></span>
                    </div>
                </div>
                <header class="ob-wizard__header">
                    <div class="ob-wizard__header-row">
                        <button type="button"
                                class="icon-btn ob-wizard__back"
                                disabled="@(_step == 1)"
                                aria-label="@Culture["Onboarding.BackAria"]"
                                @onclick="BackAsync">‹</button>
                        <div class="ob-wizard__segments"
                             role="progressbar"
                             aria-valuemin="1"
                             aria-valuemax="10"
                             aria-valuenow="@_step"
                             aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                            @foreach (var phase in OnboardingWizardCatalog.Phases)
                            {
                                <span>
                                    <i style="--w:@(OnboardingWizardCatalog.PhaseFill(phase, _step) * 100)%"></i>
                                </span>
                            }
                        </div>
                        <button type="button" class="ob-wizard__later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                    </div>
                    <div class="ob-wizard__status-row">
                        <span>
                            <strong>@Culture[currentPhase.NameKey]</strong> ·
                            @Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
                        </span>
                        <span aria-live="polite" class="@(_saveError ?"is-error" : null)">@SaveText</span>
                    </div>
                </header>

                <section class="ob-wizard__content">
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="state-message error">@_error</p>
                    }

                    <p class="ob-wizard__step-pill">@MobileStepBadge</p>

                    @if (_earlyMoment == EarlyRewardMoment.FirstInsight)
                    {
                        <EarlyRewardFirstInsightStep TestTabs="MiniTestTabs"
                                                     CompletedTestStep="7"
                                                     Strength="_earlyStrength" />
                    }
                    else
                    {
                    @switch (_step)
                    {
                        case 1:
                            <PersonalStep Draft="Draft"
                                          ShowValidation="_showValidation"
                                          AddressChanged="AddressChanged"
                                          BirthDateChanged="BirthDateChanged"
                                          ShowCity="ShowCity"
                                          SelectAddress="SelectAddress" />
                            break;

                        case 2:
                            <AvailabilityStep Draft="Draft"
                                              ShowValidation="_showValidation"
                                              Presets="PresetItems"
                                              TogglePreset="TogglePreset"
                                              ToggleFineTune="ToggleFineTune"
                                              SetMinHours="SetMinHoursAsync"
                                              SetMaxHours="SetMaxHoursAsync"
                                              ManualAvailability="ManualAvailabilityAsync"
                                              ToggleAvailability="ToggleAvailability"
                                              ResetPresets="ResetPresets" />
                            break;

                        case 3:
                            <TransportStep Draft="Draft"
                                           ShowValidation="_showValidation"
                                           SelectTransport="SelectTransport"
                                           SelectTravelTime="SelectTravelTime"
                                           ShowCustomTravel="ShowCustomTravel" />
                            break;

                        case 4:
                            <WorkHistoryStep Draft="Draft"
                                             AddJob="AddJob"
                                             RemoveJob="RemoveJob"
                                             SetJobStart="OnSetJobStart"
                                             SetJobEnd="OnSetJobEnd" />
                            break;

                        case 5:
                            <EducationStep Draft="Draft" SelectEducation="SelectEducation" />
                            break;

                        case 6:
                            <DreamJobStep Draft="Draft"
                                          ShowValidation="_showValidation"
                                          Young="@IsYoungCandidate"
                                          ChooseDream="ChooseDream"
                                          ChooseTitle="ChooseDreamTitle"
                                          ChooseOwnDream="ChooseOwnDream"
                                          DreamKeyDown="DreamKeyDown" />
                            break;

                        case 7 when !Draft.HasConsent && ShowJourneyConsent:
                            <TestJourneyConsentStep CompletedSteps="_journeyCompletedSteps"
                                                    NextStep="_journeyNextStep" />
                            break;

                        case 7 when !Draft.HasConsent:
                            <TestConsentStep Draft="Draft"
                                             ShowValidation="_showValidation"
                                             TestTabs="ConsentTabs"
                                             ConsentChanged="OnConsentChanged" />
                            break;

                        case >= 7 and <= 10:
                            <OnboardingMiniTest Step="_step"
                                                FlowEpoch="_step"
                                                CurrentQuestion="_currentQuestion"
                                                TestTabs="MiniTestTabs"
                                                Questions="_miniQuestions"
                                                Answers="MiniVisibleAnswers"
                                                Depth="TestDepthLevel.First"
                                                InputPrefix="@MiniPrefix"
                                                LaterLabel="@Culture["Onboarding.Tests.LaterDoen"]"
                                                Answer="OnMiniAnswer"
                                                OnFinished="FinishMiniAsync"
                                                OnLeave="BackAsync"
                                                OnLater="SkipTestsLaterAsync"
                                                ExpandQuestion="ExpandQuestion"
                                                ResolveQuestionText="QuestionText" />
                            break;
                    }

                    }

                    <div class="ob-wizard__mascot-anchor" aria-hidden="true">
                        <img src="/images/brand/mascot-64.webp" width="36" height="36" alt="" />
                    </div>
                </section>

                @if (_earlyMoment != EarlyRewardMoment.None || !ShowMiniTestFooter)
                {
                    <footer class="ob-wizard__footer @(ShowJourneyConsent ? "ob-wizard__footer--journey" : null) @(ShowTestsLaterOffer ? "ob-wizard__footer--with-later" : null)"
                            data-sticky-footer="true">
                        @if (ShowNearbyPanel)
                        {
                            <OnboardingNearbyPanel Layout="OnboardingNearbyPanel.NearbyPanelLayout.Mobile"
                                                   Signal="_nearbySignal"
                                                   TransportLabel="@Draft.Transport"
                                                   RefinedHeadline="NearbyRefinedHeadline" />
                        }
                        @if (_step is 4 or 5)
                        {
                            <button type="button" class="ob-wizard__ghost ob-wizard__footer-extra" @onclick="SkipOptionalAsync">
                                @Culture["Onboarding.Skip"]
                            </button>
                        }
                        else if (_step == 6)
                        {
                            <button type="button" class="ob-wizard__ghost ob-wizard__footer-extra" @onclick="DreamUnknownAsync">
                                @Culture["Onboarding.DreamUnknown"]
                            </button>
                        }
                        @if (ShowJourneyConsent)
                        {
                            <TestConsentFooterFields Draft="Draft"
                                                     ConsentChanged="OnConsentChanged"
                                                     ShowError="@(_showValidation && !Draft.ConsentRequested)" />
                        }
                        <div class="ob-wizard__actionbar">
                            <button type="button"
                                    class="ob-wizard__back-footer"
                                    data-testid="onboarding-back"
                                    disabled="@(_busy || (_step == 1 && _earlyMoment == EarlyRewardMoment.None))"
                                    @onclick="BackAsync">@Culture["Onboarding.Back"]</button>
                            <button type="button"
                                    class="btn btn-primary ob-wizard__cta"
                                    data-testid="onboarding-next"
                                    disabled="@_busy"
                                    @onclick="@(() => NextAsync())">@NextLabel</button>
                            @if (ShowTestsLaterOffer && !ShowJourneyConsent)
                            {
                                <button type="button"
                                        class="btn btn-secondary ob-wizard__footer-later"
                                        data-testid="onboarding-tests-later"
                                        disabled="@_busy"
                                        @onclick="SkipTestsLaterAsync">
                                    @Culture["Onboarding.Tests.LaterDoen"]
                                </button>
                            }
                        </div>
                    </footer>
                }
            </main>
            @if (ShowNearbyPanel)
            {
                <aside class="ob-wizard__nearby-rail" aria-label="@Culture["Onboarding.Panel.Nearby.RailAria"]">
                    <OnboardingNearbyPanel Layout="OnboardingNearbyPanel.NearbyPanelLayout.Desktop"
                                           Signal="_nearbySignal"
                                           TransportLabel="@Draft.Transport"
                                           RefinedHeadline="NearbyRefinedHeadline" />
                </aside>
            }
        </div>
    }
</div>

@code {
    private enum WizardPhase { Wizard, Install }
    private enum EarlyRewardMoment { None, FirstInsight }
    private sealed record SidebarItem(int Number, int First, int Last, string Title, string Lead);
    private sealed record WelcomePhase(int Number, string Title, string Lead, string Time);
    

    private bool _loading = true;
    private bool _busy;
    private bool _welcome;
    private bool _finish;
    private readonly OnboardingProfileDraft Draft = new();
    private bool _miniArrivedViaBack;
    private bool _installIos;
    private bool _installCanPrompt;
    private bool _saving;
    private bool _savedVisible;
    private bool _saveError;
    private bool _showValidation;
    private bool _pendingStepScroll;
    private bool _loadingNearby;
    private int _nearbyPeakCount;
    private EarlyRewardMoment _earlyMoment;
    private OnboardingNearbySignal? _nearbySignal;
    private OnboardingImpressionItem? _earlyStrength;
    private int _step = 1;
    private int _currentQuestion;
    private string _installMessage = "";
    private string? _error;
    private WizardPhase _phase;
    private OnboardingState? _state;
    private readonly Dictionary<int, int> _miniAnswers = new();
    private readonly Dictionary<int, int> _serverAnswers = new();
    private readonly HashSet<int> _lockedIds = [];
    private int[] _miniBlockQuestionIds = [];
    private List<OnboardingMiniTest.MiniQuestion> _miniQuestions = [];
    private IReadOnlyList<int> _journeyCompletedSteps = [];
    private int _journeyNextStep = 7;
    private CancellationTokenSource? _saveCts;
    private CancellationTokenSource? _geocodeCts;
    private CancellationTokenSource? _dreamCts;

    private static readonly AvailabilityStep.Preset[] PresetItems =
    [
        new("school", "Onboarding.Preset.School", "Onboarding.Preset.School.Lead"),
        new("weekend", "Onboarding.Preset.Weekend", "Onboarding.Preset.Weekend.Lead"),
        new("evening", "Onboarding.Preset.Evening", "Onboarding.Preset.Evening.Lead"),
        new("office", "Onboarding.Preset.Office", "Onboarding.Preset.Office.Lead"),
        new("holiday", "Onboarding.Preset.Holiday", "Onboarding.Preset.Holiday.Lead"),
        new("parttime", "Onboarding.Preset.Parttime", "Onboarding.Preset.Parttime.Lead"),
        new("fulltime", "Onboarding.Preset.Fulltime", "Onboarding.Preset.Fulltime.Lead"),
        new("custom", "Onboarding.Preset.Custom", "Onboarding.Preset.Custom.Lead")
    ];
    private static readonly TestConsentStep.TestTab[] ConsentTabs =
    [
        new(7, "Onboarding.Test.Competency", "Onboarding.Test.Competency.Lead"),
        new(8, "Onboarding.Test.Career", "Onboarding.Test.Career.Lead"),
        new(9, "Onboarding.Test.Culture", "Onboarding.Test.Culture.Lead"),
        new(10, "Onboarding.Test.Values", "Onboarding.Test.Values.Lead")
    ];
    private static readonly OnboardingMiniTest.TestTab[] MiniTestTabs = ConsentTabs
        .Select(t => new OnboardingMiniTest.TestTab(t.Step, t.Title, t.Lead)).ToArray();
    private QuestionnaireAutosave? _autosave;

    private static readonly string[] Days = DayPartMatrix.DayCodes;
    private static readonly string[] WorkingSlots = ["Ochtend", "Middag", "Avond"];
    private static readonly string[] TransportOptions = TransportLabels.Selectable;
    private static readonly int[] TravelChoices = [10, 20, 30, 45];
    private static readonly string[] MboLevels = ["1", "2", "3", "4"];
    private static readonly SidebarItem[] Sidebar =
    [
        new(1, 1, 3, "Onboarding.Phase.OverJou", "Onboarding.Side.OverJou"),
        new(2, 4, 5, "Onboarding.Phase.Achtergrond", "Onboarding.Side.Achtergrond"),
        new(3, 6, 6, "Onboarding.Phase.Droom", "Onboarding.Side.Droom"),
        new(4, 7, 10, "Onboarding.Phase.WieBenJij", "Onboarding.Side.WieBenJij"),
        new(5, 11, 11, "Onboarding.Side.Kompas", "Onboarding.Side.KompasLead")
    ];
    private static readonly WelcomePhase[] WelcomePhases =
    [
        new(1, "Onboarding.Phase.OverJou", "Onboarding.Welcome.OverJou", "Onboarding.Welcome.Time2"),
        new(2, "Onboarding.Welcome.Background", "Onboarding.Welcome.BackgroundLead", "Onboarding.Welcome.Time1"),
        new(3, "Onboarding.Welcome.Dream", "Onboarding.Welcome.DreamLead", "Onboarding.Welcome.TimeHalf"),
        new(4, "Onboarding.Phase.WieBenJij", "Onboarding.Welcome.TestsLead", "Onboarding.Welcome.Time2")
    ];

    private string SaveText => _saveError ? Culture["Onboarding.NotSaved"]
        : _saving ? Culture["Onboarding.Saving"]
        : _savedVisible ? $"✓ {Culture["Onboarding.Saved"]}" : "";
    private string HoursLabel => Draft.MinHours is not null && Draft.MaxHours is not null
        ? $"{Draft.MinHours:0} – {Draft.MaxHours:0} {Culture["Onboarding.Hours"]}" : "–";
    private string DaysSummary => Draft.Availability.Count == 0
        ? "–" : Culture.Format("Onboarding.DayPartsCount", Draft.Availability.Count);
    private string AvailableFromLabel => Draft.Immediate
        ? Culture["Onboarding.AvailableImmediate"]
        : Draft.AvailableFrom is { } d
            ? AvailabilityStartRules.FormatDisplayDate(d, Culture.Language)
            : "";
    private string AndSeparator => $" {Culture["Onboarding.And"]} ";
    private string MiniPrefix => $"obv2-{_step}-";
    private int MinHoursSlider => decimal.ToInt32(Draft.MinHours ?? 1);
    private int MaxHoursSlider => decimal.ToInt32(Draft.MaxHours ?? 60);
    private bool AvailabilityValid => Draft.MinHours is > 0 && Draft.MaxHours >= Draft.MinHours && Draft.Availability.Count > 0;
    private string MobileStepBadge
    {
        get
        {
            if (_earlyMoment == EarlyRewardMoment.FirstInsight)
            {
                return Culture["Onboarding.Early.Insight.Badge"];
            }

            if (Culture.Language.StartsWith("nl", StringComparison.OrdinalIgnoreCase))
            {
                return $"Stap {_step} van 10";
            }

            var raw = Culture.Format("Discovery.StepOf", _step);
            return raw.Length > 0 ? char.ToUpperInvariant(raw[0]) + raw[1..] : raw;
        }
    }

    private string MobileTopMeta => _earlyMoment switch
    {
        EarlyRewardMoment.FirstInsight => Culture["Onboarding.Early.Insight.Meta"],
        _ => Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
            .Replace(" van 10 ·", " ·", StringComparison.Ordinal)
            .Replace(" of 10 ·", " ·", StringComparison.Ordinal)
            .Replace(" minuten", " min", StringComparison.Ordinal)
            .Replace(" min left", " min", StringComparison.Ordinal)
    };

    private bool ShowJourneyConsent =>
        TestJourneyIllustration.Enabled && _step == 7 && !Draft.HasConsent && _earlyMoment == EarlyRewardMoment.None;

    private string NextLabel => _earlyMoment == EarlyRewardMoment.FirstInsight
            ? Culture["Onboarding.NextTest"]
            : ShowJourneyConsent
                ? JourneyConsentCtaLabel
            : _step == 7 && !Draft.HasConsent
        ? Culture["Onboarding.Consent.Cta"]
        : _step == 10 ? Culture["Onboarding.ViewKompas"]
        : _step is >= 7 ? Culture["Onboarding.NextTest"]
        : Draft.FineTune && _step == 2 ? Culture["Onboarding.Done"]
        : Culture["Onboarding.Next"];

    /// <summary>Mini-test uses a single primary in <see cref="TestQuestionFlow"/> (no duplicate wizard CTA).</summary>
    private bool ShowMiniTestFooter =>
        _earlyMoment == EarlyRewardMoment.None
        && _step is >= 7 and <= 10
        && Draft.HasConsent
        && _miniQuestions.Count > 0;

    private bool ShowTestsLaterOffer =>
        _earlyMoment == EarlyRewardMoment.FirstInsight
        || (_step == 7 && !Draft.HasConsent && _earlyMoment == EarlyRewardMoment.None)
        || (_step is >= 7 and <= 10 && Draft.HasConsent && _earlyMoment == EarlyRewardMoment.None);

    private const string BanenkaartPath = KbRoutes.Map;

    private bool NearbyPanelEligible =>
        !_welcome
        && !_finish
        && _earlyMoment != EarlyRewardMoment.FirstInsight
        && NearbyBasicsSaved();

    private bool ShowNearbyPanel => NearbyPanelEligible && _nearbySignal is not null && !_loadingNearby;

    private bool NearbyRefinedHeadline =>
        _nearbySignal is { Count: > 0 and var count }
        && _nearbyPeakCount > count;

    private bool NearbyBasicsSaved() =>
        OnboardingWizardValidation.HasResolvableLocation(
            Draft.City, Draft.HomeLat, Draft.HomeLng, Draft.Postcode, Draft.PostcodeResolved);

    private string JourneyConsentCtaLabel
    {
        get
        {
            var testNumber = OnboardingTestCompletion.TestNumberForStep(_journeyNextStep);
            return testNumber <= 1
                ? Culture["Onboarding.Journey.CtaStart"]
                : Culture.Format("Onboarding.Journey.CtaContinue", testNumber);
        }
    }

    private void OnConsentChanged(bool value)
    {
        Draft.ConsentRequested = value;
        if (value)
        {
            ClearStepValidation();
        }

        StateHasChanged();
    }

    private async Task RefreshJourneyCompletionAsync()
    {
        if (!TestJourneyIllustration.Enabled || Draft.HasConsent || _step != 7)
        {
            return;
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        _journeyCompletedSteps = await OnboardingTestCompletion.LoadCompletedWizardStepsAsync(Api, testsV2);
        _journeyNextStep = OnboardingTestCompletion.FirstIncompleteStep(_journeyCompletedSteps);
    }

    private bool CanNext => GetValidationIssues().Count == 0
                            && (_step is not (>= 7 and <= 10)
                                || _miniQuestions.All(question => MiniVisibleAnswers.ContainsKey(question.Id)));

    private IReadOnlyList<OnboardingValidationIssue> GetValidationIssues()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return _step switch
        {
            1 => OnboardingWizardValidation.ValidatePersonal(
                Draft.FirstName,
                Draft.LastName,
                Draft.BirthDate,
                Draft.City,
                Draft.HomeLat,
                Draft.HomeLng,
                Draft.Postcode,
                Draft.PostcodeResolved,
                today),
            2 => OnboardingWizardValidation.ValidateAvailability(
                Draft.MinHours,
                Draft.MaxHours,
                Draft.Availability.Count,
                Draft.Immediate,
                Draft.AvailableFrom,
                requirePresetSelection: Draft.Presets.Count == 0 && Draft.Availability.Count == 0),
            3 => OnboardingWizardValidation.ValidateTransport(Draft.Transport, Draft.MaxTravel),
            6 => OnboardingWizardValidation.ValidateDream(Draft.Dream),
            7 when !Draft.HasConsent => OnboardingWizardValidation.ValidateConsent(Draft.ConsentRequested),
            _ => []
        };
    }

