@page "/candidate/start"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>

<div class="ob-wizard">
    @if (_loading)
    {
        <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p>
    }
    else if (_phase == WizardPhase.Install)
    {
        <section class="ob-wizard__install">
            <h1>@Culture["Onboarding.Install.Title"]</h1>
            <p>@Culture["Onboarding.Install.Lead"]</p>
            <div class="ob-install">
                @if (_installIos)
                {
                    <p class="ob-install__hint">@Culture["Pwa.IosHint"]</p>
                }
                else if (_installCanPrompt)
                {
                    <button type="button" class="btn-compact btn-compact--primary" @onclick="InstallAsync">
                        @Culture["Onboarding.Install.AddApp"]
                    </button>
                }
                <button type="button" class="btn-compact btn-compact--primary" @onclick="EnablePushAsync">
                    @Culture["Onboarding.Install.EnablePush"]
                </button>
                @if (!string.IsNullOrEmpty(_installMessage))
                {
                    <p aria-live="polite">@_installMessage</p>
                }
            </div>
            <button type="button" class="ob-wizard__ghost" @onclick="InstallLaterAsync">
                @Culture["Onboarding.Install.Later"]
            </button>
        </section>
    }
    else if (_finish || _state?.FinishReached == true)
    {
        <section class="ob-wizard__finish">
            <div class="ob-wizard__compass" aria-hidden="true">⌾</div>
            <span class="ob-wizard__badge">@Culture["Onboarding.Finish.Badge"]</span>
            <h1>@Culture.Format("Onboarding.Finish.Title", _firstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Finish.Lead"]</p>
            @if (_state?.Impression is { } impression)
            {
                <div class="ob-wizard__highlights">
                    @if (impression.Strengths.FirstOrDefault() is { } strength)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Strength"]</small>
                            <strong>@strength.Sentence</strong>
                        </article>
                    }
                    @if (impression.Riasec.Take(2).ToList() is { Count: > 0 } riasec)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Work"]</small>
                            <strong>@string.Join(AndSeparator, riasec.Select(item => item.Label))</strong>
                        </article>
                    }
                    @if (impression.TopValue is { } value)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Value"]</small>
                            <strong>@value.Label</strong>
                        </article>
                    }
                </div>
                @if (impression.MatchingVacancyCount > 0)
                {
                    <p class="ob-wizard__figure">
                        <strong>@impression.MatchingVacancyCount</strong> @Culture["Onboarding.Finish.Matches"]
                    </p>
                }
            }
            <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="CompleteAsync">
                @Culture["Onboarding.Finish.Cta"]
            </button>
            <a class="ob-wizard__ghost" href="/home?tab=tests">@Culture["Onboarding.Finish.FullTests"]</a>
        </section>
    }
    else if (_welcome)
    {
        <section class="ob-wizard__welcome">
            <div class="lobsy-logo">
                <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
            </div>
            <h1>@Culture.Format("Onboarding.Welcome.Title", _firstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Welcome.Lead"]</p>
            <div class="ob-wizard__phase-cards">
                @foreach (var item in WelcomePhases)
                {
                    <article>
                        <span>@item.Number</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                        <small>@Culture[item.Time]</small>
                    </article>
                }
            </div>
            <p class="ob-wizard__hint">@Culture["Onboarding.Welcome.Hint"]</p>
            <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="BeginAsync">
                @Culture["Onboarding.Welcome.Cta"]
            </button>
        </section>
    }
    else
    {
        var currentPhase = OnboardingWizardCatalog.PhaseForStep(_step);
        <div class="ob-wizard__layout">
            <aside class="ob-wizard__sidebar">
                <div class="lobsy-logo">
                    <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
                </div>
                @foreach (var item in Sidebar)
                {
                    var isCurrent = item.First <= _step && _step <= item.Last;
                    var isDone = _step > item.Last;
                    <div class="ob-wizard__side-item @(isCurrent ? "is-current" : null) @(isDone ? "is-done" : null)">
                        <span>@(isDone ? "✓" : item.Number)</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                    </div>
                }
                <p class="ob-wizard__saved">✓ @Culture["Onboarding.AllSaved"]</p>
                <button type="button" class="ob-wizard__ghost" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
            </aside>

            <main class="ob-wizard__main">
                <header class="ob-wizard__header">
                    <div class="ob-wizard__header-row">
                        <button type="button"
                                class="icon-btn ob-wizard__back"
                                disabled="@(_step == 1)"
                                aria-label="@Culture["Onboarding.BackAria"]"
                                @onclick="BackAsync">‹</button>
                        <div class="ob-wizard__segments"
                             role="progressbar"
                             aria-valuemin="1"
                             aria-valuemax="10"
                             aria-valuenow="@_step"
                             aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                            @foreach (var phase in OnboardingWizardCatalog.Phases)
                            {
                                <span>
                                    <i style="--w:@(OnboardingWizardCatalog.PhaseFill(phase, _step) * 100)%"></i>
                                </span>
                            }
                        </div>
                        <button type="button" class="ob-wizard__later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                    </div>
                    <div class="ob-wizard__status-row">
                        <span>
                            <strong>@Culture[currentPhase.NameKey]</strong> ·
                            @Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
                        </span>
                        <span aria-live="polite" class="@(_saveError ? "is-error" : null)">@SaveText</span>
                    </div>
                </header>

                <section class="ob-wizard__content">
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="state-message error">@_error</p>
                    }

                    @switch (_step)
                    {
                        case 1:
                            <h1 tabindex="-1">@Culture["Onboarding.Step1.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step1.Lead"]</p>
                            <div class="ob-wizard__field-row">
                                <label>
                                    @Culture["Profile.FirstName"]
                                    <input autocomplete="given-name" maxlength="128"
                                           @bind="_firstName" @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                                </label>
                                <label>
                                    @Culture["Profile.LastName"]
                                    <input autocomplete="family-name" maxlength="128"
                                           @bind="_lastName" @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                                </label>
                            </div>
                            <label>
                                @Culture["Onboarding.Postcode"]
                                <input inputmode="text" autocomplete="postal-code" maxlength="7"
                                       @bind="_postcode" @bind:event="oninput" @bind:after="AddressChanged" />
                            </label>
                            @if (_postcodeResolved)
                            {
                                <p class="ob-wizard__hint">✓ @Culture.Format("Onboarding.PostcodeResolved", _city)</p>
                            }
                            @if (_postcodeMissing)
                            {
                                <p class="error">
                                    @Culture["Onboarding.PostcodeNotFound"]
                                    <button type="button" class="ob-wizard__inline-link" @onclick="ShowCity">
                                        @Culture["Onboarding.EnterCity"]
                                    </button>
                                </p>
                            }
                            @if (_showCity)
                            {
                                <label>
                                    @Culture["Onboarding.City"]
                                    <input autocomplete="address-level2"
                                           @bind="_city" @bind:event="oninput" @bind:after="AddressChanged" />
                                </label>
                            }
                            @if (_suggestions.Count > 0)
                            {
                                <ul class="ob-wizard__suggestions">
                                    @foreach (var suggestion in _suggestions)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => SelectAddress(suggestion)">
                                                @suggestion.Label
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            <fieldset>
                                <legend>@Culture["Onboarding.BirthDate"]</legend>
                                <div class="ob-wizard__birth">
                                    <label>
                                        @Culture["Onboarding.Day"]
                                        <input inputmode="numeric" maxlength="2"
                                               @bind="_birthDay" @bind:event="oninput" @bind:after="BirthDateChanged" />
                                    </label>
                                    <label>
                                        @Culture["Onboarding.Month"]
                                        <input inputmode="numeric" maxlength="2"
                                               @bind="_birthMonth" @bind:event="oninput" @bind:after="BirthDateChanged" />
                                    </label>
                                    <label>
                                        @Culture["Onboarding.Year"]
                                        <input inputmode="numeric" maxlength="4"
                                               @bind="_birthYear" @bind:event="oninput" @bind:after="BirthDateChanged" />
                                    </label>
                                </div>
                                <small>@Culture["Onboarding.BirthHint"]</small>
                            </fieldset>
                            <label>
                                @Culture["Profile.Phone"] <small>@Culture["Onboarding.Optional"]</small>
                                <input type="tel" autocomplete="tel"
                                       @bind="_phone" @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                            </label>
                            break;

                        case 2:
                            <h1 tabindex="-1">@Culture["Onboarding.Step2.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step2.Lead"]</p>
                            <fieldset>
                                <legend class="visually-hidden">@Culture["Onboarding.Step2.Title"]</legend>
                                <div class="ob-wizard__presets">
                                    @foreach (var preset in Presets)
                                    {
                                        var isSelected = _presets.Contains(preset.Code);
                                        <button type="button" aria-pressed="@isSelected"
                                                class="@(isSelected ? "is-selected" : null)"
                                                @onclick="() => TogglePreset(preset.Code)">
                                            <span>@(isSelected ? "✓" : "")</span>
                                            <b>@Culture[preset.Title]</b>
                                            <small>@Culture[preset.Lead]</small>
                                        </button>
                                    }
                                </div>
                            </fieldset>
                            <div class="ob-wizard__availability-summary">
                                <strong>@Culture["Onboarding.AvailabilitySummary"]</strong>
                                <button type="button" aria-expanded="@_fineTune" @onclick="ToggleFineTune">
                                    @Culture["Onboarding.Adjust"]
                                </button>
                                <dl>
                                    <div>
                                        <dt>@Culture["Vacancy.HoursPerWeek"]</dt>
                                        <dd>@HoursLabel</dd>
                                    </div>
                                    <div>
                                        <dt>@Culture["Profile.Availability"]</dt>
                                        <dd>@DaysSummary</dd>
                                    </div>
                                    <div>
                                        <dt>@Culture["Onboarding.AvailableFrom"]</dt>
                                        <dd>@AvailableFromLabel</dd>
                                    </div>
                                </dl>
                            </div>
                            @if (!_immediate)
                            {
                                <label>
                                    @Culture["Onboarding.AvailableFrom"]
                                    <input type="date" @bind="_availableFrom" @bind:after="ScheduleProfileSave" />
                                </label>
                            }
                            @if (_fineTune)
                            {
                                <div class="ob-wizard__fine-tune">
                                    <HoursRangeSlider CssClass="hours-range--compact"
                                                      Min="1"
                                                      Max="60"
                                                      Low="@MinHoursSlider"
                                                      High="@MaxHoursSlider"
                                                      LowChanged="SetMinHoursAsync"
                                                      HighChanged="SetMaxHoursAsync"
                                                      RangeCommitted="ManualAvailabilityAsync"
                                                      MinLabel="@Culture["Onboarding.MinHours"]"
                                                      MaxLabel="@Culture["Onboarding.MaxHours"]"
                                                      UnitLabel="@Culture["Onboarding.Hours"]" />
                                    <fieldset>
                                        <legend>@Culture["Profile.Availability"]</legend>
                                        <div class="ob-wizard__matrix">
                                            @foreach (var day in Days)
                                            {
                                                <span>@UiLabels.Weekday(Culture, day)</span>
                                                @foreach (var slot in WorkingSlots)
                                                {
                                                    var key = $"{day}:{slot}";
                                                    var isAvailable = _availability.Contains(key);
                                                    <button type="button"
                                                            aria-pressed="@isAvailable"
                                                            aria-label="@AvailabilityLabel(day, slot)"
                                                            class="@(isAvailable ? "is-on" : null)"
                                                            @onclick="() => ToggleAvailability(key)">
                                                        @UiLabels.AvailabilitySlot(Culture, slot)
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </fieldset>
                                    @if (_presetsOverridden)
                                    {
                                        <p class="ob-wizard__hint">
                                            @Culture["Onboarding.ManualOverride"]
                                            <button type="button" class="ob-wizard__inline-link" @onclick="ResetPresets">
                                                @Culture["Onboarding.Refill"]
                                            </button>
                                        </p>
                                    }
                                </div>
                            }
                            @if (!AvailabilityValid)
                            {
                                <p class="ob-wizard__hint error">@Culture["Onboarding.AvailabilityRequired"]</p>
                            }
                            break;

                        case 3:
                            <h1 tabindex="-1">@Culture["Onboarding.Step3.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step3.Lead"]</p>
                            <fieldset>
                                <legend>@Culture["Onboarding.Transport"]</legend>
                                <div class="ob-wizard__transport">
                                    @foreach (var transport in TransportOptions)
                                    {
                                        var isSelected = _transport == transport;
                                        <button type="button" aria-pressed="@isSelected"
                                                class="@(isSelected ? "is-selected" : null)"
                                                @onclick="() => SelectTransport(transport)">
                                            @TransportLabel(transport)
                                        </button>
                                    }
                                </div>
                            </fieldset>
                            <fieldset>
                                <legend>@Culture["Onboarding.MaxTravel"] <strong>@_maxTravel @Culture["Onboarding.Minutes"]</strong></legend>
                                <div class="ob-wizard__transport">
                                    @foreach (var minutes in TravelChoices)
                                    {
                                        <button type="button" aria-pressed="@(_maxTravel == minutes)"
                                                @onclick="() => SelectTravelTime(minutes)">
                                            @minutes
                                        </button>
                                    }
                                </div>
                                <button type="button" class="ob-wizard__inline-link" @onclick="ShowCustomTravel">
                                    @Culture["Onboarding.Other"]
                                </button>
                                @if (_customTravel)
                                {
                                    <input type="number" min="1" max="180"
                                           @bind="_maxTravel" @bind:after="ScheduleProfileSave" />
                                }
                            </fieldset>
                            break;

                        case 4:
                            <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
                            <h1 tabindex="-1">@Culture["Onboarding.Step4.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step4.Lead"]</p>
                            <label class="ob-wizard__check">
                                <input type="checkbox" @bind="_noWork" @bind:after="ScheduleProfileSave" />
                                @Culture["Onboarding.NoWorkExperience"]
                            </label>
                            @if (!_noWork)
                            {
                                @foreach (var job in _jobs)
                                {
                                    var item = job;
                                    <article class="ob-wizard__job">
                                        <button type="button" class="icon-btn"
                                                aria-label="@Culture.Format("Onboarding.DeleteJob", item.Role)"
                                                @onclick="() => RemoveJob(item)">×</button>
                                        <label>
                                            @Culture["Profile.Role"]
                                            <input @bind="item.Role" @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                                        </label>
                                        <label>
                                            @Culture["Profile.Employer"]
                                            <input @bind="item.EmployerName" @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                                        </label>
                                        <div class="ob-wizard__field-row">
                                            <label>
                                                @Culture["Profile.EmployerFrom"]
                                                <input type="month" value="@item.StartMonth"
                                                       @onchange="e => SetJobStart(item, e.Value?.ToString())" />
                                            </label>
                                            <label>
                                                @Culture["Profile.EmployerTo"]
                                                <input type="month" value="@item.EndMonth"
                                                       @onchange="e => SetJobEnd(item, e.Value?.ToString())" />
                                            </label>
                                        </div>
                                    </article>
                                }
                                @if (_jobs.Count < 3)
                                {
                                    <button type="button" class="ob-wizard__add-job" @onclick="AddJob">
                                        @Culture["Onboarding.AddJob"]
                                    </button>
                                }
                            }
                            break;

                        case 5:
                            <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span>
                            <h1 tabindex="-1">@Culture["Onboarding.Step5.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step5.Lead"]</p>
                            <fieldset>
                                <legend class="visually-hidden">@Culture["Profile.Education"]</legend>
                                @foreach (var level in OnboardingWizardCatalog.EducationRadioLevels)
                                {
                                    var isSelected = EducationSelected(level);
                                    <label class="ob-wizard__radio @(isSelected ? "is-selected" : null)">
                                        <input type="radio" name="education" checked="@isSelected"
                                               @onchange="() => SelectEducation(level)" />
                                        @EducationLabel(level)
                                    </label>
                                }
                                @if (_education.StartsWith("MBO", StringComparison.Ordinal))
                                {
                                    <div class="ob-wizard__transport">
                                        @foreach (var mboLevel in MboLevels)
                                        {
                                            var isSelected = MboLevelSelected(mboLevel);
                                            <button type="button" aria-pressed="@isSelected"
                                                    @onclick="() => SelectEducation(MboEducation(mboLevel))">
                                                @mboLevel
                                            </button>
                                        }
                                    </div>
                                }
                            </fieldset>
                            <label>
                                @Culture["Onboarding.EducationDirection"]
                                <input maxlength="128" @bind="_educationDirection"
                                       @bind:event="oninput" @bind:after="ScheduleProfileSave" />
                            </label>
                            break;

                        case 6:
                            <h1 tabindex="-1">@Culture["Onboarding.Step6.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Step6.Lead"]</p>
                            <div class="ob-wizard__dream-search">
                                <input role="combobox"
                                       aria-expanded="@(_dreamSearch.Length > 0)"
                                       aria-autocomplete="list"
                                       placeholder="@Culture["Onboarding.DreamSearch"]"
                                       @bind="_dreamSearch"
                                       @bind:event="oninput"
                                       @onkeydown="DreamKeyDown" />
                                @if (_dreamSearch.Length > 0)
                                {
                                    <div role="listbox">
                                        @foreach (var dreamJob in DreamJobCatalog.Search(_dreamSearch))
                                        {
                                            <button type="button" role="option" @onclick="() => ChooseDream(dreamJob)">
                                                @((MarkupString)(DreamJobIcons.TryGet(dreamJob.IconKey) ?? ""))
                                                <span>@Culture[$"DreamJob.{dreamJob.Key}"]</span>
                                            </button>
                                        }
                                        <button type="button" @onclick="ChooseOwnDream">
                                            ＋ @Culture.Format("Onboarding.DreamOwn", _dreamSearch.Trim())
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="ob-wizard__dream-grid">
                                @foreach (var dreamJob in DreamJobCatalog.All)
                                {
                                    var isSelected = _dream == dreamJob.TitleNl;
                                    <button type="button" aria-pressed="@isSelected"
                                            class="@(isSelected ? "is-selected" : null)"
                                            @onclick="() => ChooseDream(dreamJob)">
                                        <span>@((MarkupString)(DreamJobIcons.TryGet(dreamJob.IconKey) ?? ""))</span>
                                        <small>@Culture[$"DreamJob.{dreamJob.Key}"]</small>
                                    </button>
                                }
                            </div>
                            break;

                        case 7 when !_hasConsent:
                            <h1 tabindex="-1">@Culture["Onboarding.Consent.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Consent.Lead"]</p>
                            <ol class="ob-wizard__test-list">
                                @foreach (var tab in TestTabs)
                                {
                                    <li>
                                        <strong>@Culture[tab.Title]</strong>
                                        <small>@Culture[tab.Lead]</small>
                                    </li>
                                }
                            </ol>
                            <label class="ob-wizard__consent" role="switch" aria-checked="@_consentRequested">
                                <input type="checkbox" @bind="_consentRequested" />
                                @Culture["Onboarding.Consent.Check"]
                            </label>
                            <details>
                                <summary>@Culture["Onboarding.Consent.More"]</summary>
                                <p>@Culture["Onboarding.Consent.MoreText"]</p>
                            </details>
                            <p class="ob-wizard__hint">🔒 @Culture["Onboarding.Consent.Private"]</p>
                            break;

                        case >= 7 and <= 10:
                            <div class="ob-wizard__test-tabs">
                                @foreach (var tab in TestTabs)
                                {
                                    var isCurrent = tab.Step == _step;
                                    var isDone = tab.Step < _step;
                                    <span class="@(isCurrent ? "is-current" : isDone ? "is-done" : null)">
                                        @Culture[tab.Title]
                                    </span>
                                }
                            </div>
                            <h1 tabindex="-1">@Culture[$"Onboarding.Step{_step}.Title"]</h1>
                            <p class="ob-wizard__lead">@Culture["Onboarding.Test.Lead"]</p>
                            @if (_miniQuestions.Count == 0)
                            {
                                <p>@Culture["Onboarding.MiniAllDone"]</p>
                            }
                            else
                            {
                                @foreach (var question in _miniQuestions.Take(_currentQuestion + 2))
                                {
                                    var index = _miniQuestions.IndexOf(question);
                                    var answered = _miniAnswers.ContainsKey(question.Id);
                                    <LikertScaleQuestion QuestionId="question.Id"
                                                         Text="@QuestionText(question)"
                                                         Value="@(answered ? _miniAnswers[question.Id] : null)"
                                                         Collapsed="@(answered && index != _currentQuestion)"
                                                         Dimmed="@(index > _currentQuestion)"
                                                         Interactive="@(index <= _currentQuestion)"
                                                         IsCurrent="@(index == _currentQuestion)"
                                                         Index="@(index + 1)"
                                                         Total="@_miniQuestions.Count"
                                                         InputPrefix="@MiniPrefix"
                                                         ValueChanged="value => AnswerAsync(question.Id, value)"
                                                         Expanded="() => ExpandQuestion(index)" />
                                }
                            }
                            break;
                    }
                </section>

                <footer class="ob-wizard__footer">
                    <button type="button"
                            class="btn-compact btn-compact--primary ob-wizard__cta"
                            disabled="@(!CanNext || _busy)"
                            @onclick="NextAsync">@NextLabel</button>
                    @if (_step is 4 or 5)
                    {
                        <button type="button" class="ob-wizard__ghost" @onclick="SkipOptionalAsync">
                            @Culture["Onboarding.Skip"]
                        </button>
                    }
                    else if (_step == 6)
                    {
                        <button type="button" class="ob-wizard__ghost" @onclick="DreamUnknownAsync">
                            @Culture["Onboarding.DreamUnknown"]
                        </button>
                    }
                </footer>
            </main>
        </div>
    }
</div>

@code {
    private enum WizardPhase { Wizard, Install }
    private sealed record Preset(string Code, string Title, string Lead);
    private sealed record SidebarItem(int Number, int First, int Last, string Title, string Lead);
    private sealed record TestTab(int Step, string Title, string Lead);
    private sealed record WelcomePhase(int Number, string Title, string Lead, string Time);
    private sealed record MiniQuestion(int Id, string TextKey);

    private bool _loading = true;
    private bool _busy;
    private bool _welcome;
    private bool _finish;
    private bool _fineTune;
    private bool _presetsOverridden;
    private bool _immediate = true;
    private bool _noWork;
    private bool _hasConsent;
    private bool _consentRequested;
    private bool _installIos;
    private bool _installCanPrompt;
