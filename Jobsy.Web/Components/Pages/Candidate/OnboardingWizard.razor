@* Wizard v1 is retained below as a reference while v2 owns this route. *@
@page "/candidate/start"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>
<div class="ob-wizard">
@if (_v2Loading) { <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p> }
else if (_v2Phase == V2Phase.Install)
{
    <section class="ob-wizard__install">
        <h1>@Culture["Onboarding.Install.Title"]</h1><p>@Culture["Onboarding.Install.Lead"]</p>
        <div class="ob-install">
            @if (_v2InstallIos) { <p class="ob-install__hint">@Culture["Pwa.IosHint"]</p> }
            else if (_v2InstallCanPrompt) { <button type="button" class="btn-compact btn-compact--primary" @onclick="V2InstallAsync">@Culture["Onboarding.Install.AddApp"]</button> }
            <button type="button" class="btn-compact btn-compact--primary" @onclick="V2PushAsync">@Culture["Onboarding.Install.EnablePush"]</button>
            @if (!string.IsNullOrEmpty(_v2InstallMessage)) { <p aria-live="polite">@_v2InstallMessage</p> }
        </div>
        <button type="button" class="ob-wizard__ghost" @onclick="V2InstallLaterAsync">@Culture["Onboarding.Install.Later"]</button>
    </section>
}
else if (_v2Finish || _v2State?.FinishReached == true)
{
    <section class="ob-wizard__finish">
        <div class="ob-wizard__compass" aria-hidden="true">⌾</div>
        <span class="ob-wizard__badge">@Culture["Onboarding.Finish.Badge"]</span>
        <h1>@Culture.Format("Onboarding.Finish.Title", _v2FirstName)</h1>
        <p class="ob-wizard__lead">@Culture["Onboarding.Finish.Lead"]</p>
        @if (_v2State?.Impression is { } impression)
        {
            <div class="ob-wizard__highlights">
                @if (impression.Strengths.FirstOrDefault() is { } strength) { <article><small>@Culture["Onboarding.Finish.Strength"]</small><strong>@strength.Sentence</strong></article> }
                @if (impression.Riasec.Take(2).ToList() is { Count: > 0 } riasec) { <article><small>@Culture["Onboarding.Finish.Work"]</small><strong>@string.Join($" {Culture["Onboarding.And"]} ", riasec.Select(x => x.Label))</strong></article> }
                @if (impression.TopValue is { } value) { <article><small>@Culture["Onboarding.Finish.Value"]</small><strong>@value.Label</strong></article> }
            </div>
            @if (impression.MatchingVacancyCount > 0) { <p class="ob-wizard__figure"><strong>@impression.MatchingVacancyCount</strong> @Culture["Onboarding.Finish.Matches"]</p> }
        }
        <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="V2CompleteAsync">@Culture["Onboarding.Finish.Cta"]</button>
        <a class="ob-wizard__ghost" href="/home?tab=tests">@Culture["Onboarding.Finish.FullTests"]</a>
    </section>
}
else if (_v2Welcome)
{
    <section class="ob-wizard__welcome">
        <div class="lobsy-logo"><img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" /></div>
        <h1>@Culture.Format("Onboarding.Welcome.Title", _v2FirstName)</h1><p class="ob-wizard__lead">@Culture["Onboarding.Welcome.Lead"]</p>
        <div class="ob-wizard__phase-cards">
            @foreach (var phase in V2WelcomePhases) { <article><span>@phase.Number</span><div><strong>@Culture[phase.Title]</strong><small>@Culture[phase.Lead]</small></div><small>@Culture[phase.Time]</small></article> }
        </div>
        <p class="ob-wizard__hint">@Culture["Onboarding.Welcome.Hint"]</p>
        <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="V2BeginAsync">@Culture["Onboarding.Welcome.Cta"]</button>
    </section>
}
else
{
    var phase = OnboardingWizardCatalog.PhaseForStep(_v2Step);
    <div class="ob-wizard__layout">
        <aside class="ob-wizard__sidebar">
            <div class="lobsy-logo"><img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" /></div>
            @foreach (var item in V2Sidebar) { var current = item.First <= _v2Step && _v2Step <= item.Last; var done = _v2Step > item.Last; <div class="ob-wizard__side-item @(current ? "is-current" : null) @(done ? "is-done" : null)"><span>@(done ? "✓" : item.Number)</span><div><strong>@Culture[item.Title]</strong><small>@Culture[item.Lead]</small></div></div> }
            <p class="ob-wizard__saved">✓ @Culture["Onboarding.AllSaved"]</p><button type="button" class="ob-wizard__ghost" @onclick="V2LaterAsync">@Culture["Onboarding.Later"]</button>
        </aside>
        <main class="ob-wizard__main">
            <header class="ob-wizard__header">
                <div class="ob-wizard__header-row">
                    <button type="button" class="icon-btn ob-wizard__back" disabled="@(_v2Step == 1)" aria-label="@Culture["Onboarding.BackAria"]" @onclick="V2BackAsync">‹</button>
                    <div class="ob-wizard__segments" role="progressbar" aria-valuemin="1" aria-valuemax="10" aria-valuenow="@_v2Step" aria-label="@Culture.Format("Onboarding.ProgressAria", _v2Step, 10)">
                        @foreach (var item in OnboardingWizardCatalog.Phases) { <span><i style="--w:@(OnboardingWizardCatalog.PhaseFill(item, _v2Step) * 100)%"></i></span> }
                    </div>
                    <button type="button" class="ob-wizard__later" @onclick="V2LaterAsync">@Culture["Onboarding.Later"]</button>
                </div>
                <div class="ob-wizard__status-row"><span><strong>@Culture[phase.NameKey]</strong> · @Culture.Format("Onboarding.StepLine", _v2Step, OnboardingWizardCatalog.RemainingMinutes(_v2Step))</span><span aria-live="polite" class="@(_v2SaveError ? "is-error" : null)">@V2SaveText</span></div>
            </header>
            <section class="ob-wizard__content">
                @if (!string.IsNullOrWhiteSpace(_v2Error)) { <p class="state-message error">@_v2Error</p> }
                @switch (_v2Step)
                {
                    case 1:
                        <h1 tabindex="-1">@Culture["Onboarding.Step1.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step1.Lead"]</p>
                        <div class="ob-wizard__field-row"><label>@Culture["Profile.FirstName"]<input autocomplete="given-name" maxlength="128" @bind="_v2FirstName" @bind:event="oninput" @bind:after="V2ScheduleProfileSave" /></label><label>@Culture["Profile.LastName"]<input autocomplete="family-name" maxlength="128" @bind="_v2LastName" @bind:event="oninput" @bind:after="V2ScheduleProfileSave" /></label></div>
                        <label>@Culture["Onboarding.Postcode"]<input inputmode="text" autocomplete="postal-code" maxlength="7" @bind="_v2Postcode" @bind:event="oninput" @bind:after="V2AddressChanged" /></label>
                        @if (_v2PostcodeResolved) { <p class="ob-wizard__hint">✓ @Culture.Format("Onboarding.PostcodeResolved", _v2City)</p> }
                        @if (_v2PostcodeMissing) { <p class="error">@Culture["Onboarding.PostcodeNotFound"] <button type="button" class="ob-wizard__inline-link" @onclick="() => _v2ShowCity = true">@Culture["Onboarding.EnterCity"]</button></p> }
                        @if (_v2ShowCity) { <label>@Culture["Onboarding.City"]<input autocomplete="address-level2" @bind="_v2City" @bind:event="oninput" @bind:after="V2AddressChanged" /></label> }
                        @if (_v2Suggestions.Count > 0) { <ul class="ob-wizard__suggestions">@foreach (var item in _v2Suggestions) { <li><button type="button" @onclick="() => V2SelectAddress(item)">@item.Label</button></li> }</ul> }
                        <fieldset><legend>@Culture["Onboarding.BirthDate"]</legend><div class="ob-wizard__birth"><label>@Culture["Onboarding.Day"]<input inputmode="numeric" maxlength="2" @bind="_v2BirthDay" @bind:event="oninput" @bind:after="V2DateChanged" /></label><label>@Culture["Onboarding.Month"]<input inputmode="numeric" maxlength="2" @bind="_v2BirthMonth" @bind:event="oninput" @bind:after="V2DateChanged" /></label><label>@Culture["Onboarding.Year"]<input inputmode="numeric" maxlength="4" @bind="_v2BirthYear" @bind:event="oninput" @bind:after="V2DateChanged" /></label></div><small>@Culture["Onboarding.BirthHint"]</small></fieldset>
                        <label>@Culture["Profile.Phone"] <small>@Culture["Onboarding.Optional"]</small><input type="tel" autocomplete="tel" @bind="_v2Phone" @bind:event="oninput" @bind:after="V2ScheduleProfileSave" /></label>
                        break;
                    case 2:
                        <h1 tabindex="-1">@Culture["Onboarding.Step2.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step2.Lead"]</p>
                        <fieldset><legend class="visually-hidden">@Culture["Onboarding.Step2.Title"]</legend><div class="ob-wizard__presets">@foreach (var preset in V2Presets) { var selected = _v2Presets.Contains(preset.Code); <button type="button" aria-pressed="@selected" class="@(selected ? "is-selected" : null)" @onclick="() => V2TogglePreset(preset.Code)"><span>@(selected ? "✓" : "")</span><b>@Culture[preset.Title]</b><small>@Culture[preset.Lead]</small></button> }</div></fieldset>
                        <div class="ob-wizard__availability-summary"><strong>@Culture["Onboarding.AvailabilitySummary"]</strong><button type="button" aria-expanded="@_v2FineTune" @onclick="() => _v2FineTune = !_v2FineTune">@Culture["Onboarding.Adjust"]</button><dl><div><dt>@Culture["Vacancy.HoursPerWeek"]</dt><dd>@V2HoursLabel</dd></div><div><dt>@Culture["Profile.Availability"]</dt><dd>@V2DaysSummary</dd></div><div><dt>@Culture["Onboarding.AvailableFrom"]</dt><dd>@(_v2Immediate ? Culture["Onboarding.AvailableImmediate"] : _v2AvailableFrom?.ToString())</dd></div></dl></div>
                        @if (!_v2Immediate) { <label>@Culture["Onboarding.AvailableFrom"]<input type="date" @bind="_v2AvailableFrom" @bind:after="V2ScheduleProfileSave" /></label> }
                        @if (_v2FineTune) { <div class="ob-wizard__fine-tune"><div class="ob-wizard__field-row"><label>@Culture["Onboarding.MinHours"]<input type="number" min="1" max="60" @bind="_v2MinHours" @bind:after="V2ManualAvailability" /></label><label>@Culture["Onboarding.MaxHours"]<input type="number" min="1" max="60" @bind="_v2MaxHours" @bind:after="V2ManualAvailability" /></label></div><fieldset><legend>@Culture["Profile.Availability"]</legend><div class="ob-wizard__matrix">@foreach (var day in V2Days) { <span>@UiLabels.Weekday(Culture, day)</span> @foreach (var slot in V2Slots.Where(x => x != "Nacht")) { var key = $"{day}:{slot}"; var on = _v2Availability.Contains(key); <button type="button" aria-pressed="@on" aria-label="@($"{UiLabels.Weekday(Culture, day)} {UiLabels.AvailabilitySlot(Culture, slot)}")" class="@(on ? "is-on" : null)" @onclick="() => V2ToggleAvailability(key)">@UiLabels.AvailabilitySlot(Culture, slot)</button> } }</div></fieldset>@if (_v2PresetsOverridden) { <p class="ob-wizard__hint">@Culture["Onboarding.ManualOverride"] <button type="button" class="ob-wizard__inline-link" @onclick="V2ResetPresets">@Culture["Onboarding.Refill"]</button></p> }</div> }
                        @if (!V2AvailabilityValid) { <p class="ob-wizard__hint error">@Culture["Onboarding.AvailabilityRequired"]</p> }
                        break;
                    case 3:
                        <h1 tabindex="-1">@Culture["Onboarding.Step3.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step3.Lead"]</p><fieldset><legend>@Culture["Onboarding.Transport"]</legend><div class="ob-wizard__transport">@foreach (var transport in V2Transport) { var selected = _v2Transport == transport; <button type="button" aria-pressed="@selected" class="@(selected ? "is-selected" : null)" @onclick="() => { _v2Transport = transport; V2ScheduleProfileSave(); }">@Culture[$"Transport.{transport}"]</button> }</div></fieldset><fieldset><legend>@Culture["Onboarding.MaxTravel"] <strong>@_v2MaxTravel @Culture["Onboarding.Minutes"]</strong></legend><div class="ob-wizard__transport">@foreach (var minute in V2TravelChoices) { <button type="button" aria-pressed="@(_v2MaxTravel == minute)" @onclick="() => { _v2MaxTravel = minute; _v2CustomTravel = false; V2ScheduleProfileSave(); }">@minute</button> }</div><button type="button" class="ob-wizard__inline-link" @onclick="() => _v2CustomTravel = true">@Culture["Onboarding.Other"]</button>@if (_v2CustomTravel) { <input type="number" min="1" max="180" @bind="_v2MaxTravel" @bind:after="V2ScheduleProfileSave" /> }</fieldset>
                        break;
                    case 4:
                        <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span><h1 tabindex="-1">@Culture["Onboarding.Step4.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step4.Lead"]</p><label class="ob-wizard__check"><input type="checkbox" @bind="_v2NoWork" @bind:after="V2ScheduleProfileSave" />@Culture["Onboarding.NoWorkExperience"]</label>@if (!_v2NoWork) { @foreach (var job in _v2Jobs) { var item = job; <article class="ob-wizard__job"><button type="button" class="icon-btn" aria-label="@Culture.Format("Onboarding.DeleteJob", item.Role)" @onclick="() => V2RemoveJob(item)">×</button><strong>@item.Role</strong><small>@item.EmployerName</small></article> } @if (_v2Jobs.Count < 3) { <button type="button" class="ob-wizard__add-job" @onclick="V2AddJob">@Culture["Onboarding.AddJob"]</button> } }<button type="button" class="ob-wizard__ghost" @onclick="V2SkipOptionalAsync">@Culture["Onboarding.Skip"]</button>
                        break;
                    case 5:
                        <span class="ob-wizard__badge">@Culture["Onboarding.Optional"]</span><h1 tabindex="-1">@Culture["Onboarding.Step5.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step5.Lead"]</p><fieldset><legend class="visually-hidden">@Culture["Profile.Education"]</legend>@foreach (var level in OnboardingWizardCatalog.EducationRadioLevels) { var on = _v2Education == level || (level == "MBO" && _v2Education?.StartsWith("MBO") == true); <label class="ob-wizard__radio @(on ? "is-selected" : null)"><input type="radio" name="education" checked="@on" @onchange="() => V2SelectEducation(level)" />@(level == EducationLevelLabels.None ? Culture["Education.None"] : level)</label> }@if (_v2Education?.StartsWith("MBO") == true) { <div class="ob-wizard__transport">@foreach (var level in new[] { "1", "2", "3", "4" }) { <button type="button" aria-pressed="@(_v2Education == $"MBO {level}")" @onclick="() => V2SelectEducation($"MBO {level}")">@level</button> }</div> }</fieldset><label>@Culture["Onboarding.EducationDirection"]<input maxlength="128" @bind="_v2EducationDirection" @bind:event="oninput" @bind:after="V2ScheduleProfileSave" /></label><button type="button" class="ob-wizard__ghost" @onclick="V2SkipOptionalAsync">@Culture["Onboarding.Skip"]</button>
                        break;
                    case 6:
                        <h1 tabindex="-1">@Culture["Onboarding.Step6.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Step6.Lead"]</p><div class="ob-wizard__dream-search"><input role="combobox" aria-expanded="@(_v2DreamSearch.Length > 0)" aria-autocomplete="list" placeholder="@Culture["Onboarding.DreamSearch"]" @bind="_v2DreamSearch" @bind:event="oninput" @onkeydown="V2DreamKeyDown" />@if (_v2DreamSearch.Length > 0) { <div role="listbox">@foreach (var job in DreamJobCatalog.Search(_v2DreamSearch)) { <button type="button" role="option" @onclick="() => V2ChooseDream(job)">@((MarkupString)(DreamJobIcons.TryGet(job.IconKey) ?? ""))<span>@Culture[$"DreamJob.{job.Key}"]</span></button> }<button type="button" @onclick="V2ChooseOwnDream">＋ @Culture.Format("Onboarding.DreamOwn", _v2DreamSearch.Trim())</button></div> }</div><div class="ob-wizard__dream-grid">@foreach (var job in DreamJobCatalog.All) { var selected = _v2Dream == job.TitleNl; <button type="button" aria-pressed="@selected" class="@(selected ? "is-selected" : null)" @onclick="() => V2ChooseDream(job)"><span>@((MarkupString)(DreamJobIcons.TryGet(job.IconKey) ?? ""))</span><small>@Culture[$"DreamJob.{job.Key}"]</small></button> }</div><button type="button" class="ob-wizard__ghost" @onclick="V2DreamUnknownAsync">@Culture["Onboarding.DreamUnknown"]</button>
                        break;
                    case 7 when !_v2HasConsent:
                        <h1 tabindex="-1">@Culture["Onboarding.Consent.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Consent.Lead"]</p><ol class="ob-wizard__test-list">@foreach (var item in V2TestTabs) { <li><strong>@Culture[item.Title]</strong><small>@Culture[item.Lead]</small></li> }</ol><label class="ob-wizard__consent" role="switch" aria-checked="@_v2ConsentRequested"><input type="checkbox" @bind="_v2ConsentRequested" />@Culture["Onboarding.Consent.Check"]</label><details><summary>@Culture["Onboarding.Consent.More"]</summary><p>@Culture["Onboarding.Consent.MoreText"]</p></details><p class="ob-wizard__hint">🔒 @Culture["Onboarding.Consent.Private"]</p>
                        break;
                    case >= 7 and <= 10:
                        <div class="ob-wizard__test-tabs">@foreach (var tab in V2TestTabs) { var isCurrent = tab.Step == _v2Step; var done = tab.Step < _v2Step; <span class="@(isCurrent ? "is-current" : done ? "is-done" : null)">@Culture[tab.Title]</span> }</div><h1 tabindex="-1">@Culture[$"Onboarding.Step{_v2Step}.Title"]</h1><p class="ob-wizard__lead">@Culture["Onboarding.Test.Lead"]</p>@if (_v2MiniQuestions.Count == 0) { <p>@Culture["Onboarding.MiniAllDone"]</p> } else { @foreach (var question in _v2MiniQuestions.Take(_v2CurrentQuestion + 2)) { var index = _v2MiniQuestions.IndexOf(question); var answered = _v2MiniAnswers.ContainsKey(question.Id); <LikertScaleQuestion QuestionId="question.Id" Text="@V2QuestionText(question)" Value="@(answered ? _v2MiniAnswers[question.Id] : null)" Collapsed="@(answered && index != _v2CurrentQuestion)" Dimmed="@(index > _v2CurrentQuestion)" Interactive="@(index <= _v2CurrentQuestion)" IsCurrent="@(index == _v2CurrentQuestion)" Index="@(index + 1)" Total="@_v2MiniQuestions.Count" InputPrefix="@V2MiniPrefix" ValueChanged="value => V2AnswerAsync(question.Id, value)" Expanded="() => V2ExpandQuestion(index)" /> } }
                        break;
                }
            </section>
            <footer class="ob-wizard__footer"><button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" disabled="@(!_v2CanNext || _v2Busy)" @onclick="V2NextAsync">@V2NextLabel</button></footer>
        </main>
    </div>
}
</div>

@code {
    private enum V2Phase { Wizard, Install }
    private sealed record V2Preset(string Code, string Title, string Lead);
    private sealed record V2Side(int Number, int First, int Last, string Title, string Lead);
    private sealed record V2Tab(int Step, string Title, string Lead);
    private sealed record V2Welcome(int Number, string Title, string Lead, string Time);
    private sealed record V2Question(int Id, string TextKey);
    private bool _v2Loading = true, _v2Busy, _v2Welcome, _v2Finish, _v2FineTune, _v2PresetsOverridden, _v2Immediate = true, _v2NoWork, _v2HasConsent, _v2ConsentRequested, _v2InstallIos, _v2InstallCanPrompt, _v2CustomTravel, _v2ShowCity, _v2PostcodeMissing, _v2PostcodeResolved, _v2Saving, _v2SavedVisible, _v2SaveError;
    private int _v2Step = 1, _v2CurrentQuestion, _v2MaxTravel = 30;
    private decimal? _v2MinHours = 8, _v2MaxHours = 24;
    private string _v2FirstName = "", _v2LastName = "", _v2Phone = "", _v2Postcode = "", _v2City = "", _v2Transport = "", _v2Dream = "", _v2DreamSearch = "", _v2BirthDay = "", _v2BirthMonth = "", _v2BirthYear = "", _v2Education = "", _v2EducationDirection = "", _v2InstallMessage = "";
    private DateOnly? _v2BirthDate, _v2AvailableFrom;
    private double? _v2HomeLat, _v2HomeLng;
    private V2Phase _v2Phase;
    private OnboardingState? _v2State;
    private readonly HashSet<string> _v2Availability = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _v2Presets = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<CandidateEmployerHistory> _v2Jobs = [];
    private readonly List<AddressSuggestion> _v2Suggestions = [];
    private readonly Dictionary<int, int> _v2MiniAnswers = new();
    private readonly Dictionary<int, int> _v2ServerAnswers = new();
    private readonly HashSet<int> _v2LockedIds = [];
    private List<V2Question> _v2MiniQuestions = [];
    private QuestionnaireAutosave? _v2Autosave;
    private CancellationTokenSource? _v2SaveCts, _v2GeoCts, _v2DreamCts;
    private static readonly string[] V2Days = DayPartMatrix.DayCodes;
    private static readonly string[] V2Slots = DayPartMatrix.DayPartCodes;
    private static readonly string[] V2Transport = ["Lopend", "Fiets", "E-bike", "OV", "Auto"];
    private static readonly int[] V2TravelChoices = [10, 20, 30, 45];
    private static readonly V2Preset[] V2Presets = [new("direct","Onboarding.Preset.Direct","Onboarding.Preset.Direct.Lead"),new("school","Onboarding.Preset.School","Onboarding.Preset.School.Lead"),new("weekend","Onboarding.Preset.Weekend","Onboarding.Preset.Weekend.Lead"),new("evening","Onboarding.Preset.Evening","Onboarding.Preset.Evening.Lead"),new("office","Onboarding.Preset.Office","Onboarding.Preset.Office.Lead"),new("holiday","Onboarding.Preset.Holiday","Onboarding.Preset.Holiday.Lead"),new("parttime","Onboarding.Preset.Parttime","Onboarding.Preset.Parttime.Lead"),new("fulltime","Onboarding.Preset.Fulltime","Onboarding.Preset.Fulltime.Lead")];
    private static readonly V2Side[] V2Sidebar = [new(1,1,3,"Onboarding.Phase.OverJou","Onboarding.Side.OverJou"),new(2,4,5,"Onboarding.Phase.Achtergrond","Onboarding.Side.Achtergrond"),new(3,6,6,"Onboarding.Phase.Droom","Onboarding.Side.Droom"),new(4,7,10,"Onboarding.Phase.WieBenJij","Onboarding.Side.WieBenJij"),new(5,11,11,"Onboarding.Side.Kompas","Onboarding.Side.KompasLead")];
    private static readonly V2Tab[] V2TestTabs = [new(7,"Onboarding.Test.Competency","Onboarding.Test.Competency.Lead"),new(8,"Onboarding.Test.Career","Onboarding.Test.Career.Lead"),new(9,"Onboarding.Test.Culture","Onboarding.Test.Culture.Lead"),new(10,"Onboarding.Test.Values","Onboarding.Test.Values.Lead")];
    private static readonly V2Welcome[] V2WelcomePhases = [new(1,"Onboarding.Phase.OverJou","Onboarding.Welcome.OverJou","Onboarding.Welcome.Time2"),new(2,"Onboarding.Welcome.Background","Onboarding.Welcome.BackgroundLead","Onboarding.Welcome.Time1"),new(3,"Onboarding.Welcome.Dream","Onboarding.Welcome.DreamLead","Onboarding.Welcome.TimeHalf"),new(4,"Onboarding.Phase.WieBenJij","Onboarding.Welcome.TestsLead","Onboarding.Welcome.Time2")];
    private string V2SaveText => _v2SaveError ? Culture["Onboarding.NotSaved"] : _v2Saving ? Culture["Onboarding.Saving"] : _v2SavedVisible ? $"✓ {Culture["Onboarding.Saved"]}" : "";
    private string V2HoursLabel => _v2MinHours is not null && _v2MaxHours is not null ? $"{_v2MinHours:0} – {_v2MaxHours:0} {Culture["Onboarding.Hours"]}" : "–";
    private string V2DaysSummary => _v2Availability.Count == 0 ? "–" : Culture.Format("Onboarding.DayPartsCount", _v2Availability.Count);
    private bool V2AvailabilityValid => _v2MinHours is > 0 && _v2MaxHours >= _v2MinHours && _v2Availability.Count > 0;
    private string V2MiniPrefix => $"obv2-{_v2Step}-";
    private string V2NextLabel => _v2Step == 7 && !_v2HasConsent ? Culture["Onboarding.Consent.Cta"] : _v2Step == 10 ? Culture["Onboarding.Finish.Cta"] : _v2Step is >= 7 ? Culture["Onboarding.NextTest"] : _v2FineTune && _v2Step == 2 ? Culture["Onboarding.Done"] : Culture["Onboarding.Next"];
    private bool _v2CanNext => _v2Step switch { 1 => !string.IsNullOrWhiteSpace(_v2FirstName) && !string.IsNullOrWhiteSpace(_v2LastName) && _v2BirthDate is not null && ((_v2HomeLat is not null && _v2HomeLng is not null) || !string.IsNullOrWhiteSpace(_v2City)), 2 => V2AvailabilityValid, 3 => !string.IsNullOrWhiteSpace(_v2Transport) && _v2MaxTravel > 0, 6 => !string.IsNullOrWhiteSpace(_v2Dream), 7 when !_v2HasConsent => _v2ConsentRequested, >= 7 => _v2MiniQuestions.All(q => _v2MiniAnswers.ContainsKey(q.Id)), _ => true };

    protected override async Task OnInitializedAsync() { Culture.Changed += V2CultureChanged; await V2LoadAsync(); }
