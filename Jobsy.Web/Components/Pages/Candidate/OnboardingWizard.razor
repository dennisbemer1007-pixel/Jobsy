    private void ClearMiniAnswersBeforeStepChange()
    {
        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _currentQuestion = 0;
    }

    private async Task PrepareMiniAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
            _autosave = null;
        }
        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _miniBlockQuestionIds = [];
        _miniQuestions = [];
        _currentQuestion = 0;
        if (_step is < 7 or > 10 || !Draft.HasConsent) return;

        Dictionary<string, int>? answers;
        IEnumerable<(int Id, string Key)> catalog;
        int[] questionIds;
        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        switch (_step)
        {
            case 7:
                var competency = await Api.GetMyCompetenciesAsync();
                answers = competency?.Answers;
                var compVersion = ResolveQuickScanVersion(competency?.QuickScanVersion, testsV2);
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Competence, compVersion);
                catalog = AssessmentQuickScanCatalog.CompetenceQuestions(compVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            case 8:
                var career = await Api.GetMyCareerInterestsAsync();
                answers = career?.Answers;
                var careerVersion = ResolveQuickScanVersion(career?.QuickScanVersion, testsV2);
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Career, careerVersion);
                catalog = AssessmentQuickScanCatalog.CareerQuestions(careerVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            case 9:
                var culture = await Api.GetMyCultureAsync();
                answers = culture?.Answers;
                var cultureVersion = ResolveQuickScanVersion(culture?.QuickScanVersion, testsV2);
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Culture, cultureVersion);
                catalog = AssessmentQuickScanCatalog.CultureQuestions(cultureVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
            default:
                var values = await Api.GetMyValuesAsync();
                answers = values?.Answers;
                var valuesVersion = ResolveQuickScanVersion(values?.QuickScanVersion, testsV2);
                questionIds = TestDepthRules.MiniIds(AssessmentKind.Values, valuesVersion);
                catalog = AssessmentQuickScanCatalog.ValuesQuestions(valuesVersion)
                    .Select(item => (item.Id, item.TextKey));
                break;
        }

        foreach (var answer in answers ?? [])
        {
            if (int.TryParse(answer.Key, out var id)
                && questionIds.Contains(id)
                && answer.Value is >= 1 and <= 5)
            {
                _serverAnswers[id] = answer.Value;
            }
        }
        _miniBlockQuestionIds = questionIds;
        foreach (var id in questionIds)
        {
            if (_serverAnswers.ContainsKey(id)) _lockedIds.Add(id);
        }

        var catalogById = catalog.ToDictionary(item => item.Id);
        _miniQuestions = questionIds
            .Where(catalogById.ContainsKey)
            .Select(id => new OnboardingMiniTest.MiniQuestion(id, catalogById[id].Key))
            .ToList();
        var firstOpen = _miniQuestions.FindIndex(q =>
            !_serverAnswers.ContainsKey(q.Id) && !_miniAnswers.ContainsKey(q.Id));
        if (_miniArrivedViaBack && _miniQuestions.Count > 0)
        {
            _currentQuestion = _miniQuestions.Count - 1;
        }
        else
        {
            _currentQuestion = firstOpen < 0 ? 0 : firstOpen;
        }
        var allowedIds = questionIds.ToHashSet();
        _autosave = new QuestionnaireAutosave(async (draft, cancellationToken) =>
        {
            var merged = new Dictionary<int, int>(_serverAnswers);
            foreach (var answer in draft)
            {
                if (allowedIds.Contains(answer.Key))
                {
                    merged[answer.Key] = answer.Value;
                }
            }

            switch (_step)
            {
                case 7:
                    await Api.SaveMyCompetenciesAsync(merged, false, cancellationToken);
                    break;
                case 8:
                    await Api.SaveMyCareerInterestsAsync(merged, false, cancellationToken);
                    break;
                case 9:
                    await Api.SaveMyCultureAsync(merged, false, cancellationToken);
                    break;
                case 10:
                    await Api.SaveMyValuesAsync(merged, false, cancellationToken);
                    break;
            }
        }, () => InvokeAsync(StateHasChanged), 150);
    }

    private async Task TryAutoAdvanceEmptyMiniStepAsync()
    {
        if (_miniArrivedViaBack || _welcome || _finish)
        {
            return;
        }

        if (_step is < 7 or > 10)
        {
            return;
        }

        if (_step == 7 && !Draft.HasConsent)
        {
            return;
        }

        if (_miniQuestions.Count > 0)
        {
            return;
        }

        if (_step == 7 && Draft.HasConsent && await CompetencyMiniCompleteAsync())
        {
            await LoadEarlyStrengthAsync();
            _earlyMoment = EarlyRewardMoment.FirstInsight;
            RequestStepScrollReset();
            return;
        }

        _busy = true;
        try
        {
            if (_step == 10)
            {
                await FinalizeApplyReadinessAsync();
                _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
                _finish = true;
                _state = await Api.GetMyOnboardingAsync() ?? _state;
                return;
            }

            _step++;
            _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
            FlashSaved();
            await PrepareMiniAsync();
            await TryAutoAdvanceEmptyMiniStepAsync();
            RequestStepScrollReset();
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private string QuestionText(OnboardingMiniTest.MiniQuestion question) => Culture[question.TextKey];

    private IReadOnlyDictionary<int, int> MiniVisibleAnswers
    {
        get
        {
            var allowed = _miniBlockQuestionIds.Length > 0
                ? _miniBlockQuestionIds.ToHashSet()
                : _miniQuestions.Select(q => q.Id).ToHashSet();
            if (_serverAnswers.Count == 0)
            {
                return FilterMiniAnswers(_miniAnswers, allowed);
            }

            var merged = new Dictionary<int, int>(_serverAnswers);
            foreach (var answer in _miniAnswers)
            {
                if (allowed.Contains(answer.Key))
                {
                    merged[answer.Key] = answer.Value;
                }
            }

            return FilterMiniAnswers(merged, allowed);
        }
    }

    private static IReadOnlyDictionary<int, int> FilterMiniAnswers(
        IReadOnlyDictionary<int, int> source,
        IReadOnlySet<int> allowed)
    {
        if (allowed.Count == 0)
        {
            return source;
        }

        var filtered = new Dictionary<int, int>();
        foreach (var (id, value) in source)
        {
            if (allowed.Contains(id))
            {
                filtered[id] = value;
            }
        }

        return filtered;
    }

    private Task AnswerAsync(int id, int value)
    {
        _miniAnswers[id] = value;
        FlashSaved();
        if (_autosave is not null)
        {
            _ = SaveMiniQuietAsync(id, value);
        }

        _ = InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async Task FinishMiniAsync()
    {
        if (_step == 7)
        {
            _busy = true;
            try
            {
                if (_autosave is not null)
                {
                    await _autosave.FlushAsync();
                }

                await LoadEarlyStrengthAsync();
                _earlyMoment = EarlyRewardMoment.FirstInsight;
                RequestStepScrollReset();
            }
            catch (Exception ex)
            {
                _error = UserFacing.Describe(ex);
            }
            finally
            {
                _busy = false;
            }

            return;
        }

        await NextAsync(fromMiniTestFinish: true);
    }

    private async Task SaveMiniQuietAsync(int id, int value)
    {
        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch
        {
            // The answer is already on screen; leaving the step still flushes.
        }
    }

    private void ExpandQuestion(int index) => _currentQuestion = index;

    private async Task AcceptConsentAsync()
    {
        var profile = await Api.AcceptTestAiConsentAsync();
        Draft.HasConsent = profile?.TestAiConsentAt is not null;
        if (Draft.HasConsent)
        {
            await PrepareMiniAsync();
            await TryAutoAdvanceEmptyMiniStepAsync();
        }
        else _error = Culture["Onboarding.Consent.Failed"];
    }

    private async void OnGratisDnaMerged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    Draft.HasConsent = profile.TestAiConsentAt is not null;
                }

                if (!_loading && !_welcome && !_finish && _step is >= 7 and <= 10)
                {
                    await RefreshJourneyCompletionAsync();
                    await PrepareMiniAsync();
                    await TryAutoAdvanceEmptyMiniStepAsync();
                }

                StateHasChanged();
            });
        }
        catch
        {
            // Reload is best effort.
        }
    }

    private void ScheduleProfileSave()
    {
        if (_loading) return;
        _saveCts?.Cancel();
        _saveCts = new();
        _saving = true;
        _saveError = false;
        _ = ProfileDebounceAsync(_saveCts.Token);
    }

    private async Task ProfileDebounceAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(350, cancellationToken);
            await SaveProfileAsync(cancellationToken);
            _error = null;
            try
            {
                await RefreshNearbySignalIfEligibleAsync();
            }
            catch
            {
                // Nearby panel is informational; a failed refresh must not block autosave UX.
            }

            FlashSaved();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FlushAsync()
    {
        _saveCts?.Cancel();
        await SaveProfileAsync(CancellationToken.None);
        try
        {
            await RefreshNearbySignalIfEligibleAsync();
        }
        catch
        {
        }
    }

    private Task SaveProfileAsync(CancellationToken cancellationToken) => Api.UpdateMyProfileAsync(
        dateOfBirth: Draft.BirthDate,
        preferences: new CandidatePreferences
        {
            MinHoursPerWeek = Draft.MinHours,
            MaxHoursPerWeek = Draft.MaxHours,
            MaxTravelMinutes = Draft.MaxTravel,
            PreferredTransport = string.IsNullOrWhiteSpace(Draft.Transport) ? null : Draft.Transport,
            Availability = BuildAvailability(),
            AvailabilityPresets = Draft.Presets.ToList(),
            AvailabilityPresetsOverridden = Draft.PresetsOverridden,
            Employers = Draft.JobsForSave(),
            NoWorkExperience = Draft.NoWork,
            Educations = string.IsNullOrWhiteSpace(Draft.Education)
                ? []
                : [OnboardingWizardCatalog.FormatEducationLine(Draft.Education, Draft.EducationDirection)],
            EducationDirection = EducationDirectionCatalog.SupportsDirection(Draft.Education) && !string.IsNullOrWhiteSpace(Draft.EducationDirection)
                ? Draft.EducationDirection.Trim()
                : null,
            HomeAddress = HomeAddress(),
            WorkStatuses = Draft.WorkStatuses.OrderBy(x => x).ToList()
        },
        homeLatitude: Draft.HomeLat,
        homeLongitude: Draft.HomeLng,
        clearHomeLocation: string.IsNullOrWhiteSpace(HomeAddress()),
        firstName: Draft.FirstName.Trim(),
        lastName: Draft.LastName.Trim(),
        phoneNumber: string.IsNullOrWhiteSpace(Draft.Phone) ? null : Draft.Phone.Trim(),
        availableFromDate: Draft.Immediate ? null : Draft.AvailableFrom,
        clearAvailableFromDate: Draft.Immediate,
        ct: cancellationToken);

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in Draft.Availability)
        {
            var pair = key.Split(':', 2);
            if (pair.Length != 2) continue;
            if (!result.TryGetValue(pair[0], out var values)) result[pair[0]] = values = [];
            values.Add(pair[1]);
        }
        return result;
    }

    private void FlashSaved()
    {
        _saving = false;
        _saveError = false;
        _savedVisible = true;
        _ = HideSavedAsync();
    }

    private async Task HideSavedAsync()
    {
        await Task.Delay(2500);
        _savedVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshNearbySignalIfEligibleAsync()
    {
        if (!NearbyPanelEligible)
        {
            return;
        }

        _loadingNearby = true;
        try
        {
            var signal = await Api.GetOnboardingNearbySignalAsync();
            if (signal is not null)
            {
                _nearbyPeakCount = Math.Max(_nearbyPeakCount, signal.Count);
                _nearbySignal = signal;
            }
        }
        catch
        {
            // Keep last signal; never surface panel refresh as wizard error.
        }
        finally
        {
            _loadingNearby = false;
        }
    }

    private async Task ApplyLegacyNearbyRedirectAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
                .TryGetValue("from", out var fromValues)
            || !string.Equals(fromValues.FirstOrDefault(), "nearby", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (_step != 3)
        {
            return;
        }

        _step = 4;
        _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
        FlashSaved();
        await PrepareMiniAsync();
    }

    private async Task LoadEarlyStrengthAsync()
    {
        var competency = await Api.GetMyCompetenciesAsync();
        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        var version = ResolveQuickScanVersion(competency?.QuickScanVersion, testsV2);
        var answerMap = ParseMiniAnswers(competency?.Answers);
        var preview = AssessmentQuickScanCatalog.ScoreCompetence(answerMap, version);
        var top = OnboardingImpressionComposer.TopCompetencyItems(preview, 1).FirstOrDefault();
        _earlyStrength = top is null
            ? null
            : new OnboardingImpressionItem
            {
                Code = top.Code,
                Label = top.Label,
                Sentence = top.Sentence,
                Percent = top.Percent
            };
    }

    private async Task<bool> CompetencyMiniCompleteAsync()
    {
        var competency = await Api.GetMyCompetenciesAsync();
        if (competency?.Answers is not { Count: > 0 })
        {
            return false;
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        var version = ResolveQuickScanVersion(competency.QuickScanVersion, testsV2);
        var miniIds = TestDepthRules.MiniIds(AssessmentKind.Competence, version);
        return miniIds.All(id =>
            competency.Answers.TryGetValue(id.ToString(), out var value) && value is >= 1 and <= 5);
    }

    private static Dictionary<int, int> ParseMiniAnswers(Dictionary<string, int>? answers)
    {
        var result = new Dictionary<int, int>();
        foreach (var pair in answers ?? [])
        {
            if (int.TryParse(pair.Key, out var id) && pair.Value is >= 1 and <= 5)
            {
                result[id] = pair.Value;
            }
        }

        return result;
    }

    private async Task CompleteAsync()
    {
        var passportOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.CandidatePassport);
        if (passportOn)
        {
            _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
            if (await ShouldInstallAsync())
            {
                _phase = WizardPhase.Install;
            }
            else
            {
                Navigation.NavigateTo(FeatureRoutes.CandidateDiscoveryPath, true);
            }

            return;
        }

        _state = await Api.CompleteMyOnboardingAsync();
        if (await ShouldInstallAsync())
        {
            _phase = WizardPhase.Install;
        }
        else
        {
            Navigation.NavigateTo("/candidate/profile");
        }
    }

    private async Task<bool> ShouldInstallAsync()
    {
        try
        {
            if (await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone")) return false;
            _installIos = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            _installCanPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
            return _installIos || _installCanPrompt;
        }
        catch
        {
            return false;
        }
    }

    private async Task InstallAsync()
    {
        try
        {
            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
            Navigation.NavigateTo("/candidate/profile");
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

    private async Task EnablePushAsync()
    {
        try
        {
            var key = await Api.GetWebPushVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(key))
            {
                _installMessage = Culture["Push.Unavailable"];
                return;
            }

            var result = await Js.InvokeAsync<PushResult>("lobsyPush.createSubscription", key);
            if (result.Ok && !string.IsNullOrWhiteSpace(result.Endpoint)
                && !string.IsNullOrWhiteSpace(result.P256dh) && !string.IsNullOrWhiteSpace(result.Auth))
            {
                await Api.SubscribeWebPushAsync(result.Endpoint, result.P256dh, result.Auth);
                _installMessage = Culture["Onboarding.Install.PushOk"];
            }
            else
            {
                _installMessage = Culture["Push.Denied"];
            }
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

    private Task InstallLaterAsync()
    {
        Navigation.NavigateTo("/candidate/profile");
        return Task.CompletedTask;
    }

    private void CultureChanged() => InvokeAsync(StateHasChanged);

    private Task OnSetJobStart((CandidateEmployerHistory Job, string? Value) args)
    {
        SetJobStart(args.Job, args.Value);
        return Task.CompletedTask;
    }

    private Task OnSetJobEnd((CandidateEmployerHistory Job, string? Value) args)
    {
        SetJobEnd(args.Job, args.Value);
        return Task.CompletedTask;
    }

    private Task OnMiniAnswer((int Id, int Value) args) => AnswerAsync(args.Id, args.Value);

    private static int ResolveQuickScanVersion(int? storedVersion, bool testsV2Enabled)
    {
        if (storedVersion is int v && v > 0)
        {
            return AssessmentTestVersions.Normalize(v);
        }

        return testsV2Enabled ? AssessmentTestVersions.V3 : AssessmentTestVersions.V1;
    }

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= CultureChanged;
        GratisDnaMergeNotifier.Merged -= OnGratisDnaMerged;
        _saveCts?.Cancel();
        _geocodeCts?.Cancel();
        _dreamCts?.Cancel();
        if (_autosave is not null) await _autosave.DisposeAsync();
    }

    private sealed class PushResult
    {
        public bool Ok { get; set; }
        public string? Endpoint { get; set; }
        public string? P256dh { get; set; }
        public string? Auth { get; set; }
    }
}
