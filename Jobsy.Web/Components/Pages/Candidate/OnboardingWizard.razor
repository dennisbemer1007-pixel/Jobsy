    private void ScheduleDebouncedNearbyRefresh()
    {
        if (_step < 2 || !NearbyBasicsSaved() || _welcome || _finish)
        {
            return;
        }

        _nearbyRefreshCts?.Cancel();
        _nearbyRefreshCts?.Dispose();
        _nearbyRefreshCts = new CancellationTokenSource();
        var token = _nearbyRefreshCts.Token;
        _ = DebouncedNearbyRefreshAsync(token);
    }

    private async Task DebouncedNearbyRefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(2000, cancellationToken);
            await RefreshNearbySignalIfEligibleAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            // Informational panel only.
        }
    }

    private async Task SafeStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Circuit may be disconnected during teardown.
        }
    }

    private async Task FlushAsync()
    {
        if (_profileAutosave is null)
        {
            return;
        }

        try
        {
            await _profileAutosave.FlushAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
    }

    private Task SaveProfileAsync(CancellationToken cancellationToken) => Api.UpdateMyProfileAsync(
        dateOfBirth: Draft.BirthDate,
        preferences: new CandidatePreferences
        {
            MinHoursPerWeek = Draft.MinHours,
            MaxHoursPerWeek = Draft.MaxHours,
            MaxTravelMinutes = Draft.MaxTravel,
            PreferredTransport = string.IsNullOrWhiteSpace(Draft.Transport) ? null : Draft.Transport,
            Availability = BuildAvailability(),
            AvailabilityPresets = Draft.Presets.ToList(),
            AvailabilityPresetsOverridden = Draft.PresetsOverridden,
            Employers = Draft.JobsForSave(),
            NoWorkExperience = Draft.NoWork,
            Educations = string.IsNullOrWhiteSpace(Draft.Education)
                ? []
                : [OnboardingWizardCatalog.FormatEducationLine(Draft.Education, Draft.EducationDirection)],
            EducationDirection = EducationDirectionCatalog.SupportsDirection(Draft.Education) && !string.IsNullOrWhiteSpace(Draft.EducationDirection)
                ? Draft.EducationDirection.Trim()
                : null,
            HomeAddress = HomeAddress(),
            WorkStatuses = Draft.WorkStatuses.OrderBy(x => x).ToList()
        },
        homeLatitude: Draft.HomeLat,
        homeLongitude: Draft.HomeLng,
        clearHomeLocation: string.IsNullOrWhiteSpace(HomeAddress()),
        firstName: Draft.FirstName.Trim(),
        lastName: Draft.LastName.Trim(),
        phoneNumber: string.IsNullOrWhiteSpace(Draft.Phone) ? null : Draft.Phone.Trim(),
        availableFromDate: Draft.Immediate ? null : Draft.AvailableFrom,
        clearAvailableFromDate: Draft.Immediate,
        ct: cancellationToken);

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in Draft.Availability)
        {
            var pair = key.Split(':', 2);
            if (pair.Length != 2) continue;
            if (!result.TryGetValue(pair[0], out var values)) result[pair[0]] = values = [];
            values.Add(pair[1]);
        }
        return result;
    }

    private async Task LoadFinaleContextAsync()
    {
        var flags = await FeatureFlags.GetAsync();
        var testsV2 = flags.TestsV2Enabled;
        var competency = await Api.GetMyCompetenciesAsync();
        var career = await Api.GetMyCareerInterestsAsync();
        var culture = await Api.GetMyCultureAsync();
        var values = await Api.GetMyValuesAsync();
        var deeperDone = OnboardingFinaleDeeper.AllKindsReachedDeeper(
            competency?.Answers,
            competency?.QuickScanVersion,
            career?.Answers,
            career?.QuickScanVersion,
            culture?.Answers,
            culture?.QuickScanVersion,
            values?.Answers,
            values?.QuickScanVersion,
            testsV2);
        var referenceVerificationOn = await ReferenceVerificationGate.IsEnabledAsync();
        _finaleCardsInput = new OnboardingFinaleCardsInput(
            flags.CandidatePassportEnabled,
            referenceVerificationOn,
            flags.ProactiveMatchingEnabled,
            flags.KandidatenkaartEnabled,
            deeperDone,
            !string.IsNullOrWhiteSpace(Draft.Dream));
        _nearbySignal ??= await Api.GetOnboardingNearbySignalAsync();
        _finaleMaxTravel = _nearbySignal?.MaxTravelMinutes ?? Draft.MaxTravel;
        _finaleHomeLabel = string.IsNullOrWhiteSpace(Draft.City) ? null : Draft.City.Trim();
    }

    private async Task RefreshNearbySignalIfEligibleAsync()
    {
        if (!NearbyPanelEligible)
        {
            return;
        }

        try
        {
            var signal = await Api.GetOnboardingNearbySignalAsync();
            if (signal is null)
            {
                return;
            }

            _nearbyPeakCount = Math.Max(_nearbyPeakCount, signal.Count);
            _nearbySignal = signal;
            await SafeStateHasChangedAsync();
        }
        catch
        {
            // Keep last signal; never surface panel refresh as wizard error.
        }
    }

    private async Task ApplyLegacyNearbyRedirectAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
                .TryGetValue("from", out var fromValues)
            || !string.Equals(fromValues.FirstOrDefault(), "nearby", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (_step != 3)
        {
            return;
        }

        _step = 4;
        _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
        await PrepareMiniAsync();
    }

    private async Task LoadEarlyStrengthAsync()
    {
        var competency = await Api.GetMyCompetenciesAsync();
        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        var version = ResolveQuickScanVersion(competency?.QuickScanVersion, testsV2);
        var answerMap = ParseMiniAnswers(competency?.Answers);
        var preview = AssessmentQuickScanCatalog.ScoreCompetence(answerMap, version);
        var top = OnboardingImpressionComposer.TopCompetencyItems(preview, 1).FirstOrDefault();
        _earlyStrength = top is null
            ? null
            : new OnboardingImpressionItem
            {
                Code = top.Code,
                Label = top.Label,
                Sentence = top.Sentence,
                Percent = top.Percent
            };
    }

    private async Task<bool> CompetencyMiniCompleteAsync()
    {
        var competency = await Api.GetMyCompetenciesAsync();
        if (competency?.Answers is not { Count: > 0 })
        {
            return false;
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        var version = ResolveQuickScanVersion(competency.QuickScanVersion, testsV2);
        var miniIds = TestDepthRules.MiniIds(AssessmentKind.Competence, version);
        return miniIds.All(id =>
            competency.Answers.TryGetValue(id.ToString(), out var value) && value is >= 1 and <= 5);
    }

    private static Dictionary<int, int> ParseMiniAnswers(Dictionary<string, int>? answers)
    {
        var result = new Dictionary<int, int>();
        foreach (var pair in answers ?? [])
        {
            if (int.TryParse(pair.Key, out var id) && pair.Value is >= 1 and <= 5)
            {
                result[id] = pair.Value;
            }
        }

        return result;
    }

    private async Task CompleteAsync()
    {
        var passportOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.CandidatePassport);
        if (passportOn)
        {
            _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
            if (await ShouldInstallAsync())
            {
                _phase = WizardPhase.Install;
            }
            else
            {
                Navigation.NavigateTo(FeatureRoutes.CandidateDiscoveryPath, true);
            }

            return;
        }

        _state = await Api.CompleteMyOnboardingAsync();
        if (await ShouldInstallAsync())
        {
            _phase = WizardPhase.Install;
        }
        else
        {
            Navigation.NavigateTo("/candidate/profile");
        }
    }

    private async Task<bool> ShouldInstallAsync()
    {
        try
        {
            if (await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone")) return false;
            _installIos = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            _installCanPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
            return _installIos || _installCanPrompt;
        }
        catch
        {
            return false;
        }
    }

    private async Task InstallAsync()
    {
        try
        {
            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
            Navigation.NavigateTo("/candidate/profile");
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

    private async Task EnablePushAsync()
    {
        try
        {
            var key = await Api.GetWebPushVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(key))
            {
                _installMessage = Culture["Push.Unavailable"];
                return;
            }

            var result = await Js.InvokeAsync<PushResult>("lobsyPush.createSubscription", key);
            if (result.Ok && !string.IsNullOrWhiteSpace(result.Endpoint)
                && !string.IsNullOrWhiteSpace(result.P256dh) && !string.IsNullOrWhiteSpace(result.Auth))
            {
                await Api.SubscribeWebPushAsync(result.Endpoint, result.P256dh, result.Auth);
                _installMessage = Culture["Onboarding.Install.PushOk"];
            }
            else
            {
                _installMessage = Culture["Push.Denied"];
            }
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

