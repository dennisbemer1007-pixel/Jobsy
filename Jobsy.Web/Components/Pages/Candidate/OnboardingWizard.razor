    {
        await Task.Delay(2000);
        _progressSavedVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InstallPwaAsync()
    {
        _installBusy = true;
        _installMessage = null;
        try
        {
            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
            _installCanPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
        finally
        {
            _installBusy = false;
        }
    }

    private async Task EnablePushAsync()
    {
        _installBusy = true;
        _installMessage = null;
        try
        {
            var key = await Api.GetWebPushVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(key))
            {
                _installMessage = Culture["Push.Unavailable"];
                return;
            }

            var result = await Js.InvokeAsync<PushCreateResult>("lobsyPush.createSubscription", key);
            if (result is { Ok: true }
                && !string.IsNullOrWhiteSpace(result.Endpoint)
                && !string.IsNullOrWhiteSpace(result.P256dh)
                && !string.IsNullOrWhiteSpace(result.Auth))
            {
                await Api.SubscribeWebPushAsync(result.Endpoint, result.P256dh, result.Auth);
                _installMessage = Culture["Onboarding.Install.PushOk"];
            }
            else
            {
                _installMessage = Culture["Push.Denied"];
            }
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
        finally
        {
            _installBusy = false;
        }
    }

    private Task FinishInstallLaterAsync()
    {
        Navigation.NavigateTo("/candidate/match");
        return Task.CompletedTask;
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= OnCultureChanged;
        _profileSaveCts?.Cancel();
        _profileSaveCts?.Dispose();
        _geocodeCts?.Cancel();
        _geocodeCts?.Dispose();
        _dreamSaveCts?.Cancel();
        _dreamSaveCts?.Dispose();
        if (_miniAutosave is not null)
        {
            await _miniAutosave.DisposeAsync();
        }
    }

    private sealed class PushCreateResult
    {
        public bool Ok { get; set; }
        public string? Endpoint { get; set; }
        public string? P256dh { get; set; }
        public string? Auth { get; set; }
        public string? Reason { get; set; }
    }
