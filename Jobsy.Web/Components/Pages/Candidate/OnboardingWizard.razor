    private static int ResolveQuickScanVersion(int? storedVersion, bool testsV2Enabled)
    {
        if (storedVersion is int v && v > 0)
        {
            return AssessmentTestVersions.Normalize(v);
        }

        return testsV2Enabled ? AssessmentTestVersions.V3 : AssessmentTestVersions.V1;
    }

    /// <summary>Pinned at mini-block prepare time so debounced autosave cannot write to the wrong assessment store after step changes.</summary>
    private sealed record MiniBlockAutosaveContext(
        int WizardStep,
        AssessmentKind Kind,
        int QuickScanVersion,
        Dictionary<int, int> ServerBaseline);

    private async Task PersistMiniBlockAnswersAsync(
        MiniBlockAutosaveContext context,
        IReadOnlyDictionary<int, int> draft,
        CancellationToken cancellationToken)
    {
        var merged = new Dictionary<int, int>(context.ServerBaseline);
        foreach (var answer in draft)
        {
            merged[answer.Key] = answer.Value;
        }

        var payload = OnboardingMiniBlockCompletion.ScopeToMiniIds(
            context.Kind,
            context.QuickScanVersion,
            merged);

        switch (context.WizardStep)
        {
            case 7:
                await Api.SaveMyCompetenciesAsync(payload, false, cancellationToken);
                break;
            case 8:
                await Api.SaveMyCareerInterestsAsync(payload, false, cancellationToken);
                break;
            case 9:
                await Api.SaveMyCultureAsync(payload, false, cancellationToken);
                break;
            case 10:
                await Api.SaveMyValuesAsync(payload, false, cancellationToken);
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= CultureChanged;
        GratisDnaMergeNotifier.Merged -= OnGratisDnaMerged;
        _nearbyRefreshCts?.Cancel();
        _nearbyRefreshCts?.Dispose();
        _geocodeCts?.Cancel();
        _dreamCts?.Cancel();
        if (_profileAutosave is not null) await _profileAutosave.DisposeAsync();
        if (_autosave is not null) await _autosave.DisposeAsync();
    }

