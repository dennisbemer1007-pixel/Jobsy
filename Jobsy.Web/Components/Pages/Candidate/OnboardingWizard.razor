        => Api.SaveOnboardingDreamJobAsync(string.IsNullOrWhiteSpace(_dreamJob) ? null : _dreamJob.Trim());

    private void FlashProgressSaved()
    {
        _progressSaveStatus = SaveQuietStatus.Saved;
        _progressSavedVisible = true;
        _ = HideProgressSavedSoonAsync();
    }

