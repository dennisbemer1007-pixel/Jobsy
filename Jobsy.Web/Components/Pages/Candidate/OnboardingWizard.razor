@page "/candidate/start"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject GratisDnaMergeService GratisDnaMerge
@inject Jobsy.Core.Features.IFeatureFlags FeatureFlags
@inject UserFacingError UserFacing
@using Jobsy.Web.Components.Candidate.Onboarding
@implements IAsyncDisposable

<PageTitle>@Culture["Onboarding.PageTitle"] · Lobsy</PageTitle>

<div class="ob-wizard">
    @if (_loading)
    {
        <p class="ob-wizard__loading" aria-busy="true">@Culture["Common.Loading"]</p>
    }
    else if (_phase == WizardPhase.Install)
    {
        <section class="ob-wizard__install">
            <h1>@Culture["Onboarding.Install.Title"]</h1>
            <p>@Culture["Onboarding.Install.Lead"]</p>
            <div class="ob-install">
                @if (_installIos)
                {
                    <p class="ob-install__hint">@Culture["Pwa.IosHint"]</p>
                }
                else if (_installCanPrompt)
                {
                    <button type="button" class="btn-compact btn-compact--primary" @onclick="InstallAsync">
                        @Culture["Onboarding.Install.AddApp"]
                    </button>
                }
                <button type="button" class="btn-compact btn-compact--primary" @onclick="EnablePushAsync">
                    @Culture["Onboarding.Install.EnablePush"]
                </button>
                @if (!string.IsNullOrEmpty(_installMessage))
                {
                    <p aria-live="polite">@_installMessage</p>
                }
            </div>
            <button type="button" class="ob-wizard__ghost" @onclick="InstallLaterAsync">
                @Culture["Onboarding.Install.Later"]
            </button>
        </section>
    }
    else if (_finish || _state?.FinishReached == true)
    {
        <section class="ob-wizard__finish">
            <div class="ob-wizard__compass" aria-hidden="true">⌾</div>
            <span class="ob-wizard__badge">@Culture["Onboarding.Finish.Badge"]</span>
            <h1>@Culture.Format("Onboarding.Finish.Title", Draft.FirstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Finish.Lead"]</p>
            @if (_state?.Impression is { } impression)
            {
                <div class="ob-wizard__highlights">
                    @if (impression.Strengths.FirstOrDefault() is { } strength)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Strength"]</small>
                            <strong>@strength.Sentence</strong>
                        </article>
                    }
                    @if (impression.Riasec.Take(2).ToList() is { Count: > 0 } riasec)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Work"]</small>
                            <strong>@string.Join(AndSeparator, riasec.Select(item => item.Label))</strong>
                        </article>
                    }
                    @if (impression.TopValue is { } value)
                    {
                        <article>
                            <small>@Culture["Onboarding.Finish.Value"]</small>
                            <strong>@value.Label</strong>
                        </article>
                    }
                </div>
                @if (impression.MatchingVacancyCount > 0)
                {
                    <p class="ob-wizard__figure">
                        <strong>@impression.MatchingVacancyCount</strong> @Culture["Onboarding.Finish.Matches"]
                    </p>
                }
            }
            <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="CompleteAsync">
                @Culture["Onboarding.Finish.Cta"]
            </button>
            <a class="ob-wizard__ghost" href="/home?tab=tests">@Culture["Onboarding.Finish.FullTests"]</a>
        </section>
    }
    else if (_welcome)
    {
        <section class="ob-wizard__welcome">
            <div class="lobsy-logo">
                <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
            </div>
            <h1>@Culture.Format("Onboarding.Welcome.Title", Draft.FirstName)</h1>
            <p class="ob-wizard__lead">@Culture["Onboarding.Welcome.Lead"]</p>
            <div class="ob-wizard__phase-cards">
                @foreach (var item in WelcomePhases)
                {
                    <article>
                        <span>@item.Number</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                        <small>@Culture[item.Time]</small>
                    </article>
                }
            </div>
            <p class="ob-wizard__hint">@Culture["Onboarding.Welcome.Hint"]</p>
            <button type="button" class="btn-compact btn-compact--primary ob-wizard__cta" @onclick="BeginAsync">
                @Culture["Onboarding.Welcome.Cta"]
            </button>
        </section>
    }
    else
    {
        var currentPhase = OnboardingWizardCatalog.PhaseForStep(_step);
        <div class="ob-wizard__layout">
            <aside class="ob-wizard__sidebar">
                <div class="lobsy-logo">
                    <img class="lobsy-logo__img" src="/images/brand/lobsy-128.png" alt="" />
                </div>
                @foreach (var item in Sidebar)
                {
                    var isCurrent = item.First <= _step && _step <= item.Last;
                    var isDone = _step > item.Last;
                    <div class="ob-wizard__side-item @(isCurrent ? "is-current" : null) @(isDone ? "is-done" : null)">
                        <span>@(isDone ? "✓" : item.Number)</span>
                        <div>
                            <strong>@Culture[item.Title]</strong>
                            <small>@Culture[item.Lead]</small>
                        </div>
                    </div>
                }
                <p class="ob-wizard__saved">✓ @Culture["Onboarding.AllSaved"]</p>
                <button type="button" class="ob-wizard__ghost" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
            </aside>

            <main class="ob-wizard__main">
                <header class="ob-wizard__header">
                    <div class="ob-wizard__header-row">
                        <button type="button"
                                class="icon-btn ob-wizard__back"
                                disabled="@(_step == 1)"
                                aria-label="@Culture["Onboarding.BackAria"]"
                                @onclick="BackAsync">‹</button>
                        <div class="ob-wizard__segments"
                             role="progressbar"
                             aria-valuemin="1"
                             aria-valuemax="10"
                             aria-valuenow="@_step"
                             aria-label="@Culture.Format("Onboarding.ProgressAria", _step, 10)">
                            @foreach (var phase in OnboardingWizardCatalog.Phases)
                            {
                                <span>
                                    <i style="--w:@(OnboardingWizardCatalog.PhaseFill(phase, _step) * 100)%"></i>
                                </span>
                            }
                        </div>
                        <button type="button" class="ob-wizard__later" @onclick="LaterAsync">@Culture["Onboarding.Later"]</button>
                    </div>
                    <div class="ob-wizard__status-row">
                        <span>
                            <strong>@Culture[currentPhase.NameKey]</strong> ·
                            @Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
                        </span>
                        <span aria-live="polite" class="@(_saveError ? "is-error" : null)">@SaveText</span>
                    </div>
                </header>

                <section class="ob-wizard__content">
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="state-message error">@_error</p>
                    }

                    @switch (_step)
                    {
                        case 1:
                            <PersonalStep Draft="Draft"
                                          AddressChanged="AddressChanged"
                                          BirthDateChanged="BirthDateChanged"
                                          ShowCity="ShowCity"
                                          SelectAddress="SelectAddress" />
                            break;

                        case 2:
                            <AvailabilityStep Draft="Draft"
                                              Presets="PresetItems"
                                              TogglePreset="TogglePreset"
                                              ToggleFineTune="ToggleFineTune"
                                              SetMinHours="SetMinHoursAsync"
                                              SetMaxHours="SetMaxHoursAsync"
                                              ManualAvailability="ManualAvailabilityAsync"
                                              ToggleAvailability="ToggleAvailability"
                                              ResetPresets="ResetPresets" />
                            break;

                        case 3:
                            <TransportStep Draft="Draft"
                                           SelectTransport="SelectTransport"
                                           SelectTravelTime="SelectTravelTime"
                                           ShowCustomTravel="ShowCustomTravel" />
                            break;

                        case 4:
                            <WorkHistoryStep Draft="Draft"
                                             AddJob="AddJob"
                                             RemoveJob="RemoveJob"
                                             SetJobStart="OnSetJobStart"
                                             SetJobEnd="OnSetJobEnd" />
                            break;

                        case 5:
                            <EducationStep Draft="Draft" SelectEducation="SelectEducation" />
                            break;

                        case 6:
                            <DreamJobStep Draft="Draft"
                                          ChooseDream="ChooseDream"
                                          ChooseOwnDream="ChooseOwnDream"
                                          DreamKeyDown="DreamKeyDown" />
                            break;

                        case 7 when !Draft.HasConsent:
                            <TestConsentStep Draft="Draft" TestTabs="ConsentTabs" />
                            break;

                        case >= 7 and <= 10:
                            <OnboardingMiniTest Step="_step"
                                                CurrentQuestion="_currentQuestion"
                                                TestTabs="MiniTestTabs"
                                                Questions="_miniQuestions"
                                                Answers="_miniAnswers"
                                                InputPrefix="@MiniPrefix"
                                                Answer="OnMiniAnswer"
                                                ExpandQuestion="ExpandQuestion"
                                                ResolveQuestionText="QuestionText" />
                            break;
                    }
                </section>

                <footer class="ob-wizard__footer">
                    <button type="button"
                            class="btn-compact btn-compact--primary ob-wizard__cta"
                            disabled="@(!CanNext || _busy)"
                            @onclick="NextAsync">@NextLabel</button>
                    @if (_step is 4 or 5)
                    {
                        <button type="button" class="ob-wizard__ghost" @onclick="SkipOptionalAsync">
                            @Culture["Onboarding.Skip"]
                        </button>
                    }
                    else if (_step == 6)
                    {
                        <button type="button" class="ob-wizard__ghost" @onclick="DreamUnknownAsync">
                            @Culture["Onboarding.DreamUnknown"]
                        </button>
                    }
                </footer>
            </main>
        </div>
    }
</div>

@code {
    private enum WizardPhase { Wizard, Install }
    private sealed record SidebarItem(int Number, int First, int Last, string Title, string Lead);
    private sealed record WelcomePhase(int Number, string Title, string Lead, string Time);
    

    private bool _loading = true;
    private bool _busy;
    private bool _welcome;
    private bool _finish;
    private readonly OnboardingProfileDraft Draft = new();
    private bool _miniArrivedViaBack;
    private bool _installIos;
    private bool _installCanPrompt;
    private bool _saving;
    private bool _savedVisible;
    private bool _saveError;
    private int _step = 1;
    private int _currentQuestion;
    private string _installMessage = "";
    private string? _error;
    private WizardPhase _phase;
    private OnboardingState? _state;
    private readonly Dictionary<int, int> _miniAnswers = new();
    private readonly Dictionary<int, int> _serverAnswers = new();
    private readonly HashSet<int> _lockedIds = [];
    private List<OnboardingMiniTest.MiniQuestion> _miniQuestions = [];
    private CancellationTokenSource? _saveCts;
    private CancellationTokenSource? _geocodeCts;
    private CancellationTokenSource? _dreamCts;

    private static readonly AvailabilityStep.Preset[] PresetItems =
    [
        new("direct", "Onboarding.Preset.Direct", "Onboarding.Preset.Direct.Lead"),
        new("school", "Onboarding.Preset.School", "Onboarding.Preset.School.Lead"),
        new("weekend", "Onboarding.Preset.Weekend", "Onboarding.Preset.Weekend.Lead"),
        new("evening", "Onboarding.Preset.Evening", "Onboarding.Preset.Evening.Lead"),
        new("office", "Onboarding.Preset.Office", "Onboarding.Preset.Office.Lead"),
        new("holiday", "Onboarding.Preset.Holiday", "Onboarding.Preset.Holiday.Lead"),
        new("parttime", "Onboarding.Preset.Parttime", "Onboarding.Preset.Parttime.Lead"),
        new("fulltime", "Onboarding.Preset.Fulltime", "Onboarding.Preset.Fulltime.Lead")
    ];
    private static readonly TestConsentStep.TestTab[] ConsentTabs =
    [
        new(7, "Onboarding.Test.Competency", "Onboarding.Test.Competency.Lead"),
        new(8, "Onboarding.Test.Career", "Onboarding.Test.Career.Lead"),
        new(9, "Onboarding.Test.Culture", "Onboarding.Test.Culture.Lead"),
        new(10, "Onboarding.Test.Values", "Onboarding.Test.Values.Lead")
    ];
    private static readonly OnboardingMiniTest.TestTab[] MiniTestTabs = ConsentTabs
        .Select(t => new OnboardingMiniTest.TestTab(t.Step, t.Title, t.Lead)).ToArray();
    private QuestionnaireAutosave? _autosave;

    private static readonly string[] Days = DayPartMatrix.DayCodes;
    private static readonly string[] WorkingSlots = ["Ochtend", "Middag", "Avond"];
    private static readonly string[] TransportOptions = TransportLabels.Selectable;
    private static readonly int[] TravelChoices = [10, 20, 30, 45];
    private static readonly string[] MboLevels = ["1", "2", "3", "4"];
    private static readonly SidebarItem[] Sidebar =
    [
        new(1, 1, 3, "Onboarding.Phase.OverJou", "Onboarding.Side.OverJou"),
        new(2, 4, 5, "Onboarding.Phase.Achtergrond", "Onboarding.Side.Achtergrond"),
        new(3, 6, 6, "Onboarding.Phase.Droom", "Onboarding.Side.Droom"),
        new(4, 7, 10, "Onboarding.Phase.WieBenJij", "Onboarding.Side.WieBenJij"),
        new(5, 11, 11, "Onboarding.Side.Kompas", "Onboarding.Side.KompasLead")
    ];
    private static readonly WelcomePhase[] WelcomePhases =
    [
        new(1, "Onboarding.Phase.OverJou", "Onboarding.Welcome.OverJou", "Onboarding.Welcome.Time2"),
        new(2, "Onboarding.Welcome.Background", "Onboarding.Welcome.BackgroundLead", "Onboarding.Welcome.Time1"),
        new(3, "Onboarding.Welcome.Dream", "Onboarding.Welcome.DreamLead", "Onboarding.Welcome.TimeHalf"),
        new(4, "Onboarding.Phase.WieBenJij", "Onboarding.Welcome.TestsLead", "Onboarding.Welcome.Time2")
    ];

    private string SaveText => _saveError ? Culture["Onboarding.NotSaved"]
        : _saving ? Culture["Onboarding.Saving"]
        : _savedVisible ? $"✓ {Culture["Onboarding.Saved"]}" : "";
    private string HoursLabel => Draft.MinHours is not null && Draft.MaxHours is not null
        ? $"{Draft.MinHours:0} – {Draft.MaxHours:0} {Culture["Onboarding.Hours"]}" : "–";
    private string DaysSummary => Draft.Availability.Count == 0
        ? "–" : Culture.Format("Onboarding.DayPartsCount", Draft.Availability.Count);
    private string AvailableFromLabel => Draft.Immediate
        ? Culture["Onboarding.AvailableImmediate"] : Draft.AvailableFrom?.ToString() ?? "";
    private string AndSeparator => $" {Culture["Onboarding.And"]} ";
    private string MiniPrefix => $"obv2-{_step}-";
    private int MinHoursSlider => decimal.ToInt32(Draft.MinHours ?? 1);
    private int MaxHoursSlider => decimal.ToInt32(Draft.MaxHours ?? 60);
    private bool AvailabilityValid => Draft.MinHours is > 0 && Draft.MaxHours >= Draft.MinHours && Draft.Availability.Count > 0;
    private string NextLabel => _step == 7 && !Draft.HasConsent
        ? Culture["Onboarding.Consent.Cta"]
        : _step == 10 ? Culture["Onboarding.ViewKompas"]
        : _step is >= 7 ? Culture["Onboarding.NextTest"]
        : Draft.FineTune && _step == 2 ? Culture["Onboarding.Done"]
        : Culture["Onboarding.Next"];
    private bool CanNext => _step switch
    {
        1 => !string.IsNullOrWhiteSpace(Draft.FirstName)
             && !string.IsNullOrWhiteSpace(Draft.LastName)
             && Draft.BirthDate is not null
             && ((Draft.HomeLat is not null && Draft.HomeLng is not null) || !string.IsNullOrWhiteSpace(Draft.City)),
        2 => AvailabilityValid,
        3 => !string.IsNullOrWhiteSpace(Draft.Transport) && Draft.MaxTravel > 0,
        6 => !string.IsNullOrWhiteSpace(Draft.Dream),
        7 when !Draft.HasConsent => Draft.ConsentRequested,
        >= 7 => _miniQuestions.All(question => _miniAnswers.ContainsKey(question.Id)),
        _ => true
    };

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += CultureChanged;
        GratisDnaMergeNotifier.Merged += OnGratisDnaMerged;
        Draft.Changed = EventCallback.Factory.Create(this, ScheduleProfileSave);

        try
        {
            if (await FeatureFlags.IsEnabledAsync(Jobsy.Core.Features.PlatformFeature.CandidatePassport))
            {
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var target = "/candidate/ontdekkingsreis" + uri.Query;
                Navigation.NavigateTo(target, replace: true);
                return;
            }
        }
        catch
        {
            // Fall through to classic wizard on flag lookup failure.
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            await GratisDnaMerge.TryMergeAsync();

            var onboardingTask = Api.GetMyOnboardingAsync();
            var profileTask = Api.GetMyProfileAsync();
            await Task.WhenAll(onboardingTask, profileTask);
            _state = await onboardingTask ?? new OnboardingState { CurrentStep = 1, ShouldShow = true };
            ApplyProfile(await profileTask);

            if (_state.IsComplete)
            {
                if (await ShouldInstallAsync())
                {
                    _phase = WizardPhase.Install;
                }
                else
                {
                    Navigation.NavigateTo("/candidate/profile", true);
                }
                return;
            }

            _step = Math.Clamp(_state.CurrentStep, 1, 10);
            _finish = _state.FinishReached;
            _welcome = _step == 1
                && (_state.Steps.Count == 0 || _state.Steps.All(item => item.Step == 1 && item.CompletedAtUtc is null));
            if (!_welcome && !_finish)
            {
                await MarkStartedAsync();
                await PrepareMiniAsync();
                await TryAutoAdvanceEmptyMiniStepAsync();
            }
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyProfile(MeProfile? profile)
    {
        if (profile is null) return;
        Draft.FirstName = profile.FirstName ?? "";
        Draft.LastName = profile.LastName ?? "";
        Draft.Phone = profile.PhoneNumber ?? "";
        Draft.BirthDate = profile.DateOfBirth;
        if (Draft.BirthDate is { } date)
        {
            Draft.BirthDay = date.Day.ToString();
            Draft.BirthMonth = date.Month.ToString();
            Draft.BirthYear = date.Year.ToString();
        }

        Draft.HasConsent = profile.TestAiConsentAt is not null;
        Draft.HomeLat = profile.HomeLatitude;
        Draft.HomeLng = profile.HomeLongitude;
        var preferences = profile.Preferences ?? new();
        SplitAddress(preferences.HomeAddress);
        Draft.MinHours = preferences.MinHoursPerWeek ?? 8;
        Draft.MaxHours = preferences.MaxHoursPerWeek ?? 24;
        Draft.MaxTravel = preferences.MaxTravelMinutes ?? 30;
        Draft.Transport = preferences.PreferredTransport is null ? "" : TransportLabels.Canonical(preferences.PreferredTransport);
        Draft.Immediate = profile.AvailableFromDate is null;
        Draft.AvailableFrom = profile.AvailableFromDate;
        foreach (var preset in preferences.AvailabilityPresets.Where(AvailabilityPresetRules.IsKnown))
        {
            Draft.Presets.Add(preset);
        }
        Draft.PresetsOverridden = preferences.AvailabilityPresetsOverridden == true;
        foreach (var (day, parts) in preferences.Availability)
        {
            foreach (var part in parts) Draft.Availability.Add($"{day}:{part}");
        }
        Draft.NoWork = preferences.NoWorkExperience == true;
        Draft.Jobs.Clear();
        Draft.Jobs.AddRange(preferences.Employers.Take(3));
        var education = preferences.Educations.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(education))
        {
            var parts = education.Split('–', 2, StringSplitOptions.TrimEntries);
            Draft.Education = parts[0];
            Draft.EducationDirection = parts.Length > 1 ? parts[1] : preferences.EducationDirection ?? "";
        }
    }

    private async Task BeginAsync()
    {
        _welcome = false;
        await MarkStartedAsync();
    }

    private async Task MarkStartedAsync()
    {
        _state = await Api.SaveMyOnboardingProgressAsync(_step);
        FlashSaved();
    }

    private async Task BackAsync()
    {
        if (_step <= 1) return;
        await FlushAsync();
        _miniArrivedViaBack = true;
        _step--;
        await MarkStartedAsync();
        await PrepareMiniAsync();
    }

    private async Task NextAsync()
    {
        if (!CanNext || _busy) return;
        _busy = true;
        _error = null;
        _miniArrivedViaBack = false;
        try
        {
            if (_step == 7 && !Draft.HasConsent)
            {
                await AcceptConsentAsync();
                return;
            }
            if (_step <= 5) await FlushAsync();
            if (_step == 6) await SaveDreamAsync();
            if (_step >= 7 && _autosave is not null) await _autosave.FlushAsync();
            if (_step == 10)
            {
                _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
                _finish = true;
                _state = await Api.GetMyOnboardingAsync() ?? _state;
                return;
            }

            _step++;
            _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
            FlashSaved();
            await PrepareMiniAsync();
            await TryAutoAdvanceEmptyMiniStepAsync();
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SkipOptionalAsync()
    {
        await FlushAsync();
        _miniArrivedViaBack = false;
        _step++;
        _state = await Api.SaveMyOnboardingProgressAsync(_step, stepSkipped: true);
        await PrepareMiniAsync();
        await TryAutoAdvanceEmptyMiniStepAsync();
    }

    private async Task LaterAsync()
    {
        try
        {
            await FlushAsync();
            await Api.SaveMyOnboardingProgressAsync(_step);
        }
        catch
        {
            // Persisting before leaving is best effort.
        }
        Navigation.NavigateTo("/home");
    }

    private void ShowCity() => Draft.ShowCity = true;

    private void SplitAddress(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var index = value.Trim().IndexOf(' ');
        Draft.Postcode = index > 0 ? value[..index].Trim() : value.Trim();
        Draft.City = index > 0 ? value[(index + 1)..].Trim() : "";
    }

    private string HomeAddress() => $"{NormalizePostcode(Draft.Postcode)} {Draft.City.Trim()}".Trim();

    private static string NormalizePostcode(string value)
    {
        var raw = value.Replace(" ", "").ToUpperInvariant();
        return raw.Length == 6 ? raw[..4] + " " + raw[4..] : value.Trim().ToUpperInvariant();
    }

    private void AddressChanged()
    {
        Draft.HomeLat = Draft.HomeLng = null;
        Draft.PostcodeResolved = false;
        ScheduleProfileSave();
        _geocodeCts?.Cancel();
        _geocodeCts = new();
        _ = GeocodeAsync(_geocodeCts.Token);
    }

    private async Task GeocodeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(350, cancellationToken);
            var postcode = NormalizePostcode(Draft.Postcode);
            if (!System.Text.RegularExpressions.Regex.IsMatch(postcode, "^[1-9][0-9]{3} [A-Z]{2}$")) return;
            var result = (await Geocoder.SuggestAsync(postcode, cancellationToken))
                .FirstOrDefault(item => item.Label.Replace(" ", "")
                    .StartsWith(postcode.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
            if (result is null)
            {
                Draft.PostcodeMissing = true;
                await InvokeAsync(StateHasChanged);
                return;
            }
            SelectAddress(result);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            Draft.PostcodeMissing = true;
        }
    }

    private void SelectAddress(AddressSuggestion item)
    {
        Draft.HomeLat = item.Latitude;
        Draft.HomeLng = item.Longitude;
        SplitAddress(item.Label);
        Draft.Postcode = NormalizePostcode(Draft.Postcode);
        Draft.PostcodeResolved = true;
        Draft.PostcodeMissing = false;
        ScheduleProfileSave();
    }

    private void BirthDateChanged()
    {
        Draft.BirthDate = int.TryParse(Draft.BirthDay, out var day)
            && int.TryParse(Draft.BirthMonth, out var month)
            && int.TryParse(Draft.BirthYear, out var year)
            && DateOnly.TryParse($"{year:D4}-{month:D2}-{day:D2}", out var date)
                ? date : null;
        ScheduleProfileSave();
    }

    private void ToggleFineTune() => Draft.FineTune = !Draft.FineTune;

    private void TogglePreset(string code)
    {
        if (!Draft.Presets.Add(code)) Draft.Presets.Remove(code);
        if (!Draft.PresetsOverridden) ApplyPresets();
        ScheduleProfileSave();
    }

    private void ApplyPresets()
    {
        var result = AvailabilityPresetRules.Compute(Draft.Presets, Draft.MinHours, Draft.MaxHours);
        Draft.MinHours = result.MinHours;
        Draft.MaxHours = result.MaxHours;
        Draft.Availability.Clear();
        foreach (var dayPart in result.DayParts) Draft.Availability.Add(dayPart);
        Draft.Immediate = result.Immediate;
        if (Draft.Immediate) Draft.AvailableFrom = null;
    }

