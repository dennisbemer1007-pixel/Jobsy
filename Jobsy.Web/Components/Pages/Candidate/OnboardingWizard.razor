    private Task SaveProfileAsync(CancellationToken cancellationToken) => Api.UpdateMyProfileAsync(
        dateOfBirth: _birthDate,
        preferences: new CandidatePreferences
        {
            MinHoursPerWeek = _minHours,
            MaxHoursPerWeek = _maxHours,
            MaxTravelMinutes = _maxTravel,
            PreferredTransport = string.IsNullOrWhiteSpace(_transport) ? null : _transport,
            Availability = BuildAvailability(),
            AvailabilityPresets = _presets.ToList(),
            AvailabilityPresetsOverridden = _presetsOverridden,
            Employers = _jobs,
            NoWorkExperience = _noWork,
            Educations = string.IsNullOrWhiteSpace(_education)
                ? []
                : [OnboardingWizardCatalog.FormatEducationLine(_education, _educationDirection)],
            EducationDirection = _educationDirection,
            HomeAddress = HomeAddress()
        },
        homeLatitude: _homeLat,
        homeLongitude: _homeLng,
        clearHomeLocation: string.IsNullOrWhiteSpace(HomeAddress()),
        firstName: _firstName.Trim(),
        lastName: _lastName.Trim(),
        phoneNumber: string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
        availableFromDate: _immediate ? null : _availableFrom,
        clearAvailableFromDate: _immediate,
        ct: cancellationToken);

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in _availability)
        {
            var pair = key.Split(':', 2);
            if (pair.Length != 2) continue;
            if (!result.TryGetValue(pair[0], out var values)) result[pair[0]] = values = [];
            values.Add(pair[1]);
        }
        return result;
    }

