    /// <summary>Skip mini-tests; basics stay saved. Tests remain on paspoort / ontdekkingsreis.</summary>
    private async Task SkipTestsLaterAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await FlushAsync();
            if (_step == 6)
            {
                await SaveDreamAsync();
            }

            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            _earlyMoment = EarlyRewardMoment.None;
            _earlyStrength = null;
            _nearbySignal = null;

            _state = await Api.SaveMyOnboardingProgressAsync(6, stepCompleted: true, finishReached: true);
            await Api.CompleteMyOnboardingAsync();
            Navigation.NavigateTo(BanenkaartPath);
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

