    {
        1 => !string.IsNullOrWhiteSpace(_firstName)
             && !string.IsNullOrWhiteSpace(_lastName)
             && _birthDate is not null
             && ((_homeLat is not null && _homeLng is not null) || !string.IsNullOrWhiteSpace(_city)),
        2 => AvailabilityValid,
        3 => !string.IsNullOrWhiteSpace(_transport) && _maxTravel > 0,
        6 => !string.IsNullOrWhiteSpace(_dream),
        7 when !_hasConsent => _consentRequested,
        >= 7 => _miniQuestions.All(question => _miniAnswers.ContainsKey(question.Id)),
        _ => true
    };

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += CultureChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var onboardingTask = Api.GetMyOnboardingAsync();
            var profileTask = Api.GetMyProfileAsync();
            await Task.WhenAll(onboardingTask, profileTask);
            _state = await onboardingTask ?? new OnboardingState { CurrentStep = 1, ShouldShow = true };
            ApplyProfile(await profileTask);

            if (_state.IsComplete)
            {
                if (await ShouldInstallAsync())
                {
                    _phase = WizardPhase.Install;
                }
                else
                {
                    Navigation.NavigateTo("/candidate/profile", true);
                }
                return;
            }

            _step = Math.Clamp(_state.CurrentStep, 1, 10);
            _finish = _state.FinishReached;
            _welcome = _step == 1
                && (_state.Steps.Count == 0 || _state.Steps.All(item => item.Step == 1 && item.CompletedAtUtc is null));
            if (!_welcome && !_finish)
            {
                await MarkStartedAsync();
                await PrepareMiniAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyProfile(MeProfile? profile)
    {
        if (profile is null) return;
        _firstName = profile.FirstName ?? "";
        _lastName = profile.LastName ?? "";
        _phone = profile.PhoneNumber ?? "";
        _birthDate = profile.DateOfBirth;
        if (_birthDate is { } date)
        {
            _birthDay = date.Day.ToString();
            _birthMonth = date.Month.ToString();
            _birthYear = date.Year.ToString();
        }

        _hasConsent = profile.TestAiConsentAt is not null;
        _homeLat = profile.HomeLatitude;
        _homeLng = profile.HomeLongitude;
        var preferences = profile.Preferences ?? new();
        SplitAddress(preferences.HomeAddress);
        _minHours = preferences.MinHoursPerWeek ?? 8;
        _maxHours = preferences.MaxHoursPerWeek ?? 24;
        _maxTravel = preferences.MaxTravelMinutes ?? 30;
        _transport = preferences.PreferredTransport is null ? "" : TransportLabels.Canonical(preferences.PreferredTransport);
        _immediate = profile.AvailableFromDate is null;
        _availableFrom = profile.AvailableFromDate;
        foreach (var preset in preferences.AvailabilityPresets.Where(AvailabilityPresetRules.IsKnown))
        {
            _presets.Add(preset);
        }
        _presetsOverridden = preferences.AvailabilityPresetsOverridden == true;
        foreach (var (day, parts) in preferences.Availability)
        {
            foreach (var part in parts) _availability.Add($"{day}:{part}");
        }
        _noWork = preferences.NoWorkExperience == true;
        _jobs.AddRange(preferences.Employers.Take(3));
        var education = preferences.Educations.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(education))
        {
            var parts = education.Split('–', 2, StringSplitOptions.TrimEntries);
            _education = parts[0];
            _educationDirection = parts.Length > 1 ? parts[1] : preferences.EducationDirection ?? "";
        }
    }

    private async Task BeginAsync()
    {
        _welcome = false;
        await MarkStartedAsync();
    }

    private async Task MarkStartedAsync()
    {
        _state = await Api.SaveMyOnboardingProgressAsync(_step);
        FlashSaved();
    }

    private async Task BackAsync()
    {
        if (_step <= 1) return;
        await FlushAsync();
        _step--;
        await MarkStartedAsync();
        await PrepareMiniAsync();
    }

    private async Task NextAsync()
    {
        if (!CanNext || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            if (_step == 7 && !_hasConsent)
            {
                await AcceptConsentAsync();
                return;
            }
            if (_step <= 5) await FlushAsync();
            if (_step == 6) await SaveDreamAsync();
            if (_step >= 7 && _autosave is not null) await _autosave.FlushAsync();
            if (_step == 10)
            {
                _state = await Api.SaveMyOnboardingProgressAsync(10, stepCompleted: true, finishReached: true);
                _finish = true;
                _state = await Api.GetMyOnboardingAsync() ?? _state;
                return;
            }

            _step++;
            _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
            FlashSaved();
            await PrepareMiniAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SkipOptionalAsync()
    {
        await FlushAsync();
        _step++;
        _state = await Api.SaveMyOnboardingProgressAsync(_step, stepSkipped: true);
        await PrepareMiniAsync();
    }

    private async Task LaterAsync()
    {
        try
        {
            await FlushAsync();
            await Api.SaveMyOnboardingProgressAsync(_step);
        }
        catch
        {
            // Persisting before leaving is best effort.
        }
        Navigation.NavigateTo("/home");
    }

