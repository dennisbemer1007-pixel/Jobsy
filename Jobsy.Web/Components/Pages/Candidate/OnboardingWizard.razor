    private void V2AddJob() => _v2Jobs.Add(new CandidateEmployerHistory());
    private void V2RemoveJob(CandidateEmployerHistory job) { _v2Jobs.Remove(job); V2ScheduleProfileSave(); }
    private void V2SelectEducation(string level) { _v2Education = level == "MBO" ? "MBO 1" : level; if (level == EducationLevelLabels.None) _v2EducationDirection = ""; V2ScheduleProfileSave(); }
    private void V2ChooseDream(DreamJob job) { _v2Dream = job.TitleNl; _v2DreamSearch = ""; V2ScheduleDreamSave(); }
    private void V2ChooseOwnDream() { _v2Dream = _v2DreamSearch.Trim()[..Math.Min(128, _v2DreamSearch.Trim().Length)]; _v2DreamSearch = ""; V2ScheduleDreamSave(); }
    private Task V2DreamKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _v2DreamSearch = ""; if (e.Key == "Enter" && _v2DreamSearch.Length > 0) V2ChooseOwnDream(); return Task.CompletedTask; }
