    private string Step1MobileHeroJpg => HeroCompactPreview.Variant == CandidateHeroCompactPreviewVariant.C
        ? CompactHeroPreviewArt.OnboardingKennismakenMobile
        : OnboardingIllustrationAssets.MobileHeroJpg("kennismaken");

    private string Step1MobileHeroWebp => HeroCompactPreview.Variant == CandidateHeroCompactPreviewVariant.C
        ? CompactHeroPreviewArt.OnboardingKennismakenMobile
        : OnboardingIllustrationAssets.MobileHeroWebp("kennismaken");

    private string? IllustratedSidebarNote => _step switch
    {
        1 => Culture["Onboarding.IllustratedSidebar.Step1"],
        2 => Culture["Onboarding.IllustratedSidebar.Step2"],
        3 => Culture["Onboarding.IllustratedSidebar.Step3"],
        4 => Culture["Onboarding.IllustratedSidebar.Step4"],
        5 => Culture["Onboarding.IllustratedSidebar.Step5"],
        6 => Culture["Onboarding.IllustratedSidebar.Step6"],
        _ => null,
    };

    private IReadOnlyList<string> DreamStepRegionalTitles =>
        _nearbySignal?.Examples.Select(example => example.Title).ToList() ?? [];

    private int _currentQuestion;
    private int _miniFlowEpoch;
    private int _preparedMiniStep;
    private int _stepTransitionGeneration;
    private string _installMessage = "";
    private string? _error;
    private WizardPhase _phase;
    private OnboardingState? _state;
    private bool _finaleV2;
    private OnboardingFinaleCardsInput _finaleCardsInput = new(false, false, false, false, false, false);
    private int _finaleMaxTravel = 30;
    private string? _finaleHomeLabel;
    private readonly Dictionary<int, int> _miniAnswers = new();
    private readonly Dictionary<int, int> _serverAnswers = new();
    private readonly HashSet<int> _lockedIds = [];
    private int[] _miniBlockQuestionIds = [];
    private int _miniQuickScanVersion = AssessmentTestVersions.V1;
    private List<OnboardingMiniTest.MiniQuestion> _miniQuestions = [];
    private IReadOnlyList<int> _journeyCompletedSteps = [];
    private int _journeyNextStep = 7;
    private OnboardingWizardProfileAutosave? _profileAutosave;
    private CancellationTokenSource? _nearbyRefreshCts;
    private CancellationTokenSource? _geocodeCts;
    private CancellationTokenSource? _dreamCts;

    private IReadOnlyList<(string Code, string TitleKey, string LeadKey)> IllustratedPresetTuples
        => PresetItems.Select(p => (p.Code, p.Title, p.Lead)).ToList();

    private static readonly AvailabilityStep.Preset[] PresetItems =
    [
        new("school", "Onboarding.Preset.School", "Onboarding.Preset.School.Lead"),
        new("weekend", "Onboarding.Preset.Weekend", "Onboarding.Preset.Weekend.Lead"),
        new("evening", "Onboarding.Preset.Evening", "Onboarding.Preset.Evening.Lead"),
        new("office", "Onboarding.Preset.Office", "Onboarding.Preset.Office.Lead"),
        new("holiday", "Onboarding.Preset.Holiday", "Onboarding.Preset.Holiday.Lead"),
        new("parttime", "Onboarding.Preset.Parttime", "Onboarding.Preset.Parttime.Lead"),
        new("fulltime", "Onboarding.Preset.Fulltime", "Onboarding.Preset.Fulltime.Lead"),
        new("custom", "Onboarding.Preset.Custom", "Onboarding.Preset.Custom.Lead")
    ];
    private static readonly TestConsentStep.TestTab[] ConsentTabs =
    [
        new(7, "Onboarding.Test.Competency", "Onboarding.Test.Competency.Lead"),
        new(8, "Onboarding.Test.Career", "Onboarding.Test.Career.Lead"),
        new(9, "Onboarding.Test.Culture", "Onboarding.Test.Culture.Lead"),
        new(10, "Onboarding.Test.Values", "Onboarding.Test.Values.Lead")
    ];
    private static readonly OnboardingMiniTest.TestTab[] MiniTestTabs = ConsentTabs
        .Select(t => new OnboardingMiniTest.TestTab(t.Step, t.Title, t.Lead)).ToArray();
    private QuestionnaireAutosave? _autosave;

    private static readonly string[] Days = DayPartMatrix.DayCodes;
    private static readonly string[] WorkingSlots = ["Ochtend", "Middag", "Avond"];
    private static readonly string[] TransportOptions = TransportLabels.Selectable;
    private static readonly int[] TravelChoices = [10, 20, 30, 45];
    private static readonly string[] MboLevels = ["1", "2", "3", "4"];
    private static readonly SidebarItem[] Sidebar =
    [
        new(1, 1, 3, "Onboarding.Phase.OverJou", "Onboarding.Side.OverJou"),
        new(2, 4, 5, "Onboarding.Phase.Achtergrond", "Onboarding.Side.Achtergrond"),
        new(3, 6, 6, "Onboarding.Phase.Droom", "Onboarding.Side.Droom"),
        new(4, 7, 10, "Onboarding.Phase.WieBenJij", "Onboarding.Side.WieBenJij"),
        new(5, 11, 11, "Onboarding.Side.Kompas", "Onboarding.Side.KompasLead")
    ];
    private static readonly WelcomePhase[] WelcomePhases =
    [
        new(1, "Onboarding.Phase.OverJou", "Onboarding.Welcome.OverJou", "Onboarding.Welcome.Time2"),
        new(2, "Onboarding.Welcome.Background", "Onboarding.Welcome.BackgroundLead", "Onboarding.Welcome.Time1"),
        new(3, "Onboarding.Welcome.Dream", "Onboarding.Welcome.DreamLead", "Onboarding.Welcome.TimeHalf"),
        new(4, "Onboarding.Phase.WieBenJij", "Onboarding.Welcome.TestsLead", "Onboarding.Welcome.Time2")
    ];

    private string SaveText => _saveError
        ? Culture["Onboarding.NotSaved"]
        : _profilePersistInFlight ? Culture["Onboarding.Saving"] : "";

    private string RustigSaveStatus => string.IsNullOrEmpty(SaveText)
        ? Culture["Onboarding.Rustig.Saved"]
        : SaveText;
    private string HoursLabel => Draft.MinHours is not null && Draft.MaxHours is not null
        ? $"{Draft.MinHours:0} – {Draft.MaxHours:0} {Culture["Onboarding.Hours"]}" : "–";
    private string DaysSummary => Draft.Availability.Count == 0
        ? "–" : Culture.Format("Onboarding.DayPartsCount", Draft.Availability.Count);
    private string AvailableFromLabel => Draft.Immediate
        ? Culture["Onboarding.AvailableImmediate"]
        : Draft.AvailableFrom is { } d
            ? AvailabilityStartRules.FormatDisplayDate(d, Culture.Language)
            : "";
    private string AndSeparator => $" {Culture["Onboarding.And"]} ";
    private string MiniPrefix => $"obv2-{_step}-";
    private int MinHoursSlider => decimal.ToInt32(Draft.MinHours ?? 1);
    private int MaxHoursSlider => decimal.ToInt32(Draft.MaxHours ?? 60);
    private bool AvailabilityValid => Draft.MinHours is > 0 && Draft.MaxHours >= Draft.MinHours && Draft.Availability.Count > 0;
    private string MobileStepBadge
    {
        get
        {
            if (_earlyMoment == EarlyRewardMoment.FirstInsight)
            {
                return Culture["Onboarding.Early.Insight.Badge"];
            }

            if (Culture.Language.StartsWith("nl", StringComparison.OrdinalIgnoreCase))
            {
                return $"Stap {_step} van 10";
            }

            var raw = Culture.Format("Discovery.StepOf", _step);
            return raw.Length > 0 ? char.ToUpperInvariant(raw[0]) + raw[1..] : raw;
        }
    }

    private string MobileTopMeta => _earlyMoment switch
    {
        EarlyRewardMoment.FirstInsight => Culture["Onboarding.Early.Insight.Meta"],
        _ => Culture.Format("Onboarding.StepLine", _step, OnboardingWizardCatalog.RemainingMinutes(_step))
            .Replace(" van 10 ·", " ·", StringComparison.Ordinal)
            .Replace(" of 10 ·", " ·", StringComparison.Ordinal)
            .Replace(" minuten", " min", StringComparison.Ordinal)
            .Replace(" min left", " min", StringComparison.Ordinal)
    };

    private bool ShowJourneyConsent =>
        TestJourneyIllustration.Enabled
        && !OnboardingRustig.Enabled
        && _step == 7
        && !Draft.HasConsent
        && _earlyMoment == EarlyRewardMoment.None;

    private string NextLabel => _earlyMoment == EarlyRewardMoment.FirstInsight
            ? Culture["Onboarding.NextTest"]
            : ShowJourneyConsent
                ? JourneyConsentCtaLabel
            : _step == 7 && !Draft.HasConsent
        ? Culture["Onboarding.Consent.Cta"]
        : _step == 10 ? Culture["Onboarding.ViewKompas"]
        : _step is >= 7 ? Culture["Onboarding.NextTest"]
        : Draft.FineTune && _step == 2 ? Culture["Onboarding.Done"]
        : Culture["Onboarding.Next"];

    /// <summary>Client mini islands use the wizard footer (no embedded TestQuestionFlow CTA).</summary>
    private bool ShowMiniTestFooter => false;

    private bool ShowTestsLaterOffer =>
        _earlyMoment == EarlyRewardMoment.FirstInsight
        || (_step == 7 && !Draft.HasConsent && _earlyMoment == EarlyRewardMoment.None)
        || (_step is >= 7 and <= 10 && Draft.HasConsent && _earlyMoment == EarlyRewardMoment.None);

    private const string BanenkaartPath = KbRoutes.Map;

    private bool NearbyPanelEligible =>
        !_welcome
        && !_finish
        && _earlyMoment != EarlyRewardMoment.FirstInsight
        && NearbyBasicsSaved();

    private bool ShowNearbyPanel => NearbyPanelEligible && _nearbySignal is not null;

    private bool NearbyRefinedHeadline =>
        _nearbySignal is { Count: > 0 and var count }
        && _nearbyPeakCount > count;

    private bool NearbyBasicsSaved() =>
        OnboardingWizardValidation.HasResolvableLocation(
            Draft.City, Draft.HomeLat, Draft.HomeLng, Draft.Postcode, Draft.PostcodeResolved);

    private string JourneyConsentCtaLabel
    {
        get
        {
            var testNumber = OnboardingTestCompletion.TestNumberForStep(_journeyNextStep);
            return testNumber <= 1
                ? Culture["Onboarding.Journey.CtaStart"]
                : Culture.Format("Onboarding.Journey.CtaContinue", testNumber);
        }
    }

    private void OnConsentChanged(bool value)
    {
        Draft.ConsentRequested = value;
        if (value)
        {
            ClearStepValidation();
        }

        StateHasChanged();
    }

    private async Task RefreshJourneyCompletionAsync()
    {
        if (!TestJourneyIllustration.Enabled || Draft.HasConsent || _step != 7)
        {
            return;
        }

        var testsV2 = await FeatureFlags.IsEnabledAsync(PlatformFeature.TestsV2);
        _journeyCompletedSteps = await OnboardingTestCompletion.LoadCompletedWizardStepsAsync(Api, testsV2);
        _journeyNextStep = OnboardingTestCompletion.FirstIncompleteStep(_journeyCompletedSteps);
    }

    private bool CanNext => GetValidationIssues().Count == 0
                            && (_step is not (>= 7 and <= 10)
                                || _miniQuestions.All(question => MiniVisibleAnswers.ContainsKey(question.Id)));

    private IReadOnlyList<OnboardingValidationIssue> GetValidationIssues()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return _step switch
        {
            1 => OnboardingWizardValidation.ValidatePersonal(
                Draft.FirstName,
                Draft.LastName,
                Draft.BirthDate,
                Draft.City,
                Draft.HomeLat,
                Draft.HomeLng,
                Draft.Postcode,
                Draft.PostcodeResolved,
                today,
                Draft.GeolocationPendingConfirm),
            2 => OnboardingWizardValidation.ValidateAvailability(
                Draft.MinHours,
                Draft.MaxHours,
                Draft.Availability.Count,
                Draft.Immediate,
                Draft.AvailableFrom,
                requirePresetSelection: Draft.Presets.Count == 0 && Draft.Availability.Count == 0),
            3 => OnboardingWizardValidation.ValidateTransport(Draft.Transport, Draft.MaxTravel),
            6 => OnboardingWizardValidation.ValidateDream(Draft.Dream),
            7 when !Draft.HasConsent => OnboardingWizardValidation.ValidateConsent(Draft.ConsentRequested),
            _ => []
        };
    }

    private void ClearStepValidation() => _showValidation = false;

    private async Task ScrollToFirstIssueAsync(IReadOnlyList<OnboardingValidationIssue> issues)
    {
        if (issues.Count == 0)
        {
            return;
        }

        var anchor = OnboardingWizardValidation.FieldAnchorId(issues[0].Field);
        try
        {
            await Js.InvokeVoidAsync("jobsyDom.scrollToId", anchor);
        }
        catch
        {
            // optional
        }
    }

    private void RequestStepScrollReset()
    {
        _pendingStepScroll = true;
    }

    private bool TryParseStepQuery(out int step)
    {
        step = 0;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("step", out var raw))
        {
            return false;
        }

        return int.TryParse(raw.FirstOrDefault(), out step);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingStepScroll)
        {
            return;
        }

        _pendingStepScroll = false;
        try
        {
            await Js.InvokeVoidAsync("jobsyDom.resetWizardStepScroll");
        }
        catch
        {
            // optional
        }
    }

    protected override void OnInitialized()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryHeader = tokens.HeaderName ?? "RequestVerificationToken";
            _antiforgeryToken = tokens.RequestToken ?? "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _finaleV2 = await OnboardingFinaleV2.IsEnabledAsync();
        Culture.Changed += CultureChanged;
        GratisDnaMergeNotifier.Merged += OnGratisDnaMerged;
        _profileAutosave = new OnboardingWizardProfileAutosave(
            PersistProfileDraftAsync,
            onPersistStarted: () => _profilePersistInFlight = true,
            onPersistEnded: OnProfilePersistEnded,
            onPersistSucceeded: ScheduleDebouncedNearbyRefresh);
        Draft.Changed = EventCallback.Factory.Create(this, ScheduleProfileSave);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            await GratisDnaMerge.TryMergeAsync();

            var onboardingTask = Api.GetMyOnboardingAsync();
            var profileTask = Api.GetMyProfileAsync();
            await Task.WhenAll(onboardingTask, profileTask);
            _state = await onboardingTask ?? new OnboardingState { CurrentStep = 1, ShouldShow = true };
            ApplyProfile(await profileTask);

            var passportOn = await FeatureFlags.IsEnabledAsync(Jobsy.Core.Features.PlatformFeature.CandidatePassport);
            _finaleV2 = await OnboardingFinaleV2.IsEnabledAsync();
            if (_state.IsComplete)
            {
                if (await ShouldInstallAsync())
                {
                    _phase = WizardPhase.Install;
                }
                else
                {
                    Navigation.NavigateTo(
                        passportOn ? FeatureRoutes.CandidatePassportPath : "/candidate/profile",
                        true);
                }
                return;
            }

            if (passportOn && _state.FinishReached && !_finaleV2)
            {
                Navigation.NavigateTo(FeatureRoutes.CandidateDiscoveryPath, true);
                return;
            }

            _step = Math.Clamp(_state.CurrentStep, 1, 10);
            if (TryParseStepQuery(out var requestedStep))
            {
                var ceiling = Math.Clamp(_state.CurrentStep, 1, 10);
                _step = Math.Clamp(requestedStep, 1, ceiling);
            }

            _finish = _state.FinishReached;
            if (_finish && _finaleV2)
            {
                await LoadFinaleContextAsync();
            }

            _welcome = ShouldShowWelcomeScreen(_state, _step);
            if (OnboardingRustig.Enabled && !_welcome && !_finish && _phase != WizardPhase.Install && _step is >= 1 and <= 3)
            {
                Navigation.NavigateTo(OnboardingRoutes.StepUrl(_step), forceLoad: true);
                return;
            }

            if (!_welcome && !_finish)
            {
                await MarkStartedAsync();
                await RefreshJourneyCompletionAsync();
                await PrepareMiniAsync();
                await EnsureOnFirstIncompleteMiniBlockAsync();
                await TryAutoAdvanceEmptyMiniStepAsync();
                await ApplyLegacyNearbyRedirectAsync();
                try
                {
                    await RefreshNearbySignalIfEligibleAsync();
                }
                catch
                {
                    // Informational panel only.
                }

                RequestStepScrollReset();
            }
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyProfile(MeProfile? profile)
    {
        if (profile is null) return;
        (Draft.FirstName, Draft.LastName) = CandidateNameRules.ResolveOnboardingPrefill(
            profile.FirstName,
            profile.LastName,
            profile.FullName,
            profile.Email);
        Draft.Phone = profile.PhoneNumber ?? "";
        Draft.BirthDate = profile.DateOfBirth;
        if (Draft.BirthDate is { } date)
        {
            Draft.BirthDay = date.Day.ToString();
            Draft.BirthMonth = date.Month.ToString();
            Draft.BirthYear = date.Year.ToString();
        }

        Draft.HasConsent = profile.TestAiConsentAt is not null;
        Draft.HomeLat = profile.HomeLatitude;
        Draft.HomeLng = profile.HomeLongitude;
        var preferences = profile.Preferences ?? new();
        CandidateHomeAddressLookup.HydrateDraftFromStored(Draft, preferences.HomeAddress);
        Draft.MinHours = preferences.MinHoursPerWeek ?? 8;
        Draft.MaxHours = preferences.MaxHoursPerWeek ?? 24;
        Draft.MaxTravel = preferences.MaxTravelMinutes ?? 30;
        Draft.Transport = TransportLabels.Normalize(preferences.PreferredTransport);
        Draft.Immediate = profile.AvailableFromDate is null;
        Draft.AvailableFrom = profile.AvailableFromDate;
        foreach (var preset in preferences.AvailabilityPresets.Where(AvailabilityPresetRules.IsKnown))
        {
            Draft.Presets.Add(preset);
        }
        Draft.PresetsOverridden = preferences.AvailabilityPresetsOverridden == true;
        foreach (var (day, parts) in preferences.Availability)
        {
            foreach (var part in parts) Draft.Availability.Add($"{day}:{part}");
        }

        Draft.FineTune = Draft.Presets.Contains(AvailabilityPresetRules.Custom);

        Draft.NoWork = preferences.NoWorkExperience == true;
        Draft.Jobs.Clear();
        Draft.Jobs.AddRange(preferences.Employers.Take(3));
        var education = preferences.Educations.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(education))
        {
            var parts = education.Split('–', 2, StringSplitOptions.TrimEntries);
            Draft.Education = parts[0];
            Draft.EducationDirection = parts.Length > 1 ? parts[1] : preferences.EducationDirection ?? "";
        }

        var serverWorkStatuses = preferences.WorkStatuses ?? [];
        if (serverWorkStatuses.Count > 0 || Draft.WorkStatuses.Count == 0)
        {
            Draft.WorkStatuses.Clear();
            foreach (var code in serverWorkStatuses)
            {
                if (WorkStatusCatalog.IsKnown(code))
                {
                    Draft.WorkStatuses.Add(WorkStatusCatalog.Canonical(code)!);
                }
            }
        }
    }

    private async Task BeginAsync()
    {
        if (_busy || _loading)
        {
            return;
        }

        _error = null;
        _busy = true;
        try
        {
            _state = await Api.SaveMyOnboardingProgressAsync(_step, source: WelcomeDismissedSource);
            Api.InvalidateMeCache(JobsyApiClient.OnboardingCacheKey);
            _welcome = false;
            if (OnboardingRustig.Enabled)
            {
                Navigation.NavigateTo(OnboardingRoutes.StepUrl(_step), forceLoad: true);
                return;
            }

            RequestStepScrollReset();
            await InvokeAsync(StateHasChanged);
            await RefreshJourneyCompletionAsync();
            await PrepareMiniAsync();
            await DeferredTryAutoAdvanceAsync();
        }
        catch (Exception ex)
        {
            _welcome = ShouldShowWelcomeScreen(_state ?? new OnboardingState { CurrentStep = _step }, _step);
            _error = UserFacing.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkStartedAsync()
    {
        _state = await Api.SaveMyOnboardingProgressAsync(_step);
    }

    private async Task BackAsync()
    {
        if (_earlyMoment == EarlyRewardMoment.FirstInsight)
        {
            _earlyMoment = EarlyRewardMoment.None;
            _earlyStrength = null;
            ClearStepValidation();
            RequestStepScrollReset();
            return;
        }

        if (_step <= 1) return;
        await FlushBeforeLeavingStepAsync();
        ClearStepValidation();
        _miniArrivedViaBack = true;
        _step--;
        await MarkStartedAsync();
        await PrepareMiniAsync();
        _miniArrivedViaBack = false;
        RequestStepScrollReset();
    }

    private async Task NextAsync(bool fromMiniTestFinish = false)
    {
        if (_busy)
        {
            return;
        }

        if (!fromMiniTestFinish)
        {
            if (_step is >= 1 and <= 10)
            {
                return;
            }

            var issues = GetValidationIssues();
            if (_step is >= 7 and <= 10 && Draft.HasConsent && _miniQuestions.Count > 0
                && !OnboardingMiniBlockCompletion.IsMiniBlockComplete(_step, _miniQuickScanVersion, MiniVisibleAnswers))
            {
                _currentQuestion = OnboardingMiniBlockCompletion.FirstUnansweredMiniIndex(
                    _step,
                    _miniQuickScanVersion,
                    MiniVisibleAnswers);
                StateHasChanged();
                return;
            }
            else if (issues.Count > 0)
            {
                _showValidation = true;
                _error = Culture[issues[0].MessageKey];
                await ScrollToFirstIssueAsync(issues);
                await SafeStateHasChangedAsync();
                return;
            }
        }

        _showValidation = false;
        _busy = true;
        _error = null;
        _miniArrivedViaBack = false;
        try
        {
            if (_earlyMoment == EarlyRewardMoment.FirstInsight)
            {
                _earlyMoment = EarlyRewardMoment.None;
                _earlyStrength = null;
                ClearMiniAnswersBeforeStepChange();
                _step++;
                _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
                await PrepareMiniAsync();
                RequestStepScrollReset();
                await DeferredTryAutoAdvanceAsync();
                return;
            }

            if (_step == 7 && !Draft.HasConsent)
            {
                await AcceptConsentAsync();
                return;
            }

            if (_step == 7 && Draft.HasConsent && _miniQuestions.Count > 0
                && OnboardingMiniBlockCompletion.IsMiniBlockComplete(_step, _miniQuickScanVersion, MiniVisibleAnswers))
            {
                await FinishMiniAsync();
                return;
            }

            if (!await FlushBeforeLeavingStepAsync())
            {
                await SafeStateHasChangedAsync();
                return;
            }

            if (_step == 10)
            {
                if (!await TryEnterKompasWhenAllMiniTestsCompleteAsync())
                {
                    return;
                }

                return;
            }

            ClearMiniAnswersBeforeStepChange();
            _step++;
            _state = await Api.SaveMyOnboardingProgressAsync(_step, stepCompleted: true);
            Interlocked.Increment(ref _stepTransitionGeneration);
            await PrepareMiniAsync();
            RequestStepScrollReset();
            try
            {
                await RefreshNearbySignalIfEligibleAsync();
            }
            catch
            {
                // Nearby panel is informational only.
            }

            await Task.Yield();
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }

        await DeferredTryAutoAdvanceAsync();
    }

    private async Task SkipOptionalAsync()
    {
        await FlushBeforeLeavingStepAsync();
        ClearStepValidation();
        _miniArrivedViaBack = false;
        ClearMiniAnswersBeforeStepChange();
        _step++;
        _state = await Api.SaveMyOnboardingProgressAsync(_step, stepSkipped: true);
        await PrepareMiniAsync();
        RequestStepScrollReset();
        await DeferredTryAutoAdvanceAsync();
    }

    private async Task LaterAsync()
    {
        try
        {
            await FlushAsync();
            await Api.SaveMyOnboardingProgressAsync(_step);
        }
        catch
        {
            // Persisting before leaving is best effort.
        }
        Navigation.NavigateTo("/home");
    }

    /// <summary>Skip mini-tests; basics stay saved. Tests remain on paspoort / ontdekkingsreis.</summary>
    private async Task SkipTestsLaterAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await FlushAsync();
            if (_step == 6)
            {
                await SaveDreamAsync();
            }

            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            _earlyMoment = EarlyRewardMoment.None;
            _earlyStrength = null;
            _nearbySignal = null;

            _state = await Api.SaveMyOnboardingProgressAsync(6, stepCompleted: true, finishReached: true);
            _state = await Api.CompleteMyOnboardingAsync();
            Api.InvalidateMeCache();
            Navigation.NavigateTo(BanenkaartPath, forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = UserFacing.Describe(ex);
            _saveError = true;
        }
        finally
        {
            _busy = false;
        }
    }

