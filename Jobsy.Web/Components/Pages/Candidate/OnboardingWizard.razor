    private void OnAddressFieldsChanged()
    {
        _homeLat = null;
        _homeLng = null;
        ScheduleProfileSave();
        ScheduleGeocode();
    }

    private void ScheduleGeocode()
    {
        _geocodeCts?.Cancel();
        _geocodeCts?.Dispose();
        _geocodeCts = new CancellationTokenSource();
        var token = _geocodeCts.Token;
        _ = GeocodeDebouncedAsync(token);
    }

    private async Task GeocodeDebouncedAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var query = ComposedHomeAddress();
        if (query.Length < 3)
        {
            _showAddressSuggestions = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _geocoding = true;
        _showAddressSuggestions = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _addressSuggestions = (await Geocoder.SuggestAsync(query, token)).ToList();
            if (_addressSuggestions.Count == 1)
            {
                SelectAddressSuggestion(_addressSuggestions[0]);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _addressSuggestions = [];
        }
        finally
        {
            _geocoding = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectAddressSuggestion(AddressSuggestion suggestion)
    {
        _homeLat = suggestion.Latitude;
        _homeLng = suggestion.Longitude;
        if (!string.IsNullOrWhiteSpace(suggestion.Label))
        {
            SplitHomeAddress(suggestion.Label);
        }

        _showAddressSuggestions = false;
        ScheduleProfileSave();
    }

    private void ScheduleProfileSave()
    {
        if (_loading)
        {
            return;
        }
        _profileSaveCts?.Cancel();
        _profileSaveCts?.Dispose();
        _profileSaveCts = new CancellationTokenSource();
        var token = _profileSaveCts.Token;
        _profileSaveStatus = SaveQuietStatus.Saving;
        _ = ProfileSaveDebouncedAsync(token);
    }

    private async Task ProfileSaveDebouncedAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await SaveProfileAsync(token);
            _profileSaveStatus = SaveQuietStatus.Saved;
            _profileSavedVisible = true;
            await InvokeAsync(StateHasChanged);
            _ = HideProfileSavedSoonAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _profileSaveStatus = SaveQuietStatus.Idle;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HideProfileSavedSoonAsync()
    {
        await Task.Delay(2000);
        _profileSavedVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FlushProfileSaveAsync()
    {
        _profileSaveCts?.Cancel();
        await SaveProfileAsync(CancellationToken.None);
    }

    private async Task SaveProfileAsync(CancellationToken ct)
    {
        var home = ComposedHomeAddress();
        var clearHome = string.IsNullOrWhiteSpace(home);
        var educations = string.IsNullOrWhiteSpace(_educationLevel)
            ? []
            : new List<string>
            {
                OnboardingWizardCatalog.FormatEducationLine(_educationLevel!, _educationDirection)
            };

        await Api.UpdateMyProfileAsync(
            firstName: _firstName.Trim(),
            lastName: _lastName.Trim(),
            phoneNumber: string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
            homeLatitude: clearHome ? null : _homeLat,
            homeLongitude: clearHome ? null : _homeLng,
            clearHomeLocation: clearHome,
            availableFromDate: _availableImmediate ? null : _availableFrom,
            clearAvailableFromDate: _availableImmediate,
            preferences: new CandidatePreferences
            {
                MinHoursPerWeek = _minHours,
                MaxHoursPerWeek = _maxHours,
                MaxTravelMinutes = _maxTravel,
                PreferredTransport = string.IsNullOrWhiteSpace(_preferredTransport) ? null : _preferredTransport,
                Availability = BuildAvailability(),
                Employers = _employers
                    .Where(e => !string.IsNullOrWhiteSpace(e.EmployerName) || !string.IsNullOrWhiteSpace(e.Role))
                    .Select(e => new CandidateEmployerHistory
                    {
                        EmployerName = e.EmployerName?.Trim() ?? "",
                        Role = string.IsNullOrWhiteSpace(e.Role) ? null : e.Role.Trim(),
                        StartMonth = e.StartMonth,
                        EndMonth = e.EndMonth
                    })
                    .ToList(),
                Educations = educations,
                EducationDirection = string.IsNullOrWhiteSpace(_educationDirection) ? null : _educationDirection.Trim(),
                NoWorkExperience = _noWorkExperience,
                HomeAddress = clearHome ? null : home
            },
            ct: ct);
    }

    private Dictionary<string, List<string>> BuildAvailability()
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in _availability)
        {
            var parts = key.Split(':', 2);
            if (parts.Length != 2)
            {
                continue;
            }

            if (!map.TryGetValue(parts[0], out var slots))
            {
                slots = [];
                map[parts[0]] = slots;
            }

            if (!slots.Contains(parts[1], StringComparer.OrdinalIgnoreCase))
            {
                slots.Add(parts[1]);
            }
        }

        return map;
    }

    private void ScheduleDreamSave()
    {
        _dreamSaveCts?.Cancel();
        _dreamSaveCts?.Dispose();
        _dreamSaveCts = new CancellationTokenSource();
        var token = _dreamSaveCts.Token;
        _ = DreamSaveDebouncedAsync(token);
    }

