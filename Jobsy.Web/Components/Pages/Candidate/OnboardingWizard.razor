    private async Task PrepareMiniAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
            _autosave = null;
        }
        _miniAnswers.Clear();
        _serverAnswers.Clear();
        _lockedIds.Clear();
        _miniQuestions = [];
        _currentQuestion = 0;
        if (_step is < 7 or > 10 || !_hasConsent) return;

        Dictionary<string, int>? answers;
        IEnumerable<(int Id, string Key)> catalog;
        int[] questionIds;
        switch (_step)
        {
            case 7:
                var competency = await Api.GetMyCompetenciesAsync();
                answers = competency?.Answers;
                questionIds = OnboardingWizardCatalog.CompetencyQuestionIds;
                catalog = CompetencyTestCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            case 8:
                var career = await Api.GetMyCareerInterestsAsync();
                answers = career?.Answers;
                questionIds = OnboardingWizardCatalog.CareerQuestionIds;
                catalog = CareerTestCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            case 9:
                var culture = await Api.GetMyCultureAsync();
                answers = culture?.Answers;
                questionIds = OnboardingWizardCatalog.CultureQuestionIds;
                catalog = CulturePersonalityCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
            default:
                var values = await Api.GetMyValuesAsync();
                answers = values?.Answers;
                questionIds = OnboardingWizardCatalog.ValuesQuestionIds;
                catalog = SchwartzValuesCatalog.Questions.Select(item => (item.Id, item.TextKey));
                break;
        }

        foreach (var answer in answers ?? [])
        {
            if (int.TryParse(answer.Key, out var id) && answer.Value is >= 1 and <= 5)
            {
                _serverAnswers[id] = answer.Value;
            }
        }
        foreach (var id in questionIds)
        {
            if (_serverAnswers.ContainsKey(id)) _lockedIds.Add(id);
        }

        _miniQuestions = catalog
            .Where(item => questionIds.Contains(item.Id) && !_lockedIds.Contains(item.Id))
            .Select(item => new MiniQuestion(item.Id, item.Key))
            .ToList();
        _autosave = new QuestionnaireAutosave(async (draft, cancellationToken) =>
        {
            var merged = new Dictionary<int, int>(_serverAnswers);
            foreach (var answer in draft) merged[answer.Key] = answer.Value;
            switch (_step)
            {
                case 7:
                    await Api.SaveMyCompetenciesAsync(merged, false, cancellationToken);
                    break;
                case 8:
                    await Api.SaveMyCareerInterestsAsync(merged, false, cancellationToken);
                    break;
                case 9:
                    await Api.SaveMyCultureAsync(merged, false, cancellationToken);
                    break;
                case 10:
                    await Api.SaveMyValuesAsync(merged, false, cancellationToken);
                    break;
            }
        }, () => InvokeAsync(StateHasChanged), 150);
    }

