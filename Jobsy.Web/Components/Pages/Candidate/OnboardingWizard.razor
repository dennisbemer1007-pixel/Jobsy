    private async Task CompleteAsync()
    {
        _state = await Api.CompleteMyOnboardingAsync();
        if (await ShouldInstallAsync()) _phase = WizardPhase.Install;
        else Navigation.NavigateTo("/candidate/profile");
    }

    private async Task<bool> ShouldInstallAsync()
    {
        try
        {
            if (await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone")) return false;
            _installIos = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            _installCanPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
            return _installIos || _installCanPrompt;
        }
        catch
        {
            return false;
        }
    }

    private async Task InstallAsync()
    {
        try
        {
            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

    private async Task EnablePushAsync()
    {
        try
        {
            var key = await Api.GetWebPushVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(key))
            {
                _installMessage = Culture["Push.Unavailable"];
                return;
            }

            var result = await Js.InvokeAsync<PushResult>("lobsyPush.createSubscription", key);
            if (result.Ok && !string.IsNullOrWhiteSpace(result.Endpoint)
                && !string.IsNullOrWhiteSpace(result.P256dh) && !string.IsNullOrWhiteSpace(result.Auth))
            {
                await Api.SubscribeWebPushAsync(result.Endpoint, result.P256dh, result.Auth);
                _installMessage = Culture["Onboarding.Install.PushOk"];
            }
            else
            {
                _installMessage = Culture["Push.Denied"];
            }
        }
        catch
        {
            _installMessage = Culture["Onboarding.Install.Failed"];
        }
    }

    private Task InstallLaterAsync()
    {
        Navigation.NavigateTo("/candidate/profile");
        return Task.CompletedTask;
    }

    private void CultureChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Culture.Changed -= CultureChanged;
        _saveCts?.Cancel();
        _geocodeCts?.Cancel();
        _dreamCts?.Cancel();
        if (_autosave is not null) await _autosave.DisposeAsync();
    }

    private sealed class PushResult
    {
        public bool Ok { get; set; }
        public string? Endpoint { get; set; }
        public string? P256dh { get; set; }
        public string? Auth { get; set; }
    }
}
