@page "/candidate/values"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@Culture["ValuesScan.Title"] · Lobsy</PageTitle>

<QuestionnaireShell Title="@Culture["ValuesScan.Title"]"
                    Subtitle="@Subtitle"
                    BackHref="/profiel"
                    PrivacyNote="@Culture["ValuesScan.PrivacyNote"]"
                    PrivacyHref="/privacy"
                    AnsweredCount="@AnsweredCount"
                    TotalCount="@SchwartzValuesCatalog.QuestionCount"
                    SaveStatus="@(_autosave?.Status ?? QuestionnaireSaveStatus.Saved)"
                    Loading="_loading"
                    LoadFailed="_loadFailed"
                    ErrorMessage="@_message"
                    ReloadHref="/candidate/values"
                    Message="@_banner"
                    Completing="_completing"
                    ScrollToQuestionId="_focus.ScrollToId"
                    SmoothScroll="_focus.SmoothScroll"
                    OnComplete="CompleteAsync"
                    OnNext="GoNextAsync"
                    OnRetrySave="RetrySaveAsync">
    <QuestionnairePageBody Categories="@CategoryGroups"
                           Answers="_answers"
                           CurrentId="_focus.CurrentId"
                           DimmedId="_focus.DimmedId"
                           ExpandedId="_focus.ExpandedId"
                           InputPrefix="vq"
                           OnAnswer="OnAnswerAsync"
                           OnExpand="ExpandQuestion" />
</QuestionnaireShell>

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private bool _completing;
    private string? _message;
    private string? _banner;
    private readonly Dictionary<int, int> _answers = [];
    private readonly QuestionnaireFocus _focus = new();
    private QuestionnaireAutosave? _autosave;

    private int AnsweredCount => _answers.Count;

    private IReadOnlyList<QuestionnaireCategoryGroup> CategoryGroups
        => BuildCategoryGroups();

    private string? Subtitle
    {
        get
        {
            if (_focus.CurrentId is null)
            {
                return null;
            }

            var cat = QuestionsFlat().FirstOrDefault(q => q.Id == _focus.CurrentId)?.Category;
            if (string.IsNullOrEmpty(cat))
            {
                return null;
            }

            var inCat = QuestionsFor(cat);
            var done = inCat.Count(q => _answers.ContainsKey(q.Id));
            return Culture.Format("Questionnaire.CategoryProgress", Culture[$"ValuesScan.Cat.{cat}"], done, inCat.Count);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) =>
            {
                await Api.SaveMyValuesAsync(answers, complete: false, ct);
            },
            onChanged: () => InvokeAsync(StateHasChanged));

        try
        {
            var state = await Api.GetMyValuesAsync();
            if (state is not null)
            {
                _answers.Clear();
                foreach (var (key, value) in state.Answers)
                {
                    if (int.TryParse(key, out var id) && value is >= 1 and <= 5)
                    {
                        _answers[id] = value;
                    }
                }
            }

            _autosave.ReplaceAll(_answers);
            _focus.Initialize(OrderedIds(), _answers);
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<QuestionnaireCategoryGroup> BuildCategoryGroups()
        => SchwartzValuesCatalog.CategoryCodes
            .Select(category =>
            {
                var questions = QuestionsFor(category);
                return new QuestionnaireCategoryGroup
                {
                    Key = category,
                    Label = Culture[$"ValuesScan.Cat.{category}"],
                    Questions = questions
                        .Select(q => new QuestionnaireQuestion
                        {
                            Id = q.Id,
                            Text = $"{q.Id}. {Culture[q.TextKey]}",
                            CategoryKey = category,
                            CategoryLabel = Culture[$"ValuesScan.Cat.{category}"]
                        })
                        .ToList()
                };
            })
            .ToList();

    private static IReadOnlyList<CompetencyQuestion> QuestionsFor(string category)
        => SchwartzValuesCatalog.QuestionsFor(category);

    private static IEnumerable<CompetencyQuestion> QuestionsFlat()
        => SchwartzValuesCatalog.CategoryCodes.SelectMany(QuestionsFor);

    private IReadOnlyList<int> OrderedIds()
        => QuestionsFlat().Select(q => q.Id).ToList();

    private async Task OnAnswerAsync((int Id, int Value) answer)
    {
        var (id, value) = answer;
        _answers[id] = value;
        _banner = null;
        _focus.AfterAnswer(id, OrderedIds(), _answers);
        try
        {
            if (_autosave is not null)
            {
                await _autosave.SetAnswerAsync(id, value);
            }
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private void ExpandQuestion(int id)
        => _focus.Expand(id, OrderedIds(), _answers);

    private Task GoNextAsync()
    {
        _focus.GoNext(OrderedIds(), _answers);
        return Task.CompletedTask;
    }

    private async Task RetrySaveAsync()
    {
        if (_autosave is null)
        {
            return;
        }

        try
        {
            await _autosave.RetryAsync();
            _banner = null;
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
    }

    private async Task CompleteAsync()
    {
        if (_loadFailed || AnsweredCount < SchwartzValuesCatalog.QuestionCount)
        {
            return;
        }

        _completing = true;
        _banner = null;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
            }

            await Api.SaveMyValuesAsync(_answers, complete: true);
            Navigation.NavigateTo("/profiel");
        }
        catch (Exception ex)
        {
            _banner = ex.Message;
        }
        finally
        {
            _completing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_autosave is not null)
        {
            await _autosave.DisposeAsync();
        }
    }
}
