@page "/candidate/values"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Components.Shared.Questionnaire
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@Culture["ValuesScan.Title"] · Lobsy</PageTitle>

@if (_loading)
{
    <div class="test-page journey-page"><div class="test-skeleton" aria-busy="true"><span class="skeleton-line skeleton-line--title"></span></div></div>
}
else if (_loadFailed)
{
    <div class="test-page"><p>@Culture["Common.Error"]</p><a href="/candidate/values?stap=intro">@Culture["Common.Retry"]</a></div>
}
else
{
    <TestConsentGate GateChanged="OnGateChanged">
        @if (_gateOpen)
        {
            @if (_mode == TestPageShell.ShellMode.Intro)
            {
                <TestPageShell Kind="AssessmentKind.Values"
                               Mode="TestPageShell.ShellMode.Intro"
                               H1="@Culture["Discovery.Test.ValuesScan.Title"]"
                               Lead="@Culture["TestFlow.Lead.Values"]"
                               TestName="@Culture["ValuesScan.Title"]"
                               Answered="_answered"
                               TargetCount="_targetCount"
                               BubbleText="@IntroBubble">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <fieldset class="test-depth-pick" role="radiogroup" aria-label="@Culture["TestFlow.DepthPick"]">
                            <legend>@Culture["TestFlow.DepthPick"]</legend>
                            @foreach (var band in TestDepthRules.Levels(AssessmentKind.Values))
                            {
                                var done = _answered >= band.Count;
                                <label class="test-depth-pick__card @(done ? "is-done" : null) @(_target == band.Level ? "is-on" : null)">
                                    <input type="radio" name="depth" value="@band.Level" checked="@(_target == band.Level)"
                                           disabled="@done" @onchange="() => SelectDepth(band.Level)" />
                                    <strong>@Culture[TestDepthRules.NameKey(band.Level)]</strong>
                                    <span>@Culture.Format("TestFlow.DepthMeta", band.Count, TestDepthRules.MinutesFor(AssessmentKind.Values, band.Level))</span>
                                </label>
                            }
                        </fieldset>
                        <footer class="test-shell__footer">
                            <a href="/profiel/tests/values">@Culture["TestFlow.ToMyTests"]</a>
                            @if (_answered >= _fullCount)
                            {
                                <a class="engagement-btn" href="/profiel/tests/values">@Culture["TestDone.ViewResult"]</a>
                                <button type="button" class="test-flow__later" @onclick="StartQuestions">@Culture["TestFlow.Again"]</button>
                            }
                            else
                            {
                                <button type="button" class="engagement-btn" @onclick="StartQuestions">
                                    @(_answered == 0 ? Culture["TestFlow.Begin"] : Culture.Format("TestFlow.ContinueAt", ResumeAt))
                                </button>
                            }
                        </footer>
                    </ChildContent>
                </TestPageShell>
            }
            else if (_mode == TestPageShell.ShellMode.Question && _autosave is not null)
            {
                <TestPageShell Kind="AssessmentKind.Values"
                               Mode="TestPageShell.ShellMode.Question"
                               H1="@Culture["Discovery.Test.ValuesScan.Title"]"
                               TestName="@Culture["ValuesScan.Title"]"
                               LevelName="@Culture[TestDepthRules.NameKey(_target)]"
                               Answered="_autosave.AnsweredCount"
                               TargetCount="_targetCount"
                               BubbleText="@Culture["TestFlow.Bubble.Question"]">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <p class="test-page__save" aria-live="polite">@_liveSave</p>
                        <TestQuestionFlow Kind="AssessmentKind.Values"
                                          Questions="_flowQuestions"
                                          Answers="_autosave.Answers"
                                          Target="_target"
                                          Autosave="_autosave"
                                          OnLevelReached="OnLevelReached"
                                          OnFinished="OnFinished"
                                          OnLater="LaterAsync"
                                          OnChanged="OnFlowChanged" />
                    </ChildContent>
                </TestPageShell>
            }
            else if (_mode == TestPageShell.ShellMode.Done)
            {
                <TestPageShell Kind="AssessmentKind.Values"
                               Mode="TestPageShell.ShellMode.Done"
                               H1="@Culture["TestDone.Title"]"
                               TestName="@Culture["ValuesScan.Title"]"
                               LevelName="@Culture[TestDepthRules.NameKey(_reachedLevel ?? _target)]"
                               DoneLead="@DoneLead"
                               Answered="_answered"
                               TargetCount="_targetCount"
                               BubbleText="@Culture["TestDone.Bubble.Values"]">
                    <RailContent>@RenderRail()</RailContent>
                    <ChildContent>
                        <ul class="test-done__gains">
                            @foreach (var line in _gainLines)
                            {
                                <li>✓ @line</li>
                            }
                        </ul>
                        <footer class="test-shell__footer">
                            <a href="/profiel/tests/values">@Culture["TestDone.Back"]</a>
                            <a class="engagement-btn" href="@(_fromReis ? "/candidate/ontdekkingsreis" : "/profiel/tests/values")">
                                @(_fromReis ? Culture["TestDone.BackToJourney"] : Culture["TestDone.ViewResult"])
                            </a>
                        </footer>
                    </ChildContent>
                </TestPageShell>
            }
        }
    </TestConsentGate>
}

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private bool _gateOpen;
    private bool _fromReis;
    private TestPageShell.ShellMode _mode = TestPageShell.ShellMode.Intro;
    private TestDepthLevel _target = TestDepthLevel.Full;
    private TestDepthLevel? _reachedLevel;
    private int _answered;
    private string? _liveSave;
    private QuestionnaireAutosave? _autosave;
    private List<TestQuestionFlow.FlowQuestion> _flowQuestions = [];
    private List<string> _gainLines = [];
    private QuestionnaireSaveStatus _lastAnnounced = QuestionnaireSaveStatus.Idle;

    private int _targetCount => TestDepthRules.CountFor(AssessmentKind.Values, _target);
    private int _fullCount => TestDepthRules.CountFor(AssessmentKind.Values, TestDepthLevel.Full);
    private static readonly IReadOnlyDictionary<int, int> EmptyAnswers = new Dictionary<int, int>();
    private int ResumeAt => TestDepthRules.ResumeQuestionNumber(AssessmentKind.Values, _autosave?.Answers ?? EmptyAnswers);
    private string IntroBubble => _answered >= _fullCount
        ? Culture["TestFlow.Bubble.IntroDone"]
        : _answered > 0
            ? Culture.Format("TestFlow.Bubble.IntroContinue", _answered)
            : Culture["TestFlow.Bubble.IntroStart"];
    private string DoneLead => (_reachedLevel ?? _target) == TestDepthLevel.Full
        ? Culture.Format("TestDone.LeadFull", Culture["ValuesScan.Title"])
        : Culture.Format("TestDone.LeadLevel", Culture["ValuesScan.Title"], Culture[TestDepthRules.NameKey(_reachedLevel ?? _target)]);

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _fromReis = q.TryGetValue("from", out var f) && f == "reis";
        if (q.TryGetValue("stap", out var stap) && stap == "klaar")
        {
            _mode = TestPageShell.ShellMode.Done;
        }
        else if (!q.ContainsKey("stap") || stap == "intro")
        {
            _mode = TestPageShell.ShellMode.Intro;
            if (!uri.Query.Contains("stap=", StringComparison.Ordinal))
            {
                Navigation.NavigateTo("/candidate/values?stap=intro", replace: true);
            }
        }
        else
        {
            _mode = TestPageShell.ShellMode.Question;
        }

        _autosave = new QuestionnaireAutosave(
            persist: async (answers, ct) => await Api.SaveMyValuesAsync(answers, complete: false, ct),
            onChanged: OnAutosaveChanged,
            onFailed: _ => InvokeAsync(() => { _liveSave = Culture["TestFlow.SaveFailed"]; return Task.CompletedTask; }));

        try
        {
            var state = await Api.GetMyValuesAsync();
            var answers = new Dictionary<int, int>();
            if (state?.Answers is not null)
            {
                foreach (var (key, value) in state.Answers)
                {
                    if (int.TryParse(key, out var id) && value is >= 1 and <= 5) answers[id] = value;
                }
            }
            _answered = answers.Count;
            _flowQuestions = TestDepthRules.QuestionIdsFor(AssessmentKind.Values, TestDepthLevel.Full)
                .Select(id =>
                {
                    var qItem = SchwartzValuesCatalog.Questions.First(x => x.Id == id);
                    return new TestQuestionFlow.FlowQuestion(id, Culture[qItem.TextKey]);
                }).ToList();
            _autosave.ReplaceAll(answers);
            var reached = TestDepthRules.Reached(AssessmentKind.Values, _answered);
            if (reached is TestDepthLevel r && r != TestDepthLevel.Full)
            {
                _target = TestDepthRules.Next(AssessmentKind.Values, _answered) ?? TestDepthLevel.Full;
            }
        }
        catch { _loadFailed = true; }
        finally { _loading = false; }
    }

    private RenderFragment RenderRail() => __builder =>
    {
        <ol class="test-rail">
            @foreach (var band in TestDepthRules.Levels(AssessmentKind.Values))
            {
                var done = _answered >= band.Count;
                var current = _mode == TestPageShell.ShellMode.Question && _target == band.Level;
                <li class="@(done ? "is-done" : current ? "is-current" : null)" aria-current="@(current ? "step" : null)">
                    @Culture[TestDepthRules.NameKey(band.Level)] · @band.Count
                </li>
            }
        </ol>
    };

    private void SelectDepth(TestDepthLevel level) { if (_answered < TestDepthRules.CountFor(AssessmentKind.Values, level)) _target = level; }
    private void StartQuestions()
    {
        _mode = TestPageShell.ShellMode.Question;
        Navigation.NavigateTo("/candidate/values?stap=vraag", replace: true);
    }
    private Task OnGateChanged(bool open) { _gateOpen = open; return Task.CompletedTask; }
    private Task OnAutosaveChanged()
    {
        if (_autosave is not null && _autosave.Status != _lastAnnounced)
        {
            _lastAnnounced = _autosave.Status;
            _liveSave = _autosave.Status switch
            {
                QuestionnaireSaveStatus.Saved => Culture["TestFlow.Saved"],
                QuestionnaireSaveStatus.Failed => Culture["TestFlow.SaveFailed"],
                _ => _liveSave
            };
        }

        _answered = _autosave?.AnsweredCount ?? _answered;
        return InvokeAsync(StateHasChanged);
    }
    private Task OnFlowChanged() => InvokeAsync(StateHasChanged);
    private async Task OnLevelReached(TestDepthLevel level)
    {
        if (level == _target) await FinishAtLevel(level, complete: level == TestDepthLevel.Full);
    }
    private async Task OnFinished() => await FinishAtLevel(_target, complete: _target == TestDepthLevel.Full);
    private async Task FinishAtLevel(TestDepthLevel level, bool complete)
    {
        _reachedLevel = level;
        try
        {
            if (_autosave is not null)
            {
                await _autosave.FlushAsync();
                if (complete) await Api.SaveMyValuesAsync(_autosave.Answers, complete: true);
            }
            _answered = _autosave?.AnsweredCount ?? _answered;
            _gainLines = [Culture["TestDone.Gain.Values1"], Culture["TestDone.Gain.Values2"], Culture["TestDone.Gain.Values3"]];
            _mode = TestPageShell.ShellMode.Done;
            Navigation.NavigateTo("/candidate/values?stap=klaar", replace: true);
        }
        catch (TestSaveClientException ex) when (ex.Code == "assessment_adjustment_limit")
        {
            _liveSave = Culture["TestErr.Limit"];
        }
        catch { _liveSave = Culture["Common.Error"]; }
    }
    private async Task LaterAsync()
    {
        if (_autosave is not null) await _autosave.FlushAsync();
        Navigation.NavigateTo("/profiel/tests/values");
    }
    public async ValueTask DisposeAsync() { if (_autosave is not null) await _autosave.DisposeAsync(); }
}
