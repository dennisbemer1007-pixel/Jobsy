@page "/profiel"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@inject NavigationManager Navigation

@* Legacy hub URL → Kompas (DNA tab). Keep route so old links keep working. *@
@code {
    protected override void OnInitialized()
        => Navigation.NavigateTo("/candidate/profile", forceLoad: false, replace: true);
}
