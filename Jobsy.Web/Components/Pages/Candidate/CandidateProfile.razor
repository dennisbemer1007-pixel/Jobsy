@page "/profiel"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@inject CandidateProfileService Profiles
@inject CultureState Culture

<PageTitle>@Culture["ProfileHub.Title"] · Lobsy</PageTitle>

<div class="panel-page profile-hub profile-hub--gateway pb-28">
    <header class="profile-hub__header">
        <div class="profile-hub__intro">
            <h1>@Culture["ProfileHub.Title"]</h1>
            <p class="login-lead">@Culture["ProfileHub.GatewayLead"]</p>
        </div>
        @if (_model is not null)
        {
            <div class="profile-hub__completeness" aria-label="@Culture.Format("ProfileHub.CompletenessAria", _model.ProfileCompletenessPercent)">
                <span class="profile-hub__completeness-label">@Culture["ProfileHub.Completeness"]</span>
                <strong>@_model.ProfileCompletenessPercent%</strong>
                <div class="profile-hub__completeness-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_model.ProfileCompletenessPercent">
                    <span style="width: @_model.ProfileCompletenessPercent%"></span>
                </div>
            </div>
        }
    </header>

    @if (_model is null)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <section class="profile-hub-gateway" aria-labelledby="profile-hub-kompas">
            <a class="profile-hub-kompas" href="/candidate/profile" id="profile-hub-kompas">
                <span class="profile-hub-kompas__eyebrow">@Culture["ProfileHub.KompasEyebrow"]</span>
                <span class="profile-hub-kompas__title">@Culture["Kompas.Title"]</span>
                <span class="profile-hub-kompas__lead">@Culture["ProfileHub.KompasLead"]</span>
                <span class="profile-hub-kompas__cta">@Culture["ProfileHub.OpenKompas"]</span>
            </a>

            <p class="profile-hub-gateway__meta muted">
                @_model.Basics.DisplayName
                @if (!string.IsNullOrWhiteSpace(_model.Basics.HomeArea))
                {
                    <span>· @_model.Basics.HomeArea</span>
                }
            </p>

            <div class="profile-hub-gateway__links">
                <a class="engagement-btn" href="/candidate/profile?tab=profile">@Culture["ProfileHub.EditBasics"]</a>
                <a class="engagement-btn" href="/carriere">@Culture["CareerDash.OpenLink"]</a>
                <a class="engagement-btn" href="/privacy">@Culture["Legal.Privacy"]</a>
            </div>
        </section>
    }
</div>

@code {
    private CandidateProfileHubModel? _model;

    protected override void OnInitialized()
        => _model = Profiles.GetProfile();
}
