@page "/candidate/external/add"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [RequiresFeature(PlatformFeature.CandidateExternalVacancies)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["ExtVac.Add.Title"] · Lobsy</PageTitle>
<HeadContent>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/kb-ext-add.js")}")" defer></script>
</HeadContent>

@if (_loading)
{
    <PageContentSkeleton Variant="apps" CardCount="1" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}

@code {
    private bool _loading = true;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override void OnInitialized()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            http.Response.Headers.CacheControl = "no-store";
            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("url", out var urlValues);
            _bodyHtml = ExternalVacancyAddSsrShells.BuildBody(Culture, urlValues.FirstOrDefault());
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
