@page "/candidate/applications/{ApplicationId:guid}/after-match/pick-slot-ssr"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [RequiresFeature(PlatformFeature.Employers)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Culture["AfterMatch.Screen04.PageTitle"] · Lobsy</PageTitle>
<PageSeo Title="@Culture["AfterMatch.Screen04.PageTitle"]" />
<HeadContent>
<link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/sollicitaties-page.css")" />
    <script src="@($"/{WwwrootAssetCatalog.Url("js/sollicitaties-mark-read-flush.js")}")" defer></script>
    <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-pick-slot.js")}")" defer></script>
</HeadContent>

@if (_loading)
{
    <PageContentSkeleton Variant="apps" CardCount="2" LoadingLabel="@Culture["Common.Loading"]" />
}
else if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}
else if (!string.IsNullOrWhiteSpace(_fatalMessage))
{
    <p class="state-message">@_fatalMessage</p>
}

@code {
    [Parameter] public Guid ApplicationId { get; set; }

    private bool _loading = true;
    private string? _fatalMessage;
    private string? _bodyHtml;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpContextAccessor.HttpContext;
            if (http is null)
            {
                _fatalMessage = Culture["Panel.ErrorInline"];
                return;
            }

            var query = QueryHelpers.ParseQuery(http.Request.QueryString.Value ?? "");
            query.TryGetValue("return", out var returnValues);
            var returnUrl = returnValues.FirstOrDefault();

            var data = await AfterMatchPickSlotSsrData.LoadAsync(
                Api,
                Culture,
                ApplicationId,
                returnUrl);

            if (data is null)
            {
                _bodyHtml = AfterMatchSsrErrorShells.BuildInterviewNotFound(
                    Culture,
                    returnUrl,
                    "AfterMatch.Screen04.PageTitle",
                    "AfterMatch.Link.BackPickSlot");
                return;
            }

            _bodyHtml = AfterMatchPickSlotSsrShells.BuildBody(Culture, data, ApplicationId);
        }
        catch
        {
            _fatalMessage = Culture["Panel.ErrorInline"];
        }
        finally
        {
            _loading = false;
        }
    }
}
