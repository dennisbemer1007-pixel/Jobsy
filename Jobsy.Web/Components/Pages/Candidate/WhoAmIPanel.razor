@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation

<div class="whoami">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrWhiteSpace(_message) && _state is null)
    {
        <p class="state-message">@_message</p>
        <button type="button" class="engagement-btn" disabled="@_loading" @onclick="RetryAsync">
            @Culture["Common.Retry"]
        </button>
    }
    else if (_state is { IsUnlocked: true } open)
    {
        <p class="login-lead">@Culture["WhoAmI.LeadOpen"]</p>
        @if (string.Equals(open.InsightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            <p class="state-message" aria-live="polite">@Culture["Insights.Updating"]</p>
        }
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="kompas-status kompas-status--ok">@_message</p>
        }

        <section class="whoami-section" aria-labelledby="whoami-story-title">
            <h3 id="whoami-story-title" class="whoami__title">@Culture["WhoAmI.StoryTitle"]</h3>
            <div class="whoami-story">
                @foreach (var para in Paragraphs(open.Story))
                {
                    <p>@para</p>
                }
            </div>
        </section>

        @if (HasProfileBits(open))
        {
            <section class="whoami-section" aria-labelledby="whoami-profile-title">
                <h3 id="whoami-profile-title" class="whoami__title">@Culture["WhoAmI.ProfileTitle"]</h3>
                <div class="whoami-profile-grid">
                    @if (open.Employers.Count > 0)
                    {
                        <div class="whoami-profile-card">
                            <h4>@Culture["WhoAmI.WorkExperience"]</h4>
                            <ul>
                                @foreach (var job in open.Employers.Take(4))
                                {
                                    <li>
                                        <strong>@(string.IsNullOrWhiteSpace(job.Role) ? job.EmployerName : job.Role)</strong>
                                        @if (!string.IsNullOrWhiteSpace(job.Role) && !string.IsNullOrWhiteSpace(job.EmployerName))
                                        {
                                            <span class="muted"> · @job.EmployerName</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    @if (open.Educations.Count > 0 || open.Certificates.Count > 0)
                    {
                        <div class="whoami-profile-card">
                            <h4>@Culture["WhoAmI.Courses"]</h4>
                            <ul>
                                @foreach (var edu in open.Educations.Take(4))
                                {
                                    <li>@edu</li>
                                }
                                @foreach (var cert in open.Certificates.Take(4))
                                {
                                    <li>@cert</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </section>
        }

        @if (open.Keywords.Count > 0)
        {
            <section class="whoami-section" aria-labelledby="whoami-keywords-title">
                <h3 id="whoami-keywords-title" class="whoami__title">@Culture["WhoAmI.Keywords"]</h3>
                <ul class="whoami-chips">
                    @foreach (var keyword in open.Keywords)
                    {
                        <li>@keyword</li>
                    }
                </ul>
            </section>
        }

        <section class="whoami-section" aria-labelledby="whoami-comp-title">
            <div class="whoami-section__head">
                <h3 id="whoami-comp-title" class="whoami__title">@Culture["Kompas.TabCompetencies"]</h3>
                <p class="whoami-model muted">@Culture["Competency.ScienceNote"]</p>
            </div>
            <CompetencyScorePanel Scores="open.CompetencyScores" />
        </section>

        <section class="whoami-section" aria-labelledby="whoami-culture-title">
            <div class="whoami-section__head">
                <h3 id="whoami-culture-title" class="whoami__title">@Culture["WhoAmI.CultureTitle"]</h3>
                <p class="whoami-model muted">@Culture["CultureScan.ScienceNote"]</p>
            </div>
            <CultureScorePanel Scores="open.CultureScores" />
        </section>

        <section class="whoami-section whoami-section--career" aria-labelledby="whoami-career-title">
            <div class="whoami-section__head">
                <h3 id="whoami-career-title" class="whoami__title">@Culture["Kompas.TabCareers"]</h3>
                <p class="whoami-model muted">@Culture["Career.ScienceNote"]</p>
            </div>
            <RiasecScorePanel Scores="open.CareerScores" />
            <button type="button" class="engagement-btn" @onclick="() => GoTab(CandidateKompasTabs.Career)">
                @Culture["WhoAmI.OpenCareerResults"]
            </button>
        </section>

        <label class="whoami-attach">
            <input type="checkbox" checked="@open.IncludeOnCv" disabled="@_busy" @onchange="OnAttachChanged" />
            <span>
                <strong>@Culture["WhoAmI.AttachCv"]</strong>
                <span class="whoami-attach__hint">@Culture["WhoAmI.AttachHint"]</span>
            </span>
        </label>
    }
    else if (_state is { } locked)
    {
        <p class="login-lead">@Culture["WhoAmI.LeadLocked"]</p>
        <p class="kompas-status">@Culture.Format("WhoAmI.Progress", locked.CompletedCount)</p>
        <ol class="whoami-checklist">
            <li class="@(locked.ProfileFilled ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(locked.ProfileFilled ? "✓" : "")</span>
                <div>
                    <strong>@Culture["WhoAmI.StepProfile"]</strong>
                    @if (!locked.ProfileFilled)
                    {
                        <p>@Culture["WhoAmI.StepProfileHint"]</p>
                        <button type="button" class="engagement-btn" @onclick="() => GoTab(CandidateKompasTabs.Profile)">@Culture["WhoAmI.OpenProfile"]</button>
                    }
                </div>
            </li>
            <li class="@(locked.CompetencyCompleted ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(locked.CompetencyCompleted ? "✓" : "")</span>
                <div>
                    <strong>@Culture["WhoAmI.StepCompetency"]</strong>
                    @if (!locked.CompetencyCompleted)
                    {
                        <a class="engagement-btn" href="/candidate/competencies">@Culture["WhoAmI.OpenCompetency"]</a>
                    }
                </div>
            </li>
            <li class="@(locked.CareerCompleted ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(locked.CareerCompleted ? "✓" : "")</span>
                <div>
                    <strong>@Culture["WhoAmI.StepCareer"]</strong>
                    @if (!locked.CareerCompleted)
                    {
                        <a class="engagement-btn" href="/candidate/career">@Culture["WhoAmI.OpenCareer"]</a>
                    }
                </div>
            </li>
            <li class="@(locked.CultureCompleted ? "is-done" : null)">
                <span class="whoami-check" aria-hidden="true">@(locked.CultureCompleted ? "✓" : "")</span>
                <div>
                    <strong>@Culture["WhoAmI.StepCulture"]</strong>
                    @if (!locked.CultureCompleted)
                    {
                        <a class="engagement-btn" href="/candidate/culture">@Culture["WhoAmI.OpenCulture"]</a>
                    }
                </div>
            </li>
        </ol>
        @if (!string.IsNullOrWhiteSpace(locked.Encouragement))
        {
            <p class="login-lead">@locked.Encouragement</p>
        }
    }
</div>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<string> OnOpenTab { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _wasActive;
    private bool _loadStarted;
    private string? _message;
    private WhoAmIState? _state;
    private int _insightsRefreshAttempts;

    protected override async Task OnParametersSetAsync()
    {
        if (Active == _wasActive)
        {
            return;
        }

        var opening = Active && !_wasActive;
        _wasActive = Active;
        if (opening)
        {
            await LoadAsync(force: false);
        }
    }

    private Task RetryAsync() => LoadAsync(force: true);

    private async Task LoadAsync(bool force)
    {
        if (_loadStarted && !force && _state is not null)
        {
            return;
        }

        _loadStarted = true;
        var firstLoad = _state is null;
        if (firstLoad || force)
        {
            _loading = true;
            _message = null;
        }

        try
        {
            WhoAmIState? next = null;
            for (var attempt = 1; attempt <= 2; attempt++)
            {
                try
                {
                    next = await Api.GetMyWhoAmIAsync();
                    if (next is not null)
                    {
                        break;
                    }
                }
                catch (Exception ex) when (attempt < 2 && HomeDashboardLoad.IsTransient(ex))
                {
                    await Task.Delay(400);
                    continue;
                }
                catch
                {
                    next = null;
                    break;
                }

                if (next is null && attempt < 2)
                {
                    await Task.Delay(400);
                }
            }

            if (next is not null)
            {
                _state = next;
                _message = null;
                if (string.Equals(next.InsightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                {
                    _ = RefreshInsightsLaterAsync();
                }
            }
            else if (_state is null)
            {
                _message = Culture["Common.Error"];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshInsightsLaterAsync()
    {
        while (_insightsRefreshAttempts < 3
               && _state is not null
               && string.Equals(_state.InsightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
        {
            _insightsRefreshAttempts++;
            try
            {
                await Task.Delay(3000);
                var next = await Api.GetMyWhoAmIAsync();
                if (next is null)
                {
                    continue;
                }

                _state = next;
                await InvokeAsync(StateHasChanged);
                if (!string.Equals(next.InsightsStatus, "Updating", StringComparison.OrdinalIgnoreCase))
                {
                    break;
                }
            }
            catch
            {
                break;
            }
        }
    }

    private async Task GoTab(string tab)
    {
        if (OnOpenTab.HasDelegate)
        {
            await OnOpenTab.InvokeAsync(tab);
            return;
        }

        Navigation.NavigateTo($"/home?tab={tab}");
    }

    private async Task OnAttachChanged(ChangeEventArgs e)
    {
        var include = e.Value is true or "true" or "on";
        _busy = true;
        _message = null;
        try
        {
            _state = await Api.SaveMyWhoAmIAsync(include);
            _message = Culture["WhoAmI.Saved"];
        }
        catch
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool HasProfileBits(WhoAmIState open)
        => open.Employers.Count > 0 || open.Educations.Count > 0 || open.Certificates.Count > 0;

    private static IEnumerable<string> Paragraphs(string? story)
        => string.IsNullOrWhiteSpace(story)
            ? []
            : story.Split(["\r\n\r\n", "\n\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
