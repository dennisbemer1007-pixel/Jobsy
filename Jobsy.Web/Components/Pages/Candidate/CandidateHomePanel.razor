@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<div class="panel-page panel-page--dashboard">
    <header class="panel-header panel-header--dashboard">
        <div>
            <h1>@Culture["Kompas.Title"]</h1>
            <p class="login-lead">@Culture["Kompas.Lead"]</p>
        </div>
    </header>

    <CandidateKompas />

    @if (_error is not null && _metrics.Count == 0 && !_loading)
    {
        <p class="state-message error">@_error</p>
    }
    else if (_loading && _metrics.Count == 0)
    {
        <div class="bento-grid" aria-busy="true" aria-label="@Culture["Common.Loading"]">
            <div class="bento-grid__main">
                <div class="bento-hero" style="--bento-hero-cols:4">
                    <MetricTileSkeleton Size="featured" />
                    <MetricTileSkeleton Size="default" ShowRing="true" />
                    <MetricTileSkeleton Size="default" />
                    <MetricTileSkeleton Size="default" ShowRing="true" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="bento-grid">
            <div class="bento-grid__main">
                @if (_metrics.Count > 0)
                {
                    <div class="bento-hero" style="--bento-hero-cols:@Math.Min(_metrics.Count, 4)" aria-label="Kerncijfers">
                        @for (var i = 0; i < _metrics.Count; i++)
                        {
                            var metric = _metrics[i];
                            <MetricTile Label="@UiLabels.MetricKey(Culture, metric.Key)"
                                        FormattedValue="@metric.Value.ToString("0")"
                                        Size="@(i == 0 ? "featured" : "default")"
                                        Emphasis="@(i == 0)"
                                        Sparkline="@metric.Sparkline"
                                        Selected="@(_selectedKey == metric.Key)"
                                        OnClick="() => SelectMetricAsync(metric.Key)" />
                        }
                    </div>
                }
            </div>
        </div>

        @if (_selectedKey is not null)
        {
            <DrilldownGrid Title="@SelectedLabel"
                           OverviewHref="@ListHrefFor(_selectedKey)"
                           Loading="@_drillLoading"
                           ShowAmount="false"
                           Items="_drilldown" />
        }
    }
</div>

@code {
    private const string Period = "week";

    private string? _selectedKey;
    private bool _loading = true;
    private bool _drillLoading;
    private string? _error;
    private List<MetricCount> _metrics = [];
    private List<MetricDrilldownItem> _drilldown = [];

    private string SelectedLabel =>
        _selectedKey is null ? "" : UiLabels.MetricKey(Culture, _selectedKey);

    private bool _loadStarted;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override Task OnInitializedAsync()
        => TryLoadAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? TryLoadAsync() : Task.CompletedTask;

    private async Task TryLoadAsync()
    {
        if (!HomeDashboardLoad.TryBegin(ref _loadStarted, RendererInfo.IsInteractive))
        {
            return;
        }

        await LoadSummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private async Task SelectMetricAsync(string key)
    {
        if (_selectedKey == key)
        {
            _selectedKey = null;
            _drilldown = [];
            return;
        }

        _selectedKey = key;
        await LoadDrilldownAsync(key);
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        _error = null;
        var (metrics, error) = await HomeDashboardLoad.FetchAsync(async () =>
            (await Api.GetMyMetricsSummaryAsync(Period)).ToList());
        if (error is not null)
        {
            _error = error;
            _metrics = [];
        }
        else
        {
            _metrics = metrics ?? [];
        }

        _loading = false;
    }

    private async Task LoadDrilldownAsync(string key)
    {
        _drillLoading = true;
        try
        {
            _drilldown = (await Api.GetMyMetricsDrilldownAsync(key, Period)).ToList();
        }
        catch
        {
            _drilldown = [];
        }
        finally
        {
            _drillLoading = false;
        }
    }

    private static string ListHrefFor(string key) => key.ToLowerInvariant() switch
    {
        "applications" => "/candidate/applications",
        "likes" => "/candidate/liked",
        "shares" => "/candidate/shared",
        _ => "/home"
    };
}
