@page "/candidate/wat-drijft-jou"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Candidate")]
@using Jobsy.Web.Components.Candidate
@using Jobsy.Web.Components.UwvMockups
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.UwvFeatures
@using Jobsy.Web.UwvMockups
@inject CultureState Culture
@inject IUwvFeaturesMockupGate UwvGate

<PageTitle>@UwvMockupCopy.Drijfveren.ResultsTitle(Culture.Language) · Lobsy</PageTitle>

@if (!UwvGate.IsEnabled)
{
    <div class="panel-page"><p class="state-message">@Culture["Common.Error"]</p></div>
}
else
{
    <div class="journey-page panel-page--cand-ill">
        <CandidateIllustratedHero Eyebrow="@(UwvMockupCopy.IsEnglish(Culture.Language) ? "My results" : "Mijn resultaten")"
                                  Title="@UwvMockupCopy.Drijfveren.ResultsTitle(Culture.Language)"
                                  Lead="@UwvMockupCopy.Drijfveren.Lead(Culture.Language)"
                                  ArtUrl="@CandidateIllustratedImages.KompasHeroWide"
                                  ArtUrlMobileFigures="@CandidateIllustratedImages.MobFiguresKompas"
                                  ArtPosition="right center"
                                  ArtPositionDesktop="right center"
                                  CssClass="cand-hero--kompas-band cand-hero--with-art" />
        <div class="opl-wrap">
            <UwvDrijfverenResults />
        </div>
    </div>
}
