@page "/branch/applicants"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary")]
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Employer.Applicants"] · Lobsy</PageTitle>

<div class="panel-page">
    <h1>@Culture["Employer.Applicants"]</h1>
    <p class="login-lead">@Culture["Employer.ApplicantsLead"]</p>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="state-message">Nog geen reacties.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var a in _items)
            {
                <div class="table-row">
                    <div>
                        @if (a.MatchPercent is int matchPct)
                        {
                            <strong class="match-score match-score--@(MatchBand(matchPct, a.ViaSafetyNet))">@matchPct%</strong>
                            @if (a.ViaSafetyNet)
                            {
                                <span class="status-pill">Vangnet</span>
                            }
                        }
                        @if (a.PiiRevealed)
                        {
                            <strong>@a.CandidateName</strong>
                            <span class="muted">@a.CandidateEmail</span>
                            @if (!string.IsNullOrWhiteSpace(a.CandidateAddress))
                            {
                                <span class="muted">@a.CandidateAddress</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.CandidateCity))
                            {
                                <span class="muted">@a.CandidateCity</span>
                            }
                            <span class="muted">
                                @(a.DistanceKm is not null ? $"{a.DistanceKm:0.#} km" : "afstand onbekend")
                                · @a.PreferredTransport · @a.EstimatedTravelMinutes min
                            </span>
                        }
                        else
                        {
                            <strong>Kandidaat</strong>
                            <span class="muted">@a.PreferredTransport · @a.EstimatedTravelMinutes min</span>
                            @if (!string.IsNullOrWhiteSpace(a.PreferencesSummary))
                            {
                                <span class="muted">Voorkeuren: @a.PreferencesSummary</span>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(a.Motivation))
                        {
                            <span class="muted"><em>Motivatie:</em> @a.Motivation</span>
                        }
                        @if (a.PiiRevealed)
                        {
                            <span class="muted">Werkvergunning: @(a.WorkPermitConfirmed ? "Bevestigd" : "Onbekend")</span>
                            <span class="muted">Wettelijk: kandidaat voldoet aan de taakeisen</span>
                        }
                        @if (a.PiiRevealed)
                        {
                            @if (!string.IsNullOrWhiteSpace(a.SnapshotDrivingLicenses))
                            {
                                <span class="muted">Rijbewijs: @a.SnapshotDrivingLicenses</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.SnapshotEducations))
                            {
                                <span class="muted">Opleiding: @a.SnapshotEducations</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.SchoolEmail))
                            {
                                <span class="muted">School-e-mail: @a.SchoolEmail</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.StudentNumber))
                            {
                                <span class="muted">Studentnummer: @a.StudentNumber</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.StudyProgram))
                            {
                                <span class="muted">Stage-opleiding: @a.StudyProgram@(string.IsNullOrWhiteSpace(a.StudyYear) ? "" : $" · jaar {a.StudyYear}")</span>
                            }
                            @if (a.CandidateEmployerCount > 0)
                            {
                                <span class="muted">Eerdere werkgevers: @a.CandidateEmployerCount</span>
                            }
                        }
                        <span class="muted">@a.VacancyTitle · @UiLabels.ApplicationStatus(Culture, a.Status)</span>
                    </div>
                    <div class="inline-actions">
                        @if (_canReact && a.Status == "Pending")
                        {
                            <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => ReactAsync(a.Id, AcceptedStatus)">
                                Accepteer
                            </button>
                            <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => ReactAsync(a.Id, RejectedStatus)">
                                Wijs af
                            </button>
                        }
                        @if (_canReact && a.Status == "Accepted")
                        {
                            <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => MarkContactAsync(a.Id)">
                                Contact met kandidaat
                            </button>
                        }
                        @if (_canReact && (a.Status == "Accepted" || a.Status == "EmployerContacting"))
                        {
                            <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => FulfillAsync(a.VacancyId, a.Id)">
                                Markeer als vervuld
                            </button>
                        }
                        <span class="status-pill status-pill--@a.Status.ToLowerInvariant()">@UiLabels.ApplicationStatus(Culture, a.Status)</span>
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    private const string AcceptedStatus = "Accepted";
    private const string RejectedStatus = "Rejected";

    private List<EmployerApplicationItem> _items = [];
    private bool _loading = true;
    private bool _canReact;
    private Guid? _busyId;
    private string? _message;

    private static string MatchBand(int percent, bool viaSafetyNet)
        => viaSafetyNet || percent < 50 ? "red" : percent >= 70 ? "green" : "orange";

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _canReact = user.IsInRole("BranchManager")
                || user.IsInRole("EnterpriseManager")
                || user.IsInRole("Intermediary")
                || user.IsInRole("Admin");
            _items = (await Api.GetApplicationsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReactAsync(Guid id, string status)
    {
        if (!_canReact)
        {
            return;
        }

        _busyId = id;
        _message = null;
        try
        {
            await Api.ReactToApplicationAsync(id, status);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = status == "Accepted"
                ? "Geaccepteerd — PII zichtbaar, stub e-mail/push verstuurd."
                : "Afgewezen — stub e-mail/push verstuurd.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task MarkContactAsync(Guid id)
    {
        _busyId = id;
        _message = null;
        try
        {
            await Api.MarkEmployerContactAsync(id);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = "Status bijgewerkt naar: Werkgever neemt contact op.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task FulfillAsync(Guid vacancyId, Guid applicationId)
    {
        _busyId = applicationId;
        _message = null;
        try
        {
            await Api.FulfillVacancyAsync(vacancyId, applicationId);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = "Vacature gemarkeerd als vervuld; overige kandidaten zijn geïnformeerd.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busyId = null;
        }
    }
}
