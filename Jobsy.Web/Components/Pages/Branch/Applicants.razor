@page "/branch/applicants"
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["Employer.Applicants"] · Lobsy</PageTitle>

<div class="panel-page applicants-page">
    <header class="applicants-page__header">
        <div>
            <h1>@Culture["Employer.Applicants"]</h1>
            <p class="login-lead">@Culture["Employer.ApplicantsLead"]</p>
        </div>
        @if (_canReact)
        {
            <p class="applicants-page__hint muted">@Culture["Employer.ApplicantsPrivacyHint"]</p>
        }
        else
        {
            <p class="applicants-page__hint muted">@Culture["Employer.ApplicantsReadOnly"]</p>
        }
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="state-message">@Culture["Employer.ApplicantsEmpty"]</p>
    }
    else
    {
        var filteredItems = FilteredItems.ToList();

        <div class="applicants-filters pill-scroller" role="tablist" aria-label="@Culture["Employer.Applicants"]">
            @foreach (var filter in StatusFilters)
            {
                <button type="button"
                        class="applicants-filters__btn @(_statusFilter == filter.Key ? "is-active" : null)"
                        role="tab"
                        aria-selected="@(_statusFilter == filter.Key)"
                        @onclick="() => _statusFilter = filter.Key">
                    @filter.Label
                    <span class="applicants-filters__count">@CountFor(filter.Key)</span>
                </button>
            }
        </div>

        @if (filteredItems.Count == 0)
        {
            <p class="state-message">Geen sollicitaties binnen dit filter.</p>
        }
        else
        {
        <div class="applicants-list">
            @foreach (var a in filteredItems)
            {
                var expanded = _expandedIds.Contains(a.Id);
                var otherPending = CountOtherOpen(a);
                var detailsId = $"application-details-{a.Id:N}";
                var prefs = HumanText(a.PreferencesSummary);
                var licenses = HumanText(a.SnapshotDrivingLicenses);
                var educations = HumanText(a.SnapshotEducations);
                var about = HumanText(a.SnapshotAboutMe);
                <article class="applicant-card status-@a.Status.ToLowerInvariant() @(expanded ? "is-expanded" : null)">
                    <button type="button"
                            class="applicant-card__summary"
                            aria-expanded="@(expanded ? "true" : "false")"
                            aria-controls="@detailsId"
                            aria-label="@($"{(expanded ? "Verberg" : "Toon")} details voor {DisplayCandidateName(a)} bij {a.VacancyTitle}")"
                            @onclick="() => ToggleExpanded(a.Id)">
                        <span class="applicant-card__identity">
                            <strong>@DisplayCandidateName(a)</strong>
                            <span class="applicant-card__job">@a.VacancyTitle</span>
                            @if (!string.IsNullOrWhiteSpace(a.CompanyName))
                            {
                                <span class="muted">@a.CompanyName</span>
                            }
                        </span>
                        <span class="applicant-card__meta">
                            @if (a.MatchPercent is int matchPct)
                            {
                                <span class="match-score match-score--@(MatchBand(matchPct, a.ViaSafetyNet))">@matchPct%</span>
                            }
                            <span class="status-pill status-pill--@a.Status.ToLowerInvariant()">@UiLabels.ApplicationStatus(Culture, a.Status)</span>
                            <span class="applicant-card__when muted">@a.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                        </span>
                        <span class="applicant-card__chevron" aria-hidden="true">@(expanded ? "−" : "+")</span>
                    </button>
                    @if (expanded)
                    {
                        <div id="@detailsId" class="applicant-card__details">
                            <section class="applicant-card__section">
                                <h3>@Culture["Employer.FactMotivation"]</h3>
                                <p>@(string.IsNullOrWhiteSpace(a.Motivation) ? "—" : a.Motivation)</p>
                            </section>
                            <section class="applicant-card__section">
                                <h3>@Culture["Employer.FactAvailability"]</h3>
                                <p>@(string.IsNullOrWhiteSpace(a.AvailabilitySummary) ? "—" : a.AvailabilitySummary)</p>
                                @if (!string.IsNullOrWhiteSpace(prefs))
                                {
                                    <p class="muted">@prefs</p>
                                }
                            </section>
                            <section class="applicant-card__section">
                                <h3>@Culture["Employer.FactProfile"]</h3>
                                <dl class="applicants-grid__facts">
                                    <div>
                                        <dt>@Culture["Employer.FactDistance"]</dt>
                                        <dd>@FormatTravel(a)</dd>
                                    </div>
                                    <div>
                                        <dt>@Culture["Employer.FactAge"]</dt>
                                        <dd>@(a.CandidateAgeYears is int age ? $"{age}" : "—")</dd>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(licenses))
                                    {
                                        <div>
                                            <dt>@Culture["Employer.FactLicense"]</dt>
                                            <dd>@licenses</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(educations))
                                    {
                                        <div>
                                            <dt>@Culture["Employer.FactEducation"]</dt>
                                            <dd>@educations</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(about))
                                    {
                                        <div class="applicants-grid__fact--wide">
                                            <dt>@Culture["Employer.FactAbout"]</dt>
                                            <dd>@about</dd>
                                        </div>
                                    }
                                </dl>
                            </section>
                            <section class="applicant-card__section">
                                <h3>@Culture["Employer.FactContact"]</h3>
                                @if (IsDirectContactVisible(a))
                                {
                                    <div class="contact-icons">
                                        @if (!string.IsNullOrWhiteSpace(a.CandidateEmail))
                                        {
                                            <a class="contact-icon" href="@($"mailto:{a.CandidateEmail}")" title="@a.CandidateEmail" aria-label="E-mail">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(a.CandidatePhone))
                                        {
                                            <a class="contact-icon" href="@($"tel:{DigitsOnly(a.CandidatePhone)}")" title="@a.CandidatePhone" aria-label="Bellen">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3c0 1-1 2-2 2C10 19.5 4.5 14 4.5 5.5c0-1 1-2 2-2Z"/></svg>
                                            </a>
                                        }
                                        @if (a.WhatsAppContactAllowed && !string.IsNullOrWhiteSpace(a.CandidatePhone))
                                        {
                                            <a class="contact-icon" href="@WhatsAppHref(a.CandidatePhone)" target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="WhatsApp">
                                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.7 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.8 1c-.1.1-.3.2-.5.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.5.1-.3c0-.1 0-.3-.1-.4l-.8-1.9c-.2-.5-.4-.4-.5-.4h-.4a.8.8 0 0 0-.6.3 2.5 2.5 0 0 0-.8 1.9 4.4 4.4 0 0 0 .9 2.3 10 10 0 0 0 3.8 3.6 4.3 4.3 0 0 0 2.5.8 2.1 2.1 0 0 0 1.5-.7 1.8 1.8 0 0 0 .4-1.2c0-.2 0-.2-.2-.3Z"/></svg>
                                            </a>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(a.CandidateCity))
                                    {
                                        <p class="muted">@a.CandidateCity</p>
                                    }
                                }
                                else
                                {
                                    <p class="muted">@Culture["Employer.HireToRevealContact"]</p>
                                    @if (a.MatchPercent is int pct)
                                    {
                                        <p class="muted">Match @pct%</p>
                                    }
                                }
                            </section>
                            <div class="applicant-card__actions">
                                @if (_canReact && a.Status == "Pending")
                                {
                                    <button type="button" class="engagement-btn engagement-btn--primary" disabled="@_busyId.HasValue" @onclick="() => ReactAsync(a.Id, AcceptedStatus)" @onclick:stopPropagation="true">
                                        @Culture["Employer.Accept"]
                                    </button>
                                    <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => OpenRejectConfirm(a)" @onclick:stopPropagation="true">
                                        @Culture["Employer.Reject"]
                                    </button>
                                }
                                @if (_canReact && a.Status == "Accepted")
                                {
                                    <button type="button" class="engagement-btn engagement-btn--primary" disabled="@_busyId.HasValue" @onclick="() => MarkContactAsync(a.Id)" @onclick:stopPropagation="true">
                                        @Culture["Employer.Invite"]
                                    </button>
                                }
                                @if (_canReact && (a.Status == "Accepted" || a.Status == "EmployerContacting"))
                                {
                                    <button type="button" class="engagement-btn engagement-btn--primary" disabled="@_busyId.HasValue" @onclick="() => OpenMatchConfirm(a, otherPending)" @onclick:stopPropagation="true">
                                        @Culture["Employer.Match"]
                                    </button>
                                }
                                @if (a.CvPdfAvailable || a.PiiRevealed)
                                {
                                    <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => DownloadCvAsync(a.Id)" @onclick:stopPropagation="true">
                                        @Culture["Employer.DownloadLobsyCv"]
                                    </button>
                                }
                                @if (a.UploadedCvAvailable)
                                {
                                    <button type="button" class="engagement-btn" disabled="@_busyId.HasValue" @onclick="() => DownloadUploadedCvAsync(a.Id)" @onclick:stopPropagation="true">
                                        @Culture["Employer.DownloadUploadedCv"]
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message @(_messageIsError ? "error" : null)">@_message</p>
        }
    }
</div>

@if (_rejectTarget is not null)
{
    <div class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="reject-title">
        <button type="button" class="confirm-modal__backdrop" @onclick="CloseDialogs" aria-label="@Culture["Common.Close"]"></button>
        <div class="confirm-modal__dialog">
            <h2 id="reject-title">@Culture["Employer.RejectConfirmTitle"]</h2>
            <p>@Culture["Employer.RejectConfirmBody"]</p>
            <div class="confirm-modal__actions">
                <button type="button" class="engagement-btn" @onclick="CloseDialogs">@Culture["Common.Cancel"]</button>
                <button type="button" class="engagement-btn engagement-btn--danger" disabled="@_busyId.HasValue" @onclick="ConfirmRejectAsync">
                    @Culture["Employer.Reject"]
                </button>
            </div>
        </div>
    </div>
}

@if (_matchTarget is not null)
{
    <div class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="match-title">
        <button type="button" class="confirm-modal__backdrop" @onclick="CloseDialogs" aria-label="@Culture["Common.Close"]"></button>
        <div class="confirm-modal__dialog">
            <h2 id="match-title">@Culture["Employer.MatchConfirmTitle"]</h2>
            <p>@Culture.Format("Employer.MatchConfirmBody", _matchTarget.CandidateName ?? Culture["Employer.AnonymousCandidate"], _matchTarget.VacancyTitle)</p>

            <label class="confirm-modal__check">
                <input type="checkbox" @bind="_matchRejectOthers" />
                <span>
                    @Culture["Employer.MatchRejectOthers"]
                    @if (_matchOtherCount > 0)
                    {
                        <span class="muted"> (@Culture.Format("Employer.MatchRejectOthersCount", _matchOtherCount))</span>
                    }
                </span>
            </label>
            <label class="confirm-modal__check">
                <input type="checkbox" @bind="_matchCloseVacancy" />
                <span>@Culture["Employer.MatchCloseVacancy"]</span>
            </label>

            <div class="confirm-modal__actions">
                <button type="button" class="engagement-btn" @onclick="CloseDialogs">@Culture["Common.Cancel"]</button>
                <button type="button" class="engagement-btn engagement-btn--primary" disabled="@_busyId.HasValue" @onclick="ConfirmMatchAsync">
                    @Culture["Employer.MatchConfirm"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string AcceptedStatus = "Accepted";
    private const string RejectedStatus = "Rejected";

    private List<EmployerApplicationItem> _items = [];
    private bool _loading = true;
    private bool _canReact;
    private Guid? _busyId;
    private string? _message;
    private bool _messageIsError;
    private string _statusFilter = "all";
    private readonly HashSet<Guid> _expandedIds = [];

    private EmployerApplicationItem? _rejectTarget;
    private EmployerApplicationItem? _matchTarget;
    private int _matchOtherCount;
    private bool _matchRejectOthers = true;
    private bool _matchCloseVacancy = true;

    private IEnumerable<(string Key, string Label)> StatusFilters =>
    [
        ("all", Culture["Employer.FilterAll"]),
        ("open", Culture["Employer.FilterOpen"]),
        ("accepted", Culture["Employer.FilterAccepted"]),
        ("matched", Culture["Employer.FilterMatched"]),
        ("rejected", Culture["Employer.FilterRejected"])
    ];

    private IEnumerable<EmployerApplicationItem> FilteredItems =>
        (_statusFilter switch
        {
            "open" => _items.Where(a => a.Status is "Pending"),
            "accepted" => _items.Where(a => a.Status is "Accepted" or "EmployerContacting"),
            "matched" => _items.Where(a => a.Status is "Hired"),
            "rejected" => _items.Where(a => a.Status is "Rejected" or "FilledElsewhere" or "Withdrawn"),
            _ => _items
        })
        .OrderBy(a => StatusSortRank(a.Status))
        .ThenByDescending(a => a.CreatedAt)
        .ThenBy(a => a.VacancyTitle, StringComparer.CurrentCultureIgnoreCase);

    private static string MatchBand(int percent, bool viaSafetyNet)
        => viaSafetyNet || percent < 50 ? "red" : percent >= 70 ? "green" : "orange";

    private static int StatusSortRank(string status) => status switch
    {
        "Pending" => 0,
        "Accepted" or "EmployerContacting" => 1,
        _ => 2
    };

    private void ToggleExpanded(Guid id)
    {
        if (!_expandedIds.Add(id))
        {
            _expandedIds.Remove(id);
        }
    }

    private static string? HumanText(string? value)
        => ApplicationPreferenceRedaction.ToHumanReadable(value);

    private string DisplayCandidateName(EmployerApplicationItem item) =>
        item.PiiRevealed && !string.IsNullOrWhiteSpace(item.CandidateName)
            ? item.CandidateName
            : Culture["Employer.AnonymousCandidate"];

    private static bool IsDirectContactVisible(EmployerApplicationItem item)
        => Enum.TryParse<ApplicationStatus>(item.Status, ignoreCase: true, out var status)
           && ApplicationRules.IsDirectContactRevealed(status);

    private static string DigitsOnly(string phone)
        => new string(phone.Where(char.IsDigit).ToArray());

    private static string WhatsAppHref(string phone)
    {
        var digits = DigitsOnly(phone);
        if (digits.StartsWith("0", StringComparison.Ordinal) && digits.Length >= 9)
        {
            digits = "31" + digits[1..];
        }

        return $"https://wa.me/{digits}";
    }

    private string FormatTravel(EmployerApplicationItem item)
    {
        var travel = $"± {item.EstimatedTravelMinutes} min ({UiLabels.Transport(Culture, item.PreferredTransport)})";
        return item.DistanceKm is double km
            ? $"{km.ToString("0.#")} km · {travel}"
            : travel;
    }

    private int CountFor(string key) => key switch
    {
        "open" => _items.Count(a => a.Status is "Pending"),
        "accepted" => _items.Count(a => a.Status is "Accepted" or "EmployerContacting"),
        "matched" => _items.Count(a => a.Status is "Hired"),
        "rejected" => _items.Count(a => a.Status is "Rejected" or "FilledElsewhere" or "Withdrawn"),
        _ => _items.Count
    };

    private int CountOtherOpen(EmployerApplicationItem current) =>
        _items.Count(a => a.VacancyId == current.VacancyId
                          && a.Id != current.Id
                          && a.Status is "Pending" or "Accepted" or "EmployerContacting");

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _canReact = user.IsInRole("BranchManager")
                || user.IsInRole("EnterpriseManager")
                || user.IsInRole("Intermediary")
                || user.IsInRole("Admin");
            _items = (await Api.GetApplicationsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void CloseDialogs()
    {
        _rejectTarget = null;
        _matchTarget = null;
    }

    private void OpenRejectConfirm(EmployerApplicationItem item)
        => _rejectTarget = item;

    private void OpenMatchConfirm(EmployerApplicationItem item, int otherCount)
    {
        _matchTarget = item;
        _matchOtherCount = otherCount;
        _matchRejectOthers = true;
        _matchCloseVacancy = true;
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectTarget is null)
        {
            return;
        }

        var id = _rejectTarget.Id;
        CloseDialogs();
        await ReactAsync(id, RejectedStatus);
    }

    private async Task ConfirmMatchAsync()
    {
        if (_matchTarget is null)
        {
            return;
        }

        var vacancyId = _matchTarget.VacancyId;
        var applicationId = _matchTarget.Id;
        var rejectOthers = _matchRejectOthers;
        var closeVacancy = _matchCloseVacancy;
        CloseDialogs();
        await FulfillAsync(vacancyId, applicationId, rejectOthers, closeVacancy);
    }

    private async Task ReactAsync(Guid id, string status)
    {
        if (!_canReact)
        {
            return;
        }

        _busyId = id;
        _message = null;
        _messageIsError = false;
        try
        {
            await Api.ReactToApplicationAsync(id, status);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = status == AcceptedStatus
                ? Culture["Employer.AcceptedToast"]
                : Culture["Employer.RejectedToast"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task MarkContactAsync(Guid id)
    {
        _busyId = id;
        _message = null;
        _messageIsError = false;
        try
        {
            await Api.MarkEmployerContactAsync(id);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = Culture["Employer.InvitedToast"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task FulfillAsync(Guid vacancyId, Guid applicationId, bool rejectOthers, bool closeVacancy)
    {
        _busyId = applicationId;
        _message = null;
        _messageIsError = false;
        try
        {
            await Api.FulfillVacancyAsync(vacancyId, applicationId, rejectOthers, closeVacancy);
            _items = (await Api.GetApplicationsAsync()).ToList();
            _message = Culture["Employer.MatchedToast"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task DownloadCvAsync(Guid applicationId)
    {
        _busyId = applicationId;
        _message = null;
        _messageIsError = false;
        try
        {
            await Api.DownloadApplicationLobsyCvPdfAsync(applicationId, Js);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busyId = null;
        }
    }

    private async Task DownloadUploadedCvAsync(Guid applicationId)
    {
        _busyId = applicationId;
        _message = null;
        _messageIsError = false;
        try
        {
            await Api.DownloadApplicationUploadedCvAsync(applicationId, Js);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busyId = null;
        }
    }
}
