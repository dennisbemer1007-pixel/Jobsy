@page "/branch/vacancies/new"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,EnterpriseManager,Intermediary")]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules

<PageTitle>@(_isDuplicate ? "Vacature dupliceren" : "Vacature plaatsen") · Lobsy</PageTitle>

<div class="panel-page vacancy-editor">
    <header class="panel-header">
        <div>
            <h1>@(_isDuplicate ? "Vacature dupliceren" : "Vacature plaatsen")</h1>
            <p class="login-lead">
                @if (_isDuplicate)
                {
                    <text>Gegevens zijn overgenomen uit de bronvacature. Pas aan waar nodig en sla op als concept — publiceren via de vacaturelijst.</text>
                }
                else
                {
                    <text>Rich text, media en salaristabel. Opslaan als concept — publiceren via de vacaturelijst.</text>
                }
            </p>
        </div>
    </header>

    <div class="vacancy-editor__grid">
        <form class="login-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            @if (_companies.Count > 1)
            {
                <label>
                    Vestiging
                    <select @bind="_companyId" @bind:after="LoadSalaryTablesAsync">
                        @foreach (var c in _companies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </label>
            }
            <label>
                Titel
                <input @bind="_title" @bind:event="oninput" required />
            </label>
                <label>
                    Omschrijving
                    <div class="richtext-toolbar" role="toolbar" aria-label="Opmaak">
                        <div class="richtext-toolbar__group">
                            <button type="button" class="richtext-btn" title="Vet" aria-label="Vet"
                                    @onclick='() => FormatAsync("b")'><span aria-hidden="true">B</span></button>
                            <button type="button" class="richtext-btn richtext-btn--italic" title="Cursief" aria-label="Cursief"
                                    @onclick='() => FormatAsync("i")'><span aria-hidden="true">I</span></button>
                            <button type="button" class="richtext-btn richtext-btn--underline" title="Onderstrepen" aria-label="Onderstrepen"
                                    @onclick='() => FormatAsync("u")'><span aria-hidden="true">U</span></button>
                        </div>
                        <span class="richtext-toolbar__sep" aria-hidden="true"></span>
                        <div class="richtext-toolbar__group">
                            <button type="button" class="richtext-btn @(_align == "left" ? "is-active" : null)" title="Links uitlijnen" aria-label="Links uitlijnen"
                                    @onclick='() => AlignAsync("left")'>
                                @((MarkupString)AlignLeftSvg)
                            </button>
                            <button type="button" class="richtext-btn @(_align == "center" ? "is-active" : null)" title="Centreren" aria-label="Centreren"
                                    @onclick='() => AlignAsync("center")'>
                                @((MarkupString)AlignCenterSvg)
                            </button>
                            <button type="button" class="richtext-btn @(_align == "right" ? "is-active" : null)" title="Rechts uitlijnen" aria-label="Rechts uitlijnen"
                                    @onclick='() => AlignAsync("right")'>
                                @((MarkupString)AlignRightSvg)
                            </button>
                            <button type="button" class="richtext-btn @(_align == "justify" ? "is-active" : null)" title="Uitvullen" aria-label="Uitvullen"
                                    @onclick='() => AlignAsync("justify")'>
                                @((MarkupString)AlignJustifySvg)
                            </button>
                        </div>
                        <span class="richtext-toolbar__sep" aria-hidden="true"></span>
                        <div class="richtext-toolbar__group">
                            <button type="button" class="richtext-btn" title="Lijst" aria-label="Lijst"
                                    @onclick="InsertListAsync">
                                @((MarkupString)ListSvg)
                            </button>
                            <button type="button" class="richtext-btn" title="Link invoegen" aria-label="Link invoegen"
                                    @onclick="InsertLinkAsync">
                                @((MarkupString)LinkSvg)
                            </button>
                        </div>
                    </div>
                    <textarea @ref="_descriptionRef" rows="8" @bind="_description" @bind:event="oninput" required></textarea>
                </label>
                <label>
                    Afbeelding-URL
                    <input @bind="_imageUrl" @bind:event="oninput" placeholder="https://…" />
                </label>
                <label>
                    Video-URL
                    <input @bind="_videoUrl" @bind:event="oninput" placeholder="https://… (YouTube/Vimeo)" />
                </label>
            <label>
                Salaristabel
                <select @bind="_salaryTableId" @bind:after="OnSalaryTableChanged" required>
                    <option value="">— Kies een salaristabel —</option>
                    @foreach (var t in _salaryTables)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </label>
            @if (SelectedSalaryTable is not null)
            {
                <div class="salary-table-preview" aria-live="polite">
                    <p class="salary-table-preview__title">Voorbeeld · @SelectedSalaryTable.Name</p>
                    <table class="wage-table">
                        <thead>
                            <tr>
                                <th>Leeftijd</th>
                                <th>Uurloon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rate in SelectedSalaryTable.Rates.OrderBy(r => r.AgeYears))
                            {
                                <tr>
                                    <th>@rate.Label</th>
                                    <td>€ @rate.HourlyRate.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <label>
                Vervoer
                <select @bind="_transport">
                    <option value="Bike">Fiets</option>
                    <option value="Car">Auto</option>
                    <option value="PublicTransport">OV</option>
                    <option value="Bike,Car">Fiets + Auto</option>
                </select>
            </label>
            <fieldset class="profile-roles">
                <legend>Branche (max @WorkTypeLabels.MaxPerVacancy)</legend>
                @foreach (var label in WorkTypeLabels.All)
                {
                    var selected = _selectedWorkTypes.Contains(label);
                    var disabled = !selected && _selectedWorkTypes.Count >= WorkTypeLabels.MaxPerVacancy;
                    <label class="@(disabled ? "is-disabled" : null)">
                        <input type="checkbox"
                               checked="@selected"
                               disabled="@disabled"
                               @onchange="e => ToggleWorkType(label, e)" />
                        @label
                    </label>
                }
            </fieldset>
            <fieldset class="profile-roles">
                <legend>Vereist rijbewijs (optioneel)</legend>
                @foreach (var license in DrivingLicenseLabels.All)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_selectedLicenses.Contains(license)"
                               @onchange="e => ToggleLicense(license, e)" />
                        @license
                    </label>
                }
            </fieldset>
            <fieldset class="profile-roles">
                <legend>Vereist opleidingsniveau (optioneel)</legend>
                @foreach (var level in EducationLevelLabels.VacancyAll)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_selectedEducationLevels.Contains(level)"
                               @onchange="e => ToggleEducation(level, e)" />
                        @level
                    </label>
                }
            </fieldset>
            <fieldset class="profile-min-employers">
                <legend>Minimaal aantal werkgevers</legend>
                <div class="profile-min-employers__options" role="radiogroup" aria-label="Minimaal aantal werkgevers">
                    <label>
                        <input type="radio" name="min-employers" checked="@(_minimumEmployers is null)" @onchange="() => SetMinimumEmployers(null)" />
                        Geen
                    </label>
                    @foreach (var n in new[] { 1, 2, 3 })
                    {
                        <label>
                            <input type="radio" name="min-employers" checked="@(_minimumEmployers == n)" @onchange="() => SetMinimumEmployers(n)" />
                            @n
                        </label>
                    }
                </div>
            </fieldset>
            <button class="login-submit" type="submit" disabled="@_saving">
                @(_isDuplicate ? "Opslaan als nieuw concept" : "Opslaan als concept")
            </button>
        </form>

        <aside class="vacancy-preview" aria-label="Preview-tegel">
            <h2>Preview</h2>
            <article class="vacancy-card vacancy-card--preview">
                @if (SafeImageUrl is not null)
                {
                    <div class="vacancy-card-top" style="@($"background-image:url('{SafeImageUrl}')")"></div>
                }
                <h2>@(string.IsNullOrWhiteSpace(_title) ? "Titel…" : _title)</h2>
                <p class="muted">@SelectedCompanyName</p>
                <div class="vacancy-preview__body">@PreviewPlain</div>
                @if (SelectedSalaryTable is not null)
                {
                    var adult = SelectedSalaryTable.Rates
                        .OrderByDescending(r => r.AgeYears)
                        .FirstOrDefault();
                    if (adult is not null)
                    {
                        <p><strong>€ @adult.HourlyRate.ToString("0.00")</strong> / uur (@adult.Label)</p>
                    }
                    <p class="muted">Salaristabel: @SelectedSalaryTable.Name</p>
                }
                else
                {
                    <p class="muted">Kies een salaristabel</p>
                }
                @if (_selectedWorkTypes.Count > 0)
                {
                    <p class="muted">Branche: @string.Join(", ", _selectedWorkTypes)</p>
                }
                @if (!string.IsNullOrWhiteSpace(_videoUrl))
                {
                    <p class="muted">Video: @_videoUrl</p>
                }
            </article>
        </aside>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message error">@_message</p>
    }
</div>

@if (_moderationOpen)
{
    <div class="share-modal-backdrop" @onclick="CloseModeration"></div>
    <div class="share-modal moderation-modal" role="dialog" aria-modal="true" aria-labelledby="moderation-title">
        <div class="share-modal__header">
            <h2 id="moderation-title">Even aanpassen</h2>
            <button type="button" class="share-modal__close" @onclick="CloseModeration" aria-label="Sluiten">×</button>
        </div>
        <p class="share-modal__lead">We hebben de tekst bekeken voordat we opslaan.</p>
        <p class="moderation-modal__warning">@_moderationWarning</p>
        @if (!string.IsNullOrWhiteSpace(_moderationSuggestion))
        {
            <div class="moderation-modal__suggestion">
                <strong>Tip</strong>
                <p>@_moderationSuggestion</p>
            </div>
        }
        <div class="inline-actions" style="margin-top:1rem">
            <button type="button" class="login-submit" @onclick="CloseModeration">Tekst aanpassen</button>
        </div>
    </div>
}

@code {
    private const string AlignLeftSvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M2 3h12v1.2H2zm0 3h8v1.2H2zm0 3h12v1.2H2zm0 3h8v1.2H2z\"/></svg>";
    private const string AlignCenterSvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M2 3h12v1.2H2zm2 3h8v1.2H4zm-2 3h12v1.2H2zm2 3h8v1.2H4z\"/></svg>";
    private const string AlignRightSvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M2 3h12v1.2H2zm4 3h8v1.2H6zm-4 3h12v1.2H2zm4 3h8v1.2H6z\"/></svg>";
    private const string AlignJustifySvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M2 3h12v1.2H2zm0 3h12v1.2H2zm0 3h12v1.2H2zm0 3h12v1.2H2z\"/></svg>";
    private const string ListSvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"3\" cy=\"4\" r=\"1.1\"/><circle cx=\"3\" cy=\"8\" r=\"1.1\"/><circle cx=\"3\" cy=\"12\" r=\"1.1\"/><path d=\"M6 3.4h8v1.2H6zm0 4h8v1.2H6zm0 4h8v1.2H6z\"/></svg>";
    private const string LinkSvg =
        "<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6.5 9.5 9.5 6.5\"/><path d=\"M7.2 11.2 5.5 12.9a2.4 2.4 0 0 1-3.4-3.4L3.8 8\"/><path d=\"M8.8 4.8 10.5 3.1a2.4 2.4 0 0 1 3.4 3.4L12.2 8\"/></svg>";

    [SupplyParameterFromQuery(Name = "from")]
    public Guid? From { get; set; }

    private ElementReference _descriptionRef;
    private string _title = "";
    private string _description = "";
    private string _imageUrl = "";
    private string _videoUrl = "";
    private string _salaryTableId = "";
    private string _transport = "Bike";
    private int? _minimumEmployers;
    private string? _align;
    private HashSet<string> _selectedWorkTypes = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedLicenses = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedEducationLevels = new(StringComparer.OrdinalIgnoreCase);
    private bool _saving;
    private bool _isDuplicate;
    private string? _message;
    private bool _moderationOpen;
    private string? _moderationWarning;
    private string? _moderationSuggestion;
    private Guid _companyId;
    private List<CompanySummary> _companies = [];
    private List<SalaryTableItem> _salaryTables = [];

    private string SelectedCompanyName =>
        _companies.FirstOrDefault(c => c.Id == _companyId)?.Name ?? "Vestiging";

    private SalaryTableItem? SelectedSalaryTable =>
        Guid.TryParse(_salaryTableId, out var sid)
            ? _salaryTables.FirstOrDefault(t => t.Id == sid)
            : null;

    private string PreviewPlain =>
        string.IsNullOrWhiteSpace(_description)
            ? "Omschrijving…"
            : HtmlSanitize.ToPlainPreview(_description);

    private string? SafeImageUrl
    {
        get
        {
            var url = HtmlSanitize.NormalizeMediaUrl(_imageUrl);
            if (url is null)
            {
                return null;
            }

            // Prevent breaking out of CSS url('…')
            return url.Replace("'", "%27", StringComparison.Ordinal).Replace("\"", "%22", StringComparison.Ordinal);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _companies = (await Api.GetMyCompaniesAsync()).ToList();
        if (_companies.Count > 0)
        {
            _companyId = _companies[0].Id;
        }

        if (From is Guid sourceId)
        {
            await PrefillFromAsync(sourceId);
        }

        await LoadSalaryTablesAsync();
    }

    private async Task PrefillFromAsync(Guid sourceId)
    {
        try
        {
            var source = await Api.GetVacancyAsync(sourceId);
            if (source is null)
            {
                _message = "Bronvacature niet gevonden.";
                return;
            }

            if (_companies.All(c => c.Id != source.CompanyId))
            {
                _message = "Je hebt geen toegang tot de bronvacature.";
                return;
            }

            _isDuplicate = true;
            _companyId = source.CompanyId;
            _title = AppendCopySuffix(source.Title);
            _description = source.Description;
            _imageUrl = source.ImageUrl ?? "";
            _videoUrl = source.VideoUrl ?? "";
            _salaryTableId = source.SalaryTableId?.ToString() ?? "";
            _transport = MapTransportToFormValue(source.RequiredTransport);
            _selectedWorkTypes = source.WorkTypes.ToHashSet(StringComparer.OrdinalIgnoreCase);
            _selectedLicenses = DrivingLicenseLabels.Split(source.RequiredDrivingLicense)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _selectedEducationLevels = EducationLevelLabels.Split(source.RequiredEducation)
                .Where(x => EducationLevelLabels.VacancyAll.Contains(x, StringComparer.OrdinalIgnoreCase))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _minimumEmployers = source.MinimumEmployers is >= 1 and <= 3
                ? source.MinimumEmployers
                : null;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private static string AppendCopySuffix(string title)
    {
        const string suffix = " (kopie)";
        return title.EndsWith(suffix, StringComparison.OrdinalIgnoreCase)
            ? title
            : title + suffix;
    }

    private static string MapTransportToFormValue(string[] required)
    {
        static bool Has(string[] values, params string[] aliases) =>
            aliases.Any(a => values.Contains(a, StringComparer.OrdinalIgnoreCase));

        var hasBike = Has(required, TransportLabels.Bike, nameof(TransportMode.Bike));
        var hasCar = Has(required, TransportLabels.Car, nameof(TransportMode.Car));
        var hasOv = Has(required, TransportLabels.PublicTransport, nameof(TransportMode.PublicTransport));

        if (hasBike && hasCar)
        {
            return "Bike,Car";
        }

        if (hasCar)
        {
            return "Car";
        }

        if (hasOv)
        {
            return "PublicTransport";
        }

        return "Bike";
    }

    private void ToggleWorkType(string label, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (on)
        {
            if (_selectedWorkTypes.Count >= WorkTypeLabels.MaxPerVacancy && !_selectedWorkTypes.Contains(label))
            {
                return;
            }

            _selectedWorkTypes.Add(label);
        }
        else
        {
            _selectedWorkTypes.Remove(label);
        }
    }

    private void ToggleLicense(string license, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (on)
        {
            _selectedLicenses.Add(license);
        }
        else
        {
            _selectedLicenses.Remove(license);
        }
    }

    private void ToggleEducation(string level, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (on)
        {
            _selectedEducationLevels.Add(level);
        }
        else
        {
            _selectedEducationLevels.Remove(level);
        }
    }

    private void SetMinimumEmployers(int? value) => _minimumEmployers = value;

    private Task OnSalaryTableChanged() => Task.CompletedTask;

    private async Task LoadSalaryTablesAsync()
    {
        if (_companyId == Guid.Empty)
        {
            _salaryTables = [];
            return;
        }

        try
        {
            _salaryTables = (await Api.GetSalaryTablesAsync(_companyId)).Where(t => t.IsActive).ToList();
            if (string.IsNullOrWhiteSpace(_salaryTableId))
            {
                var wml = _salaryTables.FirstOrDefault(t => t.IsSystemWml)
                          ?? _salaryTables.FirstOrDefault(t =>
                              t.Name.Equals("Wettelijk Minimumloon", StringComparison.OrdinalIgnoreCase)
                              || t.Name.Equals("WML", StringComparison.OrdinalIgnoreCase));
                if (wml is not null)
                {
                    _salaryTableId = wml.Id.ToString();
                }
            }
            else if (_salaryTables.All(t => t.Id.ToString() != _salaryTableId))
            {
                var wml = _salaryTables.FirstOrDefault(t => t.IsSystemWml)
                          ?? _salaryTables.FirstOrDefault(t =>
                              t.Name.Equals("Wettelijk Minimumloon", StringComparison.OrdinalIgnoreCase)
                              || t.Name.Equals("WML", StringComparison.OrdinalIgnoreCase));
                _salaryTableId = wml?.Id.ToString() ?? _salaryTables.FirstOrDefault()?.Id.ToString() ?? "";
            }
        }
        catch
        {
            _salaryTables = [];
        }
    }

    private async Task FormatAsync(string tag)
    {
        var next = await Js.InvokeAsync<string?>("jobsyRichtext.wrap", _descriptionRef, $"<{tag}>", $"</{tag}>", "tekst");
        if (next is not null)
        {
            _description = next;
        }
    }

    private async Task AlignAsync(string align)
    {
        _align = align;
        var next = await Js.InvokeAsync<string?>(
            "jobsyRichtext.wrap",
            _descriptionRef,
            $"<p style=\"text-align:{align}\">",
            "</p>",
            "tekst");
        if (next is not null)
        {
            _description = next;
        }
    }

    private async Task InsertListAsync()
    {
        var next = await Js.InvokeAsync<string?>(
            "jobsyRichtext.wrap",
            _descriptionRef,
            "<ul>\n<li>",
            "</li>\n</ul>",
            "Punt");
        if (next is not null)
        {
            _description = next;
        }
    }

    private async Task InsertLinkAsync()
    {
        var next = await Js.InvokeAsync<string?>("jobsyRichtext.insertLink", _descriptionRef);
        if (next is not null)
        {
            _description = next;
        }
    }

    private void CloseModeration()
    {
        _moderationOpen = false;
    }

    private async Task SaveAsync()
    {
        if (_companyId == Guid.Empty)
        {
            _message = "Geen vestiging gekoppeld aan dit account.";
            return;
        }

        if (!Guid.TryParse(_salaryTableId, out var salaryTableId))
        {
            _message = "Kies een salaristabel.";
            return;
        }

        var table = _salaryTables.FirstOrDefault(t => t.Id == salaryTableId);
        if (table is null || table.Rates.Count == 0)
        {
            _message = "Geselecteerde salaristabel heeft geen tarieven.";
            return;
        }

        var adultRate = table.Rates
            .Where(r => r.AgeYears >= 21)
            .OrderBy(r => r.AgeYears)
            .FirstOrDefault()
            ?? table.Rates.OrderByDescending(r => r.AgeYears).First();

        var workTypes = WorkTypeLabels.Combine(_selectedWorkTypes);
        if (!WorkTypeLabels.IsValidSelection(workTypes))
        {
            _message = $"Kies 1 of {WorkTypeLabels.MaxPerVacancy} branches.";
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            var mode = _transport switch
            {
                "Car" => TransportMode.Car,
                "PublicTransport" => TransportMode.PublicTransport,
                "Bike,Car" => TransportMode.Bike | TransportMode.Car,
                _ => TransportMode.Bike
            };

            var today = DateOnly.FromDateTime(DateTime.Today);
            await Api.CreateVacancyAsync(new CreateVacancyForm(
                _companyId,
                _title,
                _description,
                adultRate.HourlyRate,
                today,
                today.AddMonths(3),
                mode,
                workTypes,
                string.IsNullOrWhiteSpace(_imageUrl) ? null : _imageUrl.Trim(),
                string.IsNullOrWhiteSpace(_videoUrl) ? null : _videoUrl.Trim(),
                salaryTableId,
                DrivingLicenseLabels.Combine(_selectedLicenses),
                EducationLevelLabels.Combine(_selectedEducationLevels, forVacancy: true),
                _minimumEmployers is >= 1 and <= 3 ? _minimumEmployers : null));

            Navigation.NavigateTo("/employer/vacancies");
        }
        catch (VacancyModerationException ex)
        {
            _moderationWarning = ex.Warning;
            _moderationSuggestion = ex.Suggestion;
            _moderationOpen = true;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
