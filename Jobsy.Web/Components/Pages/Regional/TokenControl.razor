@page "/regional/tokens"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RegionalManager,EnterpriseManager")]
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture

<PageTitle>Tokens & vacatures · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Centrale token- en vacaturecontrole</h1>
            <p class="login-lead">
                @if (_canAllocate)
                {
                    <text>Organisatiepot, uitgifte aan vestigingen en vacaturestatus.</text>
                }
                else
                {
                    <text>Alleen-lezen: token-saldo en vacaturestatus in jouw regio.</text>
                }
            </p>
        </div>
        <a class="auth-link" href="/employer/tokens">Tokenbeheer →</a>
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        @if (_pot is not null)
        {
            <div class="stat-grid">
                <div class="stat-card">
                    <span class="stat-card__label">Organisatiepot</span>
                    <strong class="stat-card__value">@_pot.Balance.ToString("0.##")</strong>
                </div>
            </div>
        }

        <section class="panel-section">
            <h2>Token-saldo per vestiging</h2>
            <div class="table-list">
                @foreach (var b in _balances)
                {
                    <div class="table-row">
                        <div>
                            <strong>@b.CompanyName</strong>
                            @if (b.ParentCompanyId is null && _hasOrgHierarchy)
                            {
                                <span class="muted"> · pot</span>
                            }
                            else if (b.TokensManagedByEnterprise)
                            {
                                <span class="muted"> · tokenbeheer bedrijfsmanager</span>
                            }
                        </div>
                        <span>@b.Balance.ToString("0.##") tokens</span>
                    </div>
                }
            </div>
        </section>

        @if (_canAllocate)
        {
            <section class="panel-section">
                <h2>Tokens uitgeven</h2>
                @if (_issueTargets.Count == 0)
                {
                    <p class="muted">Geen vestigingen aangevinkt. Stel tokenbeheer in via <a class="auth-link" href="/employer/tokens">Mijn tokens</a>.</p>
                }
                else
                {
                    <form class="login-form" style="max-width:420px" @onsubmit="IssueAsync" @onsubmit:preventDefault>
                        <label>
                            Vestiging
                            <select @bind="_toCompanyId">
                                @foreach (var b in _issueTargets)
                                {
                                    <option value="@b.CompanyId">@b.CompanyName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Aantal
                            <input type="number" min="0.5" step="0.5" @bind="_amount" />
                        </label>
                        <button class="login-submit" type="submit" disabled="@(_busy || _pot is null)">Uitgeven</button>
                    </form>
                }
            </section>
        }

        <section class="panel-section">
            <h2>Vacatures</h2>
            <div class="table-list">
                @foreach (var v in _vacancies)
                {
                    <div class="table-row">
                        <div>
                            <strong>@v.Title</strong>
                            <span class="muted">@v.CompanyName · @v.Status</span>
                        </div>
                        <span>€ @(v.HourlyWage?.ToString("0.00") ?? "—")</span>
                    </div>
                }
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    private List<TokenBalance> _balances = [];
    private List<VacancyListItem> _vacancies = [];
    private bool _loading = true;
    private bool _busy;
    private bool _canAllocate;
    private bool _hasOrgHierarchy;
    private Guid _toCompanyId;
    private decimal _amount = 1;
    private string? _message;
    private TokenBalance? _pot;
    private List<TokenBalance> _issueTargets = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            _canAllocate = state.User.IsInRole("EnterpriseManager") || state.User.IsInRole("Admin");
            await ReloadBalancesAsync();
            _vacancies = (await Api.GetManagedVacanciesAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadBalancesAsync()
    {
        _balances = (await Api.GetTokenBalancesAsync()).ToList();
        _hasOrgHierarchy = _balances.Any(b => b.ParentCompanyId is not null);
        _pot = _balances.FirstOrDefault(b => b.ParentCompanyId is null && _hasOrgHierarchy)
            ?? _balances.FirstOrDefault(b => b.ParentCompanyId is null);
        _issueTargets = _balances
            .Where(b => b.ParentCompanyId is not null && b.TokensManagedByEnterprise)
            .OrderBy(b => b.CompanyName)
            .ToList();
        if (_issueTargets.Count > 0
            && (_toCompanyId == Guid.Empty || _issueTargets.All(b => b.CompanyId != _toCompanyId)))
        {
            _toCompanyId = _issueTargets[0].CompanyId;
        }
    }

    private async Task IssueAsync()
    {
        if (!_canAllocate || _pot is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await Api.AllocateTokensAsync(_pot.CompanyId, _toCompanyId, _amount, "Uitgifte uit organisatiopot");
            await ReloadBalancesAsync();
            _message = "Tokens uitgegeven.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
