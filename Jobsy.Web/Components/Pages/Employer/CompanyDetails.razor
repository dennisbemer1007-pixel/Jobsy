@page "/employer/company"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "EnterpriseManager,Admin")]
@inject JobsyApiClient Api

<PageTitle>Bedrijfsgegevens · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Bedrijfsgegevens</h1>
            <p class="login-lead">Organisatiegegevens, bereikbaarheid, CSV-import en externe API-koppeling.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">Laden…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_organizations.Count == 0)
    {
        <p class="state-message">Geen organisatie gevonden.</p>
    }
    else
    {
        @if (_organizations.Count > 1)
        {
            <label class="filter-required" style="max-width:24rem;display:block;margin-bottom:1rem">
                Organisatie / vestiging
                <select @bind="_selectedOrgId" @bind:after="OnOrgChangedAsync">
                    @foreach (var org in _organizations)
                    {
                        <option value="@org.Id">@(org.ParentCompanyId is null ? org.Name : $"{org.Name} (vestiging)")</option>
                    }
                </select>
            </label>
        }

        @if (_org is not null)
        {
            <section class="panel-section">
                <h2>@_org.Name</h2>
                <p class="muted">@_org.Address · KVK @_org.KvkNumber</p>
                <p class="muted">@_org.TokenBalance.ToString("0.##") tokens · @_org.ActiveVacancies actieve vacatures</p>
            </section>

            <section class="panel-section">
                <h2>Voorkeur voor contact</h2>
                <p class="muted">
                    Geef aan of kandidaten na een succesvolle sollicitatie direct contact mogen opnemen
                    (mail, telefoon of WhatsApp). Per vacature kun je dit later overschrijven.
                    WhatsApp en telefoon worden nooit op de openbare vacaturepagina getoond.
                </p>
                <label class="checkbox-row">
                    <input type="checkbox"
                           checked="@_directContactEnabled"
                           disabled="@_busy"
                           @onchange="OnDirectContactToggle" />
                    Direct contact gewenst (WhatsApp / Telefoon / Mail)
                </label>
                @if (_directContactEnabled)
                {
                    <div class="contact-pref-channels" style="margin-top:0.75rem;display:grid;gap:0.5rem">
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_preferMail" disabled="@_busy" />
                            Mail
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_preferPhone" disabled="@_busy" />
                            Telefoon
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_preferWhatsApp" disabled="@_busy" />
                            WhatsApp
                        </label>
                    </div>
                    <div class="login-form" style="margin-top:0.75rem;max-width:28rem">
                        <label>
                            Contact-e-mail
                            <input type="email" @bind="_contactEmail" disabled="@(_busy || !_preferMail)" />
                        </label>
                        <label>
                            Telefoonnummer
                            <input type="tel" @bind="_contactPhone" disabled="@(_busy || (!_preferPhone && !_preferWhatsApp))" />
                        </label>
                        <label>
                            WhatsApp-nummer
                            <input type="tel"
                                   @bind="_contactWhatsApp"
                                   placeholder="Optioneel — anders telefoonnummer"
                                   disabled="@(_busy || !_preferWhatsApp)" />
                        </label>
                    </div>
                }
                <div class="inline-actions" style="margin-top:0.75rem">
                    <button class="login-submit" type="button" disabled="@_busy" @onclick="SaveContactPreferenceAsync">
                        Contactvoorkeur opslaan
                    </button>
                </div>
            </section>

            @if (_org.ParentCompanyId is null)
            {
            <section class="panel-section">
                <h2>CSV Batch Import</h2>
                <p class="muted">
                    Schakel batch-import van vacatures via CSV in. Vacatures komen binnen als concept;
                    publiceren (en tokenverbruik) gebeurt daarna in Lobsy — net als bij de API.
                </p>
                <label class="checkbox-row">
                    <input type="checkbox"
                           checked="@_org.CsvBatchImportEnabled"
                           disabled="@_busy"
                           @onchange="OnCsvToggleAsync" />
                    CSV Batch Import inschakelen
                </label>
                @if (_org.CsvBatchImportEnabled)
                {
                    <p class="muted" style="margin-top:0.5rem">
                        Navigatie toont nu de tab <a href="/employer/csv-import">CSV Import</a>.
                    </p>
                }
            </section>

            <section class="panel-section">
                <h2>API-koppeling</h2>
                <p class="muted">
                    Externe systemen kunnen vacatures aanmaken, wijzigen en status opvragen via
                    <code>X-API-Key</code> op <code>/api/external/vacancies</code>.
                    Nieuwe vacatures blijven concept tot je ze in Lobsy publiceert (tokenverwerking).
                    De volledige sleutel wordt nooit opgeslagen — alleen een hash.
                </p>

                @if (_activeKey is null)
                {
                    <div class="inline-actions">
                        <button class="login-submit" type="button" disabled="@_busy" @onclick="GenerateAsync">
                            API Key genereren
                        </button>
                        <button class="btn-compact" type="button" disabled="@_busy" @onclick="EmailCredentialsAsync">
                            Verzend credentials via e-mail
                        </button>
                    </div>
                    <p class="muted" style="margin-top:0.5rem">
                        E-mail genereert een nieuwe key en stuurt die naar jouw account-e-mail.
                    </p>
                }
                else
                {
                    <div class="table-list" style="margin-bottom:1rem">
                        <div class="table-row">
                            <div>
                                <strong>@_activeKey.Name</strong>
                                <span class="muted">
                                    @_activeKey.KeyPrefix
                                    · actief
                                    · aangemaakt @_activeKey.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                    @if (_activeKey.LastUsedAt is DateTime used)
                                    {
                                        <text> · laatst gebruikt @used.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</text>
                                    }
                                    else
                                    {
                                        <text> · nog niet gebruikt</text>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="inline-actions">
                        <button class="btn-compact" type="button" disabled="@_busy" @onclick="DeactivateAsync">
                            Desactiveren
                        </button>
                        <button class="btn-compact" type="button" disabled="@_busy" @onclick="GenerateAsync">
                            Nieuwe key genereren
                        </button>
                        <button class="btn-compact btn-compact--primary" type="button" disabled="@_busy" @onclick="ConfirmEmailAsync">
                            Verzend credentials via e-mail
                        </button>
                    </div>
                    <p class="muted" style="margin-top:0.5rem">
                        Let op: e-mailen of opnieuw genereren deactiveert de huidige key en maakt een nieuwe.
                    </p>
                }

                @if (_inactiveKeys.Count > 0)
                {
                    <h3 style="margin-top:1.5rem">Eerdere keys</h3>
                    <div class="table-list">
                        @foreach (var k in _inactiveKeys)
                        {
                            <div class="table-row">
                                <div>
                                    <strong>@k.Name</strong>
                                    <span class="muted">
                                        @k.KeyPrefix · inactief · @k.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
            }

            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="state-message">@_message</p>
            }
        }
    }
</div>

@if (_showKeyModal && _generated is not null)
{
    <div class="share-modal-backdrop" @onclick="CloseKeyModal"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="api-key-modal-title">
        <div class="share-modal__header">
            <h2 id="api-key-modal-title">API-key gegenereerd</h2>
            <button type="button" class="share-modal__close" @onclick="CloseKeyModal" aria-label="Sluiten">×</button>
        </div>
        <p class="share-modal__lead">
            <strong>Let op:</strong> deze sleutel is slechts één keer zichtbaar. Kopieer en bewaar hem veilig.
            Gebruik daarna niet “Verzend via e-mail” — dat maakt een andere key aan.
        </p>
        <label>
            API-key
            <input type="text" readonly value="@_generated.PlaintextKey" onclick="this.select()" style="font-family:monospace" />
        </label>
        <p class="muted">Header: <code>X-API-Key: …</code> · prefix @_generated.KeyPrefix</p>
        <div class="inline-actions" style="margin-top:1rem">
            <button class="login-submit" type="button" @onclick="CloseKeyModal">Ik heb de key bewaard</button>
        </div>
    </div>
}

@if (_confirmEmail)
{
    <div class="share-modal-backdrop" @onclick="CancelEmail"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="api-email-modal-title">
        <div class="share-modal__header">
            <h2 id="api-email-modal-title">Credentials e-mailen?</h2>
            <button type="button" class="share-modal__close" @onclick="CancelEmail" aria-label="Sluiten">×</button>
        </div>
        <p class="share-modal__lead">
            Dit deactiveert de huidige API-key en stuurt een <strong>nieuwe</strong> key naar jouw account-e-mail.
            De oude key werkt daarna niet meer.
        </p>
        <div class="inline-actions" style="margin-top:1rem">
            <button class="login-submit" type="button" disabled="@_busy" @onclick="EmailCredentialsAsync">Bevestigen</button>
            <button class="btn-compact" type="button" disabled="@_busy" @onclick="CancelEmail">Annuleren</button>
        </div>
    </div>
}

@code {
    private List<CompanySummary> _organizations = [];
    private CompanySummary? _org;
    private string _selectedOrgId = "";
    private List<CompanyApiKeyItem> _keys = [];
    private CompanyApiKeyItem? _activeKey;
    private List<CompanyApiKeyItem> _inactiveKeys = [];
    private GeneratedApiKeyItem? _generated;
    private bool _showKeyModal;
    private bool _confirmEmail;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private bool _directContactEnabled;
    private bool _preferMail;
    private bool _preferPhone;
    private bool _preferWhatsApp;
    private string _contactEmail = "";
    private string _contactPhone = "";
    private string _contactWhatsApp = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var companies = await Api.GetMyCompaniesAsync();
            // Prefer organisations; fall back to all companies so vestigingen can set contact prefs too.
            _organizations = companies
                .Where(c => c.ParentCompanyId is null)
                .OrderBy(c => c.Name)
                .ToList();
            if (_organizations.Count == 0)
            {
                _organizations = companies.OrderBy(c => c.Name).ToList();
            }
            else
            {
                // Also include vestigingen so contact prefs can be set per vestiging.
                var extras = companies
                    .Where(c => c.ParentCompanyId is not null)
                    .OrderBy(c => c.Name);
                _organizations = _organizations.Concat(extras).ToList();
            }

            if (_organizations.Count == 0)
            {
                _org = null;
                return;
            }

            if (string.IsNullOrEmpty(_selectedOrgId)
                || !_organizations.Any(o => o.Id.ToString() == _selectedOrgId))
            {
                _selectedOrgId = _organizations[0].Id.ToString();
            }

            await LoadKeysForSelectedAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnOrgChangedAsync() => await LoadKeysForSelectedAsync();

    private async Task LoadKeysForSelectedAsync()
    {
        _org = _organizations.FirstOrDefault(o => o.Id.ToString() == _selectedOrgId);
        if (_org is null)
        {
            return;
        }

        SyncContactFormFromOrg();
        _keys = [];
        _activeKey = null;
        _inactiveKeys = [];
        if (_org.ParentCompanyId is null)
        {
            _keys = (await Api.GetCompanyApiKeysAsync(_org.Id)).ToList();
            _activeKey = _keys.FirstOrDefault(k => k.IsActive);
            _inactiveKeys = _keys.Where(k => !k.IsActive).ToList();
        }
    }

    private void SyncContactFormFromOrg()
    {
        if (_org is null)
        {
            return;
        }

        _directContactEnabled = _org.DirectContactEnabled;
        _preferMail = _org.ContactPreferMail;
        _preferPhone = _org.ContactPreferPhone;
        _preferWhatsApp = _org.ContactPreferWhatsApp;
        _contactEmail = _org.ContactEmail ?? "";
        _contactPhone = _org.ContactPhone ?? "";
        _contactWhatsApp = _org.ContactWhatsApp ?? "";
    }

    private void OnDirectContactToggle(ChangeEventArgs e)
    {
        _directContactEnabled = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (!_directContactEnabled)
        {
            _preferMail = false;
            _preferPhone = false;
            _preferWhatsApp = false;
        }
    }

    private async Task SaveContactPreferenceAsync()
    {
        if (_org is null || _busy)
        {
            return;
        }

        if (_directContactEnabled && !_preferMail && !_preferPhone && !_preferWhatsApp)
        {
            _message = "Kies minstens één contactoptie (Mail, Telefoon of WhatsApp).";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var updated = await Api.UpdateContactPreferenceAsync(
                _org.Id,
                _directContactEnabled,
                _preferMail,
                _preferPhone,
                _preferWhatsApp,
                string.IsNullOrWhiteSpace(_contactEmail) ? null : _contactEmail.Trim(),
                string.IsNullOrWhiteSpace(_contactPhone) ? null : _contactPhone.Trim(),
                string.IsNullOrWhiteSpace(_contactWhatsApp) ? null : _contactWhatsApp.Trim());
            if (updated is not null)
            {
                ApplyContactToLocal(updated);
                _message = "Contactvoorkeur opgeslagen.";
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyContactToLocal(CompanySummary updated)
    {
        if (_org is null)
        {
            return;
        }

        _org.DirectContactEnabled = updated.DirectContactEnabled;
        _org.ContactPreferMail = updated.ContactPreferMail;
        _org.ContactPreferPhone = updated.ContactPreferPhone;
        _org.ContactPreferWhatsApp = updated.ContactPreferWhatsApp;
        _org.ContactEmail = updated.ContactEmail;
        _org.ContactPhone = updated.ContactPhone;
        _org.ContactWhatsApp = updated.ContactWhatsApp;
        var idx = _organizations.FindIndex(o => o.Id == _org.Id);
        if (idx >= 0)
        {
            _organizations[idx] = _org;
        }

        SyncContactFormFromOrg();
    }

    private async Task GenerateAsync()
    {
        if (_org is null || _busy || _org.ParentCompanyId is not null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            _generated = await Api.GenerateCompanyApiKeyAsync(_org.Id);
            _showKeyModal = _generated is not null;
            await LoadKeysForSelectedAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync()
    {
        if (_org is null || _activeKey is null || _busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await Api.DeactivateCompanyApiKeyAsync(_org.Id, _activeKey.Id);
            _message = "API-key gedeactiveerd.";
            await LoadKeysForSelectedAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmEmailAsync() => _confirmEmail = true;

    private void CancelEmail() => _confirmEmail = false;

    private async Task EmailCredentialsAsync()
    {
        if (_org is null || _busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _confirmEmail = false;
        try
        {
            var result = await Api.EmailCompanyApiKeyCredentialsAsync(_org.Id);
            _message = result is null
                ? "Credentials verzonden."
                : $"Nieuwe API-key verzonden naar {result.RecipientEmail} (prefix {result.KeyPrefix}). De vorige key is gedeactiveerd.";
            await LoadKeysForSelectedAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnCsvToggleAsync(ChangeEventArgs e)
    {
        if (_org is null || _busy)
        {
            return;
        }

        var enabled = e.Value is bool b && b || e.Value?.ToString() == "on";
        _busy = true;
        _message = null;
        try
        {
            var updated = await Api.UpdateCsvBatchImportAsync(_org.Id, enabled);
            if (updated is not null)
            {
                _org.CsvBatchImportEnabled = updated.CsvBatchImportEnabled;
                var idx = _organizations.FindIndex(o => o.Id == _org.Id);
                if (idx >= 0)
                {
                    _organizations[idx].CsvBatchImportEnabled = updated.CsvBatchImportEnabled;
                }
            }

            _message = enabled
                ? "CSV Batch Import is ingeschakeld. De tab CSV Import verschijnt in het menu."
                : "CSV Batch Import is uitgeschakeld.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseKeyModal()
    {
        _showKeyModal = false;
        _generated = null;
    }
}
