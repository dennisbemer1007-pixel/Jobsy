@page "/employer/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "EnterpriseManager,Admin")]
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api

<PageTitle>Gebruikers · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Gebruikers</h1>
            <p class="login-lead">Uitnodigen, bewerken en rollen toekennen binnen jouw organisatie.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">Laden…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var u in _users)
            {
                <div class="table-row">
                    <div>
                        <strong>@u.FullName</strong>
                        <span class="muted">
                            @u.Email · @RoleLabel(u.Role) · @(u.CompanyName ?? "—")
                            @if (!u.IsActive)
                            {
                                <text> · inactief</text>
                            }
                        </span>
                    </div>
                    <div class="table-row__actions">
                        <button type="button" class="icon-btn" title="Bewerken" aria-label="Gebruiker bewerken" disabled="@_busy" @onclick="() => StartEdit(u)">
                            @((MarkupString)ActionIcons.Edit)
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (_editing is not null)
        {
            <section class="panel-section">
                <h2>Gebruiker bewerken</h2>
                <p class="muted">@_editing.Email</p>
                <form class="login-form" style="max-width:480px" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                    <label>
                        Naam
                        <input @bind="_editFullName" required />
                    </label>
                    <label>
                        Rol
                        <select @bind="_editRole">
                            <option value="EnterpriseManager">Bedrijfsmanager</option>
                            <option value="RegionalManager">Regiomanager</option>
                            <option value="BranchManager">Vestigingsmanager</option>
                            <option value="Intermediary">Intermediair</option>
                        </select>
                    </label>
                    <label>
                        Primaire vestiging
                        <select @bind="_editPrimaryCompanyId">
                            <option value="">— Geen —</option>
                            @foreach (var c in _companies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </label>
                    <fieldset class="profile-roles profile-roles--wide">
                        <legend>Extra lidmaatschappen</legend>
                        @foreach (var c in _companies)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@_editMemberships.Contains(c.Id)"
                                       @onchange="e => ToggleEditMembership(c.Id, (bool)(e.Value ?? false))" />
                                @c.Name
                            </label>
                        }
                    </fieldset>
                    <label class="publish-option">
                        <input type="checkbox" @bind="_editIsActive" />
                        <span>Actief</span>
                    </label>
                    <div class="inline-actions">
                        <button class="login-submit" type="submit" disabled="@_busy">Opslaan</button>
                        <button class="btn-compact" type="button" disabled="@_busy" @onclick="CancelEdit">Annuleren</button>
                    </div>
                </form>
            </section>
        }

        <section class="panel-section">
            <h2>Uitnodigen</h2>
            <form class="login-form" style="max-width:480px" @onsubmit="InviteAsync" @onsubmit:preventDefault>
                <label>
                    E-mail
                    <input type="email" @bind="_email" required />
                </label>
                <label>
                    Naam
                    <input @bind="_fullName" required />
                </label>
                <label>
                    Rol
                    <select @bind="_role">
                        <option value="EnterpriseManager">Bedrijfsmanager</option>
                        <option value="RegionalManager">Regiomanager</option>
                        <option value="BranchManager">Vestigingsmanager</option>
                        <option value="Intermediary">Intermediair</option>
                    </select>
                </label>
                <label>
                    Primaire vestiging
                    <select @bind="_primaryCompanyId">
                        <option value="">— Geen —</option>
                        @foreach (var c in _companies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </label>
                <fieldset class="profile-roles profile-roles--wide">
                    <legend>Extra lidmaatschappen</legend>
                    @foreach (var c in _companies)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@_memberships.Contains(c.Id)"
                                   @onchange="e => ToggleMembership(c.Id, (bool)(e.Value ?? false))" />
                            @c.Name
                        </label>
                    }
                </fieldset>
                <button class="login-submit" type="submit" disabled="@_busy">Uitnodigen</button>
            </form>
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    private List<CompanyUserItem> _users = [];
    private List<CompanySummary> _companies = [];
    private HashSet<Guid> _memberships = [];
    private HashSet<Guid> _editMemberships = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _email = "";
    private string _fullName = "";
    private string _role = "BranchManager";
    private string _primaryCompanyId = "";

    private CompanyUserItem? _editing;
    private string _editFullName = "";
    private string _editRole = "BranchManager";
    private string _editPrimaryCompanyId = "";
    private bool _editIsActive = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companies = (await Api.GetMyCompaniesAsync()).ToList();
            _users = (await Api.GetCompanyUsersAsync()).ToList();
            if (_companies.Count > 0)
            {
                _primaryCompanyId = _companies[0].Id.ToString();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(CompanyUserItem user)
    {
        _editing = user;
        _editFullName = user.FullName;
        _editRole = user.Role;
        _editPrimaryCompanyId = user.CompanyId?.ToString() ?? "";
        _editIsActive = user.IsActive;
        _editMemberships = user.MembershipCompanyIds.ToHashSet();
        _message = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editMemberships = [];
    }

    private void ToggleMembership(Guid id, bool selected)
    {
        if (selected)
        {
            _memberships.Add(id);
        }
        else
        {
            _memberships.Remove(id);
        }
    }

    private void ToggleEditMembership(Guid id, bool selected)
    {
        if (selected)
        {
            _editMemberships.Add(id);
        }
        else
        {
            _editMemberships.Remove(id);
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            Guid? primary = Guid.TryParse(_editPrimaryCompanyId, out var pid) ? pid : null;
            await Api.UpdateCompanyUserAsync(_editing.Id, new UpdateCompanyUserForm(
                _editFullName,
                _editRole,
                primary,
                _editMemberships.ToArray(),
                _editIsActive));
            _users = (await Api.GetCompanyUsersAsync()).ToList();
            CancelEdit();
            _message = "Gebruiker opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InviteAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            Guid? primary = Guid.TryParse(_primaryCompanyId, out var pid) ? pid : null;
            await Api.InviteCompanyUserAsync(new InviteUserForm(
                _email,
                _fullName,
                _role,
                primary,
                _memberships.ToArray()));
            _users = (await Api.GetCompanyUsersAsync()).ToList();
            _email = "";
            _fullName = "";
            _memberships = [];
            _message = "Uitnodiging verstuurd met inloglink en tijdelijk wachtwoord (stub e-mail).";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string RoleLabel(string role) => role switch
    {
        "EnterpriseManager" => "Bedrijfsmanager",
        "RegionalManager" => "Regiomanager",
        "BranchManager" => "Vestigingsmanager",
        "Intermediary" => "Intermediair",
        _ => role
    };
}
