@page "/employer/vacancies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Employer.VacanciesTitle"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Employer.VacanciesTitle"]</h1>
            <p class="login-lead">
                @(_canManageVacancy ? Culture["Employer.VacanciesLeadManage"] : Culture["Employer.VacanciesLeadRead"])
            </p>
        </div>
        @if (_canManageVacancy)
        {
            <a class="login-submit" href="/branch/vacancies/new" style="text-decoration:none;display:inline-flex;align-items:center;">@Culture["Employer.NewVacancy"]</a>
        }
    </header>

    <div class="employer-search filter-bar">
        @if (_salaryTableFilter is not null)
        {
            <p class="muted" style="grid-column:1/-1;margin:0">
                @Culture["Employer.SalaryTableFilter"]@(string.IsNullOrWhiteSpace(_salaryTableFilterName) ? "" : $": {_salaryTableFilterName}")
                · <button type="button" class="auth-link" style="border:none;background:none;padding:0;cursor:pointer" @onclick="ClearSalaryTableFilter">@Culture["Employer.ClearFilter"]</button>
            </p>
        }
        <label class="filter-required">
            @Culture["Employer.JobType"]
            <select @bind="_workTypeFilter" @bind:after="ApplyFilters">
                <option value="">@Culture["Employer.AllSectors"]</option>
                @foreach (var label in _branchOptions)
                {
                    <option value="@label">@UiLabels.WorkType(Culture, label)</option>
                }
            </select>
        </label>
        <label class="filter-required">
            @Culture["Employer.WageByAge"]
            <select @bind="_ageFilter" @bind:after="ApplyFilters">
                <option value="">@Culture["Employer.AllAges"]</option>
                @for (var age = 15; age <= 21; age++)
                {
                    <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                }
            </select>
        </label>
        @if (!string.IsNullOrEmpty(_ageFilter))
        {
            <label>
                @Culture["Employer.MinWage"]
                <input type="number" min="0" step="0.50" @bind="_minWage" @bind:after="ApplyFilters" />
            </label>
            <label>
                @Culture["Employer.MaxWage"]
                <input type="number" min="0" step="0.50" @bind="_maxWage" @bind:after="ApplyFilters" />
            </label>
        }
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_filtered.Count == 0)
    {
        <p class="state-message">@Culture["Discovery.NoneWithoutOrigin"]</p>
    }
    else
    {
        <div class="table-list vacancy-manage-list">
            @foreach (var v in _filtered)
            {
                <div class="table-row vacancy-manage-row">
                    <div class="vacancy-manage-row__main">
                        <strong class="vacancy-manage-row__title">@v.Title</strong>
                        <span class="muted">
                            @v.CompanyName · @v.Status
                            · <span class="source-badge source-badge--@VacancySourceDisplay.CssModifier(v.CreatedVia)">@VacancySourceDisplay.Label(v.CreatedVia)</span>
                            @if (v.WorkTypes.Length > 0)
                            {
                                <text> · @string.Join(", ", v.WorkTypes)</text>
                            }
                            @if (v.IsHighlighted)
                            {
                                <text> · highlight</text>
                            }
                            @if (v.ExtensionCount > 0)
                            {
                                <text> · @v.ExtensionCount× verlengd</text>
                            }
                            · getoond @v.ImpressionCount · clicks @v.ClickCount · sollicitaties @v.ApplicationCount
                            · € @(v.HourlyWage?.ToString("0.00") ?? "—")
                        </span>
                    </div>
                    <div class="table-row__actions vacancy-manage-row__actions">
                            <a class="icon-btn" href="@($"/vacancies/{v.Id}")" title="Bekijken" aria-label="Vacature bekijken">
                                @((MarkupString)ActionIcons.View)
                            </a>
                            @if (_canManageVacancy)
                            {
                                <button class="btn-compact" type="button" title="Contactvoorkeur" @onclick="() => OpenContactPref(v)">
                                    Contact
                                </button>
                                <a class="icon-btn" href="@($"/branch/vacancies/new?from={v.Id}")" title="Dupliceren" aria-label="Vacature dupliceren">
                                    @((MarkupString)ActionIcons.Duplicate)
                                </a>
                            }
                        @if (_canManageVacancy && v.Status == "Draft")
                        {
                            <button class="btn-compact" type="button" @onclick="() => OpenPublish(v)">Publiceer…</button>
                        }
                        @if (v.Status == "PendingApproval" && _canApprovePublish)
                        {
                            <button class="btn-compact" type="button" @onclick="() => ApproveAsync(v.Id)">Goedkeuren</button>
                        }
                        @if (_canManageVacancy && v.Status == "Active")
                        {
                            @if (!v.IsHighlighted)
                            {
                                <button class="btn-compact" type="button" @onclick="() => HighlightAsync(v.Id)">Highlight</button>
                            }
                            <button class="icon-btn" type="button" title="PushBom" aria-label="PushBom versturen" @onclick="() => OpenPushBom(v)">
                                @((MarkupString)ActionIcons.Bomb)
                            </button>
                            <button class="btn-compact" type="button" @onclick="() => ExtendAsync(v.Id)">Verleng</button>
                            <button class="btn-compact" type="button" @onclick="() => DeactivateAsync(v.Id)">Inactive</button>
                        }
                        @if (_canManageVacancy && v.Status == "Archived")
                        {
                            <button class="btn-compact" type="button" @onclick="() => ExtendAsync(v.Id)">Heractiveer (+verlengen)</button>
                        }
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

<PublishOptionsDialog IsOpen="_publishOpen"
                      Vacancy="_publishVacancy"
                      OnClose="ClosePublish"
                      OnPublished="OnPublished" />

<PushBomConfirmDialog IsOpen="_pushBomOpen"
                      Vacancy="_pushBomVacancy"
                      OnClose="ClosePushBom"
                      OnConfirmed="OnPushBomConfirmed" />

@if (_contactOpen && _contactVacancy is not null)
{
    <div class="share-modal-backdrop" @onclick="CloseContactPref"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="contact-pref-title">
        <div class="share-modal__header">
            <h2 id="contact-pref-title">Voorkeur voor contact</h2>
            <button type="button" class="share-modal__close" @onclick="CloseContactPref" aria-label="Sluiten">×</button>
        </div>
        <p class="share-modal__lead">@_contactVacancy.Title</p>
        <p class="muted">Overschrijf de bedrijfsinstellingen voor deze vacature. Contactgegevens komen uit het bedrijfsprofiel.</p>
        <label class="checkbox-row">
            <input type="checkbox" @bind="_contactOverride" @bind:after="OnContactOverrideChanged" disabled="@_contactBusy" />
            Afwijkende contactvoorkeur voor deze vacature
        </label>
        @if (_contactOverride)
        {
            <label class="checkbox-row" style="margin-top:0.5rem">
                <input type="checkbox" @bind="_contactDirect" @bind:after="OnContactDirectChanged" disabled="@_contactBusy" />
                Direct contact gewenst (WhatsApp / Telefoon / Mail)
            </label>
            @if (_contactDirect)
            {
                <div style="margin-top:0.5rem;display:grid;gap:0.35rem">
                    <label class="checkbox-row">
                        <input type="checkbox" @bind="_contactMail" disabled="@_contactBusy" />
                        Mail
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" @bind="_contactPhone" disabled="@_contactBusy" />
                        Telefoon
                    </label>
                    <label class="checkbox-row">
                        <input type="checkbox" @bind="_contactWhatsApp" disabled="@_contactBusy" />
                        WhatsApp
                    </label>
                </div>
            }
        }
        @if (!string.IsNullOrEmpty(_contactError))
        {
            <p class="state-message error">@_contactError</p>
        }
        <div class="inline-actions" style="margin-top:1rem">
            <button type="button" class="login-submit" disabled="@_contactBusy" @onclick="SaveContactPrefAsync">Opslaan</button>
            <button type="button" class="btn-compact" disabled="@_contactBusy" @onclick="CloseContactPref">Annuleren</button>
        </div>
    </div>
}

@code {
    private List<VacancyListItem> _vacancies = [];
    private List<VacancyListItem> _filtered = [];
    private bool _loading = true;
    private bool _canApprovePublish;
    private bool _canManageVacancy;
    private string? _error;
    private string? _message;
    private bool _publishOpen;
    private VacancyListItem? _publishVacancy;
    private bool _pushBomOpen;
    private VacancyListItem? _pushBomVacancy;
    private bool _contactOpen;
    private VacancyListItem? _contactVacancy;
    private bool _contactBusy;
    private string? _contactError;
    private bool _contactOverride;
    private bool _contactDirect;
    private bool _contactMail;
    private bool _contactPhone;
    private bool _contactWhatsApp;
    private string _workTypeFilter = "";
    private List<string> _branchOptions = WorkTypeLabels.All.ToList();
    private string _ageFilter = "";
    private decimal? _minWage;
    private decimal? _maxWage;
    private Guid? _salaryTableFilter;
    private string? _salaryTableFilterName;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("salaryTableId", out var raw)
                && Guid.TryParse(raw, out var tableId))
            {
                _salaryTableFilter = tableId;
            }

            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _canApprovePublish = user.IsInRole("EnterpriseManager") || user.IsInRole("Admin");
            _canManageVacancy = user.IsInRole("BranchManager")
                || user.IsInRole("EnterpriseManager")
                || user.IsInRole("Intermediary")
                || user.IsInRole("Admin");
            try
            {
                var options = await Api.GetMasterdataAsync(MasterdataCategories.Branch);
                var branches = options.Select(o => o.Label).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
                if (branches.Count > 0)
                {
                    _branchOptions = branches;
                }
            }
            catch
            {
                // keep fallback
            }

            _vacancies = (await Api.GetManagedVacanciesAsync()).ToList();

            if (_salaryTableFilter is Guid tid)
            {
                try
                {
                    var table = await Api.GetSalaryTableAsync(tid);
                    _salaryTableFilterName = table?.Name;
                }
                catch
                {
                    _salaryTableFilterName = null;
                }
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<VacancyListItem> query = _vacancies;

        if (_salaryTableFilter is Guid tableId)
        {
            query = query.Where(v => v.SalaryTableId == tableId);
        }

        if (!string.IsNullOrWhiteSpace(_workTypeFilter))
        {
            query = query.Where(v => v.WorkTypes.Any(w =>
                string.Equals(w, _workTypeFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (int.TryParse(_ageFilter, out var age))
        {
            query = query.Where(v =>
            {
                var wage = ResolveWage(v, age);
                if (wage is null)
                {
                    return false;
                }

                if (_minWage is decimal min && wage < min)
                {
                    return false;
                }

                if (_maxWage is decimal max && wage > max)
                {
                    return false;
                }

                return true;
            });
        }

        _filtered = query.ToList();
    }

    private void ClearSalaryTableFilter()
    {
        _salaryTableFilter = null;
        _salaryTableFilterName = null;
        Navigation.NavigateTo("/employer/vacancies", replace: true);
        ApplyFilters();
    }

    private static decimal? ResolveWage(VacancyListItem v, int age)
    {
        if (v.HourlyWage is not null)
        {
            return v.HourlyWage;
        }

        if (v.WageByAge is { Count: > 0 })
        {
            return v.WageByAge
                .OrderBy(b => Math.Abs(b.AgeYears - age))
                .FirstOrDefault()?.HourlyRate;
        }

        return null;
    }

    private async Task RefreshAsync()
    {
        _vacancies = (await Api.GetManagedVacanciesAsync()).ToList();
        ApplyFilters();
    }

    private void OpenPublish(VacancyListItem vacancy)
    {
        _publishVacancy = vacancy;
        _publishOpen = true;
    }

    private Task ClosePublish()
    {
        _publishOpen = false;
        _publishVacancy = null;
        return Task.CompletedTask;
    }

    private async Task OnPublished(VacancyProductActionResult? result)
    {
        await RefreshAsync();
        _message = result?.PendingApproval == true
            ? (result.Message ?? "Wacht op goedkeuring (onvoldoende tokens).")
            : "Vacature gepubliceerd.";
    }

    private async Task ApproveAsync(Guid id)
    {
        try
        {
            await Api.ApprovePublishAsync(id);
            await RefreshAsync();
            _message = "Publicatie goedgekeurd.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task HighlightAsync(Guid id)
    {
        try
        {
            await Api.HighlightVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature gehighlight.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private void OpenPushBom(VacancyListItem vacancy)
    {
        _pushBomVacancy = vacancy;
        _pushBomOpen = true;
    }

    private Task ClosePushBom()
    {
        _pushBomOpen = false;
        _pushBomVacancy = null;
        return Task.CompletedTask;
    }

    private async Task OnPushBomConfirmed(VacancyProductActionResult? result)
    {
        await RefreshAsync();
        _message = $"PushBom verstuurd naar {result?.PushBomRecipientCount ?? 0} kandidaten (stub).";
    }

    private async Task ExtendAsync(Guid id)
    {
        try
        {
            await Api.ExtendVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature verlengd (+14 dagen).";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        try
        {
            await Api.DeactivateVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature inactief (gearchiveerd).";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task OpenContactPref(VacancyListItem vacancy)
    {
        _contactVacancy = vacancy;
        _contactError = null;
        _contactBusy = true;
        _contactOpen = true;
        try
        {
            var pref = await Api.GetVacancyContactPreferenceAsync(vacancy.Id);
            _contactOverride = pref?.OverrideContactPreference ?? false;
            _contactDirect = pref?.DirectContactEnabled ?? false;
            _contactMail = pref?.ContactPreferMail ?? false;
            _contactPhone = pref?.ContactPreferPhone ?? false;
            _contactWhatsApp = pref?.ContactPreferWhatsApp ?? false;
        }
        catch (Exception ex)
        {
            _contactError = ex.Message;
        }
        finally
        {
            _contactBusy = false;
        }
    }

    private void CloseContactPref()
    {
        _contactOpen = false;
        _contactVacancy = null;
        _contactError = null;
    }

    private void OnContactOverrideChanged()
    {
        if (!_contactOverride)
        {
            _contactDirect = false;
            _contactMail = false;
            _contactPhone = false;
            _contactWhatsApp = false;
        }
    }

    private void OnContactDirectChanged()
    {
        if (!_contactDirect)
        {
            _contactMail = false;
            _contactPhone = false;
            _contactWhatsApp = false;
        }
    }

    private async Task SaveContactPrefAsync()
    {
        if (_contactVacancy is null || _contactBusy)
        {
            return;
        }

        if (_contactOverride
            && _contactDirect
            && !_contactMail
            && !_contactPhone
            && !_contactWhatsApp)
        {
            _contactError = "Kies minstens één contactoptie (Mail, Telefoon of WhatsApp).";
            return;
        }

        _contactBusy = true;
        _contactError = null;
        try
        {
            await Api.UpdateVacancyContactPreferenceAsync(
                _contactVacancy.Id,
                _contactOverride,
                _contactDirect,
                _contactMail,
                _contactPhone,
                _contactWhatsApp);
            _message = "Contactvoorkeur voor vacature opgeslagen.";
            CloseContactPref();
        }
        catch (Exception ex)
        {
            _contactError = ex.Message;
        }
        finally
        {
            _contactBusy = false;
        }
    }
}
