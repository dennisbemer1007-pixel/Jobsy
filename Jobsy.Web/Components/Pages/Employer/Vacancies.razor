@page "/employer/vacancies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Rules
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Vacatures · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Vacatures</h1>
            <p class="login-lead">Beheer concepten en actieve vacatures. Publiceren via token-opties popup.</p>
        </div>
        <a class="login-submit" href="/branch/vacancies/new" style="text-decoration:none;display:inline-flex;align-items:center;">Nieuwe vacature</a>
    </header>

    <div class="employer-search filter-bar">
        @if (_salaryTableFilter is not null)
        {
            <p class="muted" style="grid-column:1/-1;margin:0">
                Gefilterd op salaristabel@(string.IsNullOrWhiteSpace(_salaryTableFilterName) ? "" : $": {_salaryTableFilterName}")
                · <button type="button" class="auth-link" style="border:none;background:none;padding:0;cursor:pointer" @onclick="ClearSalaryTableFilter">Filter wissen</button>
            </p>
        }
        <label class="filter-required">
            Type baan
            <select @bind="_workTypeFilter" @bind:after="ApplyFilters">
                <option value="">Alle branches</option>
                @foreach (var label in WorkTypeLabels.All)
                {
                    <option value="@label">@label</option>
                }
            </select>
        </label>
        <label class="filter-required">
            Uurloon (op basis van leeftijd)
            <select @bind="_ageFilter" @bind:after="ApplyFilters">
                <option value="">Alle leeftijden</option>
                @for (var age = 15; age <= 21; age++)
                {
                    <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                }
            </select>
        </label>
        @if (!string.IsNullOrEmpty(_ageFilter))
        {
            <label>
                Min. uurloon (€)
                <input type="number" min="0" step="0.50" @bind="_minWage" @bind:after="ApplyFilters" />
            </label>
            <label>
                Max. uurloon (€)
                <input type="number" min="0" step="0.50" @bind="_maxWage" @bind:after="ApplyFilters" />
            </label>
        }
    </div>

    @if (_loading)
    {
        <p class="state-message">Laden…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_filtered.Count == 0)
    {
        <p class="state-message">Geen vacatures voor deze filters.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var v in _filtered)
            {
                <div class="table-row">
                    <div>
                        <strong>@v.Title</strong>
                        <span class="muted">
                            @v.CompanyName · @v.Status
                            @if (v.WorkTypes.Length > 0)
                            {
                                <text> · @string.Join(", ", v.WorkTypes)</text>
                            }
                            @if (v.IsHighlighted)
                            {
                                <text> · highlight</text>
                            }
                            @if (v.ExtensionCount > 0)
                            {
                                <text> · @v.ExtensionCount× verlengd</text>
                            }
                            · getoond @v.ImpressionCount · clicks @v.ClickCount · sollicitaties @v.ApplicationCount
                            · € @(v.HourlyWage?.ToString("0.00") ?? "—")
                        </span>
                    </div>
                    <div class="table-row__actions">
                        <a class="auth-link" href="@($"/vacancies/{v.Id}")">Bekijk</a>
                        <a class="auth-link" href="@($"/branch/vacancies/new?from={v.Id}")">Dupliceren</a>
                        @if (v.Status == "Draft")
                        {
                            <button class="btn-compact" type="button" @onclick="() => OpenPublish(v)">Publiceer…</button>
                        }
                        @if (v.Status == "PendingApproval" && _canApprovePublish)
                        {
                            <button class="btn-compact" type="button" @onclick="() => ApproveAsync(v.Id)">Goedkeuren</button>
                        }
                        @if (v.Status == "Active")
                        {
                            @if (!v.IsHighlighted)
                            {
                                <button class="btn-compact" type="button" @onclick="() => HighlightAsync(v.Id)">Highlight</button>
                            }
                            <button class="btn-compact" type="button" @onclick="() => OpenPushBom(v)">PushBom…</button>
                            <button class="btn-compact" type="button" @onclick="() => ExtendAsync(v.Id)">Verleng</button>
                            <button class="btn-compact" type="button" @onclick="() => DeactivateAsync(v.Id)">Inactive</button>
                        }
                        @if (v.Status == "Archived")
                        {
                            <button class="btn-compact" type="button" @onclick="() => ExtendAsync(v.Id)">Heractiveer (+verlengen)</button>
                        }
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

<PublishOptionsDialog IsOpen="_publishOpen"
                      Vacancy="_publishVacancy"
                      OnClose="ClosePublish"
                      OnPublished="OnPublished" />

<PushBomConfirmDialog IsOpen="_pushBomOpen"
                      Vacancy="_pushBomVacancy"
                      OnClose="ClosePushBom"
                      OnConfirmed="OnPushBomConfirmed" />

@code {
    private List<VacancyListItem> _vacancies = [];
    private List<VacancyListItem> _filtered = [];
    private bool _loading = true;
    private bool _canApprovePublish;
    private string? _error;
    private string? _message;
    private bool _publishOpen;
    private VacancyListItem? _publishVacancy;
    private bool _pushBomOpen;
    private VacancyListItem? _pushBomVacancy;
    private string _workTypeFilter = "";
    private string _ageFilter = "";
    private decimal? _minWage;
    private decimal? _maxWage;
    private Guid? _salaryTableFilter;
    private string? _salaryTableFilterName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("salaryTableId", out var raw)
                && Guid.TryParse(raw, out var tableId))
            {
                _salaryTableFilter = tableId;
            }

            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _canApprovePublish = user.IsInRole("EnterpriseManager") || user.IsInRole("Admin");
            _vacancies = (await Api.GetManagedVacanciesAsync()).ToList();

            if (_salaryTableFilter is Guid tid)
            {
                try
                {
                    var table = await Api.GetSalaryTableAsync(tid);
                    _salaryTableFilterName = table?.Name;
                }
                catch
                {
                    _salaryTableFilterName = null;
                }
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<VacancyListItem> query = _vacancies;

        if (_salaryTableFilter is Guid tableId)
        {
            query = query.Where(v => v.SalaryTableId == tableId);
        }

        if (!string.IsNullOrWhiteSpace(_workTypeFilter))
        {
            query = query.Where(v => v.WorkTypes.Any(w =>
                string.Equals(w, _workTypeFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (int.TryParse(_ageFilter, out var age))
        {
            query = query.Where(v =>
            {
                var wage = ResolveWage(v, age);
                if (wage is null)
                {
                    return false;
                }

                if (_minWage is decimal min && wage < min)
                {
                    return false;
                }

                if (_maxWage is decimal max && wage > max)
                {
                    return false;
                }

                return true;
            });
        }

        _filtered = query.ToList();
    }

    private void ClearSalaryTableFilter()
    {
        _salaryTableFilter = null;
        _salaryTableFilterName = null;
        Navigation.NavigateTo("/employer/vacancies", replace: true);
        ApplyFilters();
    }

    private static decimal? ResolveWage(VacancyListItem v, int age)
    {
        if (v.HourlyWage is not null)
        {
            return v.HourlyWage;
        }

        if (v.WageByAge is { Count: > 0 })
        {
            return v.WageByAge
                .OrderBy(b => Math.Abs(b.AgeYears - age))
                .FirstOrDefault()?.HourlyRate;
        }

        return null;
    }

    private async Task RefreshAsync()
    {
        _vacancies = (await Api.GetManagedVacanciesAsync()).ToList();
        ApplyFilters();
    }

    private void OpenPublish(VacancyListItem vacancy)
    {
        _publishVacancy = vacancy;
        _publishOpen = true;
    }

    private Task ClosePublish()
    {
        _publishOpen = false;
        _publishVacancy = null;
        return Task.CompletedTask;
    }

    private async Task OnPublished(VacancyProductActionResult? result)
    {
        await RefreshAsync();
        _message = result?.PendingApproval == true
            ? (result.Message ?? "Wacht op goedkeuring (onvoldoende tokens).")
            : "Vacature gepubliceerd.";
    }

    private async Task ApproveAsync(Guid id)
    {
        try
        {
            await Api.ApprovePublishAsync(id);
            await RefreshAsync();
            _message = "Publicatie goedgekeurd.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task HighlightAsync(Guid id)
    {
        try
        {
            await Api.HighlightVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature gehighlight.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private void OpenPushBom(VacancyListItem vacancy)
    {
        _pushBomVacancy = vacancy;
        _pushBomOpen = true;
    }

    private Task ClosePushBom()
    {
        _pushBomOpen = false;
        _pushBomVacancy = null;
        return Task.CompletedTask;
    }

    private async Task OnPushBomConfirmed(VacancyProductActionResult? result)
    {
        await RefreshAsync();
        _message = $"PushBom verstuurd naar {result?.PushBomRecipientCount ?? 0} kandidaten (stub).";
    }

    private async Task ExtendAsync(Guid id)
    {
        try
        {
            await Api.ExtendVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature verlengd (+14 dagen).";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        try
        {
            await Api.DeactivateVacancyAsync(id);
            await RefreshAsync();
            _message = "Vacature inactive (gearchiveerd).";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }
}
