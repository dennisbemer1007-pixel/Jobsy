@page "/employer/sales"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "EnterpriseManager,Intermediary")]
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject CultureState Culture
@implements IDisposable

<PageTitle>Sales · Lobsy</PageTitle>

<div class="panel-page panel-page--wide">
    <header class="panel-header">
        <div>
            <h1>Sales</h1>
            <p class="login-lead">Deel je trackingcode, volg aangedragen bedrijven en zie je verdiende referraltokens.</p>
        </div>
    </header>

    <div class="admin-sublinks" role="tablist" aria-label="Sales onderdelen">
        <button type="button" class="admin-sublink @ActiveTabClass("overview")" role="tab" aria-selected="@(_tab == "overview")" @onclick='() => SetTab("overview")'>
            Overzicht
        </button>
        <button type="button" class="admin-sublink @ActiveTabClass("toolkit")" role="tab" aria-selected="@(_tab == "toolkit")" @onclick='() => SetTab("toolkit")'>
            Trackingcode &amp; flyer
        </button>
        <button type="button" class="admin-sublink @ActiveTabClass("explain")" role="tab" aria-selected="@(_tab == "explain")" @onclick='() => SetTab("explain")'>
            Uitleg
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_me is null)
    {
        <p class="state-message error">Partnerprofiel kon niet worden geladen.</p>
    }
    else if (_tab == "overview")
    {
        <section class="panel-section">
            <h2>Referral-overzicht</h2>
            <p class="muted">Bedrijven die via jouw trackingcode zijn aangemeld. Bonus (0,5 token) wordt automatisch toegekend zodra hun welkomsttoken wordt ingezet.</p>

            <div class="stat-grid">
                <div class="stat-card">
                    <span class="stat-card__label">Verdiende referraltokens</span>
                    <strong class="stat-card__value">@FormatTokens(_me.ReferralTokensEarned)</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-card__label">Aangedragen bedrijven</span>
                    <strong class="stat-card__value">@_me.ReferredCompanyCount</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-card__label">Bonus toegekend</span>
                    <strong class="stat-card__value">@_me.RewardedReferralCount</strong>
                </div>
            </div>
        </section>

        <section class="panel-section">
            <h2>Aangedragen bedrijven</h2>
            @if (_referrals.Count == 0)
            {
                <p class="muted">Nog geen bedrijven via jouw code. Deel je trackingcode of flyer om te starten.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Bedrijf</th>
                                <th>Status</th>
                                <th>Aangedragen</th>
                                <th>Bonus toegekend</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _referrals)
                            {
                                <tr>
                                    <td>@row.CompanyName</td>
                                    <td>@row.StatusLabel</td>
                                    <td>@(row.ReferredAtUtc?.ToLocalTime().ToString("dd-MM-yyyy") ?? "—")</td>
                                    <td>@(row.RewardedAtUtc?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_tab == "toolkit")
    {
        <section class="panel-section">
            <h2>Trackingcode &amp; flyer</h2>
            <p class="muted">Deel je unieke code. Nieuwe bedrijven die via jouw link registreren worden aan jouw salesprofiel gekoppeld.</p>

            <div class="stat-grid">
                <div class="stat-card">
                    <span class="stat-card__label">Trackingcode</span>
                    <strong class="stat-card__value">@TrackingCode</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-card__label">Aangedragen</span>
                    <strong class="stat-card__value">@_me.ReferredCompanyCount</strong>
                </div>
            </div>
        </section>

        <section class="panel-section partner-sales__box">
            <h2>Links en flyer</h2>
            <div class="table-list">
                <div class="table-row">
                    <div>
                        <strong>Partnerlink</strong>
                        <div class="muted" style="word-break:break-all">@PartnerUrl</div>
                    </div>
                    <div class="inline-actions" style="gap:0.35rem">
                        <button class="btn-compact" type="button" @onclick="() => CopyAsync(PartnerUrl)">Kopieer</button>
                        <a class="btn-compact" href="@PartnerUrl" target="_blank" rel="noopener">Open</a>
                    </div>
                </div>
                <div class="table-row">
                    <div>
                        <strong>Registratie-URL</strong>
                        <div class="muted" style="word-break:break-all">@RegisterUrl</div>
                    </div>
                    <div class="inline-actions" style="gap:0.35rem">
                        <button class="btn-compact" type="button" @onclick="() => CopyAsync(RegisterUrl)">Kopieer</button>
                        <a class="btn-compact" href="@RegisterUrl" target="_blank" rel="noopener">Open</a>
                    </div>
                </div>
                <div class="table-row">
                    <div>
                        <strong>Trackingcode</strong>
                        <div class="muted">@TrackingCode</div>
                    </div>
                    <button class="btn-compact" type="button" @onclick="() => CopyAsync(TrackingCode)">Kopieer</button>
                </div>
            </div>

            <div class="inline-actions" style="flex-wrap:wrap;gap:0.5rem;margin-top:1rem">
                @if (!string.IsNullOrWhiteSpace(_toolkit?.FlyerUrl))
                {
                    <a class="btn-compact btn-compact--primary" href="@_toolkit.FlyerUrl" target="_blank" rel="noopener">
                        Download flyer
                    </a>
                }
                <button class="btn-compact" type="button" @onclick="ShareWhatsApp">Deel via WhatsApp</button>
                <button class="btn-compact" type="button" @onclick="ShareMail">Deel via mail</button>
            </div>
        </section>
    }
    else if (_tab == "explain")
    {
        <section class="panel-section">
            <h2>Hoe werkt het?</h2>
            <ol class="muted" style="padding-left:1.25rem;line-height:1.6">
                <li>Deel je unieke trackingcode, partnerlink of flyer.</li>
                <li>Een nieuw bedrijf meldt zich aan via jouw code en wordt aan jou gekoppeld.</li>
                <li>Het bedrijf krijgt standaard 1 welkomsttoken bij registratie.</li>
                <li>Zodra dat welkomsttoken wordt ingezet (vacature, highlight of pushbom), ontvang jij automatisch <strong>0,5 token</strong> in je tokenwallet — eenmalig per bedrijf.</li>
            </ol>
            <p class="muted" style="margin-top:1rem">Er zijn geen cash-uitbetalingen, percentages of selfbilling-facturen meer voor dit partnerschap.</p>
        </section>
    }
</div>

@code {
    private string _tab = "overview";
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private PartnerAffiliateMeModel? _me;
    private PartnerAffiliateToolkitModel? _toolkit;
    private List<PartnerAffiliateReferralRowModel> _referrals = [];

    private string TrackingCode => FirstNonEmpty(_toolkit?.TrackingCode, _me?.TrackingCode) ?? "—";
    private string PartnerUrl => FirstNonEmpty(_toolkit?.PartnerPageUrl, BuildPartnerUrl())!;
    private string RegisterUrl => FirstNonEmpty(_toolkit?.RegisterUrl, BuildRegisterUrl())!;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (qs.TryGetValue("tab", out var tab) && IsKnownTab(tab.ToString()))
        {
            _tab = tab.ToString();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _me = await Api.GetPartnerAffiliateMeAsync();
            _toolkit = await Api.GetPartnerAffiliateToolkitAsync();
            _referrals = (await Api.GetPartnerAffiliateReferralsAsync()).ToList();
            if (_me?.Referrals is { Count: > 0 } && _referrals.Count == 0)
            {
                _referrals = _me.Referrals;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    private void SetTab(string tab)
    {
        if (IsKnownTab(tab))
        {
            _tab = tab;
            _error = null;
            _message = null;
        }
    }

    private string ActiveTabClass(string tab) => _tab == tab ? "admin-sublink--active" : "";

    private async Task CopyAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == "—")
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", value);
            _message = "Gekopieerd naar klembord.";
        }
        catch
        {
            _message = value;
        }
    }

    private void ShareWhatsApp()
    {
        var text = Uri.EscapeDataString(
            $"Meld je aan bij Lobsy met mijn code {TrackingCode}: {RegisterUrl}");
        Nav.NavigateTo($"https://wa.me/?text={text}", forceLoad: true);
    }

    private void ShareMail()
    {
        var subject = Uri.EscapeDataString("Lobsy - aanmelden via mijn partnercode");
        var body = Uri.EscapeDataString(
            $"Hoi,%0A%0AHier is mijn Lobsy-partnerlink met code {TrackingCode}:%0A{PartnerUrl}%0A%0ARegistreren kan direct via:%0A{RegisterUrl}%0A%0A");
        Nav.NavigateTo($"mailto:?subject={subject}&body={body}", forceLoad: true);
    }

    private string BuildPartnerUrl()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        return TrackingCode == "—"
            ? $"{baseUri}/partner"
            : $"{baseUri}/partner/{Uri.EscapeDataString(TrackingCode)}";
    }

    private string BuildRegisterUrl()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        return TrackingCode == "—"
            ? $"{baseUri}/register"
            : $"{baseUri}/register?ref={Uri.EscapeDataString(TrackingCode)}";
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private static bool IsKnownTab(string? tab)
        => tab is "overview" or "toolkit" or "explain" or "tokenlog" or "invoices";

    private static string FormatTokens(decimal amount)
        => amount.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"));
}
