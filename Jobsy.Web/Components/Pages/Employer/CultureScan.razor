@page "/employer/culture"
@page "/branch/culture"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,RegionalManager,EnterpriseManager,Intermediary,Admin")]
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["CultureScan.EmployerTitle"] · Lobsy</PageTitle>

<div class="panel-page profile-page competency-test-page">
    <header class="saved-gate__header profile-page__header">
        <h1>@Culture["CultureScan.EmployerTitle"]</h1>
        <p class="login-lead">@Culture["CultureScan.EmployerLead"]</p>
    </header>

    <article class="detail-card">
        <p class="login-lead">@Culture["CultureScan.EmployerNote"]</p>
        <p class="competency-test__progress" aria-live="polite">
            @Culture.Format("Competency.Progress", AnsweredCultureCount, 12)
        </p>
        <div class="competency-test__meter" role="progressbar" aria-valuemin="0" aria-valuemax="12" aria-valuenow="@AnsweredCultureCount">
            <span style="width: @((AnsweredCultureCount * 100 / 12).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
        </div>

        @if (_loading)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (_loadFailed)
        {
            <p class="state-message">@_message</p>
        }
        else
        {
            @foreach (var category in CulturePersonalityCatalog.CultureDimensionCodes)
            {
                var questions = CulturePersonalityCatalog.QuestionsFor(category);
                var done = questions.Count(q => _answers.ContainsKey(q.Id));
                <fieldset class="competency-test__cat">
                    <legend>@Culture[$"CultureScan.Cat.{category}"]</legend>
                    <p class="profile-address__hint">@Culture[$"CultureScan.Cat.{category}.Hint"]</p>
                    <p class="profile-address__hint">@Culture.Format("Competency.CategoryProgress", Culture[$"CultureScan.Cat.{category}"], done, questions.Count)</p>
                    @foreach (var question in questions)
                    {
                        <div class="competency-question">
                            <p class="competency-question__text">@question.Id. @Culture[question.TextKey]</p>
                            <div class="competency-likert" role="radiogroup" aria-label="@Culture[question.TextKey]">
                                @for (var value = 1; value <= 5; value++)
                                {
                                    var current = value;
                                    var id = $"eq{question.Id}-{current}";
                                    <label class="competency-likert__opt @(_answers.TryGetValue(question.Id, out var selected) && selected == current ? "is-on" : null)">
                                        <input type="radio"
                                               name="@($"eq{question.Id}")"
                                               id="@id"
                                               value="@current"
                                               checked="@(_answers.TryGetValue(question.Id, out var v) && v == current)"
                                               @onchange="() => SetAnswer(question.Id, current)" />
                                        <span>@Culture[$"Competency.Likert.{current}"]</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
            }

            <div class="profile-save-bar">
                <button class="engagement-btn" type="button" disabled="@_saving" @onclick="SaveDraftAsync">
                    @Culture["Competency.SaveDraft"]
                </button>
                <button class="login-submit" type="button" disabled="@(_saving || AnsweredCultureCount < 12)" @onclick="CompleteAsync">
                    @Culture["Competency.Complete"]
                </button>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="state-message profile-save-bar__message">@_message</p>
                }
            </div>

            @if (_scores is { } scores)
            {
                <h2 class="login-lead">@Culture["CultureScan.EmployerResult"]</h2>
                <CultureScorePanel Scores="@ToScoreSet(scores)" />
            }
        }
    </article>
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _loadFailed;
    private string? _message;
    private readonly Dictionary<int, int> _answers = [];
    private CulturePersonalityScoreSet? _scores;

    private int AnsweredCultureCount => _answers.Count(kv => kv.Key is >= 1 and <= 12);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Api.GetCompanyCultureAsync();
            if (state is not null)
            {
                _answers.Clear();
                foreach (var (key, value) in state.Answers)
                {
                    if (int.TryParse(key, out var id))
                    {
                        _answers[id] = value;
                    }
                }

                _scores = state.Scores;
            }
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetAnswer(int id, int value)
    {
        _answers[id] = value;
        _message = null;
    }

    private Task SaveDraftAsync() => PersistAsync(complete: false);
    private Task CompleteAsync() => PersistAsync(complete: true);

    private async Task PersistAsync(bool complete)
    {
        _saving = true;
        _message = null;
        try
        {
            var saved = await Api.SaveCompanyCultureAsync(_answers, complete);
            _answers.Clear();
            foreach (var (key, value) in saved.Answers)
            {
                if (int.TryParse(key, out var id))
                {
                    _answers[id] = value;
                }
            }

            _scores = saved.Scores;
            _message = complete ? Culture["CultureScan.EmployerSaved"] : Culture["Competency.SavedDraft"];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static CulturePersonalityScoreSet ToScoreSet(CulturePersonalityScoreSet scores) => scores;
}
