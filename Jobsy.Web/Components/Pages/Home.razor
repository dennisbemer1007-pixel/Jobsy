@page "/"
@* Prerender the map shell (placeholder + chrome). Leaflet binds only after hydrate + idle. *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>
<HeadContent>
    <link rel="preload" href="images/maps/nl-preview.svg" as="image" type="image/svg+xml" fetchpriority="high" />
</HeadContent>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
