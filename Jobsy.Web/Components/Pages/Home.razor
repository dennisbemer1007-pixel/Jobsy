@page "/"
@* Map chrome prerenders. MapLibre CSS/JS are not linked from this document — that
   kept a 300KB+ critical request chain on first paint. jobsyMaps injects them after
   the first frame (and Blazor ensure() can start them immediately once interactive). *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
