@page "/"
@* Map chrome prerenders; MapLibre CSS/JS start at page load (fetchpriority=high) so the map is filled immediately. *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="lib/maplibre/maplibre-gl.css" fetchpriority="high" />
    <link rel="preload" href="lib/maplibre/maplibre-gl.js" as="script" fetchpriority="high" />
    <link rel="preload" href="js/jobsyMapLibre.js?v=20260820-r161" as="script" fetchpriority="high" />
    <link rel="preload" href="js/jobMap.js?v=20260820-r161" as="script" />
</HeadContent>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
