@page "/"
@* Map chrome prerenders; MapLibre CSS/JS load lazily via jobsyMaps when #job-map is near the viewport. *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
