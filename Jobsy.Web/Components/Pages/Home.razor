@page "/"
@* Prerender the map chrome. MapLibre + OpenFreeMap warm from this page so the live map appears sooner. *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>
<HeadContent>
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    <link rel="stylesheet" href="/lib/maplibre/maplibre-gl.css" />
    <link rel="preload" href="/lib/maplibre/maplibre-gl.js" as="script" fetchpriority="high" />
    <link rel="preload" href="/js/jobsyMapLibre.js?v=20260819-ml" as="script" fetchpriority="high" />
    <link rel="preload" href="/js/jobMap.js?v=20260819-ml" as="script" fetchpriority="high" />
</HeadContent>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
