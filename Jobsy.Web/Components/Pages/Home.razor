@page "/"
@* Map chrome prerenders. MapLibre CSS is non-blocking (same print→all trick as app.css) so first paint is the inline map shell. JS is still preloaded; worker is fetch, not script (unused-JS). *@
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.JobMapTitle"]</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="lib/maplibre/maplibre-gl.css?v=20260820-r166" media="print" onload="this.onload=null;this.media='all'" />
    <link rel="preload" href="lib/maplibre/maplibre-gl-csp.js?v=20260820-r180" as="script" fetchpriority="high" />
    <link rel="preload" href="lib/maplibre/maplibre-gl-csp-worker.js?v=20260820-r166" as="fetch" crossorigin fetchpriority="high" />
    <link rel="preload" href="js/jobsyMapLibre.min.js?v=20260822-r195" as="script" fetchpriority="high" />
    <link rel="preload" href="js/jobMap.min.js?v=20260822-r193" as="script" fetchpriority="high" />
</HeadContent>

<VacancyDiscovery />

@code {
    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
