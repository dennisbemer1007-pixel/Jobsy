@using Jobsy.Web.Components.Employer
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Dashboard
@using Jobsy.Web.Models
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@implements IDisposable

<div class="panel-page panel-page--dashboard max-w-full overflow-x-hidden">
    <header class="panel-header panel-header--dashboard">
        <div class="panel-header__title-row">
            <h1>@Title</h1>
            <DashboardRefreshButton Period="_period" Disabled="_loading" OnRefreshed="ApplyRefreshAsync" />
        </div>
        <p class="login-lead">@Lead</p>
        <div class="panel-header__actions">
            <div class="period-tabs period-tabs--compact pill-scroller" role="tablist" aria-label="@Culture["Common.Period"]">
                @foreach (var p in PeriodKeys)
                {
                    <button type="button"
                            class="period-tab @(_period == p ? "period-tab--active" : null)"
                            role="tab"
                            aria-selected="@(_period == p)"
                            disabled="@_loading"
                            @onclick="() => SetPeriodAsync(p)">
                        @PeriodLabel(p)
                    </button>
                }
            </div>
        </div>
    </header>

    @if (_error is not null && _metrics.Count == 0 && !_loading)
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        <MetricsCategoryBoard Metrics="_metrics"
                              Loading="@(_loading && _metrics.Count == 0)"
                              ValueFormatter="FormatValue"
                              ShowVacancyPerformance="true"
                              VacancyPerformance="_vacancyBoard"
                              VacancyHrefPrefix="/vacancies"
                              OnMetricClick="OpenMetricAsync" />
    }

    @if (EnableRaamflyer)
    {
        <section class="panel-section dashboard-secondary">
            <RaamflyerTools Companies="_companies"
                            AllowOverview="AllowOverviewRaamflyer"
                            Loading="_loadingCompanies"
                            OverviewTitle="@(Title.Contains("Regio", StringComparison.OrdinalIgnoreCase) ? "onze regio" : "onze vestigingen")" />
        </section>
    }
</div>

@code {
    private static readonly string[] PeriodKeys = ["day", "week", "month", "quarter", "year"];

    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string Lead { get; set; } = string.Empty;
    [Parameter] public string VacanciesHref { get; set; } = "/employer/vacancies";
    [Parameter] public string TokensHref { get; set; } = "/employer/tokens";
    [Parameter] public string ApplicationsHref { get; set; } = "/branch/applicants";
    [Parameter] public bool EnableRaamflyer { get; set; }
    [Parameter] public bool AllowOverviewRaamflyer { get; set; }

    private string _period = "week";
    private bool _loading = true;
    private string? _error;
    private List<MetricCount> _metrics = [];
    private VacancyPerformanceBoard? _vacancyBoard;
    private List<CompanySummary> _companies = [];
    private bool _loadingCompanies;

    private string PeriodLabel(string key) => key switch
    {
        "day" => Culture["Metrics.Day"],
        "week" => Culture["Metrics.Week"],
        "month" => Culture["Metrics.Month"],
        "quarter" => Culture["Metrics.Quarter"],
        "year" => Culture["Metrics.Year"],
        _ => key
    };

    private bool _loadStarted;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override Task OnInitializedAsync()
        => TryLoadAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? TryLoadAsync() : Task.CompletedTask;

    private async Task TryLoadAsync()
    {
        if (!HomeDashboardLoad.TryBegin(ref _loadStarted, RendererInfo.IsInteractive))
        {
            return;
        }

        if (EnableRaamflyer)
        {
            await LoadCompaniesAsync();
        }

        await LoadSummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private static string FormatValue(MetricCount metric)
    {
        if (MetricDashboardCatalog.IsPercent(metric.Key))
        {
            return metric.Value.ToString("0.#") + "%";
        }

        if (MetricDashboardCatalog.IsMinutes(metric.Key))
        {
            return metric.Value.ToString("0.#") + " min";
        }

        return metric.Key.StartsWith("tokens_", StringComparison.OrdinalIgnoreCase)
            ? metric.Value.ToString("0.##")
            : metric.Value.ToString("0");
    }

    private async Task SetPeriodAsync(string period)
    {
        if (_period == period)
        {
            return;
        }

        _period = period;
        await LoadSummaryAsync();
    }

    private Task OpenMetricAsync(MetricCount metric)
    {
        var overview = ListHrefFor(metric.Key);
        var qs = $"period={Uri.EscapeDataString(_period)}"
                 + $"&label={Uri.EscapeDataString(metric.Label)}"
                 + $"&overview={Uri.EscapeDataString(overview)}";
        Navigation.NavigateTo($"/home/metrics/{Uri.EscapeDataString(metric.Key)}?{qs}");
        return Task.CompletedTask;
    }

    private async Task LoadCompaniesAsync()
    {
        _loadingCompanies = true;
        try
        {
            _companies = (await Api.GetMyCompaniesAsync())
                .OrderBy(c => c.ParentCompanyId is null ? 0 : 1)
                .ThenBy(c => c.Name)
                .ToList();
        }
        catch
        {
            _companies = [];
        }
        finally
        {
            _loadingCompanies = false;
        }
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        _error = null;
        var (metrics, error) = await HomeDashboardLoad.FetchAsync(async () =>
            (await Api.GetEmployerMetricsSummaryAsync(_period)).ToList());
        if (error is not null)
        {
            _error = error;
            _metrics = [];
            _vacancyBoard = null;
            _loading = false;
            return;
        }

        _metrics = metrics ?? [];

        try
        {
            _vacancyBoard = await Api.GetVacancyPerformanceAsync(_period);
        }
        catch
        {
            // KPI tiles stay available when Top/Flop fails independently.
            _vacancyBoard = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyRefreshAsync(DashboardRefreshResult result)
    {
        if (result.Metrics is not null)
        {
            _metrics = result.Metrics;
        }

        if (result.VacancyPerformance is not null)
        {
            _vacancyBoard = result.VacancyPerformance;
        }

        _error = null;
        return Task.CompletedTask;
    }

    private string ListHrefFor(string key) => key.ToLowerInvariant() switch
    {
        "applications" or "applications_pending" or "conversion_rate"
            or "avg_travel_minutes" or "top_transport_share" => ApplicationsHref,
        "impressions" or "clicks" => VacanciesHref,
        "active_vacancies" or "active_vacancies_employers" or "active_vacancies_intermediaries"
            or "active_boosts" => VacanciesHref,
        "tokens_purchased" or "tokens_spent" or "tokens_balance" or "pushboms" or "extensions" => TokensHref,
        _ => VacanciesHref
    };
}
