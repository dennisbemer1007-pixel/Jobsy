@using Jobsy.Core.Authorization
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@implements IDisposable

<div class="panel-page panel-page--dashboard">
    <header class="panel-header panel-header--dashboard">
        <div>
            <h1>@Title</h1>
            <p class="login-lead">@Lead</p>
        </div>
        <div class="period-tabs period-tabs--compact" role="tablist" aria-label="@Culture["Common.Period"]">
            @foreach (var p in PeriodKeys)
            {
                <button type="button"
                        class="period-tab @(_period == p ? "period-tab--active" : null)"
                        role="tab"
                        aria-selected="@(_period == p)"
                        disabled="@_loading"
                        @onclick="() => SetPeriodAsync(p)">
                    @PeriodLabel(p)
                </button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="state-message error">@_error</p>
    }
    else if (_loading && _metrics.Count == 0)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <MetricsCategoryBoard Metrics="_metrics"
                              ValueFormatter="FormatValue"
                              ShowVacancyPerformance="true"
                              VacancyPerformance="_vacancyBoard"
                              VacancyHrefPrefix="/vacancies"
                              OnMetricClick="OpenMetricAsync">
            <a class="stat-card stat-card--link stat-card--nav" href="@TokensHref">
                <span class="stat-card__label">@Culture["Common.Tokens"]</span>
                <strong class="stat-card__value">→</strong>
            </a>
            <a class="stat-card stat-card--link stat-card--nav" href="@VacanciesHref">
                <span class="stat-card__label">@Culture["Employer.DashboardVacancies"]</span>
                <strong class="stat-card__value">→</strong>
            </a>
            @if (_showMyApplications)
            {
                <a class="stat-card stat-card--link stat-card--nav" href="/candidate/applications">
                    <span class="stat-card__label">@Culture["Employer.DashboardApplications"]</span>
                    <strong class="stat-card__value">→</strong>
                </a>
            }
            @if (!string.IsNullOrEmpty(ExtraHref))
            {
                <a class="stat-card stat-card--link stat-card--nav" href="@ExtraHref">
                    <span class="stat-card__label">@ExtraLabel</span>
                    <strong class="stat-card__value">→</strong>
                </a>
            }
        </MetricsCategoryBoard>
    }
</div>

@code {
    private static readonly string[] PeriodKeys = ["day", "week", "month", "quarter", "year"];

    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string Lead { get; set; } = string.Empty;
    [Parameter] public string VacanciesHref { get; set; } = "/employer/vacancies";
    [Parameter] public string TokensHref { get; set; } = "/employer/tokens";
    [Parameter] public string ApplicationsHref { get; set; } = "/branch/applicants";
    [Parameter] public string? ExtraHref { get; set; }
    [Parameter] public string ExtraLabel { get; set; } = "Meer";

    private string _period = "week";
    private bool _loading = true;
    private bool _showMyApplications;
    private string? _error;
    private List<MetricCount> _metrics = [];
    private VacancyPerformanceBoard? _vacancyBoard;

    private string PeriodLabel(string key) => key switch
    {
        "day" => Culture["Metrics.Day"],
        "week" => Culture["Metrics.Week"],
        "month" => Culture["Metrics.Month"],
        "quarter" => Culture["Metrics.Quarter"],
        "year" => Culture["Metrics.Year"],
        _ => key
    };

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _showMyApplications = state.User.HasClaim(JobsyClaimTypes.HasCandidateApplications, "1");
        await LoadSummaryAsync();
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private static string FormatValue(MetricCount metric)
    {
        if (MetricDashboardCatalog.IsPercent(metric.Key))
        {
            return metric.Value.ToString("0.#") + "%";
        }

        return metric.Key.StartsWith("tokens_", StringComparison.OrdinalIgnoreCase)
            ? metric.Value.ToString("0.##")
            : metric.Value.ToString("0");
    }

    private async Task SetPeriodAsync(string period)
    {
        if (_period == period)
        {
            return;
        }

        _period = period;
        await LoadSummaryAsync();
    }

    private Task OpenMetricAsync(MetricCount metric)
    {
        var overview = ListHrefFor(metric.Key);
        var qs = $"period={Uri.EscapeDataString(_period)}"
                 + $"&label={Uri.EscapeDataString(metric.Label)}"
                 + $"&overview={Uri.EscapeDataString(overview)}";
        Navigation.NavigateTo($"/home/metrics/{Uri.EscapeDataString(metric.Key)}?{qs}");
        return Task.CompletedTask;
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var metricsTask = Api.GetEmployerMetricsSummaryAsync(_period);
            var perfTask = Api.GetVacancyPerformanceAsync(_period);
            await Task.WhenAll(metricsTask, perfTask);
            _metrics = (await metricsTask).ToList();
            _vacancyBoard = await perfTask;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _metrics = [];
            _vacancyBoard = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private string ListHrefFor(string key) => key.ToLowerInvariant() switch
    {
        "applications" => ApplicationsHref,
        "impressions" or "clicks" => VacanciesHref,
        "active_vacancies" or "active_vacancies_employers" or "active_vacancies_intermediaries" => VacanciesHref,
        "tokens_purchased" or "tokens_spent" or "pushboms" or "extensions" => TokensHref,
        _ => VacanciesHref
    };
}
