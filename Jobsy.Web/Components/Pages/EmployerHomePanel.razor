@using Jobsy.Web.Components.Shared
@inject JobsyApiClient Api
@inject NavigationManager Navigation

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Title</h1>
            <p class="login-lead">@Lead</p>
        </div>
        <div class="period-tabs" role="tablist" aria-label="Periode">
            @foreach (var p in Periods)
            {
                <button type="button"
                        class="period-tab @(_period == p.Key ? "period-tab--active" : null)"
                        role="tab"
                        aria-selected="@(_period == p.Key)"
                        disabled="@_loading"
                        @onclick="() => SetPeriodAsync(p.Key)">
                    @p.Label
                </button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="state-message error">@_error</p>
    }
    else if (_loading && _metrics.Count == 0)
    {
        <p class="state-message">Laden…</p>
    }
    else
    {
        <div class="stat-grid">
            @foreach (var metric in _metrics)
            {
                <MetricTile Label="@metric.Label"
                            FormattedValue="@FormatValue(metric)"
                            OnClick="() => OpenMetricAsync(metric)" />
            }
            <a class="stat-card stat-card--link" href="@TokensHref">
                <span class="stat-card__label">Tokens</span>
                <strong class="stat-card__value">→</strong>
            </a>
            <a class="stat-card stat-card--link" href="@VacanciesHref">
                <span class="stat-card__label">Vacatures</span>
                <strong class="stat-card__value">→</strong>
            </a>
            @if (!string.IsNullOrEmpty(ExtraHref))
            {
                <a class="stat-card stat-card--link" href="@ExtraHref">
                    <span class="stat-card__label">@ExtraLabel</span>
                    <strong class="stat-card__value">→</strong>
                </a>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Periods =
    [
        ("day", "Dag"),
        ("week", "Week"),
        ("month", "Maand"),
        ("quarter", "Kwartaal"),
        ("year", "Jaar")
    ];

    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string Lead { get; set; } = string.Empty;
    [Parameter] public string VacanciesHref { get; set; } = "/employer/vacancies";
    [Parameter] public string TokensHref { get; set; } = "/employer/tokens";
    [Parameter] public string ApplicationsHref { get; set; } = "/branch/applicants";
    [Parameter] public string? ExtraHref { get; set; }
    [Parameter] public string ExtraLabel { get; set; } = "Meer";

    private string _period = "week";
    private bool _loading = true;
    private string? _error;
    private List<MetricCount> _metrics = [];

    protected override async Task OnInitializedAsync()
        => await LoadSummaryAsync();

    private static string FormatValue(MetricCount metric)
        => metric.Key.StartsWith("tokens_", StringComparison.OrdinalIgnoreCase)
            ? metric.Value.ToString("0.##")
            : metric.Value.ToString("0");

    private async Task SetPeriodAsync(string period)
    {
        if (_period == period)
        {
            return;
        }

        _period = period;
        await LoadSummaryAsync();
    }

    private Task OpenMetricAsync(MetricCount metric)
    {
        var overview = ListHrefFor(metric.Key);
        var qs = $"period={Uri.EscapeDataString(_period)}"
                 + $"&label={Uri.EscapeDataString(metric.Label)}"
                 + $"&overview={Uri.EscapeDataString(overview)}";
        Navigation.NavigateTo($"/home/metrics/{Uri.EscapeDataString(metric.Key)}?{qs}");
        return Task.CompletedTask;
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _metrics = (await Api.GetEmployerMetricsSummaryAsync(_period)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _metrics = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private string ListHrefFor(string key) => key.ToLowerInvariant() switch
    {
        "applications" => ApplicationsHref,
        "impressions" or "clicks" => VacanciesHref,
        "active_vacancies" or "active_vacancies_employers" or "active_vacancies_intermediaries" => VacanciesHref,
        "tokens_purchased" or "tokens_spent" or "pushboms" or "extensions" => TokensHref,
        _ => VacanciesHref
    };
}
