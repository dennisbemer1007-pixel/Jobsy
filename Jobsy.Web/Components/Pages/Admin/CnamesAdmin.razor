@page "/admin/organisaties/regios"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminNav.Regions"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Regions"]" Lead="@Culture["AdminOrgs.RegionsLead"]" Wide="true">
    <AdminTabs BasePath="/admin/organisaties/regios" @bind-ActiveKey="_tab" @bind-ActiveKey:after="OnTabChangedAsync" Tabs="_tabs" />

    @if (_tab == "regios")
    {
        <section class="admin-regions-readonly">
            <p class="muted">@Culture["AdminOrgs.RegionsManagedNote"]</p>
            @if (_loadingRegions)
            {
                <p class="state-message">@Culture["Common.Loading"]</p>
            }
            else if (!string.IsNullOrEmpty(_regionsError))
            {
                <p class="state-message error">@_regionsError</p>
            }
            else
            {
                <AdminDataTable Loading="false"
                                Empty="_regions.Count == 0"
                                EmptyText="@Culture["AdminOrgs.RegionsEmpty"]">
                    <Header>
                        <th scope="col">@Culture["AdminOrgs.ColRegion"]</th>
                        <th scope="col">@Culture["AdminOrgs.ColOrganisation"]</th>
                        <th scope="col">@Culture["AdminOrgs.ColBranches"]</th>
                    </Header>
                    <Rows>
                        @foreach (var r in _regions)
                        {
                            <tr>
                                <td><strong>@r.Name</strong></td>
                                <td>@r.OrganizationCompanyName</td>
                                <td>@r.Companies.Count</td>
                            </tr>
                        }
                    </Rows>
                </AdminDataTable>
            }
        </section>
    }
    else
    {
        <CnamesSection />
    }
</AdminPageShell>

@code {
    private string _tab = "domeinen";
    private readonly List<AdminTabs.Tab> _tabs = [];
    private List<RegionItem> _regions = [];
    private bool _loadingRegions;
    private string? _regionsError;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        RebuildTabs();
    }

    protected override async Task OnInitializedAsync()
    {
        var qs = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (qs.TryGetValue("tab", out var tab)
            && string.Equals(tab.ToString(), "regios", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "regios";
        }

        if (_tab == "regios")
        {
            await LoadRegionsAsync();
        }
    }

    private async Task OnTabChangedAsync()
    {
        if (_tab == "regios")
        {
            await LoadRegionsAsync();
        }
    }

    private void OnCultureChanged()
    {
        RebuildTabs();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Culture.Changed -= OnCultureChanged;

    private void RebuildTabs()
    {
        _tabs.Clear();
        _tabs.Add(new AdminTabs.Tab("domeinen", Culture["AdminOrgs.TabDomains"]));
        _tabs.Add(new AdminTabs.Tab("regios", Culture["AdminOrgs.TabRegions"]));
    }

    private async Task LoadRegionsAsync()
    {
        _loadingRegions = true;
        _regionsError = null;
        try
        {
            _regions = (await Api.GetRegionsAsync()).ToList();
        }
        catch (Exception ex)
        {
            _regionsError = ex.Message;
            _regions = [];
        }
        finally
        {
            _loadingRegions = false;
        }
    }
}
