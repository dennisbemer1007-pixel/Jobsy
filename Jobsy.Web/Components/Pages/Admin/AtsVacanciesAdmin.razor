@page "/admin/ats-vacancies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Admin.AtsVacancies"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.AtsVacancies"]" Lead="@Culture["Admin.AtsVacanciesLead"]" Wide="true" ShowVacanciesNav="true">
    <div class="ats-toolbar">
        <label class="ats-toolbar__search">
            <span class="visually-hidden">@Culture["Common.Search"]</span>
            <input type="search"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   placeholder="Zoek op titel, bedrijf of locatie…" />
        </label>
        <label class="ats-toolbar__filter">
            Status
            <select @bind="_statusFilter" @bind:after="ReloadAsync">
                <option value="">Alle</option>
                <option value="PendingReview">In afwachting</option>
                <option value="Approved">Actief</option>
                <option value="Rejected">Afgekeurd</option>
                <option value="Expired">Verlopen</option>
                <option value="Inactive">Inactief</option>
            </select>
        </label>
        <div class="ats-toolbar__actions">
            <button class="btn-primary" type="button" disabled="@_busy" @onclick="ScrapeAsync">
                Start Scrape Handmatig
            </button>
            <button class="btn-compact" type="button" disabled="@_busy" @onclick="HealthAsync">Health-check</button>
            <button class="btn-compact" type="button" disabled="@_busy" @onclick="ReloadAsync">Vernieuwen</button>
        </div>
        <span class="ats-toolbar__count muted">@_filtered.Count resultaat@(_filtered.Count == 1 ? "" : "en")</span>
    </div>

    @if (_scrapeReport is not null)
    {
        <section class="ats-diag panel-section">
            <div class="panel-header">
                <h2>Scrape-log (achtergrond)</h2>
                <button class="btn-compact" type="button" @onclick="() => _scrapeReport = null">Sluiten</button>
            </div>
            <p class="ats-diag__summary">
                Bronnen <strong>@_scrapeReport.SourceCount</strong>
                · Failed <strong>@_scrapeReport.FailedSources</strong>
                · upsert <strong>@_scrapeReport.Upserted</strong>
                · invalid skip @_scrapeReport.SkippedInvalid
                · HTTP @_scrapeReport.HttpErrors
            </p>
            @if (_scrapeReport.Sources.Count > 0)
            {
                <div class="ats-diag__sources">
                    @foreach (var s in _scrapeReport.Sources)
                    {
                        <div class="ats-diag__source ats-diag__source--@s.Status.ToLowerInvariant()">
                            <div class="ats-diag__source-head">
                                <strong>@s.Name</strong>
                                <span class="ats-status-badge ats-status-badge--@DomainStatusClass(s.Status)">@s.Status</span>
                            </div>
                            <div class="muted">
                                @s.Domain · HTTP @(s.ListHttpStatus?.ToString() ?? "—")
                                · pages @s.PagesScanned
                                · pagination @s.PaginationFollowed
                                · unique URLs @s.VacancyLinkCount
                                · ATS opgeslagen @s.AtsListingsSaved
                                · anchors @s.RawAnchorCount
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Error))
                            {
                                <div class="ats-diag__source-error">@s.Error</div>
                            }
                        </div>
                    }
                </div>
            }
            <details class="ats-diag__details">
                <summary>Volledige logregels</summary>
                <pre class="ats-diag__log">@string.Join('\n', _scrapeReport.Lines)</pre>
            </details>
        </section>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_filtered.Count == 0)
    {
        <div class="ats-empty">
            <h2>Geen gescrapete vacatures</h2>
            <p class="muted">Het overzicht toont alleen echte scrape-resultaten. Start een handmatige scrape of wacht op de dagelijkse run.</p>
        </div>
    }
    else
    {
        <div class="ats-card-grid">
            @foreach (var row in _filtered)
            {
                <article class="ats-card" @onclick="() => OpenDetail(row)">
                    <header class="ats-card__header">
                        <div>
                            <h3 class="ats-card__title">@row.Title</h3>
                            <p class="ats-card__company">@row.CompanyName</p>
                        </div>
                        <div>
                            <span class="source-badge source-badge--ats ats-card__channel">ATS</span>
                            <span class="ats-status-badge ats-status-badge--@StatusClass(row.Status)">@StatusLabel(row.Status)</span>
                        </div>
                    </header>
                    <div class="ats-card__meta">
                        <span>@(string.IsNullOrWhiteSpace(row.LocationLabel) ? "Locatie onbekend" : row.LocationLabel)</span>
                        @if (!string.IsNullOrWhiteSpace(row.SalaryText) || row.HourlyWage is > 0)
                        {
                            <span>@SalaryDisplay(row)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.HoursText))
                        {
                            <span>@row.HoursText</span>
                        }
                        <span class="ats-score ats-score--@ScoreBand(row.CompletenessScore)">@row.CompletenessScore%</span>
                        <span class="muted">@row.ScrapedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    <p class="ats-card__excerpt">@Excerpt(row.Description)</p>
                    <footer class="ats-card__footer" @onclick:stopPropagation="true">
                        <a class="ats-card__source" href="@row.SourceUrl" target="_blank" rel="noopener noreferrer">@row.SourceDomain</a>
                        <div class="ats-card__actions">
                            @if (row.Status is "PendingReview" or "Inactive")
                            {
                                <button class="btn-compact btn-compact--ok" type="button" disabled="@_busy" @onclick="() => ApproveAsync(row)">Goedkeuren</button>
                            }
                            @if (row.Status is not "Rejected")
                            {
                                <button class="btn-compact" type="button" disabled="@_busy" @onclick="() => RejectAsync(row)">Afkeuren</button>
                            }
                            <button class="btn-compact" type="button" @onclick="() => OpenDetail(row)">Inzien</button>
                        </div>
                    </footer>
                </article>
            }
        </div>
    }

    @if (_edit is not null)
    {
        <div class="ats-detail-backdrop" @onclick="CloseDetail"></div>
        <aside class="ats-detail-drawer" role="dialog" aria-modal="true" aria-labelledby="ats-detail-title">
            <header class="ats-detail-drawer__head">
                <div class="ats-detail-drawer__head-text">
                    <p class="ats-detail-drawer__eyebrow">
                        <span class="source-badge source-badge--ats">ATS</span>
                        <span class="ats-status-badge ats-status-badge--@StatusClass(_edit.Status)">@StatusLabel(_edit.Status)</span>
                        <span class="muted">score @_edit.CompletenessScore%</span>
                    </p>
                    <h2 id="ats-detail-title">@_edit.Title</h2>
                    <p class="ats-detail-drawer__company">@_edit.CompanyName</p>
                </div>
                <button class="ats-detail-drawer__close btn-compact" type="button" @onclick="CloseDetail" aria-label="Sluiten">
                    Sluiten
                </button>
            </header>

            <div class="ats-detail-drawer__scroll">
                <div class="ats-detail-drawer__meta">
                    <div><span class="muted">Locatie</span><strong>@(_edit.LocationLabel ?? "—")</strong></div>
                    <div><span class="muted">Salarisindicatie</span><strong>@(SalaryDisplay(_edit))</strong></div>
                    <div><span class="muted">Uren</span><strong>@(_edit.HoursText ?? "—")</strong></div>
                    <div><span class="muted">Starten vanaf</span><strong>@(_edit.StartDateText ?? "—")</strong></div>
                    <div><span class="muted">Gescrapet</span><strong>@_edit.ScrapedAtUtc.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</strong></div>
                    <div><span class="muted">Bron</span><strong><a href="@_edit.SourceUrl" target="_blank" rel="noopener noreferrer">@_edit.SourceDomain</a></strong></div>
                </div>

                @if (_edit.AiEnrichedAtUtc is not null)
                {
                    <p class="ats-detail-drawer__enrich muted">
                        Genormaliseerd @(_edit.AiEnrichedFromOpenAi ? "via AI" : "lokaal")
                        · @_edit.AiEnrichedAtUtc.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                    </p>
                }

                <section class="ats-detail-drawer__body">
                    <div class="ats-detail-drawer__body-head">
                        <h3>Vacatureomschrijving</h3>
                        <a class="ats-detail-drawer__open-source" href="@_edit.SourceUrl" target="_blank" rel="noopener noreferrer">
                            Open bronpagina
                        </a>
                    </div>
                    <div class="ats-detail-drawer__prose">@FormatDescription(_edit.Description)</div>
                </section>

                @if (!string.IsNullOrWhiteSpace(_edit.RequirementsText))
                {
                    <section class="ats-detail-drawer__body ats-detail-drawer__body--requirements">
                        <div class="ats-detail-drawer__body-head">
                            <h3>Vereisten</h3>
                        </div>
                        <div class="ats-detail-drawer__prose ats-detail-drawer__prose--list">@FormatDescription(_edit.RequirementsText)</div>
                    </section>
                }

                <p class="muted ats-detail-drawer__source-url">
                    Originele URL:
                    <a href="@_edit.SourceUrl" target="_blank" rel="noopener noreferrer">@_edit.SourceUrl</a>
                </p>

                <details class="ats-detail-drawer__edit">
                    <summary>Velden handmatig bewerken</summary>
                    <div class="ats-edit-grid">
                        <label>Titel <input @bind="_editTitle" /></label>
                        <label>Bedrijf <input @bind="_editCompany" /></label>
                        <label>Locatie <input @bind="_editLocation" /></label>
                        <label>Salaris-tekst <input @bind="_editSalary" /></label>
                        <label>Uurloon <input type="number" step="0.01" @bind="_editWage" /></label>
                        <label>Uren-tekst <input @bind="_editHours" /></label>
                        <label>Starten vanaf <input @bind="_editStart" /></label>
                        <label class="ats-edit-grid__full">Vereisten
                            <textarea rows="5" @bind="_editRequirements"></textarea>
                        </label>
                        <label class="ats-edit-grid__full">Omschrijving
                            <textarea rows="10" @bind="_editDescription"></textarea>
                        </label>
                    </div>
                    <button class="btn-compact" type="button" disabled="@_busy" @onclick="SaveEditAsync">Opslaan</button>
                </details>
            </div>

            <footer class="ats-detail-drawer__actions">
                @if (_edit.Status is "PendingReview" or "Inactive")
                {
                    <button class="btn-primary" type="button" disabled="@_busy" @onclick="() => ApproveAsync(_edit)">Goedkeuren / Actief</button>
                }
                @if (_edit.Status is not "Rejected")
                {
                    <button class="btn-compact" type="button" disabled="@_busy" @onclick="() => RejectAsync(_edit)">Afkeuren</button>
                }
                <button class="btn-compact" type="button" disabled="@_busy" @onclick="() => DeleteAsync(_edit)">Verwijderen</button>
                @if (_edit.LinkedVacancyId is Guid vid)
                {
                    <a class="btn-compact" href="/vacancies/@vid">Gekoppelde vacature</a>
                }
            </footer>
        </aside>
    }
</AdminPageShell>

@code {
    private List<AtsListingItem> _listings = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _searchQuery = string.Empty;
    private string _statusFilter = "PendingReview";
    private AtsScrapeRunReport? _scrapeReport;
    private AtsListingItem? _edit;
    private string _editTitle = string.Empty;
    private string _editCompany = string.Empty;
    private string? _editLocation;
    private string _editDescription = string.Empty;
    private string? _editSalary;
    private decimal? _editWage;
    private string? _editHours;
    private string? _editStart;
    private string? _editRequirements;

    private List<AtsListingItem> _filtered => Filter().ToList();

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        await ReloadAsync();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _listings = (await Api.GetAtsListingsAsync(
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _listings = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<AtsListingItem> Filter()
    {
        IEnumerable<AtsListingItem> q = _listings;
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var term = _searchQuery.Trim();
            q = q.Where(l =>
                l.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                || l.CompanyName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (l.LocationLabel?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || l.SourceUrl.Contains(term, StringComparison.OrdinalIgnoreCase)
                || l.SourceDomain.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private void OpenDetail(AtsListingItem row)
    {
        _edit = row;
        _editTitle = row.Title;
        _editCompany = row.CompanyName;
        _editLocation = row.LocationLabel;
        _editDescription = row.Description;
        _editSalary = row.SalaryText;
        _editWage = row.HourlyWage;
        _editHours = row.HoursText;
        _editStart = row.StartDateText;
        _editRequirements = row.RequirementsText;
    }

    private void CloseDetail() => _edit = null;

    private async Task SaveEditAsync()
    {
        if (_edit is null) return;
        _busy = true;
        _message = null;
        try
        {
            var updated = await Api.UpdateAtsListingAsync(_edit.Id, new AtsListingUpdateForm(
                _editTitle, _editCompany, _editLocation, _editDescription,
                _editSalary, _editWage, _editHours, _editStart, _editRequirements));
            _message = "Opgeslagen.";
            await ReloadAsync();
            if (updated is not null)
            {
                OpenDetail(_listings.FirstOrDefault(l => l.Id == updated.Id) ?? updated);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync(AtsListingItem row)
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Api.ApproveAtsListingAsync(row.Id);
            _message = result is null
                ? "Goedgekeurd."
                : $"Goedgekeurd → vacature {result.VacancyId} ({result.VacancyStatus}).";
            CloseDetail();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(AtsListingItem row)
    {
        _busy = true;
        _message = null;
        try
        {
            await Api.RejectAtsListingAsync(row.Id, "Handmatig afgekeurd door admin");
            _message = "Afgekeurd.";
            CloseDetail();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(AtsListingItem row)
    {
        _busy = true;
        _message = null;
        try
        {
            await Api.DeleteAtsListingAsync(row.Id);
            _message = "Verwijderd.";
            CloseDetail();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ScrapeAsync()
    {
        _busy = true;
        _message = null;
        _scrapeReport = null;
        try
        {
            _message = "Scrape gestart…";
            StateHasChanged();
            var report = await Api.RunAtsScrapeAsync();
            _scrapeReport = report;
            _message =
                $"Scrape klaar: {report.Upserted} upsert(s), {report.FailedSources} failed bron(nen), " +
                $"{report.SkippedInvalid} invalid skip(s). Alleen valide listings staan in het overzicht.";
            _statusFilter = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = "Scrape mislukt: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HealthAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var n = await Api.RunAtsHealthAsync();
            _message = $"Health-check klaar: {n} wijziging(en).";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Excerpt(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Geen omschrijving.";
        var clean = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return clean.Length <= 160 ? clean : clean[..157] + "…";
    }

    private static string FormatDescription(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "Geen vacaturetekst beschikbaar. Open de bronpagina of bewerk de velden handmatig.";
        }

        // Normalize messy scrape whitespace into readable paragraphs without losing content.
        var normalized = System.Text.RegularExpressions.Regex.Replace(text.Trim(), @"[ \t]+", " ");
        normalized = System.Text.RegularExpressions.Regex.Replace(normalized, @"\n{3,}", "\n\n");
        return normalized;
    }

    private static string SalaryDisplay(AtsListingItem row)
    {
        if (!string.IsNullOrWhiteSpace(row.SalaryText)) return row.SalaryText!;
        if (row.HourlyWage is > 0) return $"€{row.HourlyWage:0.00} / uur";
        return "—";
    }

    private static string StatusLabel(string status) => status switch
    {
        "PendingReview" => "In afwachting",
        "Approved" => "Actief",
        "Rejected" => "Afgekeurd",
        "Expired" => "Verlopen",
        "Inactive" => "Inactief",
        _ => status
    };

    private static string StatusClass(string status) => status switch
    {
        "PendingReview" => "pending",
        "Approved" => "ok",
        "Rejected" => "bad",
        "Expired" or "Inactive" => "muted",
        _ => "muted"
    };

    private static string DomainStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "ok" => "ok",
        "partial" => "pending",
        "failed" => "bad",
        _ => "muted"
    };

    private static string ScoreBand(int score) => score switch
    {
        >= 80 => "high",
        >= 50 => "mid",
        _ => "low"
    };

    public void Dispose() => Culture.Changed -= OnCultureChanged;
}
