@page "/admin/company"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Admin.CompanyDetails"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.CompanyDetails"]" Lead="@Culture["Admin.CompanyDetailsLead"]" ShowSettingsNav="true">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        <section class="panel-section">
            <div class="panel-header">
                <h2>Lobsy / Jobsy</h2>
                <button class="login-submit" type="button" disabled="@_busy" @onclick="SaveAsync">
                    @(_busy ? "Opslaan…" : "Opslaan")
                </button>
            </div>
            <p class="muted">Deze gegevens verschijnen onderaan factuur-PDF’s. Het Knab BTW-IBAN wordt gebruikt voor de geautomatiseerde BTW-buffer.</p>

            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="state-message">@_message</p>
            }

            <div class="login-form" style="max-width:36rem;margin-top:1rem;display:grid;gap:0.75rem">
                <label>
                    Bedrijfsnaam
                    <input @bind="_form.CompanyName" />
                </label>
                <label>
                    Slogan
                    <input @bind="_form.Slogan" />
                </label>
                <label>
                    Adres
                    <input @bind="_form.Address" />
                </label>
                <div style="display:grid;grid-template-columns:8rem 1fr;gap:0.75rem">
                    <label>
                        Postcode
                        <input @bind="_form.PostalCode" />
                    </label>
                    <label>
                        Plaats
                        <input @bind="_form.City" />
                    </label>
                </div>
                <label>
                    Land
                    <input @bind="_form.Country" />
                </label>
                <label>
                    KvK-nummer
                    <input @bind="_form.KvkNumber" />
                </label>
                <label>
                    BTW-nummer
                    <input @bind="_form.VatNumber" />
                </label>
                <label>
                    Knab BTW-rekening (IBAN)
                    <input @bind="_form.VatBufferIban"
                           placeholder="NL00KNAB0123456789"
                           autocomplete="off"
                           spellcheck="false" />
                </label>
                <p class="muted" style="margin:0">
                    Na elke succesvolle Mollie token-aankoop wordt het BTW-bedrag (21%) als overboeking-opdracht gelogd
                    naar dit IBAN, met het unieke factuurnummer als omschrijving/kenmerk.
                </p>
                <label>
                    Telefoon
                    <input @bind="_form.Phone" />
                </label>
                <label>
                    E-mail
                    <input type="email" @bind="_form.Email" />
                </label>
            </div>
        </section>
    }
</AdminPageShell>

@code {
    private PlatformCompanyItem _form = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;


    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _form = await Api.GetPlatformCompanyAsync() ?? new PlatformCompanyItem();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            _form = await Api.SavePlatformCompanyAsync(_form) ?? _form;
            _message = "Bedrijfsgegevens opgeslagen.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
