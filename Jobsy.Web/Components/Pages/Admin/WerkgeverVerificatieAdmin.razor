@page "/admin/werkgeververificatie"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminWa.Title"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminWa.Title"]" Lead="@Culture["AdminWa.Lead"]" Wide="true">
    <div class="filter-bar">
        <button type="button" class="@TabClass("handmatig")" @onclick="ShowManualTab">@Culture["AdminWa.Tab.Manual"]</button>
        <button type="button" class="@TabClass("gemarkeerd")" @onclick="ShowFlaggedTab">@Culture["AdminWa.Tab.Flagged"]</button>
        <button type="button" class="@TabClass("brieven")" @onclick="ShowLettersTab">@Culture["AdminWa.Tab.Letters"]</button>
        <button type="button" class="@TabClass("toegang")" @onclick="ShowAccessTab">@Culture["AdminWa.Tab.Access"]</button>
        <span class="muted">@(_tab == "toegang" ? _access.Count + _ownership.Count : _items.Count)</span>
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_tab == "toegang")
    {
        <h3>@Culture["Employer.AccessRequests"]</h3>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>Aanvrager</th>
                        <th>Rol</th>
                        <th>@Culture["AdminWa.Access.Managers"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _access)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.TargetCompanyName</strong>
                                <div class="muted">@item.KvkNumber</div>
                            </td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td>@item.RequestedRole</td>
                            <td class="data-table__col--wrap">
                                @foreach (var m in item.ManagerContacts)
                                {
                                    <div>@m.FullName · @m.Email</div>
                                }
                            </td>
                            <td>
                                <div class="inline-actions">
                                    <button class="btn-compact" type="button" @onclick="() => ApproveAccessAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => RejectAccessAsync(item)">@Culture["AdminWa.Reject"]</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>@Culture["AdminWa.Access.Ownership"]</h3>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>Aanvrager</th>
                        <th>Brief</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _ownership)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.TargetCompanyName</strong>
                                <div class="muted">@item.KvkNumber</div>
                            </td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td>@(item.LetterVerified ? Culture["AdminWa.Access.LetterOk"] : Culture["AdminWa.Access.LetterPending"])</td>
                            <td>
                                <div class="inline-actions">
                                    @if (item.LetterVerified)
                                    {
                                        <button class="btn-compact" type="button" @onclick="() => ApproveOwnershipAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>KvK</th>
                        <th>Aanvrager</th>
                        <th>Reden / status</th>
                        <th>Heuristieken</th>
                        <th>Eerdere afwijzingen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.CompanyName</strong>
                                <div class="muted">@item.KvkAddress</div>
                            </td>
                            <td>@item.KvkNumber</td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td class="data-table__col--wrap">@item.Reason</td>
                            <td>@string.Join(", ", item.Heuristics)</td>
                            <td>@item.PriorRejections</td>
                            <td>
                                <div class="inline-actions">
                                    <button class="btn-compact" type="button" @onclick="() => ApproveAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => BeginReject(item)">@Culture["AdminWa.Reject"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => SendLetterAsync(item)">@Culture["AdminWa.SendLetter"]</button>
                                    @if (item.StubLetterAvailable && item.BlockedLetterId is Guid letterId)
                                    {
                                        <a class="btn-compact" href="@Api.GetAdminStubLetterPdfUrl(letterId)" target="_blank" rel="noopener">@Culture["AdminWa.StubPdf"]</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_rejectTarget is not null)
        {
            <div class="panel admin-wa-reject">
                <h3>@Culture["AdminWa.Reject"] — @_rejectTarget.CompanyName</h3>
                <label>
                    @Culture["AdminWa.RejectReason"]
                    <input @bind="_rejectReason" maxlength="1000" />
                </label>
                <div class="inline-actions">
                    <button class="btn-compact" type="button" @onclick="ConfirmRejectAsync">@Culture["AdminWa.Reject"]</button>
                    <button class="btn-compact" type="button" @onclick="() => _rejectTarget = null">@Culture["Common.Cancel"]</button>
                </div>
            </div>
        }
    }
</AdminPageShell>

@code {
    private string _tab = "handmatig";
    private List<AdminCompanyVerificationItem> _items = [];
    private List<AccessRequestAdminItemModel> _access = [];
    private List<OwnershipTransferAdminItemModel> _ownership = [];
    private bool _loading = true;
    private string? _error;
    private AdminCompanyVerificationItem? _rejectTarget;
    private string _rejectReason = "";

    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private string TabClass(string tab)
        => "btn-compact" + (_tab == tab ? " is-active" : "");

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            _tab = TabQuery.Trim().ToLowerInvariant() switch
            {
                "toegang" or "access" => "toegang",
                "brieven" or "letters" => "brieven",
                "gemarkeerd" or "flagged" => "gemarkeerd",
                _ => "handmatig"
            };
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ShowManualTab() => await SwitchTab("handmatig");
    private async Task ShowFlaggedTab() => await SwitchTab("gemarkeerd");
    private async Task ShowLettersTab() => await SwitchTab("brieven");
    private async Task ShowAccessTab() => await SwitchTab("toegang");

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_tab == "toegang")
            {
                _access = (await Api.GetAdminEscalatedAccessRequestsAsync()).ToList();
                _ownership = (await Api.GetAdminOwnershipTransfersAsync()).ToList();
                _items = [];
            }
            else
            {
                _items = (await Api.GetAdminCompanyVerificationQueueAsync(_tab)).ToList();
                _access = [];
                _ownership = [];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(AdminCompanyVerificationItem item)
    {
        await Api.ApproveCompanyVerificationAsync(item.CompanyId, null);
        await ReloadAsync();
    }

    private void BeginReject(AdminCompanyVerificationItem item)
    {
        _rejectTarget = item;
        _rejectReason = "";
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectTarget is null || string.IsNullOrWhiteSpace(_rejectReason))
        {
            return;
        }

        await Api.RejectCompanyVerificationAsync(_rejectTarget.CompanyId, _rejectReason);
        _rejectTarget = null;
        await ReloadAsync();
    }

    private async Task SendLetterAsync(AdminCompanyVerificationItem item)
    {
        await Api.AdminSendCompanyVerificationLetterAsync(item.CompanyId);
        await ReloadAsync();
    }

    private async Task ApproveAccessAsync(AccessRequestAdminItemModel item)
    {
        await Api.ApproveAccessRequestAsync(item.RequestId, item.RequestedRole.ToString());
        await ReloadAsync();
    }

    private async Task RejectAccessAsync(AccessRequestAdminItemModel item)
    {
        await Api.RejectAccessRequestAsync(item.RequestId, "Afgewezen door Lobsy-support");
        await ReloadAsync();
    }

    private async Task ApproveOwnershipAsync(OwnershipTransferAdminItemModel item)
    {
        await Api.AdminApproveOwnershipTransferAsync(item.TakeoverId);
        await ReloadAsync();
    }
}
