@page "/admin/werkgeververificatie"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Models
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminWa.Title"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminWa.Title"]" Lead="@Culture["AdminWa.Lead"]" Wide="true">
    <div class="filter-bar">
        <button type="button" class="@TabClass("handmatig")" @onclick="ShowManualTab">@Culture["AdminWa.Tab.Manual"]</button>
        <button type="button" class="@TabClass("gemarkeerd")" @onclick="ShowFlaggedTab">@Culture["AdminWa.Tab.Flagged"]</button>
        <button type="button" class="@TabClass("brieven")" @onclick="ShowLettersTab">@Culture["AdminWa.Tab.Letters"]</button>
        <button type="button" class="@TabClass("toegang")" @onclick="ShowAccessTab">@Culture["AdminWa.Tab.Access"]</button>
        <button type="button" class="@TabClass("betrokkenheid")" @onclick="ShowEngageTab">@Culture["AdminWa.Tab.Engagement"]</button>
        <button type="button" class="@TabClass("waadi")" @onclick="ShowWaadiTab">@Culture["AdminWa.Tab.Waadi"]</button>
        <span class="muted">@(CountLabel())</span>
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_tab == "betrokkenheid")
    {
        <div class="filter-bar">
            <button type="button" class="@EngageFilterClass("queue")" @onclick='() => SetEngageFilter("queue")'>@Culture["AdminWa.Engage.Queue"]</button>
            <button type="button" class="@EngageFilterClass("noproof")" @onclick='() => SetEngageFilter("noproof")'>@Culture["AdminWa.Engage.NoProof"]</button>
            <button type="button" class="@EngageFilterClass("checked")" @onclick='() => SetEngageFilter("checked")'>@Culture["AdminWa.Engage.Checked"]</button>
            <button type="button" class="@EngageFilterClass("removed")" @onclick='() => SetEngageFilter("removed")'>@Culture["AdminWa.Engage.Removed"]</button>
            <button type="button" class="@EngageFilterClass("reports")" @onclick='() => SetEngageFilter("reports")'>@Culture["AdminWa.Engage.Reports"]</button>
            <input class="filter-bar__search" @bind="_engageSearch" @bind:event="oninput" placeholder="@Culture["AdminWa.Engage.Search"]" />
            <button type="button" class="btn-compact" @onclick="ReloadAsync">@Culture["AdminWa.Engage.Go"]</button>
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>Kenmerk</th>
                        <th>Status</th>
                        <th>Bewijs</th>
                        <th>Meldingen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _engageItems)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.CompanyName</strong>
                                <div class="muted">@item.KvkNumber</div>
                            </td>
                            <td>@item.ItemId</td>
                            <td>@item.Status @(item.CheckedSource is null ? "" : $"· {item.CheckedSource}")</td>
                            <td class="data-table__col--wrap">
                                @if (!string.IsNullOrWhiteSpace(item.ProofUrl))
                                {
                                    <a href="@item.ProofUrl" target="_blank" rel="nofollow ugc noopener">@item.ProofUrl</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ProofText))
                                {
                                    <div>@item.ProofText</div>
                                }
                            </td>
                            <td>@item.OpenReportCount</td>
                            <td>
                                <div class="inline-actions">
                                    <button class="btn-compact" type="button" @onclick="() => CheckEngageAsync(item)">@Culture["AdminWa.Engage.Check"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => BeginEngageRemove(item)">@Culture["AdminWa.Engage.Remove"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => ResetEngageAsync(item)">@Culture["AdminWa.Engage.Reset"]</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_engageRemoveTarget is not null)
        {
            <div class="panel admin-wa-reject">
                <h3>@Culture["AdminWa.Engage.Remove"] — @_engageRemoveTarget.CompanyName / @_engageRemoveTarget.ItemId</h3>
                <label>
                    @Culture["AdminWa.Engage.Reason"]
                    <input @bind="_engageRemoveReason" maxlength="500" />
                </label>
                <div class="inline-actions">
                    <button class="btn-compact" type="button" @onclick="ConfirmEngageRemoveAsync">@Culture["AdminWa.Engage.Remove"]</button>
                    <button class="btn-compact" type="button" @onclick="() => _engageRemoveTarget = null">@Culture["Common.Cancel"]</button>
                </div>
            </div>
        }
    }
    else if (_tab == "waadi")
    {
        @if (_waadiItems.Count == 0)
        {
            <p class="state-message">@Culture["AdminWa.Waadi.Empty"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Culture["AdminWa.Waadi.Bureau"]</th>
                            <th>@Culture["AdminWa.Waadi.Status"]</th>
                            <th>@Culture["AdminWa.Waadi.Source"]</th>
                            <th>@Culture["AdminWa.Waadi.Reference"]</th>
                            <th>@Culture["AdminWa.Waadi.ValidUntil"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _waadiItems)
                        {
                            <tr>
                                <td class="data-table__col--wrap">
                                    <strong>@item.CompanyName</strong>
                                    <div class="muted">@item.KvkNumber</div>
                                    @if (!string.IsNullOrWhiteSpace(item.WaadiCheckUrl))
                                    {
                                        <div>
                                            <a href="@item.WaadiCheckUrl" target="_blank" rel="noopener noreferrer">
                                                @Culture["AdminWa.Waadi.CheckLink"]
                                            </a>
                                        </div>
                                    }
                                </td>
                                <td>@item.Status</td>
                                <td>@(SourceLabel(item.Source))</td>
                                <td>@(item.Reference ?? "—")</td>
                                <td>@(item.ValidUntil?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>
                                    <div class="inline-actions">
                                        <button class="btn-compact" type="button" @onclick="() => BeginWaadiDecide(item, true)">@Culture["AdminWa.Waadi.Confirm"]</button>
                                        <button class="btn-compact" type="button" @onclick="() => BeginWaadiDecide(item, false)">@Culture["AdminWa.Waadi.Reject"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_waadiTarget is not null)
        {
            <div class="panel admin-wa-reject">
                <h3>@(_waadiApprove ? Culture["AdminWa.Waadi.Confirm"] : Culture["AdminWa.Waadi.Reject"]) — @_waadiTarget.CompanyName</h3>
                <label>
                    @Culture["AdminWa.Waadi.Reference"]
                    <input @bind="_waadiReference" maxlength="128" />
                </label>
                <label>
                    @Culture["AdminWa.Waadi.Source"]
                    <select @bind="_waadiSource">
                        <option value="WaadiKvk">@Culture["AdminWa.Waadi.Source.WaadiKvk"]</option>
                        <option value="WttaNau">@Culture["AdminWa.Waadi.Source.WttaNau"]</option>
                        <option value="AdminManual">@Culture["AdminWa.Waadi.Source.AdminManual"]</option>
                    </select>
                </label>
                <label>
                    @Culture["AdminWa.Waadi.ValidUntil"]
                    <input type="date" @bind="_waadiValidUntilDate" />
                </label>
                <label>
                    @Culture["AdminWa.Waadi.Note"]
                    <input @bind="_waadiNote" maxlength="500" />
                </label>
                @if (!_waadiApprove)
                {
                    <p class="muted">@Culture["AdminWa.Waadi.RejectReason"]</p>
                }
                <div class="inline-actions">
                    <button class="btn-compact" type="button" @onclick="ConfirmWaadiDecideAsync">
                        @(_waadiApprove ? Culture["AdminWa.Waadi.Confirm"] : Culture["AdminWa.Waadi.Reject"])
                    </button>
                    <button class="btn-compact" type="button" @onclick="() => _waadiTarget = null">@Culture["Common.Cancel"]</button>
                </div>
            </div>
        }
    }
    else if (_tab == "toegang")
    {
        <h3>@Culture["Employer.AccessRequests"]</h3>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>Aanvrager</th>
                        <th>Rol</th>
                        <th>@Culture["AdminWa.Access.Managers"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _access)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.TargetCompanyName</strong>
                                <div class="muted">@item.KvkNumber</div>
                            </td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td>@item.RequestedRole</td>
                            <td class="data-table__col--wrap">
                                @foreach (var m in item.ManagerContacts)
                                {
                                    <div>@m.FullName · @m.Email</div>
                                }
                            </td>
                            <td>
                                <div class="inline-actions">
                                    <button class="btn-compact" type="button" @onclick="() => ApproveAccessAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => RejectAccessAsync(item)">@Culture["AdminWa.Reject"]</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>@Culture["AdminWa.Access.Ownership"]</h3>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>Aanvrager</th>
                        <th>Brief</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _ownership)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.TargetCompanyName</strong>
                                <div class="muted">@item.KvkNumber</div>
                            </td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td>@(item.LetterVerified ? Culture["AdminWa.Access.LetterOk"] : Culture["AdminWa.Access.LetterPending"])</td>
                            <td>
                                <div class="inline-actions">
                                    @if (item.LetterVerified)
                                    {
                                        <button class="btn-compact" type="button" @onclick="() => ApproveOwnershipAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Bedrijf</th>
                        <th>KvK</th>
                        <th>Aanvrager</th>
                        <th>Reden / status</th>
                        <th>Heuristieken</th>
                        <th>Eerdere afwijzingen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td class="data-table__col--wrap">
                                <strong>@item.CompanyName</strong>
                                <div class="muted">@item.KvkAddress</div>
                            </td>
                            <td>@item.KvkNumber</td>
                            <td class="data-table__col--wrap">
                                @item.RequesterName
                                <div class="muted">@item.RequesterEmail</div>
                            </td>
                            <td class="data-table__col--wrap">@item.Reason</td>
                            <td>@string.Join(", ", item.Heuristics)</td>
                            <td>@item.PriorRejections</td>
                            <td>
                                <div class="inline-actions">
                                    <button class="btn-compact" type="button" @onclick="() => ApproveAsync(item)">@Culture["AdminWa.Approve"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => BeginReject(item)">@Culture["AdminWa.Reject"]</button>
                                    <button class="btn-compact" type="button" @onclick="() => SendLetterAsync(item)">@Culture["AdminWa.SendLetter"]</button>
                                    @if (item.StubLetterAvailable && item.BlockedLetterId is Guid letterId)
                                    {
                                        <a class="btn-compact" href="@Api.GetAdminStubLetterPdfUrl(letterId)" target="_blank" rel="noopener">@Culture["AdminWa.StubPdf"]</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_rejectTarget is not null)
        {
            <div class="panel admin-wa-reject">
                <h3>@Culture["AdminWa.Reject"] — @_rejectTarget.CompanyName</h3>
                <label>
                    @Culture["AdminWa.RejectReason"]
                    <input @bind="_rejectReason" maxlength="1000" />
                </label>
                <div class="inline-actions">
                    <button class="btn-compact" type="button" @onclick="ConfirmRejectAsync">@Culture["AdminWa.Reject"]</button>
                    <button class="btn-compact" type="button" @onclick="() => _rejectTarget = null">@Culture["Common.Cancel"]</button>
                </div>
            </div>
        }
    }
</AdminPageShell>

@code {
    private string _tab = "handmatig";
    private List<AdminCompanyVerificationItem> _items = [];
    private List<AccessRequestAdminItemModel> _access = [];
    private List<OwnershipTransferAdminItemModel> _ownership = [];
    private List<AdminEngagementItem> _engageItems = [];
    private List<AdminLenderRegistrationItem> _waadiItems = [];
    private string _engageFilter = "queue";
    private string _engageSearch = "";
    private AdminEngagementItem? _engageRemoveTarget;
    private string _engageRemoveReason = "";
    private AdminLenderRegistrationItem? _waadiTarget;
    private bool _waadiApprove;
    private string _waadiReference = "";
    private string _waadiSource = "WaadiKvk";
    private string _waadiNote = "";
    private DateTime? _waadiValidUntilDate;
    private bool _loading = true;
    private string? _error;
    private AdminCompanyVerificationItem? _rejectTarget;
    private string _rejectReason = "";

    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private string TabClass(string tab)
        => "btn-compact" + (_tab == tab ? " is-active" : "");

    private string EngageFilterClass(string filter)
        => "btn-compact" + (_engageFilter == filter ? " is-active" : "");

    private string CountLabel()
        => _tab switch
        {
            "toegang" => (_access.Count + _ownership.Count).ToString(),
            "betrokkenheid" => _engageItems.Count.ToString(),
            "waadi" => _waadiItems.Count.ToString(),
            _ => _items.Count.ToString()
        };

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            _tab = TabQuery.Trim().ToLowerInvariant() switch
            {
                "toegang" or "access" => "toegang",
                "brieven" or "letters" => "brieven",
                "gemarkeerd" or "flagged" => "gemarkeerd",
                "betrokkenheid" or "engagement" => "betrokkenheid",
                "waadi" or "uitleen" => "waadi",
                _ => "handmatig"
            };
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ShowManualTab() => await SwitchTab("handmatig");
    private async Task ShowFlaggedTab() => await SwitchTab("gemarkeerd");
    private async Task ShowLettersTab() => await SwitchTab("brieven");
    private async Task ShowAccessTab() => await SwitchTab("toegang");
    private async Task ShowEngageTab() => await SwitchTab("betrokkenheid");
    private async Task ShowWaadiTab() => await SwitchTab("waadi");

    private async Task SetEngageFilter(string filter)
    {
        _engageFilter = filter;
        await ReloadAsync();
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_tab == "toegang")
            {
                _access = (await Api.GetAdminEscalatedAccessRequestsAsync()).ToList();
                _ownership = (await Api.GetAdminOwnershipTransfersAsync()).ToList();
                _items = [];
                _engageItems = [];
                _waadiItems = [];
            }
            else if (_tab == "betrokkenheid")
            {
                _engageItems = (await Api.GetAdminEngagementQueueAsync(_engageFilter, _engageSearch)).ToList();
                _items = [];
                _access = [];
                _ownership = [];
                _waadiItems = [];
            }
            else if (_tab == "waadi")
            {
                _waadiItems = (await Api.GetAdminLenderRegistrationsAsync()).ToList();
                _items = [];
                _access = [];
                _ownership = [];
                _engageItems = [];
            }
            else
            {
                _items = (await Api.GetAdminCompanyVerificationQueueAsync(_tab)).ToList();
                _access = [];
                _ownership = [];
                _engageItems = [];
                _waadiItems = [];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CheckEngageAsync(AdminEngagementItem item)
    {
        await Api.AdminCheckEngagementAsync(item.ClaimId);
        await ReloadAsync();
    }

    private void BeginEngageRemove(AdminEngagementItem item)
    {
        _engageRemoveTarget = item;
        _engageRemoveReason = "";
    }

    private async Task ConfirmEngageRemoveAsync()
    {
        if (_engageRemoveTarget is null || string.IsNullOrWhiteSpace(_engageRemoveReason))
        {
            return;
        }

        await Api.AdminRemoveEngagementAsync(_engageRemoveTarget.ClaimId, _engageRemoveReason);
        _engageRemoveTarget = null;
        await ReloadAsync();
    }

    private async Task ResetEngageAsync(AdminEngagementItem item)
    {
        await Api.AdminResetEngagementAsync(item.ClaimId);
        await ReloadAsync();
    }

    private static string SourceLabel(string? source) => source switch
    {
        "WaadiKvk" => "Waadi via KvK",
        "WttaNau" => "Wtta",
        "AdminManual" => "Handmatig",
        _ => source ?? "—"
    };

    private void BeginWaadiDecide(AdminLenderRegistrationItem item, bool approve)
    {
        _waadiTarget = item;
        _waadiApprove = approve;
        _waadiReference = item.Reference ?? "";
        _waadiSource = string.IsNullOrWhiteSpace(item.Source) ? "WaadiKvk" : item.Source!;
        _waadiNote = item.Note ?? "";
        _waadiValidUntilDate = item.ValidUntil?.Date;
    }

    private async Task ConfirmWaadiDecideAsync()
    {
        if (_waadiTarget is null)
        {
            return;
        }

        if (!_waadiApprove && string.IsNullOrWhiteSpace(_waadiNote))
        {
            return;
        }

        await Api.AdminDecideLenderRegistrationAsync(
            _waadiTarget.CompanyId,
            _waadiApprove,
            _waadiSource,
            string.IsNullOrWhiteSpace(_waadiReference) ? null : _waadiReference,
            _waadiValidUntilDate,
            string.IsNullOrWhiteSpace(_waadiNote) ? null : _waadiNote);
        _waadiTarget = null;
        await ReloadAsync();
    }

    private async Task ApproveAsync(AdminCompanyVerificationItem item)
    {
        await Api.ApproveCompanyVerificationAsync(item.CompanyId, null);
        await ReloadAsync();
    }

    private void BeginReject(AdminCompanyVerificationItem item)
    {
        _rejectTarget = item;
        _rejectReason = "";
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectTarget is null || string.IsNullOrWhiteSpace(_rejectReason))
        {
            return;
        }

        await Api.RejectCompanyVerificationAsync(_rejectTarget.CompanyId, _rejectReason);
        _rejectTarget = null;
        await ReloadAsync();
    }

    private async Task SendLetterAsync(AdminCompanyVerificationItem item)
    {
        await Api.AdminSendCompanyVerificationLetterAsync(item.CompanyId);
        await ReloadAsync();
    }

    private async Task ApproveAccessAsync(AccessRequestAdminItemModel item)
    {
        await Api.ApproveAccessRequestAsync(item.RequestId, item.RequestedRole.ToString());
        await ReloadAsync();
    }

    private async Task RejectAccessAsync(AccessRequestAdminItemModel item)
    {
        await Api.RejectAccessRequestAsync(item.RequestId, "Afgewezen door Lobsy-support");
        await ReloadAsync();
    }

    private async Task ApproveOwnershipAsync(OwnershipTransferAdminItemModel item)
    {
        await Api.AdminApproveOwnershipTransferAsync(item.TakeoverId);
        await ReloadAsync();
    }
}
