@page "/admin/training"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Enums
@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["Admin.Training"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.Training"]" Lead="@Culture["Admin.TrainingLead"]" ShowSettingsNav="true">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <section class="training-admin-export">
            <h3>Maandexport lokale deals</h3>
            <p class="login-lead">Landelijke affiliates (Awin/Daisycon) lopen via hun eigen dashboard. Dit CSV matcht anonieme hashes voor Den Haag / Westland.</p>
            <div class="masterdata-row__fields" style="grid-template-columns: 8rem 8rem auto;">
                <label>
                    Jaar
                    <input type="number" @bind="_year" />
                </label>
                <label>
                    Maand
                    <input type="number" min="1" max="12" @bind="_month" />
                </label>
                <button class="login-submit" type="button" disabled="@_busy" @onclick="ExportAsync">Download CSV</button>
            </div>
            <form class="training-admin-match" @onsubmit="MatchAsync" @onsubmit:preventDefault="true">
                <h3>Conversie matchen</h3>
                <label>
                    Click-id
                    <input @bind="_clickId" />
                </label>
                <label>
                    Candidate hash
                    <input @bind="_candidateHash" />
                </label>
                <label>
                    E-mail bij inschrijving (wordt gehasht)
                    <input type="email" @bind="_email" autocomplete="off" />
                </label>
                <label>
                    Soort
                    <select @bind="_kind">
                        <option value="0">Lead (brochure / intake)</option>
                        <option value="1">Gestarte cursist</option>
                    </select>
                </label>
                <button class="provider-btn" type="submit" disabled="@_busy">Registreer</button>
            </form>
        </section>

        @foreach (var provider in _providers)
        {
            <article class="table-row masterdata-row">
                <h3>@provider.Name <small>@provider.Kind · @provider.Network · @provider.Region</small></h3>
                <p>@provider.BaseUrl</p>
                <p>Velden: @provider.FieldsCsv</p>
                <p>
                    CPL € @(provider.CplEuro?.ToString("0.##") ?? "—")
                    · CPA € @(provider.CpaEuro?.ToString("0.##") ?? "—")
                    · Intake € @(provider.IntakeFeeEuro?.ToString("0.##") ?? "—")
                    · Start € @(provider.StartFeeEuro?.ToString("0.##") ?? "—")
                </p>
                <ul>
                    @foreach (var offer in provider.Offers)
                    {
                        <li>
                            <button type="button" class="training-offers__link" @onclick="() => BeginEdit(offer)">
                                @offer.Title
                            </button>
                            (@offer.FieldsCsv)
                            @if (offer.ShowInPassport)
                            {
                                <span class="status-pill">paspoort</span>
                            }
                            @if (offer.IsFree)
                            {
                                <span class="status-pill">@Culture["Admin.Training.IsFree"]</span>
                            }
                            @if (offer.IsPartner)
                            {
                                <span class="status-pill">@Culture["Admin.Training.IsPartner"]</span>
                            }
                        </li>
                    }
                </ul>
            </article>
        }

        @if (_edit is not null)
        {
            <section class="detail-card" aria-labelledby="training-offer-edit-title">
                <h3 id="training-offer-edit-title">@Culture["Admin.Training.EditOffer"]</h3>
                <p><strong>@_edit.Title</strong></p>
                <div class="masterdata-row__fields">
                    <label>
                        @Culture["Admin.Training.Type"]
                        <select @bind="_editType">
                            <option value="Opleiding">Opleiding</option>
                            <option value="Cursus">Cursus</option>
                            <option value="Workshop">Workshop</option>
                        </select>
                    </label>
                    <label>
                        @Culture["Admin.Training.Duration"]
                        <input type="number" min="1" @bind="_editDurationValue" />
                    </label>
                    <label>
                        Eenheid
                        <select @bind="_editDurationUnit">
                            <option value="">—</option>
                            <option value="Hours">uren</option>
                            <option value="Days">dagen</option>
                            <option value="Weeks">weken</option>
                            <option value="Months">maanden</option>
                            <option value="Years">jaren</option>
                        </select>
                    </label>
                    <label>
                        @Culture["Admin.Training.Delivery"]
                        <select @bind="_editDelivery">
                            <option value="Online">Online</option>
                            <option value="OnSite">Op locatie</option>
                            <option value="Blended">Blended</option>
                        </select>
                    </label>
                    <label>
                        @Culture["Admin.Training.Location"]
                        <input @bind="_editLocation" />
                    </label>
                    <label>
                        Deeplink
                        <input @bind="_editPath" />
                    </label>
                    <label>
                        <input type="checkbox" @bind="_editIsFree" />
                        @Culture["Admin.Training.IsFree"]
                    </label>
                    <label>
                        <input type="checkbox" @bind="_editIsPartner" />
                        @Culture["Admin.Training.IsPartner"]
                    </label>
                    <label>
                        @Culture["Admin.Training.AffiliateCode"]
                        <input @bind="_editAffiliate" />
                    </label>
                    <label>
                        <input type="checkbox" @bind="_editShowInPassport" />
                        @Culture["Admin.Training.ShowInPassport"]
                    </label>
                    <label>
                        <input type="checkbox" @bind="_editIsActive" />
                        Actief
                    </label>
                </div>
                <button type="button" class="login-submit" disabled="@_busy" @onclick="SaveOfferAsync">
                    @Culture["Admin.Training.SaveOffer"]
                </button>
            </section>
        }
    }
</AdminPageShell>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private List<TrainingProviderAdmin> _providers = [];
    private int _year = DateTime.UtcNow.Year;
    private int _month = DateTime.UtcNow.Month;
    private string _clickId = "";
    private string _candidateHash = "";
    private string _email = "";
    private string _kind = "0";

    private TrainingOfferAdmin? _edit;
    private string _editType = "Cursus";
    private int? _editDurationValue;
    private string _editDurationUnit = "";
    private string _editDelivery = "Online";
    private string _editLocation = "";
    private string _editPath = "";
    private bool _editIsFree;
    private bool _editIsPartner;
    private string _editAffiliate = "";
    private bool _editShowInPassport;
    private bool _editIsActive = true;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override Task OnInitializedAsync()
        => LoadAsync();

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _providers = await Api.GetTrainingProvidersAdminAsync();
        }
        catch
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginEdit(TrainingOfferAdmin offer)
    {
        _edit = offer;
        _editType = string.IsNullOrWhiteSpace(offer.Type) ? "Cursus" : offer.Type;
        _editDurationValue = offer.DurationValue;
        _editDurationUnit = offer.DurationUnit ?? "";
        _editDelivery = string.IsNullOrWhiteSpace(offer.Delivery) ? "Online" : offer.Delivery;
        _editLocation = offer.Location ?? "";
        _editPath = offer.ExternalPath ?? "";
        _editIsFree = offer.IsFree;
        _editIsPartner = offer.IsPartner;
        _editAffiliate = offer.AffiliateCode ?? "";
        _editShowInPassport = offer.ShowInPassport;
        _editIsActive = offer.IsActive;
        _message = null;
    }

    private async Task SaveOfferAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            Enum.TryParse<TrainingOfferType>(_editType, true, out var type);
            TrainingDurationUnit? unit = Enum.TryParse<TrainingDurationUnit>(_editDurationUnit, true, out var u) ? u : null;
            Enum.TryParse<TrainingDeliveryMode>(_editDelivery, true, out var delivery);

            await Api.UpsertTrainingOfferAdminAsync(new
            {
                id = _edit.Id,
                providerId = _edit.ProviderId,
                title = _edit.Title,
                fieldsCsv = _edit.FieldsCsv,
                keysCsv = _edit.KeysCsv,
                externalPath = _editPath,
                isActive = _editIsActive,
                sortOrder = _edit.SortOrder,
                type = type.ToString(),
                durationValue = _editDurationValue,
                durationUnit = unit?.ToString(),
                delivery = delivery.ToString(),
                location = string.IsNullOrWhiteSpace(_editLocation) ? null : _editLocation,
                isFree = _editIsFree,
                isPartner = _editIsPartner,
                affiliateCode = string.IsNullOrWhiteSpace(_editAffiliate) ? null : _editAffiliate,
                showInPassport = _editShowInPassport
            });
            _message = "Opgeslagen.";
            _edit = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = string.IsNullOrWhiteSpace(ex.Message) ? Culture["Common.Error"] : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var csv = await Api.ExportTrainingCsvAsync(_year, _month, null);
            await Js.InvokeVoidAsync("jobsyDownload.text", $"lobsy-opleidingen-{_year:D4}-{_month:D2}.csv", csv, "text/csv");
        }
        catch (Exception ex)
        {
            _message = string.IsNullOrWhiteSpace(ex.Message) ? Culture["Common.Error"] : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MatchAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            Guid? clickId = Guid.TryParse(_clickId, out var id) ? id : null;
            await Api.RecordTrainingConversionAsync(new
            {
                clickId,
                candidateHash = string.IsNullOrWhiteSpace(_candidateHash) ? null : _candidateHash.Trim(),
                email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                kind = _kind == "1" ? "Started" : "Lead"
            });
            _message = "Conversie vastgelegd.";
        }
        catch (Exception ex)
        {
            _message = string.IsNullOrWhiteSpace(ex.Message) ? Culture["Common.Error"] : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
