@page "/admin/instellingen/integraties"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["AdminNav.Integrations"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Integrations"]" Wide="true">
    <AdminTabs BasePath="/admin/instellingen/integraties" @bind-ActiveKey="_tab" Tabs="_tabs" />
    @if (_tab == "api")
    {
        <ApiKeysSection />
    }
    else
    {
        <IntegrationsSection />
    }
</AdminPageShell>

@code {
    private string _tab = "integraties";
    private List<AdminTabs.Tab> _tabs = [];

    protected override void OnInitialized()
    {
        _tabs =
        [
            new("integraties", Culture["AdminTabs.Integrations"]),
            new("api", Culture["AdminTabs.ApiKeys"]),
        ];
        _tab = ReadTab();
    }

    protected override void OnParametersSet() => _tab = ReadTab();

    private string ReadTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("tab", out var v)
            && string.Equals(v.ToString(), "api", StringComparison.OrdinalIgnoreCase))
        {
            return "api";
        }

        return "integraties";
    }
}
