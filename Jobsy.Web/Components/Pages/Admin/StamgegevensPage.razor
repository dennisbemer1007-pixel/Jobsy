@page "/admin/content/stamgegevens"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["AdminNav.Masterdata"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Masterdata"]">
    <AdminTabs BasePath="/admin/content/stamgegevens" @bind-ActiveKey="_tab" Tabs="_tabs" />
    @if (_tab == "exclusiviteit")
    {
        <ExclusivitySection />
    }
    else
    {
        <MasterdataSection />
    }
</AdminPageShell>

@code {
    private string _tab = "stamgegevens";
    private List<AdminTabs.Tab> _tabs = [];

    protected override void OnInitialized()
    {
        _tabs =
        [
            new("stamgegevens", Culture["AdminTabs.Masterdata"]),
            new("exclusiviteit", Culture["AdminTabs.Exclusivity"]),
        ];
        _tab = ReadTab();
    }

    protected override void OnParametersSet() => _tab = ReadTab();

    private string ReadTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("tab", out var v)
            && string.Equals(v.ToString(), "exclusiviteit", StringComparison.OrdinalIgnoreCase))
        {
            return "exclusiviteit";
        }

        return "stamgegevens";
    }
}
