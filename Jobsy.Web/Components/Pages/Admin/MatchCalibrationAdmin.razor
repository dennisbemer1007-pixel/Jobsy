@page "/admin/match-calibration"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Contracts
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules

<PageTitle>Match kalibratie · Lobsy</PageTitle>

<AdminPageShell Title="Match kalibratie (V1)" Lead="Vergelijk legacy scores met MatchCalibrationV1. Zet de feature aan via Platforminstellingen.">
    <section class="panel-section">
        <p class="muted">
            Acceptatie-only vergelijking. Logging: <code>MatchCalibrationV1 compare</code> in platform logs wanneer de flag aan staat.
        </p>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Scenario</th>
                        <th>Legacy %</th>
                        <th>Fit (raw) %</th>
                        <th>Betrouwbaarheid %</th>
                        <th>Weergave %</th>
                        <th>Band</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id — @row.Label</td>
                            <td>@row.Legacy</td>
                            <td>@(row.FitRaw?.ToString() ?? "—")</td>
                            <td>@(row.Confidence?.ToString() ?? "—")</td>
                            <td><strong>@row.Display</strong></td>
                            <td>@row.Band</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</AdminPageShell>

@code {
    private readonly List<CompareRow> _rows = [];

    protected override void OnInitialized()
    {
        _rows.Add(Compare("S1", "Geen tests, reis/uren onbekend, zelfde sector", BuildS1()));
        _rows.Add(Compare("S2", "Horeca × Zorg, tests ~80%", BuildS2()));
        _rows.Add(Compare("S3", "Retail × retail, deep career", BuildS3()));
        _rows.Add(Compare("S4", "Reis/uren mismatch", BuildS4()));
        _rows.Add(Compare("S5", "Broad admin (Multidimensional)", BuildS5()));
    }

    private static CompareRow Compare(string id, string label, ProfileVacancyMatchInput input)
    {
        var legacy = ProfileVacancyMatchCalculator.CalculateLegacy(input);
        var v1 = ProfileVacancyMatchCalculator.Calculate(input, useMatchCalibrationV1: true);
        return new CompareRow(
            id,
            label,
            legacy.TotalPercent,
            v1.FitRawPercent,
            v1.ConfidencePercent,
            v1.TotalPercent,
            v1.ColorBand);
    }

    private sealed record CompareRow(
        string Id,
        string Label,
        int Legacy,
        int? FitRaw,
        int? Confidence,
        int Display,
        string Band);

    // Mirrors MatchCalibrationV1ScenarioTests inputs (doc §4.3).
    private static ProfileVacancyMatchInput BuildS1() => new()
    {
        VacancyId = Guid.NewGuid(),
        VacancyTitle = "Magazijnmedewerker",
        WorkTypes = ["Logistiek"],
        CandidateRoles = ["Logistiek medewerker"],
        Core = new MatchScoreInput
        {
            VacancyHours = new HoursRange(32, 40),
            VacancySchedule = SchedulePayload.Flexible(FlexibleScheduleSource.Manual),
            CandidateAgeYears = 22
        }
    };

