@page "/admin/financien/goodwill"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminNav.Goodwill"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Goodwill"]" Lead="@Culture["AdminFinance.GoodwillLead"]" Wide="true">
    <GoodwillGrantSection Granted="OnGrantedAsync" />
    <div style="margin-block-start:1.25rem">
        <GoodwillHistorySection @ref="_history" />
    </div>
</AdminPageShell>

@code {
    private GoodwillHistorySection? _history;

    protected override void OnInitialized() => Culture.Changed += OnCultureChanged;
    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    private async Task OnGrantedAsync()
    {
        if (_history is not null)
        {
            await _history.ReloadAsync();
        }
    }
}
