@page "/admin/beveiliging"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using System.Globalization
@using System.Text.Json
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["AdminNav.AuditLog"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.AuditLog"]" Lead="@Culture["AdminAudit.Lead"]">
    <Actions>
        <button type="button" class="btn-compact" disabled="@_busy" @onclick="ExportAsync">
            @Culture["AdminAudit.ExportCsv"]
        </button>
    </Actions>
    <ChildContent>
    <BeveiligingTabs ActiveKey="audit" />

    <div class="admin-security-layout">
        <div class="admin-security-layout__main">
            <AdminFilterBar>
                <input type="search"
                       class="admin-filter-input"
                       placeholder="@Culture["AdminAudit.SearchPlaceholder"]"
                       value="@_q"
                       @oninput="OnSearchInput" />
                <select class="admin-filter-select" @bind="_action" @bind:after="ReloadAsync">
                    <option value="">@Culture["AdminAudit.Filter.ActionAll"]</option>
                    @foreach (var a in ActionOptions)
                    {
                        <option value="@a">@ActionLabel(a)</option>
                    }
                </select>
                <select class="admin-filter-select" @bind="_period" @bind:after="ReloadAsync">
                    <option value="7">@Culture["AdminAudit.Period.7d"]</option>
                    <option value="30">@Culture["AdminAudit.Period.30d"]</option>
                    <option value="90">@Culture["AdminAudit.Period.90d"]</option>
                    <option value="all">@Culture["AdminAudit.Period.All"]</option>
                </select>
                <select class="admin-filter-select" @bind="_result" @bind:after="ReloadAsync">
                    <option value="">@Culture["AdminAudit.Filter.ResultAll"]</option>
                    <option value="success">@Culture["AdminAudit.Result.Success"]</option>
                    <option value="denied">@Culture["AdminAudit.Result.Denied"]</option>
                    <option value="failed">@Culture["AdminAudit.Result.Failed"]</option>
                </select>
            </AdminFilterBar>

            <AdminDataTable Loading="_loading" Empty="@(_page?.Items.Count == 0)" EmptyText="@Culture["AdminAudit.Empty"]">
                <Header>
                    <th scope="col">@Culture["AdminAudit.Col.Time"]</th>
                    <th scope="col">@Culture["AdminAudit.Col.Actor"]</th>
                    <th scope="col">@Culture["AdminAudit.Col.Action"]</th>
                    <th scope="col">@Culture["AdminAudit.Col.Object"]</th>
                    <th scope="col">@Culture["AdminAudit.Col.Result"]</th>
                    <th scope="col">@Culture["AdminAudit.Col.Correlation"]</th>
                </Header>
                <Rows>
                    @if (_page is not null)
                    {
                        @foreach (var row in _page.Items)
                        {
                            <tr class="admin-audit-row" @onclick="() => OpenDrawer(row)">
                                <td class="admin-mono">@FormatAmsterdam(row.OccurredAtUtc)</td>
                                <td>@row.ActorDisplayName</td>
                                <td><span class="status-pill @ActionPillClass(row.Action)">@ActionLabel(row.Action)</span></td>
                                <td class="admin-audit-object" title="@ObjectTitle(row)">
                                    <span>@row.TargetLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(row.Reason))
                                    {
                                        <span class="muted"> · @row.Reason</span>
                                    }
                                </td>
                                <td>
                                    <span class="admin-result admin-result--@row.Result">
                                        <span class="admin-result__dot" aria-hidden="true"></span>
                                        @ResultLabel(row.Result)
                                    </span>
                                </td>
                                <td class="admin-mono">
                                    <button type="button" class="admin-copy-btn" title="@Culture["AdminAudit.CopyCorrelation"]"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => CopyAsync(row.CorrelationId)">
                                        @ShortCorrelation(row.CorrelationId)
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </Rows>
            </AdminDataTable>

            @if (_page is not null)
            {
                <AdminPager Page="_page.Page" PageSize="_page.PageSize" TotalCount="_page.TotalCount"
                            PageChanged="OnPageChanged" />
            }
        </div>

        <aside class="admin-security-layout__side">
            <section class="detail-card" aria-labelledby="support-active-heading">
                <div class="admin-dash__card-head">
                    <h2 id="support-active-heading">@Culture["AdminAudit.ActiveSupport"]</h2>
                    @if (_grants.Count > 0)
                    {
                        <span class="admin-count-pill">@_grants.Count</span>
                    }
                </div>
                @if (_grants.Count == 0)
                {
                    <p class="muted">@Culture["AdminAudit.ActiveSupportEmpty"]</p>
                }
                else
                {
                    <ul class="admin-support-list">
                        @foreach (var g in _grants)
                        {
                            <li>
                                <p>@Short(g.AdminUserId) → @(g.SubjectUserId is Guid su ? Short(su) : "—")</p>
                                <p class="muted">@Remaining(g.ExpiresAt) · @g.Reason</p>
                                <button type="button" class="btn-compact btn-compact--danger-outline" disabled="@_busy"
                                        @onclick="() => RevokeGrantAsync(g.Id)">
                                    @Culture["Admin.SupportAccessRevoke"]
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="detail-card" aria-labelledby="privacy-summary-heading">
                <h2 id="privacy-summary-heading">@Culture["AdminNav.Privacy"]</h2>
                @if (_summary is not null)
                {
                    <ul class="admin-mode-list">
                        <li class="admin-mode-list__row">
                            <span>@Culture["AdminAudit.MaskingOn"]</span>
                            <span class="status-pill status-pill--success">@Culture["AdminAudit.On"]</span>
                        </li>
                        <li class="admin-mode-list__row">
                            <span>@Culture["AdminAudit.RetentionJob"]</span>
                            <span class="muted">@Culture["AdminAudit.RetentionSchedule"]</span>
                        </li>
                        <li class="admin-mode-list__row">
                            <span>@Culture["AdminAudit.LastRetention"]</span>
                            <span class="muted">@(_summary.LastRetentionRunUtc is DateTime lr ? FormatAmsterdam(lr) : "—")</span>
                        </li>
                    </ul>
                }
            </section>

            <section class="detail-card" aria-labelledby="admins-mfa-heading">
                <h2 id="admins-mfa-heading">@Culture["AdminAudit.Admins"]</h2>
                @if (_summary is not null)
                {
                    <ul class="admin-mode-list">
                        <li class="admin-mode-list__row">
                            <span>@Culture["AdminAudit.WithMfa"]</span>
                            <span class="status-pill status-pill--success">@_summary.AdminsWithMfa / @_summary.AdminsTotal</span>
                        </li>
                    </ul>
                }
            </section>
        </aside>
    </div>
    </ChildContent>
</AdminPageShell>

<AdminDrawer Open="_drawerOpen" Title="@Culture["AdminAudit.DrawerTitle"]" OpenChanged="OnDrawerOpenChanged">
    @if (_selected is not null)
    {
        <dl class="admin-audit-detail">
            <div><dt>@Culture["AdminAudit.Col.Time"]</dt><dd class="admin-mono">@FormatAmsterdam(_selected.OccurredAtUtc)</dd></div>
            <div><dt>@Culture["AdminAudit.Col.Actor"]</dt><dd>@_selected.ActorDisplayName (@_selected.ActorRole)</dd></div>
            <div><dt>@Culture["AdminAudit.Col.Action"]</dt><dd><span class="status-pill @ActionPillClass(_selected.Action)">@ActionLabel(_selected.Action)</span></dd></div>
            <div><dt>@Culture["AdminAudit.Col.Object"]</dt><dd>@_selected.TargetLabel</dd></div>
            <div><dt>@Culture["AdminAudit.Col.Result"]</dt><dd>@ResultLabel(_selected.Result)</dd></div>
            <div><dt>@Culture["AdminAudit.Reason"]</dt><dd>@(_selected.Reason ?? "—")</dd></div>
            <div><dt>@Culture["AdminAudit.Col.Correlation"]</dt><dd class="admin-mono">@_selected.CorrelationId</dd></div>
        </dl>
        @if (ParseDetails(_selected.DetailsJson) is { Count: > 0 } details)
        {
            <h3>@Culture["AdminAudit.Changes"]</h3>
            <ul class="admin-audit-changes">
                @foreach (var d in details)
                {
                    <li><span class="admin-mono">@d.Field</span>: <span class="muted">@d.From</span> → <strong>@d.To</strong></li>
                }
            </ul>
        }
    }
</AdminDrawer>

@code {
    private static readonly string[] ActionOptions =
    [
        "settings.platform.update", "maintenance.on", "maintenance.off",
        "user.mfa.reset", "support-access.grant", "support-access.revoke",
        "user.block", "user.unblock", "tokens.goodwill.grant", "export.create", "privacy.retention.run"
    ];

    private AdminAuditPage? _page;
    private AdminAuditSummary? _summary;
    private List<SupportAccessGrantItem> _grants = [];
    private bool _loading = true;
    private bool _busy;
    private string _q = "";
    private string _action = "";
    private string _period = "7";
    private string _result = "";
    private int _pageNum = 1;
    private bool _drawerOpen;
    private AdminAuditItem? _selected;
    private System.Threading.Timer? _searchDebounce;

    protected override void OnInitialized() => Culture.Changed += OnCultureChanged;
    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _searchDebounce?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("q", out var qRaw) && !string.IsNullOrWhiteSpace(qRaw))
        {
            _q = qRaw.ToString()!;
        }

        await ReloadAsync();
        try
        {
            _summary = await Api.GetAdminAuditSummaryAsync();
            _grants = (await Api.ListSupportAccessAsync(activeOnly: true)).ToList();
        }
        catch { /* side panels optional */ }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var (from, to) = PeriodRange(_period);
            _page = await Api.GetAdminAuditAsync(
                from: from, to: to, action: NullIfEmpty(_action), result: NullIfEmpty(_result),
                q: NullIfEmpty(_q), page: _pageNum, pageSize: 25);
        }
        catch
        {
            _page = new AdminAuditPage();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.Timer(async _ =>
        {
            _pageNum = 1;
            await InvokeAsync(ReloadAsync);
        }, null, 300, Timeout.Infinite);
    }

    private async Task OnPageChanged(int page)
    {
        _pageNum = page;
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            var (from, to) = PeriodRange(_period);
            var bytes = await Api.ExportAdminAuditCsvAsync(from, to, NullIfEmpty(_action), NullIfEmpty(_result), NullIfEmpty(_q));
            var b64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync("jobsySaveFile", "lobsy-audit.csv", b64, "text/csv");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeGrantAsync(Guid id)
    {
        _busy = true;
        try
        {
            await Api.RevokeSupportAccessAsync(id);
            _grants = (await Api.ListSupportAccessAsync(activeOnly: true)).ToList();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenDrawer(AdminAuditItem row)
    {
        _selected = row;
        _drawerOpen = true;
    }

    private Task OnDrawerOpenChanged(bool open)
    {
        _drawerOpen = open;
        return Task.CompletedTask;
    }

    private async Task CopyAsync(string value)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", value); } catch { }
    }

    private static (DateTime? from, DateTime? to) PeriodRange(string period) =>
        period switch
        {
            "7" => (DateTime.UtcNow.AddDays(-7), null),
            "30" => (DateTime.UtcNow.AddDays(-30), null),
            "90" => (DateTime.UtcNow.AddDays(-90), null),
            _ => (null, null)
        };

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static string FormatAmsterdam(DateTime utc)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "W. Europe Standard Time" : "Europe/Amsterdam");
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz)
            .ToString("dd-MM-yyyy HH:mm", CultureInfo.GetCultureInfo("nl-NL"));
    }

    private static string ShortCorrelation(string id)
        => id.Length <= 9 ? id : id[..4] + "-" + id[^4..];

    private static string Short(Guid id) => id.ToString("N")[..6];

    private static string Remaining(DateTime expiresAt)
    {
        var mins = Math.Max(0, (int)(expiresAt.ToUniversalTime() - DateTime.UtcNow).TotalMinutes);
        return $"Nog {mins} min";
    }

    private string ObjectTitle(AdminAuditItem row)
        => string.IsNullOrWhiteSpace(row.Reason) ? row.TargetLabel : $"{row.TargetLabel} — {row.Reason}";

    private string ActionLabel(string action) => action switch
    {
        "user.mfa.reset" => Culture["AdminAudit.Action.MfaReset"],
        "support-access.grant" or "support-access.revoke" => Culture["AdminAudit.Action.Support"],
        "settings.platform.update" or "maintenance.on" or "maintenance.off" => Culture["AdminAudit.Action.Setting"],
        "export.create" => Culture["AdminAudit.Action.Export"],
        "user.block" or "user.unblock" => Culture["AdminAudit.Action.Block"],
        "tokens.goodwill.grant" => Culture["AdminAudit.Action.Tokens"],
        "privacy.account.deleted" => Culture["AdminAudit.Action.Deleted"],
        "auth.admin.login-failed" => Culture["AdminAudit.Action.LoginFailed"],
        _ => action
    };

    private static string ActionPillClass(string action) => action switch
    {
        "user.mfa.reset" or "privacy.account.deleted" or "auth.admin.login-failed" => "status-pill--danger",
        "support-access.grant" or "support-access.revoke" or "user.sessions.revoke" or "user.sessions.revoke-all" or "user.block" or "user.unblock"
            => "status-pill--warn",
        "settings.platform.update" or "settings.pricing.update" or "settings.company.update" or "tokens.goodwill.grant" or "user.role.change"
            => "status-pill--info",
        _ => ""
    };

    private string ResultLabel(string result) => result switch
    {
        "success" => Culture["AdminAudit.Result.Success"],
        "denied" => Culture["AdminAudit.Result.Denied"],
        _ => Culture["AdminAudit.Result.Failed"]
    };

    private static List<(string Field, string? From, string? To)> ParseDetails(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("field", out var field))
            {
                return [(field.GetString() ?? "?", root.TryGetProperty("from", out var f) ? f.ToString() : null,
                    root.TryGetProperty("to", out var t) ? t.ToString() : null)];
            }

            return root.EnumerateObject()
                .Select(p => (p.Name, (string?)null, (string?)p.Value.ToString()))
                .ToList();
        }
        catch
        {
            return [];
        }
    }
}
