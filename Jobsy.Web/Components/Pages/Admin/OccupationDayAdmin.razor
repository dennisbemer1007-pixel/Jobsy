@page "/admin/content/dag-in-het-leven"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Careers
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Localization
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["AdminNav.DayInLife"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.DayInLife"]" Lead="@Culture["Admin.Day.Lead"]">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_status is null)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <p>@Culture.Format("Admin.Day.Stored", _status.Stored, _status.Total, _status.Remaining)</p>
        @if (_status.Running)
        {
            <p class="login-lead">@Culture.Format("Admin.Day.Running", _status.GeneratedThisRun, _status.FailedThisRun)</p>
        }
        @if (!string.IsNullOrWhiteSpace(_status.LastError))
        {
            <p class="state-message">@Describe(_status.LastError)</p>
        }

        <label>
            @Culture["Admin.Day.Pick"]
            <textarea rows="5" @bind="_pick" placeholder="@Culture["Admin.Day.PickLead"]"></textarea>
        </label>
        <p class="login-lead">@Culture["Admin.Day.PickLead"]</p>

        <div class="masterdata-row__fields">
            <button class="login-submit" type="button" disabled="@(_busy || _status.Running)" @onclick="StartAsync">@Culture["Admin.Day.Start"]</button>
            <button class="provider-btn" type="button" disabled="@(_busy || _status.Running)" @onclick="ChunkAsync">@Culture["Admin.Day.Chunk"]</button>
            <button class="provider-btn" type="button" disabled="@(_busy || _status.Running)" @onclick="ProbeAsync">@Culture["Admin.Day.Probe"]</button>
            <button class="provider-btn" type="button" disabled="@(_busy || _status.Running)" @onclick="RegenerateAsync">@Culture["Admin.Day.Regenerate"]</button>
            <button class="provider-btn" type="button" disabled="@_busy" @onclick="StopAsync">@Culture["Admin.Day.Stop"]</button>
            <button class="provider-btn" type="button" disabled="@_busy" @onclick="ExportAsync">@Culture["Admin.Day.Export"]</button>
        </div>
        <label>
            @Culture["Admin.Day.Import"]
            <InputFile OnChange="ImportAsync" accept=".json,application/json" />
        </label>
    }
</AdminPageShell>

@code {
    private OccupationDayAdminStatus? _status;
    private string? _message;
    private string? _pick;
    private bool _busy;
    private bool _polling;
    private CancellationTokenSource? _poll;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (_status?.Running == true)
        {
            StartPolling();
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _status = await Api.GetOccupationDayStatusAsync();
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Common.Error"];
        }
    }

    private async Task StartAsync()
        => await BeginRunAsync(null);

    private async Task ChunkAsync()
        => await BeginRunAsync(10);

    private async Task BeginRunAsync(int? limit)
    {
        _busy = true;
        _message = null;
        try
        {
            var start = await Api.StartOccupationDayBatchAsync(limit, string.IsNullOrWhiteSpace(_pick) ? null : _pick);
            if (start?.Busy == true)
            {
                _message = Culture["Admin.Day.Busy"];
            }
            else if (!string.IsNullOrWhiteSpace(start?.Message) && start.Started != true)
            {
                _message = start.Message;
            }
            else
            {
                _message = Culture["Admin.Day.Started"];
                if (start?.Titles is { Count: > 0 })
                {
                    _message = _message + " " + string.Join(", ", start.Titles.Take(8));
                }

                await RefreshAsync();
                StartPolling();
            }
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Admin.Day.Timeout"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_pick))
            {
                _message = Culture["Admin.Day.PickEmpty"];
                return;
            }

            var result = await Api.RegenerateOccupationDaysAsync(15, _pick);
            if (result is null)
            {
                _message = Culture["Common.Error"];
            }
            else
            {
                _message = Culture.Format("Admin.Day.Summary", result.Generated, result.Failed);
                await RefreshAsync();
            }
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ProbeAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var query = FirstPick(_pick);
            if (query.Length == 0)
            {
                _message = Culture["Admin.Day.PickEmpty"];
                return;
            }

            var result = await Api.ProbeOccupationDayAsync(query);
            if (result is null)
            {
                _message = Culture["Common.Error"];
            }
            else if (result.Ok)
            {
                _message = Culture.Format("Admin.Day.ProbeOk", result.TitleNl ?? query);
            }
            else
            {
                _message = Describe(result.Error);
            }
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Admin.Day.Timeout"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopAsync()
    {
        _busy = true;
        try
        {
            await Api.StopOccupationDayBatchAsync();
            await RefreshAsync();
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            await Api.DownloadOccupationDayExportAsync(Js);
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        _busy = true;
        _message = null;
        try
        {
            await using var stream = args.File.OpenReadStream(20_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var result = await Api.ImportOccupationDaysAsync(json);
            _message = result is null
                ? Culture["Common.Error"]
                : $"{result.Inserted} nieuw, {result.Updated} bijgewerkt, {result.Unchanged} gelijk, {result.Rejected} afgekeurd.";
            await RefreshAsync();
        }
        catch (Exception ex) when (!Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
            _message = Culture["Common.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartPolling()
    {
        _poll?.Cancel();
        _poll = new CancellationTokenSource();
        _polling = true;
        _ = PollAsync(_poll.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && _polling)
            {
                await Task.Delay(3000, cancellationToken);
                await RefreshAsync();
                if (_status is not { Running: true })
                {
                    if (_status is not null)
                    {
                        _message = Culture.Format("Admin.Day.Summary", _status.GeneratedThisRun, _status.FailedThisRun);
                        if (!string.IsNullOrWhiteSpace(_status.LastError))
                        {
                            _message = _message + " " + Describe(_status.LastError);
                        }
                    }

                    await InvokeAsync(StateHasChanged);
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException
            || Jobsy.Web.Hosting.CircuitInterop.IsCircuitGone(ex))
        {
        }
    }

    private string Describe(string? error)
    {
        var value = error ?? "";
        if (value.StartsWith(OccupationDayWriteErrors.KeyMissing, StringComparison.Ordinal))
        {
            return Culture["Admin.Day.Key"];
        }

        if (value.StartsWith(OccupationDayWriteErrors.KeyInvalid, StringComparison.Ordinal))
        {
            return Culture["Admin.Day.KeyInvalid"];
        }

        if (value.StartsWith(OccupationDayWriteErrors.Timeout, StringComparison.Ordinal)
            || value.Contains("timeout", StringComparison.OrdinalIgnoreCase))
        {
            return Culture["Admin.Day.Timeout"];
        }

        if (value.StartsWith("openai-http-", StringComparison.Ordinal))
        {
            var code = value["openai-http-".Length..];
            var colon = code.IndexOf(':');
            if (colon >= 0)
            {
                code = code[..colon];
            }

            return Culture.Format("Admin.Day.Http", code.Trim());
        }

        if (value.StartsWith("onbekend-beroep", StringComparison.Ordinal))
        {
            return Culture["Day.Unknown"];
        }

        return value;
    }

    private static string FirstPick(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "";
        }

        return raw.Split([',', ';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault() ?? "";
    }

    public void Dispose()
    {
        _polling = false;
        _poll?.Cancel();
        _poll?.Dispose();
    }
}
