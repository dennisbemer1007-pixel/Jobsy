@page "/admin/vacatures/categorieen"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["AdminNav.CategoriesWages"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.CategoriesWages"]">
    <AdminTabs BasePath="/admin/vacatures/categorieen"
               @bind-ActiveKey="_tab"
               Tabs="_tabs" />
    @if (_tab == "salaris")
    {
        <WagesSection />
    }
    else
    {
        <VacancyCategoriesSection />
    }
</AdminPageShell>

@code {
    private string _tab = "categorieen";
    private List<AdminTabs.Tab> _tabs = [];

    protected override void OnInitialized()
    {
        _tabs =
        [
            new("categorieen", Culture["AdminTabs.Categories"]),
            new("salaris", Culture["AdminTabs.Wages"]),
        ];
        _tab = ReadTab();
    }

    protected override void OnParametersSet() => _tab = ReadTab();

    private string ReadTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("tab", out var v)
            && string.Equals(v.ToString(), "salaris", StringComparison.OrdinalIgnoreCase))
        {
            return "salaris";
        }

        return "categorieen";
    }
}
