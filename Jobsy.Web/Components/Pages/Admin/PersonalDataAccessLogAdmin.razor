@page "/admin/personal-data-access-log"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Admin.PersonalDataAccessLog"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.PersonalDataAccessLog"]" Lead="@Culture["Admin.PersonalDataAccessLogLead"]" ShowSettingsNav="true">
    <div class="filter-bar">
        <label>
            Actor user id
            <input type="text" @bind="_actorIdText" placeholder="guid" />
        </label>
        <label>
            Subject user id
            <input type="text" @bind="_subjectIdText" placeholder="guid" />
        </label>
        <label>
            Van
            <input type="date" @bind="_fromDate" />
        </label>
        <label>
            Tot
            <input type="date" @bind="_toDate" />
        </label>
        <button class="provider-btn" type="button" disabled="@_loading" @onclick="ReloadAsync">Filter</button>
        <span class="muted">@_page?.TotalCount logs</span>
    </div>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <p class="state-message">Geen access logs gevonden.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Actor</th>
                        <th>Rol</th>
                        <th>Subject</th>
                        <th>Resource</th>
                        <th>Action</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _page.Items)
                    {
                        <tr>
                            <td>@log.OccurredAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                            <td class="muted">@Short(log.ActorUserId)</td>
                            <td>@log.ActorRole</td>
                            <td class="muted">@(log.SubjectUserId is Guid s ? Short(s) : "—")</td>
                            <td>@log.Resource</td>
                            <td>@log.Action</td>
                            <td class="muted">@(log.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="filter-bar">
            <button class="provider-btn" type="button" disabled="@(_pageNumber <= 1 || _loading)" @onclick="() => GoPageAsync(_pageNumber - 1)">Vorige</button>
            <button class="provider-btn" type="button" disabled="@(!HasNext || _loading)" @onclick="() => GoPageAsync(_pageNumber + 1)">Volgende</button>
        </div>
    }
</AdminPageShell>

@code {
    private PersonalDataAccessLogPage? _page;
    private string _actorIdText = "";
    private string _subjectIdText = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading = true;
    private string? _error;
    private int _pageNumber = 1;

    private bool HasNext =>
        _page is not null && (_page.Page * _page.PageSize) < _page.TotalCount;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task GoPageAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            Guid? actor = Guid.TryParse(_actorIdText, out var a) ? a : null;
            Guid? subject = Guid.TryParse(_subjectIdText, out var s) ? s : null;
            DateTime? from = _fromDate?.ToUniversalTime();
            DateTime? to = _toDate?.Date.AddDays(1).AddTicks(-1).ToUniversalTime();
            _page = await Api.GetPersonalDataAccessLogAsync(
                page: _pageNumber,
                pageSize: 50,
                actorUserId: actor,
                subjectUserId: subject,
                fromUtc: from,
                toUtc: to);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Short(Guid id) => id.ToString("D")[..8] + "…";
}
