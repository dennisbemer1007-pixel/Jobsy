@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using System.Security.Claims
@inject JobsyApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<PageTitle>@Culture["Admin.Users"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.Users"]" Lead="@Culture["Admin.UsersLead"]" ShowSettingsNav="true">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_page is not null)
    {
        @if (!string.IsNullOrEmpty(_toast))
        {
            <p class="state-message" role="status">@_toast</p>
        }

        <div class="filter-bar">
            <div class="muted">
                Actief @_page.Aggregates.ActiveCount · Inactief @_page.Aggregates.InactiveCount
            </div>
            @foreach (var role in _page.Aggregates.ByRole.OrderByDescending(kv => kv.Value).Take(8))
            {
                <span class="muted">@role.Key: @role.Value</span>
            }
        </div>

        <div class="filter-bar">
            <label>
                @Culture["Common.Search"]
                <input type="search" @bind="_query" @bind:event="oninput" placeholder="@Culture["Admin.SearchPlaceholder"]" />
            </label>
            <label>
                Rol
                <select @bind="_roleFilter">
                    <option value="">Alle</option>
                    @foreach (var role in _page.Aggregates.ByRole.Keys.OrderBy(r => r))
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </label>
            <label>
                Type bedrijf
                <select @bind="_typeFilter">
                    <option value="">Alle</option>
                    <option value="Employer">Employer</option>
                    <option value="Intermediary">Intermediary</option>
                    <option value="none">Geen bedrijf</option>
                </select>
            </label>
            <label class="filter-check">
                <input type="checkbox" @bind="_earlyOnly" />
                Alleen early adapters
            </label>
            <button class="provider-btn" type="button" disabled="@_loading" @onclick="ReloadAsync">Filter</button>
            <span class="muted">@_page.TotalCount gebruikers · pagina @_page.Page</span>
        </div>

        <p class="muted">
            @Culture["Admin.UsersMaskedHint"]
        </p>

        @if (_activeGrant is not null)
        {
            <p class="state-message">
                @string.Format(Culture["Admin.SupportAccessBanner"], _activeGrant.SubjectLabel, _activeGrant.ExpiresAt.ToLocalTime().ToString("HH:mm"), _activeGrant.Reason)
                <button class="provider-btn" type="button" disabled="@_busy" @onclick="RevokeActiveAsync">@Culture["Admin.SupportAccessRevoke"]</button>
            </p>
        }

        @if (_page.Items.Count == 0)
        {
            <p class="state-message">Geen gebruikers gevonden.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>E-mail</th>
                            <th>Rol</th>
                            <th>Bedrijf / type</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _page.Items)
                        {
                            <tr>
                                <td><strong>@u.FullName</strong></td>
                                <td>@u.Email</td>
                                <td>@u.Role</td>
                                <td>
                                    @if (u.CompanyName is not null)
                                    {
                                        <text>@u.CompanyName <span class="muted">(@u.CompanyType)</span></text>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsEarlyAdapter)
                                    {
                                        <span class="status-pill">Early</span>
                                    }
                                    <span class="status-pill @(u.MfaStatus == "enrolled" ? "status-pill--accepted" : null)">
                                        @MfaStatusLabel(u.MfaStatus)
                                    </span>
                                </td>
                                <td class="data-table__col--actions">
                                    <RowActionsMenu>
                                        <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenSupport(u)">
                                            @Culture["Admin.WhySeeThis"]
                                        </button>
                                        @if (u.MfaStatus == "enrolled" && u.Id != _currentAdminId)
                                        {
                                            <button class="row-actions-menu__item" type="button" role="menuitem" @onclick="() => OpenMfaReset(u)">
                                                @Culture["Mfa.AdminReset"]
                                            </button>
                                        }
                                    </RowActionsMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <SupportAccessDialog IsOpen="_supportOpen"
                                 SubjectUserId="_supportSubjectId"
                                 OnClose="CloseSupport"
                                 OnGranted="OnGrantedAsync" />

            <LobsyFriendlyDialog IsOpen="_mfaResetOpen"
                                 Title="@Culture["Mfa.AdminReset"]"
                                 TitleId="mfa-reset-title"
                                 Lead="@Culture["Mfa.AdminResetLead"]"
                                 OnClose="CloseMfaReset">
                <label class="feedback-dialog__field">
                    <span>@Culture["Mfa.AdminResetReason"]</span>
                    <textarea rows="3" maxlength="500" @bind="_mfaResetReason" @bind:event="oninput" required></textarea>
                </label>
                @if (_localPasswordAdmin)
                {
                    <label class="feedback-dialog__field">
                        <span>@Culture["Mfa.AdminResetConfirm"]</span>
                        <input type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               @bind="_mfaResetConfirmCode"
                               @bind:event="oninput" />
                    </label>
                }
                @if (!string.IsNullOrEmpty(_mfaResetError))
                {
                    <p class="state-message error">@_mfaResetError</p>
                }
                <div class="inline-actions">
                    <button type="button" class="provider-btn" disabled="@_busy" @onclick="ConfirmMfaResetAsync">
                        @Culture["Mfa.AdminReset"]
                    </button>
                    <button type="button" class="provider-btn provider-btn--ghost" disabled="@_busy" @onclick="CloseMfaReset">
                        @Culture["Common.Close"]
                    </button>
                </div>
            </LobsyFriendlyDialog>

            <div class="filter-bar">
                <button class="provider-btn" type="button" disabled="@(_page.Page <= 1 || _loading)" @onclick="() => GoPageAsync(_page.Page - 1)">Vorige</button>
                <button class="provider-btn" type="button" disabled="@(!HasNext || _loading)" @onclick="() => GoPageAsync(_page.Page + 1)">Volgende</button>
            </div>
        }
    }
</AdminPageShell>

@code {
    private AdminUsersPage? _page;
    private string _query = "";
    private string _roleFilter = "";
    private string _typeFilter = "";
    private bool _earlyOnly;
    private bool _loading = true;
    private string? _error;
    private string? _toast;
    private Guid? _companyIdFilter;
    private int _pageNumber = 1;
    private const int PageSize = 50;
    private bool _supportOpen;
    private Guid? _supportSubjectId;
    private bool _busy;
    private ActiveGrantBanner? _activeGrant;
    private Guid _currentAdminId;
    private bool _localPasswordAdmin = true;
    private bool _mfaResetOpen;
    private Guid? _mfaResetUserId;
    private string _mfaResetReason = "";
    private string _mfaResetConfirmCode = "";
    private string? _mfaResetError;

    private bool HasNext =>
        _page is not null && (_page.Page * _page.PageSize) < _page.TotalCount;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        if (Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        {
            _currentAdminId = id;
        }

        var authMethod = user.FindFirstValue("auth_method") ?? "";
        _localPasswordAdmin = !authMethod.StartsWith("external", StringComparison.OrdinalIgnoreCase);

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("companyId", out var companyRaw)
            && Guid.TryParse(companyRaw, out var companyId))
        {
            _companyIdFilter = companyId;
        }

        await ReloadAsync();
    }

    private string MfaStatusLabel(string status) => status switch
    {
        "enrolled" => Culture["Mfa.StatusEnrolled"],
        "external-only" => Culture["Mfa.StatusExternal"],
        _ => Culture["Mfa.StatusNotEnrolled"]
    };

    private async Task GoPageAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await Api.GetAdminUsersPageAsync(
                page: _pageNumber,
                pageSize: PageSize,
                q: _query,
                role: _roleFilter,
                companyType: _typeFilter,
                companyId: _companyIdFilter,
                earlyOnly: _earlyOnly);
            await RefreshActiveGrantAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenSupport(AdminUserItem user)
    {
        _supportSubjectId = user.Id;
        _supportOpen = true;
    }

    private Task CloseSupport()
    {
        _supportOpen = false;
        return Task.CompletedTask;
    }

    private void OpenMfaReset(AdminUserItem user)
    {
        _mfaResetUserId = user.Id;
        _mfaResetReason = "";
        _mfaResetConfirmCode = "";
        _mfaResetError = null;
        _mfaResetOpen = true;
    }

    private Task CloseMfaReset()
    {
        _mfaResetOpen = false;
        _mfaResetUserId = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmMfaResetAsync()
    {
        if (_mfaResetUserId is not Guid userId)
        {
            return;
        }

        var reason = _mfaResetReason.Trim();
        if (reason.Length < 5)
        {
            _mfaResetError = Culture["Mfa.AdminResetReason"];
            return;
        }

        _busy = true;
        _mfaResetError = null;
        try
        {
            await Api.ResetUserMfaAsync(
                userId,
                reason,
                _localPasswordAdmin ? _mfaResetConfirmCode : null);
            _toast = Culture["Mfa.AdminResetSuccess"];
            await CloseMfaReset();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _mfaResetError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnGrantedAsync(SupportAccessGrantItem grant)
    {
        _activeGrant = new ActiveGrantBanner(
            grant.Id,
            grant.SubjectUserId?.ToString("D")[..8] + "…" ?? "—",
            grant.ExpiresAt,
            grant.Reason);
        await ReloadAsync();
    }

    private async Task RefreshActiveGrantAsync()
    {
        var grants = await Api.ListSupportAccessAsync(activeOnly: true, take: 20);
        var mine = grants.FirstOrDefault(g => g.IsActive && g.SubjectUserId is not null);
        _activeGrant = mine is null
            ? null
            : new ActiveGrantBanner(
                mine.Id,
                mine.SubjectUserId!.Value.ToString("D")[..8] + "…",
                mine.ExpiresAt,
                mine.Reason);
    }

    private async Task RevokeActiveAsync()
    {
        if (_activeGrant is null) return;
        _busy = true;
        try
        {
            await Api.RevokeSupportAccessAsync(_activeGrant.Id);
            _activeGrant = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record ActiveGrantBanner(Guid Id, string SubjectLabel, DateTime ExpiresAt, string Reason);
}
