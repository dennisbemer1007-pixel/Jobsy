@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Admin.Users"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["Admin.Users"]" Lead="@Culture["Admin.UsersLead"]" ShowSettingsNav="true">
    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_page is not null)
    {
        <div class="filter-bar">
            <div class="muted">
                Actief @_page.Aggregates.ActiveCount · Inactief @_page.Aggregates.InactiveCount
            </div>
            @foreach (var role in _page.Aggregates.ByRole.OrderByDescending(kv => kv.Value).Take(8))
            {
                <span class="muted">@role.Key: @role.Value</span>
            }
        </div>

        <div class="filter-bar">
            <label>
                @Culture["Common.Search"]
                <input type="search" @bind="_query" @bind:event="oninput" placeholder="@Culture["Admin.SearchPlaceholder"]" />
            </label>
            <label>
                Rol
                <select @bind="_roleFilter">
                    <option value="">Alle</option>
                    @foreach (var role in _page.Aggregates.ByRole.Keys.OrderBy(r => r))
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </label>
            <label>
                Type bedrijf
                <select @bind="_typeFilter">
                    <option value="">Alle</option>
                    <option value="Employer">Employer</option>
                    <option value="Intermediary">Intermediary</option>
                    <option value="none">Geen bedrijf</option>
                </select>
            </label>
            <label class="filter-check">
                <input type="checkbox" @bind="_earlyOnly" />
                Alleen early adapters
            </label>
            <button class="provider-btn" type="button" disabled="@_loading" @onclick="ReloadAsync">Filter</button>
            <span class="muted">@_page.TotalCount gebruikers · pagina @_page.Page</span>
        </div>

        <p class="muted">
            @Culture["Admin.UsersMaskedHint"]
            <button class="provider-btn" type="button" disabled title="@Culture["Admin.SupportAccessSoon"]">
                @Culture["Admin.WhySeeThis"]
            </button>
        </p>

        @if (_page.Items.Count == 0)
        {
            <p class="state-message">Geen gebruikers gevonden.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>E-mail</th>
                            <th>Rol</th>
                            <th>Bedrijf / type</th>
                            <th>Early adapter</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _page.Items)
                        {
                            <tr>
                                <td><strong>@u.FullName</strong></td>
                                <td>@u.Email</td>
                                <td>@u.Role</td>
                                <td>
                                    @if (u.CompanyName is not null)
                                    {
                                        <text>@u.CompanyName <span class="muted">(@u.CompanyType)</span></text>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>@(u.IsEarlyAdapter ? "Ja" : "Nee")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="filter-bar">
                <button class="provider-btn" type="button" disabled="@(_page.Page <= 1 || _loading)" @onclick="() => GoPageAsync(_page.Page - 1)">Vorige</button>
                <button class="provider-btn" type="button" disabled="@(!HasNext || _loading)" @onclick="() => GoPageAsync(_page.Page + 1)">Volgende</button>
            </div>
        }
    }
</AdminPageShell>

@code {
    private AdminUsersPage? _page;
    private string _query = "";
    private string _roleFilter = "";
    private string _typeFilter = "";
    private bool _earlyOnly;
    private bool _loading = true;
    private string? _error;
    private Guid? _companyIdFilter;
    private int _pageNumber = 1;
    private const int PageSize = 50;

    private bool HasNext =>
        _page is not null && (_page.Page * _page.PageSize) < _page.TotalCount;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("companyId", out var companyRaw)
            && Guid.TryParse(companyRaw, out var companyId))
        {
            _companyIdFilter = companyId;
        }

        await ReloadAsync();
    }

    private async Task GoPageAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await Api.GetAdminUsersPageAsync(
                page: _pageNumber,
                pageSize: PageSize,
                q: _query,
                role: _roleFilter,
                companyType: _typeFilter,
                companyId: _companyIdFilter,
                earlyOnly: _earlyOnly);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
