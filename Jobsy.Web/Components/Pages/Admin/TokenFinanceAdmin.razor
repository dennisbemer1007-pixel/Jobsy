@page "/admin/financien/uitbetalingen"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Privacy
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["AdminNav.Payouts"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Payouts"]" Lead="@Culture["AdminFinance.PayoutsLead"]" Wide="true">
    <AdminTabs BasePath="/admin/financien/uitbetalingen" ActiveKey="@_tab" Tabs="_tabs" />

    @if (_tab != "declarations" && _tab != "uitbetalingen")
    {
        <div class="filter-bar" style="margin-top:1rem;align-items:flex-end">
            <label>
                @Culture["AdminFinance.Year"]
                <select @bind="_year" @bind:after="ReloadAsync">
                    @foreach (var y in Years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </label>
            <label>
                @Culture["AdminFinance.Quarter"]
                <select @bind="_quarter" @bind:after="ReloadAsync">
                    <option value="0">@Culture["AdminFinance.WholeYear"]</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
            </label>
            <button class="btn-compact" type="button" disabled="@_loading" @onclick="ReloadAsync">@Culture["AdminFinance.Refresh"]</button>
            <button class="btn-compact btn-compact--primary" type="button" @onclick="OpenWizardAsync">
                @Culture["AdminFinance.VatWizard"]
            </button>
            <span class="muted">@_rowCount @Culture["AdminFinance.Rows"]</span>
        </div>
    }
    else if (_tab == "declarations")
    {
        <div class="filter-bar" style="margin-top:1rem;align-items:flex-end">
            <button class="btn-compact" type="button" disabled="@_loading" @onclick="ReloadAsync">@Culture["AdminFinance.Refresh"]</button>
            <button class="btn-compact btn-compact--primary" type="button" @onclick="OpenWizardAsync">
                @Culture["AdminFinance.VatWizard"]
            </button>
            <span class="muted">@_rowCount @Culture["AdminFinance.Rows"]</span>
        </div>
    }

    @if (_tab == "uitbetalingen")
    {
        <FinancePayoutsSection />
    }
    else if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else if (_tab == "smcosts")
    {
        <div class="panel-section" style="margin-bottom:1rem">
            <strong>@Culture["AdminFinance.SmCostsTitle"]</strong>
            <p class="muted" style="margin:0.25rem 0 0">@Culture["AdminFinance.SmCostsLead"]</p>
        </div>
        @if (_smCosts.Count == 0)
        {
            <p class="state-message">@Culture["AdminFinance.NoSmCosts"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Culture["AdminFinance.Col.Paid"]</th>
                            <th>@Culture["AdminFinance.Col.Invoice"]</th>
                            <th>@Culture["AdminFinance.Col.Payee"]</th>
                            <th>Ex-BTW</th>
                            <th>BTW</th>
                            <th>Totaal</th>
                            <th>BTW-behandeling</th>
                            <th>@Culture["AdminFinance.Col.Status"]</th>
                            <th>Aangifte-status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _smCosts)
                        {
                            <tr>
                                <td>@(row.PaidAt?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "—")</td>
                                <td><code class="admin-mono">@row.InvoiceNumber</code></td>
                                <td>@PersonalDataMasker.MaskName(row.SalesManagerCompanyName)</td>
                                <td>€ @row.SubtotalExVat.ToString("0.00")</td>
                                <td>€ @row.VatAmount.ToString("0.00")</td>
                                <td>€ @row.TotalInclVat.ToString("0.00")</td>
                                <td>@FormatVatTreatment(row.VatTreatment)</td>
                                <td>@row.Status</td>
                                <td class="muted">@(row.VatDeclarationStatusLabel ?? "Openstaand")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted" style="margin-top:0.75rem">
                Som ex-BTW € @_smCosts.Sum(p => p.SubtotalExVat).ToString("0.00") ·
                BTW € @_smCosts.Sum(p => p.VatAmount).ToString("0.00")
            </p>
        }
    }
    else if (_tab == "vat")
    {
        @if (_vatTransfers.Count == 0)
        {
            <p class="state-message">@Culture["AdminFinance.NoVatTransfers"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Culture["AdminFinance.Col.Date"]</th>
                            <th>@Culture["AdminFinance.Col.Invoice"]</th>
                            <th>IBAN</th>
                            <th>BTW-bedrag</th>
                            <th>@Culture["AdminFinance.Col.Status"]</th>
                            <th>Notitie</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _vatTransfers)
                        {
                            <tr>
                                <td>@row.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                                <td><code class="admin-mono">@row.InvoiceNumber</code></td>
                                <td>@row.DestinationIbanMasked</td>
                                <td>€ @row.AmountEuro.ToString("0.00")</td>
                                <td>@row.Status</td>
                                <td class="muted">@row.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        @if (_declarations.Count == 0)
        {
            <p class="state-message">@Culture["AdminFinance.NoDeclarations"]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Periode</th>
                            <th>Gegenereerd</th>
                            <th>Bedrijf</th>
                            <th>Rubriek 1 BTW</th>
                            <th>Rubriek 5 voorbelasting</th>
                            <th>Te betalen / ontvangen</th>
                            <th>Transacties</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _declarations)
                        {
                            <tr>
                                <td><strong>@row.PeriodLabel</strong></td>
                                <td>
                                    @row.GeneratedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                    <span class="muted">@(row.GeneratedByName is null ? "" : $" · {row.GeneratedByName}")</span>
                                </td>
                                <td>@row.PlatformCompanyName</td>
                                <td>€ @CentsToEuro(row.Rubriek1VatCents)</td>
                                <td>€ @CentsToEuro(row.Rubriek5VoorbelastingCents)</td>
                                <td>
                                    @(row.AmountDueCents >= 0 ? "Te betalen" : "Terug")
                                    € @CentsToEuro(Math.Abs(row.AmountDueCents))
                                </td>
                                <td class="muted">
                                    @row.TokenInvoiceCount verkopen ·
                                    @row.SalesManagerInvoiceCount SM ·
                                    @row.GoodwillCount goodwill
                                </td>
                                <td>
                                    <button class="btn-compact" type="button" disabled="@(_exportBusy || !row.HasPdf)"
                                            @onclick="() => DownloadDeclarationPdfAsync(row)">PDF</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</AdminPageShell>

@if (_wizardOpen)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="@Culture["AdminFinance.VatWizard"]"
                         TitleId="vat-wizard-title"
                         Lead="@Culture["AdminFinance.VatWizardLead"]"
                         Style="max-width:32rem"
                         OnClose="CloseWizard">

        <div class="login-form" style="display:grid;gap:0.75rem">
            <label>
                Aangifteperiode
                <select @bind="_wizardPeriodKey" @bind:after="OnWizardPeriodChangedAsync" disabled="@_wizardBusy">
                    @if (_openPeriods.Count == 0)
                    {
                        <option value="">Geen periodes geladen</option>
                    }
                    @foreach (var p in _openPeriods)
                    {
                        <option value="@($"{p.Year}-{p.Quarter}")">
                            @p.PeriodLabel
                            @(p.HasOpenItems ? $" ({p.OpenTokenInvoiceCount} verkopen / {p.OpenSalesManagerInvoiceCount} SM)" : " — geen openstaande regels")
                        </option>
                    }
                </select>
            </label>

            @if (_wizardPreview is not null)
            {
                <div class="panel-section" style="background:var(--accent-soft);padding:0.75rem;border-radius:var(--radius-sm)">
                    <p style="margin:0"><strong>Rubriek 1</strong> — omzet ex. BTW € @CentsToEuro(_wizardPreview.Rubriek1OmzetExVatCents), verschuldigde BTW € @CentsToEuro(_wizardPreview.Rubriek1VatCents) (@_wizardPreview.TokenInvoiceCount facturen)</p>
                    <p style="margin:0.35rem 0 0"><strong>Rubriek 5</strong> — voorbelasting € @CentsToEuro(_wizardPreview.Rubriek5VoorbelastingCents) (@_wizardPreview.SalesManagerInvoiceCount uitbetalingen)</p>
                    <p style="margin:0.35rem 0 0">Goodwill in periode: @_wizardPreview.GoodwillCount</p>
                    <p style="margin:0.5rem 0 0">
                        <strong>
                            @(_wizardPreview.AmountDueCents >= 0 ? "Te betalen" : "Terug te ontvangen"):
                            € @CentsToEuro(Math.Abs(_wizardPreview.AmountDueCents))
                        </strong>
                    </p>
                    @if (_wizardPreview.AlreadyDeclared)
                    {
                        <p class="state-message" style="margin:0.5rem 0 0">Alle openstaande BTW-regels voor deze periode zijn al verwerkt.</p>
                    }
                    else if (_wizardPreview.TokenInvoiceCount == 0 && _wizardPreview.SalesManagerInvoiceCount == 0)
                    {
                        <p class="muted" style="margin:0.5rem 0 0">Geen openstaande verkoop- of inkoopregels om te verwerken@( _wizardPreview.GoodwillCount > 0 ? $" ({_wizardPreview.GoodwillCount} goodwill, geen omzet)." : ".")</p>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_wizardError))
            {
                <p class="state-message error">@_wizardError</p>
            }

            <div class="inline-actions" style="margin-top:0.5rem">
                <button type="button" class="btn-compact btn-compact--primary"
                        disabled="@(_wizardBusy || _wizardPreview is null || _wizardPreview.AlreadyDeclared || (_wizardPreview.TokenInvoiceCount == 0 && _wizardPreview.SalesManagerInvoiceCount == 0))"
                        @onclick="ConfirmWizardAsync">
                    @(_wizardBusy ? "Genereren…" : "Genereer")
                </button>
                <button type="button" class="btn-compact" disabled="@_wizardBusy" @onclick="CloseWizard">@Culture["Common.Cancel"]</button>
            </div>
        </div>
    </LobsyFriendlyDialog>
}

@code {
    private static readonly int[] Years =
        Enumerable.Range(DateTime.UtcNow.Year - 2, 4).Reverse().ToArray();

    private string _tab = "uitbetalingen";
    private List<AdminTabs.Tab> _tabs = [];
    private int _year = DateTime.UtcNow.Year;
    private int _quarter;
    private bool _loading = true;
    private bool _exportBusy;
    private string? _error;
    private List<VatBufferTransferItem> _vatTransfers = [];
    private List<SalesManagerCostFinanceItem> _smCosts = [];
    private List<VatDeclarationListItem> _declarations = [];

    private bool _wizardOpen;
    private bool _wizardBusy;
    private string? _wizardError;
    private string _wizardPeriodKey = "";
    private List<VatOpenPeriodItem> _openPeriods = [];
    private VatDeclarationPreviewItem? _wizardPreview;

    private int _rowCount => _tab switch
    {
        "vat" => _vatTransfers.Count,
        "smcosts" => _smCosts.Count,
        "declarations" => _declarations.Count,
        _ => 0
    };

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        _tabs =
        [
            new("uitbetalingen", Culture["AdminFinance.Tab.Payouts"]),
            new("smcosts", Culture["AdminFinance.Tab.SmCosts"]),
            new("vat", Culture["AdminFinance.Tab.VatBuffer"]),
            new("declarations", Culture["AdminFinance.Tab.VatFiling"]),
        ];
        RedirectGoodwillIfNeeded();
        _tab = ReadTab();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        if (_tab != "uitbetalingen")
        {
            await ReloadAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private void RedirectGoodwillIfNeeded()
    {
        var qs = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (qs.TryGetValue("tab", out var tab)
            && string.Equals(tab.ToString(), "goodwill", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/admin/financien/goodwill", replace: true);
        }
    }

    private string ReadTab()
    {
        var qs = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (qs.TryGetValue("tab", out var tab))
        {
            var key = tab.ToString();
            if (string.Equals(key, "goodwill", StringComparison.OrdinalIgnoreCase))
            {
                return "uitbetalingen";
            }
            // Legacy purchases tab → omzet
            if (string.Equals(key, "purchases", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/admin/financien?tab=transacties", replace: true);
                return "uitbetalingen";
            }
            if (_tabs.Any(t => string.Equals(t.Key, key, StringComparison.OrdinalIgnoreCase)))
            {
                return key.ToLowerInvariant();
            }
        }

        return "uitbetalingen";
    }

    private async Task ReloadAsync()
    {
        if (_tab == "uitbetalingen")
        {
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            var year = _year;
            int? quarter = _quarter == 0 ? null : _quarter;
            if (_tab == "smcosts")
            {
                _smCosts = (await Api.GetSalesManagerCostsAsync(year, quarter)).ToList();
            }
            else if (_tab == "declarations")
            {
                _declarations = (await Api.GetVatDeclarationsAsync()).ToList();
            }
            else
            {
                _vatTransfers = (await Api.GetVatBufferTransfersAsync(year, quarter)).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenWizardAsync()
    {
        _wizardOpen = true;
        _wizardError = null;
        _wizardPreview = null;
        _wizardBusy = true;
        try
        {
            _openPeriods = (await Api.GetVatOpenPeriodsAsync()).ToList();
            var preferred = _openPeriods.FirstOrDefault(p => p.HasOpenItems) ?? _openPeriods.FirstOrDefault();
            if (preferred is not null)
            {
                _wizardPeriodKey = $"{preferred.Year}-{preferred.Quarter}";
                await LoadWizardPreviewAsync(preferred.Year, preferred.Quarter);
            }
        }
        catch (Exception ex)
        {
            _wizardError = ex.Message;
        }
        finally
        {
            _wizardBusy = false;
        }
    }

    private void CloseWizard()
    {
        if (_wizardBusy) return;
        _wizardOpen = false;
        _wizardError = null;
    }

    private async Task OnWizardPeriodChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(_wizardPeriodKey)) return;
        var parts = _wizardPeriodKey.Split('-');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var y) || !int.TryParse(parts[1], out var q))
        {
            return;
        }

        await LoadWizardPreviewAsync(y, q);
    }

    private async Task LoadWizardPreviewAsync(int year, int quarter)
    {
        _wizardBusy = true;
        _wizardError = null;
        try
        {
            _wizardPreview = await Api.PreviewVatDeclarationAsync(year, quarter);
        }
        catch (Exception ex)
        {
            _wizardError = ex.Message;
            _wizardPreview = null;
        }
        finally
        {
            _wizardBusy = false;
        }
    }

    private async Task ConfirmWizardAsync()
    {
        if (_wizardPreview is null) return;
        _wizardBusy = true;
        _wizardError = null;
        try
        {
            var created = await Api.GenerateVatDeclarationAsync(_wizardPreview.Year, _wizardPreview.Quarter);
            _wizardOpen = false;
            Nav.NavigateTo("/admin/financien/uitbetalingen?tab=declarations", replace: true);
            _tab = "declarations";
            await ReloadAsync();
            if (created is not null && created.HasPdf)
            {
                await Api.DownloadVatDeclarationPdfAsync(Js, created.Id, created.PeriodLabel);
            }
        }
        catch (Exception ex)
        {
            _wizardError = ex.Message;
        }
        finally
        {
            _wizardBusy = false;
        }
    }

    private async Task DownloadDeclarationPdfAsync(VatDeclarationListItem row)
    {
        _exportBusy = true;
        try
        {
            await Api.DownloadVatDeclarationPdfAsync(Js, row.Id, row.PeriodLabel);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _exportBusy = false;
        }
    }

    private static string CentsToEuro(int cents) => (cents / 100m).ToString("0.00");

    private static string FormatVatTreatment(string treatment) => treatment switch
    {
        "Standard21" => "21% inkoop-btw",
        "ReverseCharge" => "BTW-verlegging",
        "Exempt" => "Vrijgesteld",
        _ => treatment
    };
}
