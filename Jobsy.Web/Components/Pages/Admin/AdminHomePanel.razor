@using Jobsy.Web.Components.Shared
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Platform dashboard</h1>
            <p class="login-lead">KPI’s over het hele platform — klik een tegel voor drilldown.</p>
        </div>
        <div class="period-tabs" role="tablist" aria-label="Periode">
            @foreach (var p in Periods)
            {
                <button type="button"
                        class="period-tab @(_period == p.Key ? "period-tab--active" : null)"
                        role="tab"
                        aria-selected="@(_period == p.Key)"
                        disabled="@_loading"
                        @onclick="() => SetPeriodAsync(p.Key)">
                    @p.Label
                </button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="state-message error">@_error</p>
    }
    else if (_loading && _metrics.Count == 0)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <div class="stat-grid">
            @foreach (var metric in _metrics)
            {
                <MetricTile Label="@metric.Label"
                            FormattedValue="@FormatValue(metric)"
                            Selected="@(_selectedKey == metric.Key)"
                            OnClick="() => SelectMetricAsync(metric.Key)" />
            }
        </div>

        @if (_selectedKey is not null)
        {
            <DrilldownGrid Title="@SelectedLabel"
                           OverviewHref="@ListHrefFor(_selectedKey)"
                           Loading="@_drillLoading"
                           Items="_drilldown" />
        }

        <section class="panel-section">
            <h2>Modules</h2>
            <div class="admin-hub__grid" role="list">
                @foreach (var tile in AdminNavItems.All.Where(t => t.Href != "/home"))
                {
                    <a class="admin-tile" href="@tile.Href" role="listitem">
                        <span class="admin-tile__icon" aria-hidden="true">@((MarkupString)tile.Svg)</span>
                        <span class="admin-tile__label">@Culture[tile.TitleKey]</span>
                    </a>
                }
            </div>
        </section>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Periods =
    [
        ("day", "Dag"),
        ("week", "Week"),
        ("month", "Maand")
    ];

    private string _period = "week";
    private string? _selectedKey;
    private bool _loading = true;
    private bool _drillLoading;
    private string? _error;
    private List<MetricCount> _metrics = [];
    private List<MetricDrilldownItem> _drilldown = [];

    private string SelectedLabel =>
        _metrics.FirstOrDefault(m => m.Key == _selectedKey)?.Label ?? _selectedKey ?? "";

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
        => await LoadSummaryAsync();

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private static string FormatValue(MetricCount metric)
        => metric.Key.StartsWith("tokens_", StringComparison.OrdinalIgnoreCase)
            ? metric.Value.ToString("0.##")
            : metric.Value.ToString("0");

    private async Task SetPeriodAsync(string period)
    {
        if (_period == period) return;
        _period = period;
        await LoadSummaryAsync();
        if (_selectedKey is not null)
        {
            await LoadDrilldownAsync(_selectedKey);
        }
    }

    private async Task SelectMetricAsync(string key)
    {
        if (_selectedKey == key)
        {
            _selectedKey = null;
            _drilldown = [];
            return;
        }

        _selectedKey = key;
        await LoadDrilldownAsync(key);
    }

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _metrics = (await Api.GetEmployerMetricsSummaryAsync(_period)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _metrics = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadDrilldownAsync(string key)
    {
        _drillLoading = true;
        try
        {
            _drilldown = (await Api.GetEmployerMetricsDrilldownAsync(key, _period)).ToList();
        }
        catch
        {
            _drilldown = [];
        }
        finally
        {
            _drillLoading = false;
        }
    }

    private static string ListHrefFor(string key) => key.ToLowerInvariant() switch
    {
        "errors" => "/admin/logging?level=Error",
        "companies_employers" => "/admin/companies?type=Employer",
        "companies_intermediaries" => "/admin/companies?type=Intermediary",
        "users_open_for_work" or "users_active" => "/admin/users",
        "tokens_purchased" or "tokens_spent" or "pushboms" or "extensions" => "/admin/finance?tab=tokenlog",
        "active_vacancies" or "active_vacancies_employers" or "active_vacancies_intermediaries"
            or "applications" or "clicks" or "shares" or "likes" => "/admin/vacancies",
        _ => "/admin/vacancies"
    };
}
