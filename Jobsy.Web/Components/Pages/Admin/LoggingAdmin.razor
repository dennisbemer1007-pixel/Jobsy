@page "/admin/beveiliging/systeemlogs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Time
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminNav.SystemLogs"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.SystemLogs"]" Lead="@Culture["Admin.LoggingLead"]">
    <BeveiligingTabs ActiveKey="logs" />

    <AdminFilterBar>
        <select class="admin-filter-select" @bind="_level" @bind:after="ReloadAsync">
            <option value="">@Culture["AdminAudit.Filter.ResultAll"]</option>
            <option value="Info">Info</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>
        <input type="search" class="admin-filter-input" @bind="_category" @bind:event="oninput"
               placeholder="@Culture["AdminLogs.CategoryPlaceholder"]" />
        <input type="date" class="admin-filter-input" @bind="_fromDate" />
        <input type="date" class="admin-filter-input" @bind="_toDate" />
        <button class="btn-compact" type="button" disabled="@_loading" @onclick="FilterAsync">@Culture["Common.Filter"]</button>
    </AdminFilterBar>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }

    <AdminDataTable Loading="_loading" Empty="@(_filtered.Count == 0)" EmptyText="@Culture["AdminLogs.Empty"]">
        <Header>
            <th scope="col">@Culture["AdminLogs.Col.Date"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Level"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Category"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Message"]</th>
        </Header>
        <Rows>
            @foreach (var log in _filtered)
            {
                <tr>
                    <td class="admin-mono" data-label="@Culture["AdminAudit.Col.Time"]">@AmsterdamTime.ToLocal(log.CreatedAt).ToString("dd-MM-yyyy HH:mm")</td>
                    <td data-label="@Culture["AdminLogs.Col.Level"]">@LevelLabel(log.Level)</td>
                    <td data-label="@Culture["AdminLogs.Col.Category"]">@CategoryLabel(log.Category)</td>
                    <td data-label="@Culture["AdminLogs.Col.Message"]">@log.Message</td>
                </tr>
            }
        </Rows>
    </AdminDataTable>
    @if (_total > _pageSize)
    {
        <AdminPager Page="_pageNum" PageSize="_pageSize" TotalCount="_total"
                    TotalPages="@LogPageCount()" PageChanged="OnPageChanged" />
    }
</AdminPageShell>

@code {
    private List<PlatformLogItem> _logs = [];
    private string _level = "";
    private string _category = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading = true;
    private string? _error;
    private int _pageNum = 1;
    private int _pageSize = 50;
    private int _total;

    private string LevelLabel(string? level) => level switch
    {
        "Warning" => Culture["AdminLogs.Level.Warning"],
        "Error" => Culture["AdminLogs.Level.Error"],
        "Info" => Culture["AdminLogs.Level.Info"],
        _ => level ?? ""
    };

    private int LogPageCount()
        => Math.Max(1, (int)Math.Ceiling(_total / (double)Math.Max(1, _pageSize)));

    private string CategoryLabel(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            return "";
        }

        var key = "Logs.Category." + category;
        var label = Culture[key];
        return string.Equals(label, key, StringComparison.Ordinal) ? category : label;
    }

    private List<PlatformLogItem> _filtered =>
        string.IsNullOrWhiteSpace(_category)
            ? _logs
            : _logs.Where(l => l.Category.Contains(_category, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized() => Culture.Changed += OnCultureChanged;
    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("level", out var levelRaw) && !string.IsNullOrWhiteSpace(levelRaw))
        {
            _level = levelRaw.ToString()!;
        }

        await ReloadAsync();
    }

    private async Task FilterAsync()
    {
        _pageNum = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _pageNum = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Api.GetPlatformLogsPageAsync(
                category: string.IsNullOrWhiteSpace(_category) ? null : _category,
                level: string.IsNullOrWhiteSpace(_level) ? null : _level,
                from: _fromDate?.ToUniversalTime(),
                to: _toDate?.ToUniversalTime(),
                page: _pageNum,
                pageSize: _pageSize);
            _logs = page.Items.ToList();
            _total = page.Total;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _logs = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }
}
