@page "/admin/beveiliging/systeemlogs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["AdminNav.SystemLogs"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.SystemLogs"]" Lead="@Culture["Admin.LoggingLead"]">
    <BeveiligingTabs ActiveKey="logs" />

    <AdminFilterBar>
        <select class="admin-filter-select" @bind="_level" @bind:after="ReloadAsync">
            <option value="">@Culture["AdminAudit.Filter.ResultAll"]</option>
            <option value="Info">Info</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>
        <input type="search" class="admin-filter-input" @bind="_category" @bind:event="oninput"
               placeholder="@Culture["AdminLogs.CategoryPlaceholder"]" />
        <input type="date" class="admin-filter-input" @bind="_fromDate" />
        <input type="date" class="admin-filter-input" @bind="_toDate" />
        <button class="btn-compact" type="button" disabled="@_loading" @onclick="ReloadAsync">@Culture["Common.Filter"]</button>
    </AdminFilterBar>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }

    <AdminDataTable Loading="_loading" Empty="@(_filtered.Count == 0)" EmptyText="@Culture["AdminLogs.Empty"]">
        <Header>
            <th scope="col">@Culture["AdminLogs.Col.Date"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Level"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Category"]</th>
            <th scope="col">@Culture["AdminLogs.Col.Message"]</th>
        </Header>
        <Rows>
            @foreach (var log in _filtered)
            {
                <tr>
                    <td class="admin-mono">@log.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@log.Level</td>
                    <td>@CategoryLabel(log.Category)</td>
                    <td>@log.Message</td>
                </tr>
            }
        </Rows>
    </AdminDataTable>
</AdminPageShell>

@code {
    private List<PlatformLogItem> _logs = [];
    private string _level = "";
    private string _category = "";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading = true;
    private string? _error;

    private string CategoryLabel(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            return "";
        }

        var key = "Logs.Category." + category;
        var label = Culture[key];
        return string.Equals(label, key, StringComparison.Ordinal) ? category : label;
    }

    private List<PlatformLogItem> _filtered =>
        string.IsNullOrWhiteSpace(_category)
            ? _logs
            : _logs.Where(l => l.Category.Contains(_category, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized() => Culture.Changed += OnCultureChanged;
    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("level", out var levelRaw) && !string.IsNullOrWhiteSpace(levelRaw))
        {
            _level = levelRaw.ToString()!;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _logs = (await Api.GetPlatformLogsAsync(
                level: string.IsNullOrWhiteSpace(_level) ? null : _level,
                from: _fromDate?.ToUniversalTime(),
                to: _toDate?.ToUniversalTime())).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _logs = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
