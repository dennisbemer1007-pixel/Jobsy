@page "/admin/organisaties"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.WebUtilities
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@Culture["AdminNav.Companies"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.Companies"]" Lead="@Culture["AdminOrgs.Lead"]" Wide="true">
    <Actions>
        <button type="button" class="btn-compact btn-compact--primary" @onclick="OpenCreate">
            + @Culture["AdminOrgs.AddOrganisation"]
        </button>
    </Actions>

    <ChildContent>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }

    <AdminFilterBar Query="@_query" QueryChanged="OnQueryChanged" Placeholder="@Culture["AdminOrgs.SearchPlaceholder"]">
        <Chips>
            <label class="admin-filter-chip">
                <span>@Culture["AdminOrgs.ColType"]</span>
                <select @bind="_typeFilter" @bind:after="ReloadAsync">
                    <option value="">@Culture["AdminUi.All"]</option>
                    <option value="Employer">@Culture["AdminOrgs.TypeEmployer"]</option>
                    <option value="Intermediary">@Culture["AdminOrgs.TypeIntermediary"]</option>
                </select>
            </label>
            <label class="admin-filter-chip">
                <span>@Culture["AdminOrgs.ColRegion"]</span>
                <select @bind="_regionFilter" @bind:after="ReloadAsync">
                    <option value="">@Culture["AdminUi.All"]</option>
                    @foreach (var r in _regionOptions)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </label>
            <label class="admin-filter-chip">
                <span>@Culture["AdminOrgs.ColStatus"]</span>
                <select @bind="_statusFilter" @bind:after="ReloadAsync">
                    <option value="">@Culture["AdminUi.All"]</option>
                    <option value="active">@Culture["AdminOrgs.StatusActive"]</option>
                    <option value="kvk-failed">@Culture["AdminOrgs.StatusKvkFailed"]</option>
                    <option value="inactive">@Culture["AdminOrgs.StatusInactive"]</option>
                    <option value="takeover">@Culture["AdminOrgs.StatusTakeover"]</option>
                    <option value="not-live">@Culture["AdminOrgs.StatusNotLive"]</option>
                </select>
            </label>
            <div class="admin-segment" role="group" aria-label="@Culture["AdminOrgs.ViewMode"]">
                <button type="button"
                        class="admin-segment__btn @(_treeMode ? "is-active" : null)"
                        aria-pressed="@_treeMode"
                        @onclick="() => SetTreeMode(true)">@Culture["AdminOrgs.ViewTree"]</button>
                <button type="button"
                        class="admin-segment__btn @(!_treeMode ? "is-active" : null)"
                        aria-pressed="@(!_treeMode)"
                        @onclick="() => SetTreeMode(false)">@Culture["AdminOrgs.ViewFlat"]</button>
            </div>
        </Chips>
    </AdminFilterBar>

    @if (_openRequests > 0)
    {
        <p class="admin-note-bar" role="status">
            @string.Format(Culture["AdminOrgs.OpenRequestsNote"], _openRequests)
            <a href="/admin/organisaties/aanvragen">@Culture["AdminOrgs.OpenRequestsLink"]</a>
        </p>
    }

    <div class="admin-orgs @(_selected is not null && !_useDrawer ? "admin-orgs--with-panel" : null)">
        <div class="admin-orgs__main">
            <AdminDataTable Loading="_loading"
                            Empty="_rows.Count == 0"
                            EmptyText="@Culture["AdminOrgs.Empty"]">
                <Header>
                    <th scope="col">@Culture["AdminOrgs.ColOrganisation"]</th>
                    <th scope="col">@Culture["AdminOrgs.ColKvk"]</th>
                    <th scope="col" class="admin-col-desktop">@Culture["AdminOrgs.ColRegion"]</th>
                    <th scope="col" class="admin-col-desktop">@Culture["AdminOrgs.ColUsers"]</th>
                    <th scope="col" class="admin-col-desktop">@Culture["AdminOrgs.ColVacancies"]</th>
                    <th scope="col" class="admin-col-desktop">@Culture["AdminOrgs.ColTokens"]</th>
                    <th scope="col">@Culture["AdminOrgs.ColStatus"]</th>
                </Header>
                <Rows>
                    @foreach (var row in _rows)
                    {
                        var selected = _selected?.Id == row.Id;
                        var isChild = row.ParentCompanyId is not null;
                        var expanded = _expanded.Contains(row.Id);
                        <tr class="admin-org-row @(selected ? "is-selected" : null) @(isChild ? "admin-org-row--child" : null)"
                            tabindex="0"
                            @onclick="() => SelectRow(row)"
                            @onkeydown="e => OnRowKey(e, row)">
                            <td class="data-table__col--wrap">
                                <div class="admin-org-cell @(isChild ? "admin-org-cell--child" : null)">
                                    @if (!isChild && _treeMode && row.BranchCount > 0)
                                    {
                                        <button type="button"
                                                class="admin-org-caret"
                                                aria-expanded="@expanded"
                                                aria-label="@Culture["AdminOrgs.ToggleBranches"]"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleExpand(row.Id)">
                                            <span aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                                        </button>
                                    }
                                    else if (isChild)
                                    {
                                        <span class="admin-org-connector" aria-hidden="true"></span>
                                    }
                                    <span class="admin-org-cell__text">
                                        <strong>@row.Name</strong>
                                        <span class="muted">@TypeLabel(row.Type)@BranchMeta(row)</span>
                                    </span>
                                </div>
                            </td>
                            <td>@row.KvkNumber</td>
                            <td class="admin-col-desktop">@(row.RegionName ?? "—")</td>
                            <td class="admin-col-desktop">@row.UserCount</td>
                            <td class="admin-col-desktop">@row.ActiveVacancyCount</td>
                            <td class="admin-col-desktop">@row.TokenBalance.ToString("0.##")</td>
                            <td>
                                <span class="admin-status-dot @StatusClass(row.Status)">@StatusLabel(row)</span>
                            </td>
                        </tr>
                    }
                </Rows>
            </AdminDataTable>

            <AdminPager Page="_page"
                        PageSize="_pageSize"
                        TotalCount="_totalCount"
                        TotalPages="@Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize))"
                        PageChanged="GoPageAsync"
                        PageSizeChanged="OnPageSizeAsync"
                        PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </div>

        @if (_selected is not null && !_useDrawer)
        {
            <aside class="admin-orgs__panel" aria-label="@Culture["AdminOrgs.DetailPanel"]">
                @DetailBody(_selected)
            </aside>
        }
    </div>
    </ChildContent>
</AdminPageShell>

@if (_selected is not null && _useDrawer)
{
    <AdminDrawer Open="true"
                 OpenChanged="OnDrawerOpenChanged"
                 Title="@_selected.Name"
                 FullSheet="true">
        @DetailBody(_selected)
    </AdminDrawer>
}

<AdminDrawer Open="_createOpen"
             OpenChanged="v => _createOpen = v"
             Title="@Culture["AdminOrgs.AddOrganisation"]">
    <CompanyCreateSection OnCreated="OnCreatedAsync" />
</AdminDrawer>

<GrantTokensDialog IsOpen="_grantOpen"
                   Company="_grantCompany"
                   OnClose="CloseGrant"
                   OnGranted="OnGrantedAsync" />

@code {
    private List<AdminCompanyItem> _all = [];
    private List<AdminCompanyItem> _rows = [];
    private List<string> _regionOptions = [];
    private AdminCompanyItem? _selected;
    private HashSet<Guid> _expanded = [];
    private string _query = "";
    private string _typeFilter = "";
    private string _regionFilter = "";
    private string _statusFilter = "";
    private bool _treeMode = true;
    private bool _loading = true;
    private bool _createOpen;
    private bool _grantOpen;
    private bool _useDrawer;
    private AdminCompanyItem? _grantCompany;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 50;
    private int _totalCount;
    private int _openRequests;
    private CancellationTokenSource? _searchCts;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var qs = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (qs.TryGetValue("type", out var type)) _typeFilter = type.ToString();
        if (qs.TryGetValue("status", out var status)) _statusFilter = status.ToString();
        if (qs.TryGetValue("q", out var q)) _query = q.ToString();
        if (qs.TryGetValue("region", out var region)) _regionFilter = region.ToString();
        await ReloadAsync();
        try
        {
            var todo = await Api.GetAdminTodoAsync();
            if (todo?.CountsByNavKey is not null)
            {
                _openRequests = todo.CountsByNavKey.GetValueOrDefault("org-requests");
            }
        }
        catch { /* non-blocking */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _useDrawer = await Js.InvokeAsync<bool>("eval", "window.matchMedia('(max-width: 1023px)').matches");
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _useDrawer = false;
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Api.GetAdminCompaniesPageAsync(
                q: string.IsNullOrWhiteSpace(_query) ? null : _query,
                type: string.IsNullOrWhiteSpace(_typeFilter) ? null : _typeFilter,
                region: string.IsNullOrWhiteSpace(_regionFilter) ? null : _regionFilter,
                status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                page: _page,
                pageSize: _pageSize);
            _all = page.Items;
            _totalCount = page.TotalCount;
            _regionOptions = _all
                .Select(c => c.RegionName)
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r)
                .Cast<string>()
                .ToList();
            RebuildRows();
            if (_selected is not null)
            {
                _selected = _all.FirstOrDefault(c => c.Id == _selected.Id) ?? _selected;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _all = [];
            _rows = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void RebuildRows()
    {
        if (!_treeMode)
        {
            _rows = _all.OrderBy(c => c.Name).ToList();
            return;
        }

        var roots = _all.Where(c => c.ParentCompanyId is null).OrderBy(c => c.Name).ToList();
        var children = _all.Where(c => c.ParentCompanyId is not null)
            .GroupBy(c => c.ParentCompanyId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.Name).ToList());
        var rows = new List<AdminCompanyItem>();
        foreach (var root in roots)
        {
            rows.Add(root);
            if (_expanded.Contains(root.Id) && children.TryGetValue(root.Id, out var kids))
            {
                rows.AddRange(kids);
            }
        }

        // Orphans (child without parent in page) still shown in flat append
        var shown = rows.Select(r => r.Id).ToHashSet();
        foreach (var orphan in _all.Where(c => c.ParentCompanyId is not null && !shown.Contains(c.Id)))
        {
            rows.Add(orphan);
        }

        _rows = rows;
    }

    private async Task OnQueryChanged(string value)
    {
        _query = value;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(280, token);
            await ReloadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task GoPageAsync(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task OnPageSizeAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        await ReloadAsync();
    }

    private void SetTreeMode(bool tree)
    {
        _treeMode = tree;
        RebuildRows();
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
        }

        RebuildRows();
    }

    private void SelectRow(AdminCompanyItem row)
    {
        _selected = row;
    }

    /// <summary>Test seam: force drawer mode (&lt; 1024 behaviour).</summary>
    public void SetUseDrawerForTests(bool useDrawer) => _useDrawer = useDrawer;

    private void OnRowKey(KeyboardEventArgs e, AdminCompanyItem row)
    {
        if (e.Key is "Enter" or " ")
        {
            SelectRow(row);
        }
    }

    private Task OnDrawerOpenChanged(bool open)
    {
        if (!open) _selected = null;
        return Task.CompletedTask;
    }

    private void OpenCreate() => _createOpen = true;

    private async Task OnCreatedAsync()
    {
        await ReloadAsync();
    }

    private void OpenGrant(AdminCompanyItem company)
    {
        _grantCompany = company;
        _grantOpen = true;
    }

    private void CloseGrant()
    {
        _grantOpen = false;
        _grantCompany = null;
    }

    private async Task OnGrantedAsync()
    {
        await ReloadAsync();
    }

    private RenderFragment DetailBody(AdminCompanyItem c) => __builder =>
    {
        <div class="admin-org-detail">
            <div class="admin-org-detail__head">
                <span class="admin-org-detail__icon" aria-hidden="true">@((MarkupString)NavIcons.Companies)</span>
                <div>
                    <h2>@c.Name</h2>
                    <p class="muted">@TypeLabel(c.Type) · @Culture["AdminOrgs.CustomerSince"] @FormatSince(c.CustomerSinceUtc)</p>
                </div>
            </div>
            <dl class="admin-kv">
                <div>
                    <dt>@Culture["AdminOrgs.ColKvk"]</dt>
                    <dd>
                        @c.KvkNumber
                        <span class="status-pill @(c.KvkVerificationStatus == "Verified" ? "status-pill--accepted" : "status-pill--warn")">
                            @(c.KvkVerificationStatus == "Verified" ? Culture["AdminOrgs.KvkVerified"] : Culture["AdminOrgs.KvkFailedPill"])
                        </span>
                    </dd>
                </div>
                <div>
                    <dt>@Culture["AdminOrgs.ColRegion"]</dt>
                    <dd>@(c.RegionName ?? "—")</dd>
                </div>
                <div>
                    <dt>@Culture["AdminOrgs.ColDomain"]</dt>
                    <dd>@(c.DomainHostname ?? "—")</dd>
                </div>
                <div>
                    <dt>@Culture["AdminOrgs.ColEnterpriseManager"]</dt>
                    <dd>@(c.EnterpriseManagerName ?? "—")</dd>
                </div>
                <div>
                    <dt>@Culture["AdminOrgs.ColTokens"]</dt>
                    <dd>
                        @c.TokenBalance.ToString("0.##")
                        @if (c.GoodwillBalance > 0)
                        {
                            <span class="muted"> (@c.GoodwillBalance.ToString("0.##") @Culture["AdminOrgs.Goodwill"])</span>
                        }
                    </dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(c.PackageLabel))
                {
                    <div>
                        <dt>@Culture["AdminOrgs.ColPackage"]</dt>
                        <dd>@c.PackageLabel</dd>
                    </div>
                }
            </dl>

            @if (c.PendingTakeoverId is Guid tid)
            {
                <AdminImpactNote Tone="warn">
                    <strong>@Culture["AdminOrgs.TakeoverNoteTitle"]</strong>
                    <p>
                        @string.Format(
                            Culture["AdminOrgs.TakeoverNoteBody"],
                            c.PendingTakeoverApplicant ?? "—",
                            c.PendingTakeoverAtUtc?.ToLocalTime().ToString("dd-MM-yyyy") ?? "—")
                    </p>
                </AdminImpactNote>
                <div class="admin-org-detail__actions">
                    <a class="btn-compact btn-compact--primary"
                       href="@($"/admin/organisaties/aanvragen?tab=overnames&takeoverId={tid:D}")">
                        @Culture["AdminOrgs.ReviewTakeover"]
                    </a>
                </div>
            }

            <div class="admin-org-detail__actions">
                <button type="button" class="btn-compact" @onclick="() => OpenGrant(c)">
                    @Culture["AdminOrgs.GrantTokens"]
                </button>
                <a class="btn-compact" href="@($"/admin/gebruikers?companyId={c.Id:D}")">
                    @string.Format(Culture["AdminOrgs.UsersLink"], c.UserCount)
                </a>
            </div>
        </div>
    };

    private string TypeLabel(string type)
        => type.Equals("Intermediary", StringComparison.OrdinalIgnoreCase)
            ? Culture["AdminOrgs.TypeIntermediary"]
            : Culture["AdminOrgs.TypeEmployer"];

    private string BranchMeta(AdminCompanyItem row)
    {
        if (row.ParentCompanyId is not null || row.BranchCount <= 0)
        {
            return "";
        }

        return $" · {string.Format(Culture["AdminOrgs.BranchCount"], row.BranchCount)}";
    }

    private string StatusLabel(AdminCompanyItem row) => row.Status switch
    {
        "kvk-failed" => Culture["AdminOrgs.StatusKvkFailed"],
        "inactive" => string.Format(Culture["AdminOrgs.StatusInactiveDays"], row.InactiveDays ?? 0),
        "takeover" => Culture["AdminOrgs.StatusTakeover"],
        "not-live" => Culture["AdminOrgs.StatusNotLive"],
        _ => Culture["AdminOrgs.StatusActive"]
    };

    private static string StatusClass(string status) => status switch
    {
        "kvk-failed" => "is-danger",
        "inactive" => "is-muted",
        "takeover" => "is-warn",
        "not-live" => "is-muted",
        _ => "is-active"
    };

    private static string FormatSince(DateTime? utc)
        => utc is null ? "—" : utc.Value.ToLocalTime().ToString("MM-yyyy");
}
