@page "/admin/paspoortpartners"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Core.Features
@using Jobsy.Core.Rules
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IFeatureFlags Features

<PageTitle>@Culture["AdminNav.PassportPartners"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.PassportPartners"]" Lead="@Culture["Admin.PassportPartners.Lead"]">
    @if (_off)
    {
        <p class="state-message" role="status">@Culture["Admin.PassportPartners.Off"]</p>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="state-message error">@_error</p>
    }

    <section class="detail-card">
        <h2>@Culture["Admin.PassportPartners.Create"]</h2>
        <label class="field-label" for="partner-company">@Culture["Admin.PassportPartners.Company"]</label>
        <select id="partner-company" class="text-input" @bind="_companyId" disabled="@_off" aria-invalid="@(_companyError is not null)">
            <option value="">@Culture["Admin.PassportPartners.Company"]</option>
            @foreach (var company in _companies)
            {
                <option value="@company.Id">@company.Name@(string.IsNullOrWhiteSpace(company.KvkNumber) ? "" : $" · KvK {company.KvkNumber}")</option>
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(_companyError))
        {
            <p class="error" role="alert">@_companyError</p>
        }
        <label class="field-label" for="partner-name">@Culture["Admin.PassportPartners.Name"]</label>
        <input id="partner-name" class="text-input" @bind="_displayName" maxlength="80" disabled="@_off" aria-invalid="@(_nameError is not null)" />
        @if (!string.IsNullOrWhiteSpace(_nameError))
        {
            <p class="error" role="alert">@_nameError</p>
        }
        <button type="button" class="btn-compact btn-compact--primary" disabled="@_off" @onclick="CreateAsync">@Culture["Admin.PassportPartners.Create"]</button>
    </section>

    @if (!_off && _partners.Count == 0)
    {
        <p class="muted">@Culture["Admin.PassportPartners.Empty"]</p>
    }
    else if (_partners.Count > 0)
    {
        <AdminDataTable>
            <Header>
                <th scope="col">@Culture["Admin.PassportPartners.Name"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Type"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Active"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Codes"]</th>
            </Header>
            <Rows>
                @foreach (var partner in _partners)
                {
                    <tr>
                        <td data-label="@Culture["Admin.PassportPartners.Name"]">@partner.DisplayName</td>
                        <td data-label="@Culture["Admin.PassportPartners.Type"]">@partner.Type</td>
                        <td data-label="@Culture["Admin.PassportPartners.Active"]">
                            <button type="button" class="btn-compact" @onclick="() => ToggleAsync(partner)">
                                @(partner.IsActive ? Culture["Passport.Shared.Yes"] : Culture["Passport.Shared.No"])
                            </button>
                        </td>
                        <td data-label="@Culture["Admin.PassportPartners.Codes"]">
                            <button type="button" class="btn-compact" @onclick="() => ToggleCodesAsync(partner)">@Culture["Admin.PassportPartners.Codes"]</button>
                            <a href="@($"/admin/paspoortpartners/{partner.Id}/codes.pdf")">@Culture["Admin.PassportPartners.Pdf"]</a>
                        </td>
                    </tr>
                }
            </Rows>
        </AdminDataTable>
    }

    @if (_codesFor is Guid openId)
    {
        <section class="detail-card">
            <h2>@Culture["Admin.PassportPartners.Codes"]</h2>
            <label class="field-label" for="code-branch">@Culture["Admin.PassportPartners.Company"]</label>
            <select id="code-branch" class="text-input" @bind="_branchId">
                <option value="">@Culture["Admin.PassportPartners.Company"]</option>
                @foreach (var company in _companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
            <button type="button" class="btn-compact btn-compact--primary" @onclick="() => CreateCodeAsync(openId)">@Culture["Admin.PassportPartners.GenerateCode"]</button>
            @if (_codes.Count == 0)
            {
                <p class="muted">@Culture["Admin.PassportPartners.Empty"]</p>
            }
            else
            {
                <ul>
                    @foreach (var row in _codes)
                    {
                        <li>
                            <span class="admin-mono">@row.CodeDisplay</span>
                            <span class="muted">@row.BranchName</span>
                            @if (row.IsActive)
                            {
                                <button type="button" class="btn-compact" @onclick="() => DeactivateCodeAsync(openId, row)">@Culture["Admin.PassportPartners.Deactivate"]</button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    <PassportPartnerLogoField Accepted="UploadLogoAsync" />
</AdminPageShell>

@code {
    private readonly List<PassportPartnerAdminItem> _partners = [];
    private readonly List<AdminCompanyItem> _companies = [];
    private readonly List<PassportPartnerCodeItem> _codes = [];
    private bool _off;
    private string? _error;
    private string? _companyError;
    private string? _nameError;
    private string _companyId = "";
    private string _branchId = "";
    private string _displayName = "";
    private Guid? _logoTargetId;
    private Guid? _codesFor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _off = !await Features.IsEnabledAsync(PlatformFeature.PassportPartners);
        }
        catch (Exception)
        {
            _off = true;
        }

        if (_off)
        {
            return;
        }

        try
        {
            _companies.AddRange(await Api.GetAdminCompaniesAsync());
            var rows = await Api.GetAdminPassportPartnersAsync();
            _partners.AddRange(rows);
            _logoTargetId = _partners.FirstOrDefault()?.Id;
        }
        catch (Exception)
        {
            // A failed list is an empty page, not a save error.
        }
    }

    private async Task CreateAsync()
    {
        if (_off)
        {
            _error = Culture["Admin.PassportPartners.Off"];
            return;
        }

        _error = null;
        _companyError = null;
        _nameError = null;
        var name = _displayName.Trim();
        if (!Guid.TryParse(_companyId, out var companyId))
        {
            _companyError = Culture["Admin.PassportPartners.CompanyRequired"];
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            _nameError = Culture["Admin.PassportPartners.NameRequired"];
        }

        if (_companyError is not null || _nameError is not null)
        {
            return;
        }

        try
        {
            await Api.CreateAdminPassportPartnerAsync(companyId, name, null);
            _partners.Clear();
            _partners.AddRange(await Api.GetAdminPassportPartnersAsync());
            _companyId = "";
            _displayName = "";
            _logoTargetId = _partners.FirstOrDefault()?.Id;
        }
        catch (ApiErrorException ex) when (ex.Code == "feature_disabled")
        {
            _off = true;
            _error = Culture["Admin.PassportPartners.Off"];
        }
        catch (ApiErrorException ex) when (ex.Code == "company_not_found")
        {
            _companyError = Culture["Admin.PassportPartners.CompanyNotFound"];
        }
        catch (ApiErrorException ex) when (ex.Code == "partner_exists")
        {
            _error = Culture["Admin.PassportPartners.AlreadyExists"];
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task ToggleAsync(PassportPartnerAdminItem partner)
    {
        try
        {
            await Api.SetAdminPassportPartnerActiveAsync(partner.Id, !partner.IsActive);
            partner.IsActive = !partner.IsActive;
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task ToggleCodesAsync(PassportPartnerAdminItem partner)
    {
        if (_codesFor == partner.Id)
        {
            _codesFor = null;
            _codes.Clear();
            return;
        }

        _codesFor = partner.Id;
        _codes.Clear();
        _codes.AddRange(await Api.GetAdminPassportPartnerCodesAsync(partner.Id));
    }

    private async Task CreateCodeAsync(Guid partnerId)
    {
        if (!Guid.TryParse(_branchId, out var branchId))
        {
            _error = Culture["Admin.PassportPartners.CompanyRequired"];
            return;
        }

        try
        {
            await Api.CreateAdminPassportPartnerCodeAsync(partnerId, branchId, null);
            _codes.Clear();
            _codes.AddRange(await Api.GetAdminPassportPartnerCodesAsync(partnerId));
            _error = null;
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task DeactivateCodeAsync(Guid partnerId, PassportPartnerCodeItem code)
    {
        try
        {
            await Api.DeactivateAdminPassportPartnerCodeAsync(code.Id);
            _codes.Clear();
            _codes.AddRange(await Api.GetAdminPassportPartnerCodesAsync(partnerId));
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task UploadLogoAsync(IBrowserFile file)
    {
        if (_logoTargetId is not Guid id)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(PassportPartnerLogoRules.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await Api.UploadAdminPassportPartnerLogoAsync(id, file.Name, file.ContentType, buffer.ToArray());
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }
}
