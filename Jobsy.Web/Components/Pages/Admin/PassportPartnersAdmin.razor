@page "/admin/paspoortpartners"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using Jobsy.Core.Rules
@using Jobsy.Web.Services
@inject JobsyApiClient Api
@inject CultureState Culture

<PageTitle>@Culture["AdminNav.PassportPartners"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.PassportPartners"]" Lead="@Culture["Admin.PassportPartners.Lead"]">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="state-message error">@_error</p>
    }

    <section class="detail-card">
        <h2>@Culture["Admin.PassportPartners.Create"]</h2>
        <label class="field-label" for="partner-company">@Culture["Admin.PassportPartners.Company"]</label>
        <input id="partner-company" class="text-input" @bind="_companyId" aria-invalid="@(_companyError is not null)" />
        @if (!string.IsNullOrWhiteSpace(_companyError))
        {
            <p class="error" role="alert">@_companyError</p>
        }
        <label class="field-label" for="partner-name">@Culture["Admin.PassportPartners.Name"]</label>
        <input id="partner-name" class="text-input" @bind="_displayName" maxlength="80" aria-invalid="@(_nameError is not null)" />
        @if (!string.IsNullOrWhiteSpace(_nameError))
        {
            <p class="error" role="alert">@_nameError</p>
        }
        <button type="button" class="btn-compact btn-compact--primary" @onclick="CreateAsync">@Culture["Admin.PassportPartners.Create"]</button>
    </section>

    @if (_partners.Count == 0)
    {
        <p class="muted">@Culture["Admin.PassportPartners.Empty"]</p>
    }
    else
    {
        <AdminDataTable>
            <Header>
                <th scope="col">@Culture["Admin.PassportPartners.Name"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Type"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Active"]</th>
                <th scope="col">@Culture["Admin.PassportPartners.Codes"]</th>
            </Header>
            <Rows>
                @foreach (var partner in _partners)
                {
                    <tr>
                        <td>@partner.DisplayName</td>
                        <td>@partner.Type</td>
                        <td>
                            <button type="button" class="btn-compact" @onclick="() => ToggleAsync(partner)">
                                @(partner.IsActive ? Culture["Passport.Shared.Yes"] : Culture["Passport.Shared.No"])
                            </button>
                        </td>
                        <td>
                            <a href="@($"api/admin/passport-partners/{partner.Id}/codes.pdf")">PDF</a>
                        </td>
                    </tr>
                }
            </Rows>
        </AdminDataTable>
    }

    <PassportPartnerLogoField Accepted="UploadLogoAsync" />
</AdminPageShell>

@code {
    private readonly List<PassportPartnerAdminItem> _partners = [];
    private string? _error;
    private string? _companyError;
    private string? _nameError;
    private string _companyId = "";
    private string _displayName = "";
    private Guid? _logoTargetId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await Api.GetAdminPassportPartnersAsync();
            _partners.AddRange(rows);
            _logoTargetId = _partners.FirstOrDefault()?.Id;
        }
        catch (Exception)
        {
            // A failed list is an empty page, not "Opslaan lukte niet".
        }
    }

    private async Task CreateAsync()
    {
        _error = null;
        _companyError = null;
        _nameError = null;
        var companyRaw = _companyId.Trim();
        var name = _displayName.Trim();
        Guid companyId = default;
        if (string.IsNullOrWhiteSpace(companyRaw) || !Guid.TryParse(companyRaw, out companyId))
        {
            _companyError = Culture["Admin.PassportPartners.CompanyRequired"];
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            _nameError = Culture["Admin.PassportPartners.NameRequired"];
        }

        if (_companyError is not null || _nameError is not null)
        {
            return;
        }

        try
        {
            await Api.CreateAdminPassportPartnerAsync(companyId, name, null);
            _partners.Clear();
            _partners.AddRange(await Api.GetAdminPassportPartnersAsync());
            _companyId = "";
            _displayName = "";
            _error = null;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _error = Culture["Admin.PassportPartners.CompanyNotFound"];
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _error = Culture["Admin.PassportPartners.AlreadyExists"];
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task ToggleAsync(PassportPartnerAdminItem partner)
    {
        try
        {
            await Api.SetAdminPassportPartnerActiveAsync(partner.Id, !partner.IsActive);
            partner.IsActive = !partner.IsActive;
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }

    private async Task UploadLogoAsync(IBrowserFile file)
    {
        if (_logoTargetId is not Guid id)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(PassportPartnerLogoRules.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await Api.UploadAdminPassportPartnerLogoAsync(id, file.Name, file.ContentType, buffer.ToArray());
        }
        catch (Exception)
        {
            _error = Culture["Admin.PassportPartners.Failed"];
        }
    }
}
