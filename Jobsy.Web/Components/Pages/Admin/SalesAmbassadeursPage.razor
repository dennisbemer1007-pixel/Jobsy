@page "/admin/gebruikers/sales"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Components.Admin.Sections
@using Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["AdminNav.SalesAmbassadors"] · Lobsy</PageTitle>

<AdminPageShell Title="@Culture["AdminNav.SalesAmbassadors"]">
    <AdminTabs BasePath="/admin/gebruikers/sales" ActiveKey="@_tab" Tabs="_tabs" />
    @if (_tab == "ambassadeurs")
    {
        <AmbassadeursSection />
    }
    else
    {
        <SalesManagersSection />
    }
</AdminPageShell>

@code {
    private string _tab = "salesmanagers";
    private List<AdminTabs.Tab> _tabs = [];

    protected override void OnInitialized()
    {
        _tabs =
        [
            new("salesmanagers", Culture["AdminTabs.SalesManagers"]),
            new("ambassadeurs", Culture["AdminTabs.Ambassadors"]),
        ];
        _tab = ReadTab();
    }

    protected override void OnParametersSet() => _tab = ReadTab();

    private string ReadTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("tab", out var v)
            && string.Equals(v.ToString(), "ambassadeurs", StringComparison.OrdinalIgnoreCase))
        {
            return "ambassadeurs";
        }

        return "salesmanagers";
    }
}
