@page "/"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@layout PublicLayout
@using Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Onboarding
@using Jobsy.Web.Seo
@using Jobsy.Web.Services
@inject CultureState Culture
@inject LandingVariantResolver VariantResolver
@inject LandingStatsClient Stats
@inject LandingPriceClient Prices
@inject PageSeoContext Seo
@inject IHttpContextAccessor HttpContextAccessor

<HeadContent>
    @if (_variant == LandingVariant.On)
    {
        <link rel="stylesheet" href="css/features/candidate-header-strip.css?v=20261025-cand-strip4" />
        <link rel="stylesheet" href="css/features/kreeft-reiskaart.css?v=20261025-reis3" />
    }
</HeadContent>

<div class="pub-landing @(_variant == LandingVariant.On ? "pub-landing--combo pub-landing--calm" : "")" data-variant="@(_variant == LandingVariant.Zw ? "zw" : "on")">
    <LandingHero Variant="_variant" VacancyCount="_vacancyDisplay" ReiskaartHtml="@(_variant == LandingVariant.On ? KreeftReiskaartMarkup.ForLandingHero(Culture) : null)" />
    @if (_variant == LandingVariant.On)
    {
        <LandingIllustratedSteps Variant="_variant" />
        <LandingBanenkaartSection Variant="_variant" VacancyCount="_vacancyDisplay" ComboLayout="true" />
        <LandingJourneyFive Variant="_variant" ComboLayout="true" />
        <LandingWhatYouGet Variant="_variant" PriceEuro="_priceEuro" ComboLayout="true" />
        <LandingPrivacy Variant="_variant" />
        <LandingEmployersFaq Variant="_variant" PriceEuro="_priceEuro" />
    }
    else
    {
        <LandingWhatIs Variant="_variant" />
        <LandingKreeft Variant="_variant" />
        <LandingWhatYouGet Variant="_variant" PriceEuro="_priceEuro" />
        <LandingForWhom Variant="_variant" />
        <LandingPrivacy Variant="_variant" />
        <LandingFaq Variant="_variant" PriceEuro="_priceEuro" />
        <LandingClosing Variant="_variant" />
    }
</div>

@code {
    private LandingVariant _variant = LandingVariant.On;
    private int? _vacancyDisplay;
    private decimal? _priceEuro;

    protected override async Task OnInitializedAsync()
    {
        Culture.InitializeFromRequest(HttpContextAccessor.HttpContext);
        _variant = await VariantResolver.GetAsync();
        if (_variant == LandingVariant.On)
        {
            var raw = await Stats.GetActiveVacanciesAsync();
            _vacancyDisplay = LandingVacancyCount.RoundDownToTens(raw);
        }

        _priceEuro = await Prices.GetDeepAnalysisPriceEuroAsync();

        var faqPairs = LandingFaq.BuildPairs(_variant, Culture.Language, _priceEuro);
        Seo.Set(new PageSeoOverride(
            Title: LandingText.For("Landing.Seo.Title", _variant, Culture.Language),
            Description: LandingText.For("Landing.Seo.Description", _variant, Culture.Language),
            JsonLd: StructuredData.FaqPage(faqPairs)));
    }
}
