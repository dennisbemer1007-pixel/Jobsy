@page "/school/privacy"
@layout SchoolLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SchoolAdmin")]
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Interfaces
@using Jobsy.Core.Scholen
@using Jobsy.Web.Components.Ui.Enterprise
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IJSRuntime Js
@inject IPlatformFeatureService Features

<PageTitle>@Culture["School.Privacy.Title"] · Lobsy</PageTitle>

<header class="sch-page-header">
    <h1>@Culture["School.Privacy.Title"]</h1>
    <p class="muted">@Culture["School.Privacy.Lead"]</p>
</header>

@if (_disabled)
{
    <p class="state-message error">@Culture["School.FeatureDisabled"]</p>
}
else if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_privacy is not null)
{
    <section class="sch-card">
        <h2>@Culture["School.Privacy.Agreement"]</h2>
        @if (_privacy.ProcessorAgreementSignedOn is DateOnly d)
        {
            <p>
                <span class="sch-pill sch-pill--ok">@d.ToString("dd-MM-yyyy")</span>
                · @_privacy.ProcessorAgreementVersion
            </p>
        }
        else
        {
            <p><span class="sch-pill sch-pill--warn">@Culture["School.Privacy.AgreementMissing"]</span></p>
        }
        <p>@Culture["School.Privacy.Roles"]</p>
        <p>@string.Format(Culture["School.Privacy.Retention"], _privacy.RetentionCutoff.ToString("dd MMMM yyyy"), _privacy.RetentionYearLabel)</p>
    </section>

    <section class="sch-card">
        <h2>@Culture["School.Privacy.Confirmations"]</h2>
        <ul class="sch-todo-list">
            @foreach (var c in _privacy.ClassConfirmations)
            {
                <li>
                    <a href="/school/klassen/@c.ClassId">@c.ClassName</a>
                    —
                    @if (c.Confirmed)
                    {
                        <span class="sch-pill sch-pill--ok">@Culture["School.Parents.Confirmed"]</span>
                    }
                    else
                    {
                        <span class="sch-pill sch-pill--warn">@Culture["School.Parents.Pending"]</span>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="sch-card" id="ouderbrief">
        <h2>@Culture["School.Privacy.Ouderbrief"]</h2>
        <pre class="sch-ouderbrief">@_privacy.OuderbriefText</pre>
        <div class="sch-admin-toolbar">
            <button type="button" class="btn-compact" @onclick="CopyLetter">@Culture["School.Privacy.Copy"]</button>
        </div>
    </section>

    <section class="sch-card">
        <h2>@Culture["School.Privacy.DeleteYear"]</h2>
        <EntImpactNote><p>@Culture["School.Privacy.DeleteYearHelp"]</p></EntImpactNote>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <p class="state-message error">@_deleteError</p>
        }
        @if (!string.IsNullOrEmpty(_deleteDone))
        {
            <p class="state-message">@_deleteDone</p>
        }
        <label>@Culture["School.Privacy.DeleteYearConfirm"]
            <input class="input" @bind="_deleteConfirm" />
        </label>
        <button type="button" class="btn-compact btn-outline-danger" disabled="@_deleteBusy" @onclick="DeleteYearAsync">
            @Culture["School.Privacy.DeleteYear"]
        </button>
    </section>
}

@code {
    private bool _disabled;
    private bool _loading = true;
    private SchoolPrivacyDto? _privacy;
    private string _deleteConfirm = "";
    private string? _deleteError;
    private string? _deleteDone;
    private bool _deleteBusy;

    protected override async Task OnInitializedAsync()
    {
        await Culture.SetLanguageAsync("nl");
        _disabled = !await SchoolsFeatureGate.IsEnabledAsync(Features);
        if (!_disabled)
        {
            _privacy = await Api.GetSchoolPrivacyAsync();
        }

        _loading = false;
    }

    private async Task CopyLetter()
    {
        if (_privacy is null) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _privacy.OuderbriefText);
        }
        catch
        {
            // ignore
        }
    }

    private async Task DeleteYearAsync()
    {
        _deleteBusy = true;
        _deleteError = null;
        _deleteDone = null;
        try
        {
            await Api.DeleteSchoolYearDataAsync(_deleteConfirm);
            _deleteConfirm = "";
            _deleteDone = Culture["School.Privacy.DeleteYearDone"];
            _privacy = await Api.GetSchoolPrivacyAsync();
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _deleteBusy = false;
        }
    }
}
