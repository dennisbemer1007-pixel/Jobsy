@page "/school/te-doen"
@layout SchoolLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "SchoolAdmin")]
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Scholen
@inject CultureState Culture
@inject JobsyApiClient Api
@inject IFeatureFlags Features

<PageTitle>@Culture["School.Todo.Title"] · Lobsy</PageTitle>

<header class="sch-page-header">
    <h1>@Culture["School.Todo.Title"]</h1>
    <p class="muted">@Culture["School.Todo.Lead"]</p>
</header>

@if (_disabled)
{
    <p class="state-message error">@Culture["School.FeatureDisabled"]</p>
}
else if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (_items.Count == 0)
{
    <p class="muted">@Culture["School.Todo.Empty"]</p>
}
else
{
    <ul class="sch-todo-list sch-todo-list--full">
        @foreach (var t in _items)
        {
            <li>
                @if (!string.IsNullOrEmpty(t.Href))
                {
                    <a href="@t.Href">@t.Title</a>
                }
                else
                {
                    <span>@t.Title</span>
                }
            </li>
        }
    </ul>
}

@code {
    private bool _disabled;
    private bool _loading = true;
    private List<SchoolTodoItemDto> _items = [];

    protected override async Task OnInitializedAsync()
    {
        await Culture.SetLanguageAsync("nl");
        _disabled = !await SchoolsFeatureGate.IsEnabledAsync(Features);
        if (!_disabled)
        {
            _items = (await Api.GetSchoolTodosAsync()).ToList();
        }

        _loading = false;
    }
}
