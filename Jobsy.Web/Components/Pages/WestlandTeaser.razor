@page "/westland"
@page "/lancering"
@layout TeaserLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config

<PageTitle>Lobsy komt naar het Westland — live 18 november</PageTitle>
<HeadContent>
    <meta name="description" content="Lobsy: hyperlokale vacatures in het Westland. Tot 18 november gratis vacatures plaatsen. Vrijwilligerswerk en stages 3 jaar gratis. Praat met Dennis via WhatsApp." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
</HeadContent>

<div class="wl-teaser">
    @* ——— Hero: één compositie ——— *@
    <section class="wl-hero" aria-labelledby="wl-hero-title">
        <div class="wl-hero__media" aria-hidden="true">
            <img class="wl-hero__img"
                 src="images/teaser/westland-hero.jpg"
                 alt=""
                 width="1920"
                 height="1080"
                 fetchpriority="high" />
            <div class="wl-hero__veil"></div>
        </div>
        <div class="wl-hero__content">
            <p class="wl-hero__brand">
                <LobsyLogo Class="wl-hero__mark" Alt="" Animate="true" />
                <span>Lobsy</span>
            </p>
            <h1 id="wl-hero-title" class="wl-hero__title">
                Werk dichterbij.<br />Mensen dichterbij.<br />
                <span class="wl-hero__title-accent">Westland, we komen eraan.</span>
            </h1>
            <p class="wl-hero__lead">
                Het hyperlokale vacatureplatform dat ondernemers en werkzoekenden koppelt op reistijd en vervoer — niet op eindeloze filters.
            </p>
            <div class="wl-hero__cta">
                <a class="wl-btn wl-btn--primary" href="/register">
                    <span class="wl-btn__emoji" aria-hidden="true">🦞</span>
                    Zet je vacature gratis online
                </a>
                <a class="wl-btn wl-btn--whatsapp" href="@_whatsAppUrl" target="_blank" rel="noopener noreferrer">
                    <span class="wl-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    </span>
                    WhatsApp Dennis
                </a>
            </div>
        </div>
    </section>

    @* ——— Intro + portret ——— *@
    <section class="wl-intro" aria-labelledby="wl-intro-title">
        <div class="wl-intro__copy">
            <p class="wl-kicker">Hallo, ik ben Dennis</p>
            <h2 id="wl-intro-title">Waarom ik Lobsy startte</h2>
            <p>
                Ik zie elke dag hoe lastig het is: ondernemers in het Westland die goede mensen zoeken,
                en werkzoekenden die wél willen werken — maar niet een uur in de file of op de fiets naar
                de verkeerde kant van de regio. Traditionele vacaturesites voelen koud, traag en ver weg.
            </p>
            <p>
                Lobsy is mijn antwoord: een eerlijk, laagdrempelig platform dat de lokale gemeenschap,
                ondernemers en werkzoekenden écht met elkaar verbindt — op basis van <strong>reistijd en vervoer</strong>.
                Van bakker tot uitzendbureau, van kas tot kassa. Ons-kent-ons, maar dan modern.
            </p>
            <p class="wl-intro__whatsapp-note">
                Prangende vraag? App me gerust op WhatsApp.
                <strong>Tijdens werktijden reageer ik zo snel mogelijk</strong> — beloofd.
            </p>
            <a class="wl-text-link" href="@_whatsAppUrl" target="_blank" rel="noopener noreferrer">
                Stuur Dennis een WhatsApp →
            </a>
        </div>
        <figure class="wl-portrait">
            <div class="wl-portrait__frame">
                <img class="wl-portrait__img"
                     src="images/brand/dennis.jpg"
                     alt="Portret van Dennis Bemer, oprichter van Lobsy"
                     width="640"
                     height="800"
                     loading="lazy"
                     @onerror="OnPortraitError" />
                @if (_portraitMissing)
                {
                    <div class="wl-portrait__fallback" aria-hidden="true">
                        <span class="wl-portrait__initials">DB</span>
                        <span class="wl-portrait__hint">Plaats dennis.jpg in images/brand/</span>
                    </div>
                }
            </div>
            <figcaption class="wl-portrait__caption">
                <blockquote class="wl-portrait__quote">
                    “Dichtbij werk vinden — en dichtbij mensen vinden — hoort bij hoe het Westland voelt.”
                </blockquote>
                <p class="wl-portrait__sign">— Dennis Bemer, oprichter van Lobsy</p>
            </figcaption>
        </figure>
    </section>

    @* ——— Livedatum & gratis ——— *@
    <section class="wl-launch" aria-labelledby="wl-launch-title">
        <div class="wl-launch__inner">
            <p class="wl-kicker wl-kicker--on-dark">De grote dag</p>
            <h2 id="wl-launch-title" class="wl-launch__date">
                <span class="wl-launch__day">18</span>
                <span class="wl-launch__month">november</span>
                <span class="wl-launch__year">we gaan live</span>
            </h2>
            <p class="wl-launch__lead">
                Tot die datum mogen <strong>alle ondernemers in het Westland</strong> —
                van bakker tot uitzendbureau en supermarkt — hun vacatures
                <strong>volledig gratis</strong> online zetten.
            </p>
            <ul class="wl-launch__perks">
                <li>
                    <strong>Gratis tot 18 november</strong>
                    — onbeperkt basisvacatures plaatsen terwijl we samen het platform vullen.
                </li>
                <li>
                    <strong>Vrijwilligerswerk &amp; stages</strong>
                    — de eerste <strong>3 jaar 100% gratis</strong>. Maatschappelijk steuntje, altijd.
                </li>
            </ul>
            <a class="wl-btn wl-btn--primary wl-btn--on-dark" href="/register">
                <span class="wl-btn__emoji" aria-hidden="true">🦞</span>
                Ik doe mee — gratis starten
            </a>
        </div>
    </section>

    @* ——— Tarieven na 18 nov ——— *@
    <section class="wl-rates" aria-labelledby="wl-rates-title">
        <header class="wl-rates__header">
            <p class="wl-kicker">Transparant, geen verrassingen</p>
            <h2 id="wl-rates-title">Wat gebeurt er na 18 november?</h2>
            <p class="wl-rates__lead">
                Dan gelden de standaardtarieven. Heldere tokens, duidelijke pakketten —
                zodat je precies weet waar je aan toe bent.
            </p>
        </header>

        <div class="wl-rates__grid">
            <div class="wl-rate">
                <h3 class="wl-rate__title">Losse tokens</h3>
                <p class="wl-rate__price"><span class="wl-rate__amount">€&nbsp;25</span> <span class="wl-rate__unit">per token</span></p>
                <p class="wl-rate__note">Flexibel bijvullen wanneer jij wilt.</p>
            </div>

            <div class="wl-rate">
                <h3 class="wl-rate__title">Tokenpakketten</h3>
                <dl class="wl-rate__list">
                    <div class="wl-rate__row">
                        <dt>1× 10 tokens</dt>
                        <dd>€&nbsp;250 <span class="wl-rate__bonus">+ 1 token gratis</span></dd>
                    </div>
                    <div class="wl-rate__row">
                        <dt>1× 25 tokens</dt>
                        <dd>€&nbsp;625 <span class="wl-rate__bonus">+ 3 tokens gratis</span></dd>
                    </div>
                </dl>
            </div>

            <div class="wl-rate wl-rate--deal">
                <p class="wl-rate__badge">Voor de grotere spelers</p>
                <h3 class="wl-rate__title">Exclusieve jaardeal</h3>
                <p class="wl-rate__price"><span class="wl-rate__amount">€&nbsp;3.000</span> <span class="wl-rate__unit">vooraf</span></p>
                <ul class="wl-rate__deal-points">
                    <li>Elke maand <strong>25 tokens</strong></li>
                    <li><strong>50% korting</strong> op al je vervolgtokens</li>
                </ul>
            </div>
        </div>

        <aside class="wl-rates__nuance" aria-label="Belangrijke nuance gratis periode">
            <h3>Belangrijk over de gratis periode</h3>
            <ul>
                <li>Aanmeldingen <strong>vóór 18 november</strong> krijgen <strong>geen welkomsttoken</strong>.</li>
                <li>Extra’s zoals <strong>Highlights</strong> en <strong>Pushboms</strong> zitten <strong>niet</strong> in de gratis periode.</li>
                <li>Vanaf 18 november gelden bovenstaande standaardtarieven.</li>
            </ul>
        </aside>
    </section>

    @* ——— Slot-CTA ——— *@
    <section class="wl-finale" aria-labelledby="wl-finale-title">
        <h2 id="wl-finale-title">Klaar om mee te doen?</h2>
        <p>
            Of je nu bakker bent in Naaldwijk, logistiek runt in Honselersdijk, of gewoon
            nieuwsgierig bent: begin vandaag. Vacature online, mensen dichterbij.
        </p>
        <div class="wl-finale__cta">
            <a class="wl-btn wl-btn--primary" href="/register">
                <span class="wl-btn__emoji" aria-hidden="true">🦞</span>
                Registreren &amp; vacature plaatsen
            </a>
            <a class="wl-btn wl-btn--whatsapp" href="@_whatsAppUrl" target="_blank" rel="noopener noreferrer">
                WhatsApp — ik help je graag
            </a>
        </div>
        <p class="wl-finale__fine">
            <a href="/">Naar de banenkaart</a>
            ·
            <a href="/wie-zijn-wij">Meer over Lobsy</a>
        </p>
    </section>
</div>

@code {
    private string _whatsAppUrl = WestlandTeaserContacts.BuildWhatsAppUrl(null);
    private bool _portraitMissing;

    protected override void OnInitialized()
    {
        var configured = Config["TeaserLanding:WhatsAppE164"];
        _whatsAppUrl = WestlandTeaserContacts.BuildWhatsAppUrl(configured);
    }

    private void OnPortraitError()
    {
        _portraitMissing = true;
    }
}
