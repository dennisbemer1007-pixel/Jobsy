@page "/partner"
@page "/partner/{TrackingCode?}"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@layout PublicLayout
@using Jobsy.Core.Features
@using Jobsy.Core.Rules
@using Jobsy.Core.Sales
@using Jobsy.Web.Sales
@attribute [RequiresFeature(PlatformFeature.Employers, FallbackPath = "/")]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IConfiguration Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<PartnerSales> Logger

<PageTitle>@Culture["PartnerPage.Seo.Title"] · Lobsy</PageTitle>
<PageSeo Title="@Culture["PartnerPage.Seo.Title"]"
         Description="@Culture["PartnerPage.Seo.Description"]"
         CanonicalPath="/partner"
         Index="@(string.IsNullOrEmpty(TrackingCode))" />

<section class="pub-section pp-partner" aria-labelledby="partner-title">
    <header class="pp-partner__hero">
        <div class="pp-partner__hero-copy">
            <p class="pp-doc__eyebrow">
                <PubEmoji Glyph="🤝" />
                <span>@Culture["PartnerPage.Eyebrow"]</span>
            </p>
            <h1 id="partner-title" class="pp-doc__title">@Culture["PartnerPage.Title"]</h1>
            <p class="pp-doc__lead">@Culture["PartnerPage.Lead"]</p>
            <div class="pp-partner__cta">
                <a class="pub-btn pub-btn--primary" href="@RegisterHref">@Culture["PartnerPage.RegisterCta"]</a>
                <a class="pub-btn pub-btn--secondary" href="#tarieven">@Culture["PartnerPage.RatesCta"]</a>
            </div>
        </div>
        <LobsyMascot Pose="MascotPose.Waving" Size="MascotSize.Large" Alt="" />
    </header>

    <div class="pp-partner__usps" aria-label="@Culture["PartnerPage.Usps.Label"]">
        <article class="pub-card pp-partner__usp">
            <PubEmoji Glyph="📍" />
            <h2>@Culture["PartnerPage.Usp.Nearby.Title"]</h2>
            <p>@Culture["PartnerPage.Usp.Nearby.Body"]</p>
        </article>
        <article class="pub-card pp-partner__usp">
            <PubEmoji Glyph="🪙" />
            <h2>@Culture["PartnerPage.Usp.PerVacancy.Title"]</h2>
            <p>@Culture["PartnerPage.Usp.PerVacancy.Body"]</p>
        </article>
        <article class="pub-card pp-partner__usp">
            <PubEmoji Glyph="🎁" />
            <h2>@Culture["PartnerPage.Usp.FreeHighlight.Title"]</h2>
            <p>@Culture.Format("PartnerPage.Usp.FreeHighlight.Body", BonusTokens)</p>
        </article>
    </div>

    <section class="pub-card pp-partner__rates" id="tarieven" aria-labelledby="partner-rates-title">
        <h2 id="partner-rates-title">@Culture["PartnerPage.Rates.Title"]</h2>
        @if (_catalog is null)
        {
            <p class="pp-partner__rates-empty">@Culture["PartnerPage.RatesUnavailable"]</p>
        }
        else
        {
            <p class="pp-partner__token-value">
                @Culture.Format("PartnerPage.Rates.TokenValue", ExVat(_catalog.BaseTokenValueEuro))
                <span class="pp-partner__incl">@Culture.Format("PartnerPage.Rates.InclVat", InclVat(_catalog.BaseTokenValueEuro))</span>
            </p>
            <table class="pp-partner__table">
                <thead>
                    <tr>
                        <th scope="col">@Culture["PartnerPage.Rates.Kind"]</th>
                        <th scope="col">@Culture["PartnerPage.Rates.Tokens"]</th>
                        <th scope="col">@Culture["PartnerPage.Rates.Price"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows())
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            <td>@row.Tokens</td>
                            <td>
                                @if (row.IsFree)
                                {
                                    <strong class="pp-partner__free">@Culture["PartnerPage.Rates.Free"]</strong>
                                }
                                else
                                {
                                    <strong>@row.ExVat</strong>
                                    <span class="pp-partner__incl">@Culture.Format("PartnerPage.Rates.InclVat", row.InclVat)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="pp-partner__vat-note">@Culture["PartnerPage.Rates.ExclVatNote"]</p>
            <p class="pp-partner__packages-note">@Culture["PartnerPage.Rates.PackagesNote"]</p>
        }
    </section>

    <section class="pub-card pp-partner__share" aria-labelledby="partner-share-title">
        <h2 id="partner-share-title">
            <PubEmoji Glyph="📣" />
            @Culture["PartnerPage.Share.Title"]
        </h2>
        <p>@Culture["PartnerPage.Share.Body"]</p>
        <div class="pp-partner__share-links">
            <a class="pub-chip pp-partner__share-link" href="@WhatsAppHref" rel="nofollow noopener">
                @Culture["PartnerPage.Share.WhatsApp"]
            </a>
            <a class="pub-chip pp-partner__share-link" href="@MailHref">
                @Culture["PartnerPage.Share.Mail"]
            </a>
            <a class="pub-chip pp-partner__share-link" href="@FlyerHref" rel="nofollow">
                @Culture["PartnerPage.Share.Flyer"]
            </a>
        </div>
        @if (!string.IsNullOrWhiteSpace(_trackingCode))
        {
            <p class="pp-partner__code">
                @Culture["PartnerPage.SalesCode"]: <strong>@_trackingCode</strong>
            </p>
        }
    </section>
</section>

@code {
    private sealed record RateRow(string Label, string Tokens, string ExVat, string InclVat, bool IsFree);

    [Parameter] public string? TrackingCode { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? RefCode { get; set; }

    private PartnerSalesCatalog? _catalog;
    private string? _trackingCode;

    private string RegisterHref => string.IsNullOrWhiteSpace(_trackingCode)
        ? PublicRoutes.CompanyRegister
        : $"{PublicRoutes.CompanyRegister}?ref={Uri.EscapeDataString(_trackingCode)}";

    private string FlyerHref => string.IsNullOrWhiteSpace(_trackingCode)
        ? PartnerFlyerEndpoints.Path
        : $"{PartnerFlyerEndpoints.Path}?code={Uri.EscapeDataString(_trackingCode)}";

    private string PartnerPageUrl
    {
        get
        {
            var origin = PageSeoResolver.Origin(Navigation.Uri, Configuration).TrimEnd('/');
            return string.IsNullOrWhiteSpace(_trackingCode)
                ? $"{origin}{PublicRoutes.Partner}"
                : $"{origin}{PublicRoutes.Partner}/{Uri.EscapeDataString(_trackingCode)}";
        }
    }

    private string WhatsAppHref
        => "https://wa.me/?text="
           + Uri.EscapeDataString(Culture.Format("PartnerPage.Share.Text", PartnerPageUrl));

    private string MailHref => MailtoLink.Build(
        Culture["PartnerPage.Share.Subject"],
        Culture.Format("PartnerPage.Share.Body.Mail", PartnerPageUrl));

    private string BonusTokens => (_catalog?.StartHighlightBonusTokens
                                   ?? VacancyProductRules.DefaultHighlightCarouselTokens).ToString("0.##");

    [SupplyParameterFromQuery(Name = "b")] public string? Channel { get; set; }
    [SupplyParameterFromQuery(Name = "preview")] public string? Preview { get; set; }

    private bool IsPreview =>
        string.Equals(Preview, "1", StringComparison.Ordinal)
        || string.Equals(Preview, "true", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var raw = FirstNonEmpty(TrackingCode, RefCode)?.Trim().ToUpperInvariant();
        _trackingCode = SalesTrackingCodes.Normalize(raw) is { } code
                        && !SalesTrackingCodes.IsAmbassadeur(code)
            ? code
            : null;

        if (_trackingCode is not null)
        {
            await TryRecordVisitAndCookieAsync(_trackingCode);
        }

        try
        {
            _catalog = await Api.GetPartnerSalesCatalogAsync();
        }
        catch (Exception ex)
        {
            // The page still sells the idea; only the rates table is dropped (never ex.Message).
            Logger.LogWarning(ex, "Partner rates unavailable for request {RequestId}", RequestId);
        }
    }

    private string? RequestId => HttpContextAccessor.HttpContext?.TraceIdentifier;

    /// <summary>Sales attribution stays best effort: the page renders even when telemetry fails.</summary>
    private async Task TryRecordVisitAndCookieAsync(string code)
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null || http.Response.HasStarted)
        {
            return;
        }

        var isBot = BotUserAgents.IsBot(http.Request.Headers.UserAgent.ToString());
        var sameDay = SalesReferralCookie.AlreadyHoldsCodeToday(http, code);
        try
        {
            var visit = await Api.RecordSalesReferralVisitAsync(
                code,
                Channel,
                countClick: !IsPreview && !isBot && !sameDay);
            if (visit is { Active: true } && !IsPreview && !http.Response.HasStarted)
            {
                SalesReferralCookie.TrySetFirstClick(http, code, visit.CookieDays);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Sales referral visit not recorded for request {RequestId}", RequestId);
        }
    }

    private IReadOnlyList<RateRow> Rows()
    {
        if (_catalog is null)
        {
            return [];
        }

        var rows = new List<RateRow>();
        foreach (var cost in _catalog.VacancyTypeCosts.Where(c => c.IsActive))
        {
            rows.Add(Row(cost.Label, cost.CostTokens, cost.PriceEuro));
        }

        rows.Add(Row(
            Culture.Format("PartnerPage.Rates.Highlight", _catalog.HighlightCarouselDays.ToString()),
            _catalog.HighlightCarouselTokens,
            Math.Round(_catalog.HighlightCarouselTokens * _catalog.BaseTokenValueEuro, 2)));

        return rows;
    }

    private RateRow Row(string label, decimal tokens, decimal priceInclVatEuro)
    {
        var free = tokens <= 0m;
        return new RateRow(
            label,
            free ? Culture["PartnerPage.Rates.NoTokens"] : tokens.ToString("0.##"),
            free ? string.Empty : ExVat(priceInclVatEuro),
            free ? string.Empty : InclVat(priceInclVatEuro),
            free);
    }

    /// <summary>
    /// Stored catalog amounts are the amounts Mollie charges, and those are incl. 21% btw
    /// (<see cref="TokenVatPricing"/>). D5 shows the excl. amount as the main number.
    /// </summary>
    private static string ExVat(decimal inclVatEuro)
        => SalesMoney.FormatPlain(
            TokenVatPricing.FromCents(TokenVatPricing.SplitInclVatEuros(inclVatEuro).ExVatCents));

    private static string InclVat(decimal inclVatEuro) => SalesMoney.FormatPlain(inclVatEuro);

    private static string? FirstNonEmpty(params string?[] values)
    {
        foreach (var v in values)
        {
            if (!string.IsNullOrWhiteSpace(v))
            {
                return v;
            }
        }

        return null;
    }
}
