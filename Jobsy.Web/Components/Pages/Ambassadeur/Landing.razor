@page "/werven/{TrackingCode}"
@page "/ambassadeur/ref/{TrackingCode}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Jobsy.Core.Rules
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<div class="panel-page">
    <p class="state-message">Je wordt doorgestuurd naar Lobsy…</p>
</div>

@code {
    [Parameter] public string TrackingCode { get; set; } = "";

    protected override void OnInitialized()
    {
        var code = (TrackingCode ?? "").Trim().ToUpperInvariant();
        var http = HttpContextAccessor.HttpContext;
        var valid = AmbassadeurCommissionRules.IsAmbassadeurTrackingCode(code);
        if (http is not null && valid)
        {
            http.Response.Cookies.Append(
                "lobsy_ambassadeur_ref",
                code,
                new CookieOptions
                {
                    HttpOnly = true,
                    IsEssential = true,
                    SameSite = SameSiteMode.Lax,
                    Secure = JobsyCookie.ShouldMarkSecure(http),
                    MaxAge = TimeSpan.FromDays(30),
                    Path = "/"
                });
        }

        var login = valid
            ? $"/login?ref={Uri.EscapeDataString(code)}"
            : "/login";
        Navigation.NavigateTo(login, replace: true);
    }
}
