@page "/ambassadeur/payout-checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Ambassadeur")]
@inject JobsyApiClient Api

<PageTitle>Uitbetaling stub · Lobsy</PageTitle>

<PayoutCheckoutStubView CancelHref="/ambassadeur/finance"
                        SuccessNavigateHref="/ambassadeur/finance"
                        CompleteCheckoutAsync="CompleteAsync" />

@code {
    private async Task<string?> CompleteAsync(string paymentId)
    {
        var result = await Api.CompleteMyAmbassadeurPayoutCheckoutAsync(paymentId);
        return result?.InvoiceNumber;
    }
}
