@page "/ambassadeur/finance"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Ambassadeur")]
@inject JobsyApiClient Api
@inject NavigationManager Nav
@inject CultureState Culture

<PageTitle>@Culture["Ambassadeur.Finance"] · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>@Culture["Ambassadeur.Finance"]</h1>
            <p class="login-lead">@Culture["Ambassadeur.FinanceLead"]</p>
        </div>
        <button class="login-submit" type="button" disabled="@_busy" @onclick="OpenPayoutModalAsync">Bedrag laten uitkeren</button>
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (_dashboard is not null)
    {
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-card__label">Saldo excl. BTW</span>
                <strong class="stat-card__value">€ @_dashboard.BalanceExVat.ToString("0.00")</strong>
            </div>
            <div class="stat-card">
                <span class="stat-card__label">Niet gefactureerd</span>
                <strong class="stat-card__value">€ @_dashboard.UninvoicedExVat.ToString("0.00")</strong>
            </div>
            <div class="stat-card">
                <span class="stat-card__label">Commissie%</span>
                <strong class="stat-card__value">@_dashboard.CurrentCommissionPercentage.ToString("0.##")%</strong>
            </div>
        </div>

        <section class="panel-section">
            <h2>Commissies per transactie</h2>
            @if (_dashboard.RecentLedger.Count == 0)
            {
                <p class="muted">Nog geen commissies.</p>
            }
            else
            {
                <div class="table-list">
                    @foreach (var e in _dashboard.RecentLedger)
                    {
                        <div class="table-row">
                            <div>
                                <strong>@e.Kind</strong>
                                <div class="muted">@(e.CompanyName ?? "—") · @e.CreatedAt.ToLocalTime().ToString("g")</div>
                                @if (!string.IsNullOrWhiteSpace(e.Note))
                                {
                                    <div class="muted">@e.Note</div>
                                }
                            </div>
                            <span>€ @e.AmountExVat.ToString("0.00")</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-section">
            <h2>Facturen</h2>
            @if (_dashboard.Invoices.Count == 0)
            {
                <p class="muted">Nog geen facturen. Start een uitbetaling om een self-billing factuur te maken.</p>
            }
            else
            {
                <div class="table-list">
                    @foreach (var inv in _dashboard.Invoices)
                    {
                        <div class="table-row">
                            <div>
                                <strong>@inv.InvoiceNumber</strong>
                                <div class="muted">@inv.Status · @inv.CreatedAt.ToLocalTime().ToString("g")</div>
                            </div>
                            <span>€ @inv.TotalInclVat.ToString("0.00") incl. BTW</span>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@if (_modalOpen)
{
    <div class="share-modal-backdrop" @onclick="CloseModal"></div>
    <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="am-payout-title"
         style="width:min(28rem, calc(100vw - 2rem));max-width:calc(100vw - 2rem)">
        <div class="share-modal__header">
            <h2 id="am-payout-title">Bedrag laten uitkeren</h2>
            <button type="button" class="share-modal__close" @onclick="CloseModal" aria-label="@Culture["Common.Close"]">×</button>
        </div>
        @if (_preview is null)
        {
            <p class="state-message">@Culture["Common.Loading"]</p>
        }
        else if (!_preview.CanPayout && _preview.AvailableExVat <= 0)
        {
            <p class="share-modal__lead" style="white-space:normal;max-width:none">@_preview.BlockReason</p>
            <div class="inline-actions" style="margin-top:1rem">
                <button type="button" class="btn-compact" @onclick="CloseModal">Sluiten</button>
            </div>
        }
        else
        {
            <p class="share-modal__lead" style="white-space:normal;max-width:none">
                Beschikbaar: € @_preview.AvailableExVat.ToString("0.00") excl. BTW · IBAN @_preview.MaskedIban
            </p>
            @if (!string.IsNullOrWhiteSpace(_preview.BlockReason) && !_preview.CanPayout)
            {
                <p class="state-message error">@_preview.BlockReason</p>
            }
            <label>
                Bedrag excl. BTW
                <input type="number" step="0.01" min="0.01" @bind="_amountInput" />
            </label>
            <div class="inline-actions" style="margin-top:1rem;gap:0.5rem">
                <button type="button" class="btn-compact btn-compact--primary" disabled="@_busy" @onclick="StartPayoutAsync">
                    Doorgaan naar uitbetaling
                </button>
                <button type="button" class="btn-compact" @onclick="CloseModal">Annuleren</button>
            </div>
        }
    </div>
}

@code {
    private AmbassadeurDashboard? _dashboard;
    private SalesManagerPayoutPreview? _preview;
    private bool _loading = true;
    private bool _busy;
    private bool _modalOpen;
    private decimal _amountInput;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("paid", out var paid) && !string.IsNullOrWhiteSpace(paid))
        {
            _message = $"Uitbetaling verwerkt: {paid}";
        }

        try
        {
            _dashboard = await Api.GetMyAmbassadeurDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenPayoutModalAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _preview = await Api.GetMyAmbassadeurPayoutPreviewAsync();
            _amountInput = _preview?.AvailableExVat ?? 0;
            _modalOpen = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseModal() => _modalOpen = false;

    private async Task StartPayoutAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.CreateMyAmbassadeurPayoutCheckoutAsync(_amountInput);
            if (result is null || string.IsNullOrWhiteSpace(result.CheckoutUrl))
            {
                throw new InvalidOperationException("Checkout starten mislukt.");
            }

            Nav.NavigateTo(result.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
