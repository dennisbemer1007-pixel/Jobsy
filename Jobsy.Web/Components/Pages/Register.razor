@page "/register"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.RegisterTitle"]</PageTitle>

<div class="login-page">
    <div class="login-card register-card">
        <h1>@Culture["Register.CompanyTitle"]</h1>
        <p class="login-lead">@Culture["Register.Lead"]</p>

        <div class="wizard-steps" aria-label="@Culture["Register.Steps"]">
            <span class="@StepClass(1)">@Culture["Register.StepKvk"]</span>
            <span class="@StepClass(2)">@Culture["Register.StepBranch"]</span>
            <span class="@StepClass(3)">@Culture["Register.StepScope"]</span>
            <span class="@StepClass(4)">@Culture["Register.StepContact"]</span>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error">@_error</p>
        }

        @if (_step == 1)
        {
            <form class="login-form" @onsubmit="LookupAsync" @onsubmit:preventDefault>
                <label>
                    @Culture["Register.KvkNumber"]
                    <input @bind="_kvkNumber" placeholder="@Culture["Register.KvkPlaceholder"]" required maxlength="20" />
                </label>
                <p class="muted">Stub-KVK’s: 12345678 (werkgever), 55667788 (intermediair SBI 78)</p>
                <button class="login-submit" type="submit" disabled="@_busy">@Culture["Register.SearchEstablishments"]</button>
            </form>
        }
        else if (_step == 2 && _kvkUnavailable)
        {
            <p class="state-message">@_error ?? "KVK-dienst is tijdelijk niet beschikbaar. Vul je vestiging handmatig in — verificatie volgt automatisch later."</p>
            <form class="login-form" @onsubmit="ContinuePendingKvk" @onsubmit:preventDefault>
                <label>
                    Vestigingsnaam
                    <input @bind="_manualName" required maxlength="256" />
                </label>
                <label>
                    Adres
                    <input @bind="_manualAddress" required maxlength="512" />
                </label>
                <label>
                    Vestigingsnummer
                    <input @bind="_manualEstablishmentNumber" required maxlength="16" placeholder="0001" />
                </label>
                <p class="muted">Intermediair-rol (SBI 78) wordt pas toegekend nadat KVK-verificatie slaagt — niet handmatig tijdens een storing.</p>
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="() => { _step = 1; _kvkUnavailable = false; _error = null; }">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="submit" disabled="@_busy">Doorgaan (KVK in afwachting)</button>
                </div>
            </form>
        }
        else if (_step == 2)
        {
            <div class="table-list">
                @foreach (var e in _establishments)
                {
                    <button type="button"
                            class="table-row register-choice @(_selected?.KvkEstablishmentId == e.KvkEstablishmentId ? "is-selected" : null)"
                            @onclick="() => SelectEstablishment(e)">
                        <div>
                            <strong>@e.Name</strong>
                            <span class="muted">@e.Address · @e.KvkEstablishmentId</span>
                            @if (e.SbiCodes is { Count: > 0 })
                            {
                                <span class="muted"> · SBI @string.Join(", ", e.SbiCodes)</span>
                            }
                        </div>
                        <span class="@(e.IsInUse ? "badge-warn" : "badge-ok")">
                            @(e.IsInUse ? Culture["Register.InUse"] : Culture["Register.Available"])
                        </span>
                    </button>
                }
            </div>
            <div class="wizard-actions">
                <button class="provider-btn" type="button" @onclick="() => _step = 1">@Culture["Common.Back"]</button>
                <button class="login-submit" type="button" disabled="@(_selected is null)" @onclick="GoToScopeOrContact">
                    @Culture["Common.Next"]
                </button>
            </div>
        }
        else if (_step == 3)
        {
            @if (_selected?.IsIntermediarySbi == true)
            {
                <p class="state-message">@Culture["Register.IntermediaryRoleHint"]</p>
                @if (_selected?.IsInUse == true)
                {
                    <p class="state-message">@Culture["Register.AlreadyRegistered"]</p>
                }
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="() => _step = 2">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="button" @onclick="() => _step = 4">@Culture["Common.Next"]</button>
                </div>
            }
            else
            {
                <fieldset class="scope-fieldset">
                    <legend>@Culture["Register.ScopeLegend"]</legend>
                    <label class="scope-option">
                        <input type="radio" name="scope" checked="@(_scope == "Organization")"
                               @onchange="@(() => _scope = "Organization")" />
                        <span>
                            <strong>@Culture["Register.ScopeOrg"]</strong>
                            <span class="muted">@Culture["Register.ScopeOrgHint"]</span>
                        </span>
                    </label>
                    <label class="scope-option">
                        <input type="radio" name="scope" checked="@(_scope == "BranchOnly")"
                               @onchange="@(() => _scope = "BranchOnly")" />
                        <span>
                            <strong>@Culture["Register.ScopeBranch"]</strong>
                            <span class="muted">@Culture["Register.ScopeBranchHint"]</span>
                        </span>
                    </label>
                </fieldset>

                @if (_selected?.IsInUse == true)
                {
                    <p class="state-message">@Culture["Register.AlreadyRegistered"]</p>
                }

                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="() => _step = 2">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="button" @onclick="() => _step = 4">@Culture["Common.Next"]</button>
                </div>
            }
        }
        else if (_step == 4)
        {
            <form class="login-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <label>
                    @Culture["Common.Name"]
                    <input @bind="_contactName" required maxlength="256" />
                </label>
                <label>
                    @Culture["Common.Email"]
                    <input type="email" @bind="_contactEmail" required maxlength="256" autocomplete="username" />
                </label>
                <label>
                    @Culture["Register.Password"]
                    <input type="password" @bind="_password" required minlength="8" maxlength="128" autocomplete="new-password" />
                </label>
                <label>
                    @Culture["Register.PasswordConfirm"]
                    <input type="password" @bind="_passwordConfirm" required minlength="8" maxlength="128" autocomplete="new-password" />
                </label>
                <p class="muted">@Culture["Register.PasswordHint"]</p>
                <label>
                    @Culture["Common.Phone"] (@Culture["Common.Optional"])
                    <input @bind="_contactPhone" maxlength="64" />
                </label>
                <label>
                    @Culture["Register.SalesCode"] (@Culture["Common.Optional"])
                    <input @bind="_salesManagerCode" maxlength="32" placeholder="SM-XXXXXX" />
                </label>
                <p class="muted">@Culture["Register.SalesCodeHint"]</p>
                <p class="muted">@Culture.Format("Register.Chosen", _selected?.Name ?? "", ScopePreviewLabel())</p>
                <label class="profile-toggle legal-consent">
                    <input type="checkbox" @bind="_acceptedTerms" required />
                    <span>
                        @Culture["Register.AcceptTerms"]
                        <a class="auth-link" href="/algemene-voorwaarden" target="_blank" rel="noopener">@Culture["Register.Terms"]</a>
                        @Culture["Register.TermsTail"]
                        <a class="auth-link" href="/privacy" target="_blank" rel="noopener">@Culture["Register.Privacy"]</a>.
                    </span>
                </label>
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="() => _step = 3">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="submit" disabled="@(_busy || !_acceptedTerms)">@Culture["Register.Submit"]</button>
                </div>
            </form>
        }
        else if (_step == 5)
        {
            <p class="state-message">@_message</p>
            @if (!string.IsNullOrEmpty(_activationUrl))
            {
                <p class="muted">@Culture["Register.ActivationLinkHint"]</p>
                <p><a class="auth-link" href="@_activationUrl">@_activationUrl</a></p>
            }
            else
            {
                <p class="muted">@Culture["Register.CheckEmail"]</p>
            }
            <a class="login-submit" href="/login" style="display:inline-block;text-align:center;text-decoration:none;margin-top:1rem">
                @Culture["Register.GoLogin"]
            </a>
        }

        <p class="muted" style="margin-top:1.25rem">
            Al een account? <a class="auth-link" href="/login">@Culture["Auth.Login"]</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ref")] public string? RefCode { get; set; }

    private int _step = 1;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string? _activationUrl;
    private string _kvkNumber = "12345678";
    private string _scope = "Organization";
    private string _contactName = "";
    private string _contactEmail = "";
    private string _contactPhone = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private string _salesManagerCode = "";
    private bool _acceptedTerms;
    private bool _kvkUnavailable;
    private bool _pendingKvk;
    private string _manualName = "";
    private string _manualAddress = "";
    private string _manualEstablishmentNumber = "0001";
    private List<KvkEstablishmentItem> _establishments = [];
    private KvkEstablishmentItem? _selected;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        if (!string.IsNullOrWhiteSpace(RefCode))
        {
            _salesManagerCode = RefCode.Trim().ToUpperInvariant();
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    private string StepClass(int n) => _step == n ? "wizard-step is-active" : "wizard-step";

    private async Task LookupAsync()
    {
        _busy = true;
        _error = null;
        _kvkUnavailable = false;
        _pendingKvk = false;
        try
        {
            var lookup = await Api.LookupRegistrationEstablishmentsAsync(_kvkNumber.Trim());
            if (lookup.IsUnavailable)
            {
                _kvkUnavailable = true;
                _error = lookup.Message;
                _selected = null;
                _step = 2;
                return;
            }

            _establishments = lookup.Establishments;
            if (_establishments.Count == 0)
            {
                _error = lookup.Message ?? "Geen vestigingen gevonden voor dit KVK-nummer.";
                return;
            }

            _selected = null;
            _step = 2;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ContinuePendingKvk()
    {
        if (string.IsNullOrWhiteSpace(_manualName)
            || string.IsNullOrWhiteSpace(_manualAddress)
            || string.IsNullOrWhiteSpace(_manualEstablishmentNumber))
        {
            _error = "Vul vestigingsnaam, adres en vestigingsnummer in.";
            return;
        }

        var kvk = new string(_kvkNumber.Where(char.IsDigit).ToArray());
        var est = _manualEstablishmentNumber.Trim();
        var digits = new string(est.Where(char.IsDigit).ToArray());
        if (digits.Length is > 0 and <= 4)
        {
            est = digits.PadLeft(4, '0');
        }

        _selected = new KvkEstablishmentItem
        {
            KvkNumber = kvk,
            EstablishmentNumber = est,
            KvkEstablishmentId = $"{kvk}_{est}",
            Name = _manualName.Trim(),
            Address = _manualAddress.Trim(),
            Latitude = 52.1326,
            Longitude = 5.2913,
            IsInUse = false,
            SbiCodes = null
        };
        _pendingKvk = true;
        _error = null;
        _step = 3;
    }

    private void SelectEstablishment(KvkEstablishmentItem e) => _selected = e;

    private void GoToScopeOrContact()
    {
        if (_selected is null)
        {
            return;
        }

        if (_selected.IsIntermediarySbi)
        {
            // Server forces BranchOnly for Intermediair (single company, no employer org tree).
            _scope = "BranchOnly";
        }

        _step = 3;
    }

    private string ScopePreviewLabel()
    {
        if (_selected?.IsIntermediarySbi == true)
        {
            return Culture["Register.ScopeIntermediary"];
        }

        return _scope == "Organization"
            ? Culture["Register.ScopeOrg"]
            : Culture["Register.ScopeBranch"];
    }

    private async Task SubmitAsync()
    {
        if (_selected is null)
        {
            _error = "Kies eerst een vestiging.";
            return;
        }

        if (!_acceptedTerms)
        {
            _error = "Je moet akkoord gaan met de algemene voorwaarden en de privacyverklaring.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 8)
        {
            _error = Culture["Register.PasswordTooShort"];
            return;
        }

        if (!string.Equals(_password, _passwordConfirm, StringComparison.Ordinal))
        {
            _error = Culture["Register.PasswordMismatch"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.SubmitRegistrationAsync(
                _selected.KvkNumber,
                _selected.KvkEstablishmentId,
                _selected.IsIntermediarySbi ? "BranchOnly" : _scope,
                _contactName.Trim(),
                _contactEmail.Trim(),
                string.IsNullOrWhiteSpace(_contactPhone) ? null : _contactPhone.Trim(),
                acceptedTerms: true,
                salesManagerTrackingCode: string.IsNullOrWhiteSpace(_salesManagerCode)
                    ? null
                    : _salesManagerCode.Trim(),
                password: _password,
                allowPendingKvkVerification: _pendingKvk,
                manualEstablishmentName: _pendingKvk ? _selected.Name : null,
                manualEstablishmentAddress: _pendingKvk ? _selected.Address : null,
                manualEstablishmentNumber: _pendingKvk ? _selected.EstablishmentNumber : null,
                manualLatitude: _pendingKvk ? _selected.Latitude : null,
                manualLongitude: _pendingKvk ? _selected.Longitude : null,
                manualIsIntermediarySbi: null);

            _message = result.Message;
            _activationUrl = result.ActivationUrl;
            _password = "";
            _passwordConfirm = "";
            _step = 5;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
