@page "/register"
@layout Jobsy.Web.Components.Layout.WaPublicLayout
@using Jobsy.Web.Components.Registration
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Jobsy.Core.Features
@attribute [RequiresFeature(PlatformFeature.Employers)]
@inject NavigationManager Navigation
@inject CultureState Culture

<PageTitle>@Culture["Page.RegisterTitle"]</PageTitle>

@if (_redirecting)
{
    <p class="wa-hint">…</p>
}
else
{
    <RegisterWizard DeepLinkKvk="@Kvk" RefCode="@Ref" DeepLinkEmail="@Email" ExtToken="@ExtToken" />
}

@code {
    [SupplyParameterFromQuery(Name = "kvk")] public string? Kvk { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }
    [SupplyParameterFromQuery(Name = "van")] public string? Van { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "extToken")] public string? ExtToken { get; set; }

    private bool _redirecting;

    protected override void OnInitialized()
    {
        if (string.Equals(Van, "ontdek", StringComparison.OrdinalIgnoreCase))
        {
            _redirecting = true;
            Navigation.NavigateTo("/ontdek", forceLoad: true);
        }
    }
}
