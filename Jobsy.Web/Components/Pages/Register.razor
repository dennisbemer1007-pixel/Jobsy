@page "/register"
@using Jobsy.Web.Auth
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@inject IHostEnvironment HostEnvironment
@implements IDisposable

<PageTitle>@Culture["Page.RegisterTitle"]</PageTitle>

<div class="login-page">
    <div class="login-card register-card">
        <div class="login-brand register-brand">
            <LobsyLogo Class="login-brand__logo" Alt="Lobsy" />
            <span class="login-brand__name">Lobsy</span>
        </div>

        @if (_step < 5)
        {
            <h1>@Culture["Register.CompanyTitle"]</h1>
            <p class="login-lead">@Culture["Register.Lead"]</p>

            <div class="wizard-steps" aria-label="@Culture["Register.Steps"]">
                <span class="@StepClass(1)">@Culture["Register.StepKvk"]</span>
                <span class="@StepClass(2)">@Culture["Register.StepBranch"]</span>
                <span class="@StepClass(3)">@Culture["Register.StepScope"]</span>
                <span class="@StepClass(4)">@Culture["Register.StepContact"]</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error">@_error</p>
        }

        @if (_step == 1)
        {
            <form class="login-form" @onsubmit="LookupAsync" @onsubmit:preventDefault>
                <label>
                    @Culture["Register.KvkNumber"]
                    <input @bind="_kvkNumber" placeholder="@Culture["Register.KvkPlaceholder"]" required maxlength="20" />
                </label>
                @if (HostEnvironment.IsDevelopment())
                {
                    <p class="muted">Stub-KVK’s: 12345678 (werkgever), 55667788 (intermediair SBI 78)</p>
                }
                <button class="login-submit" type="submit" disabled="@_busy">@Culture["Register.SearchEstablishments"]</button>
            </form>
        }
        else if (_step == 2 && _kvkUnavailable)
        {
            <p class="state-message">@_error ?? "KVK-dienst is tijdelijk niet beschikbaar. Vul je vestiging handmatig in — verificatie volgt automatisch later."</p>
            <form class="login-form" @onsubmit="ContinuePendingKvk" @onsubmit:preventDefault>
                <label>
                    Vestigingsnaam
                    <input @bind="_manualName" required maxlength="256" />
                </label>
                <label>
                    Adres
                    <input @bind="_manualAddress" required maxlength="512" />
                </label>
                <label>
                    Vestigingsnummer
                    <input @bind="_manualEstablishmentNumber" required maxlength="16" placeholder="0001" />
                </label>
                <p class="muted">Intermediair-rol (SBI 78) wordt pas toegekend nadat KVK-verificatie slaagt — niet handmatig tijdens een storing.</p>
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="() => { _step = 1; _kvkUnavailable = false; _error = null; }">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="submit" disabled="@_busy">Doorgaan (KVK in afwachting)</button>
                </div>
            </form>
        }
        else if (_step == 2)
        {
            <div class="table-list register-establishment-list">
                @foreach (var e in _establishments)
                {
                    @if (e.IsInUse)
                    {
                        <div class="table-row register-choice register-choice--unavailable">
                            <div class="register-choice__main">
                                <div>
                                    <strong>@e.Name</strong>
                                    <span class="muted">@e.Address · @e.KvkEstablishmentId</span>
                                    @if (e.SbiCodes is { Count: > 0 })
                                    {
                                        <span class="muted"> · SBI @string.Join(", ", e.SbiCodes)</span>
                                    }
                                </div>
                                <span class="badge-warn">@Culture["Register.InUse"]</span>
                            </div>
                            @if (string.Equals(_claimExpandedId, e.KvkEstablishmentId, StringComparison.Ordinal))
                            {
                                <div class="register-claim-panel">
                                    <p class="register-claim-panel__text">@Culture["Register.ClaimHint"]</p>
                                    <div class="wizard-actions">
                                        <button type="button" class="login-submit login-submit--compact" @onclick="() => StartClaim(e)">
                                            @Culture["Register.ClaimContinue"]
                                        </button>
                                        <button type="button" class="provider-btn" @onclick="() => _claimExpandedId = null">
                                            @Culture["Common.Cancel"]
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="register-claim-link"
                                        @onclick="() => ExpandClaim(e.KvkEstablishmentId)">
                                    @Culture["Register.ClaimLink"]
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="table-row register-choice @(_selected?.KvkEstablishmentId == e.KvkEstablishmentId && !_claimMode ? "is-selected" : null)"
                                @onclick="() => SelectEstablishment(e)">
                            <div class="register-choice__main">
                                <div>
                                    <strong>@e.Name</strong>
                                    <span class="muted">@e.Address · @e.KvkEstablishmentId</span>
                                    @if (e.SbiCodes is { Count: > 0 })
                                    {
                                        <span class="muted"> · SBI @string.Join(", ", e.SbiCodes)</span>
                                    }
                                </div>
                                <span class="badge-ok">@Culture["Register.Available"]</span>
                            </div>
                        </button>
                    }
                }
            </div>
            <div class="wizard-actions">
                <button class="provider-btn" type="button" @onclick="BackToKvk">@Culture["Common.Back"]</button>
                <button class="login-submit" type="button"
                        disabled="@(_selected is null || _selected.IsInUse || _claimMode)"
                        @onclick="GoToScopeOrContact">
                    @Culture["Common.Next"]
                </button>
            </div>
        }
        else if (_step == 3)
        {
            @if (_selected?.IsIntermediarySbi == true)
            {
                <p class="state-message">@Culture["Register.IntermediaryRoleHint"]</p>
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="BackToBranch">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="button" @onclick="() => _step = 4">@Culture["Common.Next"]</button>
                </div>
            }
            else
            {
                <fieldset class="scope-fieldset">
                    <legend>@Culture["Register.ScopeLegend"]</legend>
                    <label class="scope-option">
                        <input type="radio" name="scope" checked="@(_scope == "Organization")"
                               @onchange="@(() => _scope = "Organization")" />
                        <span>
                            <strong>@Culture["Register.ScopeOrg"]</strong>
                            <span class="muted">@Culture["Register.ScopeOrgHint"]</span>
                        </span>
                    </label>
                    <label class="scope-option">
                        <input type="radio" name="scope" checked="@(_scope == "BranchOnly")"
                               @onchange="@(() => _scope = "BranchOnly")" />
                        <span>
                            <strong>@Culture["Register.ScopeBranch"]</strong>
                            <span class="muted">@Culture["Register.ScopeBranchHint"]</span>
                        </span>
                    </label>
                </fieldset>

                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="BackToBranch">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="button" @onclick="() => _step = 4">@Culture["Common.Next"]</button>
                </div>
            }
        }
        else if (_step == 4)
        {
            @if (_claimMode)
            {
                <p class="state-message register-claim-intro">@Culture["Register.ClaimFormIntro"]</p>
                <p class="muted">@Culture.Format("Register.ChosenCompany", _selected?.Name ?? "")</p>
                @if (_selected?.IsIntermediarySbi == true)
                {
                    <p class="muted">@Culture["Register.IntermediaryRoleHint"]</p>
                }
                else
                {
                    <fieldset class="scope-fieldset scope-fieldset--compact">
                        <legend>@Culture["Register.ScopeLegend"]</legend>
                        <label class="scope-option">
                            <input type="radio" name="claim-scope" checked="@(_scope == "BranchOnly")"
                                   @onchange="@(() => _scope = "BranchOnly")" />
                            <span>
                                <strong>@Culture["Register.ScopeBranch"]</strong>
                                <span class="muted">@Culture["Register.ScopeBranchHint"]</span>
                            </span>
                        </label>
                        <label class="scope-option">
                            <input type="radio" name="claim-scope" checked="@(_scope == "Organization")"
                                   @onchange="@(() => _scope = "Organization")" />
                            <span>
                                <strong>@Culture["Register.ScopeOrg"]</strong>
                                <span class="muted">@Culture["Register.ScopeOrgHint"]</span>
                            </span>
                        </label>
                    </fieldset>
                }
            }
            <form class="login-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <label>
                    @Culture["Common.Name"]
                    <input @bind="_contactName" required maxlength="256" />
                </label>
                <label>
                    @Culture["Common.Email"]
                    <input type="email" @bind="_contactEmail" required maxlength="256" autocomplete="username" />
                </label>
                <label>
                    @Culture["Register.Password"]
                    <input type="password" @bind="_password" required minlength="8" maxlength="128" autocomplete="new-password" />
                </label>
                <label>
                    @Culture["Register.PasswordConfirm"]
                    <input type="password" @bind="_passwordConfirm" required minlength="8" maxlength="128" autocomplete="new-password" />
                </label>
                <p class="muted">@Culture["Register.PasswordHint"]</p>
                <label>
                    @Culture["Common.Phone"] (@Culture["Common.Optional"])
                    <input @bind="_contactPhone" maxlength="64" />
                </label>
                <label>
                    @Culture["Register.SalesCode"] (@Culture["Common.Optional"])
                    <input @bind="_salesManagerCode" maxlength="32" placeholder="SM-/AM-/BM-/IM-XXXXXX" />
                </label>
                <p class="muted">@Culture["Register.SalesCodeHint"]</p>
                @if (!_claimMode)
                {
                    <p class="muted">@Culture.Format("Register.Chosen", _selected?.Name ?? "", ScopePreviewLabel())</p>
                }
                else if (_selected?.IsIntermediarySbi != true)
                {
                    <p class="muted">@Culture.Format("Register.Chosen", _selected?.Name ?? "", ScopePreviewLabel())</p>
                }
                <label class="profile-toggle legal-consent">
                    <input type="checkbox" @bind="_acceptedTerms" required />
                    <span>
                        @Culture["Register.AcceptTerms"]
                        <a class="auth-link" href="/algemene-voorwaarden" target="_blank" rel="noopener">@Culture["Register.Terms"]</a>
                        @Culture["Register.TermsTail"]
                        <a class="auth-link" href="/privacy" target="_blank" rel="noopener">@Culture["Register.Privacy"]</a>.
                    </span>
                </label>
                <div class="wizard-actions">
                    <button class="provider-btn" type="button" @onclick="BackFromContact">@Culture["Common.Back"]</button>
                    <button class="login-submit" type="submit" disabled="@(_busy || !_acceptedTerms)">
                        @(_claimMode ? Culture["Register.ClaimSubmit"] : Culture["Register.Submit"])
                    </button>
                </div>
            </form>
        }
        else if (_step == 5)
        {
            <div class="register-result" role="status">
                <img src="@Jobsy.Web.Media.BrandImages.AbsoluteWebp256"
                     alt=""
                     class="register-result__mascot"
                     width="120"
                     height="120"
                     decoding="async" />
                @if (_activationResult is not null)
                {
                    @if (_activationResult.EmailVerifiedAwaitingTakeover)
                    {
                        <h1 class="register-result__title">@Culture["Register.ClaimResultTitle"]</h1>
                        <p class="register-result__lead">@Culture["Register.TakeoverEmailVerified"]</p>
                        <p class="muted">@Culture["Register.TakeoverAwaitingOwner"]</p>
                    }
                    else
                    {
                        <h1 class="register-result__title">@Culture["Register.ResultTitle"]</h1>
                        <p class="register-result__lead">@Culture.Format("Register.Activated", _activationResult.FullName)</p>
                        @if (_activationResult.WelcomeTokenGranted)
                        {
                            <p class="muted">@Culture["Register.WelcomeToken"]</p>
                        }
                        else if (_activationResult.FreePublishUntil is DateOnly until)
                        {
                            <p class="muted">@Culture.Format("Register.CelebrateFreePublish", until.ToString("dd-MM-yyyy"))</p>
                        }
                        <p class="muted">@Culture.Format("Register.Role", _activationResult.Role)</p>
                        <p class="muted">@Culture["Register.LoginWithChosenPassword"]</p>
                        <p class="muted">@Culture["Register.DualAuthHint"]</p>
                    }
                    <a class="login-submit"
                       href="/login"
                       style="display:inline-flex;text-align:center;text-decoration:none;margin-top:1.15rem">
                        @Culture["Register.GoLogin"]
                    </a>
                }
                else if (_expired)
                {
                    <h1 class="register-result__title">@Culture["Register.ResultTitle"]</h1>
                    <p class="register-result__lead">@Culture["Register.CodeExpired"]</p>
                    <p class="muted">@Culture["Register.RedirectingHome"]</p>
                }
                else
                {
                    <h1 class="register-result__title">
                        @(_requiresTakeover ? Culture["Register.ClaimResultTitle"] : Culture["Register.ResultTitle"])
                    </h1>
                    <p class="register-result__lead">@_message</p>
                    @if (_secondsLeft > 0)
                    {
                        <p class="muted">@Culture.Format("Register.CodeExpiresIn", FormatCountdown(_secondsLeft))</p>
                    }
                    <form class="login-form" @onsubmit="ConfirmCodeAsync" @onsubmit:preventDefault>
                        <label>
                            @Culture["Register.VerificationCode"]
                            <input type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   maxlength="6"
                                   autocomplete="one-time-code"
                                   @bind="_verificationCode"
                                   placeholder="123456"
                                   required />
                        </label>
                        <div class="wizard-actions">
                            <a class="provider-btn" href="@AuthRedirects.BanenkaartPath">@Culture["Common.Back"]</a>
                            <button class="login-submit" type="submit" disabled="@(_busy || _verificationCode.Trim().Length != 6)">
                                @Culture["Register.ConfirmCode"]
                            </button>
                        </div>
                    </form>
                    @if (!string.IsNullOrEmpty(_activationUrl))
                    {
                        <p class="muted">@Culture["Register.ActivationLinkHint"]</p>
                        <a class="login-submit login-submit--compact"
                           href="@_activationUrl"
                           style="display:inline-flex;text-decoration:none;margin-top:0.35rem">
                            @Culture["Register.OpenActivationLink"]
                        </a>
                    }
                }
            </div>
        }

        @if (_step < 5)
        {
            <p class="muted" style="margin-top:1.25rem">
                Al een account? <a class="auth-link" href="/login">@Culture["Auth.Login"]</a>
            </p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ref")] public string? RefCode { get; set; }

    private int _step = 1;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string? _activationUrl;
    private bool _requiresTakeover;
    private bool _claimMode;
    private string? _claimExpandedId;
    private Guid _registrationId;
    private DateTime? _verificationExpiresAt;
    private string _verificationCode = "";
    private int _secondsLeft;
    private bool _expired;
    private RegistrationActivationResult? _activationResult;
    private System.Threading.Timer? _countdownTimer;
    private string _kvkNumber = "12345678";
    private string _scope = "Organization";
    private string _contactName = "";
    private string _contactEmail = "";
    private string _contactPhone = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private string _salesManagerCode = "";
    private bool _acceptedTerms;
    private bool _kvkUnavailable;
    private bool _pendingKvk;
    private string _manualName = "";
    private string _manualAddress = "";
    private string _manualEstablishmentNumber = "0001";
    private List<KvkEstablishmentItem> _establishments = [];
    private KvkEstablishmentItem? _selected;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        if (!string.IsNullOrWhiteSpace(RefCode))
        {
            _salesManagerCode = RefCode.Trim().ToUpperInvariant();
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        _countdownTimer?.Dispose();
    }

    private string StepClass(int n) => _step == n ? "wizard-step is-active" : "wizard-step";

    private static string FormatCountdown(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:D2}";
    }

    private void StartCountdown(DateTime? expiresAt)
    {
        _countdownTimer?.Dispose();
        _verificationExpiresAt = expiresAt ?? DateTime.UtcNow.AddMinutes(10);
        TickCountdownSync();
        _countdownTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(TickCountdownAsync),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private void TickCountdownSync()
    {
        if (_verificationExpiresAt is null || _activationResult is not null)
        {
            return;
        }

        var left = (int)Math.Ceiling((_verificationExpiresAt.Value - DateTime.UtcNow).TotalSeconds);
        _secondsLeft = Math.Max(0, left);
    }

    private async Task TickCountdownAsync()
    {
        if (_verificationExpiresAt is null || _activationResult is not null)
        {
            return;
        }

        var left = (int)Math.Ceiling((_verificationExpiresAt.Value - DateTime.UtcNow).TotalSeconds);
        _secondsLeft = Math.Max(0, left);
        if (_secondsLeft <= 0 && !_expired)
        {
            _expired = true;
            _countdownTimer?.Dispose();
            _countdownTimer = null;
            StateHasChanged();
            await Task.Delay(1800);
            Navigation.NavigateTo(AuthRedirects.BanenkaartPath, forceLoad: true);
            return;
        }

        StateHasChanged();
    }

    private async Task LookupAsync()
    {
        _busy = true;
        _error = null;
        _kvkUnavailable = false;
        _pendingKvk = false;
        _claimMode = false;
        _claimExpandedId = null;
        try
        {
            var lookup = await Api.LookupRegistrationEstablishmentsAsync(_kvkNumber.Trim());
            if (lookup.IsUnavailable)
            {
                _kvkUnavailable = true;
                _error = lookup.Message;
                _selected = null;
                _step = 2;
                return;
            }

            _establishments = lookup.Establishments;
            if (_establishments.Count == 0)
            {
                _error = lookup.Message ?? "Geen vestigingen gevonden voor dit KVK-nummer.";
                return;
            }

            _selected = null;
            _step = 2;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ContinuePendingKvk()
    {
        if (string.IsNullOrWhiteSpace(_manualName)
            || string.IsNullOrWhiteSpace(_manualAddress)
            || string.IsNullOrWhiteSpace(_manualEstablishmentNumber))
        {
            _error = "Vul vestigingsnaam, adres en vestigingsnummer in.";
            return;
        }

        var kvk = new string(_kvkNumber.Where(char.IsDigit).ToArray());
        var est = _manualEstablishmentNumber.Trim();
        var digits = new string(est.Where(char.IsDigit).ToArray());
        if (digits.Length is > 0 and <= 4)
        {
            est = digits.PadLeft(4, '0');
        }

        _selected = new KvkEstablishmentItem
        {
            KvkNumber = kvk,
            EstablishmentNumber = est,
            KvkEstablishmentId = $"{kvk}_{est}",
            Name = _manualName.Trim(),
            Address = _manualAddress.Trim(),
            Latitude = 52.1326,
            Longitude = 5.2913,
            IsInUse = false,
            SbiCodes = null
        };
        _pendingKvk = true;
        _claimMode = false;
        _error = null;
        _step = 3;
    }

    private void SelectEstablishment(KvkEstablishmentItem e)
    {
        if (e.IsInUse)
        {
            return;
        }

        _selected = e;
        _claimMode = false;
        _claimExpandedId = null;
        _error = null;
    }

    private void ExpandClaim(string kvkEstablishmentId)
    {
        _claimExpandedId = kvkEstablishmentId;
        _error = null;
    }

    private void StartClaim(KvkEstablishmentItem e)
    {
        _selected = e;
        _claimMode = true;
        _claimExpandedId = null;
        // Default to this vestiging; non-intermediary claim form still offers Organization.
        _scope = "BranchOnly";
        _error = null;
        _step = 4;
    }

    private void BackToKvk()
    {
        _step = 1;
        _claimMode = false;
        _claimExpandedId = null;
        _selected = null;
        _error = null;
    }

    private void BackToBranch()
    {
        _step = 2;
        _claimMode = false;
        _claimExpandedId = null;
        if (_selected?.IsInUse == true)
        {
            _selected = null;
        }
    }

    private void BackFromContact()
    {
        if (_claimMode)
        {
            _step = 2;
            _claimExpandedId = _selected?.KvkEstablishmentId;
            return;
        }

        _step = 3;
    }

    private void GoToScopeOrContact()
    {
        if (_selected is null || _selected.IsInUse)
        {
            return;
        }

        if (_selected.IsIntermediarySbi)
        {
            // Server forces BranchOnly for Intermediair (single company, no employer org tree).
            _scope = "BranchOnly";
        }

        _claimMode = false;
        _step = 3;
    }

    private string ScopePreviewLabel()
    {
        if (_selected?.IsIntermediarySbi == true)
        {
            return Culture["Register.ScopeIntermediary"];
        }

        return _scope == "Organization"
            ? Culture["Register.ScopeOrg"]
            : Culture["Register.ScopeBranch"];
    }

    private async Task SubmitAsync()
    {
        if (_selected is null)
        {
            _error = "Kies eerst een vestiging.";
            return;
        }

        if (!_acceptedTerms)
        {
            _error = "Je moet akkoord gaan met de algemene voorwaarden en de privacyverklaring.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 8)
        {
            _error = Culture["Register.PasswordTooShort"];
            return;
        }

        if (!string.Equals(_password, _passwordConfirm, StringComparison.Ordinal))
        {
            _error = Culture["Register.PasswordMismatch"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var scope = _selected.IsIntermediarySbi
                ? "BranchOnly"
                : _scope;

            var result = await Api.SubmitRegistrationAsync(
                _selected.KvkNumber,
                _selected.KvkEstablishmentId,
                scope,
                _contactName.Trim(),
                _contactEmail.Trim(),
                string.IsNullOrWhiteSpace(_contactPhone) ? null : _contactPhone.Trim(),
                acceptedTerms: true,
                salesManagerTrackingCode: NormalizeSalesOrAmbassadeurCode(_salesManagerCode),
                partnerTrackingCode: NormalizePartnerCode(_salesManagerCode),
                password: _password,
                allowPendingKvkVerification: _pendingKvk,
                manualEstablishmentName: _pendingKvk ? _selected.Name : null,
                manualEstablishmentAddress: _pendingKvk ? _selected.Address : null,
                manualEstablishmentNumber: _pendingKvk ? _selected.EstablishmentNumber : null,
                manualLatitude: _pendingKvk ? _selected.Latitude : null,
                manualLongitude: _pendingKvk ? _selected.Longitude : null,
                manualIsIntermediarySbi: null);

            _message = result.Message;
            _activationUrl = result.ActivationUrl;
            _requiresTakeover = result.RequiresTakeover;
            _registrationId = result.RegistrationId;
            _password = "";
            _passwordConfirm = "";
            _verificationCode = "";
            _activationResult = null;
            _expired = false;
            _step = 5;
            StartCountdown(result.VerificationExpiresAt);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmCodeAsync()
    {
        if (_registrationId == Guid.Empty || _verificationCode.Trim().Length != 6)
        {
            _error = Culture["Register.CodeRequired"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _activationResult = await Api.ConfirmRegistrationAsync(_registrationId, _verificationCode.Trim());
            _countdownTimer?.Dispose();
            _countdownTimer = null;
            _verificationCode = "";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("verwijderd", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("verlopen", StringComparison.OrdinalIgnoreCase))
            {
                _expired = true;
                _countdownTimer?.Dispose();
                _countdownTimer = null;
                await Task.Delay(1800);
                Navigation.NavigateTo(AuthRedirects.BanenkaartPath, forceLoad: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? NormalizePartnerCode(string? value)
    {
        var code = NormalizeCode(value);
        return code is not null
               && (code.StartsWith("BM-", StringComparison.Ordinal) || code.StartsWith("IM-", StringComparison.Ordinal))
            ? code
            : null;
    }

    private static string? NormalizeSalesOrAmbassadeurCode(string? value)
    {
        var code = NormalizeCode(value);
        return code is not null
               && (code.StartsWith("SM-", StringComparison.Ordinal) || code.StartsWith("AM-", StringComparison.Ordinal))
            ? code
            : null;
    }

    private static string? NormalizeCode(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim().ToUpperInvariant();
}
