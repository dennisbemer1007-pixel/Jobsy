@page "/preview/na-de-match/{ScreenId}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [RequiresFeature(PlatformFeature.AfterMatch)]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@using Jobsy.Core.Features
@using Jobsy.Web.Applications
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@inject CultureState Culture

<PageTitle>Na de match @ScreenId · Lobsy</PageTitle>
<PageSeo Title="AfterMatch.Screen06.PageTitle" />
<HeadContent>
<link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/na-de-match.css")" />
    <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-mail-chrome.js")}")" defer></script>
    @if (_includeHerinneringenScript)
    {
        <script src="@($"/{WwwrootAssetCatalog.Url("js/ndm-herinneringen.js")}")" defer></script>
    }
</HeadContent>

@if (_bodyHtml is not null)
{
    @((MarkupString)_bodyHtml)
}
else
{
    <p class="state-message">Not found.</p>
}

@code {
    [Parameter] public string ScreenId { get; set; } = "";

    private string? _bodyHtml;
    private bool _includeHerinneringenScript;

    protected override void OnInitialized()
    {
        var id = ScreenId.Trim();
        if (id is "06" or "6")
        {
            var demo = AfterMatchBevestigingSsrData.Demo(Culture);
            _bodyHtml = AfterMatchBevestigingSsrShells.BuildBody(
                Culture,
                demo,
                AfterMatchMailSsrDemoData.ScheduledApplicationId,
                includeBackLink: false);
            return;
        }

        if (id is "07" or "7")
        {
            _includeHerinneringenScript = true;
            var demo = AfterMatchHerinneringenSsrData.Demo(Culture);
            _bodyHtml = AfterMatchHerinneringenSsrShells.BuildBody(
                Culture,
                demo,
                AfterMatchMailSsrDemoData.ScheduledApplicationId,
                includeBackLink: false,
                editableReminders: false);
            return;
        }

        _bodyHtml = null;
    }
}
