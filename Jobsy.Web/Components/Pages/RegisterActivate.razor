@page "/register/activate"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture
@implements IDisposable

<PageTitle>@Culture["Page.ActivateTitle"]</PageTitle>

<div class="login-page">
    @if (_loading)
    {
        <div class="login-card">
            <h1>@Culture["Page.ActivateTitle"]</h1>
            <p class="state-message">@Culture["Register.Activating"]</p>
        </div>
    }
    else if (_missingToken)
    {
        <div class="login-card">
            <h1>@Culture["Page.ActivateTitle"]</h1>
            <p class="login-error">@Culture["Register.NoToken"]</p>
            <a class="auth-link" href="/register">@Culture["Register.Retry"]</a>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="login-card">
            <h1>@Culture["Page.ActivateTitle"]</h1>
            <p class="login-error">@_error</p>
            <a class="auth-link" href="/register">@Culture["Register.Retry"]</a>
        </div>
    }
    else if (_result is not null && _result.EmailVerifiedAwaitingTakeover)
    {
        <div class="login-card">
            <h1>@Culture["Page.ActivateTitle"]</h1>
            <p class="state-message">@Culture["Register.TakeoverEmailVerified"]</p>
            <p class="muted">@Culture["Register.TakeoverAwaitingOwner"]</p>
            <a class="login-submit" href="/login" style="display:inline-block;text-align:center;text-decoration:none;margin-top:1rem">
                @Culture["Register.GoLogin"]
            </a>
        </div>
    }
    else if (_result is not null)
    {
        <LobsyFriendlyDialog IsOpen="true"
                             Title="@Culture["Register.CelebrateTitle"]"
                             TitleId="register-celebrate-title"
                             Mood="@LobsyDialogMood.Celebrate"
                             Class="csv-celebrate-modal register-celebrate-modal"
                             BackdropClass="register-celebrate-backdrop"
                             ShowClose="false"
                             CloseOnBackdrop="false">
<p class="csv-celebrate__score">
                    @Culture.Format("Register.CelebrateLead", _result.FullName)
                </p>
                <p class="share-modal__lead lobsy-dialog__lead">
                    @if (_result.WelcomeTokenGranted)
                    {
                        @Culture["Register.CelebrateToken"]
                    }
                    else if (_result.FreePublishUntil is DateOnly until)
                    {
                        @Culture.Format("Register.CelebrateFreePublish", until.ToString("dd-MM-yyyy"))
                    }
                    else
                    {
                        @Culture["Register.CelebrateReady"]
                    }
                </p>
@if (_result.UsedChosenPassword)
            {
                <p class="muted">@Culture["Register.LoginWithChosenPassword"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(_result.TemporaryPassword))
            {
                <p class="muted">@Culture["Register.TempPasswordDev"] <code>@_result.TemporaryPassword</code></p>
            }
            else
            {
                <p class="muted">@Culture["Register.TempPasswordEmail"]</p>
            }
<div class="inline-actions" style="justify-content:center;">
                    <a class="login-submit" href="/login" style="text-decoration:none;display:inline-flex;align-items:center;">
                        @Culture["Register.GoLogin"]
                    </a>
                </div>
</LobsyFriendlyDialog>
    }
</div>

@code {
    private bool _loading = true;
    private bool _missingToken;
    private string? _error;
    private RegistrationActivationResult? _result;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _missingToken = true;
            _loading = false;
            return;
        }

        try
        {
            _result = await Api.ActivateRegistrationAsync(Token);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
