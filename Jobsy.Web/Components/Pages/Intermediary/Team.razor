@page "/intermediary/team"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Intermediary")]
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>Team · Lobsy</PageTitle>

<div class="panel-page">
    <header class="panel-header">
        <div>
            <h1>Team</h1>
            <p class="login-lead">Nodig collega’s uit op hetzelfde intermediair-account. Vacatures en tokensaldo worden gedeeld.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        var pending = _users.Where(u => u.Role == "Intermediary" && !u.IsActive).ToList();
        var active = _users.Where(u =>
            u.Role == "Intermediary"
            && u.IsActive
            && (string.IsNullOrWhiteSpace(_search)
                || u.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))).ToList();
        <div class="users-toolbar">
            <input type="search" placeholder="Zoek op naam of e-mail" @bind="_search" @bind:event="oninput" />
        </div>
        @if (pending.Count > 0)
        {
            <section class="invite-panel" aria-label="Openstaande uitnodigingen">
                <h2 class="invite-panel__title">
                    Openstaande uitnodigingen
                    <span class="invite-count">@pending.Count</span>
                </h2>
                @foreach (var u in pending)
                {
                    <div class="table-row">
                        <div class="users-table__person">
                            <span class="user-avatar" aria-hidden="true">@Initials(u.FullName)</span>
                            <div>
                                <strong>@u.FullName</strong>
                                <span class="muted">@u.Email</span>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
        @if (active.Count == 0)
        {
            <p class="muted">Nog geen actieve teamleden. Verstuur hieronder de eerste uitnodiging.</p>
        }
        else
        {
            <table class="users-table">
                <thead>
                    <tr><th>Collega</th><th>Rol</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in active)
                    {
                        <tr>
                            <td data-label="Collega">
                                <div class="users-table__person">
                                    <span class="user-avatar" aria-hidden="true">@Initials(u.FullName)</span>
                                    <div>
                                        <strong>@u.FullName</strong>
                                        <div class="muted">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Rol"><span class="role-badge role-badge--im">Intermediair</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <section class="panel-section">
            <h2>Collega uitnodigen</h2>
            <form class="login-form" style="max-width:480px" @onsubmit="InviteAsync" @onsubmit:preventDefault>
                <label>
                    E-mail
                    <input type="email" @bind="_email" required />
                </label>
                <label>
                    Naam
                    <input @bind="_fullName" required />
                </label>
                <p class="muted">Rol: Intermediair. Teamleden krijgen alleen toegang tot dit intermediair-account.</p>
                <button class="login-submit" type="submit" disabled="@_busy">Uitnodigen</button>
            </form>
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    private List<CompanyUserItem> _users = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _email = "";
    private string _fullName = "";
    private string _search = "";

    private static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = (await Api.GetCompanyUsersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task InviteAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            await Api.InviteCompanyUserAsync(new InviteUserForm(
                _email,
                _fullName,
                "Intermediary",
                PrimaryCompanyId: null));
            _users = (await Api.GetCompanyUsersAsync()).ToList();
            _email = "";
            _fullName = "";
            _message = "Uitnodiging verstuurd. Na registratie deelt je collega vacatures en saldo.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
