@page "/intermediary/team"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Intermediary")]
@using Jobsy.Web.Components.Werkgever.Team
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

<PageTitle>Team · Lobsy</PageTitle>

<div class="panel-page users-page">
    <header class="panel-header">
        <div>
            <h1>Team</h1>
            <p class="login-lead">Nodig collega’s uit op hetzelfde intermediair-account. Vacatures en tokensaldo worden gedeeld.</p>
        </div>
        <button type="button" class="btn-compact btn-compact--primary" @onclick="() => _inviteOpen = true">
            @Culture["WgInvite.Title"]
        </button>
    </header>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        var pending = _users.Where(u => u.Role == "Intermediary" && !u.IsActive).ToList();
        var active = _users.Where(u =>
            u.Role == "Intermediary"
            && u.IsActive
            && (string.IsNullOrWhiteSpace(_search)
                || u.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))).ToList();
        <div class="users-toolbar">
            <input type="search" placeholder="Zoek op naam of e-mail" @bind="_search" @bind:event="oninput" />
        </div>
        @if (pending.Count > 0)
        {
            <section class="invite-panel" aria-label="Openstaande uitnodigingen">
                <h2 class="invite-panel__title">
                    Openstaande uitnodigingen
                    <span class="invite-count">@pending.Count</span>
                </h2>
                <div class="user-card-list">
                    @foreach (var u in pending)
                    {
                        <article class="user-card user-card--pending">
                            <div class="user-card__head">
                                <span class="user-avatar" aria-hidden="true">@Initials(u.FullName)</span>
                                <div class="user-card__identity">
                                    <strong>@u.FullName</strong>
                                    <span class="user-card__email">@u.Email</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        @if (active.Count == 0)
        {
            <p class="muted">Nog geen actieve teamleden. Verstuur de eerste uitnodiging.</p>
        }
        else
        {
            <div class="user-card-list">
                @foreach (var u in active)
                {
                    <article class="user-card">
                        <div class="user-card__head">
                            <span class="user-avatar" aria-hidden="true">@Initials(u.FullName)</span>
                            <div class="user-card__identity">
                                <strong>@u.FullName</strong>
                                <span class="user-card__email">@u.Email</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

<WgInviteDrawer Open="_inviteOpen"
                OpenChanged="v => _inviteOpen = v"
                Mode="WgInviteDrawer.InviteMode.Intermediary"
                OnInvited="OnInvited" />

@code {
    private List<CompanyUserItem> _users = [];
    private bool _loading = true;
    private string? _error;
    private string? _message;
    private string _search = "";
    private bool _inviteOpen;

    private static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = (await Api.GetCompanyUsersAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnInvited(CompanyUserItem _)
    {
        _users = (await Api.GetCompanyUsersAsync()).ToList();
        _message = Culture["WgInvite.Success"];
    }
}
