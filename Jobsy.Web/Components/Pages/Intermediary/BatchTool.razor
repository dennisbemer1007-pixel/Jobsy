@page "/intermediary/batch"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Intermediary")]
@inject JobsyApiClient Api
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules

<PageTitle>Batch-vacature tool · Lobsy</PageTitle>

<div class="panel-page">
    <h1>Batch-vacature tool</h1>
    <p class="login-lead">Zet in één handeling dezelfde vacature uit op meerdere locaties.</p>

    <form class="login-form" style="max-width:640px" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <label>
            Functietitel
            <input @bind="_title" required />
        </label>
        <label>
            Omschrijving
            <textarea rows="3" @bind="_description" required></textarea>
        </label>
        <label>
            Uurloon (€)
            <input type="number" step="0.01" @bind="_wage" />
        </label>

        <fieldset class="profile-roles">
            <legend>Branche (max @WorkTypeLabels.MaxPerVacancy)</legend>
            @foreach (var label in _branchOptions)
            {
                var selected = _selectedWorkTypes.Contains(label);
                var disabled = !selected && _selectedWorkTypes.Count >= WorkTypeLabels.MaxPerVacancy;
                <label class="@(disabled ? "is-disabled" : null)">
                    <input type="checkbox"
                           checked="@selected"
                           disabled="@disabled"
                           @onchange="e => ToggleWorkType(label, e)" />
                    @label
                </label>
            }
        </fieldset>

        <fieldset class="batch-locations">
            <legend>Locaties</legend>
            @foreach (var c in _companies)
            {
                <label class="checkbox-row">
                    <input type="checkbox" checked="@_selected.Contains(c.Id)" @onchange="e => Toggle(c.Id, e)" />
                    @c.Name
                </label>
            }
        </fieldset>

        <button class="login-submit" type="submit" disabled="@_saving">Uitzetten op @_selected.Count locaties</button>
    </form>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
</div>

@code {
    private List<CompanySummary> _companies = [];
    private HashSet<Guid> _selected = [];
    private string _title = "Vakkenvuller (batch)";
    private string _description = "Flexibele inzet via intermediair.";
    private decimal _wage = 13.50m;
    private HashSet<string> _selectedWorkTypes = new(StringComparer.OrdinalIgnoreCase) { WorkTypeLabels.Winkel };
    private List<string> _branchOptions = WorkTypeLabels.All.ToList();
    private bool _saving;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _companies = (await Api.GetMyCompaniesAsync()).ToList();
        _selected = _companies.Select(c => c.Id).ToHashSet();
        try
        {
            var options = await Api.GetMasterdataAsync(MasterdataCategories.Branch, audience: "vacancy");
            var branches = options.Select(o => o.Label).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
            if (branches.Count > 0)
            {
                _branchOptions = branches;
                if (!_selectedWorkTypes.Any(s => _branchOptions.Contains(s, StringComparer.OrdinalIgnoreCase)))
                {
                    _selectedWorkTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { _branchOptions[0] };
                }
            }
        }
        catch
        {
            // keep fallbacks
        }
    }

    private void Toggle(Guid id, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (on) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void ToggleWorkType(string label, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b || e.Value?.ToString() == "on";
        if (on)
        {
            if (_selectedWorkTypes.Count >= WorkTypeLabels.MaxPerVacancy && !_selectedWorkTypes.Contains(label))
            {
                return;
            }

            _selectedWorkTypes.Add(label);
        }
        else
        {
            _selectedWorkTypes.Remove(label);
        }
    }

    private async Task SubmitAsync()
    {
        if (_selected.Count == 0)
        {
            _message = "Selecteer minstens één locatie.";
            return;
        }

        var branchLabels = _selectedWorkTypes
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(WorkTypeLabels.MaxPerVacancy)
            .ToArray();
        if (branchLabels.Length is < 1 or > WorkTypeLabels.MaxPerVacancy)
        {
            _message = $"Kies 1 of {WorkTypeLabels.MaxPerVacancy} branches.";
            return;
        }

        _saving = true;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var created = await Api.CreateBatchAsync(new BatchVacancyForm(
                _title,
                _description,
                _wage,
                today,
                today.AddMonths(2),
                TransportMode.Bike | TransportMode.PublicTransport,
                branchLabels,
                _selected.ToArray()));
            _message = $"{created.Count} concept-vacatures aangemaakt.";
        }
        catch (VacancyModerationException ex)
        {
            _message = $"{ex.Warning} Tip: {ex.Suggestion}";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
