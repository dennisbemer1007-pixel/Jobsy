@page "/wachtwoord-vergeten"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [NoBlazorRuntime]
@layout PublicLayout
@using Jobsy.Web.Auth
@using Jobsy.Web.Features
@using Jobsy.Web.Components.Brand
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Security
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav
@inject IDataProtectionProvider DataProtection
@inject CandidatePlainPublicResolver PlainPublicResolver

@{
    var nonce = HttpContextAccessor.HttpContext is null
        ? ""
        : CspNonce.GetOrCreate(HttpContextAccessor.HttpContext);
}

<PageTitle>@(_plainShell ? Culture["PlainPublic.Forgot.Title"] : Culture["ForgotPassword.Title"]) · Lobsy</PageTitle>

<div class="@(_plainShell ? "cp-plain-wrap cp-plain-login-wrap" : null)">
<section class="@(_plainShell ? "cp-plain-login-section" : "au-stage")" data-au-forgot>
    @if (!_plainShell)
    {
        <div class="au-blob au-blob--a" aria-hidden="true"></div>
    }
    <div class="@(_plainShell ? null : "au-col")">
        <div class="@(_plainShell ? "cp-plain-card" : "au-card")">
            @if (!_plainShell)
            {
                <div class="au-card__mascot" aria-hidden="true">
                    <LobsyMascot Pose="MascotPose.Waving" Size="MascotSize.Small" Alt="" />
                </div>
            }

            @if (_sent)
            {
                @if (!_plainShell)
                {
                    <div class="au-emo" aria-hidden="true">📬</div>
                }
                <h1 class="@(_plainShell ? null : "au-title")">@(_plainShell ? Culture["PlainPublic.Forgot.SentTitle"] : Culture["ForgotPassword.SentTitle"])</h1>
                <p class="@(_plainShell ? "cp-plain-lead" : "au-lead")">@(_plainShell ? Culture["PlainPublic.Forgot.SentLead"] : Culture["ForgotPassword.SentLead"])</p>
                <form method="post" action="/account/wachtwoord-vergeten" class="au-form" data-enhance="false">
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                    <input type="hidden" name="email" value="@_email" />
                    <button type="submit" class="au-submit au-submit--secondary">@Culture["ForgotPassword.Resend"]</button>
                </form>
                <p class="au-below">
                    <a href="/login">@Culture["ForgotPassword.Back"]</a>
                </p>
            }
            else
            {
                <h1 class="@(_plainShell ? null : "au-title")">@(_plainShell ? Culture["PlainPublic.Forgot.Title"] : Culture["ForgotPassword.Title"])</h1>
                <p class="@(_plainShell ? "cp-plain-lead" : "au-lead")">@(_plainShell ? Culture["PlainPublic.Forgot.Lead"] : Culture["ForgotPassword.Lead"])</p>
                <form method="post" action="/account/wachtwoord-vergeten" class="au-form" data-enhance="false" novalidate>
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                    <div class="au-field">
                        <label class="au-field__label" for="forgot-email">@Culture["Login.Email"]</label>
                        <div class="au-input-wrap">
                            <input id="forgot-email"
                                   class="au-input"
                                   type="text"
                                   name="email"
                                   value="@_email"
                                   required
                                   autocomplete="username"
                                   inputmode="email"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   dir="ltr"
                                   autofocus />
                        </div>
                    </div>
                    <button type="submit" class="au-submit">@Culture["ForgotPassword.Submit"]</button>
                </form>
                <p class="au-below">
                    <a href="/login">@Culture["ForgotPassword.Back"]</a>
                </p>
            }
        </div>
    </div>
</section>
</div>

@code {
    private bool _plainShell;
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";
    private string _email = "";
    private bool _sent;

    protected override async Task OnInitializedAsync()
    {
        _plainShell = await PlainPublicResolver.IsPlainShellAsync();
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            return;
        }

        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? "";

        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _sent = query.TryGetValue("sent", out var sent)
                && string.Equals(sent.ToString(), "1", StringComparison.OrdinalIgnoreCase);

        if (LoginHintCookie.TryReadAndClear(http, DataProtection) is { Length: > 0 } hint)
        {
            _email = hint;
        }

        if (query.TryGetValue("email", out var emailQ) && !string.IsNullOrWhiteSpace(emailQ))
        {
            _email = emailQ.ToString();
        }
    }
}
