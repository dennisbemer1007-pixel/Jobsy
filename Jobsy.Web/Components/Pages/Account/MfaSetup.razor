@page "/account/mfa/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Net
@using System.Net.Http.Json
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav

<PageTitle>@Culture["Mfa.SetupTitle"] · Lobsy</PageTitle>

<div class="login-modal login-modal--compact account-mfa" role="dialog" aria-modal="true" aria-labelledby="mfa-setup-title">
    <div class="login-modal__dialog login-card">
        <div class="login-modal__header">
            <h1 id="mfa-setup-title">@Culture["Mfa.SetupTitle"]</h1>
        </div>

        <p class="account-mfa__step">@string.Format(Culture["Mfa.StepOf"], 1, 2)</p>
        <p class="login-lead">@Culture["Mfa.SetupLead"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error" role="alert">@_error</p>
            @if (_expired)
            {
                <p><a class="account-mfa__link" href="/login">@Culture["Mfa.BackToLogin"]</a></p>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_qrSvgDataUri))
        {
            <p class="account-mfa__label">@Culture["Mfa.ScanQr"]</p>
            <img class="account-mfa__qr" src="@_qrSvgDataUri" alt="@Culture["Mfa.QrAlt"]" width="180" height="180" />

            <details class="account-mfa__details">
                <summary>@Culture["Mfa.ManualKeySummary"]</summary>
                <div class="account-mfa__manual">
                    <code class="account-mfa__secret" id="mfa-manual-key">@_secretGrouped</code>
                    <button type="button"
                            class="icon-btn"
                            aria-label="@Culture["Mfa.CopyKey"]"
                            title="@Culture["Mfa.CopyKey"]"
                            onclick="navigator.clipboard.writeText(document.getElementById('mfa-manual-key').textContent.replace(/\s+/g,''))">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                    </button>
                </div>
            </details>

            <p class="muted account-mfa__hint">@Culture["Mfa.Instructions"]</p>

            <form method="post" action="/account/mfa/verify" class="login-form" data-enhance="false">
                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                <label>
                    @Culture["Mfa.CodeLabel"]
                    <input type="text"
                           name="code"
                           class="w-full px-4 py-3"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           required
                           placeholder="000000" />
                </label>
                <button type="submit" class="login-submit">@Culture["Mfa.Confirm"]</button>
            </form>
        }
    </div>
</div>

@code {
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private string? _qrSvgDataUri;
    private string? _secretGrouped;
    private string? _error;
    private bool _expired;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null
            || !http.Request.Cookies.TryGetValue("Jobsy.MfaChallenge", out var challenge)
            || string.IsNullOrWhiteSpace(challenge))
        {
            _error = Culture["Mfa.ErrorExpired"];
            _expired = true;
            return;
        }

        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? string.Empty;

        try
        {
            var apiBase = Jobsy.Core.JobsyPublicUrl.NormalizeBaseUrl(
                Configuration["ApiBaseUrl"],
                "http://localhost:5200/");
            using var client = new HttpClient { BaseAddress = new Uri(apiBase), Timeout = TimeSpan.FromSeconds(8) };

            using var stateResponse = await client.PostAsJsonAsync(
                "api/auth/mfa/state",
                new { challengeToken = challenge });
            if (stateResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _error = Culture["Mfa.ErrorExpired"];
                _expired = true;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _error = Culture["Mfa.ErrorTooMany"];
                return;
            }

            if (stateResponse.IsSuccessStatusCode)
            {
                var state = await stateResponse.Content.ReadFromJsonAsync<MfaStateDto>();
                if (state?.Enrolled == true)
                {
                    var returnUrl = http.Request.Query["returnUrl"].ToString();
                    var dest = string.IsNullOrWhiteSpace(returnUrl)
                        ? "/account/mfa"
                        : "/account/mfa?returnUrl=" + Uri.EscapeDataString(returnUrl);
                    Nav.NavigateTo(dest, forceLoad: true);
                    return;
                }
            }

            using var enrollResponse = await client.PostAsJsonAsync(
                "api/auth/mfa/enroll",
                new { challengeToken = challenge });
            if (enrollResponse.StatusCode == HttpStatusCode.Conflict)
            {
                Nav.NavigateTo("/account/mfa", forceLoad: true);
                return;
            }

            if (enrollResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _error = Culture["Mfa.ErrorExpired"];
                _expired = true;
                return;
            }

            if (enrollResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _error = Culture["Mfa.ErrorTooMany"];
                return;
            }

            if (!enrollResponse.IsSuccessStatusCode)
            {
                _error = Culture["Mfa.ErrorGeneric"];
                return;
            }

            var result = await enrollResponse.Content.ReadFromJsonAsync<MfaEnrollmentDto>();
            _qrSvgDataUri = result?.QrSvgDataUri;
            _secretGrouped = GroupSecret(result?.Secret);
            if (string.IsNullOrWhiteSpace(_qrSvgDataUri) || string.IsNullOrWhiteSpace(_secretGrouped))
            {
                _error = Culture["Mfa.ErrorGeneric"];
            }
        }
        catch
        {
            _error = Culture["Mfa.ErrorGeneric"];
        }
    }

    private static string? GroupSecret(string? secret)
    {
        if (string.IsNullOrWhiteSpace(secret))
        {
            return null;
        }

        var clean = secret.Replace(" ", "", StringComparison.Ordinal).ToUpperInvariant();
        return string.Join(' ', Enumerable.Range(0, (clean.Length + 3) / 4)
            .Select(i => clean.Substring(i * 4, Math.Min(4, clean.Length - i * 4))));
    }

    private sealed class MfaStateDto
    {
        public bool Enrolled { get; set; }
        public string? Email { get; set; }
    }

    private sealed class MfaEnrollmentDto
    {
        public string? Secret { get; set; }
        public string? ProvisioningUri { get; set; }
        public string? QrSvgDataUri { get; set; }
    }
}
