@page "/account/mfa/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net
@using System.Net.Http.Json
@using Jobsy.Core.Security
@using Jobsy.Core.Time
@using Jobsy.Web.Auth
@using Jobsy.Web.Components.Auth
@using Jobsy.Web.Components.Registration
@using Jobsy.Web.Localization
@using Jobsy.Web.Security
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthApiClient AuthApi
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav

<PageTitle>@Culture["Mfa.SetupTitle"] · Lobsy</PageTitle>

@{
    var nonce = HttpContextAccessor.HttpContext is null
        ? string.Empty
        : CspNonce.GetOrCreate(HttpContextAccessor.HttpContext);
}

@if (_wizardVariant)
{
    <div class="au-wizard-wrap">
        <WaWizardChrome CurrentStep="3" Speech="@Culture["Mfa.SetupLead"]" DoneOnCurrent="false" />
    </div>
}

<section class="au-stage" data-au-mfa-setup>
    <div class="au-blob au-blob--a" aria-hidden="true"></div>
    <div class="au-col">
        <div class="au-card">
            <p class="au-eyebrow">@(_wizardVariant ? string.Format(Culture["Mfa.StepOf"], 3, 4) : string.Format(Culture["Mfa.StepOf"], 1, 2))</p>
            @if (!string.IsNullOrEmpty(_maskedEmail))
            {
                <p class="au-who">
                    <span>@_maskedEmail</span>
                    <form method="post" action="/account/mfa/cancel" data-enhance="false" class="au-inline-form">
                        <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                        <button type="submit" class="au-link-btn">@Culture["Mfa.OtherAccount"]</button>
                    </form>
                </p>
            }

            <h1 class="au-title">@Culture["Mfa.SetupTitle"]</h1>
            <p class="au-lead">@Culture["Mfa.SetupLead"]</p>

            <LoginStatusBlock State="_loginState" UntilLocalHhMm="@_untilLocal" />

            @if (!string.IsNullOrWhiteSpace(_qrSvgDataUri) && !string.IsNullOrWhiteSpace(_provisioningUri))
            {
                <ol class="au-setup-steps">
                    <li>
                        <span class="au-setup-steps__n" aria-hidden="true">1</span>
                        <div>
                            <strong>@Culture["Mfa.InstallApp"]</strong>
                            <p class="au-help">
                                <a href="https://www.microsoft.com/store/apps/9NBLGGH203KP" rel="noopener noreferrer" target="_blank">Microsoft Authenticator</a>
                                ·
                                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" rel="noopener noreferrer" target="_blank">Google Authenticator</a>
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="au-setup-steps__n" aria-hidden="true">2</span>
                        <div>
                            <strong>@Culture["Mfa.LinkApp"]</strong>
                            <div class="au-mobile-only">
                                <p>
                                    <a class="au-submit" href="@_provisioningUri">@Culture["Mfa.OpenAuthenticator"]</a>
                                </p>
                                <details class="au-details">
                                    <summary>@Culture["Mfa.ShowQrDetails"]</summary>
                                    <img class="au-qr" src="@_qrSvgDataUri" alt="@Culture["Mfa.QrAlt"]" width="180" height="180" />
                                    <div class="au-manual">
                                        <code class="au-secret" id="mfa-manual-key" dir="ltr">@_secretGrouped</code>
                                        <button type="button"
                                                class="au-link-btn"
                                                data-copy-target="#mfa-manual-key"
                                                data-copied-label="@Culture["Mfa.KeyCopied"]">@Culture["Mfa.CopyKey"]</button>
                                        <span data-copy-status role="status" aria-live="polite" class="visually-hidden"></span>
                                    </div>
                                </details>
                            </div>
                            <div class="au-desktop-only">
                                <img class="au-qr" src="@_qrSvgDataUri" alt="@Culture["Mfa.QrAlt"]" width="180" height="180" />
                                <div class="au-manual">
                                    <code class="au-secret" id="mfa-manual-key-desktop" dir="ltr">@_secretGrouped</code>
                                    <button type="button"
                                            class="au-link-btn"
                                            data-copy-target="#mfa-manual-key-desktop"
                                            data-copied-label="@Culture["Mfa.KeyCopied"]">@Culture["Mfa.CopyKey"]</button>
                                    <span data-copy-status role="status" aria-live="polite" class="visually-hidden"></span>
                                </div>
                                <p class="au-help">
                                    <a href="@_provisioningUri">@Culture["Mfa.OnPhoneLink"]</a>
                                </p>
                            </div>
                        </div>
                    </li>
                    <li>
                        <span class="au-setup-steps__n" aria-hidden="true">3</span>
                        <div>
                            <strong>@Culture["Mfa.EnterCodeStep"]</strong>
                            <form method="post" action="/account/mfa/verify" class="au-form" data-enhance="false" novalidate>
                                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                                <input type="hidden" name="source" value="setup" />
                                <input type="hidden" name="method" value="totp" />
                                <div class="au-field">
                                    <label class="au-field__label" for="mfa-code">@Culture["Mfa.CodeLabel"]</label>
                                    <div class="au-input-wrap">
                                        <input id="mfa-code"
                                               class="au-input"
                                               type="text"
                                               name="code"
                                               inputmode="numeric"
                                               autocomplete="one-time-code"
                                               pattern="[0-9 ]{6,7}"
                                               maxlength="7"
                                               dir="ltr"
                                               autofocus
                                               required />
                                    </div>
                                </div>
                                <button type="submit" class="au-submit">@Culture["Mfa.Confirm"]</button>
                            </form>
                        </div>
                    </li>
                </ol>
            }
            else if (_expired)
            {
                <p><a class="au-submit" href="/login">@Culture["Mfa.BackToLogin"]</a></p>
            }
        </div>
    </div>
</section>

<script src="js/features/account-mfa.js?v=20260930-auth04" nonce="@nonce" defer></script>

@code {
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private string? _qrSvgDataUri;
    private string? _provisioningUri;
    private string? _secretGrouped;
    private string? _maskedEmail;
    private LoginState _loginState = LoginState.None;
    private string? _untilLocal;
    private bool _expired;
    private bool _wizardVariant;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null
            || !http.Request.Cookies.TryGetValue("Jobsy.MfaChallenge", out var challenge)
            || string.IsNullOrWhiteSpace(challenge))
        {
            _loginState = LoginState.Generic;
            _expired = true;
            return;
        }

        var returnUrl = http.Request.Query["returnUrl"].ToString();
        if (string.IsNullOrWhiteSpace(returnUrl)
            && http.Request.Cookies.TryGetValue("Jobsy.MfaReturnUrl", out var cookieReturn))
        {
            returnUrl = cookieReturn;
        }

        _wizardVariant = returnUrl.StartsWith("/register/", StringComparison.OrdinalIgnoreCase);

        ApplyErrorQuery();

        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? string.Empty;

        try
        {
            using var stateResponse = await AuthApi.PostJsonAsync(
                "api/auth/mfa/state",
                new { challengeToken = challenge });
            if (stateResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _loginState = LoginState.Generic;
                _expired = true;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _loginState = LoginState.TooMany;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                _loginState = LoginState.Locked;
                return;
            }

            if (stateResponse.IsSuccessStatusCode)
            {
                var state = await stateResponse.Content.ReadFromJsonAsync<MfaStateDto>();
                _maskedEmail = string.IsNullOrWhiteSpace(state?.MaskedEmail)
                    ? EmailMask.Mask(state?.Email)
                    : state!.MaskedEmail;
                if (state?.Enrolled == true)
                {
                    var dest = string.IsNullOrWhiteSpace(returnUrl)
                        ? "/account/mfa"
                        : "/account/mfa?returnUrl=" + Uri.EscapeDataString(returnUrl);
                    http.Response.Redirect(dest);
                    return;
                }
            }

            using var enrollResponse = await AuthApi.PostJsonAsync(
                "api/auth/mfa/enroll",
                new { challengeToken = challenge });
            if (enrollResponse.StatusCode == HttpStatusCode.Conflict)
            {
                http.Response.Redirect("/account/mfa");
                return;
            }

            if (enrollResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _loginState = LoginState.Generic;
                _expired = true;
                return;
            }

            if (enrollResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _loginState = LoginState.TooMany;
                return;
            }

            if (enrollResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                _loginState = LoginState.Locked;
                return;
            }

            if (!enrollResponse.IsSuccessStatusCode)
            {
                _loginState = LoginState.Unavailable;
                _expired = true;
                return;
            }

            var result = await enrollResponse.Content.ReadFromJsonAsync<MfaEnrollmentDto>();
            _qrSvgDataUri = result?.QrSvgDataUri;
            _provisioningUri = result?.ProvisioningUri;
            _secretGrouped = GroupSecret(result?.Secret);
            if (string.IsNullOrWhiteSpace(_qrSvgDataUri)
                || string.IsNullOrWhiteSpace(_provisioningUri)
                || string.IsNullOrWhiteSpace(_secretGrouped))
            {
                _loginState = LoginState.Unavailable;
                _expired = true;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _loginState = LoginState.Unavailable;
            _expired = true;
        }
    }

    private void ApplyErrorQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        var code = error.ToString();
        if (query.TryGetValue("until", out var until)
            && long.TryParse(until.ToString(), out var unix))
        {
            var utc = DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
            if (utc > DateTime.UtcNow)
            {
                _untilLocal = AmsterdamTime.ToLocal(utc).ToString("HH:mm");
            }
        }

        _loginState = code switch
        {
            "invalid" => LoginState.Invalid,
            "locked" => LoginState.Locked,
            "too-many" => LoginState.TooMany,
            "expired" => LoginState.Generic,
            _ => LoginState.Generic
        };
        _expired = code is "expired";
    }

    private static string? GroupSecret(string? secret)
    {
        if (string.IsNullOrWhiteSpace(secret))
        {
            return null;
        }

        var clean = secret.Replace(" ", "", StringComparison.Ordinal).ToUpperInvariant();
        return string.Join(' ', Enumerable.Range(0, (clean.Length + 3) / 4)
            .Select(i => clean.Substring(i * 4, Math.Min(4, clean.Length - i * 4))));
    }

    private sealed class MfaStateDto
    {
        public bool Enrolled { get; set; }
        public string? Email { get; set; }
        public string? MaskedEmail { get; set; }
    }

    private sealed class MfaEnrollmentDto
    {
        public string? Secret { get; set; }
        public string? ProvisioningUri { get; set; }
        public string? QrSvgDataUri { get; set; }
    }
}
