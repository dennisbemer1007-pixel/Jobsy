@page "/account/wachtwoord-instellen"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@using Jobsy.Web.Localization
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject CultureState Culture
@inject NavigationManager Navigation

<PageTitle>@Culture["SetPassword.Title"] · Lobsy</PageTitle>

<section class="pub-section" aria-labelledby="setpwd-title">
    <div class="pub-card">
        @if (!_valid)
        {
            <h1 id="setpwd-title">@Culture["SetPassword.Title"]</h1>
            <p>@Culture["SetPassword.Invalid"]</p>
            <p><a class="auth-link" href="/login">@Culture["SetPassword.Login"]</a></p>
        }
        else
        {
            <h1 id="setpwd-title">@Culture["SetPassword.Heading"]</h1>
            @if (!string.IsNullOrWhiteSpace(_maskedEmail))
            {
                <p class="muted">@_maskedEmail</p>
            }
            <p class="muted">@Culture["SetPassword.Hint"]</p>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="login-error" role="alert">@_error</p>
            }
            <form method="post" action="/account/wachtwoord-instellen" class="login-form" data-enhance="false">
                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                <input type="hidden" name="t" value="@_token" />
                <label>
                    @Culture["SetPassword.Password"]
                    <input type="password" name="password" class="w-full px-4 py-3" required minlength="12" maxlength="128" autocomplete="new-password" />
                </label>
                <label>
                    @Culture["SetPassword.Repeat"]
                    <input type="password" name="password2" class="w-full px-4 py-3" required minlength="12" maxlength="128" autocomplete="new-password" />
                </label>
                <button type="submit" class="login-submit" disabled="@(string.IsNullOrEmpty(_antiforgeryToken))">
                    @Culture["SetPassword.Submit"]
                </button>
            </form>
            <p class="pub-signup__footer">
                <a class="auth-link" href="/login">@Culture["SetPassword.OrExternal"]</a>
            </p>
        }
    </div>
</section>

@code {
    private string _token = "";
    private bool _valid;
    private string? _maskedEmail;
    private string? _error;
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContext ?? HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? "";
            _error = http.Request.Query["error"].FirstOrDefault() switch
            {
                "mismatch" => Culture["SetPassword.Mismatch"],
                "rules" => Culture["SetPassword.Hint"],
                "invalid" => Culture["SetPassword.Invalid"],
                _ => null
            };
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _token = query.TryGetValue("t", out var t) ? t.FirstOrDefault() ?? "" : "";
        if (string.IsNullOrWhiteSpace(_token))
        {
            _valid = false;
            return;
        }

        var apiBase = (Configuration["JobsyApi:BaseUrl"] ?? "http://localhost:5200").TrimEnd('/');
        var client = HttpClientFactory.CreateClient();
        try
        {
            var preview = await client.GetFromJsonAsync<PreviewDto>(
                $"{apiBase}/api/account/setup-link?token={Uri.EscapeDataString(_token)}");
            _valid = preview?.Valid == true;
            _maskedEmail = preview?.MaskedEmail;
        }
        catch
        {
            _valid = false;
        }
    }

    private sealed class PreviewDto
    {
        [JsonPropertyName("valid")]
        public bool Valid { get; set; }

        [JsonPropertyName("maskedEmail")]
        public string? MaskedEmail { get; set; }
    }
}
