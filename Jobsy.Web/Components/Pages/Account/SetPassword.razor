@page "/account/wachtwoord-instellen"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Jobsy.Core.Rules
@using Jobsy.Web.Auth
@using Jobsy.Web.Components.Auth
@using Jobsy.Web.Localization
@using Jobsy.Web.Security
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject CultureState Culture
@inject NavigationManager Navigation
@inject AuthApiClient AuthApi

@{
    var nonce = HttpContextAccessor.HttpContext is null
        ? ""
        : CspNonce.GetOrCreate(HttpContextAccessor.HttpContext);
}

<PageTitle>@(_isReset ? Culture["SetPassword.ResetHeading"] : Culture["SetPassword.Title"]) · Lobsy</PageTitle>

<section class="au-stage" data-au-setpwd>
    <div class="au-blob au-blob--a" aria-hidden="true"></div>
    <div class="au-col">
        <div class="au-card">
            @if (!_valid)
            {
                <h1 class="au-title">@(_isReset ? Culture["SetPassword.ResetHeading"] : Culture["SetPassword.Title"])</h1>
                <LoginStatusBlock State="LoginState.Generic" />
                <p class="au-lead">@(_isReset ? Culture["SetPassword.ResetInvalid"] : Culture["SetPassword.Invalid"])</p>
                @if (_isReset)
                {
                    <p><a class="au-submit" href="/wachtwoord-vergeten">@Culture["SetPassword.RequestNew"]</a></p>
                }
                else
                {
                    <p><a class="au-submit" href="/login">@Culture["SetPassword.Login"]</a></p>
                }
            }
            else
            {
                <h1 class="au-title">@(_isReset ? Culture["SetPassword.ResetHeading"] : Culture["SetPassword.Heading"])</h1>
                @if (!string.IsNullOrWhiteSpace(_maskedEmail))
                {
                    <p class="au-who"><span>@_maskedEmail</span></p>
                }
                <p class="au-lead">@Culture["SetPassword.Hint"]</p>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="au-alert au-alert--danger" role="alert">
                        <p class="au-alert__text">@_error</p>
                    </div>
                }
                <form method="post" action="/account/wachtwoord-instellen" class="au-form" data-enhance="false" novalidate>
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                    <input type="hidden" name="@(_isReset ? "token" : "t")" value="@_token" />
                    @if (_isReset)
                    {
                        <input type="hidden" name="doel" value="reset" />
                    }
                    <div class="au-field">
                        <label class="au-field__label" for="setpwd-password">@Culture["SetPassword.Password"]</label>
                        <div class="au-input-wrap">
                            <input id="setpwd-password"
                                   class="au-input"
                                   type="password"
                                   name="password"
                                   required
                                   minlength="@RegistrationPasswordRules.MinLength"
                                   maxlength="@RegistrationPasswordRules.MaxLength"
                                   autocomplete="new-password"
                                   dir="ltr"
                                   data-au-password-rules />
                            <button type="button"
                                    class="au-input-wrap__toggle"
                                    data-au-password-toggle
                                    aria-controls="setpwd-password"
                                    aria-pressed="false"
                                    data-label-show="@Culture["Login.ShowPassword"]"
                                    data-label-hide="@Culture["Login.HidePassword"]"
                                    hidden>@Culture["Login.ShowPassword"]</button>
                        </div>
                    </div>
                    <div class="au-field">
                        <label class="au-field__label" for="setpwd-password2">@Culture["SetPassword.Repeat"]</label>
                        <div class="au-input-wrap">
                            <input id="setpwd-password2"
                                   class="au-input"
                                   type="password"
                                   name="password2"
                                   required
                                   minlength="@RegistrationPasswordRules.MinLength"
                                   maxlength="@RegistrationPasswordRules.MaxLength"
                                   autocomplete="new-password"
                                   dir="ltr" />
                        </div>
                    </div>
                    <ul class="au-rules" data-au-password-rules-list aria-live="polite">
                        <li data-rule="min">@string.Format(Culture["SetPassword.RuleMin"], RegistrationPasswordRules.MinLength)</li>
                    </ul>
                    <button type="submit" class="au-submit" disabled="@(string.IsNullOrEmpty(_antiforgeryToken))">
                        @Culture["SetPassword.Submit"]
                    </button>
                </form>
                @if (!_isReset)
                {
                    <p class="au-below">
                        <a href="/login">@Culture["SetPassword.OrExternal"]</a>
                    </p>
                }
            }
        </div>
    </div>
</section>

<script src="js/features/auth.js?v=20260930-auth05" nonce="@nonce" defer></script>

@code {
    private string _token = "";
    private bool _valid;
    private bool _isReset;
    private string? _maskedEmail;
    private string? _error;
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _isReset = query.TryGetValue("doel", out var doel)
                   && string.Equals(doel.ToString(), "reset", StringComparison.OrdinalIgnoreCase);
        if (query.TryGetValue("token", out var tokenQ) && !string.IsNullOrWhiteSpace(tokenQ))
        {
            _token = tokenQ.ToString();
            _isReset = true;
        }
        else if (query.TryGetValue("t", out var t) && !string.IsNullOrWhiteSpace(t))
        {
            _token = t.ToString();
        }

        if (http is not null)
        {
            http.Response.Headers["Referrer-Policy"] = "no-referrer";
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? "";
            _error = http.Request.Query["error"].FirstOrDefault() switch
            {
                "mismatch" => Culture["SetPassword.Mismatch"],
                "rules" => Culture["SetPassword.Hint"],
                "invalid" => _isReset ? Culture["SetPassword.ResetInvalid"] : Culture["SetPassword.Invalid"],
                _ => null
            };
        }

        if (string.IsNullOrWhiteSpace(_token))
        {
            _valid = false;
            return;
        }

        try
        {
            if (_isReset)
            {
                using var response = await AuthApi.CreateClient()
                    .GetAsync($"api/auth/password-reset/peek?token={Uri.EscapeDataString(_token)}");
                if (!response.IsSuccessStatusCode)
                {
                    _valid = false;
                    return;
                }

                var preview = await response.Content.ReadFromJsonAsync<PreviewDto>();
                _valid = preview?.Valid == true;
                _maskedEmail = preview?.MaskedEmail;
            }
            else
            {
                var apiBase = (Configuration["JobsyApi:BaseUrl"] ?? Configuration["ApiBaseUrl"] ?? "http://localhost:5200").TrimEnd('/');
                var client = HttpClientFactory.CreateClient();
                var preview = await client.GetFromJsonAsync<PreviewDto>(
                    $"{apiBase}/api/account/setup-link?token={Uri.EscapeDataString(_token)}");
                _valid = preview?.Valid == true;
                _maskedEmail = preview?.MaskedEmail;
            }
        }
        catch
        {
            _valid = false;
        }
    }

    private sealed class PreviewDto
    {
        [JsonPropertyName("valid")]
        public bool Valid { get; set; }

        [JsonPropertyName("maskedEmail")]
        public string? MaskedEmail { get; set; }
    }
}
