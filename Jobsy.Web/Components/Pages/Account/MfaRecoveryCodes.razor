@page "/account/mfa/recovery-codes"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Text
@using System.Text.Json
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject IDataProtectionProvider DataProtection
@inject CultureState Culture
@inject NavigationManager Nav

<PageTitle>@Culture["Mfa.RecoveryTitle"] · Lobsy</PageTitle>

<div class="login-modal login-modal--compact account-mfa" role="dialog" aria-modal="true" aria-labelledby="mfa-recovery-title">
    <div class="login-modal__dialog login-card">
        <div class="login-modal__header">
            <h1 id="mfa-recovery-title">@Culture["Mfa.RecoveryTitle"]</h1>
        </div>

        <p class="account-mfa__step">@string.Format(Culture["Mfa.StepOf"], 2, 2)</p>
        <p class="login-lead">@Culture["Mfa.RecoveryLead"]</p>

        @if (_codes.Count == 0)
        {
            <p class="state-message" role="status">@Culture["Mfa.CodesAlreadyShown"]</p>
            <p>
                <a class="login-submit account-mfa__continue-link" href="@_returnUrl">@Culture["Mfa.Continue"]</a>
            </p>
        }
        else
        {
            <ul class="account-mfa__codes" id="mfa-recovery-list">
                @foreach (var recoveryCode in _codes)
                {
                    <li><code>@recoveryCode</code></li>
                }
            </ul>

            <div class="account-mfa__code-actions">
                <button type="button" class="btn-compact" id="mfa-download-codes">@Culture["Mfa.DownloadTxt"]</button>
                <button type="button" class="btn-compact" id="mfa-copy-codes">@Culture["Mfa.CopyCodes"]</button>
            </div>

            <form method="get" action="@_returnUrl" class="login-form account-mfa__confirm-form" data-enhance="false" id="mfa-recovery-continue">
                <label class="login-remember">
                    <input type="checkbox" id="mfa-codes-saved" required />
                    <span>@Culture["Mfa.SavedCheckbox"]</span>
                </label>
                <button type="submit" class="login-submit" id="mfa-continue-btn" disabled>@Culture["Mfa.Continue"]</button>
            </form>

            <script>
                (function () {
                    var codes = @((MarkupString)JsonSerializer.Serialize(_codes));
                    var text = codes.join('\n');
                    var saved = document.getElementById('mfa-codes-saved');
                    var btn = document.getElementById('mfa-continue-btn');
                    if (saved && btn) {
                        saved.addEventListener('change', function () { btn.disabled = !saved.checked; });
                    }
                    var copyBtn = document.getElementById('mfa-copy-codes');
                    if (copyBtn) {
                        copyBtn.addEventListener('click', function () {
                            navigator.clipboard.writeText(text);
                        });
                    }
                    var dl = document.getElementById('mfa-download-codes');
                    if (dl) {
                        dl.addEventListener('click', function () {
                            var blob = new Blob([text], { type: 'text/plain' });
                            var url = URL.createObjectURL(blob);
                            var a = document.createElement('a');
                            a.href = url;
                            a.download = 'lobsy-herstelcodes.txt';
                            a.click();
                            URL.revokeObjectURL(url);
                        });
                    }
                })();
            </script>
        }
    </div>
</div>

@code {
    private readonly List<string> _codes = [];
    private string _returnUrl = "/home";

    protected override void OnInitialized()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var raw)
            && !string.IsNullOrWhiteSpace(raw))
        {
            _returnUrl = Jobsy.Web.Auth.AuthRedirects.SafeLocalUrl(raw.ToString());
        }
        else if (http.Request.Cookies.TryGetValue("Jobsy.MfaReturnUrl", out var cookieReturn)
                 && !string.IsNullOrWhiteSpace(cookieReturn))
        {
            _returnUrl = Jobsy.Web.Auth.AuthRedirects.SafeLocalUrl(cookieReturn);
        }

        if (http.Request.Cookies.TryGetValue(MfaRecoveryCodesCookie.Name, out var protectedPayload)
            && !string.IsNullOrWhiteSpace(protectedPayload))
        {
            try
            {
                var protector = DataProtection.CreateProtector(MfaRecoveryCodesCookie.ProtectorPurpose);
                var json = protector.Unprotect(protectedPayload);
                var codes = JsonSerializer.Deserialize<List<string>>(json) ?? [];
                _codes.AddRange(codes.Where(c => !string.IsNullOrWhiteSpace(c)).Take(10));
            }
            catch
            {
                // Treat as already shown / invalid.
            }
        }

        // One-time: delete so a reload does not show codes again.
        http.Response.Cookies.Delete(MfaRecoveryCodesCookie.Name, new CookieOptions
        {
            Path = "/",
            Secure = true,
            SameSite = SameSiteMode.Lax,
            HttpOnly = true
        });
        http.Response.Cookies.Delete(MfaRecoveryCodesCookie.Name, new CookieOptions { Path = "/" });
        http.Response.Cookies.Delete("Jobsy.MfaReturnUrl", new CookieOptions { Path = "/", Secure = true });
        http.Response.Cookies.Delete("Jobsy.MfaReturnUrl", new CookieOptions { Path = "/" });
    }
}
