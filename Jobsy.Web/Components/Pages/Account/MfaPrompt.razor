@page "/account/mfa"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Net
@using System.Net.Http.Json
@using Jobsy.Core.Time
@using Jobsy.Web.Auth
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthApiClient AuthApi
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>@Culture["Mfa.PromptTitle"] · Lobsy</PageTitle>

<div class="login-modal login-modal--compact account-mfa" role="dialog" aria-modal="true" aria-labelledby="mfa-prompt-title">
    <div class="login-modal__dialog login-card">
        <div class="login-modal__header">
            <h1 id="mfa-prompt-title">@Culture["Mfa.PromptTitle"]</h1>
        </div>

        <p class="login-lead">@Culture["Mfa.PromptLead"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error" role="alert">@_error</p>
            @if (_expired)
            {
                <p><a class="account-mfa__link" href="/login">@Culture["Mfa.BackToLogin"]</a></p>
            }
        }

        @if (_ready)
        {
            <form method="post" action="/account/mfa/verify" class="login-form" data-enhance="false">
                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                <input type="hidden" name="source" value="prompt" />
                <label>
                    @Culture["Mfa.CodeLabel"]
                    <input type="text"
                           name="code"
                           class="w-full px-4 py-3"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           placeholder="000000" />
                </label>

                <details class="account-mfa__details">
                    <summary>@Culture["Mfa.RecoverySummary"]</summary>
                    <label>
                        @Culture["Mfa.RecoveryLabel"]
                        <input type="text"
                               name="recoveryCode"
                               class="w-full px-4 py-3"
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false" />
                    </label>
                </details>

                <button type="submit" class="login-submit">@Culture["Mfa.Login"]</button>
            </form>

            <p class="muted account-mfa__help">
                <a class="account-mfa__link" href="@_supportMailto">@Culture["Mfa.AdminHelp"]</a>
            </p>
        }
    </div>
</div>

@code {
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private string? _error;
    private bool _expired;
    private bool _ready;
    private string _supportMailto = "mailto:support@lobsy.nl";

    protected override async Task OnInitializedAsync()
    {
        var support = Configuration["Support:Email"] ?? Configuration["Mail:SupportAddress"] ?? "support@lobsy.nl";
        _supportMailto = "mailto:" + support;

        var http = HttpContextAccessor.HttpContext;
        if (http is null
            || !http.Request.Cookies.TryGetValue("Jobsy.MfaChallenge", out var challenge)
            || string.IsNullOrWhiteSpace(challenge))
        {
            _error = Culture["Mfa.ErrorExpired"];
            _expired = true;
            return;
        }

        ApplyErrorQuery(http);

        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? string.Empty;

        try
        {
            using var stateResponse = await AuthApi.PostJsonAsync(
                "api/auth/mfa/state",
                new { challengeToken = challenge });

            if (stateResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                _error = FormatLocked(http);
                return;
            }

            if (stateResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _error = Culture["Mfa.ErrorExpired"];
                _expired = true;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _error = Culture["Mfa.ErrorTooMany"];
                return;
            }

            if (!stateResponse.IsSuccessStatusCode)
            {
                _error = Culture["Mfa.ErrorGeneric"];
                _expired = true;
                return;
            }

            var state = await stateResponse.Content.ReadFromJsonAsync<MfaStateDto>();
            if (state?.Enrolled != true)
            {
                var returnUrl = http.Request.Query["returnUrl"].ToString();
                var error = http.Request.Query["error"].ToString();
                var until = http.Request.Query["until"].ToString();
                var dest = "/account/mfa/setup";
                var qs = new List<string>();
                if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    qs.Add("returnUrl=" + Uri.EscapeDataString(returnUrl));
                }

                if (!string.IsNullOrWhiteSpace(error))
                {
                    qs.Add("error=" + Uri.EscapeDataString(error));
                }

                if (!string.IsNullOrWhiteSpace(until))
                {
                    qs.Add("until=" + Uri.EscapeDataString(until));
                }

                if (qs.Count > 0)
                {
                    dest += "?" + string.Join("&", qs);
                }

                http.Response.Redirect(dest);
                return;
            }

            _ready = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = Culture["Mfa.ErrorGeneric"];
            _expired = true;
        }
    }

    private void ApplyErrorQuery(HttpContext http)
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        var code = error.ToString();
        query.TryGetValue("until", out var untilRaw);
        _error = code switch
        {
            "invalid" => Culture["Mfa.ErrorInvalid"],
            "expired" => Culture["Mfa.ErrorExpired"],
            "locked" => FormatUntil(Culture["Mfa.ErrorLocked"], untilRaw.ToString()),
            "too-many" => FormatUntil(Culture["Mfa.ErrorTooManyUntil"], untilRaw.ToString()),
            _ => Culture["Mfa.ErrorGeneric"]
        };
        _expired = code is "expired";
    }

    private string FormatLocked(HttpContext http)
    {
        var until = http.Request.Query["until"].ToString();
        return FormatUntil(Culture["Mfa.ErrorLocked"], until);
    }

    private string FormatUntil(string template, string? untilUnix)
    {
        if (long.TryParse(untilUnix, out var unix))
        {
            var utc = DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
            if (utc > DateTime.UtcNow)
            {
                var local = AmsterdamTime.ToLocal(utc);
                return string.Format(template, local.ToString("HH:mm"));
            }
        }

        return Culture["Mfa.ErrorLockedFallback"];
    }

    private sealed class MfaStateDto
    {
        public bool Enrolled { get; set; }
        public string? Email { get; set; }
    }
}
