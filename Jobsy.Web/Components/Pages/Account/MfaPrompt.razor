@page "/account/mfa"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Net
@using System.Net.Http.Json
@using Jobsy.Core.Security
@using Jobsy.Core.Time
@using Jobsy.Web.Auth
@using Jobsy.Web.Components.Auth
@using Jobsy.Web.Localization
@using Jobsy.Web.Security
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthApiClient AuthApi
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav
@inject IConfiguration Configuration

@{
    var nonce = HttpContextAccessor.HttpContext is null
        ? ""
        : CspNonce.GetOrCreate(HttpContextAccessor.HttpContext);
}

<PageTitle>@Culture["Mfa.PromptTitle"] · Lobsy</PageTitle>

<section class="au-stage" data-au-mfa>
    <div class="au-blob au-blob--a" aria-hidden="true"></div>
    <div class="au-col">
        <div class="au-card">
            @if (!_signedIn)
            {
                <p class="au-eyebrow">@Culture["Mfa.StepOfContext"]</p>
                @if (!string.IsNullOrEmpty(_maskedEmail))
                {
                    <p class="au-who">
                        <span dir="ltr">@_maskedEmail</span>
                        <form method="post" action="/account/mfa/cancel" data-enhance="false" class="au-inline-form">
                            <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                            <button type="submit" class="au-link-btn">@Culture["Mfa.OtherAccount"]</button>
                        </form>
                    </p>
                }

                <h1 class="au-title">@Culture["Mfa.PromptTitle"]</h1>
                <p class="au-lead">@Culture["Mfa.PromptLead"]</p>
            }

            <LoginStatusBlock State="_loginState" UntilLocalHhMm="_untilLocal" />

            @if (_ready)
            {
                <form method="post" action="/account/mfa/verify" class="au-form" data-enhance="false" novalidate>
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                    <input type="hidden" name="source" value="prompt" />
                    <input type="hidden" name="method" value="totp" />
                    <div class="au-field">
                        <label class="au-field__label" for="mfa-code">@Culture["Mfa.CodeLabel"]</label>
                        <div class="au-input-wrap">
                            <input id="mfa-code"
                                   class="au-input"
                                   type="text"
                                   name="code"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   pattern="[0-9 ]{6,7}"
                                   maxlength="7"
                                   dir="ltr"
                                   autofocus />
                        </div>
                    </div>
                    <label class="au-remember">
                        <input type="checkbox" name="trustDevice" value="true" />
                        <span>
                            @Culture["Mfa.TrustDevice"]
                            <span class="au-remember__hint">@Culture["Mfa.TrustDeviceHint"]</span>
                        </span>
                    </label>
                    <button type="submit" class="au-submit">@Culture["Mfa.Login"]</button>
                </form>

                <details class="au-details" open="@_openRecovery">
                    <summary>@Culture["Mfa.RecoverySummary"]</summary>
                    <form method="post" action="/account/mfa/verify" class="au-form" data-enhance="false" novalidate>
                        <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                        <input type="hidden" name="source" value="prompt" />
                        <input type="hidden" name="method" value="recovery" />
                        <div class="au-field">
                            <label class="au-field__label" for="mfa-recovery">@Culture["Mfa.RecoveryLabel"]</label>
                            <p class="au-help" id="mfa-recovery-hint">@Culture["Mfa.RecoveryHint"]</p>
                            <div class="au-input-wrap">
                                <input id="mfa-recovery"
                                       class="au-input"
                                       type="text"
                                       name="recoveryCode"
                                       autocomplete="off"
                                       autocapitalize="characters"
                                       spellcheck="false"
                                       aria-describedby="mfa-recovery-hint"
                                       dir="ltr" />
                            </div>
                        </div>
                        <button type="submit" class="au-submit au-submit--secondary">@Culture["Mfa.LoginRecovery"]</button>
                    </form>
                </details>

                <p class="au-below">
                    <a href="@_supportMailto">@Culture["Mfa.AdminHelp"]</a>
                </p>
            }
            else if (_signedIn)
            {
                <p class="au-lead">@Culture["Mfa.AlreadySignedIn"]</p>
                <p><a class="au-submit" href="/home">@Culture["Mfa.Continue"]</a></p>
            }
            else if (_expired)
            {
                <p><a class="au-submit" href="/login">@Culture["Mfa.BackToLogin"]</a></p>
            }
        </div>
    </div>
</section>

@code {
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private LoginState _loginState = LoginState.None;
    private string? _untilLocal;
    private string? _maskedEmail;
    private bool _ready;
    private bool _expired;
    private bool _signedIn;
    private bool _openRecovery;
    private string _supportMailto = "mailto:support@lobsy.nl";

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null
            || !http.Request.Cookies.TryGetValue("Jobsy.MfaChallenge", out var challenge)
            || string.IsNullOrWhiteSpace(challenge))
        {
            if (http?.User.Identity?.IsAuthenticated == true)
            {
                _signedIn = true;
                return;
            }

            _loginState = LoginState.Generic;
            _expired = true;
            return;
        }

        ApplyErrorQuery();
        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? string.Empty;

        var support = Configuration["Support:Email"]
            ?? Configuration["Mail:SupportAddress"]
            ?? "support@lobsy.nl";
        _supportMailto = "mailto:" + support;

        try
        {
            using var stateResponse = await AuthApi.PostJsonAsync(
                "api/auth/mfa/state",
                new { challengeToken = challenge });
            if (stateResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _expired = true;
                _loginState = LoginState.Generic;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                _loginState = LoginState.Locked;
                return;
            }

            stateResponse.EnsureSuccessStatusCode();
            var state = await stateResponse.Content.ReadFromJsonAsync<MfaStateDto>();
            _maskedEmail = string.IsNullOrWhiteSpace(state?.MaskedEmail)
                ? EmailMask.Mask(state?.Email)
                : state!.MaskedEmail;
            if (state?.Enrolled != true)
            {
                var httpCtx = HttpContextAccessor.HttpContext;
                if (httpCtx is not null)
                {
                    httpCtx.Response.Redirect("/account/mfa/setup");
                }

                return;
            }

            _ready = true;
        }
        catch
        {
            _expired = true;
            _loginState = LoginState.Unavailable;
        }
    }

    private void ApplyErrorQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        var code = error.ToString();
        _openRecovery = string.Equals(code, "invalid", StringComparison.OrdinalIgnoreCase)
            && query.TryGetValue("from", out var from)
            && string.Equals(from.ToString(), "recovery", StringComparison.OrdinalIgnoreCase);

        if (query.TryGetValue("until", out var until)
            && long.TryParse(until.ToString(), out var unix))
        {
            var utc = DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime;
            if (utc > DateTime.UtcNow)
            {
                _untilLocal = AmsterdamTime.ToLocal(utc).ToString("HH:mm");
            }
        }

        _loginState = code switch
        {
            "invalid" => LoginState.Invalid,
            "locked" => LoginState.Locked,
            "too-many" => LoginState.TooMany,
            "expired" => LoginState.Generic,
            _ => LoginState.Generic
        };
        if (code is "expired")
        {
            _expired = true;
        }
    }

    private sealed class MfaStateDto
    {
        public bool Enrolled { get; set; }
        public string? Email { get; set; }
        public string? MaskedEmail { get; set; }
    }
}
