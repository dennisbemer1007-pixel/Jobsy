@page "/account/mfa"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Net
@using System.Net.Http.Json
@using Jobsy.Web.Localization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject IAntiforgery Antiforgery
@inject CultureState Culture
@inject NavigationManager Nav

<PageTitle>@Culture["Mfa.PromptTitle"] · Lobsy</PageTitle>

<div class="login-modal login-modal--compact account-mfa" role="dialog" aria-modal="true" aria-labelledby="mfa-prompt-title">
    <div class="login-modal__dialog login-card">
        <div class="login-modal__header">
            <h1 id="mfa-prompt-title">@Culture["Mfa.PromptTitle"]</h1>
        </div>

        <p class="login-lead">@Culture["Mfa.PromptLead"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error" role="alert">@_error</p>
            @if (_expired)
            {
                <p><a class="account-mfa__link" href="/login">@Culture["Mfa.BackToLogin"]</a></p>
            }
        }

        @if (_ready)
        {
            <form method="post" action="/account/mfa/verify" class="login-form" data-enhance="false">
                <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                <label>
                    @Culture["Mfa.CodeLabel"]
                    <input type="text"
                           name="code"
                           class="w-full px-4 py-3"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           placeholder="000000" />
                </label>

                <details class="account-mfa__details">
                    <summary>@Culture["Mfa.RecoverySummary"]</summary>
                    <label>
                        @Culture["Mfa.RecoveryLabel"]
                        <input type="text"
                               name="recoveryCode"
                               class="w-full px-4 py-3"
                               autocomplete="one-time-code"
                               autocapitalize="characters"
                               spellcheck="false" />
                    </label>
                </details>

                <button type="submit" class="login-submit">@Culture["Mfa.Login"]</button>
            </form>

            <p class="muted account-mfa__help">
                <a class="account-mfa__link" href="/login">@Culture["Mfa.AdminHelp"]</a>
            </p>
        }
    </div>
</div>

@code {
    private string _antiforgeryFieldName = string.Empty;
    private string _antiforgeryToken = string.Empty;
    private string? _error;
    private bool _expired;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http is null
            || !http.Request.Cookies.TryGetValue("Jobsy.MfaChallenge", out var challenge)
            || string.IsNullOrWhiteSpace(challenge))
        {
            _error = Culture["Mfa.ErrorExpired"];
            _expired = true;
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var error)
            && string.Equals(error.ToString(), "invalid", StringComparison.OrdinalIgnoreCase))
        {
            _error = Culture["Mfa.ErrorInvalid"];
        }

        var tokens = Antiforgery.GetAndStoreTokens(http);
        _antiforgeryFieldName = tokens.FormFieldName;
        _antiforgeryToken = tokens.RequestToken ?? string.Empty;

        try
        {
            var apiBase = Jobsy.Core.JobsyPublicUrl.NormalizeBaseUrl(
                Configuration["ApiBaseUrl"],
                "http://localhost:5200/");
            using var client = new HttpClient { BaseAddress = new Uri(apiBase), Timeout = TimeSpan.FromSeconds(8) };
            using var stateResponse = await client.PostAsJsonAsync(
                "api/auth/mfa/state",
                new { challengeToken = challenge });

            if (stateResponse.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.BadRequest)
            {
                _error = Culture["Mfa.ErrorExpired"];
                _expired = true;
                return;
            }

            if (stateResponse.StatusCode == HttpStatusCode.TooManyRequests)
            {
                _error = Culture["Mfa.ErrorTooMany"];
                return;
            }

            if (!stateResponse.IsSuccessStatusCode)
            {
                _error = Culture["Mfa.ErrorGeneric"];
                _expired = true;
                return;
            }

            var state = await stateResponse.Content.ReadFromJsonAsync<MfaStateDto>();
            if (state?.Enrolled != true)
            {
                var returnUrl = http.Request.Query["returnUrl"].ToString();
                var dest = string.IsNullOrWhiteSpace(returnUrl)
                    ? "/account/mfa/setup"
                    : "/account/mfa/setup?returnUrl=" + Uri.EscapeDataString(returnUrl);
                // Static SSR: use Response.Redirect. NavigationManager redirects throw and a
                // bare catch turned that into ErrorGeneric (empty page on Acc).
                http.Response.Redirect(dest);
                return;
            }

            _ready = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = Culture["Mfa.ErrorGeneric"];
            _expired = true;
        }
    }

    private sealed class MfaStateDto
    {
        public bool Enrolled { get; set; }
        public string? Email { get; set; }
    }
}
