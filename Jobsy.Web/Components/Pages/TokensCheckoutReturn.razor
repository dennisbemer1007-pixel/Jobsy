@page "/tokens/checkout-return"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "BranchManager,EnterpriseManager,Intermediary,Admin")]
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject TokenBalanceCache TokenBalances

<PageTitle>Betaling · Lobsy</PageTitle>

<div class="panel-page">
    <h1>Betaling afronden</h1>
    <p class="login-lead">
        We controleren bij Mollie of je iDEAL- of creditcardbetaling is gelukt.
        Tokens worden bijgeschreven (vaak al via de realtime webhook) en eventuele openstaande actie
        (publiceren, highlight, PushBom, verlengen) wordt uitgevoerd.
    </p>

    @if (_loading)
    {
        <p class="state-message" aria-live="polite">
            @(_attempt <= 1
                ? "Betaling controleren…"
                : "Tokens worden bijgeschreven… even geduld terwijl we de betaling afronden.")
        </p>
        @if (_attempt > 1)
        {
            <p class="muted">Poging @_attempt van @_maxAttempts</p>
        }
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message error">@_message</p>
        <div class="inline-actions" style="margin-top:1.5rem">
            <button class="login-submit" type="button" disabled="@_busy" @onclick="() => CompleteAsync(resetAttempts: true)">
                @(_busy ? "Bezig…" : "Opnieuw proberen")
            </button>
            <a class="auth-link" href="/employer/tokens">Terug naar tokens</a>
        </div>
    }
</div>

@code {
    private const int _maxAttempts = 30;
    private static readonly TimeSpan PollDelay = TimeSpan.FromSeconds(2);

    private bool _loading = true;
    private bool _busy;
    private string? _paymentId;
    private Guid? _checkoutId;
    private string? _message;
    private int _attempt;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("paymentId", out var pid) && !string.IsNullOrWhiteSpace(pid))
        {
            _paymentId = pid.ToString();
        }

        if (query.TryGetValue("checkoutId", out var cid)
            && Guid.TryParse(cid.ToString(), out var checkoutId))
        {
            _checkoutId = checkoutId;
        }

        await CompleteAsync(resetAttempts: true);
    }

    private async Task CompleteAsync(bool resetAttempts = false)
    {
        _busy = true;
        _message = null;
        _loading = true;
        if (resetAttempts)
        {
            _attempt = 0;
        }

        try
        {
            if (_checkoutId is null && string.IsNullOrWhiteSpace(_paymentId))
            {
                _message = "Geen checkout-gegevens in de return-URL.";
                return;
            }

            while (_attempt < _maxAttempts)
            {
                _attempt++;
                StateHasChanged();

                CompleteCheckoutResult? result = null;
                try
                {
                    if (_checkoutId is Guid checkoutId)
                    {
                        result = await Api.CompleteTokenCheckoutBySessionAsync(checkoutId);
                    }
                    else
                    {
                        result = await Api.CompleteTokenCheckoutAsync(_paymentId!);
                    }
                }
                catch (Exception ex) when (IsPendingPayment(ex))
                {
                    // Payment / webhook may still be settling — keep polling.
                    result = null;
                }

                if (result is not null)
                {
                    TokenBalances.Invalidate();

                    if (result.PendingAction is { Succeeded: true })
                    {
                        Navigation.NavigateTo($"/employer/vacancies?paidAction={Uri.EscapeDataString(result.PendingAction.Action)}");
                        return;
                    }

                    if (result.PendingAction is { Succeeded: false })
                    {
                        Navigation.NavigateTo(
                            $"/employer/vacancies?paidActionError={Uri.EscapeDataString(result.PendingAction.Message ?? "Actie mislukt")}");
                        return;
                    }

                    Navigation.NavigateTo("/employer/tokens");
                    return;
                }

                if (_attempt < _maxAttempts)
                {
                    await Task.Delay(PollDelay);
                }
            }

            _message =
                "De betaling is nog niet bevestigd of wordt nog verwerkt. " +
                "Probeer het zo opnieuw — tokens verschijnen automatisch zodra Mollie bevestigt.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    private static bool IsPendingPayment(Exception ex)
    {
        if (ex is HttpRequestException)
        {
            return true;
        }

        var message = ex.Message ?? string.Empty;
        return message.Contains("nog niet afgerond", StringComparison.OrdinalIgnoreCase)
               || message.Contains("not paid", StringComparison.OrdinalIgnoreCase)
               || message.Contains("429", StringComparison.OrdinalIgnoreCase);
    }
}
