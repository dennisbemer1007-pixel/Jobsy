@namespace Jobsy.Web.Components.Leerling
@using Jobsy.Core.Enums
@using Jobsy.Core.Scholen.PupilPassport
@using Jobsy.Core.Scholen.QuestionSets
@inject CultureState Culture
@inject IPupilQuestionSetRegistry Registry

@if (Model is { Enabled: true } && Model.Sections.Count > 0)
{
    <section class="ouder-antwoorden" aria-labelledby="ouder-antwoorden-title" data-testid="ouder-test-antwoorden">
        <h2 id="ouder-antwoorden-title">@Culture["Ouder.Answers.Title"]</h2>
        <p class="muted ouder-antwoorden__lead">@Culture["Ouder.Answers.Lead"]</p>

        @foreach (var section in Model.Sections)
        {
            <article class="ouder-antwoorden__section ll-card">
                <header class="ouder-antwoorden__section-head">
                    <h3>@Culture[section.TitleKey]</h3>
                    <p class="muted">@Culture[section.SubtitleKey]</p>
                </header>
                <ol class="ouder-antwoorden__list">
                    @foreach (var item in section.Items)
                    {
                        var selected = SelectedValue(item.AnswerLabelKey);
                        <li class="ouder-antwoorden__item">
                            <p class="ouder-antwoorden__question">@Culture[item.QuestionTextKey]</p>
                            <LeerlingAnswerScale Labels="_def.AnswerLabels"
                                                 Set="_def.Set"
                                                 Selected="selected"
                                                 GroupLabel="@Culture["Ouder.Answers.Chosen"]"
                                                 Disabled="true" />
                        </li>
                    }
                </ol>
            </article>
        }
    </section>
}

@code {
    [Parameter] public ParentPassportAnswersWebDto? Model { get; set; }

    private PupilQuestionSetDef _def = null!;

    protected override void OnParametersSet()
    {
        _def = Registry.Get(PupilQuestionSet.Groep78);
    }

    private int? SelectedValue(string answerLabelKey)
    {
        foreach (var (value, key) in _def.AnswerLabels)
        {
            if (string.Equals(key, answerLabelKey, StringComparison.Ordinal))
            {
                return value;
            }
        }

        return null;
    }
}
