@namespace Jobsy.Web.Components.Leerling
@inject CultureState Culture

<ReadAloudButton Text="@Text"
                 SpeechKey="@SpeechKey"
                 PlayAria="@Culture["ReadAloud.Play"]"
                 AlwaysShow="@AlwaysShow" />

@code {
    [Parameter] public string Text { get; set; } = "";

    [Parameter] public string SpeechKey { get; set; } = "";

    [Parameter] public bool AlwaysShow { get; set; }
}
