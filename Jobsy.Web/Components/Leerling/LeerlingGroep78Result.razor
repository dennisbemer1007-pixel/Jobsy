@namespace Jobsy.Web.Components.Leerling
@using Jobsy.Core.Contracts.Scholen
@using Jobsy.Core.Scholen
@using Jobsy.Core.Scholen.QuestionSets
@using Jobsy.Web.Hosting
@using Jobsy.Web.Scholen
@inject CultureState Culture

@{
    var nodes = PupilGroep78JourneyStripNodes.ForTheme(JourneyThemeKey);
    var curNode = PupilGroep78ResultPage.ResultNodeIndex(JourneyThemeKey);
    var doneWidth = PupilGroep78JourneyStripNodes.DoneLineWidth(JourneyThemeKey, curNode);
    var bandTestId = PupilGroep78ResultPage.BandTestId(JourneyThemeKey);
    var bandExtra = PupilGroep78ResultPage.BandExtraClass(JourneyThemeKey);
    var journeyMeta = Culture.Format(
        "LeerlingStory.ResultJourneyMeta",
        Result.TotalItems);
    var coachText = Culture["Leerling.Coach.Story"];
    var coachSpoken = SpokenText.Join("Lobsy", coachText);
    var jobsSpoken = SpokenText.Join(Result.Story.JobIdeas.ToArray());
}

<HeadContent>
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-kies.css")" data-page-result-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-vraag.css")" data-page-result-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-route.css")" data-page-result-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-result.css")" data-page-result-css="true" />
</HeadContent>

<section class="band rs dark @bandExtra" data-testid="@bandTestId">
    <div class="wrap">
        <div class="vr-journey rs-journey" aria-label="@Culture["Leerling.Vraag.JourneyAria"]">
            <div class="vr-jrow">
                <span class="vr-jdone" style="width:@doneWidth"></span>
                @for (var i = 0; i < nodes.Count; i++)
                {
                    var node = nodes[i];
                    var done = i < curNode;
                    var current = i == curNode;
                    var cls = "vr-jn"
                              + (node.IsPuzzle ? " is-puzzle" : "")
                              + (node.IsResult ? " is-result" : "")
                              + (done ? " is-done" : "")
                              + (current ? " is-cur" : "");
                    <div class="@cls">
                        @if (current)
                        {
                            <span class="vr-here">@Culture["Leerling.Route.Here"]</span>
                        }
                        @if (node.IsPuzzle)
                        {
                            <span class="dot" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 3a2 2 0 014 0v2h4a1 1 0 011 1v4h-2a2 2 0 000 4h2v4a1 1 0 01-1 1h-4v-2a2 2 0 00-4 0v2H6a1 1 0 01-1-1v-4h2a2 2 0 000-4H5V6a1 1 0 011-1h4V3z"/></svg>
                            </span>
                        }
                        else if (node.IsResult && string.IsNullOrEmpty(node.ImageUrl))
                        {
                            <span class="dot" aria-hidden="true"></span>
                        }
                        else if (node.IsResult)
                        {
                            <span class="dot" style="background-image:url(@(node.ImageUrl))" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="dot" style="background-image:url(@(node.ImageUrl))" aria-hidden="true"></span>
                        }
                        <b>@Culture[node.TitleKey]</b>
                    </div>
                }
            </div>
            <div class="vr-jmeta rs-jmeta">
                <span><b>@Culture["LeerlingStory.DonePill"]</b> · @journeyMeta</span>
            </div>
        </div>
    </div>
</section>

<div class="wrap rs-hdr">
    <div class="rs-title">
        <span class="pill-done">@Culture["LeerlingStory.DonePill"]</span>
        <h1 class="rs-h serif">@Culture["LeerlingStory.Title"]</h1>
    </div>
</div>

<div class="wrap rs-overlap" data-testid="leerling-dit-ben-jij">
    <div class="rs-layout">
        <div>
            <div class="card rs-story-card">
                <div class="vr-qrow">
                    <LeerlingSpeak Text="@Result.Story.Body" SpeechKey="ll-story" AlwaysShow="true" />
                    <span class="speak-label">@Culture["LeerlingStory.ReadStory"]</span>
                </div>
                <p class="rs-story-body">@Result.Story.Body</p>
            </div>

            <div class="rs-tiles">
                @foreach (var tile in Result.Story.Tiles)
                {
                    var img = PupilGroep78ResultPage.TileImageUrl(JourneyThemeKey, PupilGroep78ResultPage.TileIndex(tile.ModelKey));
                    var spoken = SpokenText.Join(tile.KidLabel, tile.Explanation);
                    <div class="rs-tile">
                        <div class="rs-tile-img" style="background-image:url(@img)"></div>
                        <div class="rs-tile-body">
                            <p class="kicker">@tile.KidLabel</p>
                            <p class="rs-tile-txt">@tile.Explanation</p>
                            <LeerlingSpeak Text="@spoken" SpeechKey="@($"ll-tile-{tile.ModelKey}")" AlwaysShow="true" />
                        </div>
                    </div>
                }
            </div>

            <div class="card rs-likes-card">
                @if (Result.Likes.Count > 0)
                {
                    <h2 class="rs-sub">@Culture["LeerlingStory.LikesTitle"]</h2>
                    <div class="rs-chips">
                        @foreach (var chip in Result.Likes)
                        {
                            <span class="rs-chip is-on">@chip</span>
                        }
                    </div>
                }

                <h2 class="rs-sub">@Culture["LeerlingStory.JobsTitle"]</h2>
                <div class="vr-qrow" style="margin:10px 0 14px">
                    <LeerlingSpeak Text="@jobsSpoken" SpeechKey="ll-jobs" AlwaysShow="true" />
                    <span class="speak-label">@Culture["LeerlingStory.ReadJobs"]</span>
                </div>
                <div class="rs-chips">
                    @foreach (var job in Result.Story.JobIdeas)
                    {
                        <span class="rs-chip">@job</span>
                    }
                </div>

                <p class="same rs-note" role="note">@Culture[PupilCopy.Key(Result.QuestionSet, "LeerlingStory.Privacy")]</p>
            </div>

            <div class="rs-foot">
                @if (ShowPassport)
                {
                    <a class="btn btn-ghost" href="/leerling/paspoort">@Culture["LeerlingStory.PassportButton"]</a>
                }
                <a class="btn btn-ghost" href="/leerling/pdf">@Culture["LeerlingStory.Pdf"]</a>
                <a class="btn btn-main" href="/leerling/droombaan">
                    @Culture["LeerlingStory.CheckDream"]
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
            </div>
        </div>

        <aside class="d-only rs-coach-aside">
            <div class="bubble tail-b">
                <span class="who">Lobsy</span>
                @coachText
                <div class="bt">
                    <LeerlingSpeak Text="@coachSpoken" SpeechKey="ll-result-coach" AlwaysShow="true" />
                    <span class="speak-label">@Culture["Leerling.Wereld.ReadAloud"]</span>
                </div>
            </div>
            <img class="rs-lob"
                 src="/leerling/werelden/img/kreeft-kijker.png"
                 width="250"
                 height="250"
                 alt=""
                 decoding="async"
                 loading="lazy" />
        </aside>

        <div class="m-only rs-mobile-coach">
            <div class="guide">
                <div class="ring" role="img" aria-label="Lobsy"></div>
                <div class="bubble tail-l">
                    <span class="who">Lobsy</span>
                    @coachText
                    <div class="bt">
                        <LeerlingSpeak Text="@coachSpoken" SpeechKey="ll-result-coach-m" AlwaysShow="true" />
                        <span class="speak-label">@Culture["Leerling.Wereld.ReadAloud"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PupilResultPageDto Result { get; set; } = default!;

    [Parameter, EditorRequired] public string JourneyThemeKey { get; set; } = PupilJourneyTheme.ZeeExpeditie;

    [Parameter] public bool ShowPassport { get; set; }
}
