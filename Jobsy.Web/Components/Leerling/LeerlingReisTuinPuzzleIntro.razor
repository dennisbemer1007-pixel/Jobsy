@namespace Jobsy.Web.Components.Leerling
@using Jobsy.Web.Hosting
@using Jobsy.Web.Scholen
@inject CultureState Culture

@{
    var curNode = PupilTuinJourneyBar.IntroNodeIndex(PuzzleKey);
    var puzzleTitle = Culture[PuzzleTitleKey];
    var afterQ = Culture.Format("Leerling.PuzzelIntro.AfterQuestion", AfterQuestion);
    var introSpoken = SpokenText.Join(
        Culture[PuzzlePartKey],
        puzzleTitle,
        Culture[PuzzleLeadKey],
        Culture["Leerling.PuzzelIntro.Step1"],
        Culture["Leerling.PuzzelIntro.Step2"],
        Culture["Leerling.PuzzelIntro.Step3"]);
    var coachSpoken = SpokenText.Join("Lobsy", Culture["Leerling.PuzzelIntro.Coach"]);
}

<HeadContent>
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-kies.css")" data-page-puzzel-intro-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-vraag.css")" data-page-puzzel-intro-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-route.css")" data-page-puzzel-intro-css="true" />
    <link rel="stylesheet" href="@WwwrootAssetCatalog.Url("css/features/leerling-werelden-puzzel-intro.css")" data-page-puzzel-intro-css="true" />
    <link rel="preload" as="image" href="/leerling/werelden/img/tuin-koraal.jpg" />
    @foreach (var shell in PreviewShells)
    {
        <link rel="preload" as="image" href="@shell" />
    }
</HeadContent>

<section class="band pi pi-tuin" data-testid="ll-tuin-puzzel-intro-band">
    <div class="pi-journey vr-journey" aria-label="@Culture["Leerling.Vraag.JourneyAria"]">
        <div class="vr-jrow">
            <span class="vr-jdone" style="width:@PupilTuinJourneyBar.DoneLineWidth(curNode)"></span>
            @for (var i = 0; i < PupilTuinJourneyBar.Nodes.Count; i++)
            {
                var node = PupilTuinJourneyBar.Nodes[i];
                var done = i < curNode;
                var current = i == curNode;
                var cls = "vr-jn"
                          + (node.IsPuzzle ? " is-puzzle" : "")
                          + (node.IsResult ? " is-result" : "")
                          + (done ? " is-done" : "")
                          + (current ? " is-cur" : "");
                <div class="@cls">
                    @if (current)
                    {
                        <span class="vr-here">@Culture["Leerling.Route.Here"]</span>
                    }
                    @if (node.IsPuzzle)
                    {
                        <span class="dot" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 3a2 2 0 014 0v2h4a1 1 0 011 1v4h-2a2 2 0 000 4h2v4a1 1 0 01-1 1h-4v-2a2 2 0 00-4 0v2H6a1 1 0 01-1-1v-4h2a2 2 0 000-4H5V6a1 1 0 011-1h4V3z"/></svg>
                        </span>
                    }
                    else if (node.IsResult)
                    {
                        <span class="dot" style="background-image:url(@(node.ImageUrl))" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="dot" style="background-image:url(@(node.ImageUrl))" aria-hidden="true"></span>
                    }
                    <b>@Culture[node.TitleKey]</b>
                </div>
            }
        </div>
        <div class="pi-jmeta vr-jmeta">
            <span><b>@Culture[PuzzlePartKey]</b> · @puzzleTitle · @afterQ</span>
        </div>
    </div>
</section>

<div class="wrap pi-overlap">
    <div class="pi-layout">
        <div class="card pi-card" role="group" aria-labelledby="ll-tuin-puzzel-intro-title">
            <p class="kicker">@Culture[PuzzlePartKey]</p>
            <h1 id="ll-tuin-puzzel-intro-title" class="pi-title serif">@puzzleTitle</h1>
            <p class="pi-lead">@Culture[PuzzleLeadKey]</p>

            <div class="pi-prev-row" aria-hidden="true">
                @foreach (var shell in PreviewShells)
                {
                    <div class="pi-slot">
                        <img src="@shell" width="50" height="58" alt="" decoding="async" />
                    </div>
                }
                <div class="pi-slot pi-slot--q" aria-hidden="true">?</div>
            </div>

            <ol class="pi-steps">
                <li><span>1</span>@Culture["Leerling.PuzzelIntro.Step1"]</li>
                <li><span>2</span>@Culture["Leerling.PuzzelIntro.Step2"]</li>
                <li><span>3</span>@Culture["Leerling.PuzzelIntro.Step3"]</li>
            </ol>

            <div class="pi-facts" aria-hidden="true">
                <span>@Culture["Leerling.PuzzelIntro.NoClock"]</span>
                <span>@Culture["Leerling.PuzzelIntro.NoPressure"]</span>
            </div>

            <div class="pi-foot">
                <div class="pi-foot__read">
                    <LeerlingSpeak Text="@introSpoken"
                                   SpeechKey="@($"ll-puzzel-intro-{PuzzleKey}")"
                                   AlwaysShow="true" />
                    <span class="speak-label">@Culture["Leerling.PuzzelIntro.ReadIntro"]</span>
                </div>
                <a class="btn btn-main btn-big pi-start"
                   href="@StartHref"
                   data-testid="ll-puzzel-intro-start">
                    @Culture["Leerling.PuzzelIntro.Start"]
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        </div>

        <aside class="d-only pi-coach-aside">
            <div class="bubble tail-b">
                <span class="who">Lobsy</span>
                @Culture["Leerling.PuzzelIntro.Coach"]
                <div class="bt">
                    <LeerlingSpeak Text="@coachSpoken" SpeechKey="ll-puzzel-intro-coach" AlwaysShow="true" />
                    <span class="speak-label">@Culture["Leerling.Wereld.ReadAloud"]</span>
                </div>
            </div>
            <img class="pi-lob"
                 src="/leerling/werelden/img/kreeft-kaart.png"
                 width="250"
                 height="250"
                 alt=""
                 decoding="async"
                 loading="lazy" />
        </aside>

        <div class="m-only" style="margin-top:18px">
            <div class="guide">
                <div class="ring" role="img" aria-label="Lobsy"></div>
                <div class="bubble tail-l">
                    <span class="who">Lobsy</span>
                    @Culture["Leerling.PuzzelIntro.Coach"]
                    <div class="bt">
                        <LeerlingSpeak Text="@coachSpoken" SpeechKey="ll-puzzel-intro-coach-m" AlwaysShow="true" />
                        <span class="speak-label">@Culture["Leerling.Wereld.ReadAloud"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string PuzzleKey { get; set; } = "schelpenrij";
    [Parameter] public string StartHref { get; set; } = "/leerling/puzzel/schelpenrij";
    [Parameter] public int AfterQuestion { get; set; } = 15;

    private string PuzzleTitleKey => PuzzleKey.ToLowerInvariant() switch
    {
        "schelpenrij" => "Leerling.Puzzle.Schelpenrij.Title",
        _ => "Leerling.Puzzle.Title",
    };

    private string PuzzleLeadKey => PuzzleKey.ToLowerInvariant() switch
    {
        "schelpenrij" => "Leerling.PuzzelIntro.Schelpenrij.Lead.Tuin",
        _ => "Leerling.Puzzle.Lead",
    };

    private string PuzzlePartKey => PuzzleKey.ToLowerInvariant() switch
    {
        "schelpenrij" => "Leerling.PuzzelIntro.Part1",
        "schatkaart" => "Leerling.PuzzelIntro.Part2",
        "vuurtorenlampen" => "Leerling.PuzzelIntro.Part3",
        _ => "Leerling.Puzzle.Break",
    };

    private static IReadOnlyList<string> PreviewShells => PupilSchelpenrijPuzzle.PreviewImageUrls;
}
