@namespace Jobsy.Web.Components.Leerling
@inject CultureState Culture

<div class="vr-answers"
     role="radiogroup"
     aria-label="@GroupLabel"
     @onkeydown="OnKeyDownAsync">
    @for (var i = 0; i < Labels.Count; i++)
    {
        var index = i;
        var (value, key) = Labels[index];
        var selected = Selected == value;
        var label = Culture[key];
        var fill = FillPercent(value);
        <button type="button"
                class="vr-ans @(selected ? "is-sel" : null) @(_tapValue == value ? "is-tapped" : null)"
                role="radio"
                aria-checked="@(selected ? "true" : "false")"
                tabindex="@TabIndexFor(value)"
                disabled="@Disabled"
                @ref="_buttonRefs[index]"
                @onpointerdown="() => _tapValue = value"
                @onpointerup="ClearTap"
                @onpointerleave="ClearTap"
                @onpointercancel="ClearTap"
                @onclick="() => SelectAsync(value)">
            <span class="vr-ans__lvl" aria-hidden="true">
                <i style="height:@(fill.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i>
            </span>
            <span class="vr-ans__label">@label</span>
        </button>
    }
</div>

@code {
    private static readonly int[] FillPercents = [0, 25, 50, 75, 100];

    [Parameter] public IReadOnlyList<(int Value, string Key)> Labels { get; set; } = [];
    [Parameter] public int? Selected { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public string GroupLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }

    private ElementReference[] _buttonRefs = [];
    private int? _tapValue;

    protected override void OnParametersSet()
    {
        if (_buttonRefs.Length != Labels.Count)
        {
            _buttonRefs = new ElementReference[Labels.Count];
        }
    }

    private static int FillPercent(int value)
        => value is >= 1 and <= 5 ? FillPercents[value - 1] : 0;

    private void ClearTap() => _tapValue = null;

    private int TabIndexFor(int value)
    {
        if (Disabled || Labels.Count == 0)
        {
            return -1;
        }

        if (Selected is int selected)
        {
            return value == selected ? 0 : -1;
        }

        return value == Labels[0].Value ? 0 : -1;
    }

    private async Task SelectAsync(int value)
    {
        if (Disabled)
        {
            return;
        }

        await OnSelect.InvokeAsync(value);
        await FocusValueAsync(value);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Disabled || Labels.Count == 0)
        {
            return;
        }

        var values = Labels.Select(l => l.Value).ToList();
        var current = Selected ?? values[0];
        var index = Math.Max(0, values.IndexOf(current));
        int? next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => values[Math.Min(index + 1, values.Count - 1)],
            "ArrowLeft" or "ArrowUp" => values[Math.Max(index - 1, 0)],
            "Home" => values[0],
            "End" => values[^1],
            "1" or "2" or "3" or "4" or "5" => e.Key[0] - '0',
            " " or "Spacebar" or "Enter" => current,
            _ => null
        };

        if (next is null || !values.Contains(next.Value))
        {
            return;
        }

        await SelectAsync(next.Value);
    }

    private async Task FocusValueAsync(int value)
    {
        var index = -1;
        for (var i = 0; i < Labels.Count; i++)
        {
            if (Labels[i].Value == value)
            {
                index = i;
                break;
            }
        }

        if (index < 0 || index >= _buttonRefs.Length)
        {
            return;
        }

        try
        {
            await _buttonRefs[index].FocusAsync();
        }
        catch (InvalidOperationException)
        {
        }
    }
}
