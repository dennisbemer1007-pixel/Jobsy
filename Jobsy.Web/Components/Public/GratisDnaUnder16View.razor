@using Jobsy.Web.Localization
@inject CultureState Culture

<section class="gd-hero gd-hero--under16" aria-labelledby="gd-under16-title" data-testid="gd-under16">
    <button type="button"
            class="gd-qtop__nav gd-under16-back"
            data-testid="gd-under16-back"
            @onclick="HandleBackAsync">
        @Culture["GratisDna.Under16.Back"]
    </button>
    <h1 id="gd-under16-title">@Culture["GratisDna.Under16.Title"]</h1>
    <p class="gd-hero__lead">@Culture["GratisDna.Under16.Lead"]</p>
    <a class="gd-cta" href="@Jobsy.Web.Navigation.PublicRoutes.CreateAccountFromUnder16" data-testid="gd-under16-cta">@Culture["GratisDna.Under16.Cta"]</a>
</section>

@code {
    [Parameter]
    public EventCallback OnBack { get; set; }

    private Task HandleBackAsync() => OnBack.InvokeAsync();
}
