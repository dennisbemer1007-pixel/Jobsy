@namespace Jobsy.Web.KandidaatBanen

@if (!string.IsNullOrWhiteSpace(Text))
{
    <div class="kb-why">
        <span class="kb-why__icon" aria-hidden="true">@SparkleSvg</span>
        <p class="kb-why__text">@Text</p>
    </div>
}

