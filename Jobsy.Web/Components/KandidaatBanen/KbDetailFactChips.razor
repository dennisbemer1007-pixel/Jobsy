@using Jobsy.Web.Models
@inject CultureState Culture

<ul class="kb-detail-chips" aria-label="@Culture["Kb.Detail.FactsAria"]" data-testid="kb-detail-chips">
    @if (VacancyPublicDisplay.HasHoursInfo(Vacancy))
    {
        <li class="kb-detail-chip">
            <span class="kb-detail-chip__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/></svg>
            </span>
            <span class="kb-detail-chip__text">
                <span class="kb-detail-chip__label">@Culture["Kb.Detail.HoursFact"]</span>
                <span class="kb-detail-chip__value">@VacancyPublicDisplay.HoursRangeText(Vacancy)</span>
            </span>
        </li>
    }
    <li class="kb-detail-chip">
        <span class="kb-detail-chip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 8h12M6 12h9M6 16h6"/><path d="M4 5h16v14H4z"/></svg>
        </span>
        <span class="kb-detail-chip__text">
            <span class="kb-detail-chip__label">@Culture["Kb.Detail.WageFact"]</span>
            <span class="kb-detail-chip__value">
                @if (Vacancy.WageVisible && VacancyPublicDisplay.DisplayHourlyWage(Vacancy) is decimal wage)
                {
                    <text>€ @wage.ToString("0.00")</text>
                }
                else if (!Vacancy.WageVisible)
                {
                    <a href="#dob">@Culture["Vacancy.EnterDob"]</a>
                }
                else
                {
                    <text>—</text>
                }
            </span>
        </span>
    </li>
    <li class="kb-detail-chip">
        <span class="kb-detail-chip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>
        </span>
        <span class="kb-detail-chip__text">
            <span class="kb-detail-chip__label">@Culture["Kb.Detail.WhenFact"]</span>
            <span class="kb-detail-chip__value">@WhenLabel</span>
        </span>
    </li>
    @if (!string.IsNullOrWhiteSpace(StartDateLabel))
    {
        <li class="kb-detail-chip">
            <span class="kb-detail-chip__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>
            </span>
            <span class="kb-detail-chip__text">
                <span class="kb-detail-chip__label">@Culture["Kb.Detail.StartDateFact"]</span>
                <span class="kb-detail-chip__value">@StartDateLabel</span>
            </span>
        </li>
    }
    @if (!string.IsNullOrWhiteSpace(CategoryLabel))
    {
        <li class="kb-detail-chip">
            <span class="kb-detail-chip__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M4 12h10M4 17h14"/></svg>
            </span>
            <span class="kb-detail-chip__text">
                <span class="kb-detail-chip__label">@Culture["Kb.Detail.CategoryFact"]</span>
                <span class="kb-detail-chip__value">@CategoryLabel</span>
            </span>
        </li>
    }
    <li class="kb-detail-chip">
        <span class="kb-detail-chip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3 14.5 8.5 20.5 9.2 16 13l1 6-5.5-3-5.5 3 1-6-4.5-3.8 6-0.7z"/></svg>
        </span>
        <span class="kb-detail-chip__text">
            <span class="kb-detail-chip__label">@Culture["Kb.Detail.StartFact"]</span>
            <span class="kb-detail-chip__value">@StartLabel</span>
        </span>
    </li>
    @if (!string.IsNullOrWhiteSpace(TravelChip))
    {
        <li class="kb-detail-chip kb-detail-chip--travel">
            <span class="kb-detail-chip__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 18h2l2-7h6l2 3h2M8 11l1.5-4h5L16 11"/></svg>
            </span>
            <span class="kb-detail-chip__text">
                <span class="kb-detail-chip__label">@Culture["Kb.Detail.TravelTitle"]</span>
                <span class="kb-detail-chip__value">@TravelChip</span>
            </span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public VacancyListItem Vacancy { get; set; } = null!;

    [Parameter]
    public string WhenLabel { get; set; } = "—";

    [Parameter]
    public string StartLabel { get; set; } = "—";

    [Parameter]
    public string? StartDateLabel { get; set; }

    [Parameter]
    public string? CategoryLabel { get; set; }

    [Parameter]
    public string? TravelChip { get; set; }
}
