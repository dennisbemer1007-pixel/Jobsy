@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = string.IsNullOrEmpty(relative) ? "/" : "/" + relative;
        var returnUrl = Uri.EscapeDataString(AuthRedirects.SafeLocalUrl(AuthRedirects.PostLoginUrl(path)));
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
    }
}
