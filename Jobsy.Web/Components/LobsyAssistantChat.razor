@namespace Jobsy.Web.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Jobsy.Web.Media
@using Jobsy.Web.Navigation
@using Jobsy.Web.Features
@inherits CultureAwareComponentBase
@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject AssistantChatHost ChatHost
@inject FeedbackHost FeedbackHost
@inject IFeatureFlags FeatureFlags
@inject IChatContextGreetingGate ContextGreetingGate
@inject IJSRuntime Js

<AuthorizeView>
    <Authorized>
        @if (_visible && _uiVariant == AssistantChatUiVariant.Business && !_open)
        {
            <div class="lobsy-assistant-launcher lobsy-assistant-launcher--business @(_hasBottomNav ? "has-bottom-nav" : null)"
                 data-lobsy-coach>
                <button type="button"
                        id="lobsy-assistant-launcher-btn"
                        class="lobsy-assistant-launcher__btn"
                        @onclick="Toggle"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="lobsy-assistant-panel">
                    <img src="@BrandImages.ChatSilhouetteSvg" alt="" width="28" height="28" decoding="async" />
                    <span class="visually-hidden">@Culture["Assistant.Open"]</span>
                </button>
            </div>
        }
        @if (_visible && _open)
        {
            <div class="lobsy-assistant is-open @SkinClass @(_hasBottomNav ? "has-bottom-nav" : null) @(_uiVariant == AssistantChatUiVariant.Warm ? "lobsy-assistant--coach" : "lobsy-assistant--business-panel")">
                <div id="lobsy-assistant-panel" class="lobsy-assistant__panel" role="dialog" aria-modal="false" aria-labelledby="lobsy-assistant-title" tabindex="-1" @onkeydown="OnKeyDown">
                    <header class="lobsy-assistant__header">
                        <div class="lobsy-assistant__brand">
                            @if (_uiVariant == AssistantChatUiVariant.Warm)
                            {
                                <img class="lobsy-assistant__avatar" src="@BrandImages.MarkSvg" alt="" width="40" height="40" decoding="async" />
                                <div>
                                    <h2 id="lobsy-assistant-title">@Culture["Assistant.BotName"]</h2>
                                    <p class="lobsy-assistant__lead">@Culture["Assistant.SubtitleWarm"]</p>
                                </div>
                            }
                            else
                            {
                                <span class="lobsy-assistant__avatar lobsy-assistant__avatar--business" aria-hidden="true">
                                    <img src="@BrandImages.ChatSilhouetteSvg" alt="" width="24" height="24" decoding="async" />
                                </span>
                                <div>
                                    <h2 id="lobsy-assistant-title">@Culture["Assistant.Title"]</h2>
                                    <p class="lobsy-assistant__lead">@Culture["Assistant.SubtitleBusiness"]</p>
                                </div>
                            }
                        </div>
                        <div class="lobsy-assistant__header-actions">
                            <button type="button" class="lobsy-assistant__icon-btn" @onclick="StartNewChat" disabled="@_busy" aria-label="@Culture["Assistant.NewChat"]" title="@Culture["Assistant.NewChat"]">+</button>
                            <button type="button" class="lobsy-assistant__icon-btn" @onclick="Close" aria-label="@Culture["Assistant.Close"]">×</button>
                        </div>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(_pageContextLine))
                    {
                        <p class="lobsy-assistant__context" role="status">
                            <span class="lobsy-assistant__context-dot" aria-hidden="true"></span>
                            @_pageContextLine
                        </p>
                    }

                    <div class="lobsy-assistant__chat">
                        @for (var i = 0; i < _messages.Count; i++)
                        {
                            var msg = _messages[i];
                            <div class="lobsy-assistant__bubble lobsy-assistant__bubble--@msg.Role">
                                @if (msg.Role == "assistant")
                                {
                                    <div class="lobsy-assistant__bubble-head">
                                        @if (_uiVariant == AssistantChatUiVariant.Warm)
                                        {
                                            <img class="lobsy-assistant__bubble-logo" src="@BrandImages.MarkSvg" alt="" width="32" height="32" decoding="async" />
                                        }
                                        else
                                        {
                                            <span class="lobsy-assistant__bubble-logo lobsy-assistant__avatar--business" aria-hidden="true">
                                                <img src="@BrandImages.ChatSilhouetteSvg" alt="" width="20" height="20" decoding="async" />
                                            </span>
                                        }
                                        <span>@Culture["Assistant.BotName"]</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="lobsy-assistant__bubble-role">@Culture["Assistant.You"]</span>
                                }
                                <p>@msg.Content</p>
                                @if (msg.Role == "assistant")
                                {
                                    <ReadAloudButton Text="@msg.Content" SpeechKey="@($"assistant-{i}")" />
                                }
                            </div>
                        }
                        @if (_busy)
                        {
                            <div class="lobsy-assistant__bubble lobsy-assistant__bubble--assistant lobsy-assistant__bubble--typing">
                                <div class="lobsy-assistant__bubble-head">
                                    @if (_uiVariant == AssistantChatUiVariant.Warm)
                                    {
                                        <img class="lobsy-assistant__bubble-logo" src="@BrandImages.MarkSvg" alt="" width="32" height="32" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="lobsy-assistant__bubble-logo lobsy-assistant__avatar--business" aria-hidden="true">
                                            <img src="@BrandImages.ChatSilhouetteSvg" alt="" width="20" height="20" decoding="async" />
                                        </span>
                                    }
                                    <span>@Culture["Assistant.BotName"]</span>
                                </div>
                                <p>@Culture["Assistant.Typing"]</p>
                            </div>
                        }
                    </div>

                    @if (_suggestionChips.Count > 0)
                    {
                        <div class="lobsy-assistant__chips">
                            @foreach (var chip in _suggestionChips)
                            {
                                <button type="button" class="lobsy-assistant__chip" disabled="@_busy" @onclick="() => SendChipAsync(chip)">
                                    @chip.Label
                                </button>
                            }
                        </div>
                    }

                    @if (_actionLinks.Count > 0)
                    {
                        <div class="lobsy-assistant__actions">
                            @foreach (var link in _actionLinks)
                            {
                                <button type="button" class="engagement-btn lobsy-assistant__action" @onclick="() => FollowLink(link)">
                                    @(link.Label ?? link.Url ?? "→")
                                </button>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="state-message error">@_error</p>
                    }

                    <form class="lobsy-assistant__compose" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
                        <label class="visually-hidden" for="lobsy-assistant-input">@Culture["Assistant.InputLabel"]</label>
                        <div class="lobsy-assistant__compose-row">
                            <textarea id="lobsy-assistant-input"
                                      rows="2"
                                      maxlength="1500"
                                      placeholder="@(_uiVariant == AssistantChatUiVariant.Warm ? Culture["Assistant.PlaceholderWarm"] : Culture["Assistant.Placeholder"])"
                                      disabled="@_busy"
                                      @bind="_draft"
                                      @bind:event="oninput"
                                      @onkeydown="OnDraftKeyDown"></textarea>
                            <button type="submit" class="lobsy-assistant__send" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft))" aria-label="@Culture["Assistant.Send"]">
                                <span aria-hidden="true">→</span>
                            </button>
                        </div>
                    </form>

                    <p class="lobsy-assistant__disclaimer">
                        @Culture["Assistant.Disclaimer"]
                        <a class="auth-link" href="/gebruiksvoorwaarden" target="_blank" rel="noopener">@Culture["Assistant.DisclaimerLink"]</a>
                    </p>
                    @if (_uiVariant == AssistantChatUiVariant.Warm)
                    {
                        <p class="lobsy-assistant__human">
                            @Culture["Assistant.HumanLead"]
                            <button type="button" class="auth-link" @onclick="OpenFeedback">@Culture["Assistant.HumanLink"]</button>
                        </p>
                    }
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public bool HasBottomNav { get; set; }
    [Parameter] public bool HideEdgeTab { get; set; }
    [Parameter] public AssistantChatUiVariant UiVariant { get; set; } = AssistantChatUiVariant.Warm;

    private bool _focusInput;

    private bool _visible;
    private bool _open;
    private bool _busy;
    private bool _started;
    private bool _hasBottomNav;
    private bool _employersOn = true;
    private AssistantChatUiVariant _uiVariant;
    private string _draft = "";
    private string? _error;
    private string? _pageContextLine;
    private int _sendGeneration;
    private readonly List<AssistantChatMessage> _messages = [];
    private List<AssistantChatActionItem> _actionLinks = [];
    private List<ChatSuggestionChip> _suggestionChips = [];

    private string SkinClass => _uiVariant == AssistantChatUiVariant.Warm
        ? "lobsy-assistant--skin-warm"
        : "lobsy-assistant--skin-business";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ChatHost.ToggleRequested += OnToggleRequested;
    }

    protected override async Task OnParametersSetAsync()
    {
        _hasBottomNav = HasBottomNav;
        _uiVariant = UiVariant;
        try
        {
            _employersOn = await FeatureFlags.IsEnabledAsync(PlatformFeature.Employers);
        }
        catch (Exception)
        {
            _employersOn = true;
        }

        await ResolveVisibilityAsync();
    }

    public override void Dispose()
    {
        ChatHost.ToggleRequested -= OnToggleRequested;
        if (_open)
        {
            ChatHost.NotifyOpen(false);
        }

        base.Dispose();
    }

    private void OnToggleRequested()
        => _ = InvokeAsync(OpenFromCoachAsync);

    private async Task OpenFromCoachAsync()
    {
        await Toggle();
        StateHasChanged();
    }

    private async Task ResolveVisibilityAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _visible = AssistantChatHost.IsAvailableFor(user);
        }
        catch
        {
            _visible = false;
        }
    }

    private async Task Toggle()
    {
        if (!_visible)
        {
            await ResolveVisibilityAsync();
        }

        if (!_visible)
        {
            return;
        }

        _open = !_open;
        ChatHost.NotifyOpen(_open);
        if (_open)
        {
            _focusInput = true;
            StateHasChanged();
            if (!_started)
            {
                await StartAsync();
            }
        }
    }

    private async Task Close()
    {
        _open = false;
        ChatHost.NotifyOpen(false);
        if (_uiVariant == AssistantChatUiVariant.Warm)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyCoachDock.focus", "lobsy-coach-btn");
            }
            catch
            {
                // Circuit gone or no coach button.
            }
        }
        else
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyCoachDock.focus", "lobsy-assistant-launcher-btn");
            }
            catch
            {
                // No launcher in static render.
            }
        }
    }

    private void OpenFeedback()
    {
        _open = false;
        ChatHost.NotifyOpen(false);
        FeedbackHost.RequestOpen();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc")
        {
            await Close();
        }
    }

    private async Task OnDraftKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || e.ShiftKey || _busy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        await SendAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("jobsyComposeEnter", "lobsy-assistant-input");
            if (_focusInput)
            {
                _focusInput = false;
                await Js.InvokeVoidAsync("jobsyCoachDock.focus", "lobsy-assistant-input");
            }
        }
        catch
        {
            // bUnit / no JS: OnDraftKeyDown still sends.
        }
    }

    private async Task StartAsync()
    {
        _messages.Clear();
        _actionLinks = [];
        _suggestionChips = [];
        _pageContextLine = null;
        _error = null;
        _busy = true;
        _started = true;
        try
        {
            if (_uiVariant == AssistantChatUiVariant.Warm && ContextGreetingGate.Enabled)
            {
                var boot = await CandidateChatContextBuilder.BuildAsync(
                    Api,
                    Navigation,
                    Culture);
                _pageContextLine = boot.PageContextLine;
                _messages.Add(new AssistantChatMessage("assistant", boot.Greeting));
                _suggestionChips = boot.Chips.ToList();
            }
            else
            {
                var reply = await Api.SendAssistantChatAsync([]);
                _messages.Add(new AssistantChatMessage("assistant", reply.Reply));
                ApplyActions(reply.Actions);
            }
        }
        catch
        {
            _messages.Add(new AssistantChatMessage("assistant", Culture["Assistant.Greeting"]));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartNewChat()
    {
        _sendGeneration++;
        _messages.Clear();
        _actionLinks = [];
        _suggestionChips = [];
        _pageContextLine = null;
        _error = null;
        _draft = "";
        _started = false;
        await StartAsync();
    }

    private Task SendChipAsync(ChatSuggestionChip chip)
    {
        _draft = chip.Message;
        return SendAsync();
    }

    private async Task SendAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var text = _draft.Trim();
        _draft = "";
        _error = null;
        _suggestionChips = [];
        _messages.Add(new AssistantChatMessage("user", text));
        _busy = true;
        _actionLinks = [];
        var generation = ++_sendGeneration;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
        try
        {
            var history = AssistantChatHistory.ForRequest(_messages).ToList();
            var reply = await Api.SendAssistantChatAsync(history, timeout.Token);
            if (generation != _sendGeneration)
            {
                return;
            }

            _messages.Add(new AssistantChatMessage("assistant", reply.Reply));
            ApplyActions(reply.Actions);
        }
        catch (ApiErrorException ex) when (ex.Code == ApiErrorException.RateLimited || ex.StatusCode == 429)
        {
            if (generation == _sendGeneration)
            {
                RestoreUnanswered(text);
                _error = Culture["Assistant.RateLimited"];
            }
        }
        catch (OperationCanceledException)
        {
            _sendGeneration++;
            if (generation == _sendGeneration - 1)
            {
                RestoreUnanswered(text);
                _error = Culture["Common.Error.TryAgain"];
            }
        }
        catch (Exception)
        {
            if (generation == _sendGeneration)
            {
                _error = Culture["Common.Error.TryAgain"];
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void RestoreUnanswered(string text)
    {
        var restored = AssistantChatHistory.RestoreAfterUnanswered(_messages, text);
        _messages.Clear();
        _messages.AddRange(restored.Messages);
        _draft = restored.Draft;
    }

    private void ApplyActions(IReadOnlyList<AssistantChatActionItem>? actions)
    {
        if (actions is null || actions.Count == 0)
        {
            return;
        }

        _actionLinks = actions
            .Where(a => !string.IsNullOrWhiteSpace(a.Url))
            .GroupBy(a => a.Url)
            .Select(g => g.First())
            .Take(6)
            .ToList();

        var filter = actions.FirstOrDefault(a =>
            string.Equals(a.Type, "setFilters", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(a.Url));
        if (filter?.Url is not null)
        {
            Navigation.NavigateTo(filter.Url, forceLoad: false);
        }
    }

    private void FollowLink(AssistantChatActionItem link)
    {
        if (!string.IsNullOrWhiteSpace(link.Url))
        {
            Navigation.NavigateTo(link.Url, forceLoad: false);
        }
    }
}
