@namespace Jobsy.Web.Components.School
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Shared
@inject CultureState Culture
@implements IAsyncDisposable

@if (Open)
{
    <div @onkeydown:window="OnWindowKeyDown"></div>
    <div class="sch-dialog-backdrop"
         @onclick="Cancel"
         @onkeydown="OnBackdropKeyDown"
         tabindex="-1"
         @ref="_backdrop">
        <div class="sch-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tw-title"
             tabindex="0"
             @ref="_dialog"
             @onkeydown="OnBackdropKeyDown"
             @onclick:stopPropagation="true">
            <h2 id="tw-title">@Culture["School.TestWindow.Title"]</h2>
            <p class="muted">@Culture["School.TestWindow.Lead"]</p>
            <p>
                <span class="sch-pill @PillClass">@StatusLabel</span>
                @if (ClosesOn is DateOnly d)
                {
                    <span class="muted"> · @Culture["School.TestWindow.Until"] @d.ToString("dd-MM-yyyy")</span>
                }
            </p>

            @if (State is TestWindowState.NotOpen or TestWindowState.Closed)
            {
                <label>
                    @Culture["School.TestWindow.ClosesOn"]
                    <JobsyDateField CssClass="input"
                                    Constraint="JobsyDateConstraint.NotPast"
                                    @bind-Value="_closesOn"
                                    TestId="school-test-window-closes" />
                </label>
            }

            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="state-message error">@Error</p>
                @if (!string.IsNullOrEmpty(FixHref))
                {
                    <p><a href="@FixHref">@Culture["School.TestWindow.FixLink"]</a></p>
                }
            }

            <div class="sch-drawer-actions">
                <button type="button" class="btn-compact" @onclick="Cancel">@Culture["School.Cancel"]</button>
                @if (State == TestWindowState.Open)
                {
                    <button type="button" class="btn-primary" disabled="@Busy" @onclick="CloseWindow">
                        @Culture["School.TestWindow.Close"]
                    </button>
                }
                else if (State == TestWindowState.Closed)
                {
                    <button type="button" class="btn-primary" disabled="@Busy" @onclick="ReopenWindow">
                        @Culture["School.TestWindow.Reopen"]
                    </button>
                }
                else
                {
                    <button type="button" class="btn-primary" disabled="@Busy" @onclick="OpenWindow">
                        @Culture["School.TestWindow.Open"]
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public TestWindowState State { get; set; }
    [Parameter] public DateOnly? ClosesOn { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? FixHref { get; set; }
    [Parameter] public EventCallback<(string Action, DateOnly? ClosesOn)> OnAction { get; set; }
    [Parameter] public ElementReference? RestoreFocusTo { get; set; }

    private DateOnly? _closesOn;
    private ElementReference _backdrop;
    private ElementReference _dialog;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        _closesOn = ClosesOn;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_wasOpen)
        {
            try
            {
                await _dialog.FocusAsync();
            }
            catch
            {
                try
                {
                    await _backdrop.FocusAsync();
                }
                catch
                {
                    // ignore focus failures in prerender/tests
                }
            }
        }

        _wasOpen = Open;
    }

    private string StatusLabel => State switch
    {
        TestWindowState.Open => Culture["School.TestWindow.StatusOpen"],
        TestWindowState.Closed => Culture["School.TestWindow.StatusClosed"],
        _ => Culture["School.TestWindow.StatusNotOpen"]
    };

    private string PillClass => State switch
    {
        TestWindowState.Open => "sch-pill--ok",
        TestWindowState.Closed => "sch-pill--muted",
        _ => "sch-pill--warn"
    };

    private Task OnWindowKeyDown(KeyboardEventArgs e)
        => string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase) ? Cancel() : Task.CompletedTask;

    private Task OnBackdropKeyDown(KeyboardEventArgs e)
        => OnWindowKeyDown(e);

    private async Task Cancel()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
        await RestoreFocusAsync();
    }

    private Task OpenWindow() => Emit("open");
    private Task CloseWindow() => Emit("close");
    private Task ReopenWindow() => Emit("reopen");

    private async Task Emit(string action)
    {
        await OnAction.InvokeAsync((action, _closesOn));
    }

    private async Task RestoreFocusAsync()
    {
        if (RestoreFocusTo is not { } target)
        {
            return;
        }

        try
        {
            await target.FocusAsync();
        }
        catch
        {
            // ignore
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
