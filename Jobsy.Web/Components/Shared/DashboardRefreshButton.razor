@inject JobsyApiClient Api
@inject TokenBalanceCache TokenBalances

<button type="button"
        class="dash-refresh-btn"
        disabled="@(_busy || Disabled)"
        aria-busy="@_busy"
        aria-label="Ververs"
        title="Ververs"
        @onclick="RefreshAsync">
    @if (_busy)
    {
        <span class="dash-refresh-btn__spin" aria-hidden="true"></span>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 0 1-15.5 6.36" />
            <path d="M3 12a9 9 0 0 1 15.5-6.36" />
            <path d="M21 4v6h-6" />
            <path d="M3 20v-6h6" />
        </svg>
    }
    <span class="visually-hidden">Ververs</span>
</button>
@if (_error is not null)
{
    <span class="state-message error dash-refresh-btn__error">@_error</span>
}

@code {
    [Parameter] public string Period { get; set; } = "week";
    [Parameter] public Guid? CompanyId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<DashboardRefreshResult> OnRefreshed { get; set; }

    private bool _busy;
    private string? _error;

    private async Task RefreshAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.RefreshDashboardAsync(Period, CompanyId);
            TokenBalances.Invalidate();
            if (OnRefreshed.HasDelegate)
            {
                await OnRefreshed.InvokeAsync(result);
            }
        }
        catch
        {
            _error = "Verversen mislukt. Probeer het opnieuw.";
        }
        finally
        {
            _busy = false;
        }
    }
}
