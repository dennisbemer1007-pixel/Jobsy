@* Shared clickable KPI tile for role dashboards (equal-height bento cells). *@

<button type="button"
        class="@CssClass"
        @onclick="HandleClickAsync">
    <span class="stat-card__top">
        <span class="stat-card__label">@Label</span>
        @if (ShowWarningDot)
        {
            <span class="stat-card__status stat-card__status--warn" title="Aandacht vereist" aria-hidden="true"></span>
        }
        else if (Emphasis)
        {
            <span class="stat-card__status stat-card__status--ok" aria-hidden="true"></span>
        }
    </span>

    <span class="stat-card__body">
        <span class="stat-card__main">
            <strong class="stat-card__value">@FormattedValue</strong>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <span class="stat-card__hint">@Hint</span>
            }
        </span>

        @if (RingProgress is >= 0 and <= 100)
        {
            <MetricRing Progress="RingProgress.Value"
                        CenterLabel="@RingLabel"
                        SizePx="@RingSize"
                        Warning="Warning"
                        CssClass="@(Warning ? "metric-ring--warn" : null)" />
        }
        else if (Sparkline is { Count: > 1 })
        {
            <MetricSparkline Points="Sparkline"
                             Width="@SparkWidth"
                             Height="@SparkHeight"
                             CssClass="stat-card__spark" />
        }
    </span>

    @if (Progress is >= 0 and <= 100 && RingProgress is null)
    {
        <span class="stat-card__meter" aria-hidden="true">
            <span class="stat-card__meter-fill" style="width:@Progress.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
        </span>
    }
</button>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string FormattedValue { get; set; } = "0";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Emphasis { get; set; }
    [Parameter] public bool Warning { get; set; }
    [Parameter] public double? Progress { get; set; }
    [Parameter] public double? RingProgress { get; set; }
    [Parameter] public string? RingLabel { get; set; }
    [Parameter] public IReadOnlyList<decimal>? Sparkline { get; set; }
    /// <summary>compact | default | featured</summary>
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public EventCallback OnClick { get; set; }

    private bool ShowWarningDot => Warning;

    private int RingSize => Size switch
    {
        "featured" => 44,
        "compact" => 36,
        _ => 40
    };

    private int SparkWidth => Size == "featured" ? 72 : 56;
    private int SparkHeight => Size == "featured" ? 28 : 22;

    private string CssClass
    {
        get
        {
            var classes = "stat-card stat-card--link stat-card--tile";
            if (Selected) classes += " stat-card--selected";
            if (Emphasis) classes += " stat-card--emphasis";
            if (Warning) classes += " stat-card--warning";
            if (Size == "featured") classes += " stat-card--featured";
            if (Size == "compact") classes += " stat-card--compact";
            return classes;
        }
    }

    private Task HandleClickAsync() => OnClick.InvokeAsync();
}
