@using Jobsy.Web.Localization
@inject CultureState Culture

@if (Collapsed)
{
    <button type="button" id="@DomId" class="q-likert q-likert--collapsed @CssClass"
            data-question-id="@QuestionId" disabled="@(!Interactive)" @onclick="ExpandAsync">
        <span class="q-likert__check" aria-hidden="true">✓</span>
        <span class="q-likert__text">@Text</span>
        <strong class="q-likert__value">@Value</strong>
    </button>
}
else
{
    <fieldset id="@DomId"
              class="q-likert @CssClass @(IsCurrent ? "is-current" : null) @(Dimmed ? "is-dimmed" : null)"
              data-question-id="@QuestionId" disabled="@(!Interactive)">
        <legend class="q-likert__legend">
            @if (Index is not null && Total is not null)
            {
                <span class="q-likert__index">@Index/@Total</span>
            }
            <span class="q-likert__text">@Text</span>
            @if (Extra is not null)
            {
                <span class="q-likert__extra">@Extra</span>
            }
        </legend>
        <div class="q-likert__scale" role="group">
            @for (var value = 1; value <= 5; value++)
            {
                var current = value;
                var selected = Value == current;
                <button type="button" class="q-likert__opt @(selected ? "is-on" : null)"
                        disabled="@(!Interactive)" aria-pressed="@selected"
                        aria-label="@($"{current} {Culture["Onboarding.Likert.OfFive"]}")"
                        @onclick="() => OnSelectAsync(current)">@current</button>
            }
        </div>
        <div class="q-likert__labels">
            <span>@(LowLabel ?? Culture["Onboarding.Likert.Low"])</span>
            <span>@(HighLabel ?? Culture["Onboarding.Likert.High"])</span>
        </div>
    </fieldset>
}

@code {
    [Parameter] public int QuestionId { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public int? Value { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public bool IsAnswered { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public bool Dimmed { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public EventCallback Expanded { get; set; }
    [Parameter] public string? LowLabel { get; set; }
    [Parameter] public string? HighLabel { get; set; }
    [Parameter] public int? Index { get; set; }
    [Parameter] public int? Total { get; set; }
    [Parameter] public string InputPrefix { get; set; } = "q";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? Extra { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private string DomId => $"questionnaire-q-{QuestionId}";
    private string InputName => $"{InputPrefix}{QuestionId}";

    private async Task OnSelectAsync(int value)
    {
        if (!Interactive || Value == value)
        {
            return;
        }

        await ValueChanged.InvokeAsync(value);
    }

    private Task ExpandAsync() => Interactive ? Expanded.InvokeAsync() : Task.CompletedTask;
}
