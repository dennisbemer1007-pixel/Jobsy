@namespace Jobsy.Web.Components.Shared.Questionnaire
@using System.Text.RegularExpressions
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Candidate.Tests
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject IJSRuntime Js
@implements IAsyncDisposable

@{
    var targetCount = TargetCount;
    var index = Math.Clamp(_index, 0, Math.Max(0, Ordered.Count - 1));
    var question = Ordered.Count > 0 ? Ordered[index] : null;
    var answered = question is not null && FlowAnswers.ContainsKey(question.Id);
    var isLast = Ordered.Count > 0 && index >= targetCount - 1;
    var answeredCount = AnsweredInTargetCount();
    var reached = TestDepthRules.Reached(Kind, answeredCount);
    var nextLevel = TestDepthRules.Next(Kind, answeredCount);
    var blocks = targetCount > 50 ? 25 : targetCount;
}

<div class="test-flow @(Compact ? "test-flow--compact" : null) @(Target == TestDepthLevel.Bottom ? "test-flow--deep" : null)" data-test-flow="@Kind">
    @if (question is not null)
    {
        @if (TestBlockStageActive && Compact && !string.IsNullOrWhiteSpace(QuestionTitle))
        {
            <TestBlockMobileHero CssClass="test-block-stage__mobile-hero--compact">
                <h2 class="test-block-stage__mobile-hero-title" id="@($"tf-title-{question.Id}")">@QuestionTitle</h2>
            </TestBlockMobileHero>
        }

        @if (Target != TestDepthLevel.Bottom)
        {
            <div class="test-flow__progress-head" id="@($"tf-counter-{Kind}")">
                <p class="test-flow__counter">
                    @Culture.Format("TestFlow.QuestionOf", index + 1, targetCount)
                </p>
                @if (Compact && PartTotal is > 0 && PartIndex is > 0)
                {
                    <p class="test-flow__part">
                        @Culture.Format("Discovery.Test.PartOf", PartIndex, PartTotal)
                    </p>
                }
            </div>
        }
        <div class="test-flow__bar" role="group" aria-label="@Culture.Format("TestFlow.QuestionOf", index + 1, targetCount)">
            @for (var seg = 0; seg < blocks; seg++)
            {
                var segIndex = blocks == targetCount
                    ? seg
                    : Math.Min(targetCount - 1, (int)Math.Floor(seg * (double)targetCount / blocks));
                var segQuestion = Ordered[segIndex];
                var segAnswered = _flowAnswers.ContainsKey(segQuestion.Id);
                var segCurrent = segIndex == index;
                var cls = segAnswered
                    ? "is-done"
                    : segCurrent
                        ? "is-current"
                        : "is-todo";
                if (segAnswered && !segCurrent)
                {
                    <button type="button"
                            class="test-flow__seg @cls"
                            title="@Culture.Format("TestFlow.JumpToQuestion", segIndex + 1)"
                            aria-label="@Culture.Format("TestFlow.JumpToQuestion", segIndex + 1)"
                            @onclick="() => BeginEdit(segIndex)"></button>
                }
                else
                {
                    <span class="test-flow__seg @cls" aria-hidden="@(segCurrent ? null : "true")"></span>
                }
            }
            @if (!Compact)
            {
                @foreach (var band in TestDepthRules.Levels(Kind))
                {
                    if (band.Count < targetCount)
                    {
                        var pct = band.Count * 100.0 / targetCount;
                        <span class="test-flow__tick" style="--tick:@pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
                    }
                }
            }
        </div>
        @if (!Compact && Target != TestDepthLevel.Bottom)
        {
            <p class="test-flow__level">
                @if (reached is TestDepthLevel r)
                {
                    <span class="test-flow__level-check" aria-hidden="true">✓</span>
                    <span>@Culture.Format("TestFlow.LevelDone", Culture[TestDepthRules.NameKey(r)])</span>
                    @if (nextLevel is TestDepthLevel n && CountForLevel(n) <= targetCount)
                    {
                        <span> · @Culture.Format("TestFlow.LevelNext", CountForLevel(n) - answeredCount, Culture[TestDepthRules.NameKey(n)])</span>
                    }
                }
                else if (nextLevel is TestDepthLevel n0)
                {
                    <span>@Culture.Format("TestFlow.LevelNext", CountForLevel(n0) - answeredCount, Culture[TestDepthRules.NameKey(n0)])</span>
                }
            </p>
        }

        var spokenQuestion = StripIdPrefix(question.Text);
        <div class="test-flow__speak">
            <div class="test-flow__question-head">
                @if (Compact && !string.IsNullOrWhiteSpace(QuestionTitle) && !TestBlockStageActive)
                {
                    <h2 class="test-flow__title" id="@($"tf-title-{question.Id}")">@QuestionTitle</h2>
                }
                <ReadAloudButton Text="@spokenQuestion"
                                 SpeechKey="@($"q-{Kind}-{question.Id}")"
                                 IconOnly="@Compact"
                                 PlayAria="@Culture["ReadAloud.Play"]" />
            </div>
            @if (Compact && !string.IsNullOrWhiteSpace(QuestionLead))
            {
                <p class="test-flow__lead">@QuestionLead</p>
            }
            <blockquote class="test-flow__statement" id="@($"tf-stmt-{question.Id}")">
                “@spokenQuestion”
            </blockquote>
        </div>
        @if (!string.IsNullOrWhiteSpace(question.Example))
        {
            <p class="test-example" data-testid="test-item-example">@question.Example</p>
        }

        <LikertRadioGroup @key="question.Id"
                          QuestionId="question.Id"
                          Value="@(FlowAnswers.TryGetValue(question.Id, out var saved) ? saved : null)"
                          Interactive="true"
                          InputPrefix="@InputPrefix"
                          StatementId="@($"tf-stmt-{question.Id}")"
                          RequestFocus="_focusRequest"
                          ValueChanged="OnAnswerAsync" />

        @if (AfterLikert is not null)
        {
            @AfterLikert
        }

        @if (!Compact)
        {
            var answeredEarlier = RecentAnswered().ToList();
            @if (answeredEarlier.Count > 0)
            {
                <details class="test-flow__earlier" data-testid="test-earlier-answers">
                    <summary class="test-flow__earlier-summary">
                        @Culture.Format("TestFlow.EarlierAnswers", answeredEarlier.Count)
                    </summary>
                    <ol class="test-flow__earlier-list">
                        @for (var n = 0; n < answeredEarlier.Count; n++)
                        {
                            var (q, val, qi) = answeredEarlier[n];
                            var displayIndex = answeredEarlier.Count - n;
                            <li>
                                <span class="test-flow__earlier-num" aria-hidden="true">@displayIndex.</span>
                                <span class="test-flow__earlier-text">“@StripIdPrefix(q.Text)”</span>
                                <strong class="test-flow__earlier-val">@val</strong>
                                <button type="button" class="test-flow__adjust" @onclick="() => BeginEdit(qi)">
                                    @Culture["TestFlow.Adjust"]
                                </button>
                            </li>
                        }
                    </ol>
                </details>
            }
        }

        @if (ShowProgressInsight && _insightLines.Count > 0)
        {
            <p class="test-flow__insight-mobile" data-testid="test-progress-insight-mobile" aria-live="polite">
                @Culture.Format("TestFlow.ProgressInsight.Mobile", _insightLines[^1])
                @if (_insightNewCount > 0)
                {
                    <span class="test-flow__insight-mobile-new"> · @Culture.Format("TestFlow.ProgressInsight.MobileNew", _insightNewCount)</span>
                }
            </p>
        }

        <footer class="test-flow__footer" @ref="_footer" data-sticky-footer>
            <button type="button"
                    class="test-flow__back"
                    disabled="@(index <= 0 && !OnLeave.HasDelegate)"
                    @onclick="GoBackAsync">
                @Culture["TestFlow.Back"]
            </button>
            @if (!Compact && OnLater.HasDelegate)
            {
                <button type="button" class="test-flow__later" data-testid="onboarding-tests-later" @onclick="LaterAsync">
                    @(LaterLabel ?? Culture["TestFlow.Later"])
                </button>
            }
            <button type="button"
                    class="test-flow__next engagement-btn"
                    disabled="@(!answered || LoadFailed)"
                    @onclick="GoNextAsync">
                @(isLast ? (FinishLabel ?? Culture["TestFlow.Finish"]) : Culture["TestFlow.Next"])
            </button>
        </footer>
    }
</div>

@code {
    public sealed record FlowQuestion(int Id, string Text, string? Example = null);

    [Parameter] public AssessmentKind Kind { get; set; }
    [Parameter] public IReadOnlyList<FlowQuestion> Questions { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<int, int> Answers { get; set; } = new Dictionary<int, int>();
    [Parameter] public int StartAt { get; set; }
    [Parameter] public TestDepthLevel Target { get; set; } = TestDepthLevel.Full;
    [Parameter] public QuestionnaireAutosave? Autosave { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? QuestionTitle { get; set; }
    [Parameter] public string? QuestionLead { get; set; }
    [Parameter] public int PartIndex { get; set; }
    [Parameter] public int PartTotal { get; set; }
    [Parameter] public string InputPrefix { get; set; } = "tf";
    [Parameter] public EventCallback<TestDepthLevel> OnLevelReached { get; set; }
    [Parameter] public EventCallback OnFinished { get; set; }
    [Parameter] public EventCallback OnLater { get; set; }
    [Parameter] public string? LaterLabel { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<(int Id, int Value)> OnAnswer { get; set; }
    [Parameter] public EventCallback<int> OnIndexChanged { get; set; }
    [Parameter] public bool LoadFailed { get; set; }
    /// <summary>Overrides <see cref="UiStrings"/> TestFlow.Finish on the last question (e.g. onboarding “Volgende test”).</summary>
    [Parameter] public string? FinishLabel { get; set; }
    /// <summary>When set, advancing past this 0-based index fires <see cref="OnPauseAfter"/> instead of moving on.</summary>
    [Parameter] public Func<int, bool>? ShouldPauseAfterIndex { get; set; }
    [Parameter] public EventCallback<int> OnPauseAfter { get; set; }
    [Parameter] public int? ExternalIndex { get; set; }
    [Parameter] public RenderFragment? AfterLikert { get; set; }
    [Parameter] public bool ShowProgressInsight { get; set; }
    [Parameter] public Func<int, string>? DomainForQuestionId { get; set; }
    [Parameter] public EventCallback<ProgressInsightSnapshot> ProgressInsightChanged { get; set; }

    [CascadingParameter(Name = "TestBlockStageActive")]
    private bool TestBlockStageActive { get; set; }

    public sealed record ProgressInsightSnapshot(IReadOnlyList<string> Lines, int NewLineCount);

    private int _index;
    private int? _appliedExternalIndex;
    private bool _focusRequest;
    private int? _resumeAfterEdit;
    private readonly HashSet<TestDepthLevel> _firedLevels = [];
    private CancellationTokenSource? _advanceCts;
    private int _advanceGeneration;
    /// <summary>Merged parameter answers plus in-flight selections (same dict ref may not trigger param refresh).</summary>
    private readonly Dictionary<int, int> _flowAnswers = new();
    private IReadOnlyDictionary<int, int> FlowAnswers => _flowAnswers;
    private IReadOnlyList<FlowQuestion> Ordered => Questions;
    private string? _orderedSignature;

    private int TargetCount => Math.Min(Ordered.Count, TestDepthRules.CountFor(Kind, Target));

    private IReadOnlyList<int> OrderedQuestionIds { get; set; } = [];

    private IReadOnlyList<string> _insightLines = [];

    private int _insightNewCount;

    private int _previousInsightLineCount;

    protected override void OnInitialized()
    {
        _orderedSignature = BuildOrderedSignature();
        MergeParameterAnswers();
        ApplyFirstUnansweredIndex();
        _focusRequest = true;
        RefreshProgressInsight();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var reduce = await MatchesMediaAsync("(prefers-reduced-motion: reduce)");
                if (reduce)
                {
                    // Auto-advance at once under reduced motion (handled in OnAnswerAsync).
                }

            }
            catch
            {
                // bUnit / no JS
            }
        }

        _focusRequest = false;
        try
        {
            await Js.InvokeVoidAsync("jobsyCoachDock.syncStickyFooters");
        }
        catch
        {
            // bUnit
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    private ElementReference _footer;

    private static int CountForLevel(TestDepthLevel? level)
        => level is null ? 0 : level switch
        {
            TestDepthLevel.First => TestDepthRules.FirstCount,
            TestDepthLevel.Deeper => TestDepthRules.DeeperCount,
            _ => 0
        };

    private int CountForLevel(TestDepthLevel level) => TestDepthRules.CountFor(Kind, level);

    public static string StripIdPrefix(string text)
        => Regex.Replace(text ?? "", @"^\d+\.\s*", "");

    private IEnumerable<(FlowQuestion Q, int Value, int Index)> RecentAnswered()
    {
        for (var i = 0; i < TargetCount && i < Ordered.Count; i++)
        {
            if (i == _index)
            {
                continue;
            }

            var q = Ordered[i];
            if (_flowAnswers.TryGetValue(q.Id, out var v))
            {
                yield return (q, v, i);
            }
        }
    }

    private async Task<bool> MatchesMediaAsync(string query)
    {
        try
        {
            return await Js.InvokeAsync<bool>("jobsyMedia.matches", query);
        }
        catch
        {
            return false;
        }
    }

    private async Task OnAnswerAsync(int value)
    {
        // Capture the question before any await. Volgende can run while those awaits
        // are in flight; a later _index++ would skip the question the click already left.
        var answeredIndex = _index;
        if (answeredIndex < 0 || answeredIndex >= Ordered.Count) return;
        CancelPendingAdvance();
        var generation = _advanceGeneration;

        var question = Ordered[answeredIndex];
        _flowAnswers[question.Id] = value;
        RefreshProgressInsight();

        if (Autosave is not null)
        {
            await Autosave.SetAnswerAsync(question.Id, value);
        }
        else if (OnAnswer.HasDelegate)
        {
            await OnAnswer.InvokeAsync((question.Id, value));
        }

        await InvokeAsync(StateHasChanged);
        await OnChanged.InvokeAsync();
        await FireLevelsAsync();
        if (generation != _advanceGeneration || _index != answeredIndex) return;

        if (_resumeAfterEdit is not null)
        {
            await ReturnFromEditAsync();
            return;
        }

        if (answeredIndex >= TargetCount - 1)
        {
            if (FirstGapIndex() is int lastGap)
            {
                _index = lastGap;
                _focusRequest = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (Autosave is not null)
            {
                await Autosave.FlushAsync();
            }

            if (OnFinished.HasDelegate)
            {
                await OnFinished.InvokeAsync();
            }

            return;
        }

        if (ShouldPauseAfterIndex?.Invoke(answeredIndex) == true)
        {
            await OnPauseAfter.InvokeAsync(answeredIndex);
            _focusRequest = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var delayMs = await MatchesMediaAsync("(prefers-reduced-motion: reduce)") ? 0 : 250;
        if (generation != _advanceGeneration || _index != answeredIndex) return;

        _advanceCts = new CancellationTokenSource();
        var token = _advanceCts.Token;
        try
        {
            if (delayMs > 0) await Task.Delay(delayMs, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested || generation != _advanceGeneration || _index != answeredIndex) return;
        if (_index >= TargetCount - 1) return;
        await SetIndexAsync(answeredIndex + 1);
    }

    private void CancelPendingAdvance()
    {
        _advanceGeneration++;
        _advanceCts?.Cancel();
        _advanceCts?.Dispose();
        _advanceCts = null;
    }

    private int? FirstGapIndex()
    {
        var count = TargetCount;
        for (var i = 0; i < count; i++)
        {
            if (!_flowAnswers.ContainsKey(Ordered[i].Id))
            {
                return i;
            }
        }

        return null;
    }

    private int AnsweredInTargetCount()
    {
        var count = 0;
        for (var i = 0; i < TargetCount; i++)
        {
            if (_flowAnswers.ContainsKey(Ordered[i].Id))
            {
                count++;
            }
        }

        return count;
    }

    private static bool IsInCurrentFlow(int id, IReadOnlyList<FlowQuestion> ordered, int targetCount)
    {
        for (var i = 0; i < targetCount && i < ordered.Count; i++)
        {
            if (ordered[i].Id == id)
            {
                return true;
            }
        }

        return false;
    }

    private string BuildOrderedSignature()
        => $"{(int)Kind}:{Target}:{string.Join(',', Ordered.Take(TargetCount).Select(q => q.Id))}";

    private void ApplyFirstUnansweredIndex()
    {
        _index = Math.Clamp(StartAt, 0, Math.Max(0, TargetCount - 1));
        for (var i = 0; i < TargetCount; i++)
        {
            if (!_flowAnswers.ContainsKey(Ordered[i].Id))
            {
                _index = i;
                break;
            }
        }
    }

    private void MergeParameterAnswers()
    {
        foreach (var (id, val) in Answers)
        {
            if (IsInCurrentFlow(id, Ordered, TargetCount))
            {
                _flowAnswers[id] = val;
            }
        }

        if (Autosave is not null)
        {
            foreach (var (id, val) in Autosave.Answers)
            {
                if (IsInCurrentFlow(id, Ordered, TargetCount))
                {
                    _flowAnswers[id] = val;
                }
            }
        }
    }

    protected override void OnParametersSet()
    {
        var signature = BuildOrderedSignature();
        if (!string.Equals(signature, _orderedSignature, StringComparison.Ordinal))
        {
            _orderedSignature = signature;
            _flowAnswers.Clear();
            _firedLevels.Clear();
            MergeParameterAnswers();
            ApplyFirstUnansweredIndex();
        }
        else
        {
            MergeParameterAnswers();
        }
        RefreshProgressInsight();

        // Apply an external jump only when it changes. Re-applying the same index
        // on every render put the candidate back on the last question after Next
        // had moved them to the first unanswered one.
        if (ExternalIndex is int ei && _appliedExternalIndex != ei)
        {
            _appliedExternalIndex = ei;
            _index = Math.Clamp(ei, 0, Math.Max(0, TargetCount - 1));
        }
    }

    /// <summary>Jump to a 0-based index (used after pause "Verder").</summary>
    public void JumpToIndex(int index)
    {
        JumpTo(index);
    }

    private async Task FireLevelsAsync()
    {
        var count = AnsweredInTargetCount();
        foreach (var band in TestDepthRules.Levels(Kind))
        {
            if (count >= band.Count && _firedLevels.Add(band.Level) && OnLevelReached.HasDelegate)
            {
                await OnLevelReached.InvokeAsync(band.Level);
            }
        }
    }

    private void BeginEdit(int index)
    {
        CancelPendingAdvance();
        if (index != _index)
        {
            _resumeAfterEdit ??= _index;
        }

        JumpTo(index);
    }

    private void JumpTo(int index)
    {
        CancelPendingAdvance();
        _index = Math.Clamp(index, 0, Math.Max(0, TargetCount - 1));
        _focusRequest = true;
    }

    private async Task ReturnFromEditAsync()
    {
        if (_resumeAfterEdit is not int resume)
        {
            return;
        }

        _resumeAfterEdit = null;
        _index = Math.Clamp(resume, 0, Math.Max(0, TargetCount - 1));
        _focusRequest = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task GoBackAsync()
    {
        CancelPendingAdvance();
        if (_index <= 0)
        {
            if (OnLeave.HasDelegate)
            {
                await OnLeave.InvokeAsync();
            }

            return;
        }

        await SetIndexAsync(_index - 1);
    }

    private async Task SetIndexAsync(int index)
    {
        _index = Math.Clamp(index, 0, Math.Max(0, TargetCount - 1));
        _focusRequest = true;
        if (OnIndexChanged.HasDelegate)
        {
            await OnIndexChanged.InvokeAsync(_index);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task GoNextAsync()
    {
        CancelPendingAdvance();
        if (_resumeAfterEdit is not null)
        {
            await ReturnFromEditAsync();
            return;
        }

        if (Ordered.Count == 0 || TargetCount <= 0) return;
        _index = Math.Clamp(_index, 0, TargetCount - 1);
        var question = Ordered[_index];
        if (!_flowAnswers.ContainsKey(question.Id)) return;

        if (_index >= TargetCount - 1)
        {
            if (FirstGapIndex() is int gap)
            {
                _index = gap;
                _focusRequest = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (Autosave is not null) await Autosave.FlushAsync();
            await OnFinished.InvokeAsync();
            return;
        }

        if (ShouldPauseAfterIndex?.Invoke(_index) == true)
        {
            await OnPauseAfter.InvokeAsync(_index);
            return;
        }

        await SetIndexAsync(_index + 1);
    }

    private async Task LaterAsync()
    {
        if (Autosave is not null) await Autosave.FlushAsync();
        await OnLater.InvokeAsync();
    }

    private void RefreshProgressInsight()
    {
        if (!ShowProgressInsight || DomainForQuestionId is null)
        {
            _insightLines = [];
            _insightNewCount = 0;
            _ = NotifyProgressInsightAsync();
            return;
        }

        OrderedQuestionIds = Ordered.Take(TargetCount).Select(q => q.Id).ToList();
        var labels = TestProgressInsight.DomainLabelsSoFar(
            Kind,
            OrderedQuestionIds,
            _flowAnswers,
            DomainForQuestionId);
        var prefix = Culture[TestProgressInsight.PrefixKey(Kind)];
        _insightLines = labels
            .Select(label => Culture.Format("TestFlow.ProgressInsight.Line", prefix, label))
            .ToList();
        _insightNewCount = Math.Max(0, _insightLines.Count - _previousInsightLineCount);
        _previousInsightLineCount = _insightLines.Count;
        _ = NotifyProgressInsightAsync();
    }

    private async Task NotifyProgressInsightAsync()
    {
        if (ProgressInsightChanged.HasDelegate)
        {
            await ProgressInsightChanged.InvokeAsync(new ProgressInsightSnapshot(_insightLines, _insightNewCount));
        }
    }
}
