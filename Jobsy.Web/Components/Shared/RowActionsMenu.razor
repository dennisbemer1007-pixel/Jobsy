@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture
@inject IJSRuntime Js

<div class="row-actions-menu @(_open ? "is-open" : null)" @ref="_root" @onfocusout="OnFocusOut">
    <button type="button"
            @ref="_toggle"
            class="icon-btn row-actions-menu__toggle"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@(AriaLabel ?? Culture["Common.Actions"])"
            title="@(AriaLabel ?? Culture["Common.Actions"])"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        @((MarkupString)ActionIcons.More)
    </button>
    @if (_open)
    {
        <div @ref="_panel" class="row-actions-menu__panel" role="menu" @onclick="Close" @onclick:stopPropagation="true" @onkeydown="OnKey">
            <button type="button" class="visually-hidden" data-jobsy-dialog-close @onclick="Close">@Culture["AdminUi.CloseDrawer"]</button>
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private bool _open;
    private bool _trapped;
    private ElementReference _root;
    private ElementReference _toggle;
    private ElementReference _panel;

    private void Toggle()
        => _open = !_open;

    private void Close()
        => _open = false;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && !_trapped)
        {
            _trapped = true;
            try
            {
                await Js.InvokeVoidAsync("jobsyDialog.trap", _panel);
            }
            catch (Exception)
            {
            }
        }
        else if (!_open && _trapped)
        {
            _trapped = false;
            try
            {
                await Js.InvokeVoidAsync("jobsyDialog.release");
            }
            catch (Exception)
            {
            }

            try
            {
                await _toggle.FocusAsync();
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task OnFocusOut(FocusEventArgs _)
    {
        if (!_open)
        {
            return;
        }

        // jobsyDialog.trap moves focus into the panel and that focusout bubbles.
        // Close only when focus has actually left the menu.
        await Task.Delay(150);
        if (!_open)
        {
            return;
        }

        var left = false;
        try
        {
            left = await Js.InvokeAsync<bool>("jobsyDialog.focusLeft", _root);
        }
        catch (Exception)
        {
            left = false;
        }

        if (!left || !_open)
        {
            return;
        }

        _open = false;
        await InvokeAsync(StateHasChanged);
    }
}
