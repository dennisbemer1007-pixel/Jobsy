@namespace Jobsy.Web.Components.Shared
@using Jobsy.Core.Rules
@inject CultureState Culture
@inject IJSRuntime Js

<div class="jobsy-date-field jobsy-date-field--typed"
     data-testid="@TestId">
    <div class="jobsy-date-field__control">
        <input @ref="_textInput"
               id="@InputId"
               class="jobsy-date-field__text @CssClass"
               type="text"
               inputmode="numeric"
               autocomplete="@_autocomplete"
               lang="@_htmlLang"
               placeholder="@_placeholder"
               value="@_text"
               required="@Required"
               disabled="@Disabled"
               aria-invalid="@AriaInvalid"
               aria-describedby="@CombinedAriaDescribedBy"
               @oninput="OnTextInputAsync"
               @onblur="OnTextBlurAsync" />
        <button type="button"
                class="jobsy-date-field__picker-btn"
                tabindex="-1"
                disabled="@Disabled"
                aria-label="@_pickerLabel"
                @onclick="OpenPickerAsync">
            <span class="jobsy-date-field__calendar-icon" aria-hidden="true"></span>
        </button>
        <input @ref="_nativeInput"
               class="jobsy-date-field__input jobsy-date-field__input--native"
               type="@_nativeInputType"
               lang="@_htmlLang"
               min="@_min"
               max="@_max"
               value="@_nativeValue"
               tabindex="-1"
               aria-hidden="true"
               @onchange="OnNativeChangedAsync" />
    </div>
    <p id="@_errorId"
       class="jobsy-date-field__error"
       role="status"
       aria-live="polite">@_errorMessage</p>
</div>

@code {
    private ElementReference _textInput;
    private ElementReference _nativeInput;
    private string _htmlLang = "nl-NL";
    private string _nativeInputType = "date";
    private string? _min;
    private string? _max;
    private string? _nativeValue;
    private string _text = "";
    private string _placeholder = "dd-mm-jjjj";
    private string _autocomplete = "off";
    private string _pickerLabel = "Open calendar";
    private readonly string _errorId = $"jobsy-date-err-{Guid.NewGuid():N}";
    private string? _errorMessage;
    private JobsyDateValidationCode _validation = JobsyDateValidationCode.None;
    private bool _touched;

    [Parameter] public JobsyDatePickerKind Kind { get; set; } = JobsyDatePickerKind.Date;
    [Parameter] public JobsyDateConstraint Constraint { get; set; } = JobsyDateConstraint.None;
    [Parameter] public DateOnly? ReferenceDate { get; set; }
    [Parameter] public string? ReferenceMonth { get; set; }
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public string? MonthValue { get; set; }
    [Parameter] public EventCallback<string?> MonthValueChanged { get; set; }
    [Parameter] public string? TextValue { get; set; }
    [Parameter] public EventCallback<string?> TextValueChanged { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string? TestId { get; set; }
    [Parameter] public string? InputId { get; set; }
    [Parameter] public string? AriaDescribedBy { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowInvalid { get; set; }

    private bool IsMonth => Kind == JobsyDatePickerKind.Month;

    private string? CombinedAriaDescribedBy
    {
        get
        {
            var ids = new List<string>();
            if (!string.IsNullOrWhiteSpace(AriaDescribedBy))
            {
                ids.Add(AriaDescribedBy);
            }

            ids.Add(_errorId);
            return string.Join(' ', ids);
        }
    }

    private string? AriaInvalid
        => ShowError ? "true" : null;

    private bool ShowError
        => (_touched || ShowInvalid)
           && _validation != JobsyDateValidationCode.None;

    protected override void OnParametersSet()
    {
        _nativeInputType = IsMonth ? "month" : "date";
        _htmlLang = Culture.Language switch
        {
            "en" => "en-GB",
            "pl" => "pl-PL",
            "ro" => "ro-RO",
            "ar" => "ar",
            _ => "nl-NL"
        };

        _placeholder = Placeholder ?? (IsMonth
            ? JobsyDateInputRules.MonthPlaceholder(Culture.Language)
            : JobsyDateInputRules.Placeholder(Culture.Language));
        _autocomplete = !IsMonth && Constraint == JobsyDateConstraint.CandidateBirthDate ? "bday" : "off";
        _pickerLabel = Culture.Language switch
        {
            "en" => "Open calendar",
            _ => "Kalender openen"
        };

        var bounds = JobsyDateInputRules.Bounds(EffectiveConstraint, ReferenceDate);
        _min = Min ?? bounds.Min;
        _max = Max ?? bounds.Max;

        if (IsMonth)
        {
            SyncMonthTextFromModel();
            RefreshValidation(forceMessage: ShowInvalid);
            return;
        }

        DateOnly? modelDate = Value;
        if (modelDate is null && TextValue is not null && JobsyDateInputRules.TryParseDateInput(TextValue, out var fromText))
        {
            modelDate = fromText;
        }

        _nativeValue = JobsyDateInputRules.ToDateInputValue(modelDate);
        if (modelDate is { } d)
        {
            var formatted = JobsyDateInputRules.FormatDisplayDate(d, Culture.Language);
            if (!_touched || string.IsNullOrWhiteSpace(_text))
            {
                _text = formatted;
            }
        }
        else if (!_touched && TextValue is not null)
        {
            _text = JobsyDateInputRules.ApplyDateMask(TextValue);
        }
        else if (!_touched && string.IsNullOrWhiteSpace(_text))
        {
            _text = "";
        }

        RefreshValidation(forceMessage: ShowInvalid);
    }

    private JobsyDateConstraint EffectiveConstraint
        => IsMonth && !string.IsNullOrWhiteSpace(ReferenceMonth)
            ? JobsyDateConstraint.WorkHistoryEndAfterStart
            : Constraint;

    private void SyncMonthTextFromModel()
    {
        _nativeValue = JobsyDateInputRules.ToMonthInputValue(MonthValue);
        if (!string.IsNullOrWhiteSpace(MonthValue))
        {
            var formatted = JobsyDateInputRules.FormatDisplayMonth(MonthValue, Culture.Language);
            if (!_touched || string.IsNullOrWhiteSpace(_text))
            {
                _text = formatted;
            }
        }
        else if (!_touched)
        {
            _text = "";
        }
    }

    private async Task OnTextInputAsync(ChangeEventArgs e)
    {
        _touched = true;
        if (IsMonth)
        {
            _text = JobsyDateInputRules.ApplyMonthMask(e.Value?.ToString());
            if (JobsyDateInputRules.TryParseFlexibleMonth(_text, out var month))
            {
                await CommitMonthAsync(month);
            }
            else if (string.IsNullOrWhiteSpace(_text))
            {
                await CommitMonthAsync(null);
            }

            RefreshValidation(forceMessage: false);
            return;
        }

        _text = JobsyDateInputRules.ApplyDateMask(e.Value?.ToString());
        if (JobsyDateInputRules.TryParseFlexibleDate(_text, out var parsed))
        {
            await CommitDateAsync(parsed);
            RefreshValidation(forceMessage: false);
            return;
        }

        if (string.IsNullOrWhiteSpace(_text))
        {
            await CommitDateAsync(null);
        }

        RefreshValidation(forceMessage: false);
    }

    private async Task OnTextBlurAsync()
    {
        _touched = true;
        if (IsMonth)
        {
            if (JobsyDateInputRules.TryParseFlexibleMonth(_text, out var month))
            {
                _text = JobsyDateInputRules.FormatDisplayMonth(month, Culture.Language);
                await CommitMonthAsync(month);
            }

            RefreshValidation(forceMessage: true);
            return;
        }

        if (JobsyDateInputRules.TryParseFlexibleDate(_text, out var parsed))
        {
            _text = JobsyDateInputRules.FormatDisplayDate(parsed, Culture.Language);
            await CommitDateAsync(parsed);
        }

        RefreshValidation(forceMessage: true);
    }

    private async Task OnNativeChangedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (IsMonth)
        {
            if (!JobsyDateInputRules.TryParseMonthInput(raw, out var month))
            {
                await CommitMonthAsync(null);
                RefreshValidation(forceMessage: true);
                return;
            }

            _text = JobsyDateInputRules.FormatDisplayMonth(month, Culture.Language);
            _touched = true;
            await CommitMonthAsync(month);
            RefreshValidation(forceMessage: true);
            return;
        }

        if (!JobsyDateInputRules.TryParseDateInput(raw, out var parsed))
        {
            await CommitDateAsync(null);
            RefreshValidation(forceMessage: true);
            return;
        }

        _text = JobsyDateInputRules.FormatDisplayDate(parsed, Culture.Language);
        _touched = true;
        await CommitDateAsync(parsed);
        RefreshValidation(forceMessage: true);
    }

    private async Task CommitDateAsync(DateOnly? date)
    {
        Value = date;
        _nativeValue = JobsyDateInputRules.ToDateInputValue(date);
        await ValueChanged.InvokeAsync(date);
        if (TextValueChanged.HasDelegate)
        {
            TextValue = JobsyDateInputRules.ToDateInputValue(date);
            await TextValueChanged.InvokeAsync(TextValue);
        }
    }

    private async Task CommitMonthAsync(string? yyyyMm)
    {
        MonthValue = yyyyMm;
        _nativeValue = JobsyDateInputRules.ToMonthInputValue(yyyyMm);
        await MonthValueChanged.InvokeAsync(yyyyMm);
    }

    private void RefreshValidation(bool forceMessage)
    {
        if (IsMonth)
        {
            _validation = JobsyDateInputRules.ValidateMonthText(_text, EffectiveConstraint, ReferenceMonth, Required);
            _errorMessage = ShowError || forceMessage
                ? JobsyDateInputRules.MonthValidationMessage(_validation, Culture.Language)
                : "";
            return;
        }

        _validation = JobsyDateInputRules.ValidateText(_text, Constraint, ReferenceDate, Required);
        if (_validation == JobsyDateValidationCode.None
            && JobsyDateInputRules.TryParseFlexibleDate(_text, out var parsed))
        {
            _validation = JobsyDateInputRules.Validate(parsed, Constraint, ReferenceDate);
        }

        _errorMessage = ShowError || forceMessage
            ? JobsyDateInputRules.ValidationMessage(_validation, Culture.Language)
            : "";
    }

    private async Task OpenPickerAsync()
    {
        if (Disabled)
        {
            return;
        }

        await Js.InvokeVoidAsync("jobsyExtras.ensure");
        await Js.InvokeVoidAsync("jobsyExtras.openDatePicker", _nativeInput);
    }
}
