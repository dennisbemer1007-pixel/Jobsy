@namespace Jobsy.Web.Components.Shared
@using System.Globalization
@using Jobsy.Core.Rules
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject IJSRuntime Js

@if (_localizedShell)
{
    <div class="jobsy-date-field jobsy-date-field--localized" data-testid="@TestId">
        <button type="button"
                class="jobsy-date-field__display-btn jobsy-form-value"
                disabled="@Disabled"
                aria-invalid="@(ShowInvalid ? "true" : null)"
                aria-describedby="@AriaDescribedBy"
                @onclick="OpenPickerAsync">
            <span class="jobsy-date-field__display-text">@(_displayText ?? Placeholder)</span>
            <span class="jobsy-date-field__calendar-icon" aria-hidden="true"></span>
        </button>
        <input @ref="_input"
               id="@InputId"
               class="jobsy-date-field__input jobsy-date-field__input--native"
               type="@_inputType"
               lang="@_htmlLang"
               min="@_min"
               max="@_max"
               value="@_value"
               required="@Required"
               disabled="@Disabled"
               tabindex="-1"
               aria-hidden="true"
               @onchange="OnChangedAsync" />
    </div>
}
else
{
    <input @ref="_input"
           id="@InputId"
           class="jobsy-date-field__input @CssClass"
           type="@_inputType"
           lang="@_htmlLang"
           min="@_min"
           max="@_max"
           value="@_value"
           required="@Required"
           disabled="@Disabled"
           aria-invalid="@(ShowInvalid ? "true" : null)"
           data-testid="@TestId"
           @onchange="OnChangedAsync" />
}

@code {
    private ElementReference _input;
    private string _inputType = "date";
    private string? _min;
    private string? _max;
    private string? _value;
    private string? _displayText;
    private string _htmlLang = "nl-NL";
    private bool _localizedShell;

    [Parameter] public JobsyDatePickerKind Kind { get; set; } = JobsyDatePickerKind.Date;
    [Parameter] public JobsyDateConstraint Constraint { get; set; } = JobsyDateConstraint.None;
    [Parameter] public DateOnly? ReferenceDate { get; set; }
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public string? MonthValue { get; set; }
    [Parameter] public EventCallback<string?> MonthValueChanged { get; set; }
    [Parameter] public string? TextValue { get; set; }
    [Parameter] public EventCallback<string?> TextValueChanged { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string? TestId { get; set; }
    [Parameter] public string? InputId { get; set; }
    [Parameter] public string? AriaDescribedBy { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowInvalid { get; set; }

    protected override void OnParametersSet()
    {
        _inputType = Kind == JobsyDatePickerKind.Month ? "month" : "date";
        _htmlLang = Culture.Language switch
        {
            "en" => "en-GB",
            "pl" => "pl-PL",
            "ro" => "ro-RO",
            "ar" => "ar",
            _ => "nl-NL"
        };
        _localizedShell = Kind == JobsyDatePickerKind.Date
                          && (_htmlLang.StartsWith("nl", StringComparison.OrdinalIgnoreCase)
                              || string.IsNullOrWhiteSpace(Culture.Language));

        var bounds = JobsyDateInputRules.Bounds(Constraint, ReferenceDate);
        _min = Min ?? bounds.Min;
        _max = Max ?? bounds.Max;
        _value = Kind switch
        {
            JobsyDatePickerKind.Month => JobsyDateInputRules.ToMonthInputValue(MonthValue),
            _ when TextValue is not null => JobsyDateInputRules.ToDateInputValue(
                JobsyDateInputRules.TryParseDateInput(TextValue, out var d) ? d : null),
            _ => JobsyDateInputRules.ToDateInputValue(Value)
        };

        DateOnly? displayDate = Value;
        if (displayDate is null && JobsyDateInputRules.TryParseDateInput(_value, out var parsedForDisplay))
        {
            displayDate = parsedForDisplay;
        }

        _displayText = displayDate is { } picked
            ? JobsyDateInputRules.FormatDisplayDate(picked, Culture.Language)
            : null;
        Placeholder ??= Culture.Language switch
        {
            "en" => "dd/mm/yyyy",
            _ => "dd-mm-jjjj"
        };
    }

    private async Task OpenPickerAsync()
    {
        if (Disabled)
        {
            return;
        }

        await Js.InvokeVoidAsync("jobsyExtras.ensure");
        await Js.InvokeVoidAsync("jobsyExtras.openDatePicker", _input);
    }

    private async Task OnChangedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (Kind == JobsyDatePickerKind.Month)
        {
            if (!JobsyDateInputRules.TryParseMonthInput(raw, out var month))
            {
                MonthValue = null;
                await MonthValueChanged.InvokeAsync(null);
                return;
            }

            MonthValue = month;
            await MonthValueChanged.InvokeAsync(month);
            return;
        }

        if (!JobsyDateInputRules.TryParseDateInput(raw, out var parsed))
        {
            Value = null;
            _displayText = null;
            await ValueChanged.InvokeAsync(null);
            if (TextValueChanged.HasDelegate)
            {
                TextValue = null;
                await TextValueChanged.InvokeAsync(null);
            }

            return;
        }

        Value = parsed;
        _displayText = JobsyDateInputRules.FormatDisplayDate(parsed, Culture.Language);
        await ValueChanged.InvokeAsync(parsed);
        if (TextValueChanged.HasDelegate)
        {
            TextValue = JobsyDateInputRules.ToDateInputValue(parsed);
            await TextValueChanged.InvokeAsync(TextValue);
        }
    }
}
