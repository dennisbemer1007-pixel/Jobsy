@using Jobsy.Web.Localization
@using Jobsy.Core.Features
@inherits CultureAwareComponentBase
@inject JobsyApiClient Api
@inject IFeatureFlags FeatureFlags

@if (_visible)
{
    <aside class="ob-resume-card" aria-labelledby="ob-resume-title">
        <p id="ob-resume-title" class="ob-resume-card__title">@Culture["Onboarding.Resume.Title"]</p>
        <p class="ob-resume-card__lead">@Culture.Format("Onboarding.Resume.Lead", _remainingSteps)</p>
        <a class="ob-resume-card__link" href="@ResumeHref">@Culture["Onboarding.Resume.Cta"]</a>
    </aside>
}

@code {
    private bool _visible;
    private bool _loadStarted;
    private int _remainingSteps = 1;
    private string ResumeHref = "/candidate/start";

    protected override Task OnInitializedAsync()
        => LoadOnceAsync();

    private async Task LoadOnceAsync()
    {
        if (_loadStarted)
        {
            return;
        }

        _loadStarted = true;
        try
        {
            try
            {
                if (await FeatureFlags.IsEnabledAsync(Jobsy.Core.Features.PlatformFeature.CandidatePassport))
                {
                    ResumeHref = "/candidate/ontdekkingsreis";
                }
            }
            catch
            {
                ResumeHref = "/candidate/start";
            }

            var state = await Api.GetMyOnboardingAsync();
            _visible = state is not null && !state.IsComplete;
            if (_visible)
            {
                _remainingSteps = Math.Max(1, 11 - state!.CurrentStep);
            }
        }
        catch
        {
            _visible = false;
        }
    }
}
