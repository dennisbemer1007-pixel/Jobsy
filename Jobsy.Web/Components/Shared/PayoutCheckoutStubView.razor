@inject CultureState Culture
@inject NavigationManager Navigation

<div class="panel-page">
    <h1>@Title</h1>
    <p class="login-lead">@Lead</p>

    @if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-card__label">Payment</span>
                <strong class="stat-card__value" style="font-size:1rem">@_paymentId</strong>
            </div>
        </div>

        <div class="inline-actions" style="margin-top:1.5rem">
            <button class="login-submit" type="button" disabled="@_busy || string.IsNullOrWhiteSpace(_paymentId)" @onclick="CompleteAsync">
                @(_busy ? BusyLabel : ActionLabel)
            </button>
            <a class="auth-link" href="@CancelHref">@Culture["Common.Cancel"]</a>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Mollie uitbetaling (stub)";
    [Parameter] public string Lead { get; set; } =
        "Simuleer een geslaagde uitbetaling naar je bankrekening. Daarna wordt de self-billing factuur aangemaakt en als betaald gemarkeerd.";
    [Parameter] public string ActionLabel { get; set; } = "Uitbetalen (stub)";
    [Parameter] public string BusyLabel { get; set; } = "Bezig…";
    [Parameter] public string InvalidParamsMessage { get; set; } = "Ongeldige checkout-parameters.";
    [Parameter] public string CancelHref { get; set; } = "/";
    [Parameter] public string SuccessNavigateHref { get; set; } = "/";
    /// <summary>
    /// Completes the payout for <paramref name="paymentId"/> and returns the paid invoice number (optional query).
    /// </summary>
    [Parameter] public Func<string, Task<string?>>? CompleteCheckoutAsync { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string _paymentId = "";
    private string? _message;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _paymentId = query.TryGetValue("paymentId", out var pid) ? pid.ToString() : "";
        _loading = false;
    }

    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(_paymentId) || CompleteCheckoutAsync is null)
        {
            _message = InvalidParamsMessage;
            return;
        }

        _busy = true;
        try
        {
            var invoiceNumber = await CompleteCheckoutAsync(_paymentId);
            var q = string.IsNullOrWhiteSpace(invoiceNumber)
                ? ""
                : $"?paid={Uri.EscapeDataString(invoiceNumber)}";
            Navigation.NavigateTo($"{SuccessNavigateHref}{q}");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
