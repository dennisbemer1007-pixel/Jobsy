@using Jobsy.Web.Dashboard
@using Jobsy.Web.Models

@* Bento KPI board: equal hero grid + category tabs + optional Top/Flop tables. *@

@if (Metrics.Count > 0)
{
    var hero = MetricDashboardCatalog.HeroMetrics(Metrics, m => m.Key, m => m.Value);
    var groups = MetricDashboardCatalog.GroupPresent(Metrics, m => m.Key);
    var activeId = ResolveActiveCategory(groups);
    var heroKeys = hero.Select(h => h.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var allPairs = Metrics.Select(m => (m.Key, m.Value)).ToList();
    var heroCount = Math.Max(hero.Count, 1);

    @if (groups.Count > 1)
    {
        <div class="dash-cat-tabs" role="tablist" aria-label="KPI-categorieën">
            @foreach (var (category, items) in groups)
            {
                var warn = MetricDashboardCatalog.CategoryHasWarning(items, m => m.Key, m => m.Value);
                <button type="button"
                        class="dash-cat-tab @(activeId == category.Id ? "dash-cat-tab--active" : null) @(warn ? "dash-cat-tab--warn" : null)"
                        role="tab"
                        aria-selected="@(activeId == category.Id)"
                        @onclick="() => SelectCategory(category.Id)">
                    <span class="dash-cat-tab__label">@category.Title</span>
                    @if (warn)
                    {
                        <span class="dash-cat-tab__warn-dot" title="Aandacht vereist" aria-hidden="true"></span>
                    }
                    <span class="dash-cat-tab__count">@items.Count</span>
                </button>
            }
        </div>
    }

    <div class="bento-grid @(ShowVacancyPerformance ? "bento-grid--with-rank" : null)">
        <div class="bento-grid__main">
            @if (hero.Count > 0)
            {
                <div class="bento-hero" style="--bento-hero-cols:@heroCount" aria-label="Kerncijfers">
                    @for (var i = 0; i < hero.Count; i++)
                    {
                        var metric = hero[i];
                        var ring = MetricDashboardCatalog.RatioProgress(metric.Key, metric.Value, allPairs);
                        var isLead = i == 0;
                        <MetricTile Label="@metric.Label"
                                    FormattedValue="@FormatValue(metric)"
                                    Hint="@HintFor(metric, ring)"
                                    Emphasis="true"
                                    Size="@(isLead ? "featured" : "default")"
                                    Warning="@MetricDashboardCatalog.IsWarning(metric.Key, metric.Value)"
                                    Progress="@ProgressFor(metric)"
                                    RingProgress="ring"
                                    RingLabel="@(ring is not null ? ring.Value.ToString("0") + "%" : null)"
                                    Sparkline="@(ring is null ? metric.Sparkline : null)"
                                    Selected="@(SelectedKey == metric.Key)"
                                    OnClick="() => OnMetricClick.InvokeAsync(metric)" />
                    }
                </div>
            }

            @foreach (var (category, items) in groups)
            {
                if (groups.Count > 1 && activeId != category.Id)
                {
                    continue;
                }

                var bodyItems = items
                    .Where(m => !heroKeys.Contains(m.Key))
                    .ToList();

                <section class="bento-cell bento-cell--category" aria-labelledby="dash-cat-@category.Id">
                    <header class="dash-section__header dash-section__header--compact">
                        <div>
                            <h2 id="dash-cat-@category.Id">@category.Title</h2>
                            <p class="dash-section__lead">@category.Lead</p>
                        </div>
                    </header>

                    @if (bodyItems.Count == 0)
                    {
                        <p class="muted bento-empty">Kerncijfers staan bovenaan — wissel van tab voor meer metrics.</p>
                    }
                    else
                    {
                        <div class="bento-metrics">
                            @foreach (var metric in bodyItems)
                            {
                                var ring = MetricDashboardCatalog.RatioProgress(metric.Key, metric.Value, allPairs);
                                <MetricTile Label="@metric.Label"
                                            FormattedValue="@FormatValue(metric)"
                                            Hint="@HintFor(metric, ring)"
                                            Size="compact"
                                            Emphasis="@MetricDashboardCatalog.IsPrimary(metric.Key)"
                                            Warning="@MetricDashboardCatalog.IsWarning(metric.Key, metric.Value)"
                                            Progress="@ProgressFor(metric)"
                                            RingProgress="@(MetricDashboardCatalog.IsPercent(metric.Key) ? ring : null)"
                                            RingLabel="@(MetricDashboardCatalog.IsPercent(metric.Key) && ring is not null ? ring.Value.ToString("0") + "%" : null)"
                                            Sparkline="@metric.Sparkline"
                                            Selected="@(SelectedKey == metric.Key)"
                                            OnClick="() => OnMetricClick.InvokeAsync(metric)" />
                            }
                        </div>
                    }
                </section>
            }
        </div>

        @if (ShowVacancyPerformance)
        {
            <aside class="bento-grid__side">
                <VacancyPerformancePanel Board="VacancyPerformance"
                                         VacancyHrefPrefix="@VacancyHrefPrefix" />
            </aside>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<MetricCount> Metrics { get; set; } = [];
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<MetricCount> OnMetricClick { get; set; }
    [Parameter] public Func<MetricCount, string>? ValueFormatter { get; set; }
    [Parameter] public bool ShowVacancyPerformance { get; set; }
    [Parameter] public VacancyPerformanceBoard? VacancyPerformance { get; set; }
    [Parameter] public string VacancyHrefPrefix { get; set; } = "/vacancies";

    private string? _categoryId;
    private string? _lastSelectedKey;
    private bool _manualCategory;

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastSelectedKey, SelectedKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastSelectedKey = SelectedKey;
        _manualCategory = false;

        if (SelectedKey is null)
        {
            return;
        }

        var groups = MetricDashboardCatalog.GroupPresent(Metrics, m => m.Key);
        _categoryId = MetricDashboardCatalog.CategoryIdFor(SelectedKey, groups, m => m.Key);
    }

    private string ResolveActiveCategory(IReadOnlyList<(MetricDashboardCatalog.Category Category, IReadOnlyList<MetricCount> Metrics)> groups)
    {
        if (groups.Count == 0)
        {
            return "growth";
        }

        if (_manualCategory
            && _categoryId is not null
            && groups.Any(g => g.Category.Id == _categoryId))
        {
            return _categoryId;
        }

        if (SelectedKey is not null)
        {
            var fromSelection = MetricDashboardCatalog.CategoryIdFor(SelectedKey, groups, m => m.Key);
            if (fromSelection is not null && groups.Any(g => g.Category.Id == fromSelection))
            {
                return fromSelection;
            }
        }

        if (_categoryId is not null && groups.Any(g => g.Category.Id == _categoryId))
        {
            return _categoryId;
        }

        return groups[0].Category.Id;
    }

    private void SelectCategory(string id)
    {
        _categoryId = id;
        _manualCategory = true;
    }

    private string FormatValue(MetricCount metric)
        => ValueFormatter?.Invoke(metric) ?? DefaultFormat(metric);

    private static string DefaultFormat(MetricCount metric)
    {
        if (MetricDashboardCatalog.IsPercent(metric.Key))
        {
            return metric.Value.ToString("0.#") + "%";
        }

        if (MetricDashboardCatalog.IsMinutes(metric.Key))
        {
            return metric.Value.ToString("0.#") + " min";
        }

        return metric.Key.StartsWith("tokens_", StringComparison.OrdinalIgnoreCase)
            ? metric.Value.ToString("0.##")
            : metric.Value.ToString("0");
    }

    private static double? ProgressFor(MetricCount metric)
        => MetricDashboardCatalog.IsPercent(metric.Key)
            ? (double)Math.Clamp(metric.Value, 0, 100)
            : null;

    private static string? HintFor(MetricCount metric, double? ring)
    {
        if (metric.Key.Equals("applications_pending", StringComparison.OrdinalIgnoreCase))
        {
            return metric.Value > 0 ? "Nog geen reactie" : "Alles beantwoord";
        }

        if (metric.Key.Equals("tokens_balance", StringComparison.OrdinalIgnoreCase))
        {
            return MetricDashboardCatalog.IsWarning(metric.Key, metric.Value)
                ? "Saldo bijna op"
                : "Beschikbaar saldo";
        }

        if (metric.Key.Equals("avg_travel_minutes", StringComparison.OrdinalIgnoreCase))
        {
            return metric.Value > 0 ? "Hyperlokaal bereik" : "Nog geen matches";
        }

        if (metric.Key.Equals("active_boosts", StringComparison.OrdinalIgnoreCase))
        {
            return "Actieve highlights";
        }

        if (ring is null)
        {
            return null;
        }

        if (metric.Key.Equals("conversion_rate", StringComparison.OrdinalIgnoreCase))
        {
            return "Clicks → sollicitaties";
        }

        if (metric.Key.Equals("top_transport_share", StringComparison.OrdinalIgnoreCase))
        {
            return "Meest gekozen vervoer";
        }

        if (metric.Key.Equals("applications", StringComparison.OrdinalIgnoreCase))
        {
            return $"Conversie {ring.Value:0}%";
        }

        if (metric.Key.Equals("clicks", StringComparison.OrdinalIgnoreCase))
        {
            return $"CTR {ring.Value:0}%";
        }

        if (metric.Key.Equals("tokens_spent", StringComparison.OrdinalIgnoreCase))
        {
            return $"t.o.v. aankoop {ring.Value:0}%";
        }

        if (MetricDashboardCatalog.IsPercent(metric.Key))
        {
            return "Conversie";
        }

        return null;
    }
}
