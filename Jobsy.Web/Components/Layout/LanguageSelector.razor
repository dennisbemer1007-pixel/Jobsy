@using Jobsy.Core.Localization
@using Jobsy.Web.Localization
@inherits CultureAwareComponentBase
@inject NavigationManager Navigation

<div class="language-selector @(_open ? "is-open" : null) @(_forceClosed ? "is-closed" : null)" @onfocusout="OnFocusOut">
    <button type="button"
            class="language-selector__toggle"
            aria-haspopup="listbox"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@Culture["Language.Choose"]"
            title="@Culture["Language.Label"]"
            @onclick="Toggle">
        <img class="language-selector__flag" src="@Culture.Current.FlagImage" alt="" width="18" height="13" />
        <span class="language-selector__code">@Culture.Language.ToUpperInvariant()</span>
        <span class="language-selector__caret" aria-hidden="true">▾</span>
    </button>
        <ul class="language-selector__menu" role="listbox" aria-label="@Culture["Language.Label"]">
            @foreach (var lang in JobsyLanguages.All)
            {
                <li role="option" aria-selected="@(lang.Code == Culture.Language ? "true" : "false")">
                    <a class="language-selector__option @(lang.Code == Culture.Language ? "is-active" : null)"
                       href="@LanguageHref(lang.Code)">
                        <img class="language-selector__flag" src="@lang.FlagImage" alt="" width="18" height="13" />
                        <span class="language-selector__name">@lang.NativeName</span>
                        <span class="language-selector__code">@lang.Code.ToUpperInvariant()</span>
                    </a>
                </li>
            }
        </ul>
</div>

@code {
    private bool _open;
    private bool _forceClosed;

    private void Toggle()
    {
        _open = !_open;
        _forceClosed = !_open;
    }

    private async Task OnFocusOut(FocusEventArgs _)
    {
        await Task.Delay(150);
        _open = false;
        _forceClosed = false;
        await InvokeAsync(StateHasChanged);
    }

    private string LanguageHref(string code)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return "/taal/" + Uri.EscapeDataString(code) + "?returnUrl=" + Uri.EscapeDataString(path);
    }
}
