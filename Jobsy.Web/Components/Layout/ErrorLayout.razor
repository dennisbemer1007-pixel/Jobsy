@inherits LayoutComponentBase
@using Jobsy.Core.Localization
@using Jobsy.Core.Features
@using Jobsy.Web.Features
@using Jobsy.Web.Hosting
@using Jobsy.Web.Localization
@using Jobsy.Core.Authorization
@using Jobsy.Web.Navigation
@inject CultureState Culture
@inject IErrorChromeProvider ChromeProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject IEmployersSwitch EmployersSwitch
@*
  Static SSR shell for 404 / 500 and the later status pages.
  Hard rule: no API or DB call, no interactive render mode, no component that needs either.
  Chrome matches the public shell (pub-header / pub-footer) using request-only data.
*@

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    @* Pages add their own head tags here; a second HeadContent would replace the noindex above. *@
    <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="@ErrorHeadSection" />
    @if (_signedInCandidate)
    {
        <link rel="stylesheet" href="css/app.min.css?v=20261021-14" />
        <link rel="stylesheet" href="css/features/candidate-no-blazor-chrome.css?v=20261025-kreeft-nav5" />
    }
</HeadContent>

@if (_signedInCandidate)
{
    <div class="app-shell app-shell--candidate app-shell--error-ssr" dir="@(_chrome.IsRightToLeft ? "rtl" : null)" lang="@_chrome.Language">
        <AppShellHeader HomeHref="@FeatureRoutes.CandidateProfilePath"
                        HeaderTagline="@Culture["Brand.Tagline"]"
                        ShowCandidatePwaInstall="false" />
        <main id="main" class="app-main err-main">
            @Body
        </main>
    </div>
}
else
{
<div class="err-layout pub-theme" dir="@(_chrome.IsRightToLeft ? "rtl" : null)" lang="@_chrome.Language">
    <a class="pub-skip err-skip" href="#main">@Culture["Status.Nav.SkipToContent"]</a>
    <header class="pub-header">
        <div class="pub-header__inner">
            <a class="pub-header__brand" href="@_chrome.HomeHref" aria-label="@Culture["Status.Nav.Home"]">
                <LobsyLogo Class="pub-header__logo" Alt="Lobsy" Animate="false" Variant="LobsyLogoVariant.Horizontal" />
                <span class="pub-header__name">Lobsy</span>
            </a>

            <nav class="pub-nav" aria-label="@Culture["PublicNav.MainNav"]">
                @foreach (var item in PublicNavCatalog.Header(_variant).Where(i => i.IsAvailable))
                {
                    <a class="pub-nav__link" href="@item.Href">@Culture[item.LabelKey]</a>
                }
            </nav>

            <div class="pub-header__actions">
                <PublicLangMenu ReturnPath="@_chrome.ReturnPath" />
                @if (_chrome.IsSignedIn && _showHeaderStart)
                {
                    <a class="pub-btn pub-btn--ghost" href="@_chrome.MyStartHref">@Culture["Status.Nav.MyStart"]</a>
                }
                else if (!_chrome.IsSignedIn)
                {
                    <a class="pub-btn pub-btn--ghost" href="@_chrome.LoginHref">@Culture["Status.Nav.Login"]</a>
                    <a class="pub-btn pub-btn--primary pub-header__cta" href="@PublicRoutes.Test">@Culture["PublicNav.TakeFreeTest"]</a>
                }
            </div>

            <div class="pub-header__mobile">
                @if (_chrome.IsSignedIn && _showHeaderStart)
                {
                    <a class="pub-btn pub-btn--ghost" href="@_chrome.MyStartHref">@Culture["Status.Nav.MyStart"]</a>
                }
                else if (!_chrome.IsSignedIn)
                {
                    <a class="pub-btn pub-btn--ghost" href="@_chrome.LoginHref">@Culture["Status.Nav.Login"]</a>
                }
                <details class="pub-menu" id="pub-menu">
                    <summary class="pub-menu__toggle" aria-label="@Culture["PublicNav.Menu"]">
                        <span class="pub-menu__icon" aria-hidden="true"></span>
                    </summary>
                    <div class="pub-menu__panel">
                        <nav class="pub-menu__nav" aria-label="@Culture["PublicNav.MainNav"]">
                            @foreach (var item in PublicNavCatalog.Header(_variant).Where(i => i.IsAvailable))
                            {
                                <a class="pub-menu__link" href="@item.Href">@Culture[item.LabelKey]</a>
                            }
                        </nav>
                        <PublicLangMenu ReturnPath="@_chrome.ReturnPath" />
                        @if (!_chrome.IsSignedIn)
                        {
                            <a class="pub-btn pub-btn--primary pub-menu__cta" href="@PublicRoutes.Test">@Culture["PublicNav.TakeFreeTest"]</a>
                        }
                    </div>
                </details>
            </div>
        </div>
    </header>

    <main id="main" class="pub-main err-main">
        @Body
    </main>

    <footer class="pub-footer">
        <div class="pub-footer__inner">
            <div class="pub-footer__brand">
                <a class="pub-footer__logo-link" href="@_chrome.HomeHref" aria-label="Lobsy">
                    <LobsyLogo Class="pub-footer__logo" Alt="Lobsy" Animate="false" Variant="LobsyLogoVariant.Horizontal" />
                    <span class="pub-footer__name">Lobsy</span>
                </a>
                <p class="pub-footer__tagline">@Culture["PublicFooter.BrandLine"]</p>
            </div>

            @foreach (var column in PublicNavCatalog.Footer(_variant))
            {
                <div class="pub-footer__col">
                    <h2 class="pub-footer__heading">@Culture[column.TitleKey]</h2>
                    <ul class="pub-footer__list">
                        @foreach (var item in column.Items.Where(i => i.IsAvailable))
                        {
                            <li>
                                <a class="pub-footer__link" href="@item.Href">@Culture[item.LabelKey]</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="pub-footer__bottom">
            <p class="pub-footer__copy">@Culture.Format("PublicFooter.Copyright", _chrome.Year, Culture["PublicFooter.MadeWith"])</p>
            <p class="pub-footer__lang-name">@Culture.Current.NativeName</p>
        </div>
    </footer>
</div>
}

@code {
    /// <summary>Section an error page adds extra <c>&lt;head&gt;</c> tags to (errors 04).</summary>
    public const string ErrorHeadSection = "error-head";

    private ErrorChrome _chrome = default!;
    private bool _showHeaderStart = true;
    private bool _signedInCandidate;
    private LandingVariant _variant = LandingVariant.On;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        var path = http?.Request.Path.Value ?? "";
        var user = http?.User;
        _signedInCandidate = user?.Identity?.IsAuthenticated == true
            && RoleClaimMatching.HasRole(user, JobsyRoles.Candidate);
        _showHeaderStart = !path.StartsWith("/access-denied", StringComparison.OrdinalIgnoreCase)
                           && !path.StartsWith("/status/403", StringComparison.OrdinalIgnoreCase);
        _chrome = ChromeProvider.Build(http);
        _variant = await EmployersSwitch.VariantAsync();
        Culture.InitializeFromLanguage(_chrome.Language);
        ErrorResponse.ApplyHeaders(http);
    }

}
