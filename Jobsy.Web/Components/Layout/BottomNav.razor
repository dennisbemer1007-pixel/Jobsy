@using Jobsy.Core.Authorization
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject CultureState Culture
@inject RoleNavItemsState NavItems
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (_items.Count > 0 && !_hideForDesktopViewport)
{
    <nav class="bottom-nav" aria-label="@Culture["Nav.Main"]" @ref="_nav">
        @foreach (var item in _items)
        {
            var title = Culture[item.TitleKey];
            var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
                ? Culture[item.ShortTitleKey!]
                : title;
            var active = RoleNavCatalog.IsActive(item, Navigation.ToBaseRelativePath(Navigation.Uri), _items);
            <a class="bottom-nav__item @(active ? "is-active" : null) @(item.DesktopOnly ? "bottom-nav__item--desktop-only" : null)"
               href="@item.Href"
               data-enhance-nav="false"
               title="@title"
               data-desktop-only="@(item.DesktopOnly ? "true" : null)"
               data-testid="@(string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase) ? "nav-maqqie-uren" : null)"
               aria-current="@(active ? "page" : null)">
                <span class="bottom-nav__icon" aria-hidden="true">
                    @((MarkupString)item.Svg)
                </span>
                <span class="bottom-nav__label bottom-nav__label--full">@title</span>
                <span class="bottom-nav__label bottom-nav__label--short">@shortTitle</span>
            </a>
        }
    </nav>
}

@code {
    private IReadOnlyList<NavItem> _items = RoleNavCatalog.Anonymous;
    private ElementReference _nav;
    /// <summary>≥1024px: header nav only; bottom bar is mobile/PWA.</summary>
    private bool _hideForDesktopViewport;
    private DotNetObjectReference<BottomNav>? _dotNetRef;
    private IJSObjectReference? _viewportWatch;

    [Parameter]
    public EventCallback<bool> HasItemsChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await NavItems.EnsureInitializedAsync();
        _items = NavItems.Items;
        NavItems.Changed += OnNavItemsChanged;
    }

    private async void OnNavItemsChanged()
    {
        _items = NavItems.Items;
        await NotifyHasBottomNavAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshDesktopViewportAsync();
        }

        try
        {
            if (_items.Count > 0 && !_hideForDesktopViewport)
            {
                await Js.InvokeVoidAsync("jobsyCoachDock.bind", _nav, "--bottom-nav-h");
            }
            else
            {
                await Js.InvokeVoidAsync("jobsyCoachDock.clear", "--bottom-nav-h");
            }
        }
        catch
        {
            // bUnit / prerender
        }
    }

    private async Task RefreshDesktopViewportAsync()
    {
        try
        {
            _hideForDesktopViewport = await Js.InvokeAsync<bool>("jobsyViewport.isKompasWide");
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _viewportWatch ??= await Js.InvokeAsync<IJSObjectReference>(
                "jobsyViewport.watchKompasWide", _dotNetRef, nameof(SetDesktopViewportHidden));
            await NotifyHasBottomNavAsync();
        }
        catch
        {
            _hideForDesktopViewport = false;
        }
    }

    [JSInvokable]
    public async Task SetDesktopViewportHidden(bool isWide)
    {
        if (_hideForDesktopViewport == isWide)
        {
            return;
        }

        _hideForDesktopViewport = isWide;
        await NotifyHasBottomNavAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task NotifyHasBottomNavAsync()
        => HasItemsChanged.InvokeAsync(_items.Count > 0 && !_hideForDesktopViewport);

    public async ValueTask DisposeAsync()
    {
        NavItems.Changed -= OnNavItemsChanged;
        try
        {
            if (_viewportWatch is not null)
            {
                await _viewportWatch.InvokeVoidAsync("dispose");
                await _viewportWatch.DisposeAsync();
            }
        }
        catch
        {
            // Best-effort unsubscribe.
        }

        _viewportWatch = null;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
