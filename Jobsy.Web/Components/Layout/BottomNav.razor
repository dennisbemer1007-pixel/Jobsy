@using Jobsy.Core.Authorization
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject CultureState Culture
@inject JobsyApiClient Api
@inject BottomNavRefreshService NavRefresh
@inject AssistantChatHost ChatHost
@implements IDisposable

@if (_entries.Count > 0)
{
    <nav class="bottom-nav" aria-label="@Culture["Nav.Main"]">
        @foreach (var entry in _entries)
        {
            if (entry.IsAssistant)
            {
                <button type="button"
                        class="bottom-nav__item bottom-nav__item--assistant @(_assistantOpen ? "is-open" : null)"
                        title="@Culture["Assistant.Open"]"
                        aria-label="@Culture["Assistant.Open"]"
                        aria-expanded="@(_assistantOpen ? "true" : "false")"
                        @onclick="OpenAssistant">
                    <span class="bottom-nav__icon" aria-hidden="true">
                        @((MarkupString)NavIcons.Assistant)
                    </span>
                    <span class="bottom-nav__label">@Culture["Nav.Assistant"]</span>
                </button>
            }
            else if (entry.Item is { } item)
            {
                var title = Culture[item.TitleKey];
                var active = RoleNavCatalog.IsActive(item, Navigation.ToBaseRelativePath(Navigation.Uri), _items);
                <a class="bottom-nav__item @(active ? "is-active" : null) @(item.DesktopOnly ? "bottom-nav__item--desktop-only" : null)"
                   href="@item.Href"
                   title="@title"
                   data-desktop-only="@(item.DesktopOnly ? "true" : null)"
                   aria-current="@(active ? "page" : null)">
                    <span class="bottom-nav__icon" aria-hidden="true">
                        @((MarkupString)item.Svg)
                    </span>
                    <span class="bottom-nav__label">@title</span>
                </a>
            }
        }
    </nav>
}

@code {
    private sealed record BottomNavEntry(NavItem? Item, bool IsAssistant);

    private IReadOnlyList<NavItem> _items = RoleNavCatalog.Anonymous;
    private List<BottomNavEntry> _entries = [];
    private bool _hasTakeoverActions;
    private bool _salesOnboardingComplete;
    private bool _ambassadeurOnboardingComplete;
    private bool _csvImportEnabled;
    private bool _roleFlagsLoaded;
    private bool _showAssistant;
    private bool _assistantOpen;
    private string? _lastRoleFingerprint;

    [Parameter]
    public EventCallback<bool> HasItemsChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Culture.Changed += OnCultureChanged;
        NavRefresh.RefreshRequested += OnNavRefreshRequestedAsync;
        ChatHost.Changed += OnAssistantChanged;
        _assistantOpen = ChatHost.IsOpen;
        await RefreshItemsAsync(forceRoleApis: true);
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void OnAssistantChanged()
        => _ = InvokeAsync(() =>
        {
            _assistantOpen = ChatHost.IsOpen;
            StateHasChanged();
        });

    private void OpenAssistant()
        => ChatHost.RequestToggle();

    private async Task OnNavRefreshRequestedAsync()
    {
        await RefreshItemsAsync(forceRoleApis: true);
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Active styling is URI-based; avoid re-hitting takeover/sales APIs on every nav.
        await RefreshItemsAsync(forceRoleApis: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshItemsAsync(bool forceRoleApis)
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var fingerprint = string.Join(',', state.User.Claims
            .Where(c => c.Type is System.Security.Claims.ClaimTypes.Role or "role")
            .Select(c => c.Value)
            .OrderBy(v => v, StringComparer.Ordinal));
        var catalog = RoleNavCatalog.ForUser(state.User);

        var rolesChanged = !string.Equals(_lastRoleFingerprint, fingerprint, StringComparison.Ordinal);
        _lastRoleFingerprint = fingerprint;

        if (RoleClaimMatching.HasRole(state.User, JobsyRoles.BranchManager)
            && !RoleClaimMatching.HasRole(state.User, JobsyRoles.Admin)
            && !RoleClaimMatching.HasRole(state.User, JobsyRoles.EnterpriseManager)
            && !RoleClaimMatching.HasRole(state.User, JobsyRoles.RegionalManager))
        {
            if (forceRoleApis || rolesChanged || !_roleFlagsLoaded)
            {
                await RefreshTakeoverFlagAsync();
            }

            if (!_hasTakeoverActions)
            {
                catalog = catalog
                    .Where(i => !string.Equals(i.Href, RoleNavCatalog.Takeovers.Href, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }

        if (RoleClaimMatching.HasRole(state.User, JobsyRoles.SalesManager)
            && !RoleClaimMatching.HasRole(state.User, JobsyRoles.Admin))
        {
            if (forceRoleApis || rolesChanged || !_roleFlagsLoaded)
            {
                await RefreshSalesOnboardingFlagAsync();
            }

            if (_salesOnboardingComplete)
            {
                catalog = catalog
                    .Where(i => !string.Equals(i.Href, "/salesmanager/onboarding", StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }

        if (RoleClaimMatching.HasRole(state.User, JobsyRoles.Ambassadeur)
            && !RoleClaimMatching.HasRole(state.User, JobsyRoles.Admin))
        {
            if (forceRoleApis || rolesChanged || !_roleFlagsLoaded)
            {
                await RefreshAmbassadeurOnboardingFlagAsync();
            }

            if (_ambassadeurOnboardingComplete)
            {
                catalog = catalog
                    .Where(i => !string.Equals(i.Href, "/ambassadeur/onboarding", StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }

        // CSV import is no longer a bottom-nav item (Enterprise uses Organization hub).
        // Defensive filter if a catalog still exposes the route and the company has CSV disabled.
        if (catalog.Any(i => string.Equals(i.Href, RoleNavCatalog.CsvImport.Href, StringComparison.OrdinalIgnoreCase)))
        {
            if (forceRoleApis || rolesChanged || !_roleFlagsLoaded)
            {
                await RefreshCsvImportFlagAsync();
            }

            if (!_csvImportEnabled)
            {
                catalog = catalog
                    .Where(i => !string.Equals(i.Href, RoleNavCatalog.CsvImport.Href, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }

        _roleFlagsLoaded = true;
        _showAssistant = AssistantChatHost.IsAvailableFor(state.User);

        var previousCount = _items.Count;
        _items = catalog;
        RebuildEntries();
        if (previousCount != _items.Count || HasItemsChanged.HasDelegate)
        {
            await HasItemsChanged.InvokeAsync(_items.Count > 0);
        }
    }

    private void RebuildEntries()
    {
        var entries = _items.Select(i => new BottomNavEntry(i, false)).ToList();
        if (_showAssistant && _items.Count > 0)
        {
            entries.Insert(_items.Count / 2, new BottomNavEntry(null, true));
        }

        _entries = entries;
    }

    private async Task RefreshTakeoverFlagAsync()
    {
        try
        {
            var inbox = await Api.GetTakeoverInboxAsync();
            _hasTakeoverActions = inbox.Count > 0;
        }
        catch
        {
            _hasTakeoverActions = false;
        }
    }

    private async Task RefreshSalesOnboardingFlagAsync()
    {
        try
        {
            var dash = await Api.GetMySalesManagerDashboardAsync();
            _salesOnboardingComplete = dash?.IsOnboardingComplete == true;
        }
        catch
        {
            _salesOnboardingComplete = false;
        }
    }

    private async Task RefreshAmbassadeurOnboardingFlagAsync()
    {
        try
        {
            var dash = await Api.GetMyAmbassadeurDashboardAsync();
            _ambassadeurOnboardingComplete = dash?.IsOnboardingComplete == true;
        }
        catch
        {
            _ambassadeurOnboardingComplete = false;
        }
    }

    private async Task RefreshCsvImportFlagAsync()
    {
        try
        {
            var companies = await Api.GetMyCompaniesAsync();
            _csvImportEnabled = companies.Any(c => c.CsvBatchImportEnabled);
        }
        catch
        {
            _csvImportEnabled = false;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Culture.Changed -= OnCultureChanged;
        NavRefresh.RefreshRequested -= OnNavRefreshRequestedAsync;
        ChatHost.Changed -= OnAssistantChanged;
    }
}
