@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject CultureState Culture
@inject RoleNavItemsState NavItems
@inject IHttpContextAccessor HttpContextAccessor

@if (_items.Count > 0)
{
    <nav class="bottom-nav" aria-label="@Culture["Nav.Main"]" data-testid="candidate-bottom-nav">
        @foreach (var item in _items)
        {
            var title = Culture[item.TitleKey];
            var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
                ? Culture[item.ShortTitleKey!]
                : title;
            var active = RoleNavCatalog.IsActive(item, _relativePath, _items);
            <CandidateNavLink Class="@($"bottom-nav__item {(active ? "is-active" : null)} {(item.DesktopOnly ? "bottom-nav__item--desktop-only" : null)}")"
                              Href="@item.Href"
                              Title="@title"
                              DesktopOnly="@(item.DesktopOnly ? "true" : null)"
                              TestId="@(string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase) ? "nav-maqqie-uren" : null)"
                              AriaCurrent="@(active ? "page" : null)">
                <span class="bottom-nav__icon" aria-hidden="true">
                    @((MarkupString)item.Svg)
                </span>
                <span class="bottom-nav__label bottom-nav__label--full">@title</span>
                <span class="bottom-nav__label bottom-nav__label--short">@shortTitle</span>
            </CandidateNavLink>
        }
    </nav>
}

@code {
    private IReadOnlyList<NavItem> _items = RoleNavCatalog.Anonymous;
    private string _relativePath = "";

    [Parameter]
    public EventCallback<bool> HasItemsChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _relativePath = ResolveRelativePath();
        await NavItems.EnsureInitializedAsync();
        _items = NavItems.Items;

        if (HasItemsChanged.HasDelegate)
        {
            await HasItemsChanged.InvokeAsync(_items.Count > 0);
        }
    }

    private string ResolveRelativePath()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request is null)
        {
            return "";
        }

        var path = request.Path.Value ?? "/";
        return path.TrimStart('/');
    }
}
