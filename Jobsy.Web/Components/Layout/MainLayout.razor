@inherits LayoutComponentBase
@using Jobsy.Core.Authorization
@using Jobsy.Core.Features
@using Jobsy.Web.Auth
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Pwa
@using Jobsy.Web.Seo
@using Microsoft.AspNetCore.Components.Authorization
@inject CultureState Culture
@inject PwaInstallSheetState PwaSheet
@inject JobsyApiClient Api
@inject Jobsy.Web.RegionHosting.RegionHostState RegionHost
@inject Jobsy.Web.Branding.PlatformBrandingState Branding
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject Jobsy.Web.Services.ApiCallTracker ApiCalls
@inject AuthenticationStateProvider AuthState
@inject IFeatureFlags FeatureFlags
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<div class="app-shell @(_hasBottomNav ? "has-bottom-nav" : null) @(_isCandidate ? "app-shell--candidate" : null) @(_isMatchPage ? "app-shell--match" : null) @(_isQuestionnairePage ? "app-shell--questionnaire" : null) @(_banenkaartCandidateShell ? "app-shell--banenkaart-shell" : null) @(_pwaSheetOpen ? "pwa-sheet-open" : null)"
     dir="@(Culture.IsRightToLeft ? "rtl" : null)">
    <PageSeoHead />
    <PageRouteStylesHead />
    <Jobsy.Web.Components.Errors.MaintenanceAdminBanner />
    @if (!_isMatchPage && !_isQuestionnairePage && !_banenkaartMockupTopBar)
    {
        <AppShellHeader HomeHref="@_homeHref"
                        HeaderTagline="@HeaderTagline"
                        ShowCandidatePwaInstall="@(_isCandidate && RendererInfo.IsInteractive && !_suppressPwaInstallEntry)" />
    }

    <main class="app-main">
        <div class="app-main__content">
            @if (ShowInstallBanner)
            {
                <PwaInstallBanner />
            }
            <CircuitErrorBoundary BoundaryTag="main">
                @if (RendererInfo.IsInteractive)
                {
                    <Jobsy.Web.Components.Employer.CompanyVerificationBanner />
                    <AuthorizeView Roles="@JobsyRoles.Candidate">
                        <Authorized>
                            <Jobsy.Web.Components.Candidate.KandidatenkaartReAvailabilityBanner />
                        </Authorized>
                    </AuthorizeView>
                }
                @Body
            </CircuitErrorBoundary>
        </div>
        @if (!_isMatchPage && !_isQuestionnairePage && !_banenkaartImmersive)
        {
            <AppFooter />
        }
    </main>

    @if (!_isQuestionnairePage && !_isOnboardingWizardFocus && !_banenkaartImmersive)
    {
        @if (_noBlazorCandidateNav)
        {
            <NoBlazorCandidateNav RenderPart="NoBlazorCandidateNav.Part.Bottom" />
        }
        else
        {
            <BottomNav HasItemsChanged="OnBottomNavItemsChanged" />
        }
    }
    @if (RendererInfo.IsInteractive && !_isMatchPage && !_banenkaartImmersive && _isCandidate && !_hideCoachDock && !_hideFloatingChrome)
    {
        <LobsyCoach Compact="_isQuestionnairePage" HasBottomNav="_hasBottomNav" AskLabel="@Culture["Coach.Ask"]" CloseLabel="@Culture["Coach.CloseTip"]" />
        <LobsyAssistantChat HideEdgeTab="true" HasBottomNav="_hasBottomNav" UiVariant="AssistantChatUiVariant.Warm" />
        <FeedbackWidget HideEdgeTab="true" HasBottomNav="_hasBottomNav" />
    }
    else if (_noBlazorRuntime && _ssrCoachAvailable && !_isMatchPage && !_banenkaartImmersive && _isCandidate && !_hideCoachDock && !_hideFloatingChrome)
    {
        <LobsyCoachSsr HasBottomNav="_hasBottomNav" AskLabel="@Culture["Coach.Ask"]" />
    }
    else if (RendererInfo.IsInteractive && !_isMatchPage && !_banenkaartImmersive && !_isQuestionnairePage && !_hideFloatingChrome)
    {
        <LobsyAssistantChat HideEdgeTab="true" HasBottomNav="_hasBottomNav" />
        <FeedbackWidget HideEdgeTab="true" HasBottomNav="_hasBottomNav" />
    }
    @if (RendererInfo.IsInteractive && !_isMatchPage && !_banenkaartImmersive && !_isQuestionnairePage)
    {
        <GratisDnaMerge />
        <PushPermissionBanner />
        @if (_isCandidate && !_suppressPwaInstallEntry)
        {
            <Jobsy.Web.Components.Candidate.Pwa.CandidatePwaInstalledShareHint />
        }
        <ConsentReacceptDialog />
    }
    else if (RendererInfo.IsInteractive)
    {
        <ConsentReacceptDialog />
    }
    <CookieConsentBanner OnConsentChanged="OnCookieConsentChanged" />
    @if (RendererInfo.IsInteractive && _isCandidate && !_suppressPwaInstallEntry)
    {
        <Jobsy.Web.Components.Candidate.Pwa.CandidatePwaInstallSheet />
    }
    <SessionIdleGuard />
</div>

@code {
    private bool _siteVisitRecorded;
    private bool _hasBottomNav;
    private bool _isMatchPage;
    /// <summary>Public job map: hide app chrome for guests; logged-in candidates keep the normal shell.</summary>
    private bool _banenkaartImmersive;
    /// <summary>Logged-in candidate on banenkaart: app header + bottom nav; suppress duplicate discovery chrome header.</summary>
    private bool _banenkaartCandidateShell;
    /// <summary>Lagen mockup supplies its own <c>.top</c> bar; hide the app shell header on /banenkaart.</summary>
    private bool _banenkaartMockupTopBar;
    private bool _isQuestionnairePage;
    private bool _isOnboardingWizardFocus;
    private bool _hideCoachDock;
    private bool _hideFloatingChrome;
    private bool _isCandidate;
    private bool _suppressInstallBanner;
    private bool _suppressPwaInstallEntry;
    private bool _pwaSheetOpen;
    private bool _noBlazorRuntime;
    private bool _noBlazorCandidateNav;
    private bool _ssrCoachAvailable;

    private bool ShowInstallBanner =>
        RendererInfo.IsInteractive
        && !_isCandidate
        && !_isMatchPage
        && !_banenkaartImmersive
        && !_isQuestionnairePage
        && !_suppressInstallBanner;
    private string _homeHref = "/";

    protected override void OnInitialized()
    {
        if (CultureRequest.HasExplicitChoice(HttpContextAccessor.HttpContext))
        {
            Culture.InitializeFromRequest(HttpContextAccessor.HttpContext);
        }

        BootstrapCandidateFromHttpContext();
        RefreshFocusedFlags();

        PwaSheet.Changed += OnPwaSheetChanged;
        _pwaSheetOpen = PwaSheet.IsOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        RegionHost.Changed += OnBrandingChanged;
        Branding.Changed += OnBrandingChanged;
        Navigation.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        RefreshFocusedFlags();
        await Culture.InitializeAsync();
        await Culture.SyncDocumentAsync();
        await RefreshHomeHrefAsync();
        // Do not block first paint (or /home dashboards) on region/slogan HTTP.
        _ = HydrateHostBrandingAsync();
    }

    private async Task RefreshHomeHrefAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            var wasCandidate = _isCandidate;
            _isCandidate = user.Identity?.IsAuthenticated == true
                && RoleClaimMatching.HasRole(user, JobsyRoles.Candidate);
            var immersiveChanged = SyncBanenkaartImmersive();
            if (!_isCandidate && IsOuderGuestShellPath(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]))
            {
                _isCandidate = true;
                _homeHref = "/";
                _hasBottomNav = true;
                if (wasCandidate != _isCandidate || immersiveChanged)
                {
                    await InvokeAsync(StateHasChanged);
                }

                return;
            }

            if (!_isCandidate)
            {
                _homeHref = "/";
                if (wasCandidate != _isCandidate || immersiveChanged)
                {
                    await InvokeAsync(StateHasChanged);
                }

                return;
            }

            var flags = await FeatureFlags.GetAsync();
            if (!flags.CandidatePassportEnabled)
            {
                // Flag OFF: logo stays on "/" (LandingRedirectMiddleware → banenkaart).
                _homeHref = "/";
                SyncBanenkaartImmersive();
                if (wasCandidate != _isCandidate || immersiveChanged)
                {
                    await InvokeAsync(StateHasChanged);
                }

                return;
            }

            _homeHref = FeatureRoutes.HomeFor(
                user,
                flags,
                passportReady: AuthRedirects.PassportReadyFromClaims(user));
            if (wasCandidate != _isCandidate || immersiveChanged)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _homeHref = "/";
        }
    }

    private async Task HydrateHostBrandingAsync()
    {
        try
        {
            await Task.WhenAll(
                RegionHost.EnsureInitializedAsync(),
                Branding.EnsureInitializedAsync());
        }
        catch
        {
            // Header falls back to the default tagline.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            TryApplyRouteDocumentTitle(Navigation.Uri);
        }

        if (RendererInfo.IsInteractive)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyCoachDock.syncStickyFooters");
            }
            catch
            {
                // CSS fallbacks keep the coach tab usable when JS is blocked.
            }
        }

        if (_siteVisitRecorded)
        {
            return;
        }

        try
        {
            if (!await CookieConsentBanner.AllowsAnalyticsAsync(Js))
            {
                // Wait until the user accepts analytics (banner choice).
                return;
            }

            _siteVisitRecorded = true;
            var path = new Uri(Navigation.Uri).AbsolutePath;
            await Api.RecordSiteVisitOnceAsync(Js, path);
        }
        catch
        {
            // Analytics must not block the app shell.
            _siteVisitRecorded = true;
        }
    }

    private Task OnCookieConsentChanged()
        => InvokeAsync(StateHasChanged);

    private Task OnBottomNavItemsChanged(bool hasItems)
    {
        if (_isQuestionnairePage || _isOnboardingWizardFocus)
        {
            if (_hasBottomNav)
            {
                _hasBottomNav = false;
                return InvokeAsync(StateHasChanged);
            }

            return Task.CompletedTask;
        }

        if (_hasBottomNav == hasItems)
        {
            return Task.CompletedTask;
        }

        _hasBottomNav = hasItems;
        return InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            var path = new Uri(e.Location).AbsolutePath;
            ApiCalls.SetPath(path);
        }
        catch
        {
            // ignore malformed locations
        }

        var changed = RefreshFocusedFlags();
        if (changed)
        {
            _ = InvokeAsync(StateHasChanged);
        }

        TryApplyRouteDocumentTitle(e.Location);
        _ = RefreshCandidateRoleAsync();
    }

    private void TryApplyRouteDocumentTitle(string location)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            var path = PageSeoCatalog.Normalize(new Uri(location).AbsolutePath);
            var entry = PageSeoCatalog.Resolve(path);
            var title = PageSeoResolver.WithBrand(Culture[entry.TitleKey]);
            _ = Js.InvokeVoidAsync("lobsyCandidateNav.applyDocumentTitle", title);
        }
        catch
        {
            // Disconnected circuit / prerender
        }
    }

    private async Task RefreshCandidateRoleAsync()
    {
        var previous = _isCandidate;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            _isCandidate = user.Identity?.IsAuthenticated == true
                && RoleClaimMatching.HasRole(user, JobsyRoles.Candidate);
        }
        catch
        {
            _isCandidate = false;
        }

        SyncBanenkaartImmersive();
        if (previous != _isCandidate)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BootstrapCandidateFromHttpContext()
    {
        var http = HttpContextAccessor.HttpContext;
        var user = http?.User;
        _noBlazorRuntime = http?.GetEndpoint()?.Metadata.GetMetadata<NoBlazorRuntimeAttribute>() is not null;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _noBlazorCandidateNav = false;
            _ssrCoachAvailable = false;
            return;
        }

        if (!RoleClaimMatching.HasRole(user, JobsyRoles.Candidate))
        {
            _noBlazorCandidateNav = false;
            _ssrCoachAvailable = _noBlazorRuntime && AssistantChatHost.IsAvailableFor(user);
            return;
        }

        _isCandidate = true;
        _ssrCoachAvailable = _noBlazorRuntime && AssistantChatHost.IsAvailableFor(user);
        _noBlazorCandidateNav = _noBlazorRuntime;
        if (_noBlazorCandidateNav && !_isQuestionnairePage && !_isOnboardingWizardFocus && !_banenkaartImmersive)
        {
            _hasBottomNav = true;
        }

        SyncBanenkaartImmersive();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        try
        {
            _ = await authStateTask;
            await RefreshHomeHrefAsync();
        }
        catch
        {
            // async void: swallow dispose/auth races.
        }
    }

    private bool RefreshFocusedFlags()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relative.Split('?', '#')[0].TrimStart('/');
        var match = path.Equals("candidate/match", StringComparison.OrdinalIgnoreCase);
        var banenkaart = IsBanenkaartPath(path);
        var questionnaire = IsQuestionnairePath(path, relative);
        var onboardingWizard = IsOnboardingWizardFocusPath(path);
        var suppressInstall = SuppressesInstallBanner(path);
        var suppressPwaEntry = SuppressesPwaInstallEntry(path);
        var changed = false;
        if (_isMatchPage != match)
        {
            _isMatchPage = match;
            changed = true;
        }

        if (SyncBanenkaartImmersive(banenkaart))
        {
            changed = true;
        }

        if (_suppressInstallBanner != suppressInstall)
        {
            _suppressInstallBanner = suppressInstall;
            changed = true;
        }

        if (_suppressPwaInstallEntry != suppressPwaEntry)
        {
            _suppressPwaInstallEntry = suppressPwaEntry;
            changed = true;
        }

        if (_isQuestionnairePage != questionnaire)
        {
            _isQuestionnairePage = questionnaire;
            if (questionnaire)
            {
                _hasBottomNav = false;
            }

            changed = true;
        }

        if (_isOnboardingWizardFocus != onboardingWizard)
        {
            _isOnboardingWizardFocus = onboardingWizard;
            if (onboardingWizard)
            {
                _hasBottomNav = false;
            }

            changed = true;
        }

        var hidePassportChrome = IsPassportOrProfileCoachHidden(path);
        var hideCoach = IsLobsyCoachExcludedPath(path)
                        || IsVacancyOrNotificationsCoachHidden(path);
        if (_hideCoachDock != hideCoach)
        {
            _hideCoachDock = hideCoach;
            changed = true;
        }

        var hideFloatingChrome = hidePassportChrome
                                 || IsVacancyOrNotificationsCoachHidden(path);
        if (_hideFloatingChrome != hideFloatingChrome)
        {
            _hideFloatingChrome = hideFloatingChrome;
            changed = true;
        }

        return changed;
    }

    private bool SyncBanenkaartImmersive(bool? onBanenkaartRoute = null)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relative.Split('?', '#')[0].TrimStart('/');
        var onRoute = onBanenkaartRoute ?? IsBanenkaartPath(path);
        var bedrijvenSsr = IsBedrijvenkaartSsrPath(path);
        var immersive = onRoute && !_isCandidate && !bedrijvenSsr;
        var candidateShell = onRoute;
        var mockupTop = onRoute && !_isCandidate && !bedrijvenSsr;
        var changed = false;
        if (_banenkaartImmersive != immersive)
        {
            _banenkaartImmersive = immersive;
            changed = true;
        }

        if (_banenkaartCandidateShell != candidateShell)
        {
            _banenkaartCandidateShell = candidateShell;
            changed = true;
        }

        if (_banenkaartMockupTopBar != mockupTop)
        {
            _banenkaartMockupTopBar = mockupTop;
            changed = true;
        }

        return changed;
    }

    public static bool IsOuderGuestShellPath(string path)
        => path.TrimStart('/').Equals("ouder", StringComparison.OrdinalIgnoreCase);

    public static bool IsBanenkaartPath(string path)
    {
        path = path.TrimStart('/');
        return path.Equals("banenkaart", StringComparison.OrdinalIgnoreCase)
               || path.Equals("banen", StringComparison.OrdinalIgnoreCase)
               || path.Equals("bedrijvenkaart", StringComparison.OrdinalIgnoreCase)
               || path.Equals("bedrijvenkaart/ssr", StringComparison.OrdinalIgnoreCase)
               || IsCompanyKvkPath(path);
    }

    private static bool IsBedrijvenkaartSsrPath(string path)
        => path.TrimStart('/').Equals("bedrijvenkaart/ssr", StringComparison.OrdinalIgnoreCase);

    private static bool IsCompanyKvkPath(string path)
    {
        var segment = path.Split('/')[0];
        return segment.Length == 8 && segment.All(char.IsDigit);
    }

    /// <summary>True when the job map should render without app header / bottom nav (anonymous visitors).</summary>
    public static bool UsesBanenkaartImmersiveChrome(string path, bool isAuthenticatedCandidate)
        => IsBanenkaartPath(path) && !isAuthenticatedCandidate;

    /// <summary>Hide floating chrome on profile (paspoort keeps Lobsy-hulp).</summary>
    public static bool IsPassportOrProfileCoachHidden(string path)
    {
        path = path.TrimStart('/');
        return path.Equals("candidate/profile", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Hide floating coach on vacancy detail and notifications (inline tips / list UI only).</summary>
    public static bool IsVacancyOrNotificationsCoachHidden(string path)
    {
        path = path.TrimStart('/');
        if (path.Equals("notifications", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/start", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return path.StartsWith("vacancies/", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Lobsy-hulp uit op landing, inloggen en account-flow (mockup).</summary>
    public static bool IsLobsyCoachExcludedPath(string path)
    {
        path = path.TrimStart('/');
        if (string.IsNullOrEmpty(path))
        {
            return true;
        }

        if (path.Equals("login", StringComparison.OrdinalIgnoreCase)
            || path.Equals("inloggen", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (path.StartsWith("account-maken", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("account/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (path.Equals("ouder", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return path.Contains("/uwv-", StringComparison.OrdinalIgnoreCase)
               || path.EndsWith("/uwv", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Legacy alias — coach stays visible on illustrated SSR pages.</summary>
    public static bool IsIllustratedCandidateCoachHidden(string path) => false;

    /// <summary>Hide floating coach on standalone Quick-Scan shells (scene bubble + progress).</summary>
    public static bool IsStandaloneQuickScanCoachHidden(string path)
    {
        path = path.TrimStart('/');
        return path.Equals("candidate/competencies", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/career", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/culture", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/disc", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/values", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/deep-analysis", StringComparison.OrdinalIgnoreCase)
               || path.StartsWith("candidate/deep-analysis/", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Hide sticky LobsyCoach when the journey page already shows its own mascot (desktop grid or mobile dock / inline).</summary>
    public static bool IsDiscoveryQuestionCoachHidden(string path, string relativeUri)
    {
        path = path.TrimStart('/');
        if (!path.Equals("candidate/ontdekkingsreis", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!TryGetJourneyStap(relativeUri, out var stap) || string.IsNullOrWhiteSpace(stap))
        {
            return false;
        }

        if (stap.Equals("start", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (int.TryParse(stap, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var n)
            && n is >= 7 and <= 10)
        {
            return true;
        }

        if (int.TryParse(stap, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var step)
            && step is >= 1 and <= 6)
        {
            return true;
        }

        return stap.Equals("shed", StringComparison.OrdinalIgnoreCase)
               || stap.Equals("klaar", StringComparison.OrdinalIgnoreCase)
               || stap.Equals("toestemming", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryGetJourneyStap(string relativeUri, out string stap)
    {
        stap = "";
        var qIdx = relativeUri.IndexOf('?', StringComparison.Ordinal);
        if (qIdx < 0)
        {
            return false;
        }

        var query = relativeUri[(qIdx + 1)..];
        var hash = query.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0)
        {
            query = query[..hash];
        }

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=', StringComparison.Ordinal);
            var key = eq < 0 ? part : part[..eq];
            if (!key.Equals("stap", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            stap = eq < 0 ? "" : Uri.UnescapeDataString(part[(eq + 1)..]).Trim();
            return !string.IsNullOrWhiteSpace(stap);
        }

        return false;
    }

    public static bool SuppressesPwaInstallEntry(string path)
    {
        path = path.TrimStart('/');
        return path.Equals("candidate/share-in", StringComparison.OrdinalIgnoreCase)
               || SuppressesInstallBanner(path);
    }

    public static bool SuppressesInstallBanner(string path)
    {
        path = path.TrimStart('/');
        return path.Equals("candidate/competencies", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/career", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/culture", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/disc", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/values", StringComparison.OrdinalIgnoreCase)
               || path.Equals("candidate/start", StringComparison.OrdinalIgnoreCase)
               || path.StartsWith("candidate/ontdekkingsreis", StringComparison.OrdinalIgnoreCase)
               || path.StartsWith("candidate/deep-analysis", StringComparison.OrdinalIgnoreCase);
    }

    public static bool IsQuestionnairePath(string path)
        => IsQuestionnairePath(path, path);

    /// <summary>Onboarding wizard sticky footer must not fight the global bottom nav on mobile.</summary>
    public static bool IsOnboardingWizardFocusPath(string path)
        => path.TrimStart('/').Equals("candidate/start", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Focus mode for questionnaires / classic start / journey-in-progress.
    /// Overview (<c>/candidate/ontdekkingsreis</c> without <c>stap</c>) keeps the normal nav.
    /// </summary>
    public static bool IsQuestionnairePath(string path, string relativeUri)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        path = path.TrimStart('/');
        path = path.TrimStart('/');
        if (path.Equals("candidate/competencies", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/career", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/culture", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/disc", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/values", StringComparison.OrdinalIgnoreCase)
            || path.Equals("candidate/deep-analysis", StringComparison.OrdinalIgnoreCase)
            || (path.StartsWith("candidate/deep-analysis/", StringComparison.OrdinalIgnoreCase)
                && !path.Equals("candidate/deep-analysis/checkout", StringComparison.OrdinalIgnoreCase))
            || path.Equals("account/mfa", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("account/mfa/", StringComparison.OrdinalIgnoreCase))
        {
            // Intro/finish keep normal nav (?stap=intro|klaar).
            if (HasTestShellNavQuery(relativeUri))
            {
                return false;
            }

            return true;
        }

        if (path.Equals("candidate/ontdekkingsreis", StringComparison.OrdinalIgnoreCase))
        {
            // Static SSR keeps normal nav on all discovery screens (no focus trap).
            return false;
        }

        return false;
    }

    private static bool HasJourneyStepQuery(string relativeUri)
    {
        var qIdx = relativeUri.IndexOf('?', StringComparison.Ordinal);
        if (qIdx < 0) return false;
        var query = relativeUri[(qIdx + 1)..];
        var hash = query.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0) query = query[..hash];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=', StringComparison.Ordinal);
            var key = eq < 0 ? part : part[..eq];
            if (!key.Equals("stap", StringComparison.OrdinalIgnoreCase)) continue;
            var value = eq < 0 ? "" : Uri.UnescapeDataString(part[(eq + 1)..]);
            return !string.IsNullOrWhiteSpace(value);
        }

        return false;
    }

    /// <summary>Intro/finish of free tests use ?stap=intro|klaar and keep the normal bottom nav.</summary>
    private static bool HasTestShellNavQuery(string relativeUri)
    {
        var qIdx = relativeUri.IndexOf('?', StringComparison.Ordinal);
        if (qIdx < 0) return false;
        var query = relativeUri[(qIdx + 1)..];
        var hash = query.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0) query = query[..hash];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=', StringComparison.Ordinal);
            var key = eq < 0 ? part : part[..eq];
            if (!key.Equals("stap", StringComparison.OrdinalIgnoreCase)) continue;
            var value = eq < 0 ? "" : Uri.UnescapeDataString(part[(eq + 1)..]);
            return value.Equals("intro", StringComparison.OrdinalIgnoreCase)
                   || value.Equals("klaar", StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private string HeaderTagline => Branding.ResolveTagline(RegionHost.Current?.Slogan, Culture["Brand.Tagline"]);

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void OnBrandingChanged()
        => InvokeAsync(StateHasChanged);

    private void OnPwaSheetChanged()
    {
        var open = PwaSheet.IsOpen;
        if (_pwaSheetOpen == open)
        {
            return;
        }

        _pwaSheetOpen = open;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PwaSheet.Changed -= OnPwaSheetChanged;
        Culture.Changed -= OnCultureChanged;
        RegionHost.Changed -= OnBrandingChanged;
        Branding.Changed -= OnBrandingChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
