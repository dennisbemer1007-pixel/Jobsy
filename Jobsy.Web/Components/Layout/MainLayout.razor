@inherits LayoutComponentBase
@using Jobsy.Web.Localization
@inject CultureState Culture
@inject JobsyApiClient Api
@inject Jobsy.Web.RegionHosting.RegionHostState RegionHost
@inject Jobsy.Web.Branding.PlatformBrandingState Branding
@inject IJSRuntime Js
@inject NavigationManager Navigation
@implements IDisposable

<div class="app-shell @(_hasBottomNav ? "has-bottom-nav" : null)" dir="@(Culture.IsRightToLeft ? "rtl" : null)">
    @if (ShowPanelWatermarks)
    {
        <div class="lobsy-watermarks" aria-hidden="true">
            <img class="lobsy-watermark lobsy-watermark--left"
                 src="@Jobsy.Web.Media.BrandImages.Webp256"
                 alt=""
                 width="256"
                 height="256"
                 loading="lazy"
                 decoding="async" />
            <img class="lobsy-watermark lobsy-watermark--right"
                 src="@Jobsy.Web.Media.BrandImages.Webp256"
                 alt=""
                 width="256"
                 height="256"
                 loading="lazy"
                 decoding="async" />
        </div>
    }
    <PageSeoHead />
    <header class="app-header">
        <div class="app-header__brand">
            <a class="brand" href="/" aria-label="Lobsy">
                <LobsyLogo Class="brand__logo" Alt="Lobsy" />
                <span class="brand__text">
                    <span class="brand__name">Lobsy</span>
                    <span class="brand-tagline">@HeaderTagline</span>
                </span>
            </a>
        </div>
        <div class="app-header__actions">
            <PageHelp />
            <NotificationBell />
            <TokenWalletChip />
            <LanguageSelector />
            <AuthHeader />
        </div>
    </header>

    <main class="app-main">
        @Body
        <AppFooter />
    </main>

    <BottomNav HasItemsChanged="OnBottomNavItemsChanged" />
    @if (RendererInfo.IsInteractive)
    {
        <LobsyAssistantChat HasBottomNav="_hasBottomNav" />
        <FeedbackWidget HasBottomNav="_hasBottomNav" />
        <ConsentReacceptDialog />
    }
    <CookieConsentBanner OnConsentChanged="OnCookieConsentChanged" />
    <SessionIdleGuard />
</div>

@code {
    private bool _siteVisitRecorded;
    private bool _hasBottomNav;

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        RegionHost.Changed += OnBrandingChanged;
        Branding.Changed += OnBrandingChanged;
        await Culture.InitializeAsync();
        await Culture.SyncDocumentAsync();
        // Do not block first paint (or /home dashboards) on region/slogan HTTP.
        _ = HydrateHostBrandingAsync();
    }

    private async Task HydrateHostBrandingAsync()
    {
        try
        {
            await Task.WhenAll(
                RegionHost.EnsureInitializedAsync(),
                Branding.EnsureInitializedAsync());
        }
        catch
        {
            // Header falls back to the default tagline.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_siteVisitRecorded)
        {
            return;
        }

        try
        {
            if (!await CookieConsentBanner.AllowsAnalyticsAsync(Js))
            {
                // Wait until the user accepts analytics (banner choice).
                return;
            }

            _siteVisitRecorded = true;
            var path = new Uri(Navigation.Uri).AbsolutePath;
            await Api.RecordSiteVisitOnceAsync(Js, path);
        }
        catch
        {
            // Analytics must not block the app shell.
            _siteVisitRecorded = true;
        }
    }

    private Task OnCookieConsentChanged()
        => InvokeAsync(StateHasChanged);

    private Task OnBottomNavItemsChanged(bool hasItems)
    {
        if (_hasBottomNav == hasItems)
        {
            return Task.CompletedTask;
        }

        _hasBottomNav = hasItems;
        return InvokeAsync(StateHasChanged);
    }

    private bool ShowPanelWatermarks
    {
        get
        {
            // Never on first paint: gutter logos flash over the banenkaart before CSS/layout settle.
            if (!RendererInfo.IsInteractive)
            {
                return false;
            }

            try
            {
                var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
                return !string.IsNullOrEmpty(path);
            }
            catch
            {
                return false;
            }
        }
    }

    private string HeaderTagline => Branding.ResolveTagline(RegionHost.Current?.Slogan, Culture["Brand.Tagline"]);

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void OnBrandingChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        RegionHost.Changed -= OnBrandingChanged;
        Branding.Changed -= OnBrandingChanged;
    }
}
