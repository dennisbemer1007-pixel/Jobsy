@inherits LayoutComponentBase
@using Jobsy.Web.Localization
@inject CultureState Culture
@implements IDisposable

<div class="app-shell has-bottom-nav" dir="@(Culture.IsRightToLeft ? "rtl" : null)">
    <div class="lobsy-watermarks" aria-hidden="true">
        <img class="lobsy-watermark lobsy-watermark--left" src="images/brand/lobsy.png?v=20260726-no-ai" alt="" />
        <img class="lobsy-watermark lobsy-watermark--right" src="images/brand/lobsy.png?v=20260726-no-ai" alt="" />
    </div>
    <header class="app-header">
        <div class="app-header__brand">
            <a class="brand" href="/" aria-label="Lobsy">
                <img class="brand__logo" src="images/brand/lobsy.png?v=20260726-no-ai" alt="Lobsy" width="56" height="56" />
                <span class="brand__text">
                    <span class="brand__name">Lobsy</span>
                    <span class="brand-tagline">@Culture["Brand.Tagline"]</span>
                </span>
            </a>
        </div>
        <div class="app-header__actions">
            <TokenWalletChip />
            <AuthHeader />
            <LanguageSelector />
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <AppFooter />
    <BottomNav />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        await Culture.InitializeAsync();
        await Culture.SyncDocumentAsync();
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
