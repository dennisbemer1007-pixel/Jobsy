@using Jobsy.Core.Authorization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Jobsy.Web.Werkgever
@using Microsoft.AspNetCore.Components.Authorization
@inherits CultureAwareComponentBase
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject TokenBalanceCache TokenBalances
@inject EmployerScopeState Scope

<AuthorizeView Roles="@string.Join(',', JobsyRoles.EmployerRoles)">
    <Authorized>
        @if (_loaded && _total is not null)
        {
            <a class="token-wallet-chip" href="@_href" title="@Culture["Common.TokenBalance"]">
                <span class="token-wallet-chip__icon" aria-hidden="true">◎</span>
                <span class="token-wallet-chip__value">@_total.Value.ToString("0.##")</span>
                <span class="token-wallet-chip__label">@Culture["Common.Tokens"]</span>
            </a>
        }
    </Authorized>
</AuthorizeView>

@code {
    private decimal? _total;
    private bool _loaded;
    private string _href = "/werkgever/tokens";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        TokenBalances.Changed += OnTokenCacheChanged;
        Scope.Changed += OnScopeChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true
            || !JobsyRoles.EmployerRoles.Any(r => state.User.IsInRole(r)))
        {
            return;
        }

        _href = RoleNavCatalog.TokensHrefFor(state.User);
        await LoadBalanceAsync();
    }

    private async Task LoadBalanceAsync()
    {
        try
        {
            _total = await TokenBalances.GetOrLoadAsync(async () =>
            {
                var balances = await Api.GetTokenBalancesAsync();
                var scopeIds = Scope.CompanyIds;
                var scoped = scopeIds.Count > 0
                    ? balances.Where(b => scopeIds.Contains(b.CompanyId)).ToList()
                    : balances.ToList();
                return scoped.Sum(b => b.Balance);
            });
        }
        catch
        {
            _total = null;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void OnTokenCacheChanged()
        => InvokeAsync(LoadBalanceAsync);

    private void OnScopeChanged()
        => InvokeAsync(LoadBalanceAsync);

    public override void Dispose()
    {
        TokenBalances.Changed -= OnTokenCacheChanged;
        Scope.Changed -= OnScopeChanged;
        base.Dispose();
    }
}
