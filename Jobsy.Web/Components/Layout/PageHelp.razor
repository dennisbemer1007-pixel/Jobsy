@using Jobsy.Web.Help
@using Jobsy.Web.Localization
@inherits CultureAwareComponentBase
@inject NavigationManager Navigation

@if (_doc is not null)
{
    <div class="page-help" data-menu-id="help">
        <button type="button"
                data-menu-trigger
                class="page-help__btn"
                title="@Culture["Help.AboutPage"]"
                aria-label="@($"{Culture["Help.AboutPage"]}: {_doc.Title}")"
                aria-expanded="false"
                aria-controls="page-help-panel">
            i
        </button>

            <div class="header-dropdown-backdrop" aria-hidden="true"></div>
            <aside id="page-help-panel" class="page-help__panel info-dropdown right-0 max-w-[90vw] mx-auto z-50" role="dialog" aria-label="@_doc.Title">
                <div class="page-help__panel-head">
                    <strong>@_doc.Title</strong>
                    <button type="button" class="page-help__close" data-menu-close aria-label="@Culture["Common.Close"]">×</button>
                </div>
                <dl class="page-help__list">
                    <div>
                        <dt>@Culture["Help.Purpose"]</dt>
                        <dd>@_doc.Purpose</dd>
                    </div>
                    <div>
                        <dt>@Culture["Help.HowItWorks"]</dt>
                        <dd>@_doc.HowItWorks</dd>
                    </div>
                    <div>
                        <dt>@Culture["Help.UsedFor"]</dt>
                        <dd>@_doc.UsedFor</dd>
                    </div>
                </dl>
            </aside>
    </div>
}

@code {
    private string? _path;
    private PageHelpDocs.Doc? _doc;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
        RefreshFromUri();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RefreshFromUri();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshFromUri()
    {
        _path = new Uri(Navigation.Uri).AbsolutePath;
        _doc = PageHelpDocs.TryGet(_path);
    }

    public override void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
