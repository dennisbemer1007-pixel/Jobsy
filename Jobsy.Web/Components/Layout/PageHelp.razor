@using Jobsy.Web.Help
@using Jobsy.Web.Localization
@implements IDisposable
@inject NavigationManager Navigation
@inject CultureState Culture

@if (_doc is not null)
{
    <div class="page-help">
        <button type="button"
                class="page-help__btn @(_open ? "is-open" : null)"
                title="@Culture["Help.AboutPage"]"
                aria-label="@($"{Culture["Help.AboutPage"]}: {_doc.Title}")"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="@(_open ? "page-help-panel" : null)"
                @onclick="Toggle">
            i
        </button>

        @if (_open)
        {
            <aside id="page-help-panel" class="page-help__panel" role="dialog" aria-label="@_doc.Title">
                <div class="page-help__panel-head">
                    <strong>@_doc.Title</strong>
                    <button type="button" class="page-help__close" aria-label="@Culture["Common.Close"]" @onclick="Close">×</button>
                </div>
                <dl class="page-help__list">
                    <div>
                        <dt>@Culture["Help.Purpose"]</dt>
                        <dd>@_doc.Purpose</dd>
                    </div>
                    <div>
                        <dt>@Culture["Help.HowItWorks"]</dt>
                        <dd>@_doc.HowItWorks</dd>
                    </div>
                    <div>
                        <dt>@Culture["Help.UsedFor"]</dt>
                        <dd>@_doc.UsedFor</dd>
                    </div>
                </dl>
            </aside>
        }
    </div>
}

@code {
    private bool _open;
    private string? _path;
    private PageHelpDocs.Doc? _doc;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Culture.Changed += OnCultureChanged;
        RefreshFromUri();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _open = false;
        RefreshFromUri();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void RefreshFromUri()
    {
        _path = new Uri(Navigation.Uri).AbsolutePath;
        _doc = PageHelpDocs.TryGet(_path);
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Culture.Changed -= OnCultureChanged;
    }
}
