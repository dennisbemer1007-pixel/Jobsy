@using System.Security.Claims
@inject ILogger<CircuitErrorBoundary> Logger
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject CultureState Culture
@implements IDisposable

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        @{
            LogCircuitError(ex);
        }
        <div class="panel-page circuit-error" role="alert">
            <h1>@Culture["Circuit.ErrorTitle"]</h1>
            <p class="login-lead">@Culture["Circuit.ErrorLead"]</p>
            @if (!string.IsNullOrEmpty(_supportCode))
            {
                <p class="err-inline__code" data-support-code="@_supportCode">
                    @string.Format(System.Globalization.CultureInfo.InvariantCulture, Culture["Status.Inline.Code"], _supportCode)
                </p>
            }
            <button type="button" class="login-submit" @onclick="RecoverFromError">@Culture["Circuit.ErrorRetry"]</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string BoundaryTag { get; set; } = "main";

    private ErrorBoundary? _errorBoundary;
    private Exception? _loggedCircuitError;
    private string _supportCode = string.Empty;

    protected override void OnInitialized()
        => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // An error on one tab must never follow the user to the next route.
        _loggedCircuitError = null;
        _supportCode = string.Empty;
        _errorBoundary?.Recover();
    }

    private void RecoverFromError()
    {
        _loggedCircuitError = null;
        _supportCode = string.Empty;
        _errorBoundary?.Recover();
    }

    private void LogCircuitError(Exception ex)
    {
        if (ReferenceEquals(_loggedCircuitError, ex))
        {
            return;
        }

        _loggedCircuitError = ex;
        // E2: one code per circuit error so support can find this log line back from the screen.
        _supportCode = Jobsy.Web.Diagnostics.SupportCode.GetOrCreate(HttpContextAccessor.HttpContext);
        var route = SafeRoute();
        var userId = ResolveUserId();
        Logger.LogError(
            ex,
            "Circuit error boundary {SupportCode} at {Route} for user {UserId}: {ExceptionType}",
            _supportCode,
            route,
            userId,
            ex.GetType().Name);
        try
        {
            Sentry.SentrySdk.CaptureException(ex, scope =>
            {
                scope.SetTag(Jobsy.Web.Diagnostics.SupportCode.SentryTag, _supportCode);
                scope.SetTag("route", route);
                scope.SetTag("boundary", BoundaryTag);
                if (!string.IsNullOrEmpty(userId))
                {
                    scope.User = new Sentry.SentryUser { Id = userId };
                }
            });
        }
        catch
        {
            // Sentry optional / not configured.
        }
    }

    private string SafeRoute()
    {
        try
        {
            // Prefer PathAndQuery for debugging; fall back to base-relative path without query.
            return new Uri(Navigation.Uri).PathAndQuery;
        }
        catch
        {
            try
            {
                return "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            }
            catch
            {
                return "/";
            }
        }
    }

    private string ResolveUserId()
    {
        try
        {
            var user = HttpContextAccessor.HttpContext?.User;
            if (user?.Identity?.IsAuthenticated != true)
            {
                return "";
            }

            return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                   ?? user.FindFirst("sub")?.Value
                   ?? "";
        }
        catch
        {
            return "";
        }
    }

    public void Dispose()
        => Navigation.LocationChanged -= OnLocationChanged;
}
