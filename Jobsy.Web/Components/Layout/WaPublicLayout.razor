@namespace Jobsy.Web.Components.Layout
@inherits LayoutComponentBase
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture
@inject LandingVariantResolver VariantResolver
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<PageSeoHead />
<div class="pub-theme wa-theme" dir="@(Culture.IsRightToLeft ? "rtl" : null)" lang="@Culture.Language">
    <a class="pub-skip" href="#main">@Culture["PublicNav.SkipToContent"]</a>
    <PublicHeader Variant="_variant" EmployerWizard="true" />
    <main id="main" class="pub-main wa-main">
        <section class="au-stage wa-register-stage" aria-label="@Culture["Wa.Layout.Title"]">
            <div class="au-blob au-blob--a" aria-hidden="true"></div>
            <div class="au-blob au-blob--b" aria-hidden="true"></div>
            <div class="au-col wa-register-col">
                @Body
            </div>
        </section>
    </main>
    <PublicFooter Variant="_variant" />
    <CookieConsentBanner />
</div>

@code {
    private LandingVariant _variant = LandingVariant.On;

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        Culture.InitializeFromRequest(HttpContextAccessor.HttpContext);
        _variant = await VariantResolver.GetAsync();
        await Culture.InitializeAsync();
        await Culture.SyncDocumentAsync();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Culture.Changed -= OnCultureChanged;
}
