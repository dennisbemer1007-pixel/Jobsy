@inherits LayoutComponentBase
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<PageSeoHead />
<div class="teaser-shell" dir="@(Culture.IsRightToLeft ? "rtl" : null)">
    <header class="teaser-shell__bar">
        <a class="teaser-shell__brand" href="@PublicRoutes.Landing" aria-label="Lobsy">
            <LobsyLogo Class="teaser-shell__logo" Alt="" Animate="false" />
            <span class="teaser-shell__name">Lobsy</span>
        </a>
        <nav class="teaser-shell__nav" aria-label="@Culture["PublicNav.QuickLinks"]">
            <a class="teaser-shell__link" href="@PublicRoutes.CreateAccount">@Culture["PublicNav.CreateAccount"]</a>
            <a class="teaser-shell__link teaser-shell__link--quiet" href="@PublicRoutes.Login">@Culture["PublicNav.Login"]</a>
        </nav>
    </header>
    <main class="teaser-shell__main">
        @Body
    </main>
    <CookieConsentBanner />
    <FeedbackWidget />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        Culture.InitializeFromRequest(HttpContextAccessor.HttpContext);
        await Culture.InitializeAsync();
        await Culture.SyncDocumentAsync();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Culture.Changed -= OnCultureChanged;
}
