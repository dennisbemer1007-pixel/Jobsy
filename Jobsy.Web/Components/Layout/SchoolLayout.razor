@namespace Jobsy.Web.Components.Layout
@using Jobsy.Core.Interfaces
@using Jobsy.Core.Scholen
@using Jobsy.Web.Components.Ui.Enterprise
@using Jobsy.Web.Navigation
@inherits LayoutComponentBase
@inject CultureState Culture
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPlatformFeatureService Features

<div class="sch-shell" lang="nl">
    <header class="sch-topbar">
        <a class="sch-topbar__brand" href="@HomeHref">@Culture["School.ProductLabel"]</a>
        <div class="sch-topbar__scope">
            <EntScopeChip Label="@_scopeLabel" SubLabel="@_roleLabel" />
        </div>
        <div class="sch-topbar__account">
            <span class="sch-topbar__role">@_roleLabel</span>
            <a class="sch-topbar__link" href="/account/logout">@Culture["Auth.Logout"]</a>
        </div>
    </header>

    <div class="sch-body">
        <aside class="sch-sidebar" aria-label="@Culture["Nav.Main"]">
            @foreach (var group in _groups)
            {
                var visible = group.Items.Where(i => i.IsAvailable).ToList();
                if (visible.Count == 0)
                {
                    continue;
                }
                <p class="sch-sidebar__group">@Culture[group.LabelKey]</p>
                <ul class="sch-sidebar__list">
                    @foreach (var item in visible)
                    {
                        var active = IsActive(item.Href);
                        <li>
                            <a class="sch-sidebar__link @(active ? "is-active" : null)"
                               href="@item.Href"
                               aria-current="@(active ? "page" : null)">@Culture[item.LabelKey]</a>
                        </li>
                    }
                </ul>
            }
            <div class="sch-sidebar__footer">
                <p class="sch-sidebar__help">@Culture["School.Nav.Help"]</p>
                <p class="sch-sidebar__note">@Culture["School.Footer.NoNames"]</p>
            </div>
        </aside>

        <main class="sch-main">
            @if (_featureOff)
            {
                <p class="state-message error">@Culture["School.FeatureDisabled"]</p>
            }
            else
            {
                @Body
            }
        </main>
    </div>

    <nav class="sch-bottom-nav" aria-label="@Culture["Nav.Main"]">
        @foreach (var item in _bottom)
        {
            var active = IsActive(item.Href);
            <a class="sch-bottom-nav__item @(active ? "is-active" : null)" href="@item.Href">@Culture[item.LabelKey]</a>
        }
    </nav>
</div>

@code {
    private IReadOnlyList<ScholenNav.ScholenNavGroup> _groups = ScholenNav.SchoolGroups;
    private (string LabelKey, string Href)[] _bottom = ScholenNav.SchoolBottomNav;
    private string HomeHref = "/school";
    private string _scopeLabel = "";
    private string _roleLabel = "";
    private bool _featureOff;

    protected override async Task OnInitializedAsync()
    {
        await Culture.SetLanguageAsync("nl");
        _featureOff = !await SchoolsFeatureGate.IsEnabledAsync(Features);
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        var isTeacher = RoleClaimMatching.HasRole(user, JobsyRoles.Teacher)
                        && !RoleClaimMatching.HasRole(user, JobsyRoles.SchoolAdmin);
        if (isTeacher)
        {
            _groups = ScholenNav.TeacherGroups;
            _bottom = ScholenNav.TeacherBottomNav;
            HomeHref = "/leraar";
            _roleLabel = Culture["Leraar.RoleChip"];
        }
        else
        {
            _roleLabel = Culture["School.RoleChip"];
        }

        _scopeLabel = user.Identity?.Name ?? _roleLabel;
    }

    private bool IsActive(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', 2)[0].Trim('/');
        if (path == "/")
        {
            path = HomeHref;
        }

        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
               || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
