@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Jobsy.Core.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject CultureState Culture
@inject RoleNavItemsState NavItems
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpContextAccessor
@inject IFeatureFlags FeatureFlags
@implements IAsyncDisposable

<nav class="app-header__nav candidate-header-nav"
     aria-label="@Culture["Nav.Main"]"
     data-testid="candidate-header-nav"
     data-nav-slots="@_items.Count">
    @foreach (var item in _items)
    {
        var title = Culture[item.TitleKey];
        var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
            ? Culture[item.ShortTitleKey!]
            : title;
        var active = RoleNavCatalog.IsActive(item, Navigation.ToBaseRelativePath(Navigation.Uri), _items);
        <CandidateNavLink Class="@($"candidate-header-nav__link {(active ? "is-active" : null)}")"
                          Href="@item.Href"
                          Title="@title"
                          AriaCurrent="@(active ? "page" : null)"
                          TestId="@HeaderNavTestId(item)">
            @shortTitle
        </CandidateNavLink>
    }
</nav>

@code {
    private IReadOnlyList<NavItem> _items = RoleNavCatalog.CandidateItems(FeatureFlagSnapshot.Defaults);

    protected override void OnInitialized()
    {
        var httpUser = HttpContextAccessor.HttpContext?.User;
        if (httpUser?.Identity?.IsAuthenticated == true)
        {
            _items = RoleNavCatalog.ForUser(httpUser, FeatureFlagSnapshot.Defaults);
            if (_items.Count == 0)
            {
                _items = RoleNavCatalog.CandidateItems(FeatureFlagSnapshot.Defaults);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FeatureFlagSnapshot flags;
        try
        {
            flags = await FeatureFlags.GetAsync();
        }
        catch
        {
            flags = FeatureFlagSnapshot.Defaults;
        }

        await NavItems.EnsureInitializedAsync();
        ApplyItemsIfHrefLayoutChanged(NavItems.Items.Count > 0
            ? NavItems.Items
            : RoleNavCatalog.ForUser((await AuthState.GetAuthenticationStateAsync()).User, flags));

        NavItems.Changed += OnNavItemsChanged;
    }

    private void OnNavItemsChanged()
    {
        if (NavItems.Items.Count == 0)
        {
            return;
        }

        ApplyItemsIfHrefLayoutChanged(NavItems.Items);
    }

    private void ApplyItemsIfHrefLayoutChanged(IReadOnlyList<NavItem> next)
    {
        if (next.Count == 0)
        {
            return;
        }

        if (NavHrefFingerprint(_items) == NavHrefFingerprint(next))
        {
            return;
        }

        _items = next;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string NavHrefFingerprint(IReadOnlyList<NavItem> items)
        => string.Join("|", items.Select(i => i.Href));

    private static string? HeaderNavTestId(NavItem item)
    {
        if (string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "nav-maqqie-uren";
        }

        if (string.Equals(item.Href, RoleNavCatalog.DiscoveryItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-discovery";
        }

        if (string.Equals(item.Href, RoleNavCatalog.SearchItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-search";
        }

        return null;
    }

    public ValueTask DisposeAsync()
    {
        NavItems.Changed -= OnNavItemsChanged;
        return ValueTask.CompletedTask;
    }
}
