@using Jobsy.Core.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject CultureState Culture
@inject RoleNavItemsState NavItems
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpContextAccessor
@inject IFeatureFlags FeatureFlags
@implements IAsyncDisposable

<nav class="app-header__nav candidate-header-nav" aria-label="@Culture["Nav.Main"]" data-testid="candidate-header-nav">
    @foreach (var item in _items)
    {
        var title = Culture[item.TitleKey];
        var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
            ? Culture[item.ShortTitleKey!]
            : title;
        var active = RoleNavCatalog.IsActive(item, Navigation.ToBaseRelativePath(Navigation.Uri), _items);
        <a class="candidate-header-nav__link @(active ? "is-active" : null)"
           href="@item.Href"
           title="@title"
           aria-current="@(active ? "page" : null)"
           data-testid="@HeaderNavTestId(item)">
            @shortTitle
        </a>
    }
</nav>

@code {
    private IReadOnlyList<NavItem> _items = RoleNavCatalog.CandidateItems(FeatureFlagSnapshot.Defaults);

    protected override void OnInitialized()
    {
        var httpUser = HttpContextAccessor.HttpContext?.User;
        if (httpUser?.Identity?.IsAuthenticated == true)
        {
            var fromHttp = RoleNavCatalog.ForUser(httpUser, FeatureFlagSnapshot.Defaults);
            if (fromHttp.Count > 0)
            {
                _items = fromHttp;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FeatureFlagSnapshot flags;
        try
        {
            flags = await FeatureFlags.GetAsync();
        }
        catch
        {
            flags = FeatureFlagSnapshot.Defaults;
        }

        await NavItems.EnsureInitializedAsync();
        _items = NavItems.Items.Count > 0
            ? NavItems.Items
            : RoleNavCatalog.ForUser((await AuthState.GetAuthenticationStateAsync()).User, flags);
        if (_items.Count == 0)
        {
            _items = RoleNavCatalog.CandidateItems(flags);
        }

        NavItems.Changed += OnNavItemsChanged;
    }

    private void OnNavItemsChanged()
    {
        if (NavItems.Items.Count == 0)
        {
            return;
        }

        _items = NavItems.Items;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string? HeaderNavTestId(NavItem item)
    {
        if (string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "nav-maqqie-uren";
        }

        if (string.Equals(item.Href, RoleNavCatalog.DiscoveryItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-discovery";
        }

        if (string.Equals(item.Href, RoleNavCatalog.SearchItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-search";
        }

        return null;
    }

    public ValueTask DisposeAsync()
    {
        NavItems.Changed -= OnNavItemsChanged;
        return ValueTask.CompletedTask;
    }
}
