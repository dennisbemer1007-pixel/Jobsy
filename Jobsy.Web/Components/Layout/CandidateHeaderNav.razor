@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inject CultureState Culture
@inject RoleNavItemsState NavItems
@inject IHttpContextAccessor HttpContextAccessor

<nav class="app-header__nav candidate-header-nav"
     aria-label="@Culture["Nav.Main"]"
     data-testid="candidate-header-nav">
    @foreach (var item in _items)
    {
        var title = Culture[item.TitleKey];
        var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
            ? Culture[item.ShortTitleKey!]
            : title;
        var active = RoleNavCatalog.IsActive(item, _relativePath, _items);
        <CandidateNavLink Class="@($"candidate-header-nav__link {(active ? "is-active" : null)}")"
                          Href="@item.Href"
                          Title="@title"
                          AriaCurrent="@(active ? "page" : null)"
                          TestId="@HeaderNavTestId(item)">
            @shortTitle
        </CandidateNavLink>
    }
</nav>

@code {
    private IReadOnlyList<NavItem> _items = RoleNavCatalog.Anonymous;
    private string _relativePath = "";

    protected override async Task OnInitializedAsync()
    {
        _relativePath = ResolveRelativePath();
        await NavItems.EnsureInitializedAsync();
        _items = NavItems.Items;
    }

    private string ResolveRelativePath()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request is null)
        {
            return "";
        }

        var path = request.Path.Value ?? "/";
        return path.TrimStart('/');
    }

    private static string? HeaderNavTestId(NavItem item)
    {
        if (string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "nav-maqqie-uren";
        }

        if (string.Equals(item.Href, RoleNavCatalog.DiscoveryItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-discovery";
        }

        if (string.Equals(item.Href, RoleNavCatalog.SearchItem.Href, StringComparison.OrdinalIgnoreCase))
        {
            return "header-nav-search";
        }

        return null;
    }
}
