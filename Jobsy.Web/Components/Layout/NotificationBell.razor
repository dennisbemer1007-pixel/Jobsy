@using Microsoft.AspNetCore.Components.Authorization
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@inherits CultureAwareComponentBase
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpContextAccessor

<AuthorizeView>
    <Authorized>
        <div class="notification-bell"
             data-menu-id="notifications"
             data-notifications-all-href="@_allNotificationsHref"
             data-n-i18n-loading="@Culture["Notifications.Loading"]"
             data-n-i18n-empty-title="@Culture["Notifications.EmptyTitle"]"
             data-n-i18n-empty-body="@Culture["Notifications.EmptyBody"]"
             data-n-i18n-error-title="@Culture["Notifications.ErrorTitle"]"
             data-n-i18n-error-body="@Culture["Notifications.ErrorBody"]"
             data-n-i18n-retry="@Culture["Notifications.Retry"]"
             data-n-i18n-default-title="@Culture["Notifications.DefaultTitle"]"
             data-n-i18n-default-body="@Culture["Notifications.DefaultBody"]"
             data-n-i18n-just-now="@Culture["Notifications.JustNow"]"
             data-n-i18n-up-to-date="@Culture["Notifications.UpToDate"]">
            <button type="button"
                    data-menu-trigger
                    class="notification-bell__toggle @(_unread > 0 ? "notification-bell__toggle--unread" : null)"
                    title="@UnreadTitle"
                    aria-label="@UnreadAria">
                <span class="notification-bell__icon" aria-hidden="true">@((MarkupString)NavIcons.Notifications)</span>
                @if (_unread > 0)
                {
                    <span class="notification-bell__badge" data-notifications-badge>@(_unread > 99 ? "99+" : _unread.ToString())</span>
                }
            </button>

            <div class="header-dropdown-backdrop" aria-hidden="true"></div>
            <div class="notification-bell__panel notification-dropdown right-0 max-w-[90vw] mx-auto z-50" role="dialog" aria-label="@Culture["Notifications.PanelTitle"]">
                <div class="notification-bell__header">
                    <div>
                        <strong>@Culture["Notifications.PanelHeading"]</strong>
                        <p class="notification-bell__subtitle" data-notifications-subtitle>
                            @UnreadSubtitle
                        </p>
                    </div>
                    <div class="notification-bell__header-actions">
                        @if (_unread > 0)
                        {
                            <button type="button"
                                    class="btn-compact"
                                    data-notifications-mark-all>
                                @Culture["Notifications.MarkAllRead"]
                            </button>
                        }
                        <button type="button"
                                class="notification-bell__close"
                                data-menu-close
                                aria-label="@Culture["Common.Close"]">
                            ×
                        </button>
                    </div>
                </div>

                <div data-notifications-list class="notification-bell__list-host">
                    <p class="muted notification-bell__empty">@Culture["Notifications.LoadHint"]</p>
                </div>

                <p class="notification-bell__footer-link">
                    <a href="@_allNotificationsHref">@Culture["Notifications.ViewAll"]</a>
                </p>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private int _unread;
    private string _allNotificationsHref = "/notifications";

    private string UnreadTitle =>
        _unread > 0
            ? string.Format(Culture["Notifications.UnreadTitle"], _unread)
            : Culture["Notifications.Title"];

    private string UnreadAria =>
        _unread > 0
            ? string.Format(Culture["Notifications.UnreadAria"], _unread)
            : Culture["Notifications.Title"];

    private string UnreadSubtitle =>
        _unread > 0
            ? string.Format(Culture["Notifications.UnreadSubtitle"], _unread)
            : Culture["Notifications.UpToDate"];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var state = await AuthState.GetAuthenticationStateAsync();
        _allNotificationsHref = RoleNavCatalog.NotificationsHrefFor(state.User);
        try
        {
            _unread = await Api.GetUnreadNotificationCountAsync();
        }
        catch
        {
            _unread = 0;
        }
    }
}
