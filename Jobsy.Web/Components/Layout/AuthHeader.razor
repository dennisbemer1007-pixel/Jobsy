@using System.Security.Claims
@using Jobsy.Core.Authorization
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.Services
@using Jobsy.Core.Features
@using Microsoft.AspNetCore.Components.Authorization
@inherits CultureAwareComponentBase
@inject NavigationManager Navigation
@inject FeedbackHost FeedbackHost
@inject IJSRuntime Js
@inject JobsyApiClient Api
@inject AuthenticationStateProvider AuthState
@inject IFeatureFlags FeatureFlags

<div class="auth-header">
    <AuthorizeView>
        <Authorized>
            <div class="account-menu" data-menu-id="account">
                <button type="button"
                        data-menu-trigger
                        class="account-menu__toggle"
                        title="@Culture["Footer.Legal"]"
                        aria-label="@Culture["Auth.AccountMenu"]"
                        aria-haspopup="menu"
                        aria-expanded="false">
                    <span class="auth-user" title="@DisplayName(context.User)">
                        <span class="auth-user__name">@DisplayName(context.User)</span>
                    </span>
                    <span class="account-menu__icon" aria-hidden="true">@((MarkupString)NavIcons.Profile)</span>
                </button>
                    <div class="account-menu__panel right-0 max-w-[90vw] z-50" role="menu" aria-label="@Culture["Auth.AccountMenu"]">
                        <div class="account-menu__identity" role="presentation">
                            <strong class="account-menu__identity-name">@DisplayName(context.User)</strong>
                            @if (!string.IsNullOrWhiteSpace(EmailOf(context.User)))
                            {
                                <span class="account-menu__identity-email">@EmailOf(context.User)</span>
                            }
                        </div>
                        @if (RoleClaimMatching.HasRole(context.User, JobsyRoles.Admin))
                        {
                            <a class="account-menu__link" href="/" role="menuitem">@Culture["AdminShell.ToLobsy"]</a>
                            <a class="account-menu__link" href="/admin" role="menuitem">@Culture["AdminShell.ToAdmin"]</a>
                        }
                        @if (RoleNavCatalog.HowLobsyHrefFor(context.User) is { } howHref)
                        {
                            <a class="account-menu__link" href="@howHref" role="menuitem">@Culture["Nav.HowLobsyWorks"]</a>
                        }
                        @if (RoleClaimMatching.HasRole(context.User, JobsyRoles.Candidate))
                        {
                            <a class="account-menu__link" href="@_candidateProfileHref" role="menuitem">@Culture["Nav.Profile"]</a>
                            <a class="account-menu__link" href="/candidate/settings" role="menuitem">@Culture["CandidateSettings.Title"]</a>
                            <a class="account-menu__link account-menu__link--danger"
                               href="/privacy/data"
                               role="menuitem"
                               data-testid="candidate-delete-account-menu">
                                @Culture["Unsubscribe.Title"]
                            </a>
                            <a class="account-menu__link" href="/candidate/privacy" role="menuitem">@Culture["CandidatePrivacy.Title"]</a>
                        }
                        <button type="button"
                                class="account-menu__link"
                                role="menuitem"
                                @onclick="OpenFeedbackAsync">
                            @Culture["Feedback.Button"]
                        </button>
                        @if (_showInstall && !_isCandidate)
                        {
                            <button type="button"
                                    class="account-menu__link"
                                    role="menuitem"
                                    @onclick="InstallAppAsync">
                                @Culture["Pwa.InstallMenu"]
                            </button>
                        }
                        <a class="account-menu__link" href="/account/mail-instellingen" role="menuitem">@Culture["MailSettings.Title"]</a>
                        <a class="account-menu__link" href="/privacy" role="menuitem">@Culture["Footer.Privacy"]</a>
                        <a class="account-menu__link" href="/algemene-voorwaarden" role="menuitem">@Culture["Footer.Terms"]</a>
                        <a class="account-menu__link" href="/gebruiksvoorwaarden" role="menuitem">@Culture["Footer.Usage"]</a>
                        <a class="account-menu__link" href="/wie-zijn-wij" role="menuitem">@Culture["Footer.About"]</a>
                        <a class="account-menu__link account-menu__link--logout"
                           href="/account/logout"
                           role="menuitem"
                           data-testid="auth-logout-link"
                           data-lobsy-logout="true">
                            @Culture["Auth.Logout"]
                        </a>
                    </div>
            </div>
        </Authorized>
        <NotAuthorized>
            @if (!IsLoginRoute)
            {
                <a class="auth-link auth-link--login" href="/login">
                    <span class="auth-link__icon" aria-hidden="true">@((MarkupString)NavIcons.Login)</span>
                    <span class="auth-link__label">@Culture["Auth.Login"]</span>
                </a>
            }
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _showInstall;
    private bool _installChecked;
    private bool _isCandidate;
    private string? _profileName;
    private string _candidateProfileHref = RoleNavCatalog.ProfileItem.Href;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        CandidateNameBroadcast.Changed += OnProfileNameChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshProfileNameAsync();
        try
        {
            var flags = await FeatureFlags.GetAsync();
            _candidateProfileHref = flags.CandidatePassportEnabled
                ? RoleNavCatalog.PassportItem.Href
                : RoleNavCatalog.ProfileItem.Href;
        }
        catch
        {
            _candidateProfileHref = RoleNavCatalog.PassportItem.Href;
        }
    }

    private void OnProfileNameChanged(string name)
    {
        _profileName = name;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshProfileNameAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true
                || !RoleClaimMatching.HasRole(user, JobsyRoles.Candidate))
            {
                return;
            }

            var profile = await Api.GetMyProfileAsync();
            var name = $"{profile?.FirstName} {profile?.LastName}".Trim();
            if (!string.IsNullOrWhiteSpace(name))
            {
                _profileName = name;
            }
        }
        catch
        {
            // Claims stay the fallback when the profile call fails.
        }
    }

    private bool IsLoginRoute
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relative.Split('?', '#')[0];
            return path.Equals("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("login/", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_installChecked || !firstRender)
        {
            return;
        }

        _installChecked = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            _isCandidate = state.User.Identity?.IsAuthenticated == true
                && RoleClaimMatching.HasRole(state.User, JobsyRoles.Candidate);
            var standalone = await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone");
            var canPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
            var ios = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            _showInstall = !standalone && (canPrompt || ios);
            if (_showInstall)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _installChecked = false;
        }
    }

    private Task OpenFeedbackAsync()
    {
        FeedbackHost.RequestOpen();
        return Task.CompletedTask;
    }

    private async Task InstallAppAsync()
    {
        try
        {
            var ios = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            if (ios)
            {
                await CircuitInterop.InvokeVoidIgnoredAsync(Js, "alert", Culture["Pwa.IosHint"]);
                return;
            }

            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
            _showInstall = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
        }
        catch
        {
            // Best-effort install prompt (script missing / unsupported browser / circuit gone).
        }
    }

    private string DisplayName(ClaimsPrincipal user)
    {
        if (!string.IsNullOrWhiteSpace(_profileName))
        {
            return _profileName;
        }

        var given = user.FindFirst(ClaimTypes.GivenName)?.Value
                    ?? user.FindFirst("given_name")?.Value;
        var family = user.FindFirst(ClaimTypes.Surname)?.Value
                     ?? user.FindFirst("family_name")?.Value;
        var combined = $"{given} {family}".Trim();
        if (!string.IsNullOrWhiteSpace(combined))
        {
            return combined;
        }

        var name = user.FindFirst(ClaimTypes.Name)?.Value
                   ?? user.Identity?.Name;
        // Avoid showing a region/host brand (e.g. "Westland") as if it were the person.
        if (!string.IsNullOrWhiteSpace(name)
            && !string.Equals(name, "Westland", StringComparison.OrdinalIgnoreCase)
            && name.Contains('@') == false)
        {
            return name;
        }

        return EmailOf(user) ?? Culture["Auth.User"];
    }

    private static string? EmailOf(ClaimsPrincipal user)
        => user.FindFirst(ClaimTypes.Email)?.Value
           ?? user.FindFirst("email")?.Value;

    public override void Dispose()
    {
        CandidateNameBroadcast.Changed -= OnProfileNameChanged;
        base.Dispose();
    }
}
