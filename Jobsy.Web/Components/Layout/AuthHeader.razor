@using System.Security.Claims
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@inject CultureState Culture
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject FeedbackHost FeedbackHost
@inject IJSRuntime Js
@implements IDisposable

<div class="auth-header">
    <AuthorizeView>
        <Authorized>
            <div class="account-menu" @onfocusout="OnFocusOut">
                <button type="button"
                        class="account-menu__toggle"
                        title="@Culture["Footer.Legal"]"
                        aria-label="@Culture["Auth.AccountMenu"]"
                        aria-haspopup="menu"
                        aria-expanded="@(_open ? "true" : "false")"
                        @onclick="Toggle">
                    <span class="auth-user" title="@EmailOf(context.User)">
                        <span class="auth-user__name">@DisplayName(context.User)</span>
                        @if (!string.IsNullOrWhiteSpace(EmailOf(context.User)))
                        {
                            <span class="auth-user__role">@EmailOf(context.User)</span>
                        }
                    </span>
                    <span class="account-menu__icon" aria-hidden="true">@((MarkupString)NavIcons.Profile)</span>
                </button>
                @if (_open)
                {
                    <div class="account-menu__panel right-0 max-w-[90vw] z-50" role="menu" aria-label="@Culture["Auth.AccountMenu"]">
                        <div class="account-menu__identity" role="presentation">
                            <strong class="account-menu__identity-name">@DisplayName(context.User)</strong>
                            @if (!string.IsNullOrWhiteSpace(EmailOf(context.User)))
                            {
                                <span class="account-menu__identity-email">@EmailOf(context.User)</span>
                            }
                        </div>
                        @if (context.User.IsInRole("Candidate"))
                        {
                            <a class="account-menu__link" href="/candidate/profile" role="menuitem">@Culture["Auth.Profile"]</a>
                            <a class="account-menu__link" href="/candidate/profile?tab=profile" role="menuitem">@Culture["Auth.Settings"]</a>
                        }
                        @if (RoleNavCatalog.HowLobsyHrefFor(context.User) is { } howHref)
                        {
                            <a class="account-menu__link" href="@howHref" role="menuitem">@Culture["Nav.HowLobsyWorks"]</a>
                        }
                        <button type="button"
                                class="account-menu__link"
                                role="menuitem"
                                @onclick="OpenFeedbackAsync">
                            @Culture["Feedback.Button"]
                        </button>
                        @if (_showInstall)
                        {
                            <button type="button"
                                    class="account-menu__link"
                                    role="menuitem"
                                    @onclick="InstallAppAsync">
                                @Culture["Pwa.InstallMenu"]
                            </button>
                        }
                        <a class="account-menu__link" href="/privacy" role="menuitem">@Culture["Footer.Privacy"]</a>
                        <a class="account-menu__link" href="/algemene-voorwaarden" role="menuitem">@Culture["Footer.Terms"]</a>
                        <a class="account-menu__link" href="/gebruiksvoorwaarden" role="menuitem">@Culture["Footer.Usage"]</a>
                        <a class="account-menu__link" href="/wie-zijn-wij" role="menuitem">@Culture["Footer.About"]</a>
                        <a class="account-menu__link" href="/westland" role="menuitem">@Culture["Footer.Westland"]</a>
                        <button type="submit"
                                form="auth-logout"
                                class="account-menu__link account-menu__link--logout"
                                role="menuitem"
                                @onclick="PrepareLogoutAsync">
                            @Culture["Auth.Logout"]
                        </button>
                    </div>
                }
            </div>
            <form id="auth-logout" method="post" action="/account/logout" class="auth-logout-form auth-logout-form--chrome visually-hidden" aria-hidden="true"
                  @onsubmit="PrepareLogoutAsync">
                @if (!string.IsNullOrEmpty(_antiforgeryFieldName) && !string.IsNullOrEmpty(_antiforgeryToken))
                {
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                }
            </form>
        </Authorized>
        <NotAuthorized>
            @if (!IsLoginRoute)
            {
                <a class="auth-link auth-link--login" href="/login">
                    <span class="auth-link__icon" aria-hidden="true">@((MarkupString)NavIcons.Login)</span>
                    <span class="auth-link__label">@Culture["Auth.Login"]</span>
                </a>
            }
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";
    private bool _open;
    private bool _showInstall;
    private bool _installChecked;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        Navigation.LocationChanged += OnLocationChanged;
        var http = HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? "";
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private bool IsLoginRoute
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relative.Split('?', '#')[0];
            return path.Equals("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("login/", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void Toggle()
        => _open = !_open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_installChecked || !firstRender)
        {
            return;
        }

        _installChecked = true;
        try
        {
            var standalone = await Js.InvokeAsync<bool>("lobsyPwaInstall.isStandalone");
            var canPrompt = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
            var ios = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            _showInstall = !standalone && (canPrompt || ios);
            if (_showInstall)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _installChecked = false;
        }
    }

    private Task OpenFeedbackAsync()
    {
        _open = false;
        FeedbackHost.RequestOpen();
        return Task.CompletedTask;
    }

    private async Task InstallAppAsync()
    {
        _open = false;
        try
        {
            var ios = await Js.InvokeAsync<bool>("lobsyPwaInstall.isIos");
            if (ios)
            {
                await Js.InvokeVoidAsync("alert", Culture["Pwa.IosHint"]);
                return;
            }

            await Js.InvokeAsync<object>("lobsyPwaInstall.prompt");
            _showInstall = await Js.InvokeAsync<bool>("lobsyPwaInstall.canPrompt");
        }
        catch
        {
            // Best-effort.
        }
    }

    private async Task PrepareLogoutAsync()
    {
        _open = false;
        try
        {
            await Js.InvokeVoidAsync("lobsyPush.dropSubscription");
        }
        catch
        {
            // Best-effort; server still revokes linked subscriptions by device session.
        }
    }

    private async Task OnFocusOut(FocusEventArgs _)
    {
        await Task.Delay(150);
        _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private string DisplayName(ClaimsPrincipal user)
    {
        var given = user.FindFirst(ClaimTypes.GivenName)?.Value
                    ?? user.FindFirst("given_name")?.Value;
        var family = user.FindFirst(ClaimTypes.Surname)?.Value
                     ?? user.FindFirst("family_name")?.Value;
        var combined = $"{given} {family}".Trim();
        if (!string.IsNullOrWhiteSpace(combined))
        {
            return combined;
        }

        var name = user.FindFirst(ClaimTypes.Name)?.Value
                   ?? user.Identity?.Name;
        // Avoid showing a region/host brand (e.g. "Westland") as if it were the person.
        if (!string.IsNullOrWhiteSpace(name)
            && !string.Equals(name, "Westland", StringComparison.OrdinalIgnoreCase)
            && name.Contains('@') == false)
        {
            return name;
        }

        return EmailOf(user) ?? Culture["Auth.User"];
    }

    private static string? EmailOf(ClaimsPrincipal user)
        => user.FindFirst(ClaimTypes.Email)?.Value
           ?? user.FindFirst("email")?.Value;

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
