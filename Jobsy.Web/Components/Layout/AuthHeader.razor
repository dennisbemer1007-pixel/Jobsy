@using System.Security.Claims
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@inject CultureState Culture
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<div class="auth-header">
    <AuthorizeView>
        <Authorized>
            <div class="account-menu" @onfocusout="OnFocusOut">
                <button type="button"
                        class="account-menu__toggle"
                        title="@Culture["Footer.Legal"]"
                        aria-label="@Culture["Auth.AccountMenu"]"
                        aria-haspopup="menu"
                        aria-expanded="@(_open ? "true" : "false")"
                        @onclick="Toggle">
                    <span class="auth-user" title="@context.User.FindFirst(ClaimTypes.Email)?.Value">
                        <span class="auth-user__name">@DisplayName(context.User)</span>
                        <span class="auth-user__role">@RoleLabel(context.User)</span>
                    </span>
                    <span class="account-menu__icon" aria-hidden="true">@((MarkupString)NavIcons.Profile)</span>
                </button>
                @if (_open)
                {
                    <div class="account-menu__panel" role="menu" aria-label="@Culture["Auth.AccountMenu"]">
                        <a class="account-menu__link" href="/privacy" role="menuitem">@Culture["Footer.Privacy"]</a>
                        <a class="account-menu__link" href="/algemene-voorwaarden" role="menuitem">@Culture["Footer.Terms"]</a>
                        <a class="account-menu__link" href="/gebruiksvoorwaarden" role="menuitem">@Culture["Footer.Usage"]</a>
                        <a class="account-menu__link" href="/wie-zijn-wij" role="menuitem">@Culture["Footer.About"]</a>
                        <a class="account-menu__link" href="/westland" role="menuitem">@Culture["Footer.Westland"]</a>
                        <button type="submit"
                                form="auth-logout"
                                class="account-menu__link account-menu__link--logout"
                                role="menuitem">
                            @Culture["Auth.Logout"]
                        </button>
                    </div>
                }
            </div>
            <form id="auth-logout" method="post" action="/account/logout" class="auth-logout-form auth-logout-form--chrome">
                @if (!string.IsNullOrEmpty(_antiforgeryFieldName) && !string.IsNullOrEmpty(_antiforgeryToken))
                {
                    <input type="hidden" name="@_antiforgeryFieldName" value="@_antiforgeryToken" />
                }
                <button type="submit"
                        class="auth-icon-btn"
                        title="@Culture["Auth.Logout"]"
                        aria-label="@Culture["Auth.Logout"]">
                    <span class="auth-icon-btn__icon" aria-hidden="true">@((MarkupString)NavIcons.Logout)</span>
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a class="auth-link auth-link--login" href="/login">
                <span class="auth-link__icon" aria-hidden="true">@((MarkupString)NavIcons.Login)</span>
                <span class="auth-link__label">@Culture["Auth.Login"]</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string _antiforgeryFieldName = "";
    private string _antiforgeryToken = "";
    private bool _open;

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        var http = HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryToken = tokens.RequestToken ?? "";
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private void Toggle()
        => _open = !_open;

    private async Task OnFocusOut(FocusEventArgs _)
    {
        await Task.Delay(150);
        _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private string DisplayName(ClaimsPrincipal user)
        => user.Identity?.Name
           ?? user.FindFirst(ClaimTypes.Email)?.Value
           ?? Culture["Auth.User"];

    private string RoleLabel(ClaimsPrincipal user)
    {
        var role = user.FindFirst(ClaimTypes.Role)?.Value;
        return role switch
        {
            "BranchManager" or "Manager" => Culture["Role.BranchManager"],
            "RegionalManager" => Culture["Role.RegionalManager"],
            "EnterpriseManager" => Culture["Role.EnterpriseManager"],
            "Intermediary" => Culture["Role.Intermediary"],
            "Admin" => Culture["Role.Admin"],
            "SalesManager" => Culture["Role.SalesManager"],
            "Ambassadeur" => Culture["Role.Ambassadeur"],
            "Candidate" => Culture["Role.Candidate"],
            _ => role ?? Culture["Auth.User"]
        };
    }

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
