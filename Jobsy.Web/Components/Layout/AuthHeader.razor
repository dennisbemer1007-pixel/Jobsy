@using System.Security.Claims
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Authorization
@inject CultureState Culture
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<div class="auth-header">
    <AuthorizeView>
        <Authorized>
            <div class="auth-user" title="@context.User.FindFirst(ClaimTypes.Email)?.Value">
                <span class="auth-user__name">@DisplayName(context.User)</span>
                <span class="auth-user__role">@RoleLabel(context.User)</span>
            </div>
            <form method="post" action="/account/logout" class="auth-logout-form">
                <input type="hidden" name="__RequestVerificationToken" value="@_antiforgeryToken" />
                <button type="submit"
                        class="auth-icon-btn"
                        title="@Culture["Auth.Logout"]"
                        aria-label="@Culture["Auth.Logout"]">
                    <span class="auth-icon-btn__icon" aria-hidden="true">@((MarkupString)NavIcons.Logout)</span>
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a class="auth-link auth-link--login" href="/login">
                <span class="auth-link__icon" aria-hidden="true">@((MarkupString)NavIcons.Login)</span>
                <span class="auth-link__label">@Culture["Auth.Login"]</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string _antiforgeryToken = "";

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
        var http = HttpContextAccessor.HttpContext;
        if (http is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(http);
            _antiforgeryToken = tokens.RequestToken ?? "";
        }
    }

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    private string DisplayName(ClaimsPrincipal user)
        => user.Identity?.Name
           ?? user.FindFirst(ClaimTypes.Email)?.Value
           ?? Culture["Auth.User"];

    private string RoleLabel(ClaimsPrincipal user)
    {
        var role = user.FindFirst(ClaimTypes.Role)?.Value;
        return role switch
        {
            "BranchManager" or "Manager" => Culture["Role.BranchManager"],
            "RegionalManager" => Culture["Role.RegionalManager"],
            "EnterpriseManager" => Culture["Role.EnterpriseManager"],
            "Intermediary" => Culture["Role.Intermediary"],
            "Admin" => Culture["Role.Admin"],
            "SalesManager" => Culture["Role.SalesManager"],
            "Candidate" => Culture["Role.Candidate"],
            _ => role ?? Culture["Auth.User"]
        };
    }

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;
}
