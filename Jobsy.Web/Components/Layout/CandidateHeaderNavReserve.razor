@using Jobsy.Core.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture

@* Stable first-paint desktop nav (no interactive delay). Hidden once Blazor nav is interactive. *@
<nav class="app-header__nav candidate-header-nav candidate-header-nav--reserve"
     aria-hidden="true"
     data-testid="candidate-header-nav-reserve">
    @foreach (var item in RoleNavCatalog.CandidateItems(FeatureFlagSnapshot.Defaults))
    {
        var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
            ? Culture[item.ShortTitleKey!]
            : Culture[item.TitleKey];
        <a class="candidate-header-nav__link"
           href="@item.Href"
           tabindex="-1">@shortTitle</a>
    }
</nav>
