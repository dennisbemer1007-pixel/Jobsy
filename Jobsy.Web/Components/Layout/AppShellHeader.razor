@using Jobsy.Core.Authorization
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Pwa
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpContextAccessor HttpContextAccessor

<header class="app-header" data-testid="app-shell-header">
    <div class="app-header__brand">
        <a class="brand" href="@HomeHref" aria-label="Lobsy">
            @if (_useOnboardingBrandMark)
            {
                <img class="brand__logo brand__logo--app-icon"
                     src="@BrandImages.AppIconSvg"
                     width="48"
                     height="48"
                     alt=""
                     decoding="async"
                     data-logo-fallback="off"
                     draggable="false" />
            }
            else
            {
                <LobsyLogo Class="brand__logo" Alt="Lobsy" Variant="LobsyLogoVariant.Horizontal" />
            }
            <span class="brand__text">
                <span class="brand-tagline">@HeaderTagline</span>
            </span>
        </a>
    </div>
    @if (_showCandidateHeaderNav)
    {
        <div class="candidate-header-nav-slot">
            @if (_noBlazorRuntime)
            {
                <NoBlazorCandidateNav RenderPart="NoBlazorCandidateNav.Part.Header" />
            }
            else
            {
                <CandidateHeaderNav />
            }
        </div>
    }
    <div class="app-header__actions">
        @if (ShowCandidatePwaInstall)
        {
            <AuthorizeView Roles="@JobsyRoles.Candidate">
                <Authorized>
                    <Jobsy.Web.Components.Candidate.Pwa.CandidatePwaInstallEntry />
                </Authorized>
            </AuthorizeView>
        }
        <PageHelp />
        <NotificationBell />
        <FeatureVisible Feature="PlatformFeature.Employers">
            <TokenWalletChip />
            <SalesWalletChipV2 />
        </FeatureVisible>
        <LanguageSelector />
        <AuthHeader />
    </div>
</header>

@code {
    private bool _showCandidateHeaderNav;
    private bool _useOnboardingBrandMark;
    private bool _noBlazorRuntime;

    protected override void OnInitialized()
    {
        var http = HttpContextAccessor.HttpContext;
        var user = http?.User;
        _noBlazorRuntime = http?.GetEndpoint()?.Metadata.GetMetadata<NoBlazorRuntimeAttribute>() is not null;
        _showCandidateHeaderNav = user?.Identity?.IsAuthenticated == true
            && RoleClaimMatching.HasRole(user, JobsyRoles.Candidate);
        var path = http?.Request.Path.Value ?? "";
        _useOnboardingBrandMark = path.Contains("/candidate/ontdekkingsreis", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/candidate/paspoort", StringComparison.OrdinalIgnoreCase)
            || path.Equals("/banenkaart", StringComparison.OrdinalIgnoreCase)
            || path.Equals("/banen", StringComparison.OrdinalIgnoreCase);
    }

    [Parameter, EditorRequired]
    public string HomeHref { get; set; } = "/";

    [Parameter, EditorRequired]
    public string HeaderTagline { get; set; } = "";

    [Parameter]
    public bool ShowCandidatePwaInstall { get; set; }
}
