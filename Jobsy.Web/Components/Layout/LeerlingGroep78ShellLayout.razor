@namespace Jobsy.Web.Components.Layout
@using System.Security.Claims
@using Jobsy.Core.Authorization
@using Jobsy.Web.Security
@using Jobsy.Web.Services
@inherits LayoutComponentBase
@inject CultureState Culture
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthState
@inject Jobsy.Web.Scholen.LeerlingGroep78ShellTheme ShellTheme
@implements IDisposable

<div class="ll-g78-shell @ShellTheme.CssClass" lang="@Culture.Language">
    <header class="top">
        <a class="brand" href="/leerling/wereld">
            <img src="/leerling/werelden/img/embleem.png" width="40" height="40" alt="" />
            Lobsy
            <small>@Culture[ShellTheme.HeaderSmallKey]</small>
        </a>
        <div class="sp"></div>
        @if (!string.IsNullOrEmpty(_chip))
        {
            <span class="chip-code">@_chip</span>
        }
        @if (_showPause)
        {
            <form method="post" action="/leerling/pauze">
                <AntiforgeryToken />
                <button type="submit" class="btn-pauze">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                    <span>@Culture["Leerling.Pause"]</span>
                </button>
            </form>
        }
    </header>
    @Body
    <footer>
        <a href="@PublicRoutes.Privacy">@Culture["Footer.Privacy"]</a>
        <a href="@PublicRoutes.Accessibility">@Culture["PublicFooter.Accessibility"]</a>
    </footer>
</div>

@code {
    private string _chip = "";
    private bool _showPause = true;
    private IDisposable? _displayLanguage;

    protected override void OnInitialized()
    {
        ShellTheme.Changed += OnShellThemeChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var http = HttpContextAccessor.HttpContext;
        var lang = http?.Request.Query["lang"].ToString();
        if (!string.IsNullOrWhiteSpace(lang))
        {
            _displayLanguage?.Dispose();
            _displayLanguage = Culture.PushDisplayLanguage(lang);
        }
        else
        {
            _displayLanguage ??= Culture.PushDisplayLanguage("nl");
        }

        _chip = "";
        var pupil = PupilFromRequest();
        if (pupil is null)
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (JobsyApiAuthHandler.IsPupilPrincipal(state.User))
            {
                pupil = state.User;
            }
        }

        if (pupil is not null)
        {
            var cls = pupil.FindFirst(PupilClaimTypes.ClassLabel)?.Value;
            var code = pupil.FindFirst(PupilClaimTypes.CodeDisplay)?.Value;
            if (!string.IsNullOrWhiteSpace(cls) && !string.IsNullOrWhiteSpace(code))
            {
                _chip = $"{cls} · {code}";
            }
        }
    }

    private ClaimsPrincipal? PupilFromRequest()
    {
        var http = HttpContextAccessor.HttpContext;
        if (http?.Items[LeerlingNoStoreMiddleware.PupilPrincipalItemKey] is ClaimsPrincipal pupil
            && pupil.Identity?.IsAuthenticated == true
            && JobsyApiAuthHandler.IsPupilPrincipal(pupil))
        {
            return pupil;
        }

        return null;
    }

    private void OnShellThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = Nav.ToBaseRelativePath(e.Location).Split('?', 2)[0];
        if (path.Equals("leerling/wereld", StringComparison.OrdinalIgnoreCase))
        {
            ShellTheme.Reset();
        }
    }

    public void Dispose()
    {
        ShellTheme.Changed -= OnShellThemeChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _displayLanguage?.Dispose();
    }
}
