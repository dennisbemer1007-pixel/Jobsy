@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <AuthHeader />
    </Authorized>
    <NotAuthorized>
        <a class="pub-header__login" href="@PublicRoutes.Login">@Culture["PublicNav.Login"]</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private CultureState Culture { get; set; } = default!;
}
