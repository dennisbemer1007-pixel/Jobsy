@inject JobsyApiClient Api
@inject CultureState Culture

<LobsyFriendlyDialog IsOpen="@(IsOpen && Vacancy is not null)"
                     Title="@Culture["PushBom.Title"]"
                     TitleId="pushbom-modal-title"
                     Lead="@(Vacancy is null ? null : $"{Vacancy.Title} · {Vacancy.CompanyName}")"
                     Class="publish-modal"
                     CloseDisabled="_busy"
                     OnClose="Close">
    <div class="pushbom-preview" aria-live="polite">
        @if (_loading)
        {
            <p class="muted">@Culture["Employer.ReachCalculating"]</p>
        }
        else if (!string.IsNullOrEmpty(_loadError))
        {
            <p class="state-message error">@_loadError</p>
        }
        else if (_preview is not null)
        {
            <p class="pushbom-preview__count">
                <strong>@_preview.CandidateCount</strong>
                @( _preview.CandidateCount == 1 ? "geschikte kandidaat" : "geschikte kandidaten" )
                in bereik
            </p>
            <p class="muted">
                Binnen @_preview.RadiusKm.ToString("0.#") km en @_preview.MaxTravelMinutes min reistijd
                (Open for work)
            </p>
            @if (_preview.CandidateCount == 0)
            {
                <p class="state-message error">Geen bereik — PushBom kan niet worden geactiveerd. Geen tokens worden afgeschreven.</p>
            }
            else if (!_preview.HasPricing)
            {
                <p class="state-message error">Geen tokenprijs voor dit bereik geconfigureerd (admin settings).</p>
            }
            else
            {
                <p class="pushbom-preview__cost">
                    Dit kost <strong>@_preview.CostTokens.ToString("0.##")</strong> token(s)
                </p>
                <p class="muted">Huidig saldo: @_preview.TokenBalance.ToString("0.##") token(s)</p>
                @if (!_preview.CanAfford)
                {
                    <p class="state-message error">Je tokens zijn op — koop tokens om PushBom te activeren.</p>
                    <button type="button" class="btn-compact btn-compact--primary" style="margin-top:0.5rem" @onclick="OpenTopUpFromPreview">
                        Tokens kopen
                    </button>
                }
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
<div class="inline-actions">
            <button type="button" class="btn-compact btn-compact--primary" disabled="@ConfirmDisabled" @onclick="ConfirmAsync">
                @(_busy ? Culture["Common.Busy"] : Culture["PushBom.Confirm"])
            </button>
            <button type="button" class="btn-compact" disabled="@_busy" @onclick="Close">@Culture["Common.Cancel"]</button>
        </div>
</LobsyFriendlyDialog>

<TokenTopUpDialog IsOpen="_topUpOpen" Info="_topUpInfo" OnClose="CloseTopUp" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public VacancyListItem? Vacancy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<VacancyProductActionResult?> OnConfirmed { get; set; }

    private bool _loading;
    private bool _busy;
    private string? _loadError;
    private string? _error;
    private PushBomPreview? _preview;
    private Guid? _loadedForVacancyId;
    private bool _topUpOpen;
    private InsufficientTokensInfo? _topUpInfo;

    private bool ConfirmDisabled =>
        _busy
        || _loading
        || _preview is null
        || _preview.CandidateCount == 0
        || !_preview.HasPricing
        || !_preview.CanAfford;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || Vacancy is null)
        {
            return;
        }

        if (_loadedForVacancyId == Vacancy.Id && (_preview is not null || !string.IsNullOrEmpty(_loadError)))
        {
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        if (Vacancy is null)
        {
            return;
        }

        _loading = true;
        _loadError = null;
        _error = null;
        _preview = null;
        _loadedForVacancyId = Vacancy.Id;
        try
        {
            _preview = await Api.PreviewPushBomAsync(Vacancy.Id);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task Close()
    {
        _error = null;
        _loadError = null;
        _preview = null;
        _loadedForVacancyId = null;
        return OnClose.InvokeAsync();
    }

    private async Task ConfirmAsync()
    {
        if (Vacancy is null || ConfirmDisabled)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.PushBomVacancyAsync(Vacancy.Id);
            await OnConfirmed.InvokeAsync(result);
            await Close();
        }
        catch (InsufficientTokensException ex)
        {
            _topUpInfo = ex.Info;
            _topUpOpen = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenTopUpFromPreview()
    {
        if (Vacancy is null || _preview is null)
        {
            return;
        }

        _topUpInfo = new InsufficientTokensInfo
        {
            Message = "Je tokens zijn op. Koop tokens om PushBom te activeren.",
            CompanyId = Vacancy.CompanyId,
            VacancyId = Vacancy.Id,
            Action = "PushBom",
            RequiredTokens = _preview.CostTokens,
            Balance = _preview.TokenBalance,
            Deficit = Math.Max(0m, _preview.CostTokens - _preview.TokenBalance)
        };
        _topUpOpen = true;
    }

    private Task CloseTopUp()
    {
        _topUpOpen = false;
        _topUpInfo = null;
        return Task.CompletedTask;
    }
}
