@inject JobsyApiClient Api

@if (IsOpen && Vacancy is not null)
{
    <div class="share-modal-backdrop" @onclick="Close"></div>
    <div class="share-modal publish-modal" role="dialog" aria-modal="true" aria-labelledby="pushbom-modal-title">
        <div class="share-modal__header">
            <h2 id="pushbom-modal-title">PushBom activeren</h2>
            <button type="button" class="share-modal__close" @onclick="Close" aria-label="Sluiten">×</button>
        </div>
        <p class="share-modal__lead">@Vacancy.Title · @Vacancy.CompanyName</p>

        <div class="pushbom-preview" aria-live="polite">
            @if (_loading)
            {
                <p class="muted">Bereik berekenen…</p>
            }
            else if (!string.IsNullOrEmpty(_loadError))
            {
                <p class="state-message error">@_loadError</p>
            }
            else if (_preview is not null)
            {
                <p class="pushbom-preview__count">
                    <strong>@_preview.CandidateCount</strong>
                    @( _preview.CandidateCount == 1 ? "geschikte kandidaat" : "geschikte kandidaten" )
                    in bereik
                </p>
                <p class="muted">
                    Binnen @_preview.RadiusKm.ToString("0.#") km en @_preview.MaxTravelMinutes min reistijd
                    (Open for work)
                </p>
                @if (_preview.CandidateCount == 0)
                {
                    <p class="state-message error">Geen bereik — PushBom kan niet worden geactiveerd. Geen tokens worden afgeschreven.</p>
                }
                else if (!_preview.HasPricing)
                {
                    <p class="state-message error">Geen tokenprijs voor dit bereik geconfigureerd (admin settings).</p>
                }
                else
                {
                    <p class="pushbom-preview__cost">
                        Dit kost <strong>@_preview.CostTokens.ToString("0.##")</strong> token(s)
                    </p>
                    <p class="muted">Huidig saldo: @_preview.TokenBalance.ToString("0.##") token(s)</p>
                    @if (!_preview.CanAfford)
                    {
                        <p class="state-message error">Onvoldoende tokens om PushBom te activeren.</p>
                    }
                }
            }
        </div>

        <div class="inline-actions" style="margin-top:1rem">
            <button type="button" class="login-submit" disabled="@ConfirmDisabled" @onclick="ConfirmAsync">
                @(_busy ? "Bezig…" : "Activeer en reken af")
            </button>
            <button type="button" class="provider-btn" disabled="@_busy" @onclick="Close">Annuleren</button>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error">@_error</p>
        }
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public VacancyListItem? Vacancy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<VacancyProductActionResult?> OnConfirmed { get; set; }

    private bool _loading;
    private bool _busy;
    private string? _loadError;
    private string? _error;
    private PushBomPreview? _preview;
    private Guid? _loadedForVacancyId;

    private bool ConfirmDisabled =>
        _busy
        || _loading
        || _preview is null
        || _preview.CandidateCount == 0
        || !_preview.HasPricing
        || !_preview.CanAfford;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || Vacancy is null)
        {
            return;
        }

        if (_loadedForVacancyId == Vacancy.Id && (_preview is not null || !string.IsNullOrEmpty(_loadError)))
        {
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        if (Vacancy is null)
        {
            return;
        }

        _loading = true;
        _loadError = null;
        _error = null;
        _preview = null;
        _loadedForVacancyId = Vacancy.Id;
        try
        {
            _preview = await Api.PreviewPushBomAsync(Vacancy.Id);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task Close()
    {
        _error = null;
        _loadError = null;
        _preview = null;
        _loadedForVacancyId = null;
        return OnClose.InvokeAsync();
    }

    private async Task ConfirmAsync()
    {
        if (Vacancy is null || ConfirmDisabled)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.PushBomVacancyAsync(Vacancy.Id);
            await OnConfirmed.InvokeAsync(result);
            await Close();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
