@using Jobsy.Core.Contracts
@using Jobsy.Core.Enums
@using Jobsy.Web.Components
@using Jobsy.Web.Localization
@inject CultureState Culture

@{
    var screen = ScreenId?.Trim().PadLeft(2, '0') ?? "01";
    var isEmployer = screen is "02" or "03" or "06" or "09" or "11" or "12";
}

<div class="ndm ndm-page" data-testid="ndm-preview" data-ndm-screen="@screen" data-ndm-role="@(isEmployer ? "werkgever" : "kandidaat")">
    @if (isEmployer)
    {
        <div class="wm">
            @RenderEmployer(screen)
        </div>
    }
    else
    {
        <main class="wrap">
            @RenderCandidate(screen)
        </main>
    }
</div>

@code {
    [Parameter] public string? ScreenId { get; set; }

    private RenderFragment RenderCandidate(string screen) => __builder =>
    {
        switch (screen)
        {
            case "01":
                <NdMHero Title="@Culture["AfterMatch.Screen01.Hero.Title"]" Lead="@Culture["AfterMatch.Screen01.Hero.Lead"]" />
                <div class="g2">
                    <div class="stack">
                        <div class="card">
                            <NdMVacancyCard Initials="DK" Title="@Culture["AfterMatch.Demo.Vacancy"]" Subtitle="@($"{Culture["AfterMatch.Demo.Company"]} · {Culture["AfterMatch.Demo.Location"]}")" />
                            <div class="hr"></div>
                            <NdMTimeline CurrentStep="1" YesDate="13 okt" />
                            <NdMWhatGrid />
                        </div>
                        <div class="card">
                            <div class="row wrapflex">
                                <span class="ico">@((MarkupString)NdMIcons.Calendar)</span>
                                <div class="sp" style="min-width:220px">
                                    <b style="color:var(--brand)">@Culture["AfterMatch.Screen01.Wait.Title"]</b>
                                    <p class="small muted">@Culture["AfterMatch.Screen01.Wait.Body"]</p>
                                </div>
                                <span class="btn line sm">@Culture["AfterMatch.Screen01.Preference"]</span>
                            </div>
                        </div>
                    </div>
                    <NdMMessagePanel Messages="NdMDemoData.DemoThread().Messages" ShowNewPill="true" SystemLine="@($"{Culture["AfterMatch.Screen10.SysContact"]} · 13 oktober")" />
                </div>;
                break;
            case "04":
                <NdMHero Title="@Culture["AfterMatch.Screen04.Hero.Title"]" Lead="@Culture["AfterMatch.Screen04.Hero.Lead"]" />
                <NdMSchedulingPanel Mode="NdMSchedulingMode.CandidatePick" OpenSlots="NdMDemoData.DemoSlots()" />;
                break;
            case "05":
                <NdMHero Title="@Culture["AfterMatch.Screen05.Hero.Title"]" Lead="@Culture["AfterMatch.Screen05.Hero.Lead"]" />
                <NdMTimeline CurrentStep="2" YesDate="13 okt" InterviewHint="22 okt" />
                <NdMSchedulingPanel Mode="NdMSchedulingMode.Scheduled"
                                    ScheduledLabel="Donderdag 22 oktober, 10:30"
                                    LocationOrLink="@Culture["AfterMatch.Demo.Location"]" />;
                <NdMReminderPanel Preference="NdMDemoData.DemoThread(InterviewStatus.Scheduled).ReminderPreference" />;
                break;
            case "06":
                <p class="crumb">@Culture["AfterMatch.Screen06.Crumb"]</p>
                <h1 style="font-size:1.8rem;margin-bottom:14px">@Culture["AfterMatch.Screen06.Title"]</h1>
                <div class="g2b ndm-mail-grid">
                    <div>
                        <span class="lbl">@Culture["AfterMatch.Screen06.CandidateMail"]</span>
                        <div class="mclient">
                            <div class="mhead"><b>Lobsy</b> &lt;gesprek@lobsy.nl&gt;</div>
                            <div class="mail">
                                <h2>@Culture["AfterMatch.Screen05.Hero.Title"]</h2>
                                <p class="small">@Culture["AfterMatch.Screen05.Hero.Lead"]</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="lbl">@Culture["AfterMatch.Screen06.EmployerMail"]</span>
                        <div class="mclient">
                            <div class="mhead"><b>Lobsy</b> &lt;gesprek@lobsy.nl&gt;</div>
                            <div class="mail">
                                <h2>@Culture["AfterMatch.Screen03.Hero.Title"]</h2>
                                <p class="small">@Culture["AfterMatch.Screen02.Hero.Lead"]</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" style="margin-top:16px">
                    <b style="color:var(--brand)">@Culture["AfterMatch.Screen06.After.Title"]</b>
                    <p class="small muted">@Culture["AfterMatch.Screen06.After.Body"]</p>
                </div>;
                break;
            case "07":
                <p class="crumb">@Culture["AfterMatch.Screen07.Crumb"]</p>
                <h1 style="font-size:1.8rem;margin-bottom:14px">@Culture["AfterMatch.Screen07.Title"]</h1>
                <div class="mgrid">
                    <div>
                        <span class="lbl">@Culture["AfterMatch.Screen07.EmailLabel"]</span>
                        <div class="mclient">
                            <div class="mail ndm-mail-preview">
                                <div class="mtop">
                                    <span class="ndm-mail-logo"><LobsyMark /></span>
                                    <span class="xs muted">@Culture["AfterMatch.Mail.PlannedTag"]</span>
                                </div>
                                <p class="xs muted ndm-mail-from"><b>Lobsy</b> &lt;gesprek@lobsy.nl&gt;</p>
                                <h2>Morgen is je gesprek</h2>
                                <p class="small">Hoi Sanne, nog even op een rij. Je kunt het.</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="lbl">@Culture["AfterMatch.Screen07.PushLabel"]</span>
                        <div class="phone">
                            <div class="lock">
                                <div class="ltime">8:30</div>
                                <div class="push"><div><b>Over 2 uur je gesprek</b></div></div>
                            </div>
                        </div>
                        <NdMReminderPanel Preference="NdMDemoData.DemoThread(InterviewStatus.Scheduled).ReminderPreference" />
                    </div>
                </div>;
                break;
            case "08":
                <NdMHero Title="@Culture["AfterMatch.Screen08.Hero.Title"]" Lead="@Culture["AfterMatch.Screen08.Hero.Lead"]" />
                <div class="card stack">
                    <label class="lbl">@Culture["AfterMatch.Screen08.Reason"]</label>
                    <div class="inp area">@Culture["AfterMatch.Screen08.Reschedule"]</div>
                    <div class="row wrapflex">
                        <span class="btn">@Culture["AfterMatch.Screen08.Reschedule"]</span>
                        <span class="btn line">@Culture["AfterMatch.Screen08.Cancel"]</span>
                    </div>
                </div>;
                break;
            case "10":
                <NdMHero Title="@Culture["AfterMatch.Screen10.Hero.Title"]" Lead="@Culture["AfterMatch.Screen10.Hero.Lead"]" ShowArt="false" />
                <NdMMessagePanel Messages="NdMDemoData.DemoThread().Messages" Editable="true" SystemLine="@($"{Culture["AfterMatch.Screen10.SysContact"]} · 13 oktober")" />;
                break;
            case "13":
                <NdMHero Title="@Culture["AfterMatch.Screen13.Hero.Title"]" Lead="@Culture["AfterMatch.Screen13.Hero.Lead"]" />
                <div class="card">
                    <b>@Culture["AfterMatch.Screen13.Similar"]</b>
                    <div class="list">
                        <div><span class="pill ok">@Culture["AfterMatch.Demo.Vacancy"]</span><span class="small muted">@Culture["AfterMatch.Demo.Company"]</span></div>
                    </div>
                </div>;
                break;
            default:
                <NdMHero Title="@Culture["AfterMatch.Screen01.Hero.Title"]" Lead="@Culture["AfterMatch.Screen01.Hero.Lead"]" />;
                break;
        }
    };

    private RenderFragment RenderEmployer(string screen) => __builder =>
    {
        switch (screen)
        {
            case "02":
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen02.Hero.Title"]</h1><p>@Culture["AfterMatch.Screen02.Hero.Lead"]</p></div>
                <div class="wc stack">
                    <b>@Culture["AfterMatch.Screen02.Next.Title"]</b>
                    <span class="btn sm">@Culture["AfterMatch.Screen02.Next.Slots"]</span>
                    <span class="btn line sm">@Culture["AfterMatch.Screen02.Next.Messages"]</span>
                </div>;
                break;
            case "03":
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen03.Hero.Title"]</h1><p>@Culture["AfterMatch.Screen03.Hero.Lead"]</p></div>
                <NdMSchedulingPanel Mode="NdMSchedulingMode.EmployerPropose" OpenSlots="NdMDemoData.DemoSlots()" />;
                break;
            case "09":
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen09.Hero.Title"]</h1><p>@Culture["AfterMatch.Screen09.Hero.Lead"]</p></div>;
                break;
            case "11":
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen11.Hero.Title"]</h1><p>@Culture["AfterMatch.Screen11.Hero.Lead"]</p></div>
                <NdMMessagePanel Messages="NdMDemoData.DemoThread().Messages" Editable="true" />;
                break;
            case "12":
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen12.Hero.Title"]</h1><p>@Culture["AfterMatch.Screen12.Hero.Lead"]</p></div>
                <div class="outc">
                    <div class="on"><b>@Culture["AfterMatch.Screen12.Offer"]</b></div>
                    <div><b>@Culture["AfterMatch.Screen12.NextRound"]</b></div>
                    <div><b>@Culture["AfterMatch.Screen12.NotNow"]</b></div>
                </div>;
                break;
            default:
                <div class="wtitle"><h1>@Culture["AfterMatch.Screen02.Hero.Title"]</h1></div>;
                break;
        }
    };
}
