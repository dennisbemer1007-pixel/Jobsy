@inject JobsyApiClient Api
@inject NavigationManager Navigation
@inject CultureState Culture

<LobsyFriendlyDialog IsOpen="IsOpen"
                     Title="Even bijtanken"
                     TitleId="token-topup-title"
                     Class="publish-modal token-topup-modal"
                     CloseDisabled="_busy"
                     OnClose="Close">
<p class="share-modal__lead lobsy-dialog__lead">
            @(string.IsNullOrWhiteSpace(ActionLabel) ? "Deze actie" : ActionLabel)
            vraagt om tokens. Geen stress — kies een pakket en we helpen je meteen verder.
        </p>
@if (_loading)
    {
        <p class="muted">Opties laden…</p>
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <p class="state-message error">@_loadError</p>
    }
    else if (_quote is not null)
    {
        <p class="muted">
            Benodigd: <strong>@_quote.RequiredTokens.ToString("0.##")</strong>
            · saldo: <strong>@_quote.Balance.ToString("0.##")</strong>
            · tekort: <strong>@_quote.Deficit.ToString("0.##")</strong>
        </p>

        <fieldset class="token-topup-options">
            <legend>Tokenpakket (prepaid via Mollie)</legend>
            <div class="token-pack-options" role="radiogroup" aria-label="Tokenpakket">
            @if (_quote.ExactMatchTokens > 0)
            {
                <label class="scope-option token-pack-option @(_selectedPack == _quote.ExactMatchTokens ? "is-selected" : null)">
                    <input type="radio" name="topup-pack" checked="@(_selectedPack == _quote.ExactMatchTokens)"
                           @onchange="() => SelectPack(_quote.ExactMatchTokens)" />
                    <span>
                        <strong>Exact</strong>
                        <span class="muted">@_quote.ExactMatchTokens token(s) · € @_quote.ExactMatchPriceEuro.ToString("0.00")</span>
                    </span>
                </label>
            }

            @foreach (var pack in _quote.BulkPacks)
            {
                <label class="scope-option token-pack-option @(_selectedPack == pack.PackSize ? "is-selected" : null)">
                    <input type="radio" name="topup-pack" checked="@(_selectedPack == pack.PackSize)"
                           @onchange="() => SelectPack(pack.PackSize)" />
                    <span>
                        <strong>@pack.PackSize tokens</strong>
                        <span class="muted">€ @pack.PriceEuro.ToString("0.00")</span>
                    </span>
                </label>
            }
            </div>
        </fieldset>

        <PaymentMethodPicker @bind-SelectedMethod="_paymentMethod"
                             @bind-RememberPreference="_rememberPaymentMethod"
                             ShowRememberPreference="true"
                             Compact="true"
                             Disabled="_busy"
                             Lead="Kies iDEAL of creditcard voordat je naar Mollie gaat. Na betaling schrijft de webhook tokens bij en voert je actie (publiceren, PushBom, …) direct uit." />
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
<div class="inline-actions">
            <button type="button" class="btn-compact btn-compact--primary" disabled="@ConfirmDisabled" @onclick="PayAsync">
                @(_busy ? Culture["Common.Busy"] : (_paymentMethod == "creditcard" ? "Doorgaan met creditcard" : "Doorgaan met iDEAL"))
            </button>
            <button type="button" class="btn-compact" disabled="@_busy" @onclick="Close">@Culture["Common.Cancel"]</button>
        </div>
</LobsyFriendlyDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public InsufficientTokensInfo? Info { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _loading;
    private bool _busy;
    private string? _loadError;
    private string? _error;
    private TokenTopUpQuote? _quote;
    private int _selectedPack;
    private string _paymentMethod = "ideal";
    private bool _rememberPaymentMethod;
    private Guid? _loadedFor;

    private string ActionLabel => Info?.Action switch
    {
        "Publish" => "Publiceren",
        "Highlight" => "Highlighten",
        "PushBom" => "PushBom",
        "Extend" => "Verlengen",
        _ => Info?.Action ?? "Deze actie"
    };

    private bool ConfirmDisabled =>
        _busy || _loading || _quote is null || _selectedPack <= 0 || Info is null
        || _paymentMethod is not ("ideal" or "creditcard");

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || Info is null)
        {
            return;
        }

        if (_loadedFor == Info.VacancyId && _quote is not null)
        {
            return;
        }

        await LoadQuoteAsync();
    }

    private async Task LoadQuoteAsync()
    {
        if (Info is null)
        {
            return;
        }

        _loading = true;
        _loadError = null;
        _error = null;
        _quote = null;
        _loadedFor = Info.VacancyId;
        try
        {
            _quote = await Api.GetTokenTopUpQuoteAsync(Info.CompanyId, Info.RequiredTokens);
            if (_quote is null)
            {
                _loadError = "Kon betaalopties niet laden.";
                return;
            }

            _selectedPack = _quote.ExactMatchTokens > 0
                ? _quote.ExactMatchTokens
                : _quote.BulkPacks.FirstOrDefault()?.PackSize ?? 0;

            try
            {
                var companies = await Api.GetMyCompaniesAsync();
                var company = companies.FirstOrDefault(c => c.Id == Info.CompanyId)
                    ?? companies.FirstOrDefault(c => c.Id == Info.CompanyId || c.ParentCompanyId is null);
                _paymentMethod = string.Equals(
                    company?.PreferredPaymentMethod, "creditcard", StringComparison.OrdinalIgnoreCase)
                    ? "creditcard"
                    : "ideal";
            }
            catch
            {
                _paymentMethod = "ideal";
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectPack(int packSize) => _selectedPack = packSize;

    private Task Close()
    {
        _error = null;
        _loadError = null;
        _quote = null;
        _loadedFor = null;
        _selectedPack = 0;
        return OnClose.InvokeAsync();
    }

    private async Task PayAsync()
    {
        if (Info is null || ConfirmDisabled)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (_rememberPaymentMethod)
            {
                await Api.UpdateBillingPreferenceAsync(Info.CompanyId, _paymentMethod);
            }

            var result = await Api.CreateTokenCheckoutAsync(
                Info.CompanyId,
                _selectedPack,
                new PendingActionCheckoutRequest
                {
                    VacancyId = Info.VacancyId,
                    Action = Info.Action,
                    Highlight = Info.Highlight,
                    PushBom = Info.PushBom,
                    Extend = Info.Extend,
                    RequiredTokens = Info.RequiredTokens
                },
                paymentMethod: _paymentMethod);

            if (result is null || string.IsNullOrWhiteSpace(result.CheckoutUrl))
            {
                _error = "Checkout starten mislukt.";
                return;
            }

            Navigation.NavigateTo(result.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
