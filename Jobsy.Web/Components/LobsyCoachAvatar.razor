@namespace Jobsy.Web.Components
@using System.Threading
@using Jobsy.Core.Localization

<span class="lobsy-coach @(Animate ? "lobsy-coach--animate" : null) @Class"
      role="@(string.IsNullOrEmpty(Alt) ? null : "img")"
      aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : null)"
      aria-label="@(string.IsNullOrEmpty(Alt) ? null : Alt)">
    <svg class="lobsy-coach__svg" viewBox="0 0 1024 1024" focusable="false" aria-hidden="true">
        <defs>
            <mask id="@BodyMaskId" maskUnits="userSpaceOnUse">
                <rect width="1024" height="1024" fill="#fff" />
                <polygon points="@LeftClawPoints" fill="#000" />
                <polygon points="@RightClawPoints" fill="#000" />
            </mask>
            <clipPath id="@LeftClawClipId" clipPathUnits="userSpaceOnUse">
                <polygon points="@LeftClawPoints" />
            </clipPath>
            <clipPath id="@RightClawClipId" clipPathUnits="userSpaceOnUse">
                <polygon points="@RightClawPoints" />
            </clipPath>
        </defs>

        <image href="@LogoSrc"
               width="1024"
               height="1024"
               mask="@($"url(#{BodyMaskId})")"
               preserveAspectRatio="xMidYMid meet" />

        @* Left claw holds the language flag *@
        <g class="lobsy-coach__claw lobsy-coach__claw--hold">
            <image href="@LogoSrc"
                   width="1024"
                   height="1024"
                   clip-path="@($"url(#{LeftClawClipId})")"
                   preserveAspectRatio="xMidYMid meet" />
            <g class="lobsy-coach__flag-wrap" transform="translate(195 215) rotate(-18)">
                <rect x="0" y="8" width="6" height="72" rx="2" fill="#3a2a1a" opacity="0.85" />
                <image href="@FlagSrc"
                       x="6" y="0"
                       width="100" height="66"
                       preserveAspectRatio="xMidYMid slice"
                       class="lobsy-coach__flag" />
                <rect x="6" y="0" width="100" height="66" rx="4" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="3" />
            </g>
        </g>

        @* Right claw snaps occasionally *@
        <g class="lobsy-coach__claw lobsy-coach__claw--snap">
            <image href="@LogoSrc"
                   width="1024"
                   height="1024"
                   clip-path="@($"url(#{RightClawClipId})")"
                   preserveAspectRatio="xMidYMid meet" />
        </g>

        <ellipse class="lobsy-coach__lid lobsy-coach__lid--left" cx="467" cy="302" rx="14" ry="13" />
        <ellipse class="lobsy-coach__lid lobsy-coach__lid--right" cx="557" cy="302" rx="14" ry="13" />
    </svg>
</span>

@code {
    private static int _seq;
    private readonly string _id = Interlocked.Increment(ref _seq).ToString();

    private const string LogoSrc = "images/brand/lobsy.png?v=20260729-live";

    private const string LeftClawPoints =
        "241,311 247,270 270,225 312,187 362,174 373,177 409,229 422,279 414,320 439,382 439,428 439,499 399,526 313,529 297,506 252,453 208,402 207,395";
    private const string RightClawPoints =
        "605,339 601,281 614,229 653,177 657,176 714,191 756,229 778,274 784,315 814,398 813,417 771,471 727,507 711,529 625,526 585,499 585,434 585,387";

    private string BodyMaskId => $"lobsy-coach-body-{_id}";
    private string LeftClawClipId => $"lobsy-coach-claw-l-{_id}";
    private string RightClawClipId => $"lobsy-coach-claw-r-{_id}";

    [Parameter] public string? Class { get; set; }
    [Parameter] public string Alt { get; set; } = "Lobsy";
    [Parameter] public bool Animate { get; set; } = true;
    [Parameter] public string? Language { get; set; }

    private string FlagSrc => JobsyLanguages.Get(Language).FlagImage + "?v=1";
}
