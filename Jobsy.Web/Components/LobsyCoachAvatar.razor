@namespace Jobsy.Web.Components
@using Jobsy.Core.Localization
@using Jobsy.Web.Components.Brand
@using Jobsy.Web.Localization
@using Jobsy.Web.Media

<span class="lobsy-coach @(Animate ? "lobsy-coach--animate" : null) @Class"
      role="@(string.IsNullOrEmpty(Alt) ? null : "img")"
      aria-hidden="@(string.IsNullOrEmpty(Alt) ? "true" : null)"
      aria-label="@(string.IsNullOrEmpty(Alt) ? null : Alt)">
    <LobsyMascot Pose="MascotPose.Rustig"
                 Variant="LobsyMascotArt.MascotVariant.Avatar"
                 Size="MascotSize.Small"
                 Class="lobsy-coach__svg"
                 Alt="" />
    <span class="lobsy-coach__flag-badge" aria-hidden="true">
        <img class="lobsy-coach__flag" src="@FlagSrc" alt="" width="100" height="66" draggable="false" />
    </span>
</span>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public bool Animate { get; set; }
    [Parameter] public string? Language { get; set; }

    private string FlagSrc => JobsyLanguages.Get(Language).FlagImage + "?v=1";
}
