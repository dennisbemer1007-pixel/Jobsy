@namespace Jobsy.Web.Components
@using System.ComponentModel
@using Jobsy.Web.Media
@inherits CultureAwareComponentBase

<div class="lobsy-coach-cta lobsy-coach-cta--variant-b @PlacementClass" data-testid="vacancy-mock-interview-cta">
    <button type="button"
            class="lobsy-coach-cta__btn"
            @onclick="OnOpen"
            aria-label="@Culture["MockInterview.CtaAria"]">
        <img class="lobsy-coach-cta__avatar"
             src="@BrandImages.AbsoluteCoachBAvatar"
             alt=""
             width="40"
             height="40"
             decoding="async" />
        <span class="lobsy-coach-cta__label">@Culture["MockInterview.CtaBubble"]</span>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Placement { get; set; } = "";

    [Parameter, EditorRequired]
    public EventCallback OnOpen { get; set; }

    private string PlacementClass => Placement switch
    {
        "rail" => "lobsy-coach-cta--kb-rail",
        "mobile" => "lobsy-coach-cta--kb-mobile",
        _ => ""
    };
}
