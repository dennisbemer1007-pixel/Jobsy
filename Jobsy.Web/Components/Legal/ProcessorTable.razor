@using Jobsy.Core.Legal
@using Jobsy.Web.Localization
@inject CultureState Culture

@if (Rows.Count > 0)
{
    <div class="pp-table">
        <p class="pp-table__caption">@Culture["Legal.Processors.Caption"]</p>
        <table class="pp-table__grid">
            <thead>
                <tr>
                    <th scope="col">@Culture["Legal.Processors.Party"]</th>
                    <th scope="col">@Culture["Legal.Processors.Where"]</th>
                    <th scope="col">@Culture["Legal.Processors.Purpose"]</th>
                    <th scope="col">@Culture["Legal.Processors.Data"]</th>
                    <th scope="col">@Culture["Legal.Processors.Basis"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <th scope="row" data-label="@Culture["Legal.Processors.Party"]">
                            @row.Name
                            @if (row.Status == ProcessorStatus.Planned)
                            {
                                <span class="pp-table__planned">(@Culture[row.PlannedNoteKey ?? "Legal.Processors.Planned"])</span>
                            }
                        </th>
                        <td data-label="@Culture["Legal.Processors.Where"]">@row.Region</td>
                        <td data-label="@Culture["Legal.Processors.Purpose"]">@Culture[row.PurposeKey]</td>
                        <td data-label="@Culture["Legal.Processors.Data"]">@Culture[row.DataKey]</td>
                        <td data-label="@Culture["Legal.Processors.Basis"]">@Culture[row.TransferBasisKey ?? LegalProcessors.InsideEu]</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="pp-table__note">@Culture["Legal.Processors.TransferNote"]</p>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<LegalProcessor> Rows { get; set; } = LegalProcessors.All;
}
