@using Jobsy.Core.Legal
@using Jobsy.Web.Localization
@inject CultureState Culture

@* Official Dutch algemene voorwaarden (D3). 04 rewrites the text; 02 only moves it onto LegalDocument. *@
<LegalDocument DocumentId="@LegalDocumentIds.TermsEmployer"
               Title="@Culture["Legal.Terms"]"
               Lead="@Culture["Terms.Employer.Lead"]"
               Eyebrow="@Culture["Legal.Eyebrow.Terms"]"
               EyebrowEmoji="📜"
               Sections="Sections" />

@code {
    private IReadOnlyList<LegalSection>? _sections;

    private IReadOnlyList<LegalSection> Sections => _sections ??= BuildSections();

    private IReadOnlyList<LegalSection> BuildSections() =>
    [
        new LegalSection
        {
            Id = "wie-is-lobsy",
            Number = "1",
            TitleKey = "Terms.Sec.wie-is-lobsy.Title",
            SummaryKey = "Terms.Sec.wie-is-lobsy.Summary",
            Body = @<text>
                <LegalIdentityCard />
            </text>
        },
        new LegalSection
        {
            Id = "toepasselijkheid",
            Number = "2",
            TitleKey = "Terms.Sec.toepasselijkheid.Title",
            Body = @<text>
                <p>
                    Deze algemene voorwaarden gelden voor elke ondernemer, vestiging, organisatie of intermediair
                    (“Ondernemer”) die een bedrijfsaccount aanmaakt of gebruikt op Lobsy. Door te registreren of
                    het platform te gebruiken, ga je akkoord met deze voorwaarden en de
                    <a href="/privacy">@Culture["Legal.Privacy"]</a>.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "dienst",
            Number = "3",
            TitleKey = "Terms.Sec.dienst.Title",
            Body = @<text>
                <p>
                    Lobsy biedt een platform om vacatures te publiceren, kandidaten te bereiken op basis van
                    (onder meer) reistijd, sollicitaties te ontvangen en tokenproducten te gebruiken
                    (publiceren, highlight, PushBom, verlengen). Lobsy is een bemiddelings- en publicatieplatform;
                    wij zijn geen partij bij de arbeidsovereenkomst tussen Ondernemer en kandidaat.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "account-kvk",
            Number = "4",
            TitleKey = "Terms.Sec.account-kvk.Title",
            Body = @<text>
                <ul>
                    <li>Je bent verantwoordelijk voor juiste KVK- en vestigingsgegevens en voor bevoegde vertegenwoordiging.</li>
                    <li>Registratie kan per vestiging of voor de gehele organisatie plaatsvinden, volgens de keuzes in het registratieproces.</li>
                    <li>Bij een vestiging die al in gebruik is, kan een overnameverzoek volgen; Lobsy beslist over toekenning volgens platformregels.</li>
                    <li>Je houdt inloggegevens geheim en bent verantwoordelijk voor gebruik onder jouw account(s).</li>
                </ul>
            </text>
        },
        new LegalSection
        {
            Id = "tokens",
            Number = "5",
            TitleKey = "Terms.Sec.tokens.Title",
            Body = @<text>
                <p>
                    Tokens zijn digitale tegoeden binnen Lobsy waarmee Ondernemers betaalde platformfuncties afnemen.
                    Tokens hebben geen contante waarde buiten het platform, zijn niet overdraagbaar aan derden buiten
                    Lobsy, en vormen geen banksaldo of e-money in de zin van een betaalrekening.
                </p>
                <h3>Gebruik van tokens</h3>
                <ul>
                    <li><strong>Publiceren:</strong> het plaatsen/activeren van een vacature kost tokens volgens de actuele tarieven in het platform.</li>
                    <li><strong>Highlight:</strong> optionele zichtbaarheidsboost tegen tokenkosten.</li>
                    <li><strong>PushBom:</strong> optionele push/bereik-actie; kosten kunnen afhangen van bereik of kandidatentiers.</li>
                    <li><strong>Verlengen:</strong> verlenging van een vacatureperiode tegen tokenkosten.</li>
                </ul>
                <h3>Welkomsttoken</h3>
                <p>
                    Bij succesvolle activatie van een bedrijfsaccount kan Lobsy een welkomsttoken toekennen
                    (standaard één token, tenzij anders vermeld). Welkomsttokens kunnen aan voorwaarden of
                    gebruiksbeperkingen onderhevig zijn.
                </p>
                <h3>Allocatie</h3>
                <p>
                    Binnen een organisatie kunnen tokens (waar de functionaliteit dat toelaat) worden toegewezen
                    tussen vestigingen. Allocaties zijn intern en wijzigen het totale organisatiesaldo niet,
                    behalve door aankoop, besteding, grant of correctie.
                </p>
                <h3>Onvoldoende saldo</h3>
                <p>
                    Lobsy werkt prepaid: zonder positief tokensaldo wordt een betaalde actie geblokkeerd
                    (“no tokens, no action”). Je kunt direct in de melding tokens bijkopen (exact tekort of
                    een bulkpakket) via Mollie. Na succesvolle betaling worden tokens bijgeschreven en wordt
                    de openstaande actie automatisch uitgevoerd. Vestigingsmanagers zonder kooprecht kunnen
                    een publicatieaanvraag in wachtstatus plaatsen tot een bedrijfsmanager goedkeurt of tokens
                    beschikbaar zijn. Er wordt geen automatische incasso gebruikt.
                </p>
                <h3>Tarieven en kortingen</h3>
                <p>
                    Tokenprijzen, pakketten, productkosten en eventuele kortingen voor vroege gebruikers worden in het
                    platform getoond of door Lobsy meegedeeld. Lobsy mag tarieven wijzigen; reeds betaalde
                    pakketten blijven beschikbaar volgens de aankoopvoorwaarden van dat moment.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "betalen-btw",
            Number = "6",
            TitleKey = "Terms.Sec.betalen-btw.Title",
            SummaryKey = "Terms.Sec.betalen-btw.Summary",
            Body = @<text>
                <ul>
                    <li>Tokenpakketten worden aangeschaft via de in het platform gekozen betaalmethode (bijv. Mollie).</li>
                    <li>Betalingen zijn verschuldigd volgens de checkout; na succesvolle betaling worden tokens bijgeschreven.</li>
                    <li>Prijzen zijn in euro’s. Bij de checkout staat per bedrag of het exclusief of inclusief btw is.</li>
                    <li>Lobsy of een beheerder kan in uitzonderlijke gevallen tokens toekennen (grant) of corrigeren bij fouten of misbruik.</li>
                    <li>Terugbetaling van gekochte tokens of ongebruikte tegoeden is alleen mogelijk als de wet dat verplicht of Lobsy dat uitdrukkelijk toestaat.</li>
                </ul>
            </text>
        },
        new LegalSection
        {
            Id = "vacatures",
            Number = "7",
            TitleKey = "Terms.Sec.vacatures.Title",
            Body = @<text>
                <ul>
                    <li>Je garandeert dat vacatureteksten kloppen, rechtmatig zijn en geen discriminerende of misleidende inhoud bevatten.</li>
                    <li>Je vult uren, roosters/dagdelen (of “tijden in overleg”) en de wettelijke taakvinkjes juist in; die gegevens sturen matching en jeugdige-arbeidschecks.</li>
                    <li>Lobsy mag content modereren (inclusief geautomatiseerde/AI-ondersteunde moderatie) en vacatures weigeren, pauzeren of verwijderen.</li>
                    <li>Je blijft zelf verantwoordelijk voor werving, selectie en naleving van arbeidsrecht en gelijke behandeling.</li>
                </ul>
            </text>
        },
        new LegalSection
        {
            Id = "matching",
            Number = "7a",
            TitleKey = "Terms.Sec.matching.Title",
            Body = @<text>
                <ul>
                    <li>Matchingspercentages en breakdowns zijn hulpmiddelen op basis van reistijd, uren en dagdelen; zij vormen geen toezegging van geschiktheid of aanname.</li>
                    <li>Automatische checks op basis van taakvinkjes en kandidaatleeftijd ondersteunen naleving van de Arbeidstijdenwet, maar vervangen jouw eigen juridische en operationele controle niet.</li>
                    <li>Je mag geen minimumleeftijd als wervingsfilter op vacatures zetten; leeftijdsbescherming loopt via feitelijke taakkenmerken.</li>
                    <li>Onjuiste of onvolledige taakvinkjes, uren of roosters kunnen tot verkeerde matches of ongepaste sollicitaties leiden — dat risico ligt bij de Ondernemer.</li>
                </ul>
            </text>
        },
        new LegalSection
        {
            Id = "kandidaatgegevens",
            Number = "8",
            TitleKey = "Terms.Sec.kandidaatgegevens.Title",
            Body = @<text>
                <p>
                    Je verwerkt kandidatengegevens die je via Lobsy ontvangt als zelfstandige verwerkingsverantwoordelijke
                    (of volgens jullie interne rolverdeling), en houdt je aan de AVG. Gebruik sollicitatiegegevens alleen
                    voor werving rondom de betreffende vacature, tenzij de kandidaat anders toestemt.
                    Progressive disclosure geldt: volledige NAW/contactgegevens worden pas getoond na acceptatie of
                    contactstatus volgens de platformregels.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "beschikbaarheid",
            Number = "9",
            TitleKey = "Terms.Sec.beschikbaarheid.Title",
            Body = @<text>
                <p>
                    Lobsy streeft naar een stabiele dienst maar garandeert geen ononderbroken beschikbaarheid.
                    Functionaliteit, tarieven en deze voorwaarden kunnen worden aangepast. Bij materiële wijzigingen
                    informeren we redelijkerwijs via het platform.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "aansprakelijkheid",
            Number = "10",
            TitleKey = "Terms.Sec.aansprakelijkheid.Title",
            Body = @<text>
                <p>
                    Lobsy is niet aansprakelijk voor (het uitblijven van) matches, de kwaliteit van kandidaten,
                    beslissingen van Ondernemer of kandidaat, of schade door onjuiste door jou aangeleverde gegevens.
                    Onze totale aansprakelijkheid is, voor zover wettelijk toegestaan, beperkt tot het bedrag dat je
                    in de twaalf maanden voorafgaand aan de gebeurtenis aan Lobsy hebt betaald voor tokens, of € 250
                    als dat lager is. Dit beperkt geen aansprakelijkheid die wettelijk niet mag worden uitgesloten.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "beeindiging",
            Number = "11",
            TitleKey = "Terms.Sec.beeindiging.Title",
            Body = @<text>
                <p>
                    Bij misbruik, fraude, schending van deze voorwaarden of wetgeving mag Lobsy accounts beperken
                    of beëindigen en tokens blokkeren. Je kunt je account beëindigen volgens de in het platform
                    beschikbare procedures; openstaande verplichtingen blijven bestaan.
                </p>
            </text>
        },
        new LegalSection
        {
            Id = "recht",
            Number = "12",
            TitleKey = "Terms.Sec.recht.Title",
            Body = @<text>
                <p>
                    Op deze voorwaarden is Nederlands recht van toepassing. Geschillen worden voorgelegd aan de
                    bevoegde rechter in Nederland, tenzij dwingend recht anders bepaalt.
                </p>
            </text>
        }
    ];
}
