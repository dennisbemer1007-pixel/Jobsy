l="stylesheet" href="css/features/mijn-paspoort.css?v=20261004-tabs" /><link rel="stylesheet" href="css/features/ontdekkingsreis.css?v=20261004-end" /><link rel="stylesheet" href="css/features/tests.css?v=20261004-footer" /><link rel="stylesheet" href="css/features/carriere.css?v=20261003-sticky" /></noscript>

    <script nonce="@Nonce">
        (function () {
            var nonce = document.currentScript && document.currentScript.nonce;
            if (nonce) {
                var create = Document.prototype.createElement;
                Document.prototype.createElement = function (tagName, options) {
                    var el = create.call(this, tagName, options);
                    var tag = String(tagName || "").toLowerCase();
                    if (tag === "script" || tag === "style") {
                        el.nonce = nonce;
                        el.setAttribute("nonce", nonce);
                    }
                    return el;
                };
            }
            try {
                // Idempotent: enhanced navigation re-runs this inline script; never wrap twice.
                if (!window.__jobsyPagehideShim) {
                    window.__jobsyPagehideShim = true;
                    var add = EventTarget.prototype.addEventListener;
                    var remove = EventTarget.prototype.removeEventListener;
                    var wrapped = typeof WeakMap === "function" ? new WeakMap() : null;
                    EventTarget.prototype.addEventListener = function (type, listener, options) {
                        if (type === "unload") {
                            type = "pagehide";
                            if (wrapped && typeof listener === "function" && !listener.__jobsyPagehideMapped) {
                                var mapped = wrapped.get(listener);
                                if (!mapped) {
                                    mapped = function (ev) { return listener.call(this, ev); };
                                    mapped.__jobsyPagehideMapped = true;
                                    wrapped.set(listener, mapped);
                                }
                                listener = mapped;
                            }
                        }
                        return add.call(this, type, listener, options);
                    };
                    EventTarget.prototype.removeEventListener = function (type, listener, options) {
                        if (type === "unload") {
                            type = "pagehide";
                            if (wrapped && typeof listener === "function") {
                                listener = wrapped.get(listener) || listener;
                            }
                        }
                        return remove.call(this, type, listener, options);
                    };
                }
            } catch (e) { }
            try {
                if (localStorage.getItem("Jobsy.CookieConsent")) {
                    document.documentElement.classList.add("cookie-consent-known");
                }
            } catch (e) { }
            var webp = "/images/brand/lobsy-256.webp?v=20260828-pin";
            var png = "/images/brand/lobsy-128.png?v=20260828-pin";
            var mascotPng = "/images/brand/mascot-128.png?v=20260828-mascot";
            var svg = "data:image/svg+xml," + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#e7eef7"/><text x="32" y="40" text-anchor="middle" font-size="22" font-family="Segoe UI,Arial,sans-serif" fill="#0f2d5c">L</text></svg>'
            );
            function isPhotoFallback(img) {
                var mode = img.getAttribute("data-logo-fallback");
                if (mode === "photo") return true;
                return !!(img.classList && (
                    img.classList.contains("vacancy-photo")
                    || img.classList.contains("map-popup__photo")
                    || img.classList.contains("map-popup__media-logo")
                ));
            }
            window.jobsyLogoFallback = function (img) {
                if (!img || img.dataset.fb === "done") return true;
                var src = img.currentSrc || img.src || "";
                img.removeAttribute("srcset");
                img.removeAttribute("sizes");
                if (isPhotoFallback(img) && img.dataset.fb !== "alt" && img.dataset.fb !== "webp" && img.dataset.fb !== "png") {
                    var alt = img.getAttribute("data-fallback-src");
                    if (alt && alt.length && src.indexOf(alt.split("?")[0]) === -1) {
                        img.dataset.fb = "alt";
                        img.src = alt;
                        return true;
                    }
                    img.dataset.fb = "webp";
                    img.src = webp;
                    return true;
                }
                if (src.indexOf("mascot-256.webp") !== -1 || src.indexOf("mascot-128.webp") !== -1 || src.indexOf("mascot-64.webp") !== -1) {
                    img.dataset.fb = "png";
                    img.src = mascotPng;
                    return true;
                }
                if (src.indexOf("mascot-128.png") !== -1 || src.indexOf("mascot-180.png") !== -1 || src.indexOf("mascot-64.png") !== -1) {
                    img.dataset.fb = "done";
                    img.onerror = null;
                    img.src = svg;
                    img.classList.add("img-fallback-empty");
                    return true;
                }
                if (src.indexOf("lobsy-256.webp") !== -1 || src.indexOf("lobsy-128.webp") !== -1 || src.indexOf("lobsy-64.webp") !== -1) {
                    img.dataset.fb = "png";
                    img.src = png;
                    return true;
                }
                if (src.indexOf("lobsy-128.png") !== -1 || src.indexOf("lobsy-180.png") !== -1 || src.indexOf("lobsy-64.png") !== -1) {
                    img.dataset.fb = "done";
                    img.onerror = null;
                    img.src = svg;
                    img.classList.add("img-fallback-empty");
                    return true;
                }
                img.dataset.fb = "webp";
                img.src = webp;
                return true;
            };
            document.addEventListener("error", function (ev) {
                var t = ev.target;
                if (!t || t.tagName !== "IMG") return;
                if (t.getAttribute("data-logo-fallback") === "off") return;
                var wrap = t.closest ? t.closest(".company-card__logo") : null;
                if (t.getAttribute("data-logo-fallback") != null
                    || wrap
                    || (t.classList && (
                        t.classList.contains("vacancy-photo")
                        || t.classList.contains("map-popup__media-logo")
                        || t.classList.contains("map-popup__photo")
                        || t.classList.contains("branch-page__logo")
                        || t.classList.contains("lobsy-logo__img")
                    ))) {
                    window.jobsyLogoFallback(t);
                }
            }, true);
        })();
    </script>
    <HeadOutlet @rendermode="PageRenderMode" />
