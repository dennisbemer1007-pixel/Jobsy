<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="PageRenderMode" />
    </CascadingAuthenticationState>
    <div id="components-reconnect-modal" class="reconnect-toast">
        <div class="reconnect-toast__panel" role="status" aria-live="polite">
            <p class="reconnect-toast__msg reconnect-toast__msg--show">@Text("Status.Reconnect.Trying")</p>
            <p class="reconnect-toast__msg reconnect-toast__msg--failed">
                @Text("Status.Reconnect.Failed")
                <button type="button" class="reconnect-toast__action" data-reconnect-reload>@Text("Status.Reconnect.Reload")</button>
            </p>
            <p class="reconnect-toast__msg reconnect-toast__msg--rejected">
                @Text("Status.Reconnect.Rejected")
                <button type="button" class="reconnect-toast__action" data-reconnect-reload>@Text("Status.Reconnect.Reload")</button>
            </p>
        </div>
    </div>
    <script nonce="@Nonce">
        document.addEventListener("click", function (ev) {
            var t = ev.target;
            if (!t || !t.closest) return;
            if (t.closest("[data-reconnect-reload]")) {
                ev.preventDefault();
                location.reload();
            }
        });
    </script>
        <script src="js/gratis-dna.js?v=20261003-csp3" nonce="@Nonce" defer></script>
        <script src="js/app-core.js?v=20261004-run5c" nonce="@Nonce" defer></script>
        <script src="js/landing.js?v=20260930-landing-5" nonce="@Nonce" defer></script>
        <script src="js/public-pages.js?v=20261001-pp07" nonce="@Nonce" defer></script>
        <script src="js/navFeedback.js?v=20260928-nav-fb" nonce="@Nonce" defer></script>
        <script src="js/lobsyPush.js?v=20261004-run5c" nonce="@Nonce" defer></script>
        <script src="js/leerling-login.js?v=20261004-pupil3" nonce="@Nonce" defer></script>
    @if (LoadBlazorRuntime)
    {
        @* defer scripts run in document order — blazor-boot.js must follow blazor.web.js *@
        <script src="_framework/blazor.web.js?v=20260820-r164" autostart="false" nonce="@Nonce" defer></script>
        <script src="js/blazor-boot.js?v=20261003-reconnect" nonce="@Nonce" defer></script>
    }
</body>

</html>

@code {
    private static readonly string GitCommit =
        Environment.GetEnvironmentVariable("RENDER_GIT_COMMIT")
        ?? Environment.GetEnvironmentVariable("GIT_COMMIT")
        ?? "local";

    private string Nonce => CspNonce.Get(HttpContextAccessor.HttpContext);

    private string HtmlLang => CultureRequest.ResolveLanguage(HttpContextAccessor.HttpContext);

    /// <summary>
    /// App.razor renders statically, before any circuit exists, so it reads the catalog with the
    /// request language instead of <c>CultureState</c> (errors 04 §04.3). The reconnect toast is
    /// part of this static shell and must still speak the visitor's language.
    /// </summary>
    private string Text(string key) => UiStrings.Get(key, HtmlLang);

    private string? HtmlDir =>
        Jobsy.Core.Localization.JobsyLanguages.Get(HtmlLang).IsRightToLeft ? "rtl" : null;

    private bool SkipBlazorForPage =>
        HttpContextAccessor.HttpContext?.GetEndpoint()?.Metadata.GetMetadata<NoBlazorRuntimeAttribute>() is not null;

    private bool LoadBlazorRuntime =>
        !SkipBlazorForPage
        && !CrawlerUserAgent.ShouldSkipInteractiveRuntime(
            HttpContextAccessor.HttpContext?.Request.Headers.UserAgent.ToString());

    /// <summary>
    /// Pages marked <c>[ExcludeFromInteractiveRouting]</c> (e.g. MFA SSR forms) render without
    /// InteractiveServer so OnInitializedAsync and antiforgery run once.
    /// </summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContextAccessor.HttpContext?.AcceptsInteractiveRouting() == true
            ? new InteractiveServerRenderMode(prerender: true)
            : null;
}
