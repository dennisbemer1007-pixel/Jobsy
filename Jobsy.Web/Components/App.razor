@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lobsy — vacatures op reistijd</title>
    <meta name="theme-color" content="#0f2d5c" />
    <meta name="application-name" content="Lobsy" />
    <meta name="apple-mobile-web-app-title" content="Lobsy" />
    <meta name="format-detection" content="telephone=no" />
    <base href="/" />
    <link rel="icon" href="favicon.ico?v=20260828-pin" sizes="any" />
    <link rel="icon" type="image/png" href="favicon.png?v=20260828-pin" />
    <link rel="apple-touch-icon" href="@Jobsy.Web.Media.BrandImages.AppleTouch" />
    <link rel="dns-prefetch" href="https://tiles.openfreemap.org" />
    <style nonce="@Nonce">
        :root { --bg:#f5f2ee; --surface:#fffcfa; --text:#122033; --border:#ddd5cc; --brand:#0f2d5c; --map-land:#f8f4f0; --font:"Segoe UI","Helvetica Neue",Arial,sans-serif; }
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; max-width: 100%; overflow-x: hidden; font-family: var(--font); color: var(--text); background: var(--bg); }
        .app-shell { display: flex; flex-direction: column; height: 100%; min-height: 100%; max-width: 100%; overflow-x: hidden; }
        .app-main { flex: 1 1 auto; min-height: 0; max-width: 100%; }
        .app-shell:has(.jobsy-discovery) .app-main { overflow: hidden; display: flex; flex-direction: column; }
        .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
        .lobsy-logo { display: block; width: 56px; height: 56px; flex-shrink: 0; line-height: 0; }
        .lobsy-logo__img { display: block; width: 100%; height: 100%; object-fit: contain; }
        html.cookie-consent-known .cookie-consent { display: none; }
        .cookie-consent { position: fixed; left: 0; right: 0; bottom: 0; z-index: 80; contain: layout paint style; padding: 0.65rem 0.85rem; background: #0a2044; color: #f7f4f0; }
        .cookie-consent a { color: #fff; text-decoration: underline; text-underline-offset: 0.12em; }
        .cookie-consent__actions { display: flex; flex-wrap: wrap; gap: 0.55rem; }
        .btn-compact { padding: 0.35rem 0.7rem; border-radius: 8px; border: 1px solid rgba(247,244,240,0.45); background: transparent; color: #f7f4f0; }
        .btn-compact--primary { background: #d93a12; border-color: #d93a12; color: #fff; }
        .bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; }
        .lobsy-watermarks { display: none; }
        .app-shell:has(.jobsy-discovery) .lobsy-watermarks { display: none !important; }
        .maplibregl-ctrl-logo, a.maplibregl-ctrl-logo, .maplibregl-ctrl-attrib, .maplibregl-compact { display: none !important; }
        .jobsy-chrome { display: none; }
        .jobsy-discovery { display: grid; grid-template-columns: minmax(320px,42%) minmax(0,58%); min-height: 0; height: 100%; position: relative; }
        .map-pane, .map-stage { position: relative; width: 100%; min-width: 280px; min-height: 55dvh; background: var(--map-land); }
        .map-stage { flex: 1 1 auto; }
        #job-map, .job-map { width: 100%; min-width: 280px; min-height: 55dvh; height: 100%; background: var(--map-land); contain: layout; }
        .job-map-placeholder { position: absolute; inset: 0; background: var(--map-land); pointer-events: none; }
        .map-stage.is-live .job-map-placeholder { opacity: 0; visibility: hidden; transition: none; }
        @@media (max-width: 768px) {
            .app-shell:has(.jobsy-discovery) .app-header,
            .app-shell:has(.jobsy-discovery) .app-footer { display: none; }
            .jobsy-discovery { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
            .jobsy-discovery .jobsy-chrome { display: block; min-height: 10rem; }
            .map-pane, .map-stage, #job-map, .job-map { min-width: 0; }
            .jobsy-chrome__header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 3.5rem; padding: 0.55rem 0.85rem 0.35rem; }
            .jobsy-logo, .jobsy-chrome .lobsy-logo, .jobsy-logo__img { width: 48px; height: 48px; }
            .jobsy-chrome__search { padding: 0.55rem 0.75rem 0.35rem; }
            .jobsy-search { display: grid; grid-template-columns: 1fr auto; gap: 0.45rem; }
            .jobsy-search input { width: 100%; min-height: 2.75rem; box-sizing: border-box; }
            .jobsy-search__btn { width: 2.75rem; height: 2.75rem; }
            .jobsy-chrome__actions { display: grid; grid-template-columns: repeat(3, 1fr); }
            .jobsy-action { display: inline-flex; min-height: 2.55rem; }
            .jobsy-discovery.show-map .map-pane,
            .jobsy-discovery.show-map .map-stage,
            .jobsy-discovery.show-map #job-map,
            .jobsy-discovery.show-map .job-map,
            .jobsy-discovery.show-map .job-map-placeholder { min-height: 55dvh; width: 100%; min-width: 0; }
        }
        @@media (min-width: 769px) {
            .app-header { min-height: 4.25rem; }
            .jobsy-discovery:not(.jobsy-discovery--branch) .map-pane,
            .jobsy-discovery:not(.jobsy-discovery--branch) .map-stage,
            .jobsy-discovery:not(.jobsy-discovery--branch) #job-map { min-height: 70vh; width: 100%; }
        }
        .img-fallback-empty { background: #e7eef7; object-fit: contain; }
    </style>
    @if (LoadBlazorRuntime)
    {
        <link rel="stylesheet" href="css/app.min.css?v=20260831-mobile" media="print" data-app-css />
    }
    <noscript><link rel="stylesheet" href="css/app.min.css?v=20260831-mobile" /></noscript>
    <script nonce="@Nonce">
        (function () {
            var nonce = document.currentScript && document.currentScript.nonce;
            if (nonce) {
                var create = Document.prototype.createElement;
                Document.prototype.createElement = function (tagName, options) {
                    var el = create.call(this, tagName, options);
                    var tag = String(tagName || "").toLowerCase();
                    if (tag === "script" || tag === "style") {
                        el.nonce = nonce;
                    }
                    return el;
                };
            }
            document.querySelectorAll("link[data-app-css]").forEach(function (link) {
                function apply() { link.media = "all"; }
                link.addEventListener("load", apply);
                link.addEventListener("error", apply);
                if (link.sheet) apply();
            });
            try {
                var add = EventTarget.prototype.addEventListener;
                var remove = EventTarget.prototype.removeEventListener;
                var wrapped = typeof WeakMap === "function" ? new WeakMap() : null;
                EventTarget.prototype.addEventListener = function (type, listener, options) {
                    if (type === "unload") {
                        type = "pagehide";
                        if (wrapped && typeof listener === "function") {
                            var mapped = wrapped.get(listener);
                            if (!mapped) {
                                mapped = function (ev) { return listener.call(this, ev); };
                                wrapped.set(listener, mapped);
                            }
                            listener = mapped;
                        }
                    }
                    return add.call(this, type, listener, options);
                };
                EventTarget.prototype.removeEventListener = function (type, listener, options) {
                    if (type === "unload") {
                        type = "pagehide";
                        if (wrapped && typeof listener === "function") {
                            listener = wrapped.get(listener) || listener;
                        }
                    }
                    return remove.call(this, type, listener, options);
                };
            } catch (e) { }
            try {
                if (localStorage.getItem("Jobsy.CookieConsent")) {
                    document.documentElement.classList.add("cookie-consent-known");
                }
            } catch (e) { }
            var webp = "/images/brand/lobsy-256.webp?v=20260828-pin";
            var png = "/images/brand/lobsy-128.png?v=20260828-pin";
            var mascotPng = "/images/brand/mascot-128.png?v=20260828-mascot";
            var svg = "data:image/svg+xml," + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#e7eef7"/><text x="32" y="40" text-anchor="middle" font-size="22" font-family="Segoe UI,Arial,sans-serif" fill="#0f2d5c">L</text></svg>'
            );
            window.jobsyLogoFallback = function (img) {
                if (!img || img.dataset.fb === "done") return true;
                var src = img.currentSrc || img.src || "";
                img.removeAttribute("srcset");
                img.removeAttribute("sizes");
                if (src.indexOf("mascot-256.webp") !== -1 || src.indexOf("mascot-128.webp") !== -1 || src.indexOf("mascot-64.webp") !== -1) {
                    img.dataset.fb = "png";
                    img.src = mascotPng;
                    return true;
                }
                if (src.indexOf("mascot-128.png") !== -1 || src.indexOf("mascot-180.png") !== -1 || src.indexOf("mascot-64.png") !== -1) {
                    img.dataset.fb = "done";
                    img.onerror = null;
                    img.src = svg;
                    img.classList.add("img-fallback-empty");
                    return true;
                }
                if (src.indexOf("lobsy-256.webp") !== -1 || src.indexOf("lobsy-128.webp") !== -1 || src.indexOf("lobsy-64.webp") !== -1) {
                    img.dataset.fb = "png";
                    img.src = png;
                    return true;
                }
                if (src.indexOf("lobsy-128.png") !== -1 || src.indexOf("lobsy-180.png") !== -1 || src.indexOf("lobsy-64.png") !== -1) {
                    img.dataset.fb = "done";
                    img.onerror = null;
                    img.src = svg;
                    img.classList.add("img-fallback-empty");
                    return true;
                }
                img.dataset.fb = "webp";
                img.src = webp;
                return true;
            };
            document.addEventListener("error", function (ev) {
                var t = ev.target;
                if (!t || t.tagName !== "IMG") return;
                if (t.getAttribute("data-logo-fallback") === "off") return;
                var wrap = t.closest ? t.closest(".company-card__logo") : null;
                if (t.getAttribute("data-logo-fallback") != null
                    || wrap
                    || (t.classList && (
                        t.classList.contains("vacancy-photo")
                        || t.classList.contains("map-popup__media-logo")
                        || t.classList.contains("map-popup__photo")
                        || t.classList.contains("branch-page__logo")
                        || t.classList.contains("lobsy-logo__img")
                    ))) {
                    window.jobsyLogoFallback(t);
                }
            }, true);
        })();
    </script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: true)" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    </CascadingAuthenticationState>
    <div id="components-reconnect-modal" class="reconnect-toast">
        <div class="reconnect-toast__panel" role="status" aria-live="polite">
            <p class="reconnect-toast__msg reconnect-toast__msg--show">Verbinding herstellen…</p>
            <p class="reconnect-toast__msg reconnect-toast__msg--failed">
                Verbinding verbroken.
                <button type="button" class="reconnect-toast__action" data-reconnect-reload>Herladen</button>
            </p>
            <p class="reconnect-toast__msg reconnect-toast__msg--rejected">
                Sessie verlopen.
                <button type="button" class="reconnect-toast__action" data-reconnect-reload>Herladen</button>
            </p>
        </div>
    </div>
    <script nonce="@Nonce">
        document.addEventListener("click", function (ev) {
            var t = ev.target;
            if (!t || !t.closest) return;
            if (t.closest("[data-reconnect-reload]")) {
                ev.preventDefault();
                location.reload();
            }
        });
    </script>
    <script src="js/app-core.js?v=20260822-r207" nonce="@Nonce" defer></script>
    @if (LoadBlazorRuntime)
    {
        <script src="_framework/blazor.web.js?v=20260820-r164" nonce="@Nonce" defer></script>
    }
</body>

</html>

@code {
    private string Nonce => CspNonce.Get(HttpContextAccessor.HttpContext);

    private bool LoadBlazorRuntime =>
        !CrawlerUserAgent.ShouldSkipInteractiveRuntime(
            HttpContextAccessor.HttpContext?.Request.Headers.UserAgent.ToString());
}
