@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inherits CultureAwareComponentBase
@inject NavigationManager Navigation

<nav class="admin-sublinks admin-sublinks--wrap" aria-label="@Culture["Nav.Settings"]">
    @foreach (var item in AdminNavItems.SettingsModules)
    {
        var title = Culture[item.TitleKey];
        var active = RoleNavCatalog.IsActive(item, Navigation.ToBaseRelativePath(Navigation.Uri), AdminNavItems.SettingsModules);
        <a class="admin-sublink @(active ? "admin-sublink--active" : null)"
           href="@item.Href"
           aria-current="@(active ? "page" : null)">
            @title
        </a>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
