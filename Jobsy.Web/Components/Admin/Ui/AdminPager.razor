@namespace Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture

@if (TotalCount > 0 || TotalPages > 1)
{
    <nav class="admin-pager" aria-label="Pager">
        <button type="button" class="btn-compact" disabled="@(Page <= 1)" @onclick="PrevAsync">
            @Culture["AdminUi.PrevPage"]
        </button>
        <span class="admin-pager__meta">
            @if (TotalCount > 0)
            {
                @string.Format(Culture["AdminUi.RangeOf"], From, To, TotalCount.ToString("N0"))
            }
            else
            {
                @string.Format(Culture["AdminUi.PageOf"], Page, TotalPages)
            }
        </span>
        <button type="button" class="btn-compact" disabled="@(Page >= Math.Max(1, TotalPages))" @onclick="NextAsync">
            @Culture["AdminUi.NextPage"]
        </button>
        @if (PageSizeOptions is { Count: > 0 })
        {
            <label class="admin-pager__size">
                <span class="visually-hidden">@Culture["AdminUi.PageSize"]</span>
                <select value="@PageSize" @onchange="OnPageSize">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </label>
        }
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public IReadOnlyList<int>? PageSizeOptions { get; set; }

    private int From => TotalCount == 0 ? 0 : ((Page - 1) * PageSize) + 1;
    private int To => Math.Min(Page * PageSize, TotalCount);

    private Task PrevAsync() => PageChanged.InvokeAsync(Math.Max(1, Page - 1));
    private Task NextAsync() => PageChanged.InvokeAsync(Math.Min(Math.Max(1, TotalPages), Page + 1));

    private async Task OnPageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            await PageSizeChanged.InvokeAsync(size);
        }
    }
}
