@namespace Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture

<div class="admin-filter-bar filter-bar">
    @if (QueryChanged.HasDelegate)
    {
        <label class="admin-filter-bar__search filter-bar__search">
            <span class="visually-hidden">@Culture["AdminUi.FilterSearch"]</span>
            <input type="search"
                   value="@Query"
                   placeholder="@(Placeholder ?? Culture["AdminUi.FilterSearch"])"
                   @oninput="OnQuery" />
        </label>
    }
    @if (Chips is not null)
    {
        <div class="admin-filter-bar__chips">@Chips</div>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public RenderFragment? Chips { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnQuery(ChangeEventArgs e)
    {
        Query = e.Value?.ToString() ?? "";
        await QueryChanged.InvokeAsync(Query);
    }
}
