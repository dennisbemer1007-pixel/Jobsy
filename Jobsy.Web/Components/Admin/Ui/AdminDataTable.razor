@namespace Jobsy.Web.Components.Admin.Ui
@inject CultureState Culture

<div class="admin-data-table-wrap">
    @if (ShowTable)
    {
        <table class="admin-data-table data-table">
            <thead>
                <tr>
                    @if (ShowCheckbox)
                    {
                        <th class="admin-data-table__check" scope="col">
                            <input type="checkbox" checked="@AllSelected" @onchange="OnToggleAll"
                                   aria-label="@Culture["AdminUi.Selected"]" />
                        </th>
                    }
                    @Header
                    @if (ShowRowActions)
                    {
                        <th scope="col"><span class="visually-hidden">Acties</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (KeepHeader && Loading)
                {
                    <tr>
                        <td colspan="12">
                            <p class="admin-data-table__state">@Culture["AdminUi.Loading"]</p>
                        </td>
                    </tr>
                }
                else if (KeepHeader && Empty)
                {
                    <tr>
                        <td colspan="12">
                            <p class="admin-data-table__state">@(EmptyText ?? Culture["AdminUi.Empty"])</p>
                        </td>
                    </tr>
                }
                else
                {
                    @Rows
                }
            </tbody>
        </table>
    }
    else if (Loading)
    {
        <p class="admin-data-table__state">@Culture["AdminUi.Loading"]</p>
    }
    else if (Empty)
    {
        <p class="admin-data-table__state">@(EmptyText ?? Culture["AdminUi.Empty"])</p>
    }
</div>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Empty { get; set; }

    /// <summary>
    /// Keep the column headers on screen while the list is loading and when it has no rows.
    /// Other admin lists still replace the whole table with the status line.
    /// </summary>
    [Parameter] public bool KeepHeader { get; set; }

    private bool ShowTable => KeepHeader || (!Loading && !Empty);
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public bool ShowCheckbox { get; set; }
    [Parameter] public bool AllSelected { get; set; }
    [Parameter] public EventCallback<bool> AllSelectedChanged { get; set; }
    [Parameter] public bool ShowRowActions { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Rows { get; set; }

    private async Task OnToggleAll(ChangeEventArgs e)
    {
        var value = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        AllSelected = value;
        await AllSelectedChanged.InvokeAsync(value);
    }
}
