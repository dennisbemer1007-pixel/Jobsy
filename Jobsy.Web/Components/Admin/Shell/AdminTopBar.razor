@using System.Security.Claims
@using Jobsy.Core.Hosting
@using Jobsy.Web.Navigation
@using Jobsy.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject CultureState Culture
@inject NavigationManager Navigation

<header class="admin-topbar">
    <div class="admin-topbar__start">
        <button type="button"
                class="admin-topbar__menu"
                aria-label="@Culture["AdminShell.OpenMenu"]"
                @onclick="OnMenuClick">
            <span aria-hidden="true">@((MarkupString)NavIcons.Menu)</span>
        </button>
        <a class="admin-topbar__brand" href="/admin" aria-label="Lobsy Beheer">
            <span class="admin-topbar__logo-tile">
                <LobsyLogo Class="admin-topbar__logo" Alt="Lobsy" />
            </span>
            <span class="admin-topbar__brand-text">
                <span class="admin-topbar__name">Lobsy</span>
                <span class="admin-topbar__beheer">@Culture["AdminShell.Beheer"]</span>
            </span>
        </a>
        <AdminEnvBadge Label="@EnvLabel" />
    </div>

    <div class="admin-topbar__search">
        <AdminGlobalSearch @ref="_search" CompactTrigger="false" />
    </div>

    <div class="admin-topbar__end">
        <button type="button"
                class="admin-topbar__search-trigger"
                aria-label="@Culture["AdminShell.SearchOpen"]"
                @onclick="OpenMobileSearch">
            <span aria-hidden="true">@((MarkupString)NavIcons.Search)</span>
        </button>
        <PageHelp />
        <NotificationBell />
        <LanguageSelector />
        <AuthorizeView>
            <Authorized>
                <div class="admin-topbar__account">
                    <AuthHeader />
                    <span class="admin-topbar__meta">
                        @Culture["AdminShell.RoleAdmin"]
                        @if (AdminSessionClaims.IsMfaSatisfiedInSession(context.User))
                        {
                            <span aria-hidden="true"> · </span>@Culture["AdminShell.MfaActive"]
                        }
                    </span>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@if (_mobileSearchOpen)
{
    <div class="admin-search-sheet" role="dialog" aria-modal="true" aria-label="@Culture["AdminShell.SearchOpen"]">
        <div class="admin-search-sheet__bar">
            <AdminGlobalSearch AutoFocus="true" OnClose="CloseMobileSearch" />
            <button type="button" class="admin-search-sheet__close" @onclick="CloseMobileSearch">
                @Culture["AdminUi.CloseDrawer"]
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string EnvLabel { get; set; } = DeploymentEnvironment.Lokaal;
    [Parameter] public EventCallback OnMenuClick { get; set; }

    private AdminGlobalSearch? _search;
    private bool _mobileSearchOpen;

    private void OpenMobileSearch() => _mobileSearchOpen = true;
    private void CloseMobileSearch() => _mobileSearchOpen = false;

    public Task FocusSearchAsync() => _search?.FocusAsync() ?? Task.CompletedTask;
}
