@using Jobsy.Core.Hosting
@using Jobsy.Web.Components.Shell
@inject CultureState Culture

<LobsyShellTopBar @ref="_topBar"
                  Kind="LobsyShellTopBarKind.Admin"
                  EnvLabel="@EnvLabel"
                  OnMenuClick="OnMenuClick"
                  OnMobileSearchClick="OpenMobileSearch" />

@if (_mobileSearchOpen)
{
    <div class="admin-search-sheet" role="dialog" aria-modal="true" aria-label="@Culture["AdminShell.SearchOpen"]" @onkeydown="OnSearchKey">
        <div class="admin-search-sheet__bar">
            <AdminGlobalSearch AutoFocus="true" OnClose="CloseMobileSearch" />
            <button type="button" class="admin-search-sheet__close" @onclick="CloseMobileSearch">
                @Culture["AdminUi.CloseDrawer"]
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string EnvLabel { get; set; } = DeploymentEnvironment.Lokaal;
    [Parameter] public EventCallback OnMenuClick { get; set; }

    private LobsyShellTopBar? _topBar;
    private bool _mobileSearchOpen;

    private void OpenMobileSearch() => _mobileSearchOpen = true;

    private void CloseMobileSearch() => _mobileSearchOpen = false;

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMobileSearch();
        }
    }

    public Task FocusSearchAsync() => _topBar?.FocusSearchAsync() ?? Task.CompletedTask;
}
