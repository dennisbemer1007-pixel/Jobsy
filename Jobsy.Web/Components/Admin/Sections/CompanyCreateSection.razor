@*
  KvK create form extracted from CompaniesAdmin (04) — logic unchanged.
*@
@namespace Jobsy.Web.Components.Admin.Sections
@inject JobsyApiClient Api
@inject CultureState Culture
@inject IHostEnvironment Env

<section class="admin-company-create">
    <form class="login-form" @onsubmit="LookupAsync" @onsubmit:preventDefault>
        <label>
            @Culture["AdminOrgs.KvkNumber"]
            <input @bind="_kvkNumber" @bind:event="oninput" placeholder="8 cijfers" inputmode="numeric" maxlength="8" required />
        </label>
        @if (Env.IsDevelopment())
        {
            <p class="muted admin-company-create__hint">
                @Culture["AdminOrgs.KvkDemoHint"]
            </p>
        }
        <label>
            @Culture["AdminOrgs.ColType"]
            <select @bind="_newType">
                <option value="Employer">@Culture["AdminOrgs.TypeEmployer"]</option>
                <option value="Intermediary">@Culture["AdminOrgs.TypeIntermediary"]</option>
            </select>
        </label>
        <button class="btn-compact btn-compact--primary" type="submit" disabled="@(_busy || !KvkLooksValid)">
            @Culture["AdminOrgs.LookupEstablishments"]
        </button>
        @if (!KvkLooksValid)
        {
            <p class="muted">@Culture["AdminOrgs.KvkHint"]</p>
        }
    </form>

    @if (_establishments.Count > 0)
    {
        <div class="table-list admin-company-create__list">
            @foreach (var e in _establishments)
            {
                <div class="table-row">
                    <div>
                        <strong>@e.Name</strong>
                        <span class="muted">@e.Address · @e.KvkEstablishmentId</span>
                    </div>
                    @if (e.IsInUse)
                    {
                        <span class="muted">@Culture["AdminOrgs.AlreadyRegistered"]</span>
                    }
                    else
                    {
                        <button class="btn-compact" type="button" disabled="@_busy" @onclick="() => RegisterAsync(e)">
                            @Culture["AdminOrgs.AddEstablishment"]
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
</section>

@code {
    [Parameter] public EventCallback OnCreated { get; set; }

    private List<KvkEstablishmentItem> _establishments = [];
    private string _kvkNumber = "55667788";
    private string _newType = "Intermediary";
    private bool _busy;
    private string? _message;

    private bool KvkLooksValid
    {
        get
        {
            var kvk = _kvkNumber.Trim();
            return kvk.Length == 8 && kvk.All(char.IsDigit);
        }
    }

    private async Task LookupAsync()
    {
        if (!KvkLooksValid)
        {
            _message = Culture["AdminOrgs.KvkDigits"];
            _establishments = [];
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            _establishments = (await Api.GetKvkEstablishmentsAsync(_kvkNumber.Trim())).ToList();
            if (_establishments.Count == 0)
            {
                _message = Culture["AdminOrgs.NoEstablishments"];
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _establishments = [];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegisterAsync(KvkEstablishmentItem e)
    {
        _busy = true;
        _message = null;
        try
        {
            await Api.RegisterAdminCompanyFromKvkAsync(e.KvkNumber, e.KvkEstablishmentId, _newType);
            _message = string.Format(Culture["AdminOrgs.AddedAs"], e.Name, _newType);
            _establishments = (await Api.GetKvkEstablishmentsAsync(_kvkNumber.Trim())).ToList();
            await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
