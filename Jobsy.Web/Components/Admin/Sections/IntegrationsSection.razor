@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

@if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        @if (_aiProvider is not null)
        {
            <p class="muted" data-testid="ai-provider">
                <strong>@Culture["Admin.AiProvider.Title"]:</strong>
                @(IsMistral ? Culture["Admin.AiProvider.Mistral"] : Culture["Admin.AiProvider.OpenAI"])
                @Culture["Admin.AiProvider.ReadOnly"]
            </p>
            @if (_aiProvider.FellBackToOpenAi)
            {
                <p class="muted">@Culture["Admin.AiProvider.Fallback"]</p>
            }
        }
        <div class="company-grid">
            @foreach (var cred in _credentials)
            {
                var health = _health.FirstOrDefault(h => string.Equals(h.Key, cred.Key, StringComparison.OrdinalIgnoreCase));
                <IntegrationSettingsTile @key="cred.Key" Credential="cred" Health="health" OnChanged="ReloadAsync" />
            }
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
@code {
    private List<IntegrationHealthItem> _health = [];
    private List<IntegrationCredentialItem> _credentials = [];
    private AiProviderStatusItem? _aiProvider;
    private bool _loading = true;
    private string? _error;
    private string? _message;


    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        _health = (await Api.GetIntegrationHealthAsync()).ToList();
        _credentials = (await Api.GetIntegrationCredentialsAsync()).ToList();
        _message = null;
        try
        {
            _aiProvider = await Api.GetAiProviderAsync();
        }
        catch (Exception)
        {
            _aiProvider = null;
            _message = Culture["Common.Error"];
        }
    }

    private bool IsMistral
        => string.Equals(_aiProvider?.Provider, "Mistral", StringComparison.OrdinalIgnoreCase);
}
