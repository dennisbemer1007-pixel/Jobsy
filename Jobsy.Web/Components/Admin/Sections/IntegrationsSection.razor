@using Jobsy.Web.Components.Admin
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

@if (_loading)
    {
        <p class="state-message">@Culture["Common.Loading"]</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="state-message error">@_error</p>
    }
    else
    {
        @if (ActiveAi is not null)
        {
            <p class="muted" data-testid="ai-provider-active">
                Actieve AI-provider: <strong>@ActiveAi.ActiveAiProvider</strong>
                @if (!string.IsNullOrWhiteSpace(ActiveAi.ActiveAiModel))
                {
                    <text> · model @ActiveAi.ActiveAiModel</text>
                }
                . Alleen lezen. Wisselen doe je met <code>Ai__Provider</code>.
            </p>
        }
        <div class="company-grid">
            @foreach (var cred in _credentials)
            {
                var health = _health.FirstOrDefault(h => string.Equals(h.Key, cred.Key, StringComparison.OrdinalIgnoreCase));
                <IntegrationSettingsTile @key="cred.Key" Credential="cred" Health="health" OnChanged="ReloadAsync" />
            }
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }
    }
@code {
    private List<IntegrationHealthItem> _health = [];
    private List<IntegrationCredentialItem> _credentials = [];
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private IntegrationCredentialItem? ActiveAi =>
        _credentials.FirstOrDefault(c =>
            string.Equals(c.Key, "OpenAI", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(c.ActiveAiProvider));


    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        _health = (await Api.GetIntegrationHealthAsync()).ToList();
        _credentials = (await Api.GetIntegrationCredentialsAsync()).ToList();
        _message = null;
    }
}
