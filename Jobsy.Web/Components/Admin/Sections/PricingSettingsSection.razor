@using Jobsy.Web.Components.Admin
@using Jobsy.Web.Navigation
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

@* Mode: tokens | pushbom | flex | early | all *@
@if (_loading)
{
    <p class="state-message">@Culture["Common.Loading"]</p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <p class="state-message error">@_error</p>
}
else
{
    @if (Show("tokens"))
    {
<section class="panel-section">
            <h2>Token pricing — pakketten voor werkgevers</h2>
            <p class="muted">
                Deze actieve pakketten verschijnen op de Tokens-tab voor bedrijfsmanagers, vestigingsmanagers en intermediairs.
                Pas hier prijzen aan; dit staat los van salespakketten.
            </p>
            <p class="muted">
                Ambassadeur-commissiedrempels en overrides: <a class="auth-link" href="/admin/gebruikers/sales?tab=ambassadeurs">Ambassadeurs beheer</a>
                · Salesmanager-tarieven: <a class="auth-link" href="/admin/financien/prijzen?tab=sales">Sales beheer</a>.
            </p>
            <div class="table-list">
                @foreach (var pack in _settings?.Packs ?? [])
                {
                    <div class="table-row">
                        <div>
                            <strong>@pack.PackSize tokens</strong>
                            <span class="muted">@(pack.IsActive ? "actief" : "inactief")</span>
                        </div>
                        <div class="inline-actions">
                            <input type="number" step="0.01" min="0" @bind="pack.PriceEuro" style="width:5.5rem" />
                            <label class="filter-check"><input type="checkbox" @bind="pack.IsActive" /> Actief</label>
                            <button class="btn-compact" type="button" @onclick="() => SavePackAsync(pack)">@Culture["Common.Save"]</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Show("flex"))
    {
        <section class="panel-section">
            <h2>Lobsy Flex &amp; talent — bedragen</h2>
            <p class="muted">Alle commerciële bedragen uit de platformspecificatie. Tokens voor contact ontgrendelen worden ook bij de kosten per actie hierboven gezet.</p>
            @if (_lobsyCommercial is not null)
            {
                <article class="company-card platform-features-card" style="margin-bottom:1rem">
                    <div class="inline-actions" style="flex-wrap:wrap;gap:0.75rem;align-items:end">
                        <label>
                            Uitgebreide test Competenties (incl. btw)
                            <input type="number" min="0.01" max="100" step="0.01" @bind="_lobsyCommercial.DeepTestPriceCompetenceEuro" style="width:6rem" />
                        </label>
                        <label>
                            Uitgebreide test Beroepen (incl. btw)
                            <input type="number" min="0.01" max="100" step="0.01" @bind="_lobsyCommercial.DeepTestPriceCareerEuro" style="width:6rem" />
                        </label>
                        <label>
                            Uitgebreide test Waarden (incl. btw)
                            <input type="number" min="0.01" max="100" step="0.01" @bind="_lobsyCommercial.DeepTestPriceValuesEuro" style="width:6rem" />
                        </label>
                        <label>
                            Uitgebreide test Cultuur (incl. btw)
                            <input type="number" min="0.01" max="100" step="0.01" @bind="_lobsyCommercial.DeepTestPriceCultureEuro" style="width:6rem" />
                        </label>
                        <label>
                            Flex-marge (€/uur)
                            <input type="number" min="0" max="100" step="0.01" @bind="_lobsyCommercial.MarginPerHourEuro" style="width:6rem" />
                        </label>
                        <label>
                            Uitzend-jaarabonnement (€)
                            <input type="number" min="0" max="1000000" step="1" @bind="_lobsyCommercial.AgencyAnnualPriceEuro" style="width:7rem" />
                        </label>
                        <label>
                            Contact ontgrendelen (tokens)
                            <input type="number" min="0.1" max="100" step="0.1" @bind="_lobsyCommercial.ContactUnlockCostTokens" style="width:5.5rem" />
                        </label>
                        <label style="min-width:12rem;flex:1">
                            Backoffice-partner
                            <input @bind="_lobsyCommercial.BackofficePartnerName" style="width:100%" />
                        </label>
                        <label class="filter-check" style="align-self:center">
                            <input type="checkbox" @bind="_lobsyCommercial.FirstEmployerAcceptanceFreeEnabled" />
                            Eerste acceptatie werkgever gratis
                        </label>
                        <button class="btn-compact btn-compact--primary" type="button" disabled="@_lobsyCommercialBusy" @onclick="SaveLobsyCommercialAsync">@Culture["Common.Save"]</button>
                    </div>
                </article>
            }
        </section>
    }

    @if (Show("tokens"))
    {
        <section class="panel-section">
            <h2>Financieel — kosten per actie</h2>
            <p class="muted">@Culture["AdminFinance.CostIntro"]</p>
            <div class="table-list">
                @foreach (var cost in _settings?.Costs ?? [])
                {
                    <div class="table-row">
                        <div>
                            <strong>@CostLabel(cost.Reason)</strong>
                            <span class="muted">@(cost.IsActive ? "actief" : "inactief")</span>
                        </div>
                        <div class="inline-actions">
                            <input type="number" step="0.1" min="0" @bind="cost.CostTokens" style="width:5.5rem" />
                            <label class="filter-check"><input type="checkbox" @bind="cost.IsActive" /> Actief</label>
                            <button class="btn-compact" type="button" @onclick="() => SaveCostAsync(cost)">@Culture["Common.Save"]</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Show("pushbom"))
    {
        <section class="panel-section">
            <h2>PushBom — bereik &amp; tokenprijs</h2>
            <p class="muted">Straal en maximale reistijd bepalen het potentiële bereik. Tokenkost hangt af van het aantal geschikte kandidaten in dat bereik.</p>

            @if (_pushBomSettings is not null)
            {
                <article class="company-card platform-features-card" style="margin-bottom:1rem">
                    <div class="inline-actions" style="flex-wrap:wrap;gap:0.75rem">
                        <label>
                            Straal (km)
                            <input type="number" min="1" max="100" step="0.5" @bind="_pushBomSettings.RadiusKm" style="width:5.5rem" />
                        </label>
                        <label>
                            Max. reistijd (min)
                            <input type="number" min="5" max="180" @bind="_pushBomSettings.MaxTravelMinutes" style="width:5.5rem" />
                        </label>
                        <button class="btn-compact btn-compact--primary" type="button" disabled="@_pushBomBusy" @onclick="SavePushBomSettingsAsync">@Culture["Common.Save"]</button>
                    </div>
                </article>
            }

            <div class="table-list">
                @foreach (var tier in _pushBomTiers)
                {
                    <div class="table-row">
                        <div class="inline-actions" style="flex-wrap:wrap">
                            <label>
                                Min
                                <input type="number" min="0" @bind="tier.MinCandidates" style="width:4rem" />
                            </label>
                            <label>
                                Max
                                <input type="number" min="0" value="@(tier.MaxCandidates?.ToString() ?? "")"
                                       @onchange="e => SetTierMax(tier, e)" style="width:4rem" title="Leeg = onbeperkt" />
                            </label>
                            <label>
                                Tokens
                                <input type="number" step="0.1" min="0" @bind="tier.CostTokens" style="width:4.5rem" />
                            </label>
                            <label class="filter-check"><input type="checkbox" @bind="tier.IsActive" /> Actief</label>
                            <button class="btn-compact" type="button" @onclick="() => SaveTierAsync(tier)">@Culture["Common.Save"]</button>
                            <button type="button" class="icon-btn icon-btn--danger" title="Verwijderen" aria-label="Tier verwijderen" @onclick="() => DeleteTierAsync(tier)">
                                @((MarkupString)ActionIcons.Trash)
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="inline-actions" style="margin-top:0.75rem">
                <button class="btn-compact" type="button" @onclick="AddTier">+ Tier toevoegen</button>
            </div>
        </section>
    }

    @if (Show("early"))
    {
        <section class="panel-section">
            <h2>@Culture["AdminTabs.EarlyAdapters"]</h2>
            <div class="table-list">
                @foreach (var rule in _settings?.EarlyAdapterRules ?? [])
                {
                    <div class="table-row">
                        <div style="flex:1">
                            <input @bind="rule.Name" style="width:100%;margin-bottom:0.35rem" />
                            <span class="muted">Maandelijks grant / aankoopkorting %</span>
                        </div>
                        <div class="inline-actions">
                            <input type="number" min="0" @bind="rule.MonthlyGrantTokens" style="width:4.5rem" title="Monthly grant" />
                            <input type="number" step="0.1" min="0" max="100" @bind="rule.PurchaseDiscountPercent" style="width:4.5rem" title="Discount %" />
                            <label class="filter-check"><input type="checkbox" @bind="rule.IsActive" /> Actief</label>
                            <button class="btn-compact" type="button" @onclick="() => SaveRuleAsync(rule)">@Culture["Common.Save"]</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message">@_message</p>
    }
}

@code {
    [Parameter] public string Mode { get; set; } = "all";

    private bool Show(string key)
        => string.Equals(Mode, "all", StringComparison.OrdinalIgnoreCase)
           || string.Equals(Mode, key, StringComparison.OrdinalIgnoreCase);

    private string CostLabel(string reason)
    {
        var key = "TokenSpendCost." + reason;
        var label = Culture[key];
        return string.Equals(label, key, StringComparison.Ordinal) ? reason : label;
    }

    private TokenPricingSettings? _settings;
    private PushBomSettingsItem? _pushBomSettings;
    private LobsyCommercialSettingsItem? _lobsyCommercial;
    private List<PushBomPricingTierItem> _pushBomTiers = [];
    private bool _loading = true;
    private bool _pushBomBusy;
    private bool _lobsyCommercialBusy;
    private string? _error;
    private string? _message;

    protected override void OnInitialized()
        => Culture.Changed += OnCultureChanged;

    private void OnCultureChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Culture.Changed -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await Api.GetTokenPricingSettingsAsync();
            _pushBomSettings = _settings?.PushBomSettings ?? new PushBomSettingsItem();
            _pushBomTiers = _settings?.PushBomPricingTiers?.ToList() ?? [];
            _lobsyCommercial = _settings?.LobsyCommercial ?? new LobsyCommercialSettingsItem();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveLobsyCommercialAsync()
    {
        if (_lobsyCommercial is null)
        {
            return;
        }

        _lobsyCommercialBusy = true;
        _message = null;
        try
        {
            _lobsyCommercial = await Api.UpdateLobsyCommercialAsync(_lobsyCommercial) ?? _lobsyCommercial;
            _settings = await Api.GetTokenPricingSettingsAsync();
            _message = "Lobsy Flex & talent-bedragen opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _lobsyCommercialBusy = false;
        }
    }

    private async Task SavePackAsync(TokenPackSetting pack)
    {
        try
        {
            await Api.UpdateTokenPackAsync(pack.Id, pack.PriceEuro, pack.IsActive);
            _message = $"Pack {pack.PackSize} opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SaveCostAsync(TokenCostSetting cost)
    {
        try
        {
            await Api.UpdateTokenCostAsync(cost.Id, cost.CostTokens, cost.IsActive);
            _message = $"Cost {cost.Reason} opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SavePushBomSettingsAsync()
    {
        if (_pushBomSettings is null)
        {
            return;
        }

        _pushBomBusy = true;
        try
        {
            var saved = await Api.UpdatePushBomSettingsAsync(
                _pushBomSettings.RadiusKm,
                _pushBomSettings.MaxTravelMinutes);
            if (saved is not null)
            {
                _pushBomSettings = saved;
            }

            _message = "PushBom bereik-instellingen opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _pushBomBusy = false;
        }
    }

    private void AddTier()
    {
        var nextMin = _pushBomTiers.Count == 0
            ? 1
            : _pushBomTiers.Max(t => t.MaxCandidates ?? t.MinCandidates) + 1;
        _pushBomTiers.Add(new PushBomPricingTierItem
        {
            Id = Guid.Empty,
            MinCandidates = nextMin,
            MaxCandidates = nextMin + 9,
            CostTokens = 1m,
            IsActive = true
        });
    }

    private static void SetTierMax(PushBomPricingTierItem tier, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw))
        {
            tier.MaxCandidates = null;
            return;
        }

        tier.MaxCandidates = int.TryParse(raw, out var value) ? value : tier.MaxCandidates;
    }

    private async Task SaveTierAsync(PushBomPricingTierItem tier)
    {
        try
        {
            var saved = await Api.UpsertPushBomPricingTierAsync(tier);
            if (saved is not null)
            {
                tier.Id = saved.Id;
                tier.MinCandidates = saved.MinCandidates;
                tier.MaxCandidates = saved.MaxCandidates;
                tier.CostTokens = saved.CostTokens;
                tier.IsActive = saved.IsActive;
            }

            _message = "PushBom-prijstier opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task DeleteTierAsync(PushBomPricingTierItem tier)
    {
        try
        {
            if (tier.Id != Guid.Empty)
            {
                await Api.DeletePushBomPricingTierAsync(tier.Id);
            }

            _pushBomTiers.Remove(tier);
            _message = "PushBom-prijstier verwijderd.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SaveRuleAsync(EarlyAdapterRuleItem rule)
    {
        try
        {
            var saved = await Api.UpsertEarlyAdapterRuleAsync(rule);
            if (saved is not null)
            {
                rule.Id = saved.Id;
            }

            _message = $"Rule '{rule.Name}' opgeslagen.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }
}
