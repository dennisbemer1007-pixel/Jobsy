    private void OpenBulkConfirm(string action)
    {
        _bulkAction = action;
        _bulkTitle = action == "block"
            ? Culture["AdminUsers.BulkBlock"]
            : Culture["AdminUsers.BulkEndSessions"];
        _bulkReason = "";
        _bulkError = null;
        _bulkOpen = true;
    }

    private async Task ConfirmBulkAsync()
    {
        if (_selected.Count == 0 || _bulkReason.Trim().Length < 5) return;
        _busy = true;
        _bulkError = null;
        try
        {
            var result = await Api.BulkAdminUsersAsync(
                _bulkAction == "block" ? "block" : "revoke-sessions",
                _selected.ToList(),
                _bulkReason.Trim());
            _toast = string.Format(Culture["AdminUsers.BulkResult"], result.Succeeded, result.Skipped);
            _bulkOpen = false;
            _selected.Clear();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _bulkError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record ActiveGrantBanner(Guid Id, DateTime ExpiresAt, string Reason);
}
