@using Jobsy.Web.Admin
@* Expandable integration settings tile with green/red status and live test. *@
@inject CultureState Culture

<article class="company-card integration-tile @(StatusClass)" @onclick="Toggle">
    <div class="integration-tile__header">
        <div>
            <h3 class="company-card__name">@Credential.DisplayName</h3>
            <p class="company-card__meta">@StatusLabel</p>
        </div>
        <div class="integration-tile__actions">
            @if (Help is not null)
            {
                <button type="button"
                        class="integration-tile__info @(_helpOpen ? "is-open" : null)"
                        title="Informatie over @Credential.DisplayName"
                        aria-label="Informatie over @Credential.DisplayName"
                        aria-expanded="@_helpOpen"
                        @onclick="ToggleHelp"
                        @onclick:stopPropagation="true">
                    i
                </button>
            }
            <span class="integration-tile__chevron" aria-hidden="true">@(_expanded ? "▾" : "▸")</span>
        </div>
    </div>
    <p class="company-card__address">@(string.IsNullOrWhiteSpace(StatusMessage) ? Credential.Description : StatusMessage)</p>

    @if (_helpOpen && Help is not null)
    {
        <aside class="integration-help" @onclick:stopPropagation="true">
            <p class="integration-help__summary">@Help.Summary</p>
            <dl class="integration-help__list">
                <div>
                    <dt>Gebruik in Lobsy</dt>
                    <dd>@Help.UsedFor</dd>
                </div>
                <div>
                    <dt>Key / credentials aanmaken</dt>
                    <dd>@Help.WhereToGetKey</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Help.Tip))
                {
                    <div>
                        <dt>Tip</dt>
                        <dd>@Help.Tip</dd>
                    </div>
                }
            </dl>
            @if (!string.IsNullOrWhiteSpace(Help.DocsUrl))
            {
                <p class="integration-help__link">
                    <a class="auth-link" href="@Help.DocsUrl" target="_blank" rel="noopener noreferrer"
                       @onclick:stopPropagation="true">
                        @(Help.DocsUrlLabel ?? "Documentatie openen") ↗
                    </a>
                </p>
            }
        </aside>
    }

    @if (_expanded)
    {
        <div class="integration-key-form" @onclick:stopPropagation="true">
            <p class="muted">@Credential.Description</p>

            @if (Credential.SupportsApiKey)
            {
                @if (Credential.HasApiKey && !string.IsNullOrWhiteSpace(Credential.ApiKeyMasked))
                {
                    <p class="muted">@(IsMailIntegration ? "Huidige Resend API-key:" : "Huidige API-key:") @Credential.ApiKeyMasked</p>
                }
                else
                {
                    <p class="muted">@(IsMailIntegration ? "Nog geen Resend API-key opgeslagen." : "Nog geen API-key opgeslagen.")</p>
                }
                <label>
                    @(IsMailIntegration ? "Resend API-key (aanbevolen)" : "API-key")
                    @* type=text + text-security: empty field stays empty (no browser password-dots). *@
                    <input class="integration-secret-input"
                           type="text"
                           autocomplete="off"
                           autocorrect="off"
                           autocapitalize="off"
                           spellcheck="false"
                           data-lpignore="true"
                           data-1p-ignore="true"
                           name="@($"integration-{Credential.Key}-api-key")"
                           placeholder="@(IsMailIntegration
                               ? (Credential.HasApiKey ? "Nieuwe Resend-key (leeg = behouden)" : "re_...")
                               : (Credential.HasApiKey ? "Nieuwe key (leeg = behouden)" : "Plak API-key"))"
                           @bind="_apiKey"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>
                @if (IsMailIntegration)
                {
                    <p class="muted">Op cloud-hosts blokkeert Gmail SMTP vaak (fout 5.7.9). Resend werkt wél: key van resend.com, From geverifieerd of tijdelijk onboarding@resend.dev.</p>
                    @if (Credential.UsesEnvironmentCredentials)
                    {
                        <p class="muted">Minimaal één veld komt uit de omgeving (<code>Mail__ResendApiKey</code> / <code>Mail__FromAddress</code>). Resend is pas klaar als key én From gezet zijn.</p>
                    }
                    @if (Credential.IgnoresEnvironmentCredentials)
                    {
                        <p class="muted">Omgevingscredentials zijn uitgeschakeld na “Secrets wissen”. Plak nieuwe keys of heractiveer de omgeving hieronder.</p>
                    }
                }
            }

            @if (Credential.SupportsOAuth)
            {
                @if (IsMailIntegration)
                {
                    <p class="muted"><strong>Optioneel:</strong> SMTP (alleen als Resend niet gebruikt wordt; Gmail vanaf servers faalt vaak).</p>
                }
                <label>
                    @(IsMailIntegration ? "SMTP-gebruiker (Gmail-adres)" : "Client ID")
                    <input @bind="_clientId"
                           @bind:event="oninput"
                           @bind:after="MarkDirty"
                           placeholder="@(IsMailIntegration ? "jouw@gmail.com" : null)" />
                </label>
                @if (Credential.HasClientSecret && !string.IsNullOrWhiteSpace(Credential.ClientSecretMasked))
                {
                    <p class="muted">@(IsMailIntegration ? "Huidig app-wachtwoord:" : "Huidig secret:") @Credential.ClientSecretMasked</p>
                }
                else
                {
                    <p class="muted">@(IsMailIntegration ? "Nog geen app-wachtwoord opgeslagen." : "Nog geen client secret opgeslagen.")</p>
                }
                <label>
                    @(IsMailIntegration ? "App-wachtwoord" : "Client Secret")
                    <input class="integration-secret-input"
                           type="text"
                           autocomplete="off"
                           autocorrect="off"
                           autocapitalize="off"
                           spellcheck="false"
                           data-lpignore="true"
                           data-1p-ignore="true"
                           name="@($"integration-{Credential.Key}-client-secret")"
                           placeholder="@(IsMailIntegration
                               ? (Credential.HasClientSecret ? "Nieuw app-wachtwoord (leeg = behouden)" : "16-tekens app-wachtwoord")
                               : (Credential.HasClientSecret ? "Nieuw secret (leeg = behouden)" : "Client secret"))"
                           @bind="_clientSecret"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>
            }

            @if (Credential.SupportsTenantId)
            {
                <label>
                    Tenant ID
                    <input @bind="_tenantId" @bind:event="oninput" @bind:after="MarkDirty" placeholder="common of tenant-guid" />
                </label>
            }

            @if (Credential.SupportsModel)
            {
                <label>
                    Model
                    <input @bind="_model" @bind:event="oninput" @bind:after="MarkDirty" placeholder="gpt-4o-mini" />
                </label>
            }

            @if (Credential.SupportsBaseUrl)
            {
                <label>
                    @(IsMailIntegration ? "SMTP-host" : "Base URL")
                    <input @bind="_baseUrl"
                           @bind:event="oninput"
                           @bind:after="MarkDirty"
                           placeholder="@(IsMailIntegration ? "smtp.gmail.com" : "https://...")" />
                </label>
                @if (IsMailIntegration)
                {
                    <label>
                        SMTP-poort
                        <input type="number"
                               min="1"
                               max="65535"
                               inputmode="numeric"
                               @bind="_smtpPort"
                               @bind:event="oninput"
                               @bind:after="MarkDirty"
                               placeholder="587" />
                    </label>
                    <p class="muted">Alleen de hostnaam (geen https://). Standaardpoort 587 (STARTTLS); 465 voor SSL.</p>
                }
            }

            @if (Credential.SupportsFromAddress)
            {
                <label>
                    Afzender (From)
                    <input @bind="_fromAddress"
                           @bind:event="oninput"
                           @bind:after="MarkDirty"
                           placeholder="@(IsMailIntegration ? "onboarding@resend.dev of jouw@domein.nl" : "noreply@example.com")" />
                </label>
            }

            <div class="inline-actions">
                <button class="btn-compact" type="button" disabled="@_busy" @onclick="SaveAsync" @onclick:stopPropagation="true">@Culture["Common.Save"]</button>
                <button class="btn-compact btn-compact--primary" type="button" disabled="@_busy" @onclick="TestAsync" @onclick:stopPropagation="true">Test verbinding</button>
                @if (Credential.HasApiKey || Credential.HasClientSecret)
                {
                    <button class="btn-compact" type="button" disabled="@_busy" @onclick="ClearSecretsAsync" @onclick:stopPropagation="true">Secrets wissen</button>
                }
                @if (IsMailIntegration && Credential.IgnoresEnvironmentCredentials)
                {
                    <button class="btn-compact" type="button" disabled="@_busy" @onclick="UseEnvironmentAsync" @onclick:stopPropagation="true">Omgeving opnieuw gebruiken</button>
                }
            </div>

            @if (IsMailIntegration)
            {
                <div class="integration-test-mail" @onclick:stopPropagation="true">
                    <label>
                        Testmail naar
                        <input type="email"
                               autocomplete="email"
                               @bind="_testMailTo"
                               @bind:event="oninput"
                               placeholder="jouw@email.nl" />
                    </label>
                    <button class="btn-compact btn-compact--primary"
                            type="button"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_testMailTo))"
                            @onclick="SendTestMailAsync"
                            @onclick:stopPropagation="true">
                        Stuur testmail
                    </button>
                    <p class="muted">Stuurt een echte testmail via Resend (als API-key gezet is) of SMTP.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(_localMessage))
            {
                <p class="state-message @(_localOk == false ? "error" : null)">@_localMessage</p>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public IntegrationCredentialItem Credential { get; set; } = default!;
    [Parameter] public IntegrationHealthItem? Health { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Inject] private JobsyApiClient Api { get; set; } = default!;

    private string? _boundKey;
    private DateTime? _boundUpdatedAtUtc;
    private bool _expanded;
    private bool _helpOpen;
    private bool _busy;
    private bool _dirty;
    private bool? _localOk;
    private string? _localMessage;
    private string _apiKey = "";
    private string _clientId = "";
    private string _clientSecret = "";
    private string _tenantId = "";
    private string _model = "gpt-4o-mini";
    private string _baseUrl = "";
    private string _smtpPort = "587";
    private string _fromAddress = "";
    private string _testMailTo = "";

    private IntegrationHelpDocs.Doc? Help => IntegrationHelpDocs.TryGet(Credential.Key);

    private string StatusClass => EffectivePingOk switch
    {
        true => "integration-tile--ok",
        false => "integration-tile--fail",
        null => "integration-tile--unknown"
    };

    private bool? EffectivePingOk => Health?.LastPingOk ?? Credential.LastPingOk;

    private string StatusLabel => EffectivePingOk switch
    {
        true => "Verbonden",
        false => "Geen verbinding",
        null => "Niet getest"
    };

    private string StatusMessage =>
        !string.IsNullOrWhiteSpace(Health?.StatusMessage)
            ? Health!.StatusMessage
            : Credential.LastPingMessage ?? string.Empty;

    private bool IsMailIntegration =>
        string.Equals(Credential.Key, "Mail", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        var keyChanged = !string.Equals(_boundKey, Credential.Key, StringComparison.OrdinalIgnoreCase);
        var serverUpdated = Credential.UpdatedAtUtc != _boundUpdatedAtUtc;
        if (keyChanged)
        {
            _boundKey = Credential.Key;
            _expanded = false;
            _helpOpen = false;
            _dirty = false;
            SyncDraftsFromCredential();
            return;
        }

        // Refresh drafts from server after save/test reload, unless the user is mid-edit.
        if (serverUpdated && !_dirty)
        {
            SyncDraftsFromCredential();
        }
    }

    private void SyncDraftsFromCredential()
    {
        _apiKey = "";
        _clientSecret = "";
        _clientId = Credential.ClientId ?? "";
        _tenantId = Credential.TenantId ?? "";
        _model = Credential.Model ?? "gpt-4o-mini";
        SplitHostAndPort(Credential.BaseUrl, out _baseUrl, out _smtpPort);
        _fromAddress = Credential.FromAddress ?? "";
        if (IsMailIntegration && string.IsNullOrWhiteSpace(_testMailTo) && !string.IsNullOrWhiteSpace(_fromAddress))
        {
            _testMailTo = _fromAddress;
        }

        _boundUpdatedAtUtc = Credential.UpdatedAtUtc;
        _dirty = false;
    }

    private static void SplitHostAndPort(string? stored, out string host, out string port)
    {
        host = "";
        port = "587";
        if (string.IsNullOrWhiteSpace(stored))
        {
            return;
        }

        var raw = stored.Trim();
        var colon = raw.LastIndexOf(':');
        if (colon > 0
            && colon < raw.Length - 1
            && int.TryParse(raw[(colon + 1)..], out var parsed)
            && parsed is > 0 and <= 65535)
        {
            host = raw[..colon].Trim();
            port = parsed.ToString();
            return;
        }

        host = raw;
    }

    private static string CombineHostAndPort(string host, string portText)
    {
        var cleanedHost = (host ?? string.Empty).Trim();
        // Drop accidental host:port if the user typed both into the host field.
        var colon = cleanedHost.LastIndexOf(':');
        if (colon > 0
            && colon < cleanedHost.Length - 1
            && int.TryParse(cleanedHost[(colon + 1)..], out var embedded)
            && embedded is > 0 and <= 65535)
        {
            cleanedHost = cleanedHost[..colon].Trim();
        }

        if (!int.TryParse((portText ?? string.Empty).Trim(), out var port) || port is < 1 or > 65535)
        {
            port = 587;
        }

        return string.IsNullOrWhiteSpace(cleanedHost)
            ? string.Empty
            : $"{cleanedHost}:{port}";
    }

    private void MarkDirty() => _dirty = true;

    private void Toggle()
    {
        _expanded = !_expanded;
        if (_expanded && !_dirty)
        {
            SyncDraftsFromCredential();
            _localMessage = null;
        }
    }

    private void ToggleHelp()
    {
        _helpOpen = !_helpOpen;
    }

    private IntegrationCredentialSaveForm BuildSaveForm(bool clearSecrets = false, bool useEnvironment = false) => new()
    {
        ApiKey = Credential.SupportsApiKey ? _apiKey : null,
        Model = Credential.SupportsModel ? _model : null,
        ClientId = Credential.SupportsOAuth ? _clientId : null,
        ClientSecret = Credential.SupportsOAuth ? _clientSecret : null,
        TenantId = Credential.SupportsTenantId ? _tenantId : null,
        BaseUrl = Credential.SupportsBaseUrl
            ? (IsMailIntegration ? CombineHostAndPort(_baseUrl, _smtpPort) : _baseUrl)
            : null,
        FromAddress = Credential.SupportsFromAddress ? _fromAddress : null,
        ClearApiKey = clearSecrets && Credential.SupportsApiKey,
        ClearClientSecret = clearSecrets && Credential.SupportsOAuth,
        UseEnvironmentCredentials = useEnvironment
    };

    private async Task SaveAsync()
    {
        _busy = true;
        _localMessage = null;
        try
        {
            await Api.SaveIntegrationCredentialAsync(Credential.Key, BuildSaveForm());
            _apiKey = "";
            _clientSecret = "";
            _dirty = false;
            _localOk = true;
            _localMessage = "Opgeslagen. Klik op Test verbinding om te controleren.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _localOk = false;
            _localMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearSecretsAsync()
    {
        _busy = true;
        _localMessage = null;
        try
        {
            await Api.SaveIntegrationCredentialAsync(Credential.Key, BuildSaveForm(clearSecrets: true));
            _apiKey = "";
            _clientSecret = "";
            _fromAddress = IsMailIntegration ? "" : _fromAddress;
            _dirty = false;
            _localOk = true;
            _localMessage = IsMailIntegration
                ? "Secrets gewist. Omgevingsvariabelen voor Mail worden genegeerd tot je opnieuw opslaat of ‘Omgeving opnieuw gebruiken’ kiest."
                : "Secrets gewist.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _localOk = false;
            _localMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UseEnvironmentAsync()
    {
        _busy = true;
        _localMessage = null;
        try
        {
            await Api.SaveIntegrationCredentialAsync(Credential.Key, BuildSaveForm(useEnvironment: true));
            _dirty = false;
            _localOk = true;
            _localMessage = "Omgevingscredentials opnieuw actief (lege Admin-velden worden weer aangevuld).";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _localOk = false;
            _localMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync()
    {
        _busy = true;
        _localMessage = null;
        try
        {
            // Backend test leest alleen opgeslagen secrets uit de DB — eerst form bewaren
            // zodat getypte (nog niet opgeslagen) waarden ook meegenomen worden.
            var hasUnsavedSecrets =
                !string.IsNullOrWhiteSpace(_apiKey) ||
                !string.IsNullOrWhiteSpace(_clientSecret);
            if (_dirty || hasUnsavedSecrets)
            {
                await Api.SaveIntegrationCredentialAsync(Credential.Key, BuildSaveForm());
                _apiKey = "";
                _clientSecret = "";
                _dirty = false;
            }

            var result = await Api.TestIntegrationAsync(Credential.Key);
            if (result is not null)
            {
                _localOk = result.IsActive;
                _localMessage = result.StatusMessage;
            }

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _localOk = false;
            _localMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendTestMailAsync()
    {
        _busy = true;
        _localMessage = null;
        try
        {
            var hasUnsavedSecrets =
                !string.IsNullOrWhiteSpace(_apiKey) ||
                !string.IsNullOrWhiteSpace(_clientSecret);
            if (_dirty || hasUnsavedSecrets)
            {
                await Api.SaveIntegrationCredentialAsync(Credential.Key, BuildSaveForm());
                _apiKey = "";
                _clientSecret = "";
                _dirty = false;
            }

            var result = await Api.SendTestMailAsync(_testMailTo);
            if (result is not null)
            {
                _localOk = result.Ok;
                _localMessage = result.Message;
            }

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _localOk = false;
            _localMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
