@using Jobsy.Web.Navigation
@inject NavigationManager Navigation
@inject CultureState Culture

<div class="admin-page @(Wide ? "admin-page--wide" : null)">
    <AdminBreadcrumbs Detail="@CrumbDetail" />
    <header class="admin-page__header">
        <div class="admin-page__titles">
            <h1>@ResolvedTitle</h1>
            @if (!string.IsNullOrWhiteSpace(Lead))
            {
                <p class="login-lead">@Lead</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="admin-page__actions">
                @Actions
            </div>
        }
    </header>
    @ChildContent
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public string? CrumbDetail { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ResolvedTitle
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Title))
            {
                return Title;
            }

            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            var resolved = AdminNav.Resolve(path);
            return resolved is null ? Culture["AdminShell.Beheer"] : Culture[resolved.Value.Item.LabelKey];
        }
    }
}
