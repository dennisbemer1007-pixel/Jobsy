@namespace Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@inject CultureState Culture

<div class="pub-landing__passport-stage" aria-hidden="false" data-testid="landing-hero-passport">
    <div class="pub-landing__passport-card pub-landing__lift pub-landing__card-calm">
        <div class="pub-landing__passport-top">
            <b>@LandingText.For("Landing.Hero.PassportTitle", Variant)</b>
            <span class="pub-pill-sample">@Culture["Public.Sample"]</span>
        </div>
        <div class="pub-landing__passport-body">
            <div class="pub-landing__passport-rad">
                <div class="pub-landing__passport-lbl">@LandingText.For("Landing.Hero.RadarYou", Variant)</div>
                <svg class="pub-landing__radar-svg" viewBox="-36 -32 392 324" width="100%" aria-hidden="true">
                    <defs>
                        <linearGradient id="lh-rg" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#2F7D5B" stop-opacity=".30"/>
                            <stop offset="1" stop-color="#1F2F55" stop-opacity=".18"/>
                        </linearGradient>
                        <filter id="lh-sh" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#1F2F55" flood-opacity=".14"/>
                        </filter>
                    </defs>
                    <polygon points="160,57 225.8,95 225.8,171 160,209 94.2,171 94.2,95" fill="#FBF7F0" stroke="#E6DDCF" stroke-width="1"/>
                    <polygon points="160,76 209.4,104.5 209.4,161.5 160,190 110.6,161.5 110.6,104.5" fill="none" stroke="#E6DDCF" stroke-width="1"/>
                    <polygon points="160,95 192.9,114 192.9,152 160,171 127.1,152 127.1,114" fill="none" stroke="#E6DDCF" stroke-width="1"/>
                    <polygon points="160,114 176.5,123.5 176.5,142.5 160,152 143.5,142.5 143.5,123.5" fill="none" stroke="#E6DDCF" stroke-width="1"/>
                    <line x1="160" y1="133" x2="160" y2="57" stroke="#E6DDCF"/>
                    <line x1="160" y1="133" x2="225.8" y2="95" stroke="#E6DDCF"/>
                    <line x1="160" y1="133" x2="225.8" y2="171" stroke="#E6DDCF"/>
                    <line x1="160" y1="133" x2="160" y2="209" stroke="#E6DDCF"/>
                    <line x1="160" y1="133" x2="94.2" y2="171" stroke="#E6DDCF"/>
                    <line x1="160" y1="133" x2="94.2" y2="95" stroke="#E6DDCF"/>
                    <polygon points="160,67.6 208.7,104.9 200.8,156.6 160,172.5 99.4,168 115.2,107.2" fill="url(#lh-rg)" stroke="#1F2F55" stroke-width="1.8" stroke-linejoin="round" filter="url(#lh-sh)"/>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--t" x="160" y="42" text-anchor="middle">@LandingText.For("Landing.Hero.BarTeam", Variant)</text>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--tr" x="228" y="88" text-anchor="end">@LandingText.For("Landing.Hero.BarPersist", Variant)</text>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--br" x="228" y="186" text-anchor="end">@LandingText.For("Landing.Hero.BarCalm", Variant)</text>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--b" x="160" y="232" text-anchor="middle">@LandingText.For("Landing.Hero.BarCreative", Variant)</text>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--bl" x="92" y="186" text-anchor="start">@LandingText.For("Landing.Hero.BarCare", Variant)</text>
                    <text class="pub-landing__radar-lbl pub-landing__radar-lbl--tl" x="92" y="88" text-anchor="start">@LandingText.For("Landing.Hero.BarPrecision", Variant)</text>
                </svg>
            </div>
            <div class="pub-landing__passport-matches">
                <div class="pub-landing__passport-lbl">@LandingText.For("Landing.Hero.RadarFits", Variant)</div>
                @MatchRow("Landing.Hero.SampleJob1", "Landing.Hero.SampleJob1Meta", 91)
                @MatchRow("Landing.Hero.SampleJob2", "Landing.Hero.SampleJob2Meta", 86)
                @MatchRow("Landing.Hero.SampleJob3", "Landing.Hero.SampleJob3Meta", 72)
            </div>
        </div>
        <div class="pub-landing__passport-footer">
            <span class="pub-landing__passport-footer-pct" aria-hidden="true">91%</span>
            <div class="pub-landing__passport-footer-copy">
                <strong>@LandingText.For("Landing.Hero.TopMatch", Variant)</strong>
                <small>@LandingText.For("Landing.Hero.TopMatchMeta", Variant)</small>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public LandingVariant Variant { get; set; } = LandingVariant.On;

    private RenderFragment MatchRow(string titleKey, string metaKey, int pct) => __builder =>
    {
        <div class="pub-landing__match-row">
            <b class="pub-landing__match-job">@LandingText.For(titleKey, Variant)</b>
            <small class="pub-landing__match-meta">@LandingText.For(metaKey, Variant)</small>
            <div class="pub-landing__match-bar">
                <span class="pub-landing__match-pct">@pct%</span>
                <span class="pub-landing__match-track"><i style="@($"width:{pct}%")"></i></span>
            </div>
        </div>
    };
}
