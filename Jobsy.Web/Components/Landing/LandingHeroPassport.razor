@namespace Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<div class="pub-landing__scene pub-landing__hero-scene pub-landing__scene--zw" aria-hidden="false">
    <div class="pub-landing__blobs" aria-hidden="true">
        <svg class="pub-landing__blob pub-landing__blob--sun" viewBox="-100 -100 200 200" preserveAspectRatio="none"><path d="M60,-60C78,-42,92,-21,92,0C92,21,78,42,60,58C42,74,21,84,-2,86C-25,88,-50,82,-66,66C-82,50,-90,25,-88,2C-86,-21,-74,-42,-58,-60C-42,-78,-21,-92,0,-92C21,-92,42,-78,60,-60Z" fill="color-mix(in srgb, var(--gold) 40%, var(--surface))"/></svg>
        <svg class="pub-landing__blob pub-landing__blob--peach" viewBox="-100 -100 200 200" preserveAspectRatio="none"><path d="M55,-68C70,-54,80,-35,84,-15C88,5,86,26,75,43C64,60,44,73,22,80C0,87,-24,88,-43,78C-62,68,-76,47,-83,24C-90,1,-90,-24,-79,-43C-68,-62,-46,-75,-24,-80C-2,-85,40,-82,55,-68Z" fill="color-mix(in srgb, var(--coral) 18%, var(--surface))"/></svg>
    </div>
    <span class="pub-pill-sample">@Culture["Public.Sample"]</span>
    <span class="pub-landing__shell-tag">@LandingText.For("Landing.Hero.OldShell", Variant)</span>
    <div class="pub-landing__ppc" data-testid="landing-hero-passport">
        <div class="pub-landing__ppc-h">
            <LobsyMascot Pose="MascotPose.Default" Size="MascotSize.Tiny" Alt="" Class="pub-landing__ppc-logo" />
            <b>@LandingText.For("Landing.Hero.PassportTitle", Variant)</b>
        </div>
        <div class="pub-landing__ppc-b">
            <div class="pub-landing__ppc-g">
                <svg class="pub-landing__wheel" viewBox="0 0 150 150" width="150" height="150" aria-hidden="true">
                    <circle cx="75" cy="75" r="58" fill="none" stroke="color-mix(in srgb, var(--border) 70%, var(--surface))" stroke-width="16" stroke-dasharray="85 91" transform="rotate(-90 75 75)"/>
                    <circle cx="75" cy="75" r="58" fill="none" stroke="var(--coral)" stroke-width="16" stroke-linecap="round" stroke-dasharray="73 180" transform="rotate(-90 75 75)"/>
                    <circle cx="75" cy="75" r="58" fill="none" stroke="var(--gold)" stroke-width="16" stroke-linecap="round" stroke-dasharray="66 180" transform="rotate(0 75 75)"/>
                    <circle cx="75" cy="75" r="58" fill="none" stroke="var(--success)" stroke-width="16" stroke-linecap="round" stroke-dasharray="54 180" transform="rotate(90 75 75)"/>
                    <circle cx="75" cy="75" r="58" fill="none" stroke="var(--brand)" stroke-width="16" stroke-linecap="round" stroke-dasharray="60 180" transform="rotate(180 75 75)"/>
                    <text x="75" y="72" text-anchor="middle" class="pub-landing__wheel-t">@LandingText.For("Landing.Hero.WheelCenter", Variant)</text>
                    <text x="75" y="90" text-anchor="middle" class="pub-landing__wheel-s">@LandingText.For("Landing.Hero.WheelSub", Variant)</text>
                </svg>
                <div class="pub-landing__dlg" aria-hidden="true">
                    <div class="pub-landing__lg-r"><i class="t-coral"></i><span>@LandingText.For("Landing.Hero.Legend1", Variant)</span><b>86%</b></div>
                    <div class="pub-landing__lg-r"><i class="t-gold"></i><span>@LandingText.For("Landing.Hero.Legend2", Variant)</span><b>78%</b></div>
                    <div class="pub-landing__lg-r"><i class="t-ok"></i><span>@LandingText.For("Landing.Hero.Legend3", Variant)</span><b>64%</b></div>
                    <div class="pub-landing__lg-r"><i class="t-brand"></i><span>@LandingText.For("Landing.Hero.Legend4", Variant)</span><b>71%</b></div>
                </div>
                <div class="pub-landing__ppc-cc">
                    <span class="pub-pill pub-landing__ppc-chip">@LandingText.For("Landing.Hero.ChipCollab", Variant)</span>
                    <span class="pub-pill pub-landing__ppc-chip">@LandingText.For("Landing.Hero.ChipHelp", Variant)</span>
                    <span class="pub-pill pub-landing__ppc-chip">@LandingText.For("Landing.Hero.ChipWarm", Variant)</span>
                </div>
            </div>
        </div>
    </div>
    <div class="pub-landing__mascot pub-landing__mascot--zw">
        <LobsyMascot Pose="MascotPose.Waving" Size="MascotSize.Hero" Priority="true" Alt="" Class="pub-landing__mascot-img" />
        <div class="pub-landing__bubble">@LandingText.For("Landing.Hero.Bubble", Variant)</div>
    </div>
    <div class="pub-landing__float pub-landing__float--fit">
        <PubEmoji Glyph="✅" />
        <div>
            <strong class="pub-landing__float-desk">@LandingText.For("Landing.Hero.FitFloatTitle", Variant)</strong>
            <strong class="pub-landing__float-mob">@LandingText.For("Landing.Hero.FitFloatMobile", Variant)</strong>
            <small class="pub-landing__float-desk">@LandingText.For("Landing.Hero.FitFloatMeta", Variant)</small>
            <small class="pub-landing__float-mob">@LandingText.For("Landing.Hero.FitFloatMobileMeta", Variant)</small>
        </div>
    </div>
    <div class="pub-landing__float pub-landing__float--journey">
        <PubEmoji Glyph="🧭" />
        <div>
            <strong>@LandingText.For("Landing.Hero.JourneyFloatTitle", Variant)</strong>
            <small>@LandingText.For("Landing.Hero.JourneyFloatMeta", Variant)</small>
        </div>
    </div>
</div>

@code {
    [Parameter] public LandingVariant Variant { get; set; } = LandingVariant.Zw;
}
