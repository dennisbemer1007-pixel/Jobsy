@namespace Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media

<section class="pub-landing__section pub-landing__section--steps pub-landing__band-a" id="flow" aria-labelledby="landing-steps-title">
    <div class="pub-landing__wrap">
        <div class="pub-landing__eyebrow">@LandingText.For("Landing.Steps.Eyebrow", Variant)</div>
        <h2 id="landing-steps-title" class="pub-landing__h2">@LandingText.For("Landing.Steps.Title", Variant)</h2>
        <p class="pub-landing__lead pub-landing__lead--narrow">@LandingText.For("Landing.Steps.Sub", Variant)</p>
        <div class="pub-landing__steps-grid">
            @StepCard("1", CandidateIllustratedImages.StepVragen, "Landing.Steps.S1Title", "Landing.Steps.S1Body")
            @StepCard("2", CandidateIllustratedImages.StepDnaLanding, "Landing.Steps.S2Title", "Landing.Steps.S2Body")
            @StepCard("3", CandidateIllustratedImages.StepBanen, "Landing.Steps.S3Title", "Landing.Steps.S3Body")
        </div>
    </div>
</section>

@code {
    [Parameter] public LandingVariant Variant { get; set; } = LandingVariant.On;

    private RenderFragment StepCard(string num, string image, string titleKey, string bodyKey) => __builder =>
    {
        <article class="pub-landing__step-card pub-landing__card-calm">
            <div class="pub-landing__step-art pub-landing__step-art--@num" style="@($"background-image:url('{image}')")" aria-hidden="true"></div>
            <div class="pub-landing__step-body">
                <span class="pub-landing__step-num" aria-hidden="true">@num</span>
                <h3>@LandingText.For(titleKey, Variant)</h3>
                <p>@LandingText.For(bodyKey, Variant)</p>
            </div>
        </article>
    };
}
