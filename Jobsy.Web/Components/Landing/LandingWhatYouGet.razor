@namespace Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Navigation
@inject CultureState Culture

<section class="pub-landing__section" id="wat-je-krijgt">
    <div class="pub-landing__wrap">
        <div class="pub-landing__shead">
            <div>
                <div class="pub-landing__eyebrow">@LandingText.For("Landing.Get.Eyebrow", Variant)</div>
                <h2 class="pub-landing__h2">@LandingText.For("Landing.Get.Title", Variant)</h2>
            </div>
            <span class="pub-pill-sample">@LandingText.For("Landing.Get.Note", Variant)</span>
        </div>

        <div class="pub-landing__showmap">
            <div class="pub-landing__showmap-list">
                <h3>@LandingText.For("Landing.Get.MapTitle", Variant)</h3>
                <p class="pub-landing__sm">@LandingText.For("Landing.Get.MapLead", Variant)</p>
                <div class="pub-landing__seg" aria-hidden="true">
                    <span class="is-on"><PubEmoji Glyph="🚲" /> @LandingText.For("Landing.Get.MapBike", Variant)</span>
                    <span><PubEmoji Glyph="🚌" /> @LandingText.For("Landing.Get.MapOv", Variant)</span>
                    <span><PubEmoji Glyph="🚗" /> @LandingText.For("Landing.Get.MapCar", Variant)</span>
                </div>
                <p class="pub-landing__xs">@LandingText.For("Landing.Get.MapWithin", Variant) <span class="pub-pill-sample">@Culture["Public.Sample"]</span></p>
                <div class="pub-landing__jobs">
                    <div class="pub-landing__job">
                        <PubEmoji Glyph="🏥" />
                        <div>
                            <h5>@LandingText.For("Landing.Get.MapJob1", Variant)</h5>
                            <small>@LandingText.For("Landing.Get.MapJob1Meta", Variant)</small>
                            <span class="pub-pill pub-pill--ok">@LandingText.For("Landing.Get.MapFit", Variant)</span>
                        </div>
                        <div class="pub-landing__tt"><b>12 min</b>@LandingText.For("Landing.Get.MapTravel", Variant)</div>
                    </div>
                    <div class="pub-landing__job">
                        <PubEmoji Glyph="🔧" />
                        <div>
                            <h5>@LandingText.For("Landing.Get.MapJob2", Variant)</h5>
                            <small>@LandingText.For("Landing.Get.MapJob2Meta", Variant)</small>
                            <span class="pub-pill pub-pill--ok">@LandingText.For("Landing.Get.MapFit", Variant)</span>
                        </div>
                        <div class="pub-landing__tt"><b>24 min</b>@LandingText.For("Landing.Get.MapTravel", Variant)</div>
                    </div>
                    <div class="pub-landing__job">
                        <PubEmoji Glyph="🌱" />
                        <div>
                            <h5>@LandingText.For("Landing.Get.MapJob3", Variant)</h5>
                            <small>@LandingText.For("Landing.Get.MapJob3Meta", Variant)</small>
                            <span class="pub-pill">@LandingText.For("Landing.Get.MapFitOk", Variant)</span>
                        </div>
                        <div class="pub-landing__tt"><b>9 min</b>@LandingText.For("Landing.Get.MapTravel", Variant)</div>
                    </div>
                </div>
            </div>
            <div class="pub-landing__showmap-vis" aria-hidden="true">
                <svg viewBox="0 0 320 280" class="pub-landing__rings">
                    <circle cx="160" cy="150" r="120" fill="none" stroke="var(--coral)" stroke-opacity=".35" stroke-dasharray="3 8"/>
                    <circle cx="160" cy="150" r="80" fill="none" stroke="var(--coral)" stroke-opacity=".45" stroke-dasharray="3 8"/>
                    <circle cx="160" cy="150" r="40" fill="none" stroke="var(--coral)" stroke-opacity=".6"/>
                    <circle cx="100" cy="100" r="6" fill="var(--map-pin)"/><circle cx="210" cy="90" r="6" fill="var(--map-pin)"/>
                    <circle cx="230" cy="170" r="6" fill="var(--map-pin)"/><circle cx="120" cy="200" r="6" fill="var(--map-pin)"/>
                </svg>
                <LobsyMascot Pose="MascotPose.Default" Size="MascotSize.Tiny" Alt="" Class="pub-landing__home-mark" />
                <span class="pub-pill">@LandingText.For("Landing.Get.MapRings", Variant)</span>
            </div>
        </div>

        <div class="pub-landing__four" id="ontdekkingsreis">
            <div class="pub-landing__fc">
                <div class="pub-landing__fc-top">
                    <PubEmoji Glyph="🪪" />
                    @if (LandingFeatureAvailability.ShowPassportSoon)
                    {
                        <span class="pub-pill pub-pill--soon">@Culture["Public.Soon"]</span>
                    }
                </div>
                <h4>@LandingText.For("Landing.Get.PassportTitle", Variant)</h4>
                <p>@LandingText.For("Landing.Get.PassportBody", Variant)</p>
                <div class="pub-landing__tabs" aria-hidden="true">
                    <span class="is-on">@LandingText.For("Landing.Get.Passport.TabDna", Variant)</span>
                    <span>@LandingText.For("Landing.Get.Passport.TabTests", Variant)</span>
                    <span>@LandingText.For("Landing.Get.Passport.TabFit", Variant)</span>
                    <span>@LandingText.For("Landing.Get.Passport.TabCareer", Variant)</span>
                    <span>@LandingText.For("Landing.Get.Passport.TabProofs", Variant)</span>
                </div>
                <div class="pub-landing__bar"><span>@LandingText.For("Landing.Get.Passport.BarSocial", Variant)</span><b style="--pct:82%"></b></div>
                <div class="pub-landing__bar pub-landing__bar--2"><span>@LandingText.For("Landing.Get.Passport.BarPractical", Variant)</span><b style="--pct:70%"></b></div>
                <div class="pub-landing__bar pub-landing__bar--3"><span>@LandingText.For("Landing.Get.Passport.BarCareful", Variant)</span><b style="--pct:58%"></b></div>
            </div>

            <div class="pub-landing__fc">
                <div class="pub-landing__fc-top">
                    <PubEmoji Glyph="🧭" />
                    @if (LandingFeatureAvailability.ShowDiscoverySoon)
                    {
                        <span class="pub-pill pub-pill--soon">@Culture["Public.Soon"]</span>
                    }
                </div>
                <h4>@LandingText.For("Landing.Get.JourneyTitle", Variant)</h4>
                <p>@LandingText.For("Landing.Get.JourneyBody", Variant)</p>
                <ol class="pub-landing__jr">
                    <li class="is-done">@LandingText.For("Landing.Get.Journey1", Variant)</li>
                    <li class="is-done">@LandingText.For("Landing.Get.Journey2", Variant)</li>
                    <li class="is-cur">@LandingText.For("Landing.Get.Journey3", Variant)</li>
                    <li>@LandingText.For("Landing.Get.Journey4", Variant)</li>
                </ol>
            </div>

            <div class="pub-landing__fc">
                <div class="pub-landing__fc-top"><PubEmoji Glyph="💘" /></div>
                <h4>@LandingText.For("Landing.Get.MatchTitle", Variant)</h4>
                <p>@LandingText.For("Landing.Get.MatchBody", Variant)</p>
                <div class="pub-landing__swipe">
                    <span class="pub-pill">@LandingText.For("Landing.Get.MatchBadge", Variant)</span>
                    <div class="pub-landing__pc">91%</div>
                    <b>@LandingText.For("Landing.Get.MatchRole", Variant)</b>
                    <small>@LandingText.For("Landing.Get.MatchMeta", Variant)</small>
                </div>
            </div>

            <div class="pub-landing__fc">
                <div class="pub-landing__fc-top"><PubEmoji Glyph="📘" /></div>
                <h4>@LandingText.For("Landing.Get.ReportTitle", Variant)</h4>
                <p>@LandingText.For("Landing.Get.ReportBody", Variant)</p>
                <div class="pub-landing__rep" aria-hidden="true">
                    <h6>@LandingText.For("Landing.Get.ReportName", Variant)</h6>
                    <div class="pub-landing__ln"></div>
                    <div class="pub-landing__ln pub-landing__ln--2"></div>
                    <div class="pub-landing__ln pub-landing__ln--3"></div>
                </div>
                @if (PriceEuro is decimal price)
                {
                    <div class="pub-landing__price">
                        @string.Format(LandingText.For("Landing.Get.ReportPrice", Variant), price.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("nl-NL")))
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public LandingVariant Variant { get; set; } = LandingVariant.On;
    [Parameter] public decimal? PriceEuro { get; set; }
}
