@namespace Jobsy.Web.Components.Landing
@using Jobsy.Web.Features
@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@inject CultureState Culture

<section class="pub-landing__section pub-landing__section--ef" id="voor-werkgevers">
    <div class="pub-landing__wrap pub-landing__ef-grid">
        <article class="pub-landing__emp-card pub-landing__lift pub-landing__card-calm">
            <div class="pub-landing__emp-head">
                <span class="pub-landing__eyebrow">@LandingText.For("Landing.Emp.Eyebrow", Variant)</span>
                <span class="pub-pill-sample">@Culture["Public.Sample"]</span>
            </div>
            <h2 class="pub-landing__h2 pub-landing__h2--sm">@LandingText.For("Landing.Emp.Title", Variant)</h2>
            <p class="pub-landing__lead pub-landing__lead--tight">@LandingText.For("Landing.Emp.Lead", Variant)</p>
            <ul class="pub-landing__emp-list">
                <li>@LandingText.For("Landing.Emp.L1", Variant)</li>
                <li>@LandingText.For("Landing.Emp.L2", Variant)</li>
                <li>@LandingText.For("Landing.Emp.L3", Variant)</li>
            </ul>
            <div class="pub-landing__emp-row">
                @if (!EmployersAvailable)
                {
                    <span class="pub-landing__emp-soon">@Culture["Public.Soon"]</span>
                }
                @if (EmployersAvailable)
                {
                    <a class="pub-btn pub-btn--primary" href="@PublicRoutes.Employers" data-kpi="LandingCtaAudience" data-kpi-target="werkgever">
                        @LandingText.For("Landing.Emp.Cta", Variant)
                    </a>
                }
                else
                {
                    <span class="pub-btn pub-btn--disabled" role="link" aria-disabled="true"
                          data-kpi="LandingCtaAudience" data-kpi-target="werkgever">
                        @LandingText.For("Landing.Emp.Cta", Variant)
                    </span>
                }
            </div>
            <p class="pub-landing__emp-register">
                <a href="@PublicRoutes.CompanyRegister">@LandingText.For("Landing.Emp.Register", Variant)</a>
            </p>
        </article>

        <article class="pub-landing__faq-card pub-landing__lift pub-landing__card-calm" id="faq">
            <div class="pub-landing__eyebrow">@LandingText.For("Landing.Faq.Eyebrow", Variant)</div>
            <h2 class="pub-landing__h2 pub-landing__h2--sm">@LandingText.For("Landing.Faq.TitleShort", Variant)</h2>
            @{
                var pairs = LandingFaq.BuildPairs(Variant, Culture.Language, PriceEuro);
                var first = true;
            }
            @foreach (var (q, a) in pairs)
            {
                <details class="pub-landing__fq pub-landing__fq--flat" open="@(first ? true : null)">
                    <summary>@q</summary>
                    <p>@a</p>
                </details>
                first = false;
            }
        </article>
    </div>
</section>

@code {
    [Parameter] public LandingVariant Variant { get; set; } = LandingVariant.On;
    [Parameter] public decimal? PriceEuro { get; set; }

    private bool EmployersAvailable =>
        PublicNavCatalog.Header(Variant).Any(i => i.Href == PublicRoutes.Employers && i.IsAvailable);
}
