@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.Navigation
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

<div class="jobsy-discovery show-map uwv-banenkaart-real" data-testid="uwv-banenkaart-mock">
    <div class="jobsy-chrome">
        <div class="kb-filter-bar uwv-banenkaart-real__bar" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <div class="kb-filter-bar__row kb-panel-head__search-row">
                <div class="kb-chrome-search kb-filter-search kb-filter-search--bar">
                    <span class="kb-filter-search__icon" aria-hidden="true">@((MarkupString)NavIcons.Search)</span>
                    <span class="uwv-banenkaart-real__keyword">@KeywordLabel</span>
                </div>
                <button type="button" class="kb-filters-button" aria-label="@Culture["Kb.Filter.FiltersAria"]">
                    <span class="kb-filters-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                    <span>@Culture["Discovery.Filters"]</span>
                </button>
            </div>
            <div class="kb-filter-bar__row kb-panel-head__address-row">
                <div class="kb-address kb-panel-head__address">
                    <label class="kb-address__label visually-hidden" for="uwv-mock-address">@Culture["Discovery.Address"]</label>
                    <div class="kb-address__field">
                        <input id="uwv-mock-address" type="text" readonly value="@AddressLabel" />
                        <button type="button" class="kb-address__geo btn btn-ghost btn-sm" disabled aria-hidden="true">
                            @LocateLabel
                        </button>
                    </div>
                </div>
            </div>
            <div class="kb-filter-bar__row kb-filter-bar__summary">
                <div class="kb-filter-bar__count-block">
                    <p class="kb-filter-bar__count">@CountLabel</p>
                    <p class="kb-filter-bar__count-sub muted">@UwvMockupCopy.Banenkaart.LayerHint(Lang)</p>
                </div>
                <label class="kb-chip kb-chip--toggle is-on uwv-banenkaart-real__layer">
                    <input type="checkbox" checked disabled />
                    <span>@UwvMockupCopy.Banenkaart.LayerLabel(Lang)</span>
                </label>
            </div>
        </div>
    </div>

    <aside class="vacancy-pane">
        <div class="kb-panel-head discovery-toolbar--desktop uwv-banenkaart-real__desktop-head" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <div class="kb-address kb-panel-head__address">
                <label class="kb-address__label" for="uwv-mock-address-desktop">@Culture["Discovery.Address"]</label>
                <div class="kb-address__field">
                    <input id="uwv-mock-address-desktop" type="text" readonly value="@AddressLabel" />
                    <button type="button" class="kb-address__geo btn btn-ghost btn-sm" disabled aria-hidden="true">@LocateLabel</button>
                </div>
            </div>
            <div class="kb-panel-head__search-row">
                <div class="kb-filter-search kb-panel-head__search">
                    <span class="kb-filter-search__icon" aria-hidden="true">@((MarkupString)NavIcons.Search)</span>
                    <span class="uwv-banenkaart-real__keyword">@KeywordLabel</span>
                </div>
                <button type="button" class="kb-filters-button kb-panel-head__filters">
                    <span class="kb-filters-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                    <span>@Culture["Discovery.Filters"]</span>
                </button>
                <label class="kb-chip kb-chip--toggle is-on uwv-banenkaart-real__layer uwv-banenkaart-real__layer--desktop">
                    <input type="checkbox" checked disabled />
                    <span>@UwvMockupCopy.Banenkaart.LayerLabel(Lang)</span>
                </label>
            </div>
        </div>

        <div class="results-meta">
            <div class="results-meta__text">
                <p class="results-meta__count">@CountLabel</p>
                <p class="results-meta__sub muted">@UwvMockupCopy.Banenkaart.LayerHint(Lang)</p>
            </div>
        </div>

        <div class="vacancy-list vacancy-list--cards uwv-banenkaart-real__list">
            @foreach (var vac in UwvMockupData.MapVacancies)
            {
                <article class="job-card uwv-banenkaart-real__card">
                    <div class="job-card__media" style="@($"background-image:url('{vac.ImageUrl}')")">
                        <div class="job-card__overlay">
                            <h2>@VacTitle(vac)</h2>
                            <p class="job-card__travel">@VacTravel(vac)</p>
                        </div>
                        @if (vac.Kansberoep)
                        {
                            <span class="job-card__badge uwv-banenkaart-real__kans-badge">@(UwvMockupCopy.IsEnglish(Lang) ? "Opportunity job" : "Kansberoep")</span>
                        }
                        @if (vac.Baangarantie)
                        {
                            <span class="job-card__badge job-card__badge--soft uwv-badge--guarantee">@(UwvMockupCopy.IsEnglish(Lang) ? "Job guarantee" : "Baangarantie")</span>
                        }
                    </div>
                    <div class="job-card__footer">
                        <p class="job-card__company">@VacCompany(vac)</p>
                        <p class="job-card__location muted">@VacLocation(vac)</p>
                    </div>
                </article>
            }
        </div>
    </aside>

    <section class="map-pane uwv-banenkaart-real__pane">
        <div class="map-stage is-live uwv-banenkaart-real__stage">
            <div class="job-map uwv-banenkaart-real__map" aria-hidden="true"></div>

            <div class="maplibregl-ctrl-top-right job-map-style-switch uwv-banenkaart-real__style-switch" aria-hidden="true">
                <button type="button" class="maplibregl-ctrl-icon job-map-style-switch__btn is-on">@(UwvMockupCopy.IsEnglish(Lang) ? "Light" : "Licht")</button>
            </div>
            <button type="button" class="btn btn-ghost btn-sm job-map-locate uwv-banenkaart-real__locate" disabled aria-hidden="true">@LocateLabel</button>

            <aside class="kb-travel-legend uwv-banenkaart-real__legend" data-iso-mode="approx" aria-label="@Culture["Kb.Legend.TravelTitle"]">
                <p class="kb-travel-legend__title">@(UwvMockupCopy.IsEnglish(Lang) ? "Travel time · bike (sample)" : "Reistijd · fiets (voorbeeld)")</p>
                <ul class="kb-travel-legend__rings">
                    <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--10"></span>10 min</li>
                    <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--20"></span>20 min</li>
                    <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--30"></span>30 min</li>
                </ul>
            </aside>

            @foreach (var pin in Pins)
            {
                <div class="job-marker uwv-banenkaart-real__marker" style="@($"left:{pin.Left}%;top:{pin.Top}%")">
                    <span class="job-marker__glyph" aria-hidden="true">@pin.Glyph</span>
                </div>
            }

            <div class="map-popup map-popup--illustrated uwv-banenkaart-real__popup">
                <div class="map-popup__main">
                    <span class="uwv-badge uwv-badge--guarantee">@(UwvMockupCopy.IsEnglish(Lang) ? "Job guarantee" : "Baangarantie")</span>
                    <h3 class="map-popup__title">@(UwvMockupCopy.IsEnglish(Lang) ? "Logistics associate (sample)" : "Logistiek medewerker (voorbeeld)")</h3>
                    <p class="map-popup__meta muted">@(UwvMockupCopy.IsEnglish(Lang) ? "15 min bike · recognised learning company" : "15 min fiets · erkend leerbedrijf")</p>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter] public string? Lang { get; set; }

    private string KeywordLabel => UwvMockupCopy.IsEnglish(Lang) ? "Logistics (sample)" : "Logistiek (voorbeeld)";
    private string AddressLabel => UwvMockupCopy.IsEnglish(Lang) ? "The Hague centre (sample)" : "Den Haag centrum (voorbeeld)";
    private string LocateLabel => UwvMockupCopy.IsEnglish(Lang) ? "My location" : "Mijn locatie";
    private string CountLabel => UwvMockupCopy.IsEnglish(Lang) ? "3 opportunity jobs nearby (sample)" : "3 kansberoepen bij jou in de buurt (voorbeeld)";

    private IEnumerable<(int Left, int Top, string Glyph)> Pins =>
    [
        (38, 48, "L"),
        (55, 62, "Z"),
        (72, 38, "T"),
    ];

    private string VacTitle(UwvMapVacancy v) => UwvMockupCopy.IsEnglish(Lang) ? v.TitleEn : v.TitleNl;
    private string VacTravel(UwvMapVacancy v) => UwvMockupCopy.IsEnglish(Lang) ? v.TravelEn : v.TravelNl;
    private string VacCompany(UwvMapVacancy v) => UwvMockupCopy.IsEnglish(Lang) ? v.CompanyEn : v.CompanyNl;
    private string VacLocation(UwvMapVacancy v) => UwvMockupCopy.IsEnglish(Lang) ? v.LocationEn : v.LocationNl;
}
