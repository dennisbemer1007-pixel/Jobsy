@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

@if (UwvMockupNav.Items.Count > 0)
{
    <nav class="bottom-nav" aria-label="@Culture["Nav.Main"]">
        @foreach (var item in UwvMockupNav.Items)
        {
            if (item.DesktopOnly)
            {
                continue;
            }

            var title = Culture[item.TitleKey];
            var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
                ? Culture[item.ShortTitleKey!]
                : title;
            var active = RoleNavCatalog.IsActive(item, ActiveHref, UwvMockupNav.Items);
            <a class="bottom-nav__item @(active ? "is-active" : null)"
               href="@UwvMockupNav.PreviewHref(item.Href, Lang)"
               title="@title"
               data-testid="@(string.Equals(item.Href, RoleNavCatalog.HoursItem.Href, StringComparison.OrdinalIgnoreCase) ? "nav-maqqie-uren" : null)"
               aria-current="@(active ? "page" : null)">
                <span class="bottom-nav__icon" aria-hidden="true">
                    @((MarkupString)item.Svg)
                </span>
                <span class="bottom-nav__label bottom-nav__label--full">@title</span>
                <span class="bottom-nav__label bottom-nav__label--short">@shortTitle</span>
            </a>
        }
    </nav>
}

@code {
    [Parameter] public string ActiveHref { get; set; } = "/carriere";
    [Parameter] public string Lang { get; set; } = "nl";
}
