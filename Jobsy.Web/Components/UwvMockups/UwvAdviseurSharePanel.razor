@using Jobsy.Web.Components
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

<section class="uwv-adviseur uwv-adviseur--full opl-wrap" aria-labelledby="@_titleId">
        <div class="uwv-adviseur__intro">
            <h1 id="@_titleId" class="uwv-block__title uwv-adviseur__h1">@UwvMockupCopy.Adviseur.Title(Lang)</h1>
            <p class="uwv-block__lead">@UwvMockupCopy.Adviseur.Lead(Lang)</p>
            <p class="uwv-adviseur__benefit muted">
                @(UwvMockupCopy.IsEnglish(Lang) ? "± 2 minutes · pick sections for your meeting" : "± 2 minuten · kies wat je meeneemt naar het gesprek")
            </p>
        </div>

        <fieldset class="uwv-adviseur__pick">
            <legend>@(UwvMockupCopy.IsEnglish(Lang) ? "Include in printout" : "Opnemen in printout")</legend>
            @foreach (var (nl, en) in UwvMockupData.AdviseurSections)
            {
                var label = UwvMockupCopy.IsEnglish(Lang) ? en : nl;
                var isPassport = label.Contains("competenc", StringComparison.OrdinalIgnoreCase)
                                 || label.Contains("competent", StringComparison.OrdinalIgnoreCase);
                var on = isPassport || label.Contains("Drijf") || label.Contains("Driver") || label.Contains("Carri") || label.Contains("Career");
                <label class="uwv-toggle">
                    <input type="checkbox" checked="@on" />
                    <span class="uwv-toggle__track" aria-hidden="true"></span>
                    <span class="uwv-toggle__label">@label</span>
                </label>
            }
        </fieldset>

        <div class="uwv-adviseur__preview-wrap">
            <p class="uwv-adviseur__preview-label">@UwvMockupCopy.Adviseur.PreviewTitle(Lang)</p>
            <article class="uwv-a4-preview" aria-label="@UwvMockupCopy.Adviseur.PreviewTitle(Lang)">
                <header class="uwv-a4-preview__head">
                    <LobsyLogo Class="uwv-a4-preview__logo" Alt="Lobsy" Variant="LobsyLogoVariant.Mark" />
                    <div class="uwv-a4-preview__head-copy">
                        <p class="uwv-a4-preview__eyebrow">@(UwvMockupCopy.IsEnglish(Lang) ? "Summary for your adviser" : "Samenvatting voor je adviseur")</p>
                        <h2>@(UwvMockupCopy.IsEnglish(Lang) ? "Sam (sample)" : "Sam (voorbeeld)")</h2>
                    </div>
                </header>
                <div class="uwv-a4-preview__body">
                    <h3>@UwvMockupCopy.Drijfveren.ResultsTitle(Lang)</h3>
                    <p>@(UwvMockupCopy.IsEnglish(Lang) ? UwvMockupData.Drivers[0].ExplainEn : UwvMockupData.Drivers[0].ExplainNl)</p>
                    <h3>@(UwvMockupCopy.IsEnglish(Lang) ? "Competencies" : "Competenties")</h3>
                    <ul class="uwv-a4-preview__skills">
                        <li>
                            <span class="uwv-verified" aria-hidden="true">✓</span>
                            @(UwvMockupCopy.IsEnglish(Lang) ? "Planning and organising" : "Plannen en organiseren")
                        </li>
                        <li>
                            <span class="uwv-verified" aria-hidden="true">✓</span>
                            @(UwvMockupCopy.IsEnglish(Lang) ? "Customer-oriented communication" : "Klantgericht communiceren")
                        </li>
                    </ul>
                    <p class="uwv-a4-preview__note muted">@UwvMockupCopy.Adviseur.VerifiedNote(Lang)</p>
                </div>
            </article>
        </div>

        <div class="uwv-adviseur__actions">
            <button type="button" class="btn btn-primary">@UwvMockupCopy.Adviseur.Print(Lang)</button>
            <button type="button" class="btn btn-ghost">@UwvMockupCopy.Adviseur.ShareLink(Lang)</button>
        </div>
</section>

@code {
    private string Lang => Culture.Language;
    private readonly string _titleId = "uwv-adviseur-" + Guid.NewGuid().ToString("N")[..8];
}
