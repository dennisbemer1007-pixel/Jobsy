@using Jobsy.Web.Components.UwvFeatures
@using Jobsy.Web.Localization
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

<section class="detail-card uwv-block uwv-partners" data-testid="uwv-workshops-partners" aria-labelledby="@_titleId">
    <h2 id="@_titleId" class="uwv-block__title">@UwvMockupCopy.Workshops.PartnersTitle(Lang)</h2>
    <ul class="uwv-partners__cards">
        @foreach (var link in UwvMockupData.UwvPartners)
        {
            <li>
                <a class="uwv-partner-card" href="@link.Url" rel="noopener noreferrer" target="_blank">
                    <UwvSectorIcon Kind="@link.IconKind" CssClass="uwv-partner-card__icon" />
                    <span class="uwv-partner-card__body">
                        <span class="uwv-partner-card__title">@(UwvMockupCopy.IsEnglish(Lang) ? link.TitleEn : link.TitleNl)</span>
                        <span class="uwv-partner-card__desc">@(UwvMockupCopy.IsEnglish(Lang) ? link.DescEn : link.DescNl)</span>
                        <span class="uwv-partner-card__meta">@(UwvMockupCopy.IsEnglish(Lang) ? "Free · online" : "Gratis · online")</span>
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

@code {
    private string Lang => Culture.Language;
    private readonly string _titleId = "uwv-partners-" + Guid.NewGuid().ToString("N")[..8];
}
