@using Jobsy.Web.Components.UwvFeatures
@using Jobsy.Web.Localization
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

<section class="detail-card career-card uwv-block uwv-omscholen" aria-labelledby="@_titleId">
    <p class="uwv-block__eyebrow">
        <i class="uwv-block__dot" aria-hidden="true"></i>
        @UwvMockupCopy.Omscholen.Title(Lang)
    </p>
    <h2 id="@_titleId" class="uwv-block__title">@UwvMockupCopy.Omscholen.Title(Lang)</h2>
    <p class="uwv-block__lead">@UwvMockupCopy.Omscholen.Lead(Lang)</p>

    <div class="uwv-omscholen__sectors">
        @foreach (var (sector, icon) in UwvMockupData.OmscholenSectors)
        {
            <article class="uwv-omscholen__sector uwv-omscholen__sector--rich">
                <UwvSectorIcon Kind="@icon" CssClass="uwv-omscholen__sector-icon" />
                <div class="uwv-omscholen__sector-body">
                    <h3>@(UwvMockupCopy.IsEnglish(Lang) ? sector.NameEn : sector.NameNl)</h3>
                    <p>@(UwvMockupCopy.IsEnglish(Lang) ? sector.DetailEn : sector.DetailNl)</p>
                    @if (sector.HasBaangarantie)
                    {
                        <span class="uwv-badge uwv-badge--guarantee">@(UwvMockupCopy.IsEnglish(Lang) ? "Job guarantee" : "Baangarantie")</span>
                    }
                    <a class="uwv-inline-link" href="/banenkaart">@UwvMockupCopy.Omscholen.MapLink(Lang)</a>
                </div>
            </article>
        }
    </div>

    <div class="uwv-omscholen__leerbanen">
        <h3 class="uwv-omscholen__sub">@(UwvMockupCopy.IsEnglish(Lang) ? "Apprenticeships (BBL)" : "Leerbanen (BBL)")</h3>
        <ul class="uwv-leerbaan-cards">
            @foreach (var lb in UwvMockupData.Leerbanen)
            {
                <li class="uwv-leerbaan-card">
                    <div class="uwv-leerbaan-card__head">
                        <strong>@(UwvMockupCopy.IsEnglish(Lang) ? lb.TitleEn : lb.TitleNl)</strong>
                        <span class="uwv-badge uwv-badge--guarantee">@(UwvMockupCopy.IsEnglish(Lang) ? "Job guarantee" : "Baangarantie")</span>
                    </div>
                    <p class="muted">@(UwvMockupCopy.IsEnglish(Lang) ? lb.CompanyEn : lb.CompanyNl)</p>
                    <a class="uwv-inline-link" href="/banenkaart">@UwvMockupCopy.Omscholen.MapLink(Lang)</a>
                </li>
            }
        </ul>
    </div>

    <aside class="uwv-omscholen__aside">
        <p>
            @UwvMockupCopy.Omscholen.Werkcentrum(Lang)
            <a href="https://www.werkcentrum.nl/" rel="noopener noreferrer">@UwvMockupCopy.Omscholen.WerkcentrumLink(Lang)</a>
        </p>
        <p class="uwv-omscholen__ww">
            @UwvMockupCopy.Omscholen.WwNote(Lang)
            <a href="https://www.uwv.nl/" rel="noopener noreferrer">@UwvMockupCopy.Omscholen.WwLink(Lang)</a>
        </p>
    </aside>
</section>

@code {
    private string Lang => Culture.Language;
    private readonly string _titleId = "uwv-omscholen-" + Guid.NewGuid().ToString("N")[..8];
}
