@using Jobsy.Web.UwvMockups

<section class="detail-card uwv-block uwv-kans" aria-labelledby="@_titleId">
    <p class="uwv-block__eyebrow">
        <i class="uwv-block__dot" aria-hidden="true"></i>
        @UwvMockupCopy.Kansberoepen.Title(Lang)
    </p>
    <h2 id="@_titleId" class="uwv-block__title">@UwvMockupCopy.Kansberoepen.Title(Lang)</h2>
    <p class="uwv-block__lead">@UwvMockupCopy.Kansberoepen.Lead(Lang)</p>
    <p class="uwv-block__meta">
        <span class="uwv-kans__region">@UwvMockupCopy.Kansberoepen.Region(Lang)</span>
        <span class="uwv-block__source">@UwvMockupCopy.Kansberoepen.Source(Lang)</span>
    </p>

    <ul class="uwv-kans__list">
        @foreach (var job in UwvMockupData.Kansberoepen)
        {
            <li class="uwv-kans__item">
                <div class="uwv-kans__head">
                    <h3>@(UwvMockupCopy.IsEnglish(Lang) ? job.TitleEn : job.TitleNl)</h3>
                    <span class="uwv-kans__prospect">@(UwvMockupCopy.IsEnglish(Lang) ? job.ProspectEn : job.ProspectNl)</span>
                </div>
                <p class="uwv-kans__route">
                    <span class="uwv-kans__route-label">@(UwvMockupCopy.IsEnglish(Lang) ? "Training route" : "Opleidingsroute")</span>
                    @(UwvMockupCopy.IsEnglish(Lang) ? job.RouteEn : job.RouteNl)
                </p>
            </li>
        }
    </ul>
</section>

@code {
    [Parameter] public string? Lang { get; set; }
    private readonly string _titleId = "uwv-kans-title-" + Guid.NewGuid().ToString("N")[..8];
}
