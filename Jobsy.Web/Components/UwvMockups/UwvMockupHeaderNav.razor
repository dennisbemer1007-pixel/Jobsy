@using Jobsy.Web.Localization
@using Jobsy.Web.Navigation
@using Jobsy.Web.UwvMockups
@inject CultureState Culture

<nav class="app-header__nav candidate-header-nav" aria-label="@Culture["Nav.Main"]" data-testid="candidate-header-nav">
    @foreach (var item in Items)
    {
        var title = Culture[item.TitleKey];
        var shortTitle = !string.IsNullOrWhiteSpace(item.ShortTitleKey)
            ? Culture[item.ShortTitleKey!]
            : title;
        var active = string.Equals(item.Href, ActiveHref, StringComparison.OrdinalIgnoreCase);
        <a class="candidate-header-nav__link @(active ? "is-active" : null)"
           href="@PreviewHref(item.Href)"
           title="@title"
           aria-current="@(active ? "page" : null)">
            @shortTitle
        </a>
    }
</nav>

@code {
    [Parameter] public string ActiveHref { get; set; } = "/carriere";
    [Parameter] public string Lang { get; set; } = "nl";

    private IReadOnlyList<NavItem> Items { get; } = RoleNavCatalog.CandidateItems(FeatureFlagSnapshot.Defaults);

    private string PreviewHref(string href)
    {
        var screen = href switch
        {
            var h when string.Equals(h, PublicRoutes.Banenkaart, StringComparison.OrdinalIgnoreCase) => "banenkaart",
            var h when string.Equals(h, "/carriere/leren", StringComparison.OrdinalIgnoreCase) => "workshops",
            var h when string.Equals(h, "/ontdek", StringComparison.OrdinalIgnoreCase) => "drijfveren",
            var h when h.StartsWith("/profiel", StringComparison.OrdinalIgnoreCase) => "adviseur",
            _ => "carriere"
        };
        return $"/preview/uwv-mockups/{screen}?lang={Uri.EscapeDataString(Lang)}";
    }
}
