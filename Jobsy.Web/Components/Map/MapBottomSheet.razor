@* Funda-style mobile bottom sheet: collapsed / card / half (/ full).
   Drag runs on the JS thread (translate3d) for 60 fps; Blazor owns snap state. *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="map-sheet @CssClass"
     id="@Id"
     role="dialog"
     aria-label="@AriaLabel"
     aria-modal="false"
     data-snap="@SnapName">
    <div class="map-sheet__scrim" @onclick="OnScrimClick" hidden="@(!ShowScrim)"></div>
    <div class="map-sheet__panel" @ref="_panel">
        <div class="map-sheet__handle" aria-hidden="true">
            <span class="map-sheet__grab"></span>
        </div>
        <div class="map-sheet__body">
            @ChildContent
        </div>
    </div>
</div>

@code {
    public enum Snap
    {
        Collapsed = 0,
        Card = 1,
        Half = 2,
        Full = 3
    }

    [Parameter] public string Id { get; set; } = "map-sheet";
    [Parameter] public string AriaLabel { get; set; } = "Vacaturelijst";
    [Parameter] public Snap Current { get; set; } = Snap.Collapsed;
    [Parameter] public EventCallback<Snap> CurrentChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowScrim { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<double> HeightChanged { get; set; }

    private ElementReference _panel;
    private bool _historyPushed;
    private DotNetObjectReference<MapBottomSheet>? _self;
    private bool _jsReady;
    private Snap? _appliedSnap;

    private string SnapName => Current.ToString().ToLowerInvariant();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("mapBottomSheet.bind", Id, _self);
                _jsReady = true;
            }
            catch (JSException)
            {
                // mapBottomSheet.js not loaded yet
            }

            await ApplySnapAsync(animate: false);
        }
        else if (_appliedSnap != Current)
        {
            await ApplySnapAsync(animate: true);
        }
    }

    private async Task ApplySnapAsync(bool animate)
    {
        _appliedSnap = Current;
        var snap = SnapName;
        double height = Current switch
        {
            Snap.Card => 160,
            Snap.Half => 400,
            Snap.Full => 700,
            _ => 64
        };
        if (_jsReady)
        {
            try
            {
                height = await Js.InvokeAsync<double>("mapBottomSheet.setSnap", Id, snap, animate);
            }
            catch
            {
                // ignore
            }
        }

        await HeightChanged.InvokeAsync(height);
        await SyncHistoryAsync();
    }

    private async Task SyncHistoryAsync()
    {
        if (!_jsReady)
        {
            return;
        }

        if (Current == Snap.Collapsed)
        {
            if (_historyPushed)
            {
                try { await Js.InvokeVoidAsync("mapBottomSheet.clearHistory", Id); } catch { }
                _historyPushed = false;
            }
            return;
        }

        if (!_historyPushed)
        {
            try
            {
                await Js.InvokeVoidAsync("mapBottomSheet.pushHistory", Id);
                _historyPushed = true;
            }
            catch { }
        }
    }

    private async Task OnScrimClick()
    {
        Current = Snap.Collapsed;
        await CurrentChanged.InvokeAsync(Current);
        await ApplySnapAsync(animate: true);
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnBrowserBack()
    {
        _historyPushed = false;
        if (Current == Snap.Collapsed)
        {
            return;
        }

        Current = Snap.Collapsed;
        await CurrentChanged.InvokeAsync(Current);
        await ApplySnapAsync(animate: true);
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnViewportResize(double height)
    {
        await ApplySnapAsync(animate: false);
    }

    [JSInvokable]
    public async Task OnJsSnapChanged(string snap)
    {
        var next = snap?.ToLowerInvariant() switch
        {
            "card" => Snap.Card,
            "half" => Snap.Half,
            "full" => Snap.Full,
            _ => Snap.Collapsed
        };
        if (next == Current)
        {
            _appliedSnap = next;
            return;
        }

        Current = next;
        _appliedSnap = next;
        await CurrentChanged.InvokeAsync(next);
        if (next == Snap.Collapsed)
        {
            await OnClose.InvokeAsync();
        }
        else
        {
            await SyncHistoryAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsReady)
        {
            try { await Js.InvokeVoidAsync("mapBottomSheet.unbind", Id); } catch { }
        }

        _self?.Dispose();
    }
}
