@* Funda-style mobile bottom sheet: collapsed / card / half (/ full). *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="map-sheet @CssClass"
     id="@Id"
     role="dialog"
     aria-label="@AriaLabel"
     aria-modal="false"
     data-snap="@SnapName"
     style="--map-sheet-y: @(_translateY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px;">
    <div class="map-sheet__scrim" @onclick="OnScrimClick" hidden="@(!ShowScrim)"></div>
    <div class="map-sheet__panel"
         @ref="_panel"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointercancel="OnPointerUp">
        <div class="map-sheet__handle" aria-hidden="true">
            <span class="map-sheet__grab"></span>
        </div>
        <div class="map-sheet__body">
            @ChildContent
        </div>
    </div>
</div>

@code {
    public enum Snap
    {
        Collapsed = 0,
        Card = 1,
        Half = 2,
        Full = 3
    }

    [Parameter] public string Id { get; set; } = "map-sheet";
    [Parameter] public string AriaLabel { get; set; } = "Vacaturelijst";
    [Parameter] public Snap Current { get; set; } = Snap.Collapsed;
    [Parameter] public EventCallback<Snap> CurrentChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowScrim { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<double> HeightChanged { get; set; }

    private ElementReference _panel;
    private double _translateY;
    private double _viewportH;
    private bool _dragging;
    private double _dragStartY;
    private double _dragStartTranslate;
    private bool _historyPushed;
    private DotNetObjectReference<MapBottomSheet>? _self;
    private bool _jsReady;
    private Snap? _appliedSnap;

    private string SnapName => Current.ToString().ToLowerInvariant();

    private double CollapsedH => 64;
    private double CardH => 160;
    private double HalfH => Math.Max(CardH, _viewportH * 0.5);
    private double FullH => Math.Max(HalfH, _viewportH * 0.92);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("mapBottomSheet.bind", Id, _self);
                _jsReady = true;
            }
            catch (JSException)
            {
                // mapBottomSheet.js not loaded yet — layout still works via CSS.
            }
            await MeasureAsync();
            await ApplySnapAsync(animate: false);
        }
        else if (_appliedSnap != Current)
        {
            await ApplySnapAsync(animate: true);
        }
    }

    private async Task MeasureAsync()
    {
        try
        {
            _viewportH = await Js.InvokeAsync<double>("mapBottomSheet.viewportHeight");
        }
        catch
        {
            _viewportH = 844;
        }
    }

    private double HeightFor(Snap snap) => snap switch
    {
        Snap.Card => CardH,
        Snap.Half => HalfH,
        Snap.Full => FullH,
        _ => CollapsedH
    };

    private async Task ApplySnapAsync(bool animate)
    {
        var h = HeightFor(Current);
        _translateY = Math.Max(0, _viewportH - h);
        _appliedSnap = Current;
        await HeightChanged.InvokeAsync(h);
        if (_jsReady)
        {
            try
            {
                await Js.InvokeVoidAsync("mapBottomSheet.setTranslate", Id, _translateY, animate && !PrefersReducedMotion());
            }
            catch
            {
                // ignore
            }
        }

        await SyncHistoryAsync();
    }

    private bool PrefersReducedMotion()
        => false; // JS path respects prefers-reduced-motion; Blazor fallback skips spring.

    private async Task SyncHistoryAsync()
    {
        if (Current == Snap.Collapsed)
        {
            if (_historyPushed && _jsReady)
            {
                try { await Js.InvokeVoidAsync("mapBottomSheet.clearHistory", Id); } catch { }
                _historyPushed = false;
            }
            return;
        }

        if (!_historyPushed && _jsReady)
        {
            try
            {
                await Js.InvokeVoidAsync("mapBottomSheet.pushHistory", Id);
                _historyPushed = true;
            }
            catch { }
        }
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        if (e.PointerType == "mouse" && e.Button != 0)
        {
            return;
        }

        _dragging = true;
        _dragStartY = e.ClientY;
        _dragStartTranslate = _translateY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_dragging)
        {
            return;
        }

        var dy = e.ClientY - _dragStartY;
        var next = Math.Clamp(_dragStartTranslate + dy, _viewportH - FullH, _viewportH - CollapsedH);
        _translateY = next;
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (!_dragging)
        {
            return;
        }

        _dragging = false;
        var h = _viewportH - _translateY;
        var target = NearestSnap(h);
        if (target != Current)
        {
            Current = target;
            await CurrentChanged.InvokeAsync(target);
        }

        await ApplySnapAsync(animate: true);
        if (target == Snap.Collapsed)
        {
            await OnClose.InvokeAsync();
        }
    }

    private Snap NearestSnap(double height)
    {
        var candidates = new[]
        {
            (Snap.Collapsed, CollapsedH),
            (Snap.Card, CardH),
            (Snap.Half, HalfH),
            (Snap.Full, FullH)
        };
        return candidates.OrderBy(c => Math.Abs(c.Item2 - height)).First().Item1;
    }

    private async Task OnScrimClick()
    {
        Current = Snap.Collapsed;
        await CurrentChanged.InvokeAsync(Current);
        await ApplySnapAsync(animate: true);
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnBrowserBack()
    {
        _historyPushed = false;
        if (Current == Snap.Collapsed)
        {
            return;
        }

        Current = Snap.Collapsed;
        await CurrentChanged.InvokeAsync(Current);
        await ApplySnapAsync(animate: true);
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnViewportResize(double height)
    {
        _viewportH = height;
        await ApplySnapAsync(animate: false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsReady)
        {
            try { await Js.InvokeVoidAsync("mapBottomSheet.unbind", Id); } catch { }
        }

        _self?.Dispose();
    }
}
