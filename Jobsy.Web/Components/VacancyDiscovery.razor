    private async Task EnsureDiscoveryHoverAsync()
    {
        for (var attempt = 0; attempt < 25 && !_disposed; attempt++)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyDiscovery.bindHover");
                try
                {
                    await Js.InvokeVoidAsync("jobsyDiscovery.bindFilterChipFade");
                }
                catch (JSException)
                {
                    // Older cached discoveryHover.js without bindFilterChipFade — hover still works.
                }
                return;
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (ObjectDisposedException)
            {
                return;
            }
            catch (JSException)
            {
                await Task.Delay(40);
            }
            catch (InvalidOperationException)
            {
                await Task.Delay(40);
            }
        }
    }

    private string FormatCardTravel(VacancyListItem vacancy)
