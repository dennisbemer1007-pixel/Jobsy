@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject ILogger<VacancyDiscovery> Logger
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject Jobsy.Web.RegionHosting.RegionHostState RegionHost
@implements IAsyncDisposable
@using Jobsy.Core.Contracts
@using Jobsy.Core.Media
@using Jobsy.Core.Rules
@using Jobsy.Web.Hosting
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json

<PageSeo JsonLd="@JobListJsonLd" />
<div class="jobsy-discovery @(showMapOnMobile ? "show-map" : "show-list") @(_filtersOpen ? "filters-open" : null)">
    <div class="jobsy-chrome">
        <header class="jobsy-chrome__header">
            <a class="jobsy-logo" href="/" aria-label="Lobsy">
                <LobsyLogo Class="jobsy-logo__img" Alt="Lobsy" />
                <span class="jobsy-logo__mark">Lobsy</span>
            </a>
            <h1 class="visually-hidden">@Culture["Seo.HomeHeading"]</h1>
            <div class="jobsy-chrome__header-actions">
                <LanguageSelector />
                <AuthHeader />
            </div>
        </header>

        <div class="jobsy-chrome__search">
            <label class="visually-hidden" for="discovery-address">@Culture["Discovery.Address"]</label>
            <div class="jobsy-search @(_origin is not null ? "jobsy-search--with-clear" : null)">
                <input id="discovery-address"
                       type="text"
                       autocomplete="off"
                       placeholder="@Culture["Discovery.AddressPlaceholder"]"
                       value="@_addressQuery"
                       @oninput="OnAddressInputAsync"
                       @onfocus="OnAddressFocus"
                       @onkeydown="OnAddressKeyDown" />
                @if (_origin is not null)
                {
                    <button type="button"
                            class="jobsy-search__clear"
                            title="@Culture["Common.Clear"]"
                            @onclick="ClearOriginAsync"
                            aria-label="@Culture["Common.Clear"]">
                        @Culture["Common.Clear"]
                    </button>
                }
                <button type="button"
                        class="jobsy-search__btn"
                        title="@Culture["Discovery.UseMyLocation"]"
                        disabled="@_locating"
                        @onclick="RequestLocationAsync"
                        aria-label="@Culture["Discovery.UseMyLocation"]">
                    <span class="jobsy-search__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="3"/>
                            <circle cx="12" cy="12" r="7"/>
                            <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21"/>
                        </svg>
                    </span>
                </button>
            </div>
            @if (_showSuggestions)
            {
                <ul class="address-suggestions" role="listbox">
                    @if (_suggesting)
                    {
                        <li class="address-suggestions__status">@Culture["Common.Loading"]</li>
                    }
                    else if (_suggestions.Count == 0 && _addressQuery.Trim().Length >= 3)
                    {
                        <li class="address-suggestions__status">@Culture["Discovery.AddressNoResults"]</li>
                    }
                    else
                    {
                        @foreach (var suggestion in _suggestions)
                        {
                            <li>
                                <button type="button"
                                        class="address-suggestions__item"
                                        @onclick="() => SelectSuggestionAsync(suggestion)">
                                    @suggestion.Label
                                </button>
                            </li>
                        }
                    }
                </ul>
            }
            @if (!string.IsNullOrEmpty(_locationError))
            {
                <p class="state-message error filter-bar__error">@_locationError</p>
            }
        </div>

        <div class="jobsy-chrome__actions @(ActiveFilterCount > 0 ? "jobsy-chrome__actions--with-clear" : null)" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <button type="button"
                    class="jobsy-action @(_filtersOpen ? "is-active" : null)"
                    @onclick="ToggleFilters"
                    aria-expanded="@(_filtersOpen ? "true" : "false")"
                    aria-controls="@(_filtersOpen ? "discovery-filters" : null)">
                <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                <span>@Culture["Discovery.Filters"]</span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="jobsy-action__badge">@ActiveFilterCount</span>
                }
            </button>
            @if (ActiveFilterCount > 0)
            {
                <button type="button"
                        class="jobsy-action jobsy-action--clear"
                        title="@Culture["Discovery.ClearFilters"]"
                        @onclick="ClearAllFiltersAsync"
                        aria-label="@Culture["Discovery.ClearFilters"]">
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                </button>
            }
            <AuthorizeView>
                <Authorized>
                    <a class="jobsy-action jobsy-action--save" href="/candidate/liked">
                        <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Liked)</span>
                        <span>@Culture["Discovery.SaveSearch"]</span>
                    </a>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="jobsy-action jobsy-action--toggle" @onclick="ToggleMobileView">
                @if (showMapOnMobile)
                {
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                    <span>@Culture["Discovery.List"]</span>
                }
                else
                {
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Map)</span>
                    <span>@Culture["Discovery.Map"]</span>
                }
            </button>
        </div>
    </div>

    <aside class="vacancy-pane">
        <div class="discovery-toolbar discovery-toolbar--desktop" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <div class="filter-bar__address discovery-toolbar__address">
                <label for="discovery-address-desktop">@Culture["Discovery.Address"]</label>
                <div class="address-field">
                    <input id="discovery-address-desktop"
                           type="text"
                           autocomplete="off"
                           placeholder="@Culture["Discovery.AddressPlaceholder"]"
                           value="@_addressQuery"
                           @oninput="OnAddressInputAsync"
                           @onfocus="OnAddressFocus"
                           @onkeydown="OnAddressKeyDown" />
                    <button type="button"
                            class="engagement-btn address-field__geo"
                            title="@Culture["Discovery.UseMyLocation"]"
                            disabled="@_locating"
                            @onclick="RequestLocationAsync"
                            aria-label="@Culture["Discovery.UseMyLocation"]"
                            aria-busy="@(_locating ? "true" : "false")">
                        <span class="address-field__geo-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <circle cx="12" cy="12" r="3"/>
                                <circle cx="12" cy="12" r="7"/>
                                <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21"/>
                            </svg>
                        </span>
                    </button>
                    @if (_origin is not null)
                    {
                        <button type="button"
                                class="engagement-btn address-field__clear"
                                @onclick="ClearOriginAsync">
                            @Culture["Common.Clear"]
                        </button>
                    }
                </div>
                @if (_showSuggestions)
                {
                    <ul class="address-suggestions" role="listbox">
                        @if (_suggesting)
                        {
                            <li class="address-suggestions__status">@Culture["Common.Loading"]</li>
                        }
                        else if (_suggestions.Count == 0 && _addressQuery.Trim().Length >= 3)
                        {
                            <li class="address-suggestions__status">@Culture["Discovery.AddressNoResults"]</li>
                        }
                        else
                        {
                            @foreach (var suggestion in _suggestions)
                            {
                                <li>
                                    <button type="button"
                                            class="address-suggestions__item"
                                            @onclick="() => SelectSuggestionAsync(suggestion)">
                                        @suggestion.Label
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(_locationError))
                {
                    <p class="state-message error filter-bar__error">@_locationError</p>
                }
            </div>
            <div class="discovery-filter-group">
                <button type="button"
                        class="discovery-filter-toggle @(_filtersOpen ? "is-active" : null)"
                        @onclick="ToggleFilters"
                        aria-expanded="@(_filtersOpen ? "true" : "false")"
                        aria-controls="discovery-filters-desktop">
                    <span class="discovery-filter-toggle__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                    <span>@Culture["Discovery.Filters"]</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="jobsy-action__badge">@ActiveFilterCount</span>
                    }
                </button>
                @if (ActiveFilterCount > 0)
                {
                    <button type="button"
                            class="discovery-filter-clear"
                            title="@Culture["Discovery.ClearFilters"]"
                            @onclick="ClearAllFiltersAsync"
                            aria-label="@Culture["Discovery.ClearFilters"]">
                        <span class="discovery-filter-toggle__icon" aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                    </button>
                }
            </div>
        </div>

        <div id="discovery-filters-desktop"
             class="filter-bar filter-bar--desktop"
             hidden="@(!_filtersOpen)"
             aria-hidden="@(!_filtersOpen ? "true" : "false")">
                <label class="filter-bar__query">
                    @Culture["Discovery.Keyword"]
                    <input type="search"
                           autocomplete="off"
                           placeholder="@Culture["Discovery.KeywordPlaceholder"]"
                           value="@(_searchDraft ?? _searchQuery ?? "")"
                           @oninput="OnSearchInput"
                           @onkeydown="OnSearchKeyDown" />
                </label>
                <div class="branch-multiselect-field">
                    <span class="branch-multiselect-field__label">@Culture["Discovery.WorkType"]</span>
                    <div class="branch-multiselect @(_branchMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_branchMenuOpen ? "true" : "false")"
                                aria-controls="@(_branchMenuOpen ? "branch-multiselect-panel-desktop" : null)"
                                @onclick="ToggleBranchMenu">
                            <span class="branch-multiselect__value @(_selectedWorkTypes.Count > 0 ? "is-selected" : null)">@BranchFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_branchMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseBranchMenu"></button>
                            <div id="branch-multiselect-panel-desktop"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.WorkType"]">
                                @foreach (var label in _branchOptions)
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedWorkTypes.Contains(label)"
                                               @onchange="e => ToggleWorkTypeAsync(label, e)" />
                                        @UiLabels.WorkType(Culture, label)
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="branch-multiselect-field">
                    <span class="branch-multiselect-field__label">@Culture["Discovery.VacancyType"]</span>
                    <div class="branch-multiselect @(_categoryMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_categoryMenuOpen ? "true" : "false")"
                                aria-controls="@(_categoryMenuOpen ? "category-multiselect-panel-desktop" : null)"
                                @onclick="ToggleCategoryMenu">
                            <span class="branch-multiselect__value @(_selectedCategoryIds.Count > 0 ? "is-selected" : null)">@CategoryFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_categoryMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseCategoryMenu"></button>
                            <div id="category-multiselect-panel-desktop"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.VacancyType"]">
                                @foreach (var cat in _categories.Where(c => c.ShowInMapFilter && c.IsActive))
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedCategoryIds.Contains(cat.Id)"
                                               @onchange="e => ToggleCategoryAsync(cat.Id, e)" />
                                        <span class="category-filter__swatch" style="--category-color:@cat.ColorHex" aria-hidden="true"></span>
                                        <span>@cat.Name</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
                <label class="filter-required">
                    @Culture["Discovery.Age"]
                    <select value="@AgeSelectValue" @onchange="OnAgeChanged" required>
                        <option value="all">@Culture["Discovery.AgeAny"]</option>
                        @for (var age = 15; age <= 21; age++)
                        {
                            <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                        }
                    </select>
                </label>
                @if (_ageYears is not null)
                {
                    <label>
                        @Culture["Discovery.MinWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMinWageChanged" />
                    </label>
                    <label>
                        @Culture["Discovery.MaxWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMaxWageChanged" />
                    </label>
                }
                <label>
                    @Culture["Discovery.TravelMinutes"]
                    <input type="number" min="5" max="90" value="@_maxTravelMinutes"
                           @onchange="OnMaxMinutesChanged" />
                </label>
                <label class="hours-range-field">
                    <span>@Culture["Discovery.HoursSlider"]</span>
                    <HoursRangeSlider CssClass="hours-range--compact"
                                      Min="0"
                                      Max="40"
                                      Low="_minHoursPerWeek"
                                      High="_maxHoursPerWeek"
                                      LowChanged="OnMinHoursSliderValue"
                                      HighChanged="OnMaxHoursSliderValue"
                                      RangeCommitted="CommitHoursRangeAsync" />
                </label>
                <label>
                    @Culture["Discovery.Transport"]
                    <select value="@_selectedTransport" @onchange="OnTransportChanged">
                        <option value="Fiets">@Culture["Transport.Bike"]</option>
                        <option value="Auto">@Culture["Transport.Car"]</option>
                        <option value="OV">@Culture["Transport.Transit"]</option>
                        <option value="Lopend">@Culture["Transport.Walk"]</option>
                    </select>
                </label>
                <label>
                    @Culture["Discovery.Radius"]
                    <input type="number" min="1" max="50" value="@_radiusKm"
                           @onchange="OnRadiusChanged" />
                </label>
                <div class="filter-bar__actions">
                    @if (_canShowMyVacancies)
                    {
                        <button type="button"
                                class="filter-bar__focus @(_myVacanciesOnly ? "is-active" : null)"
                                disabled="@_myVacanciesLoading"
                                @onclick="ToggleMyVacanciesAsync"
                                aria-pressed="@(_myVacanciesOnly ? "true" : "false")">
                            @MyVacanciesToggleLabel
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_myVacanciesError))
                    {
                        <p class="state-message error filter-bar__error">@_myVacanciesError</p>
                    }
                    @if (ActiveFilterCount > 0)
                    {
                        <button type="button"
                                class="filter-bar__clear"
                                title="@Culture["Discovery.ClearFilters"]"
                                @onclick="ClearAllFiltersAsync"
                                aria-label="@Culture["Discovery.ClearFilters"]">
                            <span class="filter-bar__clear-icon" aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                            <span>@Culture["Discovery.ClearFilters"]</span>
                        </button>
                    }
                    <button type="button" class="filter-bar__search" @onclick="ApplySearch">
                        @Culture["Discovery.Search"]
                    </button>
                </div>
            </div>

        @if (_loading && _vacancies.Count == 0)
        {
            <p class="state-message">@Culture["Discovery.Loading"]</p>
        }
        else if (!string.IsNullOrEmpty(_error) && _vacancies.Count == 0)
        {
            <p class="state-message error">@_error</p>
        }
        else if (_vacancies.Count == 0)
        {
            <p class="state-message">
                @if (_origin is null)
                {
                    @Culture["Discovery.NoneWithoutOrigin"]
                }
                else
                {
                    @Culture.Format("Discovery.NoneWithOrigin", _maxTravelMinutes, UiLabels.Transport(Culture, _selectedTransport))
                }
            </p>
        }
        else
        {
            <div class="results-meta">
                <p class="results-meta__count">@Culture.Format("Discovery.ResultCount", _vacancies.Count)</p>
                <label class="results-meta__sort">
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                    <span class="visually-hidden">@Culture["Discovery.Sort"]</span>
                    <select class="results-meta__sort-select" value="@EffectiveSortMode" @onchange="OnSortChanged">
                        @if (_origin is not null)
                        {
                            <option value="distance">@Culture["Discovery.SortDistance"]</option>
                        }
                        <option value="type">@Culture["Discovery.SortType"]</option>
                        <option value="recent">@Culture["Discovery.SortRecent"]</option>
                        <option value="title">@Culture["Discovery.SortAlphaAsc"]</option>
                        <option value="title-desc">@Culture["Discovery.SortAlphaDesc"]</option>
                    </select>
                </label>
            </div>
            @if (ShouldRenderVacancyCards)
            {
                <HighlightVacancyCarousel Vacancies="HighlightedVacanciesForUi"
                                          ActiveId="_hoveredId"
                                          ModifierClass="highlight-carousel--list"
                                          FormatTravel="FormatCarouselTravel"
                                          OnHover="OnHover"
                                          OnSelect="OnCarouselSelect" />
                <div class="vacancy-list vacancy-list--cards">
                    @foreach (var vacancy in VisibleVacancies)
                    {
                        var wageText = FormatWage(vacancy);
                        var travelText = vacancy.TravelMinutes is not null
                            ? $"± {vacancy.TravelMinutes} {Culture["Discovery.Minutes"]}"
                            : Culture.Format("Discovery.MaxMinutes", _maxTravelMinutes);
                        <article class="job-card @(_hoveredId == vacancy.Id ? "is-hovered" : null) @(vacancy.IsHighlighted ? "job-card--highlight" : null)"
                                 @onmouseenter="() => OnHover(vacancy.Id)"
                                 @onmouseleave="() => OnHover(null)"
                                 @onclick="() => OnSelect(vacancy.Id)">
                            <a class="job-card__media" href="@($"/vacancies/{vacancy.Id}")" @onclick:stopPropagation="true">
                                <VacancyPhoto Src="@vacancy.ImageUrl"
                                              FallbackSrc="@vacancy.CompanyLogoUrl"
                                              VacancyId="vacancy.Id"
                                              WorkType="@(vacancy.WorkTypes.FirstOrDefault())"
                                              Class="job-card__photo"
                                              Width="400"
                                              Height="267"
                                              Sizes="(max-width: 700px) 50vw, 360px" />
                                @if (vacancy.IsHighlighted)
                                {
                                    <span class="job-card__badge">@Culture["Discovery.Featured"]</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(vacancy.ExclusivityName)
                                         && string.Equals(vacancy.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
                                         && !vacancy.ExclusivityIsOpen)
                                {
                                    <span class="job-card__badge job-card__badge--soft">@vacancy.ExclusivityName</span>
                                }
                                else if (ShowsSuitableFor65Plus(vacancy))
                                {
                                    <span class="job-card__badge job-card__badge--senior65">@VacancyCategoryDefaults.SuitableFor65PlusLabel</span>
                                }
                                else if (vacancy.WorkTypes.Length > 0)
                                {
                                    <span class="job-card__badge job-card__badge--soft">@UiLabels.WorkType(Culture, vacancy.WorkTypes[0])</span>
                                }
                                <div class="job-card__overlay">
                                    <h2>@vacancy.Title</h2>
                                    <p class="job-card__travel">
                                        <LobsyMark Compact="true" />
                                        <span>@travelText · @UiLabels.TransportVerb(Culture, _selectedTransport)</span>
                                    </p>
                                    @if (!string.IsNullOrEmpty(wageText))
                                    {
                                        <p class="job-card__wage">@wageText</p>
                                    }
                                </div>
                            </a>
                            <div class="job-card__footer">
                                <p class="job-card__company">@(string.IsNullOrWhiteSpace(vacancy.OfferedByLabel) ? vacancy.CompanyName : vacancy.OfferedByLabel)</p>
                                <p class="job-card__location">@vacancy.CompanyAddress</p>
                            </div>
                        </article>
                    }
                </div>
                @if (HasMoreVacancyCards)
                {
                    <button type="button" class="vacancy-list__more" @onclick="ShowMoreVacancyCards">
                        @Culture.Format("Discovery.ShowResults", RemainingVacancyCardCount)
                    </button>
                }
            }
        }
    </aside>

    <section class="map-pane" aria-label="@Culture["Page.JobMapTitle"]">
        @if (RendererInfo.IsInteractive && _mapPainted && _vacancies.Count > 0)
        {
            <HighlightVacancyCarousel Vacancies="HighlightedVacanciesForUi"
                                      ActiveId="_hoveredId"
                                      ModifierClass="highlight-carousel--map"
                                      FormatTravel="FormatCarouselTravel"
                                      OnHover="OnHover"
                                      OnSelect="OnCarouselSelect" />
        }
        <div class="map-stage @(_mapPainted ? "is-live" : null)">
            <script type="application/json" id="jobsy-map-boot">@((MarkupString)MapBootPinsJson())</script>
            <div class="job-map-placeholder" aria-hidden="true"></div>
            <div @ref="_mapElement" id="job-map" class="job-map"></div>
            @if (_categories.Any(c => c.ShowInLegend && c.IsActive))
            {
                <div class="map-legend @(_legendOpen ? "is-open" : null)">
                    <button type="button"
                            class="map-legend__toggle"
                            aria-expanded="@(_legendOpen ? "true" : "false")"
                            aria-controls="map-legend-panel"
                            title="@(_legendOpen ? "Legenda verbergen" : "Legenda")"
                            @onclick="ToggleLegend"
                            @onclick:stopPropagation="true"
                            @onpointerdown:stopPropagation="true">
                        <span class="map-legend__toggle-dots" aria-hidden="true">
                            @foreach (var cat in _categories.Where(c => c.ShowInLegend && c.IsActive).Take(4))
                            {
                                <i style="--category-color:@cat.ColorHex"></i>
                            }
                        </span>
                        <span class="visually-hidden">@(_legendOpen ? "Legenda verbergen" : "Legenda tonen")</span>
                    </button>
                    <aside id="map-legend-panel"
                           class="map-legend__panel"
                           hidden="@(!_legendOpen)"
                           aria-hidden="@(!_legendOpen ? "true" : "false")"
                           aria-label="Legenda vacaturecategorieën">
                        <ul class="map-legend__list">
                            @foreach (var cat in _categories.Where(c => c.ShowInLegend && c.IsActive))
                            {
                                <li class="map-legend__item">
                                    <span class="map-legend__swatch" style="--category-color:@cat.ColorHex" aria-hidden="true"></span>
                                    <span>@cat.Name</span>
                                </li>
                            }
                        </ul>
                    </aside>
                </div>
            }
        </div>
    </section>

    @if (_filtersOpen)
    {
        <div class="filter-sheet-backdrop" @onclick="CloseFiltersAsync"></div>
        <div id="discovery-filters" class="filter-sheet" role="dialog" aria-modal="true" aria-labelledby="filter-sheet-title">
            <div class="filter-sheet__header">
                <img src="@Jobsy.Web.Media.BrandImages.AbsoluteWebp128"
                     alt=""
                     class="filter-sheet__mascot"
                     width="40"
                     height="40"
                     decoding="async"
                     draggable="false"
                     aria-hidden="true" />
                <h2 id="filter-sheet-title">
                    @Culture["Discovery.Filters"]
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="jobsy-action__badge">@ActiveFilterCount</span>
                    }
                </h2>
                <div class="filter-sheet__header-actions">
                    @if (ActiveFilterCount > 0)
                    {
                        <button type="button"
                                class="filter-sheet__clear-icon"
                                title="@Culture["Discovery.ClearFilters"]"
                                @onclick="ClearAllFiltersAsync"
                                aria-label="@Culture["Discovery.ClearFilters"]">
                            <span aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                        </button>
                    }
                    <button type="button" class="share-modal__close" @onclick="CloseFiltersAsync" aria-label="@Culture["Common.Close"]">×</button>
                </div>
            </div>

            @if (ActiveFilterCount > 0)
            {
                <div class="filter-sheet__tags">
                    @foreach (var workType in _selectedWorkTypes.OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <button type="button" class="filter-tag" @onclick="() => ClearWorkTypeAsync(workType)">@UiLabels.WorkType(Culture, workType) ×</button>
                    }
                    @foreach (var cat in SelectedCategories)
                    {
                        <button type="button" class="filter-tag" @onclick="() => ClearCategoryAsync(cat.Id)">@cat.Name ×</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button" class="filter-tag" @onclick="ClearSearchQueryAsync">“@_searchQuery” ×</button>
                    }
                    @if (_ageYears is not null)
                    {
                        <button type="button" class="filter-tag" @onclick="ClearAgeAsync">@_ageYears ×</button>
                    }
                    <button type="button"
                            class="filter-sheet__clear"
                            title="@Culture["Discovery.ClearFilters"]"
                            @onclick="ClearAllFiltersAsync"
                            aria-label="@Culture["Discovery.ClearFilters"]">
                        <span class="filter-sheet__clear-glyph" aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                        <span>@Culture["Discovery.ClearFilters"]</span>
                    </button>
                </div>
            }

            <div class="filter-sheet__body">
                @if (_canShowMyVacancies)
                {
                    <section class="filter-section filter-section--focus">
                        <h3>Vacatures</h3>
                        <button type="button"
                                class="filter-sheet__focus @(_myVacanciesOnly ? "is-active" : null)"
                                disabled="@_myVacanciesLoading"
                                @onclick="ToggleMyVacanciesAsync"
                                aria-pressed="@(_myVacanciesOnly ? "true" : "false")">
                            @MyVacanciesToggleLabel
                        </button>
                        <p class="muted">Toon alleen actieve open vacatures van bedrijven die jij beheert.</p>
                        @if (!string.IsNullOrWhiteSpace(_myVacanciesError))
                        {
                            <p class="state-message error">@_myVacanciesError</p>
                        }
                    </section>
                }

                <section class="filter-section">
                    <h3>@Culture["Discovery.Keyword"]</h3>
                    <label class="filter-sheet__query">
                        <span class="visually-hidden">@Culture["Discovery.Keyword"]</span>
                        <input type="search"
                               autocomplete="off"
                               placeholder="@Culture["Discovery.KeywordPlaceholder"]"
                               value="@(_searchDraft ?? _searchQuery ?? "")"
                               @oninput="OnSearchInput"
                               @onkeydown="OnSearchKeyDown" />
                    </label>
                </section>

                <section class="filter-section filter-section--hero">
                    <h3>@Culture["Discovery.TravelSlider"]</h3>
                    <div class="travel-slider">
                        <input type="range" min="5" max="90" step="5"
                               value="@_maxTravelMinutes"
                               @oninput="OnTravelSliderInput"
                               @onchange="OnMaxMinutesChanged" />
                        <div class="travel-slider__value">
                            <strong>@_maxTravelMinutes</strong> @Culture["Discovery.Minutes"]
                        </div>
                    </div>
                    <label>
                        @Culture["Discovery.Transport"]
                        <select value="@_selectedTransport" @onchange="OnTransportChanged">
                            <option value="Fiets">@Culture["Transport.Bike"]</option>
                            <option value="Auto">@Culture["Transport.Car"]</option>
                            <option value="OV">@Culture["Transport.Transit"]</option>
                            <option value="Lopend">@Culture["Transport.Walk"]</option>
                        </select>
                    </label>
                </section>

                <section class="filter-section filter-section--hero">
                    <h3>@Culture["Discovery.HoursSlider"]</h3>
                    <HoursRangeSlider Min="0"
                                      Max="40"
                                      Low="_minHoursPerWeek"
                                      High="_maxHoursPerWeek"
                                      LowChanged="OnMinHoursSliderValue"
                                      HighChanged="OnMaxHoursSliderValue"
                                      RangeCommitted="CommitHoursRangeAsync" />
                </section>

                <section class="filter-section">
                    <h3>@Culture["Discovery.WorkType"]</h3>
                    <div class="branch-multiselect branch-multiselect--sheet @(_branchMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_branchMenuOpen ? "true" : "false")"
                                aria-controls="@(_branchMenuOpen ? "branch-multiselect-panel-sheet" : null)"
                                @onclick="ToggleBranchMenu">
                            <span class="branch-multiselect__value @(_selectedWorkTypes.Count > 0 ? "is-selected" : null)">@BranchFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_branchMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseBranchMenu"></button>
                            <div id="branch-multiselect-panel-sheet"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.WorkType"]">
                                @foreach (var label in _branchOptions)
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedWorkTypes.Contains(label)"
                                               @onchange="e => ToggleWorkTypeAsync(label, e)" />
                                        @UiLabels.WorkType(Culture, label)
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </section>


                <section class="filter-section">
                    <h3>@Culture["Discovery.VacancyType"]</h3>
                    <div class="branch-multiselect branch-multiselect--sheet @(_categoryMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_categoryMenuOpen ? "true" : "false")"
                                aria-controls="@(_categoryMenuOpen ? "category-multiselect-panel-sheet" : null)"
                                @onclick="ToggleCategoryMenu">
                            <span class="branch-multiselect__value @(_selectedCategoryIds.Count > 0 ? "is-selected" : null)">@CategoryFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_categoryMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseCategoryMenu"></button>
                            <div id="category-multiselect-panel-sheet"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.VacancyType"]">
                                @foreach (var cat in _categories.Where(c => c.ShowInMapFilter && c.IsActive))
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedCategoryIds.Contains(cat.Id)"
                                               @onchange="e => ToggleCategoryAsync(cat.Id, e)" />
                                        <span class="category-filter__swatch" style="--category-color:@cat.ColorHex" aria-hidden="true"></span>
                                        @cat.Name
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </section>


                <section class="filter-section">
                    <h3>@Culture["Discovery.Age"] · @Culture["Discovery.HourlyWageShort"]</h3>
                    <label>
                        @Culture["Discovery.Age"]
                        <select value="@AgeSelectValue" @onchange="OnAgeChanged" required>
                            <option value="all">@Culture["Discovery.AgeAny"]</option>
                            @for (var age = 15; age <= 21; age++)
                            {
                                <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                            }
                        </select>
                    </label>
                    @if (_ageYears is not null)
                    {
                        <label>
                            @Culture["Discovery.MinWage"]
                            <input type="number" min="0" step="0.50" placeholder="—"
                                   value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMinWageChanged" />
                        </label>
                        <label>
                            @Culture["Discovery.MaxWage"]
                            <input type="number" min="0" step="0.50" placeholder="—"
                                   value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMaxWageChanged" />
                        </label>
                    }
                </section>

                <section class="filter-section">
                    <label>
                        @Culture["Discovery.Radius"]
                        <input type="number" min="1" max="50" value="@_radiusKm"
                               @onchange="OnRadiusChanged" />
                    </label>
                </section>
            </div>

            <div class="filter-sheet__footer">
                <button type="button" class="filter-sheet__cancel" @onclick="CloseFiltersAsync">
                    @Culture["Discovery.Cancel"]
                </button>
                <button type="button" class="filter-sheet__apply" @onclick="ApplySearch">
                    @Culture["Discovery.Apply"]
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<VacancyListItem> _vacancies = [];
    private string? JobListJsonLd =>
        StructuredData.JobList(
            Navigation.BaseUri.TrimEnd('/'),
            _vacancies.Select(v => (v.Id, v.Title, v.CompanyName)));
    private bool _loading = true;
    private string? _error;
    private Guid? _hoveredId;
    private uint _highlightShuffleSeed;
    private bool showMapOnMobile = true;
    /// <summary>Desktop split view (≥769px). Default false so mobile PSI does not mount 200+ cards.</summary>
    private bool _wideViewport;
    private const int VacancyCardPageSize = 12;
    private const int HighlightCarouselCap = 8;
    private int _visibleCardCount = VacancyCardPageSize;
    private bool _filtersOpen;
    private bool _legendOpen;
    private bool _branchMenuOpen;
    private bool _categoryMenuOpen;
    private bool _mapReady;
    private bool _mapPainted;
    private bool _mapInitScheduled;
    private bool _mapHostReady;
    private VacancyMapView? _mapView;

    private ElementReference _mapElement;
    private const int DefaultMinHoursPerWeek = 0;
    private const int DefaultMaxHoursPerWeek = 40;

    private int _maxTravelMinutes = 30;
    private int _radiusKm = 15;
    private string _selectedTransport = "Fiets";
    private int _minHoursPerWeek = DefaultMinHoursPerWeek;
    private int _maxHoursPerWeek = DefaultMaxHoursPerWeek;
    private readonly HashSet<string> _selectedWorkTypes = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<Guid> _selectedCategoryIds = [];
    private List<VacancyCategoryItem> _categories = [];
    private HashSet<string> _snapSelectedWorkTypes = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<Guid> _snapSelectedCategoryIds = [];
    private HashSet<Guid>? _snapMyVacancyCompanyIds;
    private HashSet<Guid>? _snapMyVacancyIds;
    private int _snapMaxTravelMinutes = 30;
    private int _snapRadiusKm = 15;
    private string _snapSelectedTransport = "Fiets";
    private int _snapMinHoursPerWeek = DefaultMinHoursPerWeek;
    private int _snapMaxHoursPerWeek = DefaultMaxHoursPerWeek;
    private int? _snapAgeYears;
    private decimal? _snapMinHourlyWage;
    private decimal? _snapMaxHourlyWage;
    private string? _snapSearchQuery;
    private bool _snapMyVacanciesOnly;
    /// <summary>Free-text filter: company name, vacancy title, description (?q=).</summary>
    private string? _searchQuery;
    /// <summary>In-progress text in the keyword field (debounced into <see cref="_searchQuery"/>).</summary>
    private string? _searchDraft;
    private CancellationTokenSource? _searchDebounceCts;
    /// <summary>Deep-link from raamflyer QR (?company= / ?companies=).</summary>
    private HashSet<Guid>? _companyFocusIds;
    private HashSet<Guid>? _queryCompanyFocusIds;
    private HashSet<Guid>? _myVacancyCompanyIds;
    private HashSet<Guid>? _myVacancyIds;
    private Guid? _mapFocusCompanyId;
    private bool _pendingCompanyMapFocus;
    private List<string> _branchOptions = WorkTypeLabels.All.ToList();
    private string _sortMode = "title";
    private bool _sortChosenByUser;
    private int? _ageYears;
    /// <summary>Age from candidate profile (DOB), used as default / restore target.</summary>
    private int? _profileAgeYears;
    private decimal? _minHourlyWage;
    private decimal? _maxHourlyWage;
    private bool _isCandidate;
    private bool _canShowMyVacancies;
    private bool _myVacanciesOnly;
    private bool _myVacanciesLoading;
    private string? _myVacanciesError;
    private CandidatePreferences? _candidatePrefs;
    private OriginPoint? _origin;
    private string _addressQuery = string.Empty;
    private List<AddressSuggestion> _suggestions = [];
    private bool _showSuggestions;
    private bool _suggesting;
    private bool _locating;
    private string? _locationError;
    private DotNetObjectReference<VacancyDiscovery>? _dotNetRef;
    private CancellationTokenSource? _suggestCts;
    private int _suggestGeneration;
    private int _loadGeneration;
    private bool _launchHydrationDone;

    /// <summary>
    /// Always maps to an existing &lt;option&gt;: "all", 15–20, or "21" (21+).
    /// Ages above 21 must not leave the select blank.
    /// </summary>
    private string AgeSelectValue => _ageYears switch
    {
        null => "all",
        >= 21 => "21",
        var age => age.Value.ToString()
    };

    private string BranchFilterSummary
    {
        get
        {
            if (_selectedWorkTypes.Count == 0)
            {
                return Culture["Discovery.WorkTypeAny"];
            }

            var labels = _selectedWorkTypes
                .OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)
                .Select(x => UiLabels.WorkType(Culture, x))
                .ToList();
            return FormatMultiSelectSummary(labels);
        }
    }

    private string CategoryFilterSummary
    {
        get
        {
            if (_selectedCategoryIds.Count == 0)
            {
                return Culture["Discovery.VacancyTypeAny"];
            }

            var labels = SelectedCategories.Select(c => c.Name).ToList();
            return FormatMultiSelectSummary(labels);
        }
    }

    private string FormatMultiSelectSummary(IReadOnlyList<string> labels)
    {
        if (labels.Count == 1)
        {
            return labels[0];
        }

        if (labels.Count == 2)
        {
            return $"{labels[0]}, {labels[1]}";
        }

        return Culture.Format("Discovery.SelectedMore", labels[0], labels.Count - 1);
    }

    private IEnumerable<VacancyCategoryItem> SelectedCategories =>
        _categories
            .Where(c => _selectedCategoryIds.Contains(c.Id))
            .OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase);

    private IReadOnlyList<VacancyListItem> HighlightedVacancies
    {
        get
        {
            IEnumerable<VacancyListItem> query = _vacancies.Where(v => v.IsHighlighted);

            // With an address/origin: only featured jobs inside the active travel/radius filter.
            // Without an address: show all featured vacancies in the current result set.
            if (_origin is not null)
            {
                query = query.Where(v =>
                    v.TravelMinutes is int minutes
                    && minutes > 0
                    && minutes <= _maxTravelMinutes
                    && (v.DistanceKm is null || v.DistanceKm <= _radiusKm));
            }

            return query
                .OrderBy(v => HighlightShuffleRank(v.Id))
                .ThenBy(v => v.Title, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }

    private uint HighlightShuffleRank(Guid id)
        => HighlightShuffleRules.Rank(_highlightShuffleSeed, id);

    private IReadOnlyList<VacancyListItem> SortedVacancies
    {
        get
        {
            var mode = EffectiveSortMode;
            var titleComparer = StringComparer.CurrentCultureIgnoreCase;
            IEnumerable<VacancyListItem> sorted = mode switch
            {
                "distance" => _vacancies
                    .OrderBy(v => v.TravelMinutes ?? int.MaxValue)
                    .ThenBy(v => v.DistanceKm ?? double.MaxValue)
                    .ThenBy(v => v.Title, titleComparer),
                "type" => _vacancies
                    .OrderBy(v => v.WorkTypes.FirstOrDefault() ?? "\uFFFF", titleComparer)
                    .ThenBy(v => v.Title, titleComparer),
                "recent" => _vacancies
                    .OrderByDescending(v => v.StartDate)
                    .ThenBy(v => v.Title, titleComparer),
                "title-desc" => _vacancies
                    .OrderByDescending(v => v.Title, titleComparer),
                _ => _vacancies
                    .OrderBy(v => v.Title, titleComparer)
            };
            return sorted.ToList();
        }
    }

    /// <summary>
    /// Job cards stay out of prerender HTML and the hidden mobile map pane.
    /// Desktop (wide) shows the list as soon as the viewport is known — do not
    /// wait for MapLibre. Mobile list view still waits until the map has painted
    /// so toggling away from the map does not flash an empty column.
    /// </summary>
    private bool ShouldRenderVacancyCards =>
        RendererInfo.IsInteractive && (_wideViewport || (_mapPainted && !showMapOnMobile));

    private IReadOnlyList<VacancyListItem> HighlightedVacanciesForUi
    {
        get
        {
            var all = HighlightedVacancies;
            return all.Count <= HighlightCarouselCap
                ? all
                : all.Take(HighlightCarouselCap).ToList();
        }
    }

    private IEnumerable<VacancyListItem> VisibleVacancies =>
        SortedVacancies.Take(_visibleCardCount);

    private bool HasMoreVacancyCards =>
        ShouldRenderVacancyCards && SortedVacancies.Count > _visibleCardCount;

    private int RemainingVacancyCardCount =>
        Math.Max(0, SortedVacancies.Count - _visibleCardCount);

    private void ShowMoreVacancyCards()
        => _visibleCardCount = Math.Min(SortedVacancies.Count, _visibleCardCount + VacancyCardPageSize);

    private string FormatCarouselTravel(VacancyListItem vacancy)
    {
        if (vacancy.TravelMinutes is not int minutes || minutes <= 0)
        {
            return string.Empty;
        }

        return Culture.Format(
            "Discovery.TravelModeMinutes",
            minutes,
            UiLabels.TransportVerb(Culture, _selectedTransport));
    }

    private string EffectiveSortMode =>
        _sortMode == "distance" && _origin is null ? "title" : _sortMode;

    private string MyVacanciesToggleLabel => _myVacanciesLoading
        ? "Laden…"
        : _myVacanciesOnly
            ? "Verberg mijn vacatures"
            : "Toon mijn vacatures";

    private int ActiveFilterCount
    {
        get
        {
            var n = 0;
            if (_selectedWorkTypes.Count > 0) n++;
            if (_selectedCategoryIds.Count > 0) n++;
            if (!string.IsNullOrWhiteSpace(_searchQuery)) n++;
            if (_ageYears is not null) n++;
            if (_minHourlyWage is not null) n++;
            if (_maxHourlyWage is not null) n++;
            if (_minHoursPerWeek != DefaultMinHoursPerWeek || _maxHoursPerWeek != DefaultMaxHoursPerWeek) n++;
            if (_myVacanciesOnly) n++;
            if (_origin is not null && _maxTravelMinutes != 30) n++;
            if (_origin is not null && _selectedTransport != "Fiets") n++;
            if (_origin is not null && _radiusKm != 15) n++;
            return n;
        }
    }

    /// <summary>
    /// Default travel/origin can wipe the catalog when the stored home is far away.
    /// Fall back to the full filtered set (keeping category / work-type / age filters)
    /// only while proximity controls are still at their defaults.
    /// </summary>
    private bool ShouldFallbackFromEmptyProximity =>
        _origin is not null
        && string.IsNullOrWhiteSpace(_searchQuery)
        && _minHourlyWage is null
        && _maxHourlyWage is null
        && _minHoursPerWeek == DefaultMinHoursPerWeek
        && _maxHoursPerWeek == DefaultMaxHoursPerWeek
        && _maxTravelMinutes == 30
        && _radiusKm == 15
        && string.Equals(_selectedTransport, "Fiets", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        Navigation.LocationChanged += OnLocationChanged;
        ApplyWorkTypeFromQuery();
        ApplySearchQueryFromQuery();
        ApplyTravelFromQuery();
        ApplyTransportFromQuery();
        ApplyHoursFromQuery();
        ApplyCompanyFocusFromQuery();
        // Kaartfocus/branding must not block catalog load or first paint.
        var regionHostTask = RegionHost.EnsureInitializedAsync();

        if (!RendererInfo.IsInteractive)
        {
            // Load the warm catalog + precomputed camera during prerender so
            // #jobsy-map-boot has the opening view (and pins) before the circuit.
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
                var viewTask = LoadMapViewAsync(cts.Token);
                await LoadVacanciesAsync(cts.Token);
                await viewTask;
                try
                {
                    await regionHostTask.WaitAsync(cts.Token);
                }
                catch (OperationCanceledException)
                {
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
            }
            return;
        }

        _ = regionHostTask;

        // Catalog + map-view in parallel — do not wait on profile/masterdata before pins appear.
        var viewTaskInteractive = LoadMapViewAsync();
        var catalogTask = LoadVacanciesAsync();
        var profileChangedFilters = false;
        try
        {
            await LoadBranchOptionsAsync();
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _isCandidate = user.IsInRole("Candidate");
            _canShowMyVacancies = user.IsInRole("EnterpriseManager")
                || user.IsInRole("RegionalManager")
                || user.IsInRole("BranchManager")
                || user.IsInRole("Intermediary");
            if (_isCandidate)
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    _candidatePrefs = profile.Preferences;
                    var beforeAge = _ageYears;
                    var beforeTravel = _maxTravelMinutes;
                    var beforeTransport = _selectedTransport;
                    var beforeMinHours = _minHoursPerWeek;
                    var beforeMaxHours = _maxHoursPerWeek;
                    var beforeTypes = _selectedWorkTypes.ToHashSet(StringComparer.OrdinalIgnoreCase);
                    ApplyAgeFromProfile(profile);

                    if (profile.Preferences.MaxTravelMinutes is int travel)
                    {
                        _maxTravelMinutes = Math.Clamp(travel, 5, 90);
                    }

                    if (!string.IsNullOrWhiteSpace(profile.Preferences.PreferredTransport))
                    {
                        _selectedTransport = profile.Preferences.PreferredTransport;
                    }

                    ApplyHoursFromProfile(profile.Preferences);

                    // Query-param workType (from assistant) wins over profile preference.
                    if (_selectedWorkTypes.Count == 0
                        && profile.Preferences.Roles is { Count: > 0 })
                    {
                        foreach (var role in profile.Preferences.Roles)
                        {
                            var preferred = WorkTypeLabels.Expand(WorkTypeLabels.Parse(role)).FirstOrDefault()
                                            ?? _branchOptions.FirstOrDefault(l =>
                                                l.Equals(role.Trim(), StringComparison.OrdinalIgnoreCase));
                            if (!string.IsNullOrWhiteSpace(preferred))
                            {
                                _selectedWorkTypes.Add(preferred!);
                            }
                        }
                    }

                    profileChangedFilters = beforeAge != _ageYears
                        || beforeTravel != _maxTravelMinutes
                        || !string.Equals(beforeTransport, _selectedTransport, StringComparison.Ordinal)
                        || beforeMinHours != _minHoursPerWeek
                        || beforeMaxHours != _maxHoursPerWeek
                        || !beforeTypes.SetEquals(_selectedWorkTypes);
                }
            }
        }
        catch
        {
            // anonymous or profile unavailable
        }

        await catalogTask;
        await viewTaskInteractive;
        if (profileChangedFilters)
        {
            await LoadVacanciesAsync();
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var beforeTypes = _selectedWorkTypes.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var beforeQuery = _searchQuery;
        var beforeMinutes = _maxTravelMinutes;
        var beforeTransport = _selectedTransport;
        var beforeMinHours = _minHoursPerWeek;
        var beforeMaxHours = _maxHoursPerWeek;
        var beforeCompanies = _companyFocusIds is null
            ? ""
            : string.Join(',', _companyFocusIds.OrderBy(x => x));
        ApplyWorkTypeFromQuery();
        ApplySearchQueryFromQuery();
        ApplyTravelFromQuery();
        ApplyTransportFromQuery();
        ApplyHoursFromQuery();
        ApplyCompanyFocusFromQuery();
        var afterCompanies = _companyFocusIds is null
            ? ""
            : string.Join(',', _companyFocusIds.OrderBy(x => x));
        if (!beforeTypes.SetEquals(_selectedWorkTypes)
            || !string.Equals(beforeQuery, _searchQuery, StringComparison.Ordinal)
            || beforeMinutes != _maxTravelMinutes
            || !string.Equals(beforeTransport, _selectedTransport, StringComparison.OrdinalIgnoreCase)
            || beforeMinHours != _minHoursPerWeek
            || beforeMaxHours != _maxHoursPerWeek
            || !string.Equals(beforeCompanies, afterCompanies, StringComparison.Ordinal))
        {
            showMapOnMobile = true;
            if (_mapReady)
            {
                try { await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions()); }
                catch { /* ignore */ }
            }
            await LoadVacanciesAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyCompanyFocusFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var ids = new HashSet<Guid>();

        if (query.TryGetValue("company", out var singleValues))
        {
            foreach (var raw in singleValues)
            {
                if (Guid.TryParse(raw, out var id))
                {
                    ids.Add(id);
                }
            }
        }

        if (query.TryGetValue("companies", out var multiValues))
        {
            foreach (var raw in multiValues)
            {
                if (string.IsNullOrWhiteSpace(raw))
                {
                    continue;
                }

                foreach (var part in raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (Guid.TryParse(part, out var id))
                    {
                        ids.Add(id);
                    }
                }
            }
        }

        if (ids.Count == 0)
        {
            _queryCompanyFocusIds = null;
            ApplyEffectiveCompanyFocus();
            return;
        }

        _queryCompanyFocusIds = ids;
        ApplyEffectiveCompanyFocus();
    }

    private void ApplyEffectiveCompanyFocus()
    {
        var ids = _myVacanciesOnly
            ? _myVacancyCompanyIds
            : _queryCompanyFocusIds;

        _companyFocusIds = ids is { Count: > 0 } ? ids.ToHashSet() : null;
        _mapFocusCompanyId = _companyFocusIds?.Count == 1 ? _companyFocusIds.First() : null;
        _pendingCompanyMapFocus = _mapFocusCompanyId is not null;
        if (_companyFocusIds is not null)
        {
            showMapOnMobile = true;
        }
    }

    private void ApplyWorkTypeFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("workType", out var values))
        {
            return;
        }

        var parsed = WorkTypeLabels.NormalizeFilterLabels(values);
        if (parsed.Length == 0)
        {
            return;
        }

        _selectedWorkTypes.Clear();
        foreach (var label in parsed)
        {
            // Prefer masterdata / built-in option casing when available.
            var option = _branchOptions.FirstOrDefault(l =>
                             l.Equals(label, StringComparison.OrdinalIgnoreCase))
                         ?? label;
            _selectedWorkTypes.Add(option);
        }
    }

    private void ApplySearchQueryFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var values))
        {
            _searchQuery = null;
            _searchDraft = null;
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        _searchQuery = string.IsNullOrWhiteSpace(raw) ? null : raw;
        _searchDraft = _searchQuery;
    }

    private void ApplyTravelFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("maxMinutes", out var values))
        {
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        if (int.TryParse(raw, out var minutes))
        {
            _maxTravelMinutes = Math.Clamp(minutes, 5, 90);
        }
    }

    private void ApplyTransportFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("transport", out var values))
        {
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        _selectedTransport = raw switch
        {
            var t when t.Equals("Lopend", StringComparison.OrdinalIgnoreCase) => "Lopend",
            var t when t.Equals("Fiets", StringComparison.OrdinalIgnoreCase) => "Fiets",
            var t when t.Equals("Auto", StringComparison.OrdinalIgnoreCase) => "Auto",
            var t when t.Equals("OV", StringComparison.OrdinalIgnoreCase) => "OV",
            _ => _selectedTransport
        };
    }

    private void ApplyHoursFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        int? min = null;
        int? max = null;
        if (query.TryGetValue("minHours", out var minValues)
            && int.TryParse(minValues.FirstOrDefault()?.Trim(), out var minParsed))
        {
            min = minParsed;
        }

        if (query.TryGetValue("maxHours", out var maxValues)
            && int.TryParse(maxValues.FirstOrDefault()?.Trim(), out var maxParsed))
        {
            max = maxParsed;
        }

        if (min is null && max is null)
        {
            return;
        }

        SetHoursRange(min ?? _minHoursPerWeek, max ?? _maxHoursPerWeek);
    }

    private void ApplyHoursFromProfile(CandidatePreferences prefs)
    {
        // Query params already applied in OnInitializedAsync win over profile defaults.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.ContainsKey("minHours") || query.ContainsKey("maxHours"))
        {
            return;
        }

        if (prefs.MinHoursPerWeek is null && prefs.MaxHoursPerWeek is null)
        {
            return;
        }

        var min = prefs.MinHoursPerWeek is decimal profileMin
            ? (int)Math.Round(profileMin, MidpointRounding.AwayFromZero)
            : DefaultMinHoursPerWeek;
        var max = prefs.MaxHoursPerWeek is decimal profileMax
            ? (int)Math.Round(profileMax, MidpointRounding.AwayFromZero)
            : DefaultMaxHoursPerWeek;
        SetHoursRange(min, max);
    }

    private void SetHoursRange(int min, int max)
    {
        min = Math.Clamp(min, DefaultMinHoursPerWeek, DefaultMaxHoursPerWeek);
        max = Math.Clamp(max, DefaultMinHoursPerWeek, DefaultMaxHoursPerWeek);
        if (max < min)
        {
            (min, max) = (max, min);
        }

        _minHoursPerWeek = min;
        _maxHoursPerWeek = max;
    }

    private async Task LoadBranchOptionsAsync()
    {
        try
        {
            var options = await Api.GetMasterdataAsync(MasterdataCategories.Branch);
            var branches = options.Select(o => o.Label).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
            if (branches.Count > 0)
            {
                _branchOptions = branches;
            }
        }
        catch
        {
            // keep built-in fallback
        }

        try
        {
            _categories = (await Api.GetVacancyCategoriesAsync())
                .Where(c => c.IsActive && !IsHighlightCategory(c))
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.Name)
                .ToList();
        }
        catch
        {
            _categories = [];
        }
    }

