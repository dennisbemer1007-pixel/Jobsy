    /// Default travel/origin can wipe the catalog when the stored home is far away.
    /// Fall back to the full filtered set (keeping category / work-type / age filters)
    /// only while proximity controls are still at their defaults.
    /// </summary>
    private bool ShouldFallbackFromEmptyProximity =>
        _origin is not null
        && string.IsNullOrWhiteSpace(_searchQuery)
        && _minHourlyWage is null
        && _maxHourlyWage is null
        && _minHoursPerWeek == DefaultMinHoursPerWeek
        && _maxHoursPerWeek == DefaultMaxHoursPerWeek
        && _maxTravelMinutes == KbMapStart.DefaultMaxTravelMinutes
        && _radiusKm == 15
        && string.Equals(_selectedTransport, "Fiets", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        Navigation.LocationChanged += OnLocationChanged;
        ApplyWorkTypeFromQuery();
        ApplySearchQueryFromQuery();
        ApplyTravelFromQuery();
        ApplyTransportFromQuery();
        ApplyHoursFromQuery();
        ApplyCompanyFocusFromQuery();
        ApplyWeergaveFromQuery();
        // Kaartfocus/branding must not block catalog load or first paint.
        var regionHostTask = RegionHost.EnsureInitializedAsync();

        if (!RendererInfo.IsInteractive)
        {
            // Warm pins + camera only — never persist the full vacancy catalog into the
            // HTML (that blew past the 2 MB Blazor hub limit and killed the circuit).
            // Pins API is ~6 KB / ~370 ms; the interactive render loads the list.
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
                var viewTask = LoadMapViewAsync(cts.Token);
                var pinsTask = LoadBootPinsAsync(cts.Token);
                await Task.WhenAll(viewTask, pinsTask);
                try
                {
                    await regionHostTask.WaitAsync(cts.Token);
                }
                catch (OperationCanceledException)
                {
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
            }
            return;
        }

        _ = regionHostTask;

        // Catalog + map-view + pins in parallel — do not wait on profile/masterdata before pins appear.
        var viewTaskInteractive = LoadMapViewAsync();
        var bootPinsTask = LoadBootPinsAsync();
        var catalogTask = LoadVacanciesAsync();
        var profileChangedFilters = false;
        try
        {
            await LoadBranchOptionsAsync();
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;
            _isAuthenticated = user.Identity?.IsAuthenticated == true;
            _isCandidate = user.IsInRole("Candidate");
            _canShowMyVacancies = user.IsInRole("EnterpriseManager")
                || user.IsInRole("RegionalManager")
                || user.IsInRole("BranchManager")
                || user.IsInRole("Intermediary");
            if (_isCandidate)
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    _candidatePrefs = profile.Preferences;
                    var beforeAge = _ageYears;
                    var beforeMinHours = _minHoursPerWeek;
                    var beforeMaxHours = _maxHoursPerWeek;
                    ApplyAgeFromProfile(profile);
                    // D5: do NOT copy MaxTravelMinutes / PreferredTransport into map filters.
                    // Match scoring still uses profile preferences elsewhere.
                    ApplyHoursFromProfile(profile.Preferences);
                    _profileMinHours = _minHoursPerWeek;
                    _profileMaxHours = _maxHoursPerWeek;
                    _filterDefaults = new KbFilterDefaults(
                        Transport: KbMapStart.DefaultTransport,
                        MaxTravelMinutes: KbMapStart.DefaultMaxTravelMinutes,
                        RadiusKm: 15,
                        AgeYears: _profileAgeYears,
                        MinHoursPerWeek: _minHoursPerWeek,
                        MaxHoursPerWeek: _maxHoursPerWeek);
                    // Keep map start defaults (Fiets / 20) even when profile has other travel prefs.
                    _maxTravelMinutes = KbMapStart.DefaultMaxTravelMinutes;
                    _selectedTransport = KbMapStart.DefaultTransport;

                    profileChangedFilters = beforeAge != _ageYears
                        || beforeMinHours != _minHoursPerWeek
                        || beforeMaxHours != _maxHoursPerWeek;
                }
            }
        }
        catch
        {
            // anonymous or profile unavailable
        }

        await catalogTask;
        await viewTaskInteractive;
        await bootPinsTask;
        if (_isCandidate && !_sortChosenByUser && ShowFitFilters)
        {
            _sortMode = "match";
        }
        if (profileChangedFilters)
        {
            await LoadVacanciesAsync();
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            if (_disposed)
            {
                return;
            }

            var beforeTypes = _selectedWorkTypes.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var beforeQuery = _searchQuery;
            var beforeMinutes = _maxTravelMinutes;
            var beforeTransport = _selectedTransport;
            var beforeMinHours = _minHoursPerWeek;
            var beforeMaxHours = _maxHoursPerWeek;
            var beforeCompanies = _companyFocusIds is null
                ? ""
                : string.Join(',', _companyFocusIds.OrderBy(x => x));
            ApplyWorkTypeFromQuery();
            ApplySearchQueryFromQuery();
            ApplyTravelFromQuery();
            ApplyTransportFromQuery();
            ApplyHoursFromQuery();
            ApplyCompanyFocusFromQuery();
            var weergaveBefore = _desktopListMode;
            ApplyWeergaveFromQuery();
            var afterCompanies = _companyFocusIds is null
                ? ""
                : string.Join(',', _companyFocusIds.OrderBy(x => x));
            if (!beforeTypes.SetEquals(_selectedWorkTypes)
                || !string.Equals(beforeQuery, _searchQuery, StringComparison.Ordinal)
                || beforeMinutes != _maxTravelMinutes
                || !string.Equals(beforeTransport, _selectedTransport, StringComparison.OrdinalIgnoreCase)
                || beforeMinHours != _minHoursPerWeek
                || beforeMaxHours != _maxHoursPerWeek
                || !string.Equals(beforeCompanies, afterCompanies, StringComparison.Ordinal))
            {
                showMapOnMobile = true;
                if (_mapReady)
                {
                    try { await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions()); }
                    catch (JSDisconnectedException) { }
                    catch (ObjectDisposedException) { }
                    catch (JSException) { }
                    catch (InvalidOperationException) { }
                }
                await LoadVacanciesAsync();
                if (!_disposed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
            else if (weergaveBefore != _desktopListMode && !_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Vacancy discovery location-changed handler failed.");
        }
    }

    private void ApplyWeergaveFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("weergave", out var values))
        {
            return;
        }

        var raw = values.FirstOrDefault();
        if (string.Equals(raw, "lijst", StringComparison.OrdinalIgnoreCase))
        {
            _desktopListMode = true;
        }
        else if (string.Equals(raw, "kaart", StringComparison.OrdinalIgnoreCase))
        {
            _desktopListMode = false;
        }
    }

    private async Task SetDesktopViewAsync(bool list)
    {
        if (_desktopListMode == list)
        {
            return;
        }

        _desktopListMode = list;
        await PersistWeergaveAsync();
        var uri = Navigation.GetUriWithQueryParameter("weergave", list ? "lijst" : null);
        Navigation.NavigateTo(uri, replace: true);
        if (!list && !_mapReady)
        {
            _mapInitScheduled = false;
            await TryInitJobMapAsync();
        }
        else if (list && _mapReady)
        {
            try
            {
                await Js.InvokeVoidAsync("jobMap.dispose");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            _mapReady = false;
            _mapPainted = false;
            _mapInitScheduled = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistWeergaveAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("jobsyGeo.setWeergave", _desktopListMode ? "lijst" : "kaart");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task HydrateWeergaveAsync()
    {
        if (_weergaveHydrated)
        {
            return;
        }

        _weergaveHydrated = true;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).ContainsKey("weergave"))
        {
            ApplyWeergaveFromQuery();
            return;
        }

        try
        {
            var stored = await Js.InvokeAsync<string?>("jobsyGeo.getWeergave");
            if (string.Equals(stored, "lijst", StringComparison.OrdinalIgnoreCase))
            {
                _desktopListMode = true;
                var next = Navigation.GetUriWithQueryParameter("weergave", "lijst");
                Navigation.NavigateTo(next, replace: true);
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void ApplyCompanyFocusFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var ids = new HashSet<Guid>();

        if (query.TryGetValue("company", out var singleValues))
        {
            foreach (var raw in singleValues)
            {
                if (Guid.TryParse(raw, out var id))
                {
                    ids.Add(id);
                }
            }
        }

        if (query.TryGetValue("companies", out var multiValues))
        {
            foreach (var raw in multiValues)
            {
                if (string.IsNullOrWhiteSpace(raw))
                {
                    continue;
                }

                foreach (var part in raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (Guid.TryParse(part, out var id))
                    {
                        ids.Add(id);
                    }
                }
            }
        }

        if (ids.Count == 0)
        {
            _queryCompanyFocusIds = null;
            ApplyEffectiveCompanyFocus();
            return;
        }

        _queryCompanyFocusIds = ids;
        ApplyEffectiveCompanyFocus();
    }

    private void ApplyEffectiveCompanyFocus()
    {
        var ids = _myVacanciesOnly
            ? _myVacancyCompanyIds
            : _queryCompanyFocusIds;

        _companyFocusIds = ids is { Count: > 0 } ? ids.ToHashSet() : null;
        _mapFocusCompanyId = _companyFocusIds?.Count == 1 ? _companyFocusIds.First() : null;
        _pendingCompanyMapFocus = _mapFocusCompanyId is not null;
        if (_companyFocusIds is not null)
        {
            showMapOnMobile = true;
        }
    }

    private void ApplyWorkTypeFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("workType", out var values))
        {
            return;
        }

        var parsed = WorkTypeLabels.NormalizeFilterLabels(values);
        if (parsed.Length == 0)
        {
            return;
        }

        _selectedWorkTypes.Clear();
        foreach (var label in parsed)
        {
            // Prefer masterdata / built-in option casing when available.
            var option = _branchOptions.FirstOrDefault(l =>
                             l.Equals(label, StringComparison.OrdinalIgnoreCase))
                         ?? label;
            _selectedWorkTypes.Add(option);
        }
    }

    private void ApplySearchQueryFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var values))
        {
            _searchQuery = null;
            _searchDraft = null;
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        _searchQuery = string.IsNullOrWhiteSpace(raw) ? null : raw;
        _searchDraft = _searchQuery;
    }

    private void ApplyTravelFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("maxMinutes", out var values))
        {
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        if (int.TryParse(raw, out var minutes))
        {
            _maxTravelMinutes = Math.Clamp(minutes, 5, 90);
        }
    }

    private void ApplyTransportFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("transport", out var values))
        {
            return;
        }

        var raw = values.FirstOrDefault()?.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        _selectedTransport = raw switch
        {
            var t when t.Equals("Lopend", StringComparison.OrdinalIgnoreCase) => "Lopend",
            var t when t.Equals("Fiets", StringComparison.OrdinalIgnoreCase) => "Fiets",
            var t when t.Equals("E-bike", StringComparison.OrdinalIgnoreCase) => "E-bike",
            var t when t.Equals("Auto", StringComparison.OrdinalIgnoreCase) => "Auto",
            var t when t.Equals("OV", StringComparison.OrdinalIgnoreCase) => "OV",
            _ => TransportLabels.IsEBike(raw) ? "E-bike" : _selectedTransport
        };
    }

    private void ApplyHoursFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        int? min = null;
        int? max = null;
        if (query.TryGetValue("minHours", out var minValues)
            && int.TryParse(minValues.FirstOrDefault()?.Trim(), out var minParsed))
        {
            min = minParsed;
        }

        if (query.TryGetValue("maxHours", out var maxValues)
            && int.TryParse(maxValues.FirstOrDefault()?.Trim(), out var maxParsed))
        {
            max = maxParsed;
        }

        if (min is null && max is null)
        {
            return;
        }

        SetHoursRange(min ?? _minHoursPerWeek, max ?? _maxHoursPerWeek);
    }

    private void ApplyHoursFromProfile(CandidatePreferences prefs)
    {
        // Query params already applied in OnInitializedAsync win over profile defaults.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.ContainsKey("minHours") || query.ContainsKey("maxHours"))
        {
            return;
        }

        if (prefs.MinHoursPerWeek is null && prefs.MaxHoursPerWeek is null)
        {
            return;
        }

        var min = prefs.MinHoursPerWeek is decimal profileMin
            ? (int)Math.Round(profileMin, MidpointRounding.AwayFromZero)
            : DefaultMinHoursPerWeek;
        var max = prefs.MaxHoursPerWeek is decimal profileMax
            ? (int)Math.Round(profileMax, MidpointRounding.AwayFromZero)
            : DefaultMaxHoursPerWeek;
        SetHoursRange(min, max);
    }

    private void SetHoursRange(int min, int max)
    {
        min = Math.Clamp(min, DefaultMinHoursPerWeek, DefaultMaxHoursPerWeek);
        max = Math.Clamp(max, DefaultMinHoursPerWeek, DefaultMaxHoursPerWeek);
        if (max < min)
        {
            (min, max) = (max, min);
        }

        _minHoursPerWeek = min;
        _maxHoursPerWeek = max;
    }

    private async Task LoadBranchOptionsAsync()
    {
        try
        {
            var options = await Api.GetMasterdataAsync(MasterdataCategories.Branch);
            var branches = options.Select(o => o.Label).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
            if (branches.Count > 0)
            {
                _branchOptions = branches;
            }
        }
        catch
        {
            // keep built-in fallback
        }

        try
        {
            _categories = (await Api.GetVacancyCategoriesAsync())
                .Where(c => c.IsActive && !IsHighlightCategory(c))
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.Name)
                .ToList();
        }
        catch
        {
            _categories = [];
        }
    }

