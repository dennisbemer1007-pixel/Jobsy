    private string MapBootPinsJson()
    {
        var opening = ResolveOpeningView();
        // Prefer dedicated pins API payload so prerender never ships 0 pins when the index is warm.
        var pins = _bootPins.Count > 0 ? _bootPins : BuildCompactPins(_vacancies);
        var payload = new Dictionary<string, object?>
        {
            ["preferFilledLocation"] = !HasCompanyMapFocus,
            ["view"] = new Dictionary<string, object?>
            {
                ["lat"] = opening.CenterLat,
                ["lng"] = opening.CenterLng,
                ["zoom"] = opening.Zoom
            },
            ["pins"] = pins,
            ["pinsUrl"] = BuildPinsApiUrl()
        };
        return JsonSerializer.Serialize(payload, BootPinJsonOptions)
            .Replace("<", "\\u003c", StringComparison.Ordinal);
    }

    /// <summary>
    /// Compact pin payload for the circuit / boot JSON — id, lat, lng, colour, match% only.
    /// Full vacancy fields load over HTTP when a pin or card is opened.
    /// Omit nulls/false/0 so #jobsy-map-boot stays under the Acc HTML budget.
    /// </summary>
    private static readonly JsonSerializerOptions BootPinJsonOptions = new()
    {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    };

    private List<Dictionary<string, object?>> BuildMarkers() => BuildCompactPins(SortedVacancies);

    private static Dictionary<string, object?> ToBootPinDict(VacancyPinBootItem p)
    {
        var dict = new Dictionary<string, object?>
        {
            ["id"] = p.Id.ToString("D"),
            ["lat"] = p.Lat,
            ["lng"] = p.Lng
        };
        if (!string.IsNullOrWhiteSpace(p.Colour))
        {
            // jobMap falls back colour ← categoryColor ← colour; one field is enough.
            dict["colour"] = p.Colour;
        }

        if (p.MatchPercent is not null)
        {
            dict["matchPercent"] = p.MatchPercent;
        }

        if (!string.IsNullOrWhiteSpace(p.MatchColorBand))
        {
            dict["matchColorBand"] = p.MatchColorBand;
        }

        if (p.Highlighted)
        {
            dict["highlighted"] = true;
            if (p.HighlightRank != 0)
            {
                dict["highlightRank"] = p.HighlightRank;
            }
        }

        if (!string.IsNullOrWhiteSpace(p.WorkType))
        {
            dict["workType"] = p.WorkType;
        }

        return dict;
    }

    private List<Dictionary<string, object?>> BuildCompactPins(IEnumerable<VacancyListItem> source) =>
        source
            .Where(v => double.IsFinite(v.Latitude) && double.IsFinite(v.Longitude))
            .Select(v =>
            {
                var colour = ShowsSuitableFor65Plus(v)
                    ? VacancyCategoryDefaults.SeniorPlusColorHex
                    : v.CategoryColorHex;
                var workType = v.WorkTypes is { Length: > 0 } ? v.WorkTypes[0] : null;
                return ToBootPinDict(new VacancyPinBootItem
                {
                    Id = v.Id,
                    Lat = v.Latitude,
                    Lng = v.Longitude,
                    Colour = colour,
                    MatchPercent = v.MatchPercent,
                    MatchColorBand = v.MatchColorBand,
                    Highlighted = v.IsHighlighted,
                    HighlightRank = v.IsHighlighted ? HighlightShuffleRank(v.Id) : 0u,
                    WorkType = workType
                });
            })
            .ToList();

    private string BuildPinsApiUrl()
    {
        var qs = new List<string>
        {
            $"transport={Uri.EscapeDataString(_selectedTransport)}",
            $"maxMinutes={_maxTravelMinutes}"
        };
        if (_origin is not null)
        {
            qs.Add($"originLat={_origin.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            qs.Add($"originLng={_origin.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            qs.Add($"radiusKm={_radiusKm.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }

        if (_selectedWorkTypes.Count > 0)
        {
            foreach (var wt in _selectedWorkTypes)
            {
                qs.Add($"workType={Uri.EscapeDataString(wt)}");
            }
        }

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            qs.Add($"q={Uri.EscapeDataString(_searchQuery.Trim())}");
        }

        if (_selectedCategoryIds.Count > 0)
        {
            foreach (var id in _selectedCategoryIds)
            {
                qs.Add($"categoryId={id:D}");
            }
        }

        if (_companyFocusIds is { Count: > 0 })
        {
            foreach (var id in _companyFocusIds)
            {
                qs.Add($"companyId={id:D}");
            }
        }

        if (_isCandidate && _minMatchPercent > 0)
        {
            qs.Add($"minMatchPercent={_minMatchPercent}");
        }

        return "/api/vacancies/pins?" + string.Join("&", qs);
    }

    private async Task ResolveLaunchOriginAsync()
    {
        KbMapStart.OriginPoint? urlOrigin = null;
        if (_origin is not null)
        {
            urlOrigin = new KbMapStart.OriginPoint(_origin.Latitude, _origin.Longitude, _addressQuery);
        }

        KbMapStart.OriginPoint? sessionOrigin = null;
        string? sessionTransport = null;
        int? sessionMinutes = null;
        try
        {
            var session = await Js.InvokeAsync<SessionOriginDto?>("jobsyGeo.getSessionOrigin");
            if (session is not null && IsFinite(session.Lat) && IsFinite(session.Lng))
            {
                sessionOrigin = new KbMapStart.OriginPoint(session.Lat, session.Lng, session.Label);
                sessionTransport = session.Transport;
                sessionMinutes = session.MaxMinutes;
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        KbMapStart.OriginPoint? storedOrigin = null;
        try
        {
            var stored = await Js.InvokeAsync<StoredOrigin?>("jobsyGeo.ensureLocationOnLaunch");
            if (stored is not null && IsFinite(stored.Lat) && IsFinite(stored.Lng))
            {
                storedOrigin = new KbMapStart.OriginPoint(stored.Lat, stored.Lng, stored.Label);
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        double? homeLat = null;
        double? homeLng = null;
        string? homeLabel = null;
        if (_isCandidate)
        {
            try
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    homeLat = profile.HomeLatitude;
                    homeLng = profile.HomeLongitude;
                    homeLabel = string.IsNullOrWhiteSpace(profile.Preferences.HomeAddress)
                        ? null
                        : profile.Preferences.HomeAddress.Trim();
                }
            }
            catch { }
        }

        var resolved = KbMapStart.Resolve(new KbMapStart.Input(
            UrlOrStateOrigin: urlOrigin,
            SessionOrigin: sessionOrigin,
            HomeLatitude: homeLat,
            HomeLongitude: homeLng,
            HomeAddressLabel: homeLabel,
            StoredOrigin: storedOrigin,
            IsLoggedInCandidate: _isCandidate));

        if (resolved.Origin is { } origin)
        {
            _origin = new OriginPoint { Latitude = origin.Latitude, Longitude = origin.Longitude };
            _addressQuery = origin.Label ?? _addressQuery;
            if (string.Equals(resolved.Source, "session", StringComparison.Ordinal)
                && !string.IsNullOrWhiteSpace(sessionTransport))
            {
                _selectedTransport = TransportLabels.Canonical(sessionTransport);
            }
            else
            {
                _selectedTransport = resolved.Transport;
            }

            if (string.Equals(resolved.Source, "session", StringComparison.Ordinal)
                && sessionMinutes is int sm)
            {
                _maxTravelMinutes = Math.Clamp(sm, 5, 90);
            }
            else
            {
                _maxTravelMinutes = resolved.MaxTravelMinutes;
            }

            if (!_sortChosenByUser && _sortMode is not "type" and not "recent" and not "match")
            {
                _sortMode = "distance";
            }

            if (string.IsNullOrWhiteSpace(_addressQuery))
            {
                _ = ResolveLaunchAddressAsync(origin.Latitude, origin.Longitude);
            }

            _showStartPrompt = false;
        }
        else
        {
            _showStartPrompt = resolved.ShowLocationPrompt && !_startPromptDismissed;
        }
    }

