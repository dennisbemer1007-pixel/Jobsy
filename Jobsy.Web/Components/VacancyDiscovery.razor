    private async Task ToggleMyVacanciesAsync()
    {
        if (!_canShowMyVacancies)
        {
            return;
        }

        _myVacanciesError = null;
        if (_myVacanciesOnly)
        {
            _myVacanciesOnly = false;
            _myVacancyCompanyIds = null;
            _myVacancyIds = null;
            ApplyEffectiveCompanyFocus();
            await LoadVacanciesAsync();
            return;
        }

        _myVacanciesLoading = true;
        try
        {
            var managed = await Api.GetManagedVacanciesAsync();
            var managedOpen = managed.Where(v =>
                ManagedVacancyMapFilter.IsPublishedOpen(v.Status, v.FulfilledByApplicationId)).ToList();
            _myVacancyIds = managedOpen
                .Select(v => v.Id)
                .Where(id => id != Guid.Empty)
                .ToHashSet();
            _myVacancyCompanyIds = managedOpen
                .Select(v => v.CompanyId)
                .Where(id => id != Guid.Empty)
                .ToHashSet();
            if (_myVacancyIds.Count == 0)
            {
                _myVacancyIds = null;
                _myVacancyCompanyIds = null;
                _myVacanciesOnly = false;
                _myVacanciesError = "Je beheert geen actieve open vacatures.";
                ApplyEffectiveCompanyFocus();
                return;
            }

            _myVacanciesOnly = true;
            ApplyEffectiveCompanyFocus();
            await LoadVacanciesAsync();
        }
        catch (Exception ex)
        {
            _myVacanciesError = ex.Message;
        }
        finally
        {
            _myVacanciesLoading = false;
        }
    }

