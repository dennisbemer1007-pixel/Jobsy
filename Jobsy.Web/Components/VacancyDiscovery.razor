    {
        _disposed = true;
        Culture.Changed -= OnCultureChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _pendingCountCts?.Cancel();
        _pendingCountCts?.Dispose();
        try
        {
            await Js.InvokeVoidAsync("jobsyDiscovery.disconnect");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        if (_mapReady)
        {
            try
            {
                await Js.InvokeVoidAsync("jobMap.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

