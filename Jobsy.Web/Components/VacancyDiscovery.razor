        }

        return Culture.Format(
            "Discovery.TravelModeMinutes",
            minutes,
            UiLabels.TransportVerb(Culture, _selectedTransport));
    }

    private async Task EnsureDesktopMatchDeckAsync()
    {
        if (_matchDeckLoadStarted || !_wideViewport || !_isCandidate || !_mapPainted)
        {
            return;
        }

        _matchDeckLoadStarted = true;
        try
        {
            await _matchDeck.LoadAsync(MatchProfile, MatchVacancies, take: 24, orderByMatch: true);
        }
        catch (Exception ex)
        {
            // Tile stays hidden on failure.
            Logger.LogWarning(ex, "Desktop match deck load failed.");
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Fire-and-forget guard: await the work, log failures (no PII), never rethrow into the circuit.
    /// </summary>
    private void RunDetachedAsync(Func<Task> work, string what)
    {
        _ = RunDetachedCoreAsync(work, what);
    }

    private async Task RunDetachedCoreAsync(Func<Task> work, string what)
    {
        try
        {
            await work();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Detached task failed: {What}", what);
        }
    }

