    private void ToggleFilters()
    {
        if (_filtersOpen)
        {
            _ = CloseFiltersAsync();
            return;
        }

        CaptureFilterSnapshot();
        _pendingResultCount = _vacancies.Count;
        _filtersOpen = true;
        SchedulePendingCountRefresh();
    }

    private async Task CloseFiltersAsync()
    {
        var wasOpen = _filtersOpen;
        // Drop pending keyword debounce so Cancel cannot re-apply a dismissed draft.
        _searchDebounceCts?.Cancel();
        _pendingCountCts?.Cancel();
        if (wasOpen)
        {
            RestoreFilterSnapshot();
        }

        _branchMenuOpen = false;
        _categoryMenuOpen = false;
        _filtersOpen = false;
        _pendingResultCount = null;

        if (wasOpen)
        {
            await ReloadFiltersIfAppliedAsync();
        }
    }

    private void CaptureFilterSnapshot()
    {
        _snapMaxTravelMinutes = _maxTravelMinutes;
        _snapRadiusKm = _radiusKm;
        _snapSelectedTransport = _selectedTransport;
        _snapMinHoursPerWeek = _minHoursPerWeek;
        _snapMaxHoursPerWeek = _maxHoursPerWeek;
        _snapAgeYears = _ageYears;
        _snapMinHourlyWage = _minHourlyWage;
        _snapMaxHourlyWage = _maxHourlyWage;
        _snapSearchQuery = _searchQuery;
        _snapSelectedWorkTypes = _selectedWorkTypes.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _snapSelectedCategoryIds = _selectedCategoryIds.ToHashSet();
        _snapMyVacanciesOnly = _myVacanciesOnly;
        _snapMyVacancyCompanyIds = _myVacancyCompanyIds?.ToHashSet();
        _snapMyVacancyIds = _myVacancyIds?.ToHashSet();
        _snapMinMatchPercent = _minMatchPercent;
        _snapSortMode = _sortMode;
        _snapSortChosenByUser = _sortChosenByUser;
    }

    private void RestoreFilterSnapshot()
    {
        _maxTravelMinutes = _snapMaxTravelMinutes;
        _radiusKm = _snapRadiusKm;
        _selectedTransport = _snapSelectedTransport;
        _minMatchPercent = _snapMinMatchPercent;
        _minHoursPerWeek = _snapMinHoursPerWeek;
        _maxHoursPerWeek = _snapMaxHoursPerWeek;
        _ageYears = _snapAgeYears;
        _minHourlyWage = _snapMinHourlyWage;
        _maxHourlyWage = _snapMaxHourlyWage;
        _searchQuery = _snapSearchQuery;
        _searchDraft = _snapSearchQuery;
        _myVacanciesOnly = _snapMyVacanciesOnly;
        _myVacancyCompanyIds = _snapMyVacancyCompanyIds?.ToHashSet();
        _myVacancyIds = _snapMyVacancyIds?.ToHashSet();
        _sortMode = _snapSortMode;
        _sortChosenByUser = _snapSortChosenByUser;
        ApplyEffectiveCompanyFocus();
        _selectedWorkTypes.Clear();
        _selectedCategoryIds.Clear();
        foreach (var type in _snapSelectedWorkTypes)
        {
            _selectedWorkTypes.Add(type);
        }
        foreach (var id in _snapSelectedCategoryIds)
        {
            _selectedCategoryIds.Add(id);
        }
    }

    private async Task ApplySearch()
    {
        _pendingCountCts?.Cancel();
        // Sync draft → query without going through CommitSearchAsync while sheet is still open
        // (that path would only schedule a pending count).
        var next = string.IsNullOrWhiteSpace(_searchDraft) ? null : _searchDraft.Trim();
        _searchQuery = next;
        _searchDraft = next;
        await PersistAgeAsync();
        await PersistSessionOriginAsync();

        if (_mapReady)
        {
            try { await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions()); }
            catch { /* ignore */ }
        }

        _branchMenuOpen = false;
        _categoryMenuOpen = false;
        _filtersOpen = false;
        _pendingResultCount = null;
        await LoadVacanciesAsync();
        CaptureFilterSnapshot();
    }

