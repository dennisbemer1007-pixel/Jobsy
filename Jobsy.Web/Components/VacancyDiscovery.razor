    private void RestoreFilterSnapshot()
    {
        _maxTravelMinutes = _snapMaxTravelMinutes;
        _radiusKm = _snapRadiusKm;
        _selectedTransport = _snapSelectedTransport;
        _minHoursPerWeek = _snapMinHoursPerWeek;
        _maxHoursPerWeek = _snapMaxHoursPerWeek;
        _ageYears = _snapAgeYears;
        _minHourlyWage = _snapMinHourlyWage;
        _maxHourlyWage = _snapMaxHourlyWage;
        _searchQuery = _snapSearchQuery;
        _searchDraft = _snapSearchQuery;
