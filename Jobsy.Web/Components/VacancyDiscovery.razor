        return Culture.Format(
            "Discovery.TravelModeMinutes",
            minutes,
            UiLabels.TransportVerb(Culture, _selectedTransport));
    }

    private string FormatTopMatchTravel(SwipeViewModel? model)
    {
        if (model?.TravelTimeMinutes is not int minutes || minutes <= 0)
        {
