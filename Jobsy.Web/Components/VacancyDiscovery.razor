            await Js.InvokeVoidAsync("jobMap.setOrigin", lat, lng, TravelMapOptions());
            await Js.InvokeVoidAsync("jobMap.fitToOriginRings", animate);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch
        {
        }
    }

