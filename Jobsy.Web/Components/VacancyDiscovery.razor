    private async Task OnAgeChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw) || !int.TryParse(raw, out var age))
        {
            _ageYears = null;
            _minHourlyWage = null;
            _maxHourlyWage = null;
        }
        else
        {
            _ageYears = Math.Clamp(age, 15, 67);
        }

        await PersistAgeAsync();
        await LoadVacanciesAsync();
    }

    private async Task OnMinWageChanged(ChangeEventArgs e)
    {
        _minHourlyWage = TryParseWage(e.Value?.ToString());
        await LoadVacanciesAsync();
    }

    private async Task OnMaxWageChanged(ChangeEventArgs e)
    {
        _maxHourlyWage = TryParseWage(e.Value?.ToString());
        await LoadVacanciesAsync();
    }

    private async Task PersistAgeAsync()
    {
        try
        {
            if (_ageYears is int age)
            {
                await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", age);
            }
            else
            {
                await Js.InvokeVoidAsync("jobsyGeo.clearStoredAge");
            }
        }
        catch
        {
            // ignore storage failures
        }

        if (!_isCandidate)
        {
            return;
        }

        try
        {
            var profile = await Api.GetMyProfileAsync();
            var prefs = profile?.Preferences ?? _candidatePrefs ?? new CandidatePreferences();
            prefs.AgeYears = _ageYears;
            _candidatePrefs = prefs;
            await Api.UpdateMyProfileAsync(preferences: prefs);
        }
        catch
        {
            // profile persist is best-effort
        }
    }

    private static decimal? TryParseWage(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        if (decimal.TryParse(raw, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var value)
            || decimal.TryParse(raw, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.CurrentCulture, out value))
        {
            return value < 0 ? null : value;
        }

        return null;
    }

    private static int AgeFromDob(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age))
        {
            age--;
        }

        return Math.Clamp(age, 15, 67);
    }

