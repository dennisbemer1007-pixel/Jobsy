    private string? FormatWage(VacancyListItem vacancy)
    {
        if (!vacancy.WageVisible)
        {
            return null;
        }

        // Without an age filter, never show wages (list must match map popups).
        if (_ageYears is not int age)
        {
            return null;
        }

        if (vacancy.HourlyWage is not null)
        {
            return $"€ {vacancy.HourlyWage.Value:0.00}{Culture["Wage.PerHour"]}";
        }

        if (vacancy.WageByAge is { Count: > 0 })
        {
            var band = vacancy.WageByAge
                .Where(b => b.AgeYears <= age)
                .OrderByDescending(b => b.AgeYears)
                .FirstOrDefault()
                ?? vacancy.WageByAge.OrderBy(b => b.AgeYears).First();
            return $"€ {band.HourlyRate:0.00}{Culture["Wage.PerHour"]}";
        }

        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _mapHostReady = true;
        if (firstRender)
        {
            _ = WarmDiscoveryScriptsAsync();
            // Measure the viewport before MapLibre so desktop cards never wait on the map.
            await MeasureViewportAsync();
            await HydrateWeergaveAsync();
            if (!(_desktopListMode && _wideViewport))
            {
                await TryInitJobMapAsync();
            }
        }

        await EnsureDiscoveryHoverAsync();
        if (HasMoreVacancyCards && _dotNetRef is not null && !_disposed && ShouldRenderVacancyCards)
        {
            try
            {
                await Js.InvokeVoidAsync(
                    "jobsyDiscovery.observeMore",
                    _moreCardsSentinel,
                    _dotNetRef,
                    nameof(ShowMoreVacancyCardsFromJs));
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
        else if (_dotNetRef is not null && !_disposed)
        {
            try
            {
                await Js.InvokeVoidAsync("jobsyDiscovery.disconnect");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (!_launchHydrationDone)
        {
            var jsReady = true;
            try
            {
                _highlightShuffleSeed = await Js.InvokeAsync<uint>("jobsyGeo.getOrCreateHighlightSeed");
            }
            catch (JSException)
            {
                jsReady = false;
            }
            catch (InvalidOperationException)
            {
                jsReady = false;
            }
            catch
            {
                _highlightShuffleSeed = (uint)Random.Shared.NextInt64(0, uint.MaxValue);
            }

            if (jsReady)
            {
                try
                {
                    // Candidate age comes from profile (DOB). Only use localStorage for anonymous / no DOB.
                    if (_ageYears is null)
                    {
                        var storedAge = await Js.InvokeAsync<int?>("jobsyGeo.getStoredAge");
                        if (storedAge is int age)
                        {
                            _ageYears = NormalizeFilterAge(age);
                            // Do not prefill min wage from WML — user sets wage filters explicitly.
                        }
                    }
                    else
                    {
                        await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", _ageYears.Value);
                    }

                    await ResolveLaunchOriginAsync();

                    _launchHydrationDone = true;
                    if (_origin is not null || _ageYears is not null)
                    {
                        await LoadVacanciesAsync();
                    }
                }
                catch (JSException)
                {
                    // Keep going — map init must not wait on geo helpers.
                }
                catch (InvalidOperationException)
                {
                    // Keep going — map init must not wait on geo helpers.
                }
                catch
                {
                    _launchHydrationDone = true;
                }
            }
        }
    }

