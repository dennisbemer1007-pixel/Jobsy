    private async Task ClearSearchQueryAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchQuery = null;
        _searchDraft = null;
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var parsed = QueryHelpers.ParseQuery(uri.Query);
        if (parsed.ContainsKey("q"))
        {
            var parts = new List<string>();
            foreach (var kv in parsed)
            {
                if (string.Equals(kv.Key, "q", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                foreach (var value in kv.Value)
                {
                    parts.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
                }
            }

            var next = parts.Count == 0 ? uri.AbsolutePath : $"{uri.AbsolutePath}?{string.Join("&", parts)}";
            Navigation.NavigateTo(next, forceLoad: false);
            return;
        }

        await ReloadFiltersIfAppliedAsync();
    }

