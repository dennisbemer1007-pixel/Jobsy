        {
            // Do not auto-fill min wage from WML — wage filters stay empty until the user sets them.
            _ageYears = NormalizeFilterAge(age);
        }

        if (!_filtersOpen)
        {
            await PersistAgeAsync();
        }

        await ReloadFiltersIfAppliedAsync();
    }

    private async Task OnMinWageChanged(ChangeEventArgs e)
    {
        _minHourlyWage = TryParseWage(e.Value?.ToString());
        await ReloadFiltersIfAppliedAsync();
    }

    private async Task OnMaxWageChanged(ChangeEventArgs e)
