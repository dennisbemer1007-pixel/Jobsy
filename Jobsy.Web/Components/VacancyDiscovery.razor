        }
    }

    private async Task TryInitJobMapAsync()
    {
        try
        {
            await MapScripts.EnsureDiscoveryAsync(Js);
        }
        catch (JSException)
        {
            return;
        }
        catch (InvalidOperationException)
        {
            return;
        }

        if (_mapReady)
        {
            try
            {
                var alive = await Js.InvokeAsync<bool>("jobMap.isAlive");
                if (!alive)
                {
                    _mapReady = false;
                    _mapInitScheduled = false;
                }
            }
            catch (JSException)
            {
                // Missing isAlive (cached jobMap.js) or transient interop — do not tear down a live map.
            }
            catch (InvalidOperationException)
            {
                // Circuit not ready — keep current map state.
            }
        }

        if (_mapReady || _mapInitScheduled)
        {
            return;
        }

        _mapInitScheduled = true;

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var markers = BuildMarkers();
            var opening = ResolveOpeningView();
            var preferFilledLocation = !HasCompanyMapFocus;
            var options = new Dictionary<string, object?>
            {
                ["dotNetRef"] = _dotNetRef,
                ["travel"] = TravelMapOptions(),
                ["highlightSeed"] = _highlightShuffleSeed,
                ["preferFilledLocation"] = preferFilledLocation,
                ["view"] = new Dictionary<string, object?>
                {
                    ["lat"] = opening.CenterLat,
                    ["lng"] = opening.CenterLng,
                    ["zoom"] = opening.Zoom
                }
            };
            if (_origin is not null)
            {
                options["origin"] = new Dictionary<string, object?>
                {
                    ["lat"] = _origin.Latitude,
                    ["lng"] = _origin.Longitude,
                    ["zoom"] = VacancyMapViewCalculator.FilledLocationZoom
                };
            }

            await Js.InvokeVoidAsync("jobMap.init", "job-map", markers, options);
            _mapReady = true;
            _mapPainted = true;
            await InvokeAsync(StateHasChanged);
            await TryFocusCompanyOnMapAsync();
        }
        catch (JSDisconnectedException)
        {
            _mapInitScheduled = false;
        }
        catch (InvalidOperationException)
        {
            _mapInitScheduled = false;
        }
        catch (JSException)
        {
            _mapInitScheduled = false;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _mapInitScheduled = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadVacanciesAsync(CancellationToken ct = default)
    {
        var generation = ++_loadGeneration;
        var hadResults = _vacancies.Count > 0;
        var canceled = false;
        _loading = !hadResults;
        _error = null;
        if (!hadResults)
        {
            await InvokeAsync(StateHasChanged);
        }
        try
        {
            // Raamflyer deep-links must show the vestiging even when the visitor's
            // travel/profile filters would otherwise hide those jobs.
            var companyFocus = _companyFocusIds is { Count: > 0 } || _myVacanciesOnly;
            var queryCompanyFocus = !_myVacanciesOnly && _queryCompanyFocusIds is { Count: > 0 };
            var useOrigin = _origin is not null && !companyFocus;
            var items = await Api.DiscoverVacanciesAsync(
                useOrigin ? _origin!.Latitude : null,
                useOrigin ? _origin!.Longitude : null,
                _selectedTransport,
                _maxTravelMinutes,
                useOrigin ? _radiusKm : null,
                companyFocus ? null : _ageYears,
                companyFocus || _ageYears is null ? null : _minHourlyWage,
                companyFocus || _ageYears is null ? null : _maxHourlyWage,
                companyFocus || _selectedWorkTypes.Count == 0 ? null : _selectedWorkTypes,
                companyFocus ? null : _searchQuery,
                companyFocus ? null : _minHoursPerWeek,
                companyFocus ? null : _maxHoursPerWeek,
                companyFocus || _selectedCategoryIds.Count == 0 ? null : _selectedCategoryIds,
                suitableFor65Plus: null,
                companyIds: _companyFocusIds,
                ct: ct);

            if (generation != _loadGeneration)
            {
                return;
            }

            // Stale/far stored origin + default proximity can wipe the catalog; show all until filters tighten.
            if (items.Count == 0 && ShouldFallbackFromEmptyProximity && !companyFocus)
            {
                items = await Api.DiscoverVacanciesAsync(
                    originLat: null,
                    originLng: null,
                    _selectedTransport,
                    _maxTravelMinutes,
                    radiusKm: null,
                    _ageYears,
                    _ageYears is null ? null : _minHourlyWage,
                    _ageYears is null ? null : _maxHourlyWage,
                    _selectedWorkTypes.Count == 0 ? null : _selectedWorkTypes,
                    _searchQuery,
                    _minHoursPerWeek,
                    _maxHoursPerWeek,
                    _selectedCategoryIds.Count == 0 ? null : _selectedCategoryIds,
                    suitableFor65Plus: null,
                    companyIds: _companyFocusIds,
                    ct: ct);

                if (generation != _loadGeneration)
                {
                    return;
                }
            }

            _vacancies = items.ToList();
            _visibleCardCount = VacancyCardPageSize;
            if (_myVacanciesOnly)
            {
                _vacancies = _myVacancyIds is { Count: > 0 }
                    ? _vacancies.Where(v => _myVacancyIds.Contains(v.Id)).ToList()
                    : [];
            }
            else if (companyFocus)
            {
                _vacancies = _companyFocusIds is { Count: > 0 }
                    ? _vacancies
                        .Where(v => _companyFocusIds.Contains(v.CompanyId))
                        .ToList()
                    : [];

                // Scenario A: exactly one open vacancy at the focused vestiging → open detail + apply.
                if (queryCompanyFocus && _companyFocusIds!.Count == 1 && _vacancies.Count == 1)
                {
                    Navigation.NavigateTo($"/vacancies/{_vacancies[0].Id:D}", replace: true);
                    return;
                }
            }

            // Paint map markers immediately; impressions are fire-and-forget analytics.
            if (_mapReady)
            {
                await Js.InvokeVoidAsync("jobMap.setVacancies", BuildMarkers());
                if (_origin is not null && _companyFocusIds is null)
                {
                    await Js.InvokeVoidAsync("jobMap.setOrigin", _origin.Latitude, _origin.Longitude, TravelMapOptions());
                }
                else
                {
                    await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions());
                }

                _mapPainted = true;
                await InvokeAsync(StateHasChanged);
                _ = RefreshMapSizeAsync();
                _ = TryFocusCompanyOnMapAsync();
            }
            else
            {
                _pendingCompanyMapFocus = _mapFocusCompanyId is not null;
            }

            if (_vacancies.Count > 0)
            {
                _mapPainted = true;
                _ = RecordImpressionsSafeAsync();
            }
            else if (_mapView is { PinCount: > 0 })
            {
                _mapPainted = true;
            }
        }
        catch (OperationCanceledException)
        {
            canceled = true;
            if (generation != _loadGeneration)
            {
                return;
            }
        }
        catch (Exception ex)
        {
            if (generation != _loadGeneration)
            {
                return;
            }

            Logger.LogWarning(ex, "Vacancy discovery failed to load the public catalog.");
            _error = Culture["Discovery.LoadFailed"];
            if (!hadResults)
            {
                _vacancies = [];
            }
        }
        finally
        {
            if (generation == _loadGeneration && !canceled)
            {
                _loading = false;
            }
        }

        if (generation == _loadGeneration && !_mapReady && !_mapInitScheduled)
        {
            if (_mapHostReady)
            {
                await TryInitJobMapAsync();
            }

            if (!_mapReady)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RecordImpressionsSafeAsync()
    {
        try
        {
            await Api.RecordImpressionsAsync(Js, _vacancies.Select(v => v.Id));
        }
        catch
        {
            // Analytics must not block discovery.
        }
    }

    private async Task RefreshMapSizeAsync()
    {
        try
        {
            await Task.Delay(80);
            await Js.InvokeVoidAsync("jobMap.invalidate");
        }
        catch
        {
            // Map may have been disposed during navigation.
        }
    }

    private async Task LoadMapViewAsync(CancellationToken ct = default)
    {
        try
        {
            var dto = await Api.GetVacancyMapViewAsync(ct);
            if (dto is null
                || dto.PinCount <= 0
                || !double.IsFinite(dto.Lat)
                || !double.IsFinite(dto.Lng)
                || !double.IsFinite(dto.Zoom))
            {
                return;
            }

            _mapView = new VacancyMapView(dto.Lat, dto.Lng, dto.Zoom, dto.PinCount);
            _mapPainted = true;
        }
        catch
        {
            // Opening view can fall back to pin centroid in MapBootPinsJson.
        }
    }

    private bool HasCompanyMapFocus =>
        _mapFocusCompanyId is not null || _companyFocusIds is { Count: > 0 };

    private VacancyMapView PinCentroidOpeningView()
    {
        if (_mapView is { PinCount: > 0 } stored)
        {
            return stored;
        }

        return VacancyMapViewCalculator.FromPoints(
            _vacancies
                .Where(v => double.IsFinite(v.Latitude) && double.IsFinite(v.Longitude))
                .Select(v => (v.Latitude, v.Longitude)));
    }

    /// <summary>
    /// Prefer the filled current location (search origin) as map center; else the
    /// region-host kaartfocus; else the existing vacancy-pin centroid.
    /// Company deep-links keep the pin/company camera.
    /// </summary>
    private VacancyMapView ResolveOpeningView()
    {
        var region = RegionHost.Current;
        return VacancyMapViewCalculator.ResolveOpening(
            PinCentroidOpeningView(),
            _origin?.Latitude,
            _origin?.Longitude,
            region?.Latitude,
            region?.Longitude,
            HasCompanyMapFocus,
            _maxTravelMinutes,
            _selectedTransport,
            _radiusKm);
    }

    private string MapBootPinsJson()
    {
        var opening = ResolveOpeningView();
        var pins = _vacancies
            .Where(v => double.IsFinite(v.Latitude) && double.IsFinite(v.Longitude))
            .Select(v =>
            {
                var typeBadge = ResolveTypeBadge(v);
                return new Dictionary<string, object?>
                {
                    ["id"] = v.Id.ToString("D"),
                    ["title"] = v.Title,
                    ["company"] = v.CompanyName,
                    ["address"] = v.CompanyAddress,
                    ["lat"] = v.Latitude,
                    ["lng"] = v.Longitude,
                    ["highlighted"] = v.IsHighlighted,
                    ["workType"] = v.WorkTypes.FirstOrDefault() ?? "",
                    ["categoryColor"] = ShowsSuitableFor65Plus(v)
                        ? VacancyCategoryDefaults.SeniorPlusColorHex
                        : v.CategoryColorHex,
                    ["typeBadgeLabel"] = typeBadge.Label,
                    ["typeBadgeColor"] = typeBadge.ColorHex
                };
            })
            .ToList();
        var payload = new Dictionary<string, object?>
        {
            ["preferFilledLocation"] = !HasCompanyMapFocus,
            ["view"] = new Dictionary<string, object?>
            {
                ["lat"] = opening.CenterLat,
                ["lng"] = opening.CenterLng,
                ["zoom"] = opening.Zoom
            },
            ["pins"] = pins
        };
        return JsonSerializer.Serialize(payload).Replace("<", "\\u003c", StringComparison.Ordinal);
    }

    private List<Dictionary<string, object?>> BuildMarkers() =>
        _vacancies.Select(v =>
        {
            var primaryType = v.WorkTypes.FirstOrDefault() ?? "";
            var typeBadge = ResolveTypeBadge(v);
            var dict = new Dictionary<string, object?>
            {
                ["id"] = v.Id.ToString(),
                ["title"] = v.Title,
                ["company"] = v.CompanyName,
                ["companyId"] = v.CompanyId.ToString("D"),
                ["companyHref"] = !string.IsNullOrWhiteSpace(v.KvkNumber) && !string.IsNullOrWhiteSpace(v.Vestigingsnummer)
                    ? $"/{v.KvkNumber}/{v.Vestigingsnummer}"
                    : null,
                ["offeredBy"] = v.OfferedByLabel,
                ["address"] = v.CompanyAddress,
                ["logoUrl"] = VacancyImageUrls.Normalize(v.CompanyLogoUrl),
                ["imageUrl"] = VacancyImageUrls.Resolve(v.ImageUrl, v.CompanyLogoUrl, v.Id, v.WorkTypes.FirstOrDefault()),
                ["lat"] = v.Latitude,
                ["lng"] = v.Longitude,
                ["transport"] = v.RequiredTransport,
                ["workTypes"] = v.WorkTypes,
                ["workType"] = primaryType,
                ["categoryId"] = v.CategoryId?.ToString("D"),
                ["categoryName"] = v.CategoryName,
                ["categoryColor"] = ShowsSuitableFor65Plus(v)
                    ? VacancyCategoryDefaults.SeniorPlusColorHex
                    : v.CategoryColorHex,
                ["suitableFor65Plus"] = ShowsSuitableFor65Plus(v),
                ["suitableFor65PlusLabel"] = VacancyCategoryDefaults.SuitableFor65PlusLabel,
                ["suitableFor65PlusColor"] = VacancyCategoryDefaults.SeniorPlusColorHex,
                ["typeBadgeLabel"] = typeBadge.Label,
                ["typeBadgeColor"] = typeBadge.ColorHex,
                ["pushBomActive"] = false,
                ["highlighted"] = v.IsHighlighted,
                ["highlightRank"] = v.IsHighlighted ? HighlightShuffleRank(v.Id) : 0u,
                ["featuredLabel"] = Culture["Discovery.Featured"],
                ["exclusivityBadge"] = !v.ExclusivityIsOpen
                    && string.Equals(v.Kind, "Internship", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(v.ExclusivityName)
                    ? v.ExclusivityName
                    : null,
                ["travelMinutes"] = v.TravelMinutes,
                ["transportLabel"] = UiLabels.TransportVerb(Culture, _selectedTransport)
            };
            if (v.WageVisible)
            {
                if (_ageYears is int age)
                {
                    // Show the resolved hourly rate inline when an age filter is active.
                    if (v.HourlyWage is not null)
                    {
                        dict["wage"] = (double)v.HourlyWage.Value;
                    }
                    else if (v.WageByAge is { Count: > 0 })
                    {
                        var band = v.WageByAge
                            .Where(b => b.AgeYears <= age)
                            .OrderByDescending(b => b.AgeYears)
                            .FirstOrDefault()
                            ?? v.WageByAge.OrderBy(b => b.AgeYears).First();
                        dict["wage"] = (double)band.HourlyRate;
                    }
                }
                else if (v.HourlyWage is not null && (v.WageByAge is null || v.WageByAge.Count == 0))
                {
                    dict["wage"] = (double)v.HourlyWage.Value;
                }

                // Full age table stays behind the popup "i" info control (not inline).
                if (v.WageByAge is { Count: > 0 })
                {
                    dict["wageBands"] = v.WageByAge
                        .OrderBy(b => b.AgeYears)
                        .Select(b => new Dictionary<string, object?>
                        {
                            ["ageYears"] = b.AgeYears,
                            ["hourlyRate"] = (double)b.HourlyRate,
                            ["label"] = b.Label
                        })
                        .ToList();
                }
            }
            else
            {
                dict["wageLabel"] = WageVisibilityRules.MissingDateOfBirthMessage;
            }

            return dict;
        }).ToList();

