@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject ILogger<VacancyDiscovery> Logger
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject Jobsy.Web.RegionHosting.RegionHostState RegionHost
@inject MatchVacancyService MatchVacancies
@inject CandidateMatchProfileService MatchProfile
@implements IAsyncDisposable
@using Jobsy.Core.Contracts
@using Jobsy.Core.Media
@using Jobsy.Core.Rules
@using Jobsy.Web.Components.Discovery
@using Jobsy.Web.Components.KandidaatBanen
@using Jobsy.Web.KandidaatBanen
@using Jobsy.Web.Components.Match
@using Jobsy.Web.Hosting
@using Jobsy.Web.Models
@using Jobsy.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json

<PageSeo JsonLd="@JobListJsonLd" />
<HeadContent>
    <script src="js/discoveryHover.js?v=20261002-kp01m" defer data-discovery-hover="true"></script>
</HeadContent>
<div class="jobsy-discovery @(showMapOnMobile ? "show-map" : "show-list") @(_filtersOpen ? "filters-open" : null) @(_desktopListMode && _wideViewport ? "jobsy-discovery--list" : null)">
    <div class="jobsy-chrome">
        <header class="jobsy-chrome__header">
            <a class="jobsy-logo" href="/" aria-label="Lobsy">
                <LobsyLogo Class="jobsy-logo__img" Alt="Lobsy" />
                <span class="jobsy-logo__mark">Lobsy</span>
            </a>
            <h1 class="visually-hidden">@Culture["Seo.HomeHeading"]</h1>
            <div class="jobsy-chrome__header-actions">
                <PageHelp />
                <NotificationBell />
                <LanguageSelector />
                <AuthHeader />
            </div>
        </header>

        @* Address lives in the start prompt (mobile) / desktop toolbar — not in the filter bar. *@
        <div class="jobsy-chrome__search kb-chrome-search kb-chrome-search--address" hidden>
            <KbAddressField InputId="discovery-address"
                            Placeholder="@Culture["Discovery.AddressPlaceholder"]"
                            Query="@_addressQuery"
                            QueryChanged="OnAddressQueryChanged"
                            OnQueryInput="OnAddressInputAsync"
                            Suggestions="_suggestions"
                            Suggesting="_suggesting"
                            @bind-ShowSuggestions="_showSuggestions"
                            OriginSet="@(_origin is not null)"
                            Locating="_locating"
                            OnLocate="RequestLocationAsync"
                            OnClear="ClearOriginAsync"
                            OnSelect="SelectSuggestionAsync" />
            @if (!string.IsNullOrEmpty(_locationError))
            {
                <p class="state-message error filter-bar__error">@_locationError</p>
            }
        </div>

        <div class="kb-filter-bar" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <div class="kb-filter-bar__row">
                <div class="kb-chrome-search kb-filter-search kb-filter-search--bar">
                    <label class="visually-hidden" for="discovery-keyword-mobile">@Culture["Discovery.Keyword"]</label>
                    <input id="discovery-keyword-mobile"
                           type="search"
                           autocomplete="off"
                           data-testid="kb-keyword-search"
                           placeholder="@Culture["Kb.Filter.KeywordPlaceholder"]"
                           value="@(_searchDraft ?? _searchQuery ?? "")"
                           @oninput="OnSearchInput"
                           @onkeydown="OnSearchKeyDown" />
                </div>
                <button type="button"
                        class="kb-filters-button @(_filtersOpen ? "is-active" : null)"
                        data-testid="kb-filters-button"
                        @onclick="ToggleFilters"
                        aria-expanded="@(_filtersOpen ? "true" : "false")"
                        aria-controls="@(_filtersOpen ? "discovery-filters" : null)"
                        aria-label="@Culture["Kb.Filter.FiltersAria"]">
                    <span class="kb-filters-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                    <span>@Culture["Discovery.Filters"]</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="jobsy-action__badge" data-testid="kb-filters-badge">@ActiveFilterCount</span>
                    }
                </button>
            </div>

            <div class="kb-filter-bar__row">
                <div class="kb-filter-chips__travel">
                    <button type="button"
                            class="kb-chip @(_travelChipOpen ? "is-open" : null) @(_maxTravelMinutes != _filterDefaults.MaxTravelMinutes || _selectedTransport != _filterDefaults.Transport ? "is-active" : null)"
                            data-testid="kb-travel-chip"
                            aria-expanded="@(_travelChipOpen ? "true" : "false")"
                            aria-label="@Culture["Kb.Filter.TravelAria"]"
                            @onclick="ToggleTravelChip">
                        <span>@TravelChipLabel</span>
                        <span aria-hidden="true">▾</span>
                    </button>
                    @if (_travelChipOpen)
                    {
                        <div class="kb-chip-popover" role="dialog" data-testid="kb-travel-popover">
                            <div class="kb-chip-popover__modes" role="group" aria-label="@Culture["Discovery.Transport"]">
                                @foreach (var mode in TravelChipModes)
                                {
                                    <button type="button"
                                            class="kb-chip-preset @(string.Equals(_selectedTransport, mode, StringComparison.Ordinal) ? "is-selected" : null)"
                                            @onclick="() => SetTravelPresetAsync(mode, _maxTravelMinutes)">
                                        @UiLabels.Transport(Culture, mode)
                                    </button>
                                }
                            </div>
                            <div class="kb-chip-popover__minutes" role="group" aria-label="@Culture["Discovery.TravelMinutes"]">
                                @foreach (var m in TravelChipMinutes)
                                {
                                    <button type="button"
                                            class="kb-chip-preset @(_maxTravelMinutes == m ? "is-selected" : null)"
                                            @onclick="() => SetTravelPresetAsync(_selectedTransport, m)">
                                        @Culture.Format("Kb.Filter.MinutesPreset", m)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <a class="kb-match-button jobsy-action--match"
                   data-testid="kb-match-button"
                   href="@MatchButtonHref">
                    <span class="kb-match-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Match)</span>
                    <span>@Culture["Nav.Match"]</span>
                </a>

                <span class="kb-filter-bar__spacer" aria-hidden="true"></span>

                <button type="button"
                        class="kb-chip kb-chip--toggle"
                        data-testid="kb-view-toggle"
                        data-kb-mobile-view-toggle="kb-mobile-view-toggle"
                        @onclick="ToggleMobileView">
                    @(showMapOnMobile ? Culture["Discovery.List"] : Culture["Discovery.Map"])
                </button>
            </div>
        </div>
    </div>

    <aside class="vacancy-pane">
        <div class="discovery-toolbar discovery-toolbar--desktop kb-desktop-toolbar" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <KbAddressField InputId="discovery-address-desktop"
                            CssClass="discovery-toolbar__address"
                            Label="@Culture["Discovery.Address"]"
                            Placeholder="@Culture["Discovery.AddressPlaceholder"]"
                            Query="@_addressQuery"
                            QueryChanged="OnAddressQueryChanged"
                            OnQueryInput="OnAddressInputAsync"
                            Suggestions="_suggestions"
                            Suggesting="_suggesting"
                            @bind-ShowSuggestions="_showSuggestions"
                            OriginSet="@(_origin is not null)"
                            Locating="_locating"
                            OnLocate="RequestLocationAsync"
                            OnClear="ClearOriginAsync"
                            OnSelect="SelectSuggestionAsync" />
            @if (!string.IsNullOrEmpty(_locationError))
            {
                <p class="state-message error filter-bar__error">@_locationError</p>
            }

            <div class="kb-filter-chips kb-filter-chips--desktop">
                <div class="kb-filter-chips__travel">
                    <button type="button"
                            class="kb-chip @(_travelChipOpen ? "is-open" : null)"
                            data-testid="kb-travel-chip"
                            aria-expanded="@(_travelChipOpen ? "true" : "false")"
                            aria-label="@Culture["Kb.Filter.TravelAria"]"
                            @onclick="ToggleTravelChip">
                        <span>@TravelChipLabel</span>
                        <span aria-hidden="true">▾</span>
                    </button>
                    @if (_travelChipOpen)
                    {
                        <div class="kb-chip-popover" role="dialog" data-testid="kb-travel-popover">
                            <div class="kb-chip-popover__modes" role="group" aria-label="@Culture["Discovery.Transport"]">
                                @foreach (var mode in TravelChipModes)
                                {
                                    <button type="button"
                                            class="kb-chip-preset @(string.Equals(_selectedTransport, mode, StringComparison.Ordinal) ? "is-selected" : null)"
                                            @onclick="() => SetTravelPresetAsync(mode, _maxTravelMinutes)">
                                        @UiLabels.Transport(Culture, mode)
                                    </button>
                                }
                            </div>
                            <div class="kb-chip-popover__minutes" role="group" aria-label="@Culture["Discovery.TravelMinutes"]">
                                @foreach (var m in TravelChipMinutes)
                                {
                                    <button type="button"
                                            class="kb-chip-preset @(_maxTravelMinutes == m ? "is-selected" : null)"
                                            @onclick="() => SetTravelPresetAsync(_selectedTransport, m)">
                                        @Culture.Format("Kb.Filter.MinutesPreset", m)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="kb-chip @(_selectedWorkTypes.Count > 0 ? "is-active" : null)" @onclick="ToggleFilters">
                    @Culture["Kb.Filter.WorkType"]
                </button>
                <button type="button"
                        class="kb-chip @(_minHoursPerWeek != _filterDefaults.MinHoursPerWeek || _maxHoursPerWeek != _filterDefaults.MaxHoursPerWeek ? "is-active" : null)"
                        @onclick="ToggleHoursChip">
                    @Culture["Kb.Filter.Hours"]
                </button>
                <button type="button"
                        class="kb-chip @(_minHourlyWage is not null || _maxHourlyWage is not null ? "is-active" : null)"
                        @onclick="ToggleWageChip">
                    @Culture["Kb.Filter.Wage"]
                </button>

                <label class="kb-filter-search kb-filter-search--desktop">
                    <span class="visually-hidden">@Culture["Discovery.Keyword"]</span>
                    <input type="search"
                           autocomplete="off"
                           placeholder="@Culture["Kb.Filter.KeywordPlaceholder"]"
                           value="@(_searchDraft ?? _searchQuery ?? "")"
                           @oninput="OnSearchInput"
                           @onkeydown="OnSearchKeyDown" />
                </label>

                <button type="button"
                        class="kb-filters-button @(_filtersOpen ? "is-active" : null)"
                        data-testid="kb-filters-button"
                        @onclick="ToggleFilters"
                        aria-expanded="@(_filtersOpen ? "true" : "false")"
                        aria-controls="discovery-filters-desktop"
                        aria-label="@Culture["Kb.Filter.FiltersAria"]">
                    <span class="kb-filters-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                    <span>@Culture["Discovery.Filters"]</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="jobsy-action__badge" data-testid="kb-filters-badge">@ActiveFilterCount</span>
                    }
                </button>
                @if (ActiveFilterCount > 0)
                {
                    <button type="button" class="kb-chip kb-chip--clear" @onclick="ClearAllFiltersAsync">
                        @Culture["Kb.Filter.Clear"]
                    </button>
                }

                <a class="kb-match-button jobsy-action--match"
                   data-testid="kb-match-button"
                   href="@MatchButtonHref">
                    <span class="kb-match-button__icon" aria-hidden="true">@((MarkupString)NavIcons.Match)</span>
                    <span>@Culture["Nav.Match"]</span>
                </a>

                <div class="kb-view-toggle"
                     role="radiogroup"
                     aria-label="@Culture["Kb.View.ToggleAria"]"
                     data-testid="kb-view-toggle">
                    <button type="button"
                            class="kb-view-toggle__btn @(!_desktopListMode ? "is-active" : null)"
                            role="radio"
                            aria-checked="@(!_desktopListMode ? "true" : "false")"
                            data-testid="kb-view-kaart"
                            @onclick="() => SetDesktopViewAsync(list: false)">
                        @Culture["Kb.View.Map"]
                    </button>
                    <button type="button"
                            class="kb-view-toggle__btn @(_desktopListMode ? "is-active" : null)"
                            role="radio"
                            aria-checked="@(_desktopListMode ? "true" : "false")"
                            data-testid="kb-view-lijst"
                            @onclick="() => SetDesktopViewAsync(list: true)">
                        @Culture["Kb.View.List"]
                    </button>
                </div>
            </div>

            @if (_hoursChipOpen)
            {
                <div class="kb-chip-popover kb-chip-popover--inline" role="dialog">
                    <button type="button" class="kb-chip-preset" @onclick="() => SetHoursPresetAsync(0, 16)">0–16</button>
                    <button type="button" class="kb-chip-preset" @onclick="() => SetHoursPresetAsync(16, 24)">16–24</button>
                    <button type="button" class="kb-chip-preset" @onclick="() => SetHoursPresetAsync(24, 32)">24–32</button>
                    <button type="button" class="kb-chip-preset" @onclick="() => SetHoursPresetAsync(32, 40)">32–40</button>
                    <button type="button" class="kb-chip-preset" @onclick="ToggleFilters">@Culture["Kb.Filter.Exact"]</button>
                </div>
            }
            @if (_wageChipOpen)
            {
                <div class="kb-chip-popover kb-chip-popover--inline" role="dialog">
                    <button type="button" class="kb-chip-preset" @onclick="ToggleFilters">@Culture["Kb.Filter.Exact"]</button>
                </div>
            }
        </div>

        <div id="discovery-filters-desktop"
             class="filter-bar filter-bar--desktop"
             aria-hidden="false">
                <label class="filter-bar__query">
                    @Culture["Discovery.Keyword"]
                    <input type="search"
                           autocomplete="off"
                           placeholder="@Culture["Discovery.KeywordPlaceholder"]"
                           value="@(_searchDraft ?? _searchQuery ?? "")"
                           @oninput="OnSearchInput"
                           @onkeydown="OnSearchKeyDown" />
                </label>
                <div class="branch-multiselect-field">
                    <span class="branch-multiselect-field__label">@Culture["Discovery.WorkType"]</span>
                    <div class="branch-multiselect @(_branchMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_branchMenuOpen ? "true" : "false")"
                                aria-controls="@(_branchMenuOpen ? "branch-multiselect-panel-desktop" : null)"
                                @onclick="ToggleBranchMenu">
                            <span class="branch-multiselect__value @(_selectedWorkTypes.Count > 0 ? "is-selected" : null)">@BranchFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_branchMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseBranchMenu"></button>
                            <div id="branch-multiselect-panel-desktop"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.WorkType"]">
                                @foreach (var label in _branchOptions)
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedWorkTypes.Contains(label)"
                                               @onchange="e => ToggleWorkTypeAsync(label, e)" />
                                        @UiLabels.WorkType(Culture, label)
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="branch-multiselect-field">
                    <span class="branch-multiselect-field__label">@Culture["Discovery.VacancyType"]</span>
                    <div class="branch-multiselect @(_categoryMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@(_categoryMenuOpen ? "true" : "false")"
                                aria-controls="@(_categoryMenuOpen ? "category-multiselect-panel-desktop" : null)"
                                @onclick="ToggleCategoryMenu">
                            <span class="branch-multiselect__value @(_selectedCategoryIds.Count > 0 ? "is-selected" : null)">@CategoryFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_categoryMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseCategoryMenu"></button>
                            <div id="category-multiselect-panel-desktop"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.VacancyType"]">
                                @foreach (var cat in _categories.Where(c => c.ShowInMapFilter && c.IsActive))
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedCategoryIds.Contains(cat.Id)"
                                               @onchange="e => ToggleCategoryAsync(cat.Id, e)" />
                                        <span class="category-filter__swatch" style="@KbCategoryColor.Style(cat.ColorHex)" aria-hidden="true"></span>
                                        <span>@cat.Name</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
                <label class="filter-required">
                    @Culture["Discovery.Age"]
                    <select value="@AgeSelectValue" @onchange="OnAgeChanged" required>
                        <option value="all">@Culture["Discovery.AgeAny"]</option>
                        @for (var age = 15; age <= 21; age++)
                        {
                            <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                        }
                    </select>
                </label>
                @if (_ageYears is not null)
                {
                    <label>
                        @Culture["Discovery.MinWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMinWageChanged" />
                    </label>
                    <label>
                        @Culture["Discovery.MaxWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMaxWageChanged" />
                    </label>
                }
                <label>
                    @Culture["Discovery.TravelMinutes"]
                    <input type="number" min="5" max="90" value="@_maxTravelMinutes"
                           @onchange="OnMaxMinutesChanged" />
                </label>
                <label class="hours-range-field">
                    <span>@Culture["Discovery.HoursSlider"]</span>
                    <HoursRangeSlider CssClass="hours-range--compact"
                                      Min="0"
                                      Max="40"
                                      Low="_minHoursPerWeek"
                                      High="_maxHoursPerWeek"
                                      LowChanged="OnMinHoursSliderValue"
                                      HighChanged="OnMaxHoursSliderValue"
                                      RangeCommitted="CommitHoursRangeAsync" />
                </label>
                <label>
                    @Culture["Discovery.Transport"]
                    <select value="@_selectedTransport" @onchange="OnTransportChanged">
                        <option value="Fiets">@Culture["Transport.Bike"]</option>
                        <option value="E-bike">@Culture["Transport.EBike"]</option>
                        <option value="Auto">@Culture["Transport.Car"]</option>
                        <option value="OV">@Culture["Transport.Transit"]</option>
                        <option value="Lopend">@Culture["Transport.Walk"]</option>
                    </select>
                </label>
                <label>
                    @Culture["Discovery.Radius"]
                    <input type="number" min="1" max="50" value="@_radiusKm"
                           @onchange="OnRadiusChanged" />
                </label>
                @if (_isCandidate && ShowFitFilters)
                {
                    <label>
                        @Culture["Discovery.MinMatch"]
                        <select value="@_minMatchPercent.ToString()" @onchange="OnMinMatchChanged">
                            <option value="0">@Culture["Discovery.MinMatchAny"]</option>
                            <option value="60">@Culture["Discovery.MinMatch60"]</option>
                            <option value="80">@Culture["Discovery.MinMatch80"]</option>
                        </select>
                    </label>
                }
                <div class="filter-bar__actions">
                    @if (_canShowMyVacancies)
                    {
                        <button type="button"
                                class="filter-bar__focus @(_myVacanciesOnly ? "is-active" : null)"
                                disabled="@_myVacanciesLoading"
                                @onclick="ToggleMyVacanciesAsync"
                                aria-pressed="@(_myVacanciesOnly ? "true" : "false")">
                            @MyVacanciesToggleLabel
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_myVacanciesError))
                    {
                        <p class="state-message error filter-bar__error">@_myVacanciesError</p>
                    }
                    @if (ActiveFilterCount > 0)
                    {
                        <button type="button"
                                class="filter-bar__clear"
                                title="@Culture["Discovery.ClearFilters"]"
                                @onclick="ClearAllFiltersAsync"
                                aria-label="@Culture["Discovery.ClearFilters"]">
                            <span class="filter-bar__clear-icon" aria-hidden="true">@((MarkupString)NavIcons.ClearFilters)</span>
                            <span>@Culture["Discovery.ClearFilters"]</span>
                        </button>
                    }
                    <button type="button" class="filter-bar__search" @onclick="ApplySearch">
                        @Culture["Discovery.Search"]
                    </button>
                </div>
            </div>

        @if (_loading && _vacancies.Count == 0)
        {
            <p class="state-message">@Culture["Discovery.Loading"]</p>
        }
        else if (!string.IsNullOrEmpty(_error) && _vacancies.Count == 0)
        {
            <p class="state-message error">@_error</p>
        }
        else if (_vacancies.Count == 0)
        {
            <p class="state-message">
                @if (_origin is null)
                {
                    @Culture["Discovery.NoneWithoutOrigin"]
                }
                else
                {
                    @Culture.Format("Discovery.NoneWithOrigin", _maxTravelMinutes, UiLabels.Transport(Culture, _selectedTransport))
                }
            </p>
        }
        else
        {
            <div class="@(_useListRows ? "kb-list-layout" : null)">
                <div class="@(_useListRows ? "kb-list-layout__main" : null)">
            <div class="results-meta">
                <div class="results-meta__text">
                    <p class="results-meta__count">
                        @if (_origin is not null)
                        {
                            @if (_desktopListMode && _wideViewport)
                            {
                                @Culture.Format("Kb.List.HeaderWithin", _vacancies.Count, _maxTravelMinutes, UiLabels.TransportVerb(Culture, _selectedTransport))
                            }
                            else
                            {
                                @Culture.Format("Kb.List.Header", _vacancies.Count, _maxTravelMinutes, UiLabels.TransportVerb(Culture, _selectedTransport))
                            }
                        }
                        else
                        {
                            @Culture.Format("Discovery.ResultCount", _vacancies.Count)
                        }
                    </p>
                    @if (_origin is not null && !string.IsNullOrWhiteSpace(_addressQuery) && _useListRows)
                    {
                        <p class="results-meta__sub muted">@Culture.Format("Kb.List.FromAddress", _addressQuery)</p>
                    }
                </div>
                <label class="results-meta__sort">
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                    <span class="visually-hidden">@Culture["Discovery.Sort"]</span>
                    <select class="results-meta__sort-select" value="@EffectiveSortMode" @onchange="OnSortChanged" data-testid="kb-list-sort">
                        @if (_isCandidate && ShowFitFilters)
                        {
                            <option value="match">@Culture["Kb.List.SortBest"]</option>
                        }
                        @if (_origin is not null)
                        {
                            <option value="distance">@Culture["Kb.List.SortNear"]</option>
                        }
                        <option value="type">@Culture["Kb.Filter.WorkType"]</option>
                        <option value="recent">@(_useListRows ? Culture["Kb.List.SortNew"] : Culture["Kb.Filter.SortStart"])</option>
                        <option value="title">@Culture["Discovery.SortAlphaAsc"]</option>
                        <option value="title-desc">@Culture["Discovery.SortAlphaDesc"]</option>
                    </select>
                </label>
            </div>
            @if (ShouldRenderVacancyCards)
            {
                @if (!_useListRows)
                {
                    <HighlightVacancyCarousel Vacancies="HighlightedVacanciesForUi"
                                              ActiveId="_hoveredId"
                                              ModifierClass="highlight-carousel--list"
                                              FormatTravel="FormatCarouselTravel"
                                              OnHover="OnHover"
                                              OnSelect="OnCarouselSelect" />
                    <div class="vacancy-list vacancy-list--cards">
                        @{
                            var cardIndex = 0;
                        }
                        @foreach (var vacancy in VisibleVacancies)
                        {
                            <VacancyCard @key="vacancy.Id"
                                         Vacancy="vacancy"
                                         IsHighlighted="vacancy.IsHighlighted"
                                         IsPressed="_pressedVacancyId == vacancy.Id"
                                         Eager="cardIndex == 0"
                                         WageText="@FormatWage(vacancy)"
                                         TravelText="@FormatCardTravel(vacancy)"
                                         OnSelect="OnSelect"
                                         OnOpen="OnOpenVacancy"
                                         OnExplainMatch="OpenMatchExplain" />
                            cardIndex++;
                        }
                        @if (HasMoreVacancyCards)
                        {
                            <div class="vacancy-list__more-sentinel"
                                 @ref="_moreCardsSentinel"
                                 aria-hidden="true"></div>
                        }
                    </div>
                }
                else
                {
                    <div class="kb-list-rows" data-testid="kb-list-rows">
                        @{
                            var rowIndex = 0;
                        }
                        @foreach (var vacancy in VisibleVacancies)
                        {
                            <KbListRow @key="vacancy.Id"
                                       Vacancy="vacancy"
                                       Compact="@(!_wideViewport)"
                                       IsPressed="_pressedVacancyId == vacancy.Id"
                                       Eager="rowIndex == 0"
                                       Transport="@_selectedTransport"
                                       TravelApprox="@(string.Equals(_selectedTransport, "OV", StringComparison.OrdinalIgnoreCase) || !string.Equals(_isoMode, "real", StringComparison.Ordinal))"
                                       WageText="@FormatWage(vacancy)"
                                       OnOpen="OnOpenVacancy" />
                            rowIndex++;
                        }
                        @if (HasMoreVacancyCards)
                        {
                            <div class="vacancy-list__more-sentinel"
                                 @ref="_moreCardsSentinel"
                                 aria-hidden="true"></div>
                        }
                    </div>
                }
                @if (HasMoreVacancyCards)
                {
                    <button type="button" class="vacancy-list__more" @onclick="ShowMoreVacancyCards">
                        @Culture.Format("Discovery.ShowResults", RemainingVacancyCardCount)
                    </button>
                }
            }
                </div>
                @if (_useListRows && _wideViewport && _desktopListMode)
                {
                    <aside class="kb-list-rail" data-testid="kb-list-rail" aria-label="@Culture["Kb.List.HowWeSort.Title"]">
                        <div class="kb-list-rail__card">
                            <h2 class="kb-list-rail__title">@Culture["Kb.List.RailTravel.Title"]</h2>
                            <div class="kb-list-rail__map" aria-hidden="true">
                                <div id="kb-list-rail-map" class="kb-list-rail__map-canvas" @ref="_listRailMapElement"></div>
                            </div>
                            @if (_origin is not null)
                            {
                                <p class="kb-list-rail__body">
                                    @Culture.Format(
                                        "Kb.List.RailTravel.Body",
                                        _maxTravelMinutes,
                                        UiLabels.TransportVerb(Culture, _selectedTransport),
                                        TravelChipLabel)
                                </p>
                                @if (string.Equals(_selectedTransport, "OV", StringComparison.OrdinalIgnoreCase)
                                    || !string.Equals(_isoMode, "real", StringComparison.Ordinal))
                                {
                                    <p class="kb-list-rail__body">@Culture["Kb.List.RailTravel.Approx"]</p>
                                }
                            }
                        </div>
                        <div class="kb-list-rail__card">
                            <h2 class="kb-list-rail__title">@Culture["Kb.List.HowWeSort.Title"]</h2>
                            <ul class="kb-list-rail__list">
                                <li>@Culture["Kb.List.HowWeSort.FitFirst"]</li>
                                <li>@Culture["Kb.List.HowWeSort.TravelNext"]</li>
                                <li>@Culture["Kb.List.HowWeSort.DislikesLower"]</li>
                            </ul>
                            <a class="kb-list-rail__link" href="@KbRoutes.PaspoortTests">@Culture["Kb.List.HowWeSort.Passport"]</a>
                        </div>
                    </aside>
                }
            </div>
        }
    </aside>

    <section class="map-pane" aria-label="@Culture["Page.JobMapTitle"]">
        @if (RendererInfo.IsInteractive && _mapPainted && (_vacancies.Count > 0 || ShowTopMatchTile))
        {
            <HighlightVacancyCarousel Vacancies="HighlightedVacanciesForUi"
                                      ActiveId="_hoveredId"
                                      ModifierClass="highlight-carousel--map"
                                      FormatTravel="FormatCarouselTravel"
                                      OnHover="OnHover"
                                      OnSelect="OnCarouselSelect"
                                      LeadingItem="@(ShowTopMatchTile ? TopMatchLeadingFragment : null)" />
        }
        <MatchDeckDialog Deck="_matchDeck"
                         IsOpen="_matchDialogOpen"
                         OnClose="CloseMatchDialogAsync" />
        @if (_showStartPrompt)
        {
            <div class="kb-start-prompt" role="dialog" aria-labelledby="kb-start-title">
                <h2 id="kb-start-title">@Culture["Kb.Start.Title"]</h2>
                <p class="kb-start-prompt__hint">@Culture["Kb.Start.Hint"]</p>
                <KbAddressField InputId="discovery-address-prompt"
                                Placeholder="@Culture["Kb.Start.AddressPlaceholder"]"
                                Query="@_addressQuery"
                                QueryChanged="OnAddressQueryChanged"
                                OnQueryInput="OnAddressInputAsync"
                                Suggestions="_suggestions"
                                Suggesting="_suggesting"
                                @bind-ShowSuggestions="_showSuggestions"
                                OriginSet="false"
                                ShowLocate="false"
                                OnSelect="SelectSuggestionAsync" />
                <div class="kb-start-prompt__actions">
                    <button type="button" class="kb-start-prompt__primary" disabled="@_locating" @onclick="RequestLocationAsync">
                        @Culture["Kb.Start.UseMyLocation"]
                    </button>
                    <button type="button" class="kb-start-prompt__later" @onclick="DismissStartPrompt">
                        @Culture["Kb.Start.Later"]
                    </button>
                </div>
            </div>
        }
        <div class="map-stage @(_mapPainted ? "is-live" : null)">
            <script type="application/json" id="jobsy-map-boot">@((MarkupString)MapBootPinsJson())</script>
            <div class="job-map-placeholder" aria-hidden="true"></div>
            <div @ref="_mapElement" id="job-map" class="job-map"></div>
            @if (_categories.Any(c => c.ShowInLegend && c.IsActive))
            {
                <aside class="kb-travel-legend" data-iso-mode="@_isoMode" aria-label="@Culture.Format("Kb.Legend.TravelTitle", UiLabels.TransportVerb(Culture, _selectedTransport))">
                    <p class="kb-travel-legend__title">@Culture.Format("Kb.Legend.TravelTitle", UiLabels.TransportVerb(Culture, _selectedTransport))</p>
                    <ul class="kb-travel-legend__rings">
                        <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--10"></span>@Culture.Format("Kb.Legend.RingMinutes", 10)</li>
                        <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--20"></span>@Culture.Format("Kb.Legend.RingMinutes", 20)</li>
                        <li><span class="kb-travel-legend__swatch kb-travel-legend__swatch--30"></span>@Culture.Format("Kb.Legend.RingMinutes", 30)</li>
                    </ul>
                    @if (string.Equals(_isoMode, "real", StringComparison.Ordinal))
                    {
                        <p class="kb-travel-legend__hint">@Culture["Kb.Legend.TravelReal"]</p>
                        <p class="kb-travel-legend__sub">@Culture["Kb.Legend.TravelRealHint"]</p>
                    }
                    else
                    {
                        <p class="kb-travel-legend__hint">@Culture["Kb.Legend.TravelApprox"]</p>
                        <p class="kb-travel-legend__sub">@Culture["Kb.Legend.TravelApproxHint"]</p>
                    }
                </aside>
                <div class="map-legend @(_legendOpen ? "is-open" : null)">
                    <button type="button"
                            class="map-legend__toggle"
                            aria-expanded="@(_legendOpen ? "true" : "false")"
                            aria-controls="map-legend-panel"
                            title="@(_legendOpen ? Culture["Kb.Legend.Hide"] : Culture["Kb.Legend.Title"])"
                            @onclick="ToggleLegend"
                            @onclick:stopPropagation="true"
                            @onpointerdown:stopPropagation="true">
                        <span class="map-legend__toggle-dots" aria-hidden="true">
                            @foreach (var cat in _categories.Where(c => c.ShowInLegend && c.IsActive).Take(4))
                            {
                                <i style="@KbCategoryColor.Style(cat.ColorHex)"></i>
                            }
                        </span>
                        <span class="visually-hidden">@(_legendOpen ? Culture["Kb.Legend.Hide"] : Culture["Kb.Legend.Show"])</span>
                    </button>
                    <aside id="map-legend-panel"
                           class="map-legend__panel"
                           hidden="@(!_legendOpen)"
                           aria-hidden="@(!_legendOpen ? "true" : "false")"
                           aria-label="@Culture["Kb.Legend.CategoriesAria"]">
                        <ul class="map-legend__list">
                            @foreach (var cat in _categories.Where(c => c.ShowInLegend && c.IsActive))
                            {
                                <li class="map-legend__item">
                                    <span class="map-legend__swatch" style="@KbCategoryColor.Style(cat.ColorHex)" aria-hidden="true"></span>
                                    <span>@cat.Name</span>
                                </li>
                            }
                        </ul>
                    </aside>
                </div>
            }
        </div>
    </section>

    @if (_filtersOpen)
    {
        <div class="filter-sheet-backdrop" @onclick="CloseFiltersAsync"></div>
        <div id="discovery-filters"
             class="filter-sheet"
             role="dialog"
             aria-modal="true"
             aria-labelledby="filter-sheet-title"
             data-testid="kb-filter-sheet">
            <div class="filter-sheet__header">
                <h2 id="filter-sheet-title">@Culture["Discovery.Filters"]</h2>
                <button type="button"
                        class="filter-sheet__clear-all"
                        data-testid="kb-filter-clear-all"
                        @onclick="ClearAllFiltersAsync">
                    @Culture["Kb.Filter.ClearAll"]
                </button>
                <button type="button"
                        class="filter-sheet__close"
                        @onclick="CloseFiltersAsync"
                        aria-label="@Culture["Common.Close"]">
                    <span aria-hidden="true">@((MarkupString)NavIcons.Close)</span>
                </button>
            </div>

            <div class="filter-sheet__body">
                @if (_canShowMyVacancies)
                {
                    <section class="filter-section filter-section--focus" data-filter-section="my-vacancies">
                        <h3>@Culture["Kb.MyVacancies.Show"]</h3>
                        <button type="button"
                                class="filter-sheet__focus @(_myVacanciesOnly ? "is-active" : null)"
                                disabled="@_myVacanciesLoading"
                                @onclick="ToggleMyVacanciesAsync"
                                aria-pressed="@(_myVacanciesOnly ? "true" : "false")">
                            @MyVacanciesToggleLabel
                        </button>
                        <p class="filter-section__hint">Toon alleen actieve open vacatures van bedrijven die jij beheert.</p>
                        @if (!string.IsNullOrWhiteSpace(_myVacanciesError))
                        {
                            <p class="state-message error">@_myVacanciesError</p>
                        }
                    </section>
                }

                <section class="filter-section" data-filter-section="keyword">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Search)</span>
                        @Culture["Kb.Filter.Keyword"]
                    </h3>
                    <label class="filter-sheet__query">
                        <span class="visually-hidden">@Culture["Kb.Filter.Keyword"]</span>
                        <input type="search"
                               autocomplete="off"
                               data-testid="kb-sheet-keyword"
                               placeholder="@Culture["Kb.Filter.SheetKeywordPlaceholder"]"
                               value="@(_searchDraft ?? _searchQuery ?? "")"
                               @oninput="OnSheetSearchInput"
                               @onkeydown="OnSearchKeyDown" />
                    </label>
                </section>

                <section class="filter-section" data-filter-section="travel">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Map)</span>
                        @Culture["Discovery.TravelSlider"]
                        <span class="filter-section__value">@Culture.Format("Kb.Filter.TravelValue", _maxTravelMinutes)</span>
                    </h3>
                    <div class="filter-sheet__presets" role="group" aria-label="@Culture["Discovery.TravelMinutes"]">
                        @foreach (var m in TravelChipMinutes)
                        {
                            <button type="button"
                                    class="filter-sheet__chip @(_maxTravelMinutes == m ? "is-selected" : null)"
                                    data-testid="kb-sheet-travel-@m"
                                    @onclick="() => SetSheetTravelMinutesAsync(m)">
                                @Culture.Format("Kb.Filter.MinutesPreset", m)
                            </button>
                        }
                    </div>
                    <div class="filter-sheet__slider">
                        <input type="range"
                               min="5"
                               max="90"
                               step="5"
                               value="@_maxTravelMinutes"
                               data-testid="kb-sheet-travel-slider"
                               aria-label="@Culture["Discovery.TravelSlider"]"
                               @oninput="OnTravelSliderInput"
                               @onchange="OnSheetTravelSliderChanged" />
                        <div class="filter-sheet__ticks" aria-hidden="true">
                            <span>5 min</span><span>30</span><span>60</span><span>90 min</span>
                        </div>
                    </div>
                    <p class="filter-section__hint">@Culture["Kb.Filter.TravelHow"]</p>
                    <div class="filter-sheet__modes" role="group" aria-label="@Culture["Kb.Filter.TravelHow"]">
                        @foreach (var mode in TravelChipModes)
                        {
                            <button type="button"
                                    class="filter-sheet__mode @(string.Equals(_selectedTransport, mode, StringComparison.Ordinal) ? "is-selected" : null)"
                                    data-testid="kb-sheet-transport-@mode"
                                    @onclick="() => SetSheetTransportAsync(mode)">
                                @UiLabels.Transport(Culture, mode)
                            </button>
                        }
                    </div>
                </section>

                @if (_isCandidate && ShowFitFilters)
                {
                    <section class="filter-section" data-filter-section="match">
                        <h3>
                            <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Match)</span>
                            @Culture["Kb.Filter.Match"]
                        </h3>
                        <p class="filter-section__hint">@Culture["Kb.Filter.MatchHint"]</p>
                        <div class="filter-sheet__seg" role="group" aria-label="@Culture["Kb.Filter.Match"]">
                            <button type="button"
                                    class="filter-sheet__seg-btn @(_minMatchPercent == 0 ? "is-selected" : null)"
                                    data-testid="kb-sheet-match-0"
                                    @onclick="() => SetSheetMinMatchAsync(0)">
                                @Culture["Kb.Filter.MatchAny"]
                            </button>
                            <button type="button"
                                    class="filter-sheet__seg-btn @(_minMatchPercent == 60 ? "is-selected" : null)"
                                    data-testid="kb-sheet-match-60"
                                    @onclick="() => SetSheetMinMatchAsync(60)">
                                @Culture["Kb.Filter.Match60"]
                            </button>
                            <button type="button"
                                    class="filter-sheet__seg-btn @(_minMatchPercent == 80 ? "is-selected" : null)"
                                    data-testid="kb-sheet-match-80"
                                    @onclick="() => SetSheetMinMatchAsync(80)">
                                @Culture["Kb.Filter.Match80"]
                            </button>
                        </div>
                    </section>
                }

                <section class="filter-section" data-filter-section="hours">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Vacancies)</span>
                        @Culture["Discovery.HoursSlider"]
                        <span class="filter-section__value">@Culture.Format("Kb.Filter.HoursValue", _minHoursPerWeek, _maxHoursPerWeek)</span>
                    </h3>
                    <HoursRangeSlider CssClass="hours-range--sheet"
                                      Min="0"
                                      Max="40"
                                      Low="_minHoursPerWeek"
                                      High="_maxHoursPerWeek"
                                      LowChanged="OnMinHoursSliderValue"
                                      HighChanged="OnMaxHoursSliderValue"
                                      RangeCommitted="CommitHoursRangeAsync" />
                    <div class="filter-sheet__ticks" aria-hidden="true">
                        <span>0</span><span>10</span><span>20</span><span>30</span><span>40 uur</span>
                    </div>
                </section>

                <section class="filter-section" data-filter-section="category">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Users)</span>
                        @Culture["Kb.Filter.WorkType"]
                    </h3>
                    <div class="filter-sheet__chips" role="group" aria-label="@Culture["Kb.Filter.WorkType"]">
                        @foreach (var cat in _categories.Where(c => c.ShowInMapFilter && c.IsActive))
                        {
                            var selected = _selectedCategoryIds.Contains(cat.Id);
                            <button type="button"
                                    class="filter-sheet__chip filter-sheet__chip--category @(selected ? "is-selected" : null)"
                                    data-testid="kb-sheet-category-@cat.Slug"
                                    aria-pressed="@(selected ? "true" : "false")"
                                    @onclick="() => ToggleCategoryChipAsync(cat.Id)">
                                <span class="filter-sheet__dot" style="@KbCategoryColor.Style(cat.ColorHex)" aria-hidden="true"></span>
                                <span>@cat.Name</span>
                                @if (selected)
                                {
                                    <span class="filter-sheet__check" aria-hidden="true">✓</span>
                                }
                            </button>
                        }
                    </div>
                </section>

                <section class="filter-section" data-filter-section="branch">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Branches)</span>
                        @Culture["Discovery.WorkType"]
                    </h3>
                    <div class="branch-multiselect branch-multiselect--sheet @(_branchMenuOpen ? "is-open" : null)">
                        <button type="button"
                                class="branch-multiselect__trigger filter-sheet__select"
                                aria-haspopup="listbox"
                                aria-expanded="@(_branchMenuOpen ? "true" : "false")"
                                aria-controls="@(_branchMenuOpen ? "branch-multiselect-panel-sheet" : null)"
                                data-testid="kb-sheet-branch"
                                @onclick="ToggleBranchMenu">
                            <span class="branch-multiselect__value @(_selectedWorkTypes.Count > 0 ? "is-selected" : null)">@BranchFilterSummary</span>
                            <span class="branch-multiselect__caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_branchMenuOpen)
                        {
                            <button type="button"
                                    class="branch-multiselect__backdrop"
                                    tabindex="-1"
                                    aria-label="@Culture["Discovery.Cancel"]"
                                    @onclick="CloseBranchMenu"></button>
                            <div id="branch-multiselect-panel-sheet"
                                 class="branch-multiselect__panel"
                                 role="listbox"
                                 aria-multiselectable="true"
                                 aria-label="@Culture["Discovery.WorkType"]">
                                @foreach (var label in _branchOptions)
                                {
                                    <label class="filter-check branch-multiselect__option">
                                        <input type="checkbox"
                                               checked="@_selectedWorkTypes.Contains(label)"
                                               @onchange="e => ToggleWorkTypeAsync(label, e)" />
                                        @UiLabels.WorkType(Culture, label)
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="filter-section" data-filter-section="wage">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Wages)</span>
                        @Culture["Kb.Filter.WageHour"]
                    </h3>
                    <div class="filter-sheet__two">
                        <label>
                            @Culture["Kb.Filter.WageMin"]
                            <input type="number"
                                   min="0"
                                   step="0.50"
                                   inputmode="decimal"
                                   data-testid="kb-sheet-wage-min"
                                   placeholder="€"
                                   value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMinWageChanged" />
                        </label>
                        <label>
                            @Culture["Kb.Filter.WageMax"]
                            <input type="number"
                                   min="0"
                                   step="0.50"
                                   inputmode="decimal"
                                   data-testid="kb-sheet-wage-max"
                                   placeholder="@Culture["Kb.Filter.WageNoMax"]"
                                   value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMaxWageChanged" />
                        </label>
                    </div>
                </section>

                <section class="filter-section" data-filter-section="age">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Profile)</span>
                        @Culture["Discovery.Age"]
                    </h3>
                    <p class="filter-section__hint">@Culture["Kb.Filter.AgeHint"]</p>
                    <label class="visually-hidden" for="kb-sheet-age">@Culture["Discovery.Age"]</label>
                    <select id="kb-sheet-age"
                            class="filter-sheet__select"
                            data-testid="kb-sheet-age"
                            value="@AgeSelectValue"
                            @onchange="OnAgeChanged"
                            required>
                        <option value="all">@Culture["Kb.Filter.AgeAny"]</option>
                        @for (var age = 15; age <= 21; age++)
                        {
                            <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                        }
                    </select>
                </section>

                <section class="filter-section" data-filter-section="distance">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.Regions)</span>
                        @Culture["Kb.Filter.Distance"]
                        <span class="filter-section__value">@Culture.Format("Kb.Filter.DistanceValue", _radiusKm)</span>
                    </h3>
                    <div class="filter-sheet__slider">
                        <input type="range"
                               min="1"
                               max="50"
                               step="1"
                               value="@_radiusKm"
                               data-testid="kb-sheet-distance"
                               aria-label="@Culture["Kb.Filter.Distance"]"
                               @oninput="OnRadiusSliderInput"
                               @onchange="OnRadiusChanged" />
                        <div class="filter-sheet__ticks" aria-hidden="true">
                            <span>1 km</span><span>25</span><span>50 km</span>
                        </div>
                    </div>
                </section>

                <section class="filter-section" data-filter-section="sort">
                    <h3>
                        <span class="filter-section__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                        @Culture["Kb.Filter.Sort"]
                    </h3>
                    <label class="visually-hidden" for="kb-sheet-sort">@Culture["Kb.Filter.Sort"]</label>
                    <select id="kb-sheet-sort"
                            class="filter-sheet__select"
                            data-testid="kb-sheet-sort"
                            value="@EffectiveSortMode"
                            @onchange="OnSortChanged">
                        @if (_isCandidate && ShowFitFilters)
                        {
                            <option value="match">@Culture["Kb.List.SortBest"]</option>
                        }
                        @if (_origin is not null)
                        {
                            <option value="distance">@Culture["Kb.List.SortNear"]</option>
                        }
                        <option value="type">@Culture["Kb.Filter.WorkType"]</option>
                        <option value="recent">@Culture["Kb.Filter.SortStart"]</option>
                        <option value="title">@Culture["Discovery.SortAlphaAsc"]</option>
                        <option value="title-desc">@Culture["Discovery.SortAlphaDesc"]</option>
                    </select>
                </section>
            </div>

            <div class="filter-sheet__footer">
                <button type="button"
                        class="filter-sheet__cancel"
                        data-testid="kb-filter-cancel"
                        @onclick="CloseFiltersAsync">
                    @Culture["Discovery.Cancel"]
                </button>
                <button type="button"
                        class="filter-sheet__apply"
                        data-testid="kb-filter-apply"
                        @onclick="ApplySearch">
                    @ApplyFiltersLabel
                </button>
            </div>
        </div>
    }
    <button type="button"
            class="kb-map-fab"
            data-testid="kb-map-fab"
            aria-label="@Culture["Kb.View.OpenMap"]"
            @onclick="ToggleMobileView">
        @Culture["Kb.View.OpenMap"]
    </button>
</div>

<LobsyFriendlyDialog IsOpen="@(_matchExplain is not null)"
                     Title="@(_matchExplain is null ? "" : Culture.Format("Competency.Matches.ExplainTitle", _matchExplain.MatchPercent ?? 0))"
                     TitleId="discovery-match-explain-title"
                     OnClose="CloseMatchExplain">
    @if (_matchExplain is not null)
    {
        <p class="competency-explain__vacancy">@_matchExplain.Title · @_matchExplain.CompanyName</p>
        @if (!string.IsNullOrWhiteSpace(_matchExplain.MatchWhySummary))
        {
            <p class="login-lead">@_matchExplain.MatchWhySummary</p>
        }
        @if (!string.IsNullOrWhiteSpace(_matchExplain.CultureFitLabel))
        {
            <p class="culture-fit culture-fit--@(_matchExplain.CultureFitBand ?? "mid")">@_matchExplain.CultureFitLabel</p>
        }
        @if (!string.IsNullOrWhiteSpace(_matchExplain.CultureFitWhy))
        {
            <p class="login-lead">@_matchExplain.CultureFitWhy</p>
        }
        <h3 class="competency-explain__h">@Culture["Competency.Matches.Why"]</h3>
        <ul class="competency-explain__list">
            @foreach (var line in _matchExplain.MatchWhy)
            {
                <li>@line</li>
            }
        </ul>
        <h3 class="competency-explain__h">@Culture["Competency.Matches.Gap"]</h3>
        <ul class="competency-explain__list competency-explain__list--gap">
            @foreach (var line in _matchExplain.MatchGaps)
            {
                <li>@line</li>
            }
        </ul>
        <a class="login-submit competency-explain__cta" href="@($"/vacancies/{_matchExplain.Id}")">
            @Culture["Competency.Matches.OpenVacancy"]
        </a>
        <a class="engagement-btn" href="/candidate/profile">@Culture["Competency.BackToProfile"]</a>
    }
</LobsyFriendlyDialog>

@code {
