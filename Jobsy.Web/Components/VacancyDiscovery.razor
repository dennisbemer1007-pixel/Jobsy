    private async Task ReloadFiltersIfAppliedAsync()
    {
        if (_filtersOpen)
        {
            SchedulePendingCountRefresh();
            return;
        }

        if (_mapReady)
        {
            try { await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions()); }
            catch { /* ignore */ }
        }

        await LoadVacanciesAsync();
    }

    private void SchedulePendingCountRefresh()
    {
        _pendingResultCount = null;
        _ = DebouncePendingCountAsync();
    }

    private async Task DebouncePendingCountAsync()
    {
        _pendingCountCts?.Cancel();
        _pendingCountCts?.Dispose();
        var cts = new CancellationTokenSource();
        _pendingCountCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
            if (!_filtersOpen)
            {
                return;
            }

            var companyFocus = _companyFocusIds is { Count: > 0 } || _myVacanciesOnly;
            var useOrigin = _origin is not null && !companyFocus;
            var items = await Api.DiscoverVacanciesAsync(
                useOrigin ? _origin!.Latitude : null,
                useOrigin ? _origin!.Longitude : null,
                _selectedTransport,
                _maxTravelMinutes,
                useOrigin ? _radiusKm : null,
                companyFocus ? null : _ageYears,
                companyFocus ? null : _minHourlyWage,
                companyFocus ? null : _maxHourlyWage,
                companyFocus || _selectedWorkTypes.Count == 0 ? null : _selectedWorkTypes,
                companyFocus ? null : _searchQuery,
                companyFocus ? null : _minHoursPerWeek,
                companyFocus ? null : _maxHoursPerWeek,
                companyFocus || _selectedCategoryIds.Count == 0 ? null : _selectedCategoryIds,
                suitableFor65Plus: null,
                companyIds: _companyFocusIds,
                minMatchPercent: _isCandidate && _minMatchPercent > 0 ? _minMatchPercent : null,
                ct: cts.Token);

            if (cts.IsCancellationRequested || !_filtersOpen)
            {
                return;
            }

            var count = items.Count;
            if (_myVacanciesOnly && _myVacancyIds is { Count: > 0 })
            {
                count = items.Count(v => _myVacancyIds.Contains(v.Id));
            }

            _pendingResultCount = count;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Newer filter change superseded this debounce.
        }
        catch
        {
            if (!cts.IsCancellationRequested && _filtersOpen)
            {
                _pendingResultCount = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchDraft = e.Value?.ToString() ?? string.Empty;
        _ = DebounceSearchAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter"))
        {
            return;
        }

        await CommitSearchAsync(immediate: true);
    }

    private async Task DebounceSearchAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        try
        {
            await Task.Delay(350, cts.Token);
            await CommitSearchAsync(immediate: false);
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this debounce.
        }
    }

    private async Task CommitSearchAsync(bool immediate)
    {
        if (immediate)
        {
            _searchDebounceCts?.Cancel();
        }

        var next = string.IsNullOrWhiteSpace(_searchDraft) ? null : _searchDraft.Trim();
        if (string.Equals(_searchQuery, next, StringComparison.Ordinal))
        {
            _searchDraft = _searchQuery;
            return;
        }

        _searchQuery = next;
        _searchDraft = next;
        await ReloadFiltersIfAppliedAsync();
    }

    private async Task PersistAgeAsync()
    {
        try
        {
            if (_ageYears is int age)
            {
                await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", age);
            }
            else
            {
                await Js.InvokeVoidAsync("jobsyGeo.clearStoredAge");
            }
        }
        catch
        {
            // ignore storage failures
        }

        // Candidate age lives on geboortedatum in the profile — do not overwrite Preferences.AgeYears
        // from the banenkaart filter (that made the filter stick on Alle / diverge from DOB).
    }

    private void ApplyAgeFromProfile(MeProfile profile)
    {
        // Geboortedatum is the profile source of truth for leeftijd.
        if (profile.DateOfBirth is DateOnly dob)
        {
            _profileAgeYears = NormalizeFilterAge(AgeFromDob(dob));
            _ageYears = _profileAgeYears;
            return;
        }

        if (profile.Preferences.AgeYears is int prefAge)
        {
            _profileAgeYears = NormalizeFilterAge(prefAge);
            _ageYears = _profileAgeYears;
        }
    }

    private static decimal? TryParseWage(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        if (decimal.TryParse(raw, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var value)
            || decimal.TryParse(raw, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.CurrentCulture, out value))
        {
            return value < 0 ? null : value;
        }

        return null;
    }

    private static int AgeFromDob(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age))
        {
            age--;
        }

        return Math.Clamp(age, 15, 67);
    }

    /// <summary>Filter UI only offers 15–21 (21+); clamp so the select always has a matching option.</summary>
    private static int NormalizeFilterAge(int age) => Math.Clamp(age, 15, 21);

