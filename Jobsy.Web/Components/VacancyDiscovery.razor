@inject JobsyApiClient Api
@inject IGeocodingClient Geocoder
@inject IJSRuntime Js
@inject CultureState Culture
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable
@using Jobsy.Core.Rules
@using Microsoft.AspNetCore.Components.Authorization

<div class="jobsy-discovery @(showMapOnMobile ? "show-map" : "show-list") @(_filtersOpen ? "filters-open" : null)">
    <div class="jobsy-chrome">
        <header class="jobsy-chrome__header">
            <a class="jobsy-logo" href="/" aria-label="Lobsy">
                <img class="jobsy-logo__img" src="images/brand/lobsy.png?v=20260726-no-ai" alt="Lobsy" width="36" height="36" />
                <span class="jobsy-logo__mark">Lobsy</span>
            </a>
        </header>

        <div class="jobsy-chrome__search">
            <label class="visually-hidden" for="discovery-address">@Culture["Discovery.Address"]</label>
            <div class="jobsy-search @(_origin is not null ? "jobsy-search--with-clear" : null)">
                <input id="discovery-address"
                       type="text"
                       autocomplete="off"
                       placeholder="@Culture["Discovery.AddressPlaceholder"]"
                       value="@_addressQuery"
                       @oninput="OnAddressInputAsync"
                       @onfocus="OnAddressFocus"
                       @onkeydown="OnAddressKeyDown" />
                @if (_origin is not null)
                {
                    <button type="button"
                            class="jobsy-search__clear"
                            title="@Culture["Common.Clear"]"
                            @onclick="ClearOriginAsync"
                            aria-label="@Culture["Common.Clear"]">
                        @Culture["Common.Clear"]
                    </button>
                }
                <button type="button"
                        class="jobsy-search__btn"
                        title="@Culture["Discovery.UseMyLocation"]"
                        disabled="@_locating"
                        @onclick="RequestLocationAsync"
                        aria-label="@Culture["Discovery.UseMyLocation"]">
                    <span class="jobsy-search__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="3"/>
                            <circle cx="12" cy="12" r="7"/>
                            <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21"/>
                        </svg>
                    </span>
                </button>
            </div>
            @if (_showSuggestions)
            {
                <ul class="address-suggestions" role="listbox">
                    @if (_suggesting)
                    {
                        <li class="address-suggestions__status">@Culture["Common.Loading"]</li>
                    }
                    else if (_suggestions.Count == 0 && _addressQuery.Trim().Length >= 3)
                    {
                        <li class="address-suggestions__status">@Culture["Discovery.AddressNoResults"]</li>
                    }
                    else
                    {
                        @foreach (var suggestion in _suggestions)
                        {
                            <li>
                                <button type="button"
                                        class="address-suggestions__item"
                                        @onclick="() => SelectSuggestionAsync(suggestion)">
                                    @suggestion.Label
                                </button>
                            </li>
                        }
                    }
                </ul>
            }
            @if (!string.IsNullOrEmpty(_locationError))
            {
                <p class="state-message error filter-bar__error">@_locationError</p>
            }
        </div>

        <div class="jobsy-chrome__actions" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <button type="button"
                    class="jobsy-action @(_filtersOpen ? "is-active" : null)"
                    @onclick="ToggleFilters"
                    aria-expanded="@_filtersOpen"
                    aria-controls="discovery-filters">
                <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                <span>@Culture["Discovery.Filters"]</span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="jobsy-action__badge">@ActiveFilterCount</span>
                }
            </button>
            <a class="jobsy-action" href="/candidate/liked">
                <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Liked)</span>
                <span>@Culture["Discovery.SaveSearch"]</span>
            </a>
            <button type="button" class="jobsy-action jobsy-action--toggle" @onclick="ToggleMobileView">
                @if (showMapOnMobile)
                {
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                    <span>@Culture["Discovery.List"]</span>
                }
                else
                {
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.Map)</span>
                    <span>@Culture["Discovery.Map"]</span>
                }
            </button>
        </div>
    </div>

    <aside class="vacancy-pane">
        <div class="discovery-toolbar discovery-toolbar--desktop" role="toolbar" aria-label="@Culture["Discovery.Filters"]">
            <div class="filter-bar__address discovery-toolbar__address">
                <label for="discovery-address-desktop">@Culture["Discovery.Address"]</label>
                <div class="address-field">
                    <input id="discovery-address-desktop"
                           type="text"
                           autocomplete="off"
                           placeholder="@Culture["Discovery.AddressPlaceholder"]"
                           value="@_addressQuery"
                           @oninput="OnAddressInputAsync"
                           @onfocus="OnAddressFocus"
                           @onkeydown="OnAddressKeyDown" />
                    <button type="button"
                            class="engagement-btn address-field__geo"
                            title="@Culture["Discovery.UseMyLocation"]"
                            disabled="@_locating"
                            @onclick="RequestLocationAsync">
                        @(_locating ? Culture["Common.Busy"] : Culture["Discovery.UseMyLocation"])
                    </button>
                    @if (_origin is not null)
                    {
                        <button type="button"
                                class="engagement-btn address-field__clear"
                                @onclick="ClearOriginAsync">
                            @Culture["Common.Clear"]
                        </button>
                    }
                </div>
                @if (_showSuggestions)
                {
                    <ul class="address-suggestions" role="listbox">
                        @if (_suggesting)
                        {
                            <li class="address-suggestions__status">@Culture["Common.Loading"]</li>
                        }
                        else if (_suggestions.Count == 0 && _addressQuery.Trim().Length >= 3)
                        {
                            <li class="address-suggestions__status">@Culture["Discovery.AddressNoResults"]</li>
                        }
                        else
                        {
                            @foreach (var suggestion in _suggestions)
                            {
                                <li>
                                    <button type="button"
                                            class="address-suggestions__item"
                                            @onclick="() => SelectSuggestionAsync(suggestion)">
                                        @suggestion.Label
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(_locationError))
                {
                    <p class="state-message error filter-bar__error">@_locationError</p>
                }
            </div>
            <button type="button"
                    class="discovery-filter-toggle @(_filtersOpen ? "is-active" : null)"
                    @onclick="ToggleFilters"
                    aria-expanded="@_filtersOpen"
                    aria-controls="discovery-filters-desktop">
                <span class="discovery-filter-toggle__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
                <span>@Culture["Discovery.Filters"]</span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="jobsy-action__badge">@ActiveFilterCount</span>
                }
            </button>
        </div>

        @if (_filtersOpen)
        {
            <div id="discovery-filters-desktop" class="filter-bar filter-bar--desktop">
                <label class="filter-required">
                    @Culture["Discovery.WorkType"]
                    <select value="@_selectedWorkType" @onchange="OnWorkTypeChanged" required>
                        <option value="">@Culture["Discovery.WorkTypeAny"]</option>
                        @foreach (var label in WorkTypeLabels.All)
                        {
                            <option value="@label">@label</option>
                        }
                    </select>
                </label>
                <label class="filter-required">
                    @Culture["Discovery.Age"]
                    <select value="@AgeSelectValue" @onchange="OnAgeChanged" required>
                        <option value="">@Culture["Discovery.AgeAny"]</option>
                        @for (var age = 15; age <= 21; age++)
                        {
                            <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                        }
                    </select>
                </label>
                @if (_ageYears is not null)
                {
                    <label>
                        @Culture["Discovery.MinWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMinWageChanged" />
                    </label>
                    <label>
                        @Culture["Discovery.MaxWage"]
                        <input type="number" min="0" step="0.50" placeholder="—"
                               value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               @onchange="OnMaxWageChanged" />
                    </label>
                }
                <label>
                    @Culture["Discovery.TravelMinutes"]
                    <input type="number" min="5" max="90" value="@_maxTravelMinutes"
                           @onchange="OnMaxMinutesChanged" />
                </label>
                <label>
                    @Culture["Discovery.Transport"]
                    <select value="@_selectedTransport" @onchange="OnTransportChanged">
                        <option value="Fiets">@Culture["Transport.Bike"]</option>
                        <option value="Auto">@Culture["Transport.Car"]</option>
                        <option value="OV">@Culture["Transport.Transit"]</option>
                        <option value="Lopend">@Culture["Transport.Walk"]</option>
                    </select>
                </label>
                <label>
                    @Culture["Discovery.Radius"]
                    <input type="number" min="1" max="50" value="@_radiusKm"
                           @onchange="OnRadiusChanged" />
                </label>
                <div class="filter-bar__actions">
                    <button type="button" class="filter-bar__search" @onclick="ApplySearch">
                        @Culture["Discovery.Search"]
                    </button>
                </div>
            </div>
        }

        @if (_loading)
        {
            <p class="state-message">@Culture["Discovery.Loading"]</p>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error">@_error</p>
        }
        else if (_vacancies.Count == 0)
        {
            <p class="state-message">
                @if (_origin is null)
                {
                    @Culture.Format("Discovery.NoneWithoutOrigin", TransportLabel(_selectedTransport))
                }
                else
                {
                    @Culture.Format("Discovery.NoneWithOrigin", _maxTravelMinutes, TransportLabel(_selectedTransport))
                }
            </p>
        }
        else
        {
            <div class="results-meta">
                <p class="results-meta__count">@Culture.Format("Discovery.ResultCount", _vacancies.Count)</p>
                <span class="results-meta__sort">
                    <span class="jobsy-action__icon" aria-hidden="true">@((MarkupString)NavIcons.List)</span>
                    @Culture["Discovery.Sort"]
                </span>
            </div>
            <div class="vacancy-list vacancy-list--cards">
                @foreach (var vacancy in _vacancies)
                {
                    var wageText = FormatWage(vacancy);
                    var travelText = vacancy.TravelMinutes is not null
                        ? $"± {vacancy.TravelMinutes} min"
                        : $"max {_maxTravelMinutes} min";
                    <article class="job-card @(_hoveredId == vacancy.Id ? "is-hovered" : null) @(vacancy.IsHighlighted ? "job-card--highlight" : null)"
                             @onmouseenter="() => OnHover(vacancy.Id)"
                             @onmouseleave="() => OnHover(null)"
                             @onclick="() => OnSelect(vacancy.Id)">
                        <a class="job-card__media" href="@($"/vacancies/{vacancy.Id}")" @onclick:stopPropagation="true"
                           style="@(string.IsNullOrWhiteSpace(vacancy.ImageUrl) ? null : $"background-image:url('{vacancy.ImageUrl}')")">
                            @if (vacancy.IsHighlighted)
                            {
                                <span class="job-card__badge">Top</span>
                            }
                            else if (vacancy.WorkTypes.Length > 0)
                            {
                                <span class="job-card__badge job-card__badge--soft">@vacancy.WorkTypes[0]</span>
                            }
                            <div class="job-card__overlay">
                                <h2>@vacancy.Title</h2>
                                <p class="job-card__travel">
                                    <LobsyMark Compact="true" />
                                    <span>@travelText · @TransportVerb(_selectedTransport)</span>
                                </p>
                                @if (!string.IsNullOrEmpty(wageText))
                                {
                                    <p class="job-card__wage">@wageText</p>
                                }
                            </div>
                        </a>
                        <div class="job-card__footer">
                            <p class="job-card__company">@vacancy.CompanyName</p>
                            <p class="job-card__location">@vacancy.CompanyAddress</p>
                            <div class="vacancy-card__actions" @onclick:stopPropagation="true">
                                <a class="vacancy-card__link" href="@($"/vacancies/{vacancy.Id}")">Bekijk</a>
                                <AuthorizeView>
                                    <Authorized>
                                        <button type="button" class="vacancy-card__link" @onclick="() => OpenShare(vacancy)">Delen</button>
                                        <a class="vacancy-card__link vacancy-card__link--primary" href="@($"/vacancies/{vacancy.Id}#apply")">Solliciteer</a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <a class="vacancy-card__link vacancy-card__link--primary"
                                           href="@($"/login?returnUrl={Uri.EscapeDataString($"/vacancies/{vacancy.Id}#apply")}")">
                                            Solliciteer
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </aside>

    <section class="map-pane">
        <div @ref="_mapElement" id="job-map" class="job-map"></div>
        <button type="button"
                class="discovery-filter-fab @(_filtersOpen ? "is-active" : null)"
                @onclick="ToggleFilters"
                aria-expanded="@_filtersOpen"
                aria-controls="discovery-filters-desktop"
                title="@Culture["Discovery.Filters"]"
                aria-label="@Culture["Discovery.Filters"]">
            <span class="discovery-filter-fab__icon" aria-hidden="true">@((MarkupString)NavIcons.Filters)</span>
            @if (ActiveFilterCount > 0)
            {
                <span class="jobsy-action__badge">@ActiveFilterCount</span>
            }
        </button>
    </section>

    @if (_filtersOpen)
    {
        <div class="filter-sheet-backdrop" @onclick="CloseFilters"></div>
        <div id="discovery-filters" class="filter-sheet" role="dialog" aria-modal="true" aria-labelledby="filter-sheet-title">
            <div class="filter-sheet__header">
                <h2 id="filter-sheet-title">
                    @Culture["Discovery.Filters"]
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="jobsy-action__badge">@ActiveFilterCount</span>
                    }
                </h2>
                <button type="button" class="filter-sheet__cancel" @onclick="CloseFilters">@Culture["Discovery.Cancel"]</button>
            </div>

            @if (ActiveFilterCount > 0)
            {
                <div class="filter-sheet__tags">
                    @if (!string.IsNullOrWhiteSpace(_selectedWorkType))
                    {
                        <button type="button" class="filter-tag" @onclick="ClearWorkTypeAsync">@_selectedWorkType ×</button>
                    }
                    @if (_ageYears is not null)
                    {
                        <button type="button" class="filter-tag" @onclick="ClearAgeAsync">@_ageYears ×</button>
                    }
                    <button type="button" class="filter-sheet__clear" @onclick="ClearAllFiltersAsync">@Culture["Discovery.ClearFilters"]</button>
                </div>
            }

            <div class="filter-sheet__body">
                <section class="filter-section filter-section--hero">
                    <h3>@Culture["Discovery.TravelSlider"]</h3>
                    <div class="travel-slider">
                        <input type="range" min="5" max="90" step="5"
                               value="@_maxTravelMinutes"
                               @oninput="OnTravelSliderInput"
                               @onchange="OnMaxMinutesChanged" />
                        <div class="travel-slider__value">
                            <strong>@_maxTravelMinutes</strong> @Culture["Discovery.Minutes"]
                        </div>
                    </div>
                    <label>
                        @Culture["Discovery.Transport"]
                        <select value="@_selectedTransport" @onchange="OnTransportChanged">
                            <option value="Fiets">@Culture["Transport.Bike"]</option>
                            <option value="Auto">@Culture["Transport.Car"]</option>
                            <option value="OV">@Culture["Transport.Transit"]</option>
                            <option value="Lopend">@Culture["Transport.Walk"]</option>
                        </select>
                    </label>
                </section>

                <section class="filter-section">
                    <h3>@Culture["Discovery.WorkType"]</h3>
                    <label>
                        <select value="@_selectedWorkType" @onchange="OnWorkTypeChanged">
                            <option value="">@Culture["Discovery.WorkTypeAny"]</option>
                            @foreach (var label in WorkTypeLabels.All)
                            {
                                <option value="@label">@label</option>
                            }
                        </select>
                    </label>
                </section>

                <section class="filter-section">
                    <h3>@Culture["Discovery.Age"] · uurloon</h3>
                    <label>
                        @Culture["Discovery.Age"]
                        <select value="@AgeSelectValue" @onchange="OnAgeChanged">
                            <option value="">@Culture["Discovery.AgeAny"]</option>
                            @for (var age = 15; age <= 21; age++)
                            {
                                <option value="@age">@(age == 21 ? "21+" : age.ToString())</option>
                            }
                        </select>
                    </label>
                    @if (_ageYears is not null)
                    {
                        <label>
                            @Culture["Discovery.MinWage"]
                            <input type="number" min="0" step="0.50" placeholder="—"
                                   value="@(_minHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMinWageChanged" />
                        </label>
                        <label>
                            @Culture["Discovery.MaxWage"]
                            <input type="number" min="0" step="0.50" placeholder="—"
                                   value="@(_maxHourlyWage?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   @onchange="OnMaxWageChanged" />
                        </label>
                    }
                </section>

                <section class="filter-section">
                    <label>
                        @Culture["Discovery.Radius"]
                        <input type="number" min="1" max="50" value="@_radiusKm"
                               @onchange="OnRadiusChanged" />
                    </label>
                </section>
            </div>

            <button type="button" class="filter-sheet__apply" @onclick="ApplySearch">
                @Culture["Discovery.Search"]
            </button>
        </div>
    }
</div>

<ShareModal IsOpen="_shareOpen" Vacancy="_shareVacancy" OnClose="CloseShare" />

@code {
    private List<VacancyListItem> _vacancies = [];
    private bool _loading = true;
    private string? _error;
    private Guid? _hoveredId;
    private bool showMapOnMobile = true;
    private bool _filtersOpen;
    private bool _mapReady;
    private bool _mapInitScheduled;
    private ElementReference _mapElement;
    private int _maxTravelMinutes = 30;
    private int _radiusKm = 15;
    private string _selectedTransport = "Fiets";
    private string _selectedWorkType = "";
    private int? _ageYears;
    private decimal? _minHourlyWage;
    private decimal? _maxHourlyWage;
    private bool _isCandidate;
    private CandidatePreferences? _candidatePrefs;
    private OriginPoint? _origin;
    private string _addressQuery = string.Empty;
    private List<AddressSuggestion> _suggestions = [];
    private bool _showSuggestions;
    private bool _suggesting;
    private bool _locating;
    private string? _locationError;
    private bool _shareOpen;
    private VacancyListItem? _shareVacancy;
    private DotNetObjectReference<VacancyDiscovery>? _dotNetRef;
    private CancellationTokenSource? _suggestCts;
    private int _suggestGeneration;

    private string AgeSelectValue => _ageYears?.ToString() ?? "";

    private int ActiveFilterCount
    {
        get
        {
            var n = 0;
            if (!string.IsNullOrWhiteSpace(_selectedWorkType)) n++;
            if (_ageYears is not null) n++;
            if (_minHourlyWage is not null) n++;
            if (_maxHourlyWage is not null) n++;
            if (_maxTravelMinutes != 30) n++;
            if (_selectedTransport != "Fiets") n++;
            if (_radiusKm != 15) n++;
            return n;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Culture.Changed += OnCultureChanged;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            _isCandidate = state.User.IsInRole("Candidate");
            if (_isCandidate)
            {
                var profile = await Api.GetMyProfileAsync();
                if (profile is not null)
                {
                    _candidatePrefs = profile.Preferences;
                    if (profile.Preferences.AgeYears is int prefAge)
                    {
                        _ageYears = prefAge;
                    }
                    else if (profile.DateOfBirth is DateOnly dob)
                    {
                        _ageYears = AgeFromDob(dob);
                    }

                    if (profile.Preferences.MaxTravelMinutes is int travel)
                    {
                        _maxTravelMinutes = Math.Clamp(travel, 5, 90);
                    }

                    if (!string.IsNullOrWhiteSpace(profile.Preferences.PreferredTransport))
                    {
                        _selectedTransport = profile.Preferences.PreferredTransport;
                    }
                }
            }
        }
        catch
        {
            // anonymous or profile unavailable
        }

        await LoadVacanciesAsync();
    }

    private async void OnCultureChanged()
    {
        await LoadVacanciesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private string TransportLabel(string transport) => transport switch
    {
        "Fiets" => Culture["Transport.Bike"],
        "Auto" => Culture["Transport.Car"],
        "OV" => Culture["Transport.Transit"],
        "Lopend" => Culture["Transport.Walk"],
        _ => transport
    };

    private string? FormatWage(VacancyListItem vacancy)
    {
        if (!vacancy.WageVisible)
        {
            return null;
        }

        if (vacancy.WageByAge is { Count: > 0 })
        {
            if (_ageYears is int age)
            {
                var band = vacancy.WageByAge
                    .OrderBy(b => Math.Abs(b.AgeYears - age))
                    .FirstOrDefault();
                if (band is not null)
                {
                    return $"€ {band.HourlyRate:0.00}/u";
                }
            }

            return string.Join(" · ", vacancy.WageByAge.Take(2).Select(b => $"{b.Label} €{b.HourlyRate:0.00}"));
        }

        if (vacancy.HourlyWage is not null)
        {
            return $"€ {vacancy.HourlyWage.Value:0.00}/u";
        }

        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (_ageYears is null)
                {
                    var storedAge = await Js.InvokeAsync<int?>("jobsyGeo.getStoredAge");
                    if (storedAge is int age)
                    {
                        _ageYears = age;
                    }
                }
                else
                {
                    await Js.InvokeVoidAsync("jobsyGeo.setStoredAge", _ageYears.Value);
                }

                var stored = await Js.InvokeAsync<StoredOrigin?>("jobsyGeo.ensureLocationOnLaunch");
                if (stored is not null && IsFinite(stored.Lat) && IsFinite(stored.Lng))
                {
                    _origin = new OriginPoint { Latitude = stored.Lat, Longitude = stored.Lng };
                    if (!string.IsNullOrWhiteSpace(stored.Label))
                    {
                        _addressQuery = stored.Label;
                    }
                    else
                    {
                        await FillAddressFromCoordinatesAsync(stored.Lat, stored.Lng, persistLabel: true);
                    }
                }

                await LoadVacanciesAsync();
                StateHasChanged();
            }
            catch
            {
                // geolocation helpers not ready yet
            }
        }

        if (_mapReady || _mapInitScheduled || _loading)
        {
            return;
        }

        _mapInitScheduled = true;

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var markers = BuildMarkers();
            var options = new Dictionary<string, object?>
            {
                ["dotNetRef"] = _dotNetRef,
                ["travel"] = TravelMapOptions()
            };
            if (_origin is not null)
            {
                options["origin"] = new Dictionary<string, object?>
                {
                    ["lat"] = _origin.Latitude,
                    ["lng"] = _origin.Longitude
                };
            }

            await Js.InvokeVoidAsync("jobMap.init", "job-map", markers, options);
            _mapReady = true;
            await Task.Delay(80);
            await Js.InvokeVoidAsync("jobMap.invalidate");
        }
        catch (JSDisconnectedException)
        {
            _mapInitScheduled = false;
        }
        catch (InvalidOperationException)
        {
            _mapInitScheduled = false;
        }
        catch (JSException)
        {
            _mapInitScheduled = false;
            await Task.Delay(150);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadVacanciesAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var items = await Api.DiscoverVacanciesAsync(
                _origin?.Latitude,
                _origin?.Longitude,
                _selectedTransport,
                _maxTravelMinutes,
                _origin is null ? null : _radiusKm,
                _ageYears,
                _ageYears is null ? null : _minHourlyWage,
                _ageYears is null ? null : _maxHourlyWage,
                string.IsNullOrWhiteSpace(_selectedWorkType) ? null : _selectedWorkType);
            _vacancies = items.ToList();
            if (_mapReady)
            {
                await Js.InvokeVoidAsync("jobMap.setVacancies", BuildMarkers());
                if (_origin is not null)
                {
                    await Js.InvokeVoidAsync("jobMap.setOrigin", _origin.Latitude, _origin.Longitude, TravelMapOptions());
                }
                else
                {
                    await Js.InvokeVoidAsync("jobMap.setTravelOptions", TravelMapOptions());
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"Kon vacatures niet laden. Start de API op poort 5200. ({ex.Message})";
            _vacancies = [];
        }
        finally
        {
            _loading = false;
        }

        // Map init is gated on !_loading in OnAfterRenderAsync — nudge a re-render after load.
        if (!_mapReady && !_mapInitScheduled)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<Dictionary<string, object?>> BuildMarkers() =>
        _vacancies.Select(v =>
        {
            var primaryType = v.WorkTypes.FirstOrDefault() ?? "";
            var dict = new Dictionary<string, object?>
            {
                ["id"] = v.Id.ToString(),
                ["title"] = v.Title,
                ["company"] = v.CompanyName,
                ["address"] = v.CompanyAddress,
                ["logoUrl"] = v.CompanyLogoUrl,
                ["imageUrl"] = v.ImageUrl,
                ["lat"] = v.Latitude,
                ["lng"] = v.Longitude,
                ["transport"] = v.RequiredTransport,
                ["workTypes"] = v.WorkTypes,
                ["workType"] = primaryType,
                ["travelMinutes"] = v.TravelMinutes,
                ["transportLabel"] = TransportVerb(_selectedTransport)
            };
            if (!v.WageVisible)
            {
                dict["wageLabel"] = WageVisibilityRules.MissingDateOfBirthMessage;
            }
            else if (v.WageByAge is { Count: > 0 })
            {
                dict["wageBands"] = v.WageByAge.Select(b => new Dictionary<string, object?>
                {
                    ["ageYears"] = b.AgeYears,
                    ["hourlyRate"] = (double)b.HourlyRate,
                    ["label"] = b.Label
                }).ToList();
            }
            else if (v.HourlyWage is not null)
            {
                dict["wage"] = (double)v.HourlyWage.Value;
            }

            return dict;
        }).ToList();

    private async Task OnAddressInputAsync(ChangeEventArgs e)
    {
        _addressQuery = e.Value?.ToString() ?? string.Empty;
        _locationError = null;
        await SuggestAddressesAsync(_addressQuery);
    }

    private void OnAddressFocus()
    {
        if (_suggestions.Count > 0 || (_addressQuery.Trim().Length >= 3 && _suggesting))
        {
            _showSuggestions = true;
        }
    }

    private void OnAddressKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showSuggestions = false;
        }
    }

    private async Task SuggestAddressesAsync(string query)
    {
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _suggestCts = new CancellationTokenSource();
        var token = _suggestCts.Token;
        var generation = ++_suggestGeneration;

        var trimmed = query.Trim();
        if (trimmed.Length < 3)
        {
            _suggestions = [];
            _showSuggestions = false;
            _suggesting = false;
            return;
        }

        _showSuggestions = true;
        _suggesting = true;

        try
        {
            await Task.Delay(280, token);
            var results = await Geocoder.SuggestAsync(trimmed, token);
            if (generation != _suggestGeneration || token.IsCancellationRequested)
            {
                return;
            }

            _suggestions = results.ToList();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            if (generation == _suggestGeneration)
            {
                _suggestions = [];
            }
        }
        finally
        {
            if (generation == _suggestGeneration)
            {
                _suggesting = false;
            }
        }
    }

    private async Task SelectSuggestionAsync(AddressSuggestion suggestion)
    {
        _showSuggestions = false;
        _suggestions = [];
        _addressQuery = suggestion.Label;
        await ApplyOriginAsync(suggestion.Latitude, suggestion.Longitude, suggestion.Label);
    }

    private async Task RequestLocationAsync()
    {
        _locating = true;
        _locationError = null;
        _showSuggestions = false;
        try
        {
            var dict = await Js.InvokeAsync<Dictionary<string, double>>("jobsyGeo.requestLocation");
            var lat = dict["lat"];
            var lng = dict["lng"];
            var label = await FillAddressFromCoordinatesAsync(lat, lng, persistLabel: false);
            await ApplyOriginAsync(lat, lng, label);
        }
        catch (Exception ex)
        {
            _locationError = ex.Message;
        }
        finally
        {
            _locating = false;
        }
    }

    private async Task<string?> FillAddressFromCoordinatesAsync(double lat, double lng, bool persistLabel)
    {
        try
        {
            var label = await Geocoder.ReverseAsync(lat, lng);
            if (!string.IsNullOrWhiteSpace(label))
            {
                _addressQuery = label;
                if (persistLabel)
                {
                    await Js.InvokeVoidAsync("jobsyGeo.setStoredOrigin", lat, lng, label);
                }

                return label;
            }
        }
        catch
        {
            // keep coordinates even if reverse geocode fails
        }

        if (string.IsNullOrWhiteSpace(_addressQuery))
        {
            _addressQuery = $"{lat.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}, {lng.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)}";
        }

        return string.IsNullOrWhiteSpace(_addressQuery) ? null : _addressQuery;
    }

    private async Task ApplyOriginAsync(double lat, double lng, string? label)
    {
        _origin = new OriginPoint { Latitude = lat, Longitude = lng };
        try
        {
            await Js.InvokeVoidAsync("jobsyGeo.setStoredOrigin", lat, lng, label);
        }
        catch
        {
            // ignore storage failures
        }

        await LoadVacanciesAsync();
        if (_mapReady)
        {
            await Js.InvokeVoidAsync("jobMap.setOrigin", lat, lng, TravelMapOptions());
        }
    }

    private async Task ClearOriginAsync()
    {
        _origin = null;
        _addressQuery = string.Empty;
        _suggestions = [];
        _showSuggestions = false;
        _locationError = null;
        try
        {
            await Js.InvokeVoidAsync("jobsyGeo.clearStoredOrigin");
            if (_mapReady)
            {
                await Js.InvokeVoidAsync("jobMap.clearOrigin");
            }
        }
        catch
        {
            // ignore
        }

        await LoadVacanciesAsync();
    }

    private Dictionary<string, object?> TravelMapOptions() => new()
    {
        ["maxMinutes"] = _maxTravelMinutes,
        ["transport"] = _selectedTransport,
        ["radiusKm"] = _radiusKm
    };

    private static string TransportVerb(string transport) => transport switch
    {
        "Fiets" => "fietsen",
        "Auto" => "rijden",
        "OV" => "OV",
        "Lopend" => "lopen",
        _ => "reistijd"
    };

