@namespace Jobsy.Web.Components
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<div id="lobsy-assistant-ssr-config" hidden
     data-chat-url="/api/assistant-client/chat"
     data-business="1"
     data-coach-avatar-url="@BrandImages.AbsoluteCoachBAvatar"
     data-coach-figure-url="@BrandImages.AbsoluteCoachB"
     data-title="@Culture["Assistant.Title"]"
     data-bot-name="@Culture["Assistant.BotName"]"
     data-subtitle="@Culture["Assistant.SubtitleBusiness"]"
     data-greeting="@Culture["Assistant.Greeting"]"
     data-you="@Culture["Assistant.You"]"
     data-close="@Culture["Assistant.Close"]"
     data-new-chat="@Culture["Assistant.NewChat"]"
     data-send="@Culture["Assistant.Send"]"
     data-placeholder="@Culture["Assistant.Placeholder"]"
     data-typing="@Culture["Assistant.Typing"]"
     data-disclaimer="@Culture["Assistant.Disclaimer"]"
     data-disclaimer-link="@Culture["Assistant.DisclaimerLink"]"
     data-read-aloud-play="@Culture["ReadAloud.Play"]"
     data-read-aloud-aria="@Culture["ReadAloud.PlayAria"]"
     data-bubble-text="@Culture["Coach.OnboardingBubble"]"
     data-lang="@Culture.Language"></div>

<LobsyCoachVariantBDock ButtonId="lobsy-assistant-launcher-btn"
                        HasBottomNav="HasBottomNav" />

@code {
    [Parameter] public bool HasBottomNav { get; set; }
}