@namespace Jobsy.Web.Components
@using Jobsy.Web.Localization
@using Jobsy.Web.Media
@inject CultureState Culture

<div id="lobsy-assistant-ssr-config" hidden
     data-chat-url="/api/assistant-client/chat"
     data-title="@Culture["Assistant.BotName"]"
     data-subtitle="@Culture["Assistant.SubtitleBusiness"]"
     data-greeting="@Culture["Assistant.Greeting"]"
     data-you="@Culture["Assistant.You"]"
     data-close="@Culture["Assistant.Close"]"
     data-new-chat="@Culture["Assistant.NewChat"]"
     data-send="@Culture["Assistant.Send"]"
     data-placeholder="@Culture["Assistant.Placeholder"]"
     data-typing="@Culture["Assistant.Typing"]"
     data-disclaimer="@Culture["Assistant.Disclaimer"]"></div>

<div class="lobsy-assistant-launcher lobsy-assistant-launcher--business @(HasBottomNav ? "has-bottom-nav" : null)"
     data-lobsy-coach
     data-ssr-coach="business">
    <button type="button"
            id="lobsy-assistant-launcher-btn"
            class="lobsy-assistant-launcher__btn"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="lobsy-assistant-panel"
            data-ssr-coach-open>
        <img src="@BrandImages.ChatSilhouetteSvg" alt="" width="28" height="28" decoding="async" />
        <span class="visually-hidden">@Culture["Assistant.Open"]</span>
    </button>
</div>

@code {
    [Parameter] public bool HasBottomNav { get; set; }
}
