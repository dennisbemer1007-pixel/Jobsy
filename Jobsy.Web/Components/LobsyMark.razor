@namespace Jobsy.Web.Components
@using Jobsy.Web.Media

<span class="lobsy-mark @(Compact ? "lobsy-mark--compact" : null)" aria-hidden="true">
    <img src="@BrandImages.MarkSvg"
         alt=""
         width="@(Compact ? 14 : 18)"
         height="@(Compact ? 14 : 18)"
         decoding="async"
         draggable="false" />
</span>

@code {
    [Parameter] public bool Compact { get; set; }
}
