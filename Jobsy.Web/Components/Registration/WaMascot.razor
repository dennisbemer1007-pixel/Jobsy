@namespace Jobsy.Web.Components.Registration
@using Jobsy.Web.Components.Brand
@using Jobsy.Web.Media

<div class="wa-mascot wa-mascot--@PoseSlug @(SizeClass)" aria-hidden="true">
    <LobsyMascot Pose="@MappedPose"
                 Size="@MascotSizeValue"
                 Class="wa-mascot__svg"
                 Alt="" />
</div>

@code {
    public enum MascotPose
    {
        Waving,
        Default,
        Celebrating
    }

    [Parameter] public MascotPose Pose { get; set; } = MascotPose.Waving;
    [Parameter] public string Size { get; set; } = "md";

    private Media.MascotPose MappedPose => Pose switch
    {
        MascotPose.Celebrating => Media.MascotPose.Juichen,
        MascotPose.Default => Media.MascotPose.Rustig,
        _ => Media.MascotPose.Uitleggen,
    };

    private MascotSize MascotSizeValue => Size switch
    {
        "sm" => MascotSize.Small,
        "lg" => MascotSize.Large,
        _ => MascotSize.Medium,
    };

    private string PoseSlug => Pose.ToString().ToLowerInvariant();

    private string SizeClass => Size switch
    {
        "sm" => "wa-mascot--sm",
        "lg" => "wa-mascot--lg",
        _ => "wa-mascot--md"
    };
}
