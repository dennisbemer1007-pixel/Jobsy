@namespace Jobsy.Web.Components
@using Jobsy.Core.Localization
@inject JobsyApiClient Api
@inject CultureState Culture
@implements IDisposable

@if (IsOpen && Vacancy is not null)
{
    <div class="share-modal-backdrop" @onclick="Close"></div>
    <div class="mock-interview-modal" role="dialog" aria-modal="true" aria-labelledby="mock-interview-title" tabindex="-1" @onkeydown="OnModalKeyDown">
        <div class="share-modal__header">
            <div class="mock-interview-modal__brand">
                <LobsyCoachAvatar Class="mock-interview-modal__avatar" Language="@Culture.Language" Alt="Lobsy" />
                <div>
                    <h2 id="mock-interview-title">@Culture["MockInterview.Title"]</h2>
                    <p class="share-modal__lead">@Vacancy.Title · @Vacancy.CompanyName</p>
                </div>
            </div>
            <button type="button" class="share-modal__close" @onclick="Close" aria-label="@Culture["MockInterview.Close"]">×</button>
        </div>

        <p class="mock-interview-modal__disclaimer">
            @Culture["MockInterview.Disclaimer"]
            <a class="auth-link" href="/gebruiksvoorwaarden" target="_blank" rel="noopener">@Culture["MockInterview.DisclaimerLink"]</a>
        </p>

        @if (_started && !_busy)
        {
            <p class="mock-interview-progress">@ProgressLabel</p>
        }

        <div class="mock-interview-chat">
            @if (_messages.Count == 0 && !_busy)
            {
                <p class="mock-interview-chat__empty">@Culture["MockInterview.Empty"]</p>
            }
            @foreach (var msg in _messages)
            {
                <div class="mock-interview-bubble mock-interview-bubble--@msg.Role">
                    @if (msg.Role == "assistant")
                    {
                        <div class="mock-interview-bubble__head">
                            <LobsyCoachAvatar Class="mock-interview-bubble__avatar" Language="@Culture.Language" Alt="" Animate="false" />
                            <span class="mock-interview-bubble__role">@Culture["MockInterview.Coach"]</span>
                        </div>
                        @foreach (var block in ParseCoachBlocks(msg.Content))
                        {
                            <div class="mock-interview-block mock-interview-block--@block.Kind">
                                @if (!string.IsNullOrEmpty(block.Label))
                                {
                                    <span class="mock-interview-block__label">@block.Label</span>
                                }
                                <p>@block.Text</p>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="mock-interview-bubble__role">@Culture["MockInterview.You"]</span>
                        <p>@msg.Content</p>
                    }
                </div>
            }
            @if (_busy)
            {
                <div class="mock-interview-bubble mock-interview-bubble--assistant mock-interview-bubble--typing">
                    <div class="mock-interview-bubble__head">
                        <LobsyCoachAvatar Class="mock-interview-bubble__avatar" Language="@Culture.Language" Alt="" Animate="false" />
                        <span class="mock-interview-bubble__role">@Culture["MockInterview.Coach"]</span>
                    </div>
                    <p>@Culture["MockInterview.Typing"]</p>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error">@_error</p>
        }

        @if (_started && !_busy)
        {
            <p class="mock-interview-hint">@CurrentHint</p>
        }

        <form class="mock-interview-compose" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
            <label class="visually-hidden" for="mock-interview-input">@Culture["MockInterview.InputLabel"]</label>
            <textarea id="mock-interview-input"
                      rows="3"
                      maxlength="2000"
                      placeholder="@Culture["MockInterview.Placeholder"]"
                      disabled="@(_busy || !_started)"
                      @bind="_draft"
                      @bind:event="oninput"></textarea>
            <div class="mock-interview-compose__actions">
                <button type="button" class="engagement-btn" disabled="@_busy" @onclick="RestartAsync">@Culture["MockInterview.Restart"]</button>
                <button type="submit" class="login-submit" disabled="@(_busy || !_started || string.IsNullOrWhiteSpace(_draft))">
                    @Culture["MockInterview.Send"]
                </button>
            </div>
        </form>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public VacancyListItem? Vacancy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly List<MockInterviewChatMessage> _messages = [];
    private string _draft = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _started;
    private bool _wasOpen;
    private Guid _sessionVacancyId;
    private string _sessionLanguage = "";

    private bool _restartWhenIdle;

    private int UserAnswerCount => _messages.Count(m => m.Role == "user");

    private string ProgressLabel => UserAnswerCount switch
    {
        0 => Culture["MockInterview.Progress0"],
        1 => Culture["MockInterview.Progress1"],
        2 => Culture["MockInterview.Progress2"],
        3 => Culture["MockInterview.Progress3"],
        4 => Culture["MockInterview.Progress4"],
        _ => Culture["MockInterview.Progress5"]
    };

    private string CurrentHint => UserAnswerCount switch
    {
        0 => Culture["MockInterview.Hint0"],
        1 => Culture["MockInterview.Hint1"],
        2 => Culture["MockInterview.Hint2"],
        _ => Culture["MockInterview.Hint3"]
    };

    protected override void OnInitialized()
    {
        Culture.Changed += OnCultureChanged;
    }

    public void Dispose()
    {
        Culture.Changed -= OnCultureChanged;
    }

    private async Task OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc")
        {
            await Close();
        }
    }

    private void OnCultureChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (!IsOpen || Vacancy is null)
            {
                StateHasChanged();
                return;
            }

            if (string.Equals(_sessionLanguage, Culture.Language, StringComparison.OrdinalIgnoreCase))
            {
                StateHasChanged();
                return;
            }

            if (_busy)
            {
                _restartWhenIdle = true;
                StateHasChanged();
                return;
            }

            await StartSessionAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Vacancy is not null && (!_wasOpen || _sessionVacancyId != Vacancy.Id))
        {
            _wasOpen = true;
            _sessionVacancyId = Vacancy.Id;
            await StartSessionAsync();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
            _restartWhenIdle = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task StartSessionAsync()
    {
        if (Vacancy is null)
        {
            return;
        }

        _messages.Clear();
        _draft = string.Empty;
        _error = null;
        _started = false;
        _busy = true;
        _restartWhenIdle = false;
        _sessionLanguage = Culture.Language;
        try
        {
            var reply = await Api.ContinueMockInterviewAsync(Vacancy.Id, []);
            _messages.Add(new MockInterviewChatMessage("assistant", reply.Reply));
            _started = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        if (_restartWhenIdle
            && !string.Equals(_sessionLanguage, Culture.Language, StringComparison.OrdinalIgnoreCase))
        {
            _restartWhenIdle = false;
            await StartSessionAsync();
        }
    }

    private async Task RestartAsync()
    {
        await StartSessionAsync();
    }

    private async Task SendAsync()
    {
        if (Vacancy is null || _busy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var text = _draft.Trim();
        _draft = string.Empty;
        _error = null;
        _messages.Add(new MockInterviewChatMessage("user", text));
        _busy = true;
        try
        {
            var history = _messages
                .Select(m => new MockInterviewChatMessage(m.Role, m.Content))
                .ToList();
            var reply = await Api.ContinueMockInterviewAsync(Vacancy.Id, history);
            _messages.Add(new MockInterviewChatMessage("assistant", reply.Reply));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private IReadOnlyList<CoachBlock> ParseCoachBlocks(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return [];
        }

        var lines = content.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var blocks = new List<CoachBlock>();
        string? currentKind = null;
        string? currentLabel = null;
        var buffer = new List<string>();

        void Flush()
        {
            if (buffer.Count == 0 && currentKind is null)
            {
                return;
            }

            var text = string.Join("\n", buffer).Trim();
            if (text.Length == 0 && currentKind is null)
            {
                buffer.Clear();
                return;
            }

            blocks.Add(new CoachBlock(currentKind ?? "body", currentLabel, text));
            buffer.Clear();
            currentKind = null;
            currentLabel = null;
        }

        foreach (var raw in lines)
        {
            var line = raw.TrimEnd();
            if (TryMatchLabel(line, out var kind, out var displayKey, out var rest))
            {
                Flush();
                currentKind = kind;
                currentLabel = Culture[displayKey];
                if (!string.IsNullOrWhiteSpace(rest))
                {
                    buffer.Add(rest);
                }
                continue;
            }

            if (string.IsNullOrWhiteSpace(line) && buffer.Count == 0 && currentKind is null)
            {
                continue;
            }

            if (currentKind is null)
            {
                currentKind = "body";
            }

            buffer.Add(line);
        }

        Flush();
        return blocks.Count > 0 ? blocks : [new CoachBlock("body", null, content.Trim())];
    }

    private static bool TryMatchLabel(string line, out string kind, out string displayKey, out string rest)
    {
        kind = "";
        displayKey = "";
        rest = "";
        foreach (var (prefix, k, key) in MockInterviewLabels.AllBlockPrefixes)
        {
            if (!line.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            kind = k;
            displayKey = key;
            rest = line[prefix.Length..].Trim();
            return true;
        }

        return false;
    }

    private sealed record CoachBlock(string Kind, string? Label, string Text);
}
