@namespace Jobsy.Web.Components
@inject JobsyApiClient Api

@if (IsOpen && Vacancy is not null)
{
    <div class="share-modal-backdrop" @onclick="Close"></div>
    <div class="mock-interview-modal" role="dialog" aria-modal="true" aria-labelledby="mock-interview-title">
        <div class="share-modal__header">
            <div>
                <h2 id="mock-interview-title">Oefen je sollicitatiegesprek</h2>
                <p class="share-modal__lead">@Vacancy.Title · @Vacancy.CompanyName</p>
            </div>
            <button type="button" class="share-modal__close" @onclick="Close" aria-label="Sluiten">×</button>
        </div>

        <p class="mock-interview-modal__disclaimer">
            Coachingsgesprek op basis van deze vacature — geen echt gesprek met de werkgever.
            Deel geen BSN, bankgegevens of wachtwoorden.
            <a class="auth-link" href="/gebruiksvoorwaarden" target="_blank" rel="noopener">Chatbot-disclaimer</a>
        </p>

        @if (_started && !_busy)
        {
            <p class="mock-interview-progress">@ProgressLabel</p>
        }

        <div class="mock-interview-chat">
            @if (_messages.Count == 0 && !_busy)
            {
                <p class="mock-interview-chat__empty">Even geduld — je coach start het gesprek…</p>
            }
            @foreach (var msg in _messages)
            {
                <div class="mock-interview-bubble mock-interview-bubble--@msg.Role">
                    <span class="mock-interview-bubble__role">@(msg.Role == "user" ? "Jij" : "Coach")</span>
                    @if (msg.Role == "assistant")
                    {
                        @foreach (var block in ParseCoachBlocks(msg.Content))
                        {
                            <div class="mock-interview-block mock-interview-block--@block.Kind">
                                @if (!string.IsNullOrEmpty(block.Label))
                                {
                                    <span class="mock-interview-block__label">@block.Label</span>
                                }
                                <p>@block.Text</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p>@msg.Content</p>
                    }
                </div>
            }
            @if (_busy)
            {
                <div class="mock-interview-bubble mock-interview-bubble--assistant mock-interview-bubble--typing">
                    <span class="mock-interview-bubble__role">Coach</span>
                    <p>Ik lees mee en geef je gerichte feedback…</p>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="state-message error">@_error</p>
        }

        @if (_started && !_busy)
        {
            <p class="mock-interview-hint">@CurrentHint</p>
        }

        <form class="mock-interview-compose" @onsubmit="SendAsync" @onsubmit:preventDefault="true">
            <label class="visually-hidden" for="mock-interview-input">Jouw antwoord</label>
            <textarea id="mock-interview-input"
                      rows="3"
                      maxlength="2000"
                      placeholder="Antwoord met een concreet voorbeeld (situatie → wat jij deed → resultaat)…"
                      disabled="@(_busy || !_started)"
                      @bind="_draft"
                      @bind:event="oninput"></textarea>
            <div class="mock-interview-compose__actions">
                <button type="button" class="engagement-btn" disabled="@_busy" @onclick="RestartAsync">Opnieuw</button>
                <button type="submit" class="login-submit" disabled="@(_busy || !_started || string.IsNullOrWhiteSpace(_draft))">
                    Verstuur antwoord
                </button>
            </div>
        </form>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public VacancyListItem? Vacancy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly List<MockInterviewChatMessage> _messages = [];
    private string _draft = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _started;
    private bool _wasOpen;
    private Guid _sessionVacancyId;

    private int UserAnswerCount => _messages.Count(m => m.Role == "user");

    private string ProgressLabel => UserAnswerCount switch
    {
        0 => "Stap 1 · Beantwoord de openingsvraag",
        1 => "Stap 2 · Bouw verder op feedback",
        2 => "Stap 3 · Situatie uit de vacature",
        3 => "Stap 4 · Praktisch & beschikbaar",
        4 => "Stap 5 · Jouw vraag aan de werkgever",
        _ => "Afronding · Je hebt de oefening doorlopen"
    };

    private string CurrentHint => UserAnswerCount switch
    {
        0 => "Tip: noem iets dat letterlijk in de vacature staat en zeg waarom dat bij jou past.",
        1 => "Tip: geef één kort voorbeeld (school, sport, bijbaan of stage).",
        2 => "Tip: denk hardop — wat doe je eerst, en waarom?",
        _ => "Tip: houd het eerlijk en concreet; eindig met een zin die bij déze vacature past."
    };

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Vacancy is not null && (!_wasOpen || _sessionVacancyId != Vacancy.Id))
        {
            _wasOpen = true;
            _sessionVacancyId = Vacancy.Id;
            await StartSessionAsync();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task StartSessionAsync()
    {
        if (Vacancy is null)
        {
            return;
        }

        _messages.Clear();
        _draft = string.Empty;
        _error = null;
        _started = false;
        _busy = true;
        try
        {
            var reply = await Api.ContinueMockInterviewAsync(Vacancy.Id, []);
            _messages.Add(new MockInterviewChatMessage("assistant", reply.Reply));
            _started = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestartAsync()
    {
        await StartSessionAsync();
    }

    private async Task SendAsync()
    {
        if (Vacancy is null || _busy || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var text = _draft.Trim();
        _draft = string.Empty;
        _error = null;
        _messages.Add(new MockInterviewChatMessage("user", text));
        _busy = true;
        try
        {
            var history = _messages
                .Select(m => new MockInterviewChatMessage(m.Role, m.Content))
                .ToList();
            var reply = await Api.ContinueMockInterviewAsync(Vacancy.Id, history);
            _messages.Add(new MockInterviewChatMessage("assistant", reply.Reply));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static IReadOnlyList<CoachBlock> ParseCoachBlocks(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return [];
        }

        var lines = content.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var blocks = new List<CoachBlock>();
        string? currentKind = null;
        string? currentLabel = null;
        var buffer = new List<string>();

        void Flush()
        {
            if (buffer.Count == 0 && currentKind is null)
            {
                return;
            }

            var text = string.Join("\n", buffer).Trim();
            if (text.Length == 0 && currentKind is null)
            {
                buffer.Clear();
                return;
            }

            blocks.Add(new CoachBlock(currentKind ?? "body", currentLabel, text));
            buffer.Clear();
            currentKind = null;
            currentLabel = null;
        }

        foreach (var raw in lines)
        {
            var line = raw.TrimEnd();
            if (StartsWithLabel(line, "Let op:", out var letOp))
            {
                Flush();
                currentKind = "caution";
                currentLabel = "Let op";
                if (!string.IsNullOrWhiteSpace(letOp))
                {
                    buffer.Add(letOp);
                }
                continue;
            }

            if (StartsWithLabel(line, "Sterk:", out var sterk))
            {
                Flush();
                currentKind = "strong";
                currentLabel = "Sterk";
                if (!string.IsNullOrWhiteSpace(sterk))
                {
                    buffer.Add(sterk);
                }
                continue;
            }

            if (StartsWithLabel(line, "Tip:", out var tip))
            {
                Flush();
                currentKind = "tip";
                currentLabel = "Tip";
                if (!string.IsNullOrWhiteSpace(tip))
                {
                    buffer.Add(tip);
                }
                continue;
            }

            if (StartsWithLabel(line, "Probeer zo:", out var probeerZo))
            {
                Flush();
                currentKind = "rewrite";
                currentLabel = "Probeer zo";
                if (!string.IsNullOrWhiteSpace(probeerZo))
                {
                    buffer.Add(probeerZo);
                }
                continue;
            }

            if (StartsWithLabel(line, "Vraag:", out var vraag))
            {
                Flush();
                currentKind = "question";
                currentLabel = "Vraag";
                if (!string.IsNullOrWhiteSpace(vraag))
                {
                    buffer.Add(vraag);
                }
                continue;
            }

            if (string.IsNullOrWhiteSpace(line) && buffer.Count == 0 && currentKind is null)
            {
                continue;
            }

            if (currentKind is null)
            {
                currentKind = "body";
            }

            buffer.Add(line);
        }

        Flush();
        return blocks.Count > 0 ? blocks : [new CoachBlock("body", null, content.Trim())];
    }

    private static bool StartsWithLabel(string line, string label, out string rest)
    {
        rest = string.Empty;
        if (!line.StartsWith(label, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        rest = line[label.Length..].Trim();
        return true;
    }

    private sealed record CoachBlock(string Kind, string? Label, string Text);
}
