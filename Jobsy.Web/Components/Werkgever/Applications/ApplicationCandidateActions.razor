@namespace Jobsy.Web.Components.Werkgever.Applications
@using Jobsy.Web.Localization
@using Jobsy.Web.Models
@using Jobsy.Web.Navigation
@using Jobsy.Web.Werkgever
@inject CultureState Culture

<div class="wg-app-drawer__footer" data-testid="wg-app-footer">
    @if (!CanWrite)
    {
        <p class="wg-readonly-hint">@Culture["WgApp.RmHint"]</p>
    }
    else if (Item is not null)
    {
        var primary = ApplicationPipelineRules.PrimaryActionKey(Item);
        @if (ApplicationPipelineRules.ShowReject(Item))
        {
            <button type="button" class="btn-compact btn-compact--danger" disabled="@Busy" @onclick="OnReject">
                @Culture["WgApp.Action.Reject"]
            </button>
        }
        @if (ApplicationPipelineRules.ShowCvDownload(Item))
        {
            <button type="button" class="btn-compact" disabled="@Busy" @onclick="OnDownloadCv">
                <span aria-hidden="true">@((MarkupString)NavIcons.Download)</span>
                @Culture["WgApp.Action.Cv"]
            </button>
        }
        @if (primary is not null && !HidePrimary)
        {
            <button type="button" class="btn-compact btn-compact--primary" disabled="@Busy" @onclick="OnPrimary">
                @Culture[primary]
            </button>
        }
    }
</div>

@code {
    [Parameter] public EmployerApplicationItem? Item { get; set; }
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool HidePrimary { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnPrimary { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }
    [Parameter] public EventCallback OnDownloadCv { get; set; }
}
