@namespace Jobsy.Web.Components.Werkgever
@using Jobsy.Web.Components.Werkgever.Sections
@using Jobsy.Web.Components.Werkgever.VacancyWizard
@using Jobsy.Web.Components.Shared
@using Jobsy.Web.Components.KandidaatBanen
@using Jobsy.Web.KandidaatBanen
@implements IDisposable
@using Jobsy.Core.Enums
@using Jobsy.Core.Media
@using Jobsy.Core.Rules

<PageTitle>@PageHeading · Lobsy</PageTitle>

<div class="vac-wizard vacancy-wizard" data-testid="vacancy-wizard">
    @if (_accessDenied)
    {
        <p class="state-message error" data-testid="vacancy-access-denied">Niet gevonden of geen toegang.</p>
    }
    else if (_savedConfirmation)
    {
        <section class="vac-wizard-saved" data-testid="vacancy-draft-saved" data-vacancy-id="@(_savedVacancyId?.ToString("D"))">
            <div class="vac-wizard-saved__card">
                <div class="vac-wizard-saved__icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" width="48" height="48" role="presentation">
                        <circle cx="24" cy="24" r="24" fill="var(--success-soft)" />
                        <path d="M14 25l7 7 13-14" fill="none" stroke="var(--success)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h1>Concept opgeslagen</h1>
                <p class="vac-wizard-saved__lead">
                    Je vacature staat als concept in je vacaturelijst. Kandidaten zien hem pas als je publiceert. Publiceren kost geen tokens.
                </p>
                <dl class="vac-wizard-saved__facts">
                    <div><dt>Functie</dt><dd>@_title</dd></div>
                    @if (VacancyPublicDisplay.DisplayHourlyWage(PreviewVacancy) is decimal wage)
                    {
                        <div><dt>Loon</dt><dd>€ @wage.ToString("0.00") / uur (21+)</dd></div>
                    }
                    @if (_minHours is decimal minH && _maxHours is decimal maxH)
                    {
                        <div><dt>Uren</dt><dd>@minH–@maxH per week</dd></div>
                    }
                    <div><dt>Rooster</dt><dd>@ScheduleSummaryLabel</dd></div>
                    <div><dt>Status</dt><dd>Concept, nog niet zichtbaar</dd></div>
                </dl>
                <div class="vac-wizard-saved__actions">
                    <button type="button" class="btn btn-primary vac-wizard-saved__publish" data-testid="vacancy-publish-now" @onclick="OpenPublishAsync">
                        Nu publiceren
                    </button>
                    <button type="button" class="btn btn-secondary vac-wizard-saved__edit" @onclick="ContinueEditingFromSavedAsync">
                        Verder bewerken
                    </button>
                    <a class="btn btn-secondary vac-wizard-saved__list" href="/werkgever/vacatures">Naar vacaturelijst</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="vac-wizard__layout">
            <aside class="vac-wizard__rail" aria-labelledby="vac-wizard-rail-title">
                <h2 id="vac-wizard-rail-title" class="vac-wizard__rail-title">@PageHeading</h2>
                <p class="vac-wizard__rail-meta">Stap @_step van @TotalSteps</p>
                <ol class="vac-wizard__rail-list">
                    @foreach (var step in WizardSteps)
                    {
                        var done = step.Id < _step;
                        var current = step.Id == _step;
                        <li class="vac-wizard__rail-item @(done ? "is-done" : null) @(current ? "is-current" : null)">
                            <span class="vac-wizard__rail-dot" aria-hidden="true">@(done ? "✓" : step.Id.ToString())</span>
                            <div>
                                <strong>@step.Title</strong>
                                <small>@step.Hint</small>
                            </div>
                        </li>
                    }
                </ol>
                <p class="vac-wizard__rail-saved muted">Concept wordt lokaal bewaard tijdens je sessie.</p>
            </aside>

            <div class="vac-wizard__stage">
                <div class="vac-wizard__stage-body">
                <div class="vac-wizard__mobile-rail" aria-label="Voortgang">
                    <div class="vac-wizard__mobile-rail-top">
                        <span><b>Stap @_step</b> · @CurrentStepTitle</span>
                        <span>@_step van @TotalSteps</span>
                    </div>
                    <div class="vac-wizard__mobile-track" aria-hidden="true">
                        @for (var i = 1; i <= TotalSteps; i++)
                        {
                            <i class="@(i <= _step ? "on" : null)"></i>
                        }
                    </div>
                </div>

                <header class="vac-wizard__head">
                    <p class="vac-wizard__eyebrow">Stap @_step van @TotalSteps</p>
                    <h1>@CurrentStepTitle</h1>
                    <p class="vac-wizard__lead">@CurrentStepLead</p>
                    @if (!string.IsNullOrEmpty(_vmPublishNote) && _step == 1)
                    {
                        <p class="muted wg-vac-create-note">@_vmPublishNote</p>
                    }
                </header>

                <form id="vac-wizard-form" class="vac-wizard__form login-form" data-session-draft="true" @onsubmit="OnFormSubmitAsync" @onsubmit:preventDefault>
                    @if (_step == 1)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-1">
            @if (_isIntermediary)
            {
                <fieldset class="vacancy-intermediary">
                    <legend>Inhuurend bedrijf (verplicht)</legend>
                    <p class="muted vacancy-field-hint">
                        Zoek op bedrijfsnaam of KVK-nummer en selecteer de vestiging van de opdrachtgever.
                    </p>
                    <KvkSearchField Label="Bedrijfsnaam of KVK-nummer"
                                    SearchButtonLabel="Zoek bedrijven"
                                    OnSelected="OnClientSearchSelectedAsync"
                                    Disabled="_kvkBusy" />
                    @if (_clientEstablishments.Count > 0)
                    {
                        <label>
                            Vestiging
                            <select @bind="_selectedEstablishmentId"
                                    @bind:after="OnClientEstablishmentChangedAsync"
                                    disabled="@_kvkBusy"
                                    aria-busy="@_kvkBusy">
                                <option value="">— Kies vestiging —</option>
                                @foreach (var e in _clientEstablishments)
                                {
                                    <option value="@e.KvkEstablishmentId">@e.Name · @e.Address</option>
                                }
                            </select>
                        </label>
                    }
                    @if (_companies.Count > 0)
                    {
                        <label>
                            Bekende opdrachtgever
                            <select @bind="_companyId" @bind:after="LoadSalaryTablesAsync" required>
                                @foreach (var c in _companies)
                                {
                                    <option value="@c.Id">@c.Name@(!string.IsNullOrWhiteSpace(c.KvkNumber) ? $" · KVK {c.KvkNumber}" : "")</option>
                                }
                            </select>
                        </label>
                    }
                    @if (SelectedCompany is not null)
                    {
                        <p class="muted" style="margin:0;font-size:0.85rem">
                            Geselecteerd: <strong>@SelectedCompany.Name</strong>
                            · KVK @SelectedCompany.KvkNumber
                            @if (!string.IsNullOrWhiteSpace(SelectedCompany.KvkEstablishmentId))
                            {
                                <text> · vestiging @SelectedCompany.KvkEstablishmentId</text>
                            }
                        </p>
                    }
                    <label class="vacancy-toggle-row">
                        <input type="checkbox" @bind="_hideClientAddressOnMap" />
                        <span>
                            <strong>Vervang bedrijfsnaam en adres door die van het intermediair</strong>
                            <span class="muted">Op de banenkaart en vacaturekaartjes; opdrachtgever blijft bekend voor admin/SROI</span>
                        </span>
                    </label>
                </fieldset>
            }
            else if (_companies.Count > 1)
            {
                <label>
                    Vestiging
                    <select @bind="_companyId" @bind:after="LoadSalaryTablesAsync" required>
                        @foreach (var c in _companies)
                        {
                            <option value="@c.Id">@c.Name@(!string.IsNullOrWhiteSpace(c.KvkNumber) ? $" · KVK {c.KvkNumber}" : "")</option>
                        }
                    </select>
                </label>
            }
            <label>
                Functietitel
                <input @bind="_title" @bind:event="oninput" required />
            </label>
            @if (_isIntermediary)
            {
                <div class="vacancy-category-summary" aria-live="polite">
                    <span class="vacancy-category-swatch" style="--category-color:@(SelectedCategory?.ColorHex ?? VacancyCategoryDefaults.UitzendbureauColorHex)" aria-hidden="true"></span>
                    <div>
                        <strong>@(SelectedCategory?.Name ?? VacancyCategoryDefaults.UitzendbureauLabel)</strong>
                        <p class="muted">Vacaturetype voor intermediairs staat vast op Uitzendbureau.</p>
                    </div>
                </div>
                <fieldset>
                    <legend>Zichtbaarheid op de banenkaart</legend>
                    <p class="muted">Kandidaten zien een cirkel rond het uitzendbureau · @MapRadiusPreview</p>
                    <div class="inline-actions">
                        @foreach (var km in new[] { 2, 5, 10 })
                        {
                            var value = km;
                            <label class="checkbox-row">
                                <input type="radio" name="map-radius" checked="@(_publicMapRadiusKm == value)"
                                       @onchange="() => _publicMapRadiusKm = value" />
                                <span>@value km</span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
            else
            {
                <fieldset class="vac-wizard-field" data-testid="vacancy-category-picker">
                    <legend>Categorie</legend>
                    @if (_categories.Count == 0)
                    {
                        <p class="muted">Categorieën laden…</p>
                    }
                    else
                    {
                        <ChoiceTileGrid DesktopThreeColumns="false" Class="vac-wizard-category-grid">
                            @foreach (var cat in CategoryPickerCategories)
                            {
                                var selected = _categoryId == cat.Id.ToString("D");
                                <ChoiceTile Role="radio"
                                            Tall="true"
                                            AlignIcons="false"
                                            Selected="selected"
                                            OnClick="() => SelectCategory(cat)">
                                    <strong>@cat.Name</strong>
                                    <small>@CategoryPickerHint(cat)</small>
                                </ChoiceTile>
                            }
                        </ChoiceTileGrid>
                    }
                </fieldset>
            }
            @if (!_isIntermediary && SelectedCategory?.PlacementKind == "Internship")
            {
                <label>
                    Exclusiviteit
                    <select @bind="_exclusivitySettingId">
                        @foreach (var opt in _exclusivityOptions)
                        {
                            <option value="@opt.Id.ToString()">@opt.Name</option>
                        }
                    </select>
                </label>
                @if (SelectedExclusivity is { IsOpenOption: false } exclusive)
                {
                    <p class="muted">Deze stageplek wordt zichtbaar voor iedereen, maar alleen studenten van @exclusive.Name kunnen solliciteren.</p>
                }
            }
            @if (!_isIntermediary && SelectedCategory?.ExtraFieldDefinitions is { Count: > 0 } fields)
            {
                <fieldset class="vacancy-category-extra">
                    <legend>Extra gegevens voor @SelectedCategory.Name</legend>
                    @foreach (var field in fields.Where(f => !IsLegalStyleCategoryField(f.Key) && !IsChipCategoryField(f.Key) && !IsMergedHoursCategoryField(f.Key)))
                    {
                        @if (field.InputType == "boolean")
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@(string.Equals(GetCategoryField(field.Key), "ja", StringComparison.OrdinalIgnoreCase))"
                                       @onchange="e => SetCategoryBool(field.Key, e)" />
                                @field.Label
                            </label>
                        }
                        else if (field.InputType == "select" && field.Options is { Count: > 0 })
                        {
                            <label>
                                @field.Label
                                <select value="@GetCategoryField(field.Key)" @onchange="e => SetCategoryField(field.Key, e.Value?.ToString())">
                                    <option value="">—</option>
                                    @foreach (var opt in field.Options)
                                    {
                                        <option value="@opt">@opt</option>
                                    }
                                </select>
                            </label>
                        }
                        else if (field.InputType == "textarea")
                        {
                            <label>
                                @field.Label
                                <textarea rows="3" value="@GetCategoryField(field.Key)" @oninput="e => SetCategoryField(field.Key, e.Value?.ToString())"></textarea>
                            </label>
                        }
                        else
                        {
                            <label>
                                @field.Label
                                <input value="@GetCategoryField(field.Key)" @oninput="e => SetCategoryField(field.Key, e.Value?.ToString())" />
                            </label>
                        }
                    }
                </fieldset>
            }
            @if (SelectedCategory?.ExtraFieldDefinitions?.FirstOrDefault(f => f.Key == VacancyCategoryExtraFields.ContractType) is { } contractField)
            {
                <fieldset class="vac-wizard-field">
                    <legend>@contractField.Label</legend>
                    <ChoiceTileGrid Wrap="true">
                        @foreach (var opt in contractField.Options ?? [])
                        {
                            <ChoiceTile Label="@opt"
                                        Selected="@(GetCategoryField(contractField.Key) == opt)"
                                        Inline="true"
                                        AlignIcons="false"
                                        OnClick="() => SelectCategoryOption(contractField.Key, opt)" />
                        }
                    </ChoiceTileGrid>
                </fieldset>
            }
            @if (SelectedCategory?.ExtraFieldDefinitions?.FirstOrDefault(f => f.Key == VacancyCategoryExtraFields.ExperienceLevel) is { } expField)
            {
                <fieldset class="vac-wizard-field">
                    <legend>@expField.Label</legend>
                    <ChoiceTileGrid Wrap="true">
                        @foreach (var opt in expField.Options ?? [])
                        {
                            <ChoiceTile Label="@opt"
                                        Selected="@(GetCategoryField(expField.Key) == opt)"
                                        Inline="true"
                                        AlignIcons="false"
                                        OnClick="() => SelectCategoryOption(expField.Key, opt)" />
                        }
                    </ChoiceTileGrid>
                </fieldset>
            }
            <fieldset class="vac-wizard-field vac-wizard-field--branch">
                <legend>Branche <span class="muted">max. @WorkTypeLabels.MaxPerVacancy</span></legend>
                <ChoiceTileGrid Wrap="true" Class="vac-wizard-branch-grid">
                    @foreach (var label in BranchPickerVisibleLabels)
                    {
                        var selected = _selectedWorkTypes.Contains(label);
                        var disabled = !selected && _selectedWorkTypes.Count >= WorkTypeLabels.MaxPerVacancy;
                        <ChoiceTile Label="@label"
                                    Selected="selected"
                                    Disabled="disabled"
                                    Inline="true"
                                    AlignIcons="false"
                                    OnClick="() => ToggleWorkTypeChip(label)" />
                    }
                    @if (ShowBranchMoreChip)
                    {
                        <ChoiceTile Label="Meer…"
                                    Inline="true"
                                    AlignIcons="false"
                                    IsAdd="true"
                                    OnClick="ExpandBranchPicker" />
                    }
                </ChoiceTileGrid>
            </fieldset>
                        </div>
                    }
                    @if (_step == 2)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-2">
<VacancyRichTextEditor @bind-Value="_description" Required="true" />
                <label>
                    Afbeelding-url
                    <input @bind="_imageUrl" @bind:event="oninput" placeholder="https://…" />
                </label>
                <label>
                    Video-url
                    <input @bind="_videoUrl" @bind:event="oninput" placeholder="https://… (YouTube/Vimeo)" />
                </label>
                        </div>
                    }
                    @if (_step == 3)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-3">
            <label>
                Salaristabel
                <select @bind="_salaryTableId" required>
                    <option value="">— Kies een salaristabel —</option>
                    @foreach (var t in _salaryTables)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </label>
            @if (SelectedSalaryTable is not null)
            {
                <div class="salary-table-preview" aria-live="polite">
                    <p class="salary-table-preview__title">Voorbeeld · @SelectedSalaryTable.Name</p>
                    <table class="wage-table">
                        <thead>
                            <tr>
                                <th>Leeftijd</th>
                                <th>Uurloon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rate in SelectedSalaryTable.Rates.OrderBy(r => r.AgeYears))
                            {
                                <tr>
                                    <th>@rate.Label</th>
                                    <td>€ @rate.HourlyRate.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <fieldset class="vacancy-hours">
                <legend class="visually-hidden">Uren per week</legend>
                <div class="vacancy-hours__row">
                    <span class="vacancy-hours__title">Uren per week</span>
                    <label>
                        Min
                        <input type="number" min="1" max="60" step="0.5" @bind="_minHours" @bind:event="oninput" />
                    </label>
                    <span class="vacancy-hours__sep" aria-hidden="true">–</span>
                    <label>
                        Max
                        <input type="number" min="1" max="60" step="0.5" @bind="_maxHours" @bind:event="oninput" />
                    </label>
                    @if (_minHours is decimal minH && _maxHours is decimal maxH && maxH >= minH)
                    {
                        <span class="vacancy-hours__meta muted">@HoursRangeRules.CategoryLabel(new HoursRange(minH, maxH).Category)</span>
                    }
                </div>
            </fieldset>

                        </div>
                    }
                    @if (_step == 4)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-4">
            <VacancyWizardScheduleFields FlexibleTimes="_flexibleTimes"
                                         FlexibleTimesChanged="OnFlexibleTimesChangedBool"
                                         ScheduleSlots="_scheduleSlots"
                                         ToggleSlot="ToggleScheduleSlotFromChipAsync" />
            <fieldset class="vacancy-legal">
                <legend>Werkzaamheden &amp; wetgeving</legend>
                <p class="muted vacancy-field-hint">Bepaalt automatisch of jongeren (15–17) mogen solliciteren.</p>
                <ul class="vacancy-legal__list">
                    @foreach (var flag in LegalTaskFlags.Catalog)
                    {
                        var isOn = GetLegalFlag(flag.Code);
                        var tipOpen = _openLegalTip == flag.Code;
                        <li class="vacancy-legal__item @(tipOpen ? "is-open" : null)">
                            <input id="@($"legal-{flag.Code}")"
                                   class="vacancy-legal__check"
                                   type="checkbox"
                                   checked="@isOn"
                                   @onchange="e => SetLegalFlag(flag.Code, e)" />
                            <label class="vacancy-legal__text" for="@($"legal-{flag.Code}")">@flag.Label</label>
                            <button type="button"
                                    class="vacancy-legal__info"
                                    title="@flag.Tooltip"
                                    aria-label="@($"Toelichting: {flag.Label}")"
                                    aria-expanded="@tipOpen"
                                    @onclick="() => ToggleLegalTip(flag.Code)">
                                i
                            </button>
                            @if (tipOpen)
                            {
                                <span class="vacancy-legal__tip">@flag.Tooltip</span>
                            }
                        </li>
                    }
                </ul>
            </fieldset>
                        </div>
                    }
                    @if (_step == 5)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-5">
            <fieldset class="profile-roles">
                <legend>Vereist rijbewijs (optioneel)</legend>
                @foreach (var license in _licenseOptions)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_selectedLicenses.Contains(license)"
                               @onchange="e => ToggleLicense(license, e)" />
                        @license
                    </label>
                }
            </fieldset>
            <fieldset class="profile-roles">
                <legend>Vereist opleidingsniveau (optioneel)</legend>
                @foreach (var level in _educationOptions)
                {
                    <label>
                        <input type="checkbox"
                               checked="@_selectedEducationLevels.Contains(level)"
                               @onchange="e => ToggleEducation(level, e)" />
                        @level
                    </label>
                }
            </fieldset>
            <fieldset class="vacancy-barrier">
                <legend>@Culture["Employer.Barrier.Legend"]</legend>
                <p class="muted vacancy-field-hint">@Culture["Employer.Barrier.Hint"]</p>
                <div class="profile-min-employers__options" role="radiogroup" aria-label="@Culture["Employer.Barrier.Legend"]">
                    <label>
                        <input type="radio" name="barrier" checked="@(!_barrierHigh)" @onchange="() => SetBarrierHigh(false)" />
                        @Culture["Employer.Barrier.Low"]
                    </label>
                    <label>
                        <input type="radio" name="barrier" checked="@_barrierHigh" @onchange="() => SetBarrierHigh(true)" />
                        @Culture["Employer.Barrier.High"]
                    </label>
                </div>
                @if (_barrierHigh)
                {
                    <label>
                        @Culture["Employer.Barrier.Diplomas"]
                        <textarea rows="3" @bind="_barrierDiplomas" @bind:event="oninput" placeholder="MBO Verpleegkunde"></textarea>
                    </label>
                    <p class="muted vacancy-field-hint">@Culture["Employer.Barrier.HardHint"]</p>
                    <div class="profile-min-employers__options" role="group" aria-label="@Culture["Employer.Barrier.HardChecks"]">
                        @foreach (var check in VacancyHardCheckCatalog.Suggested)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@_barrierHardChecks.Contains(check.Kind)"
                                       @onchange="e => ToggleHardCheck(check.Kind, e)" />
                                @check.Label
                            </label>
                        }
                    </div>
                    <p class="muted vacancy-field-hint">@Culture["Employer.Barrier.Certs"]</p>
                    <div class="profile-min-employers__options" role="group">
                        @foreach (var cert in VacancyBarrierCatalog.SuggestedCertifications)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@_barrierCerts.Contains(cert)"
                                       @onchange="e => ToggleBarrierCert(cert, e)" />
                                @cert
                            </label>
                        }
                    </div>
                    <label>
                        Extra certificaten (komma)
                        <input @bind="_barrierCertExtra" @bind:event="oninput" placeholder="VCA, BIG" />
                    </label>
                    <div class="vacancy-hours__row">
                        <label>
                            @Culture["Employer.Barrier.Years"]
                            <input type="number" min="0" max="40" @bind="_barrierYears" @bind:event="oninput" />
                        </label>
                        <label>
                            @Culture["Employer.Barrier.Hours"]
                            <input type="number" min="0" max="80000" step="100" @bind="_barrierHours" @bind:event="oninput" />
                        </label>
                    </div>
                }
            </fieldset>
            <fieldset class="profile-min-employers">
                <legend>Minimaal aantal werkgevers</legend>
                <div class="profile-min-employers__options" role="radiogroup" aria-label="Minimaal aantal werkgevers">
                    <label>
                        <input type="radio" name="min-employers" checked="@(_minimumEmployers is null)" @onchange="() => SetMinimumEmployers(null)" />
                        Geen
                    </label>
                    @foreach (var n in _minEmployerOptions)
                    {
                        <label>
                            <input type="radio" name="min-employers" checked="@(_minimumEmployers == n)" @onchange="() => SetMinimumEmployers(n)" />
                            @n
                        </label>
                    }
                </div>
            </fieldset>
            <fieldset class="profile-min-employers">
                <legend>Minimaal aantal recensies</legend>
                <p class="muted vacancy-field-hint">Standaard geen. Bij 1 of meer is dit een harde eis: solliciteren kan pas als het kandidaatprofiel zoveel complete recensies heeft.</p>
                <div class="profile-min-employers__options" role="radiogroup" aria-label="Minimaal aantal recensies">
                    <label>
                        <input type="radio" name="min-references" checked="@(_minimumReferences is null)" @onchange="() => SetMinimumReferences(null)" />
                        Geen
                    </label>
                    @foreach (var n in _minReferenceOptions)
                    {
                        <label>
                            <input type="radio" name="min-references" checked="@(_minimumReferences == n)" @onchange="() => SetMinimumReferences(n)" />
                            @n
                        </label>
                    }
                </div>
            </fieldset>
            <fieldset class="profile-roles vacancy-culture">
                <legend>@Culture["WaProfile.Vacancy.Section"]</legend>
                @if (_companyCultureSummary is null && !_teamOverride)
                {
                    <p class="muted vacancy-field-hint">
                        @Culture["WaProfile.Vacancy.NoProfile"]
                        <a href="/register/bedrijf?stap=cultuur">@Culture["WaProfile.Vacancy.EditLink"]</a>
                    </p>
                }
                else if (!_teamOverride)
                {
                    <label class="vacancy-toggle-row">
                        <input type="checkbox" checked="@(!_teamOverride)" @onchange="e => SetTeamOverride(!(e.Value as bool? ?? false))" />
                        <span>
                            <strong>@string.Format(Culture["WaProfile.Vacancy.InheritTitle"], _companyCultureName)</strong>
                            <span class="muted">@Culture["WaProfile.Vacancy.InheritHint"]</span>
                        </span>
                    </label>
                    @if (_companyCultureSummary is not null)
                    {
                        <div class="wa-prof vacancy-culture__summary" aria-label="@Culture["WaProfile.Cultuur.ProfileTitle"]">
                            @foreach (var (label, pct) in _companyCultureSummary)
                            {
                                <div><b>@pct%</b>@label</div>
                            }
                        </div>
                        @if (_companyValueLabels.Count > 0)
                        {
                            <div class="wa-toprow wa-toprow--gap">
                                @foreach (var v in _companyValueLabels)
                                {
                                    <span class="wa-pill">@v</span>
                                }
                                <a class="wa-link" href="/werkgever/organisatie/profiel?tab=cultuur">@Culture["WaProfile.Vacancy.EditLink"]</a>
                            </div>
                        }
                    }
                    <button type="button" class="btn ghost" @onclick="() => SetTeamOverride(true)">
                        @Culture["WaProfile.Vacancy.Override"]
                        <span class="pill">@Culture["WaProfile.Vacancy.Optional"]</span>
                    </button>
                }
                else
                {
                    <label class="vacancy-toggle-row">
                        <input type="checkbox" checked="@_teamOverride" @onchange="e => SetTeamOverride(e.Value as bool? ?? false)" />
                        <span>
                            <strong>@Culture["WaProfile.Vacancy.Override"]</strong>
                            <span class="muted">@Culture["WaProfile.Vacancy.OverrideHint"]</span>
                        </span>
                    </label>
                    <p class="muted vacancy-field-hint">@Culture["Employer.Culture.Hint"]</p>
                    <div class="profile-min-employers__options" role="group" aria-label="@Culture["Employer.Culture.Legend"]">
                        @foreach (var pillar in CulturePillarCatalog.All)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@_selectedCulturePillars.Contains(pillar.Id)"
                                       @onchange="e => ToggleCulturePillar(pillar.Id, e)" />
                                @Culture[pillar.LabelKey]
                            </label>
                        }
                    </div>
                    @if (_cultureError)
                    {
                        <p class="state-message error">@Culture["Employer.Culture.Error"]</p>
                    }
                }
            </fieldset>
            <fieldset class="vacancy-contact">
                <legend>Voorkeur voor contact</legend>
                <p class="muted vacancy-field-hint">
                    Directe contactopties (WhatsApp/telefoon) verschijnen voor kandidaten pas na een succesvolle sollicitatie.
                </p>
                @if (SelectedCompany is not null)
                {
                    <p class="vacancy-contact__company">
                        Bedrijf:
                        @(SelectedCompany.DirectContactEnabled
                            ? $"direct contact aan ({string.Join(", ", CompanyChannelLabels(SelectedCompany))})"
                            : "direct contact uit")
                    </p>
                }
                <ul class="vacancy-legal__list">
                    <li class="vacancy-legal__item vacancy-legal__item--plain">
                        <input id="vacancy-direct-contact"
                               class="vacancy-legal__check"
                               type="checkbox"
                               @bind="_vacancyDirectContact"
                               @bind:after="OnVacancyDirectContactChanged" />
                        <label class="vacancy-legal__text" for="vacancy-direct-contact">
                            Direct contact gewenst
                            <span class="muted">Mail, telefoon of WhatsApp tonen na sollicitatie</span>
                        </label>
                    </li>
                </ul>
                @if (_vacancyDirectContact)
                {
                    <div class="vacancy-contact__channels" role="group" aria-label="Contactkanalen">
                        <label class="vacancy-contact__channel">
                            <input type="checkbox" @bind="_vacancyPreferMail" />
                            Mail
                        </label>
                        <label class="vacancy-contact__channel">
                            <input type="checkbox" @bind="_vacancyPreferPhone" />
                            Telefoon
                        </label>
                        <label class="vacancy-contact__channel">
                            <input type="checkbox" @bind="_vacancyPreferWhatsApp" />
                            WhatsApp
                        </label>
                    </div>
                }
            </fieldset>

            <fieldset class="vacancy-contact">
                <legend>E-mailcheck bij solliciteren</legend>
                <p class="muted vacancy-field-hint">
                    Standaard uit, zodat kandidaten meteen kunnen solliciteren.
                    Alleen aanzetten als je een extra bevestiging via e-mail wilt.
                </p>
                <ul class="vacancy-legal__list">
                    <li class="vacancy-legal__item vacancy-legal__item--plain">
                        <input id="vacancy-email-verification"
                               class="vacancy-legal__check"
                               type="checkbox"
                               @bind="_requireEmailVerification" />
                        <label class="vacancy-legal__text" for="vacancy-email-verification">
                            Vraag e-mailbevestiging
                            <span class="muted">Kandidaat krijgt een korte code per mail vóór de sollicitatie definitief is</span>
                        </label>
                    </li>
                </ul>
            </fieldset>

                        </div>
                    }
                    @if (_step == 6)
                    {
                        <div class="vac-wizard__step" data-testid="vac-wizard-step-6">
                            <p class="muted">Controleer je gegevens. Sla op als concept — publiceren kan daarna vanaf deze pagina of via de vacaturelijst.</p>
                            <dl class="vac-wizard-review">
                                <div><dt>Functietitel</dt><dd>@_title</dd></div>
                                <div><dt>Vestiging</dt><dd>@SelectedCompanyName</dd></div>
                                <div><dt>Branche</dt><dd>@string.Join(", ", _selectedWorkTypes)</dd></div>
                                <div><dt>Omschrijving</dt><dd>@(_description.Length) tekens</dd></div>
                                <div><dt>Salaristabel</dt><dd>@(SelectedSalaryTable?.Name ?? "—")</dd></div>
                                <div><dt>Uren</dt><dd>@(_minHours?.ToString("0.#") ?? "—")–@(_maxHours?.ToString("0.#") ?? "—") per week</dd></div>
                                <div><dt>Rooster</dt><dd>@ScheduleSummaryLabel</dd></div>
                            </dl>
                            <button type="button" class="btn ghost" data-testid="vacancy-preview-open-review" @onclick="OpenPreviewDesktopAsync">
                                Bekijk als kandidaat
                            </button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_stepMessage))
                    {
                        <p class="state-message error" role="alert">@_stepMessage</p>
                    }
                </form>

                @if (_proactiveMatchingOn && _editVacancyId is Guid shortlistVacancyId)
                {
                    <section class="proactive-shortlist-promo" aria-labelledby="proactive-shortlist-promo-title">
                        <h2 id="proactive-shortlist-promo-title">@Culture["ProactiveMatching.Employer.Shortlist.Title"]</h2>
                        <p>@Culture["ProactiveMatching.Employer.Shortlist.PromoLead"]</p>
                        <a class="login-submit proactive-shortlist-promo__cta"
                           href="@($"/werkgever/vacatures/{shortlistVacancyId:D}/proactieve-shortlist")">
                            @Culture["ProactiveMatching.Employer.Shortlist.OpenPage"]
                        </a>
                    </section>
                }
                </div>
                    <footer class="vac-wizard-actionbar" data-testid="vacancy-wizard-actionbar">
                        <div class="vac-wizard-actionbar__mobile">
                            @if (_step > 1)
                            {
                                <button type="button" class="btn btn-secondary vac-wizard-actionbar__icon-btn vac-wizard__back" aria-label="Terug" @onclick="GoBackAsync">
                                    <span aria-hidden="true">‹</span>
                                </button>
                            }
                            else
                            {
                                <span class="vac-wizard-actionbar__icon-spacer" aria-hidden="true"></span>
                            }
                            <button type="button"
                                    class="btn btn-secondary vac-wizard-actionbar__icon-btn vac-wizard__preview-actionbar"
                                    data-testid="vacancy-preview-actionbar"
                                    aria-label="Bekijk als kandidaat"
                                    @onclick="OpenPreviewFromActionBarAsync">
                                <span class="vac-wizard__preview-actionbar-icon" aria-hidden="true">👁</span>
                                <span class="vac-wizard__preview-actionbar-label">Bekijk</span>
                            </button>
                            <button type="button"
                                    class="btn btn-secondary vac-wizard-actionbar__save-btn vac-wizard__save-inline"
                                    disabled="@_saving"
                                    @onclick="SaveAsync"
                                    data-testid="vacancy-save-draft">
                                <span class="vac-wizard-actionbar__save-icon" aria-hidden="true">💾</span>
                                <span>@(_saving ? "Opslaan…" : "Opslaan")</span>
                            </button>
                            @if (_step < TotalSteps)
                            {
                                <button type="button"
                                        class="btn btn-primary vac-wizard__next vac-wizard-actionbar__next-btn"
                                        aria-label="@NextStepButtonLabel"
                                        @onclick="GoNextAsync">
                                    Volgende
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary vac-wizard__save vac-wizard-actionbar__next-btn" type="submit" form="vac-wizard-form" disabled="@_saving" data-testid="vacancy-save-draft-submit">
                                    @(_saving ? "Opslaan…" : "Opslaan")
                                </button>
                            }
                        </div>
                        <div class="vac-wizard-actionbar__desktop">
                            <div class="vac-wizard-actionbar__left">
                                @if (_step > 1)
                                {
                                    <button type="button" class="btn btn-secondary vac-wizard__back" @onclick="GoBackAsync">Terug</button>
                                }
                                <span class="vac-wizard-actionbar__step muted">Stap @_step van @TotalSteps</span>
                            </div>
                            <div class="vac-wizard-actionbar__right">
                                <button type="button"
                                        class="btn btn-secondary vac-wizard__preview-actionbar"
                                        data-testid="vacancy-preview-actionbar"
                                        @onclick="OpenPreviewFromActionBarAsync">
                                    <span class="vac-wizard__preview-actionbar-icon" aria-hidden="true">👁</span>
                                    <span class="vac-wizard__preview-actionbar-label">Bekijk als kandidaat</span>
                                </button>
                                <button type="button" class="btn btn-secondary vac-wizard__save-inline" disabled="@_saving" @onclick="SaveAsync" data-testid="vacancy-save-draft">
                                    @(_saving ? "Opslaan…" : "Opslaan als concept")
                                </button>
                                @if (_step < TotalSteps)
                                {
                                    <button type="button" class="btn btn-primary vac-wizard__next" @onclick="GoNextAsync">@NextStepButtonLabel</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary vac-wizard__save" type="submit" form="vac-wizard-form" disabled="@_saving" data-testid="vacancy-save-draft-submit">
                                        @(_saving ? "Opslaan…" : "Opslaan als concept")
                                    </button>
                                }
                            </div>
                        </div>
                    </footer>
            </div>

            <aside class="vac-wizard__preview-aside" aria-label="Live voorbeeld">
                <p class="vac-wizard__preview-label">Zo ziet een kandidaat je vacature</p>
                <article class="vac-wizard-preview-card" data-testid="vacancy-live-preview-card">
                    <h3>@(string.IsNullOrWhiteSpace(_title) ? "Functietitel…" : _title)</h3>
                    <p class="muted">@SelectedCompanyName · @string.Join(" · ", _selectedWorkTypes.Take(2))</p>
                    @if (VacancyPublicDisplay.DisplayHourlyWage(PreviewVacancy) is decimal pw)
                    {
                        <p><strong>€ @pw.ToString("0.00") / uur</strong></p>
                    }
                    @if (_minHours is decimal pmin && _maxHours is decimal pmax)
                    {
                        <p class="muted">@pmin–@pmax uur</p>
                    }
                    <p class="muted">@ScheduleSummaryLabel</p>
                </article>
                <h4 class="vac-wizard__checklist-title">Nodig om te publiceren</h4>
                <ul class="vac-wizard__checklist">
                    <li class="@(ChecklistTitleOk ? "is-ok" : null)">Functietitel en categorie</li>
                    <li class="@(ChecklistDescriptionOk ? "is-ok" : null)">Omschrijving</li>
                    <li class="@(ChecklistSalaryOk ? "is-ok" : null)">Loon en uren</li>
                    <li class="@(ChecklistScheduleOk ? "is-ok" : null)">Rooster of 'tijden in overleg'</li>
                </ul>
                <button type="button" class="btn btn-secondary vac-wizard__preview" data-testid="vacancy-preview-open" @onclick="OpenPreviewDesktopAsync">
                    Bekijk als kandidaat
                </button>
            </aside>
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="state-message error">@_message</p>
    }
</div>

<VacancyCandidatePreviewOverlay IsOpen="_previewOpen"
                                Vacancy="PreviewVacancy"
                                MobileSheet="_previewMobileSheet"
                                OnClose="ClosePreviewAsync" />

<PublishOptionsDialog IsOpen="_publishOpen"
                      Vacancy="_publishVacancy"
                      OnClose="ClosePublishAsync"
                      OnPublished="OnPublishedAsync" />

@if (_moderationOpen)
{
    <LobsyFriendlyDialog IsOpen="true"
                         Title="Even aanpassen"
                         TitleId="moderation-title"
                         Lead="We hebben de tekst bekeken voordat we opslaan."
                         Class="moderation-modal"
                         OnClose="CloseModeration">
        <p class="moderation-modal__warning">@_moderationWarning</p>
        @if (!string.IsNullOrWhiteSpace(_moderationSuggestion))
        {
            <div class="moderation-modal__suggestion">
                <strong>Tip</strong>
                <p>@_moderationSuggestion</p>
            </div>
        }
        <div class="inline-actions">
            <button type="button" class="login-submit" @onclick="CloseModeration">Tekst aanpassen</button>
        </div>
    </LobsyFriendlyDialog>
}
