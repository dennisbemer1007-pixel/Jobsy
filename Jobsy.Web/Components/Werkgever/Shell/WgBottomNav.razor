@using Jobsy.Core.Features
@using Jobsy.Web.Components.Ui.Enterprise
@using Jobsy.Web.Navigation
@using Jobsy.Web.Werkgever
@using Microsoft.AspNetCore.Http
@inject CultureState Culture
@inject IFeatureFlags FeatureFlags
@inject NavigationManager Navigation
@inject EmployerScopeState Scope
@inject EmployerScopeBootstrap ScopeBootstrap
@inject WerkgeverCountsState Counts
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<nav class="wg-bottom-nav" aria-label="@Culture["WgShell.BottomNav"]">
    <ul class="wg-bottom-nav__list">
        @foreach (var item in Items)
        {
            var isMeer = item.Key == "meer";
            var active = !isMeer && IsActive(item);
            var count = CountFor(item);
            <li>
                @if (isMeer)
                {
                    @if (StaticChrome)
                    {
                        <button type="button"
                                class="wg-bottom-nav__link"
                                data-wg-meer-toggle="1"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                                aria-controls="wg-meer-panel">
                            <span class="wg-bottom-nav__icon" aria-hidden="true">@((MarkupString)item.Svg)</span>
                            <span>@Culture[item.LabelKeyFor(Role)]</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="wg-bottom-nav__link @(_meerOpen ? "is-active" : null)"
                                @onclick="() => _meerOpen = true">
                            <span class="wg-bottom-nav__icon" aria-hidden="true">@((MarkupString)item.Svg)</span>
                            <span>@Culture[item.LabelKeyFor(Role)]</span>
                        </button>
                    }
                }
                else
                {
                    <a class="wg-bottom-nav__link @(active ? "is-active" : null)"
                       href="@item.Href"
                       aria-current="@(active ? "page" : null)">
                        <span class="wg-bottom-nav__icon" aria-hidden="true">@((MarkupString)item.Svg)</span>
                        <span>@Culture[item.LabelKeyFor(Role)]</span>
                        @if (count > 0)
                        {
                            <span class="wg-bottom-nav__count">@count</span>
                        }
                    </a>
                }
            </li>
        }
    </ul>
</nav>

@if (StaticChrome)
{
    <div class="ent-drawer-backdrop" data-wg-meer-backdrop hidden></div>
    <aside id="wg-meer-panel"
           class="ent-drawer ent-drawer--start ent-drawer--sheet"
           data-wg-meer-panel
           role="dialog"
           aria-modal="true"
           aria-label="@Culture["WgShell.MoreSheet"]"
           hidden>
        <header class="ent-drawer__header">
            <h2 class="ent-drawer__title">@Culture["WgShell.MoreSheet"]</h2>
            <button type="button" class="ent-drawer__close" data-wg-meer-close="1"
                    aria-label="@Culture["EntUi.CloseDrawer"]">
                <span aria-hidden="true">@((MarkupString)NavIcons.Close)</span>
            </button>
        </header>
        <div class="ent-drawer__body">
            @foreach (var group in SidebarGroups)
            {
                <p class="wg-sidebar__group-label">@Culture[group.LabelKeyFor(Role)]</p>
                <ul class="wg-sidebar__items">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a class="wg-sidebar__link" href="@item.Href">
                                <span class="wg-sidebar__icon" aria-hidden="true">@((MarkupString)item.Svg)</span>
                                @Culture[item.LabelKeyFor(Role)]
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
}
else
{
    <EntDrawer Open="_meerOpen" OpenChanged="OnMeerChanged" Title="@Culture["WgShell.MoreSheet"]" FullSheet="true" Placement="start">
        @foreach (var group in SidebarGroups)
        {
            <p class="wg-sidebar__group-label">@Culture[group.LabelKeyFor(Role)]</p>
            <ul class="wg-sidebar__items">
                @foreach (var item in group.Items)
                {
                    <li>
                        <a class="wg-sidebar__link" href="@item.Href" @onclick="CloseMeer">
                            <span class="wg-sidebar__icon" aria-hidden="true">@((MarkupString)item.Svg)</span>
                            @Culture[item.LabelKeyFor(Role)]
                        </a>
                    </li>
                }
            </ul>
        }
    </EntDrawer>
}

@code {
    private bool _meerOpen;
    private bool _bootstrapped;
    private bool _kandidatenkaartEnabled;
    private bool _companyMapInitiativeEnabled;

    private bool StaticChrome => !RendererInfo.IsInteractive;
    private EmployerRole Role => Scope.DisplayRole(HttpContextAccessor.HttpContext?.User);
    private WerkgeverNavContext Ctx => new(
        CandidateInsightsEnabled: true,
        KandidatenkaartEnabled: _kandidatenkaartEnabled,
        CompanyMapInitiativeEnabled: _companyMapInitiativeEnabled,
        HasMaqqieHours: Counts.MaqqieHoursNavVisible,
        Counts: Counts.Counts);
    private IReadOnlyList<WerkgeverNavItem> Items => WerkgeverNav.MobileItems(Role, Ctx);
    private IReadOnlyList<WerkgeverNavGroup> SidebarGroups => WerkgeverNav.For(Role, Ctx);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLoc;
        Counts.Changed += OnCounts;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_bootstrapped)
        {
            return;
        }

        _bootstrapped = true;
        await ScopeBootstrap.EnsureLoadedAsync();
        await Counts.RefreshIfStaleAsync();
        var flags = await FeatureFlags.GetAsync();
        _kandidatenkaartEnabled = flags.IsEnabled(PlatformFeature.Kandidatenkaart);
        _companyMapInitiativeEnabled = flags.IsEnabled(PlatformFeature.CompanyMapInitiative);
    }

    private void OnLoc(object? s, LocationChangedEventArgs e)
        => InvokeAsync(async () =>
        {
            await Counts.RefreshIfStaleAsync();
            StateHasChanged();
        });

    private void OnCounts() => InvokeAsync(StateHasChanged);

    private string CurrentPath()
        => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private bool IsActive(WerkgeverNavItem item)
        => WerkgeverNav.IsNavItemActive(item, CurrentPath());

    private int CountFor(WerkgeverNavItem item)
    {
        if (string.IsNullOrEmpty(item.CountKey))
        {
            return 0;
        }

        return Counts.Counts.TryGetValue(item.CountKey, out var n) ? n : 0;
    }

    private Task OnMeerChanged(bool open)
    {
        _meerOpen = open;
        return Task.CompletedTask;
    }

    private void CloseMeer() => _meerOpen = false;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLoc;
        Counts.Changed -= OnCounts;
    }
}
