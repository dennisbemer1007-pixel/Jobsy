@using Jobsy.Web.Navigation
@using Jobsy.Web.Werkgever
@inject CultureState Culture
@inject NavigationManager Navigation
@inject EmployerScopeState Scope

<nav class="wg-crumbs" aria-label="@Culture["WgShell.Breadcrumb"]">
    @if (!string.IsNullOrWhiteSpace(Scope.Label))
    {
        <span>@Scope.Label</span>
        <span class="wg-crumbs__sep" aria-hidden="true">›</span>
    }
    @{
        var crumbs = WerkgeverNav.Crumbs(CurrentPath(), Role, CrumbDetail);
        for (var i = 0; i < crumbs.Count; i++)
        {
            var c = crumbs[i];
            if (i > 0)
            {
                <span class="wg-crumbs__sep" aria-hidden="true">›</span>
            }
            if (c.Href is not null && !c.IsCurrent)
            {
                <a href="@c.Href">@Culture[c.LabelKey]</a>
            }
            else
            {
                <span aria-current="@(c.IsCurrent ? "page" : null)">@Culture[c.LabelKey]</span>
            }
        }
    }
</nav>

<div class="wg-page-header">
    <div class="wg-page-header__titles">
        <h1>@(Title ?? DefaultTitle)</h1>
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p class="wg-page-header__lead">@Lead</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="wg-page-header__actions">@Actions</div>
    }
</div>

@if (ShowReadOnlyHint)
{
    <p class="wg-readonly-hint" role="status">@Culture["WgShell.ReadOnlyHint"]</p>
}

@ChildContent

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? CrumbDetail { get; set; }
    [Parameter] public bool? ReadOnlyHint { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private EmployerRole Role => Scope.Role ?? EmployerRole.Bedrijfsmanager;

    private string CurrentPath()
        => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private string DefaultTitle
    {
        get
        {
            var resolved = WerkgeverNav.Resolve(CurrentPath());
            return resolved is null ? "" : Culture[resolved.Value.Item.LabelKeyFor(Role)];
        }
    }

    private bool ShowReadOnlyHint
    {
        get
        {
            if (ReadOnlyHint.HasValue)
            {
                return ReadOnlyHint.Value;
            }

            if (Role != EmployerRole.Regiomanager)
            {
                return false;
            }

            var resolved = WerkgeverNav.Resolve(CurrentPath());
            return resolved?.Item.Visibility.For(Role) == RoleVisibilityKind.ReadOnly;
        }
    }
}
