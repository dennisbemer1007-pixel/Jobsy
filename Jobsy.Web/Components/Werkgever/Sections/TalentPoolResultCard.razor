@namespace Jobsy.Web.Components.Werkgever.Sections
@using Jobsy.Core.Rules
@using Jobsy.Web.Models
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

<div class="detail-card" data-testid="talent-card">
    <p><strong>@Card.RegionLabel</strong> · @(Card.TravelMinutes is int m ? $"{m} min" : "reistijd onbekend")</p>
    <p data-testid="talent-tags">Tags: @string.Join(", ", DisplayTags)</p>
    @if (ShowRiasec && !string.IsNullOrWhiteSpace(Card.HollandCode))
    {
        <p data-testid="talent-holland">Holland-code: @Card.HollandCode</p>
    }
    <p data-testid="talent-availability">@(Card.AvailabilitySummary ?? UnknownAvailability)</p>
    <p>Rijbewijs: @(Card.DrivingLicenses.Count == 0 ? "—" : string.Join(", ", Card.DrivingLicenses))</p>
    @if (CanMutate)
    {
        <button class="login-submit" type="button" @onclick="() => OnUnlock.InvokeAsync(Card.CandidateUserId)">
            @UnlockLabel
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public AnonymousTalentCard Card { get; set; } = default!;
    [Parameter] public bool ShowRiasec { get; set; }
    [Parameter] public bool CanMutate { get; set; }
    [Parameter] public string UnlockLabel { get; set; } = "";
    [Parameter] public EventCallback<Guid> OnUnlock { get; set; }

    private string UnknownAvailability
        => Services.GetService<CultureState>()?["Talent.AvailabilityUnknown"]
           ?? "Beschikbaarheid onbekend";

    private IEnumerable<string> DisplayTags
    {
        get
        {
            IEnumerable<string> tags = ShowRiasec
                ? Card.MatchTags.Concat(Card.RiasecTags)
                : Card.MatchTags.Where(t => !TalentPoolRiasecVisibility.IsCareerTestOutput(t));
            return tags.Distinct(StringComparer.OrdinalIgnoreCase);
        }
    }
}
