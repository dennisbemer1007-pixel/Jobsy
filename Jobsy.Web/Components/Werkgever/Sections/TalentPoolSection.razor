@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject JobsyApiClient Api
@inject CultureState Culture
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Configuration
@using Microsoft.Extensions.Configuration
@using Jobsy.Core.Authorization
@using Jobsy.Core.Enums
@using Jobsy.Core.Rules
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Culture["Talent.Title"] · Lobsy</PageTitle>

<div class="panel-page">
<header class="saved-gate__header">
        <h1>@Culture["Talent.Title"]</h1>
        <p class="login-lead">@Culture["Talent.Lead"]</p>
        <p class="profile-address__hint">@Culture["Talent.NoAge"]</p>
        @if (!_canMutate)
        {
            <p class="profile-address__hint">@Culture["Employer.RegionalReadOnlyNotice"]</p>
        }
        <p><a href="/werkgever/talentpool?tab=contact">@Culture["Talent.EmployerContactsTitle"]</a></p>
    </header>

    <article class="detail-card">
        <form class="login-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            @if (ShowRiasecTagFilter)
            {
                <label>
                    Tags (competenties / RIASEC)
                    <input @bind="_tags" placeholder="Samenwerken, Social" />
                </label>
            }
            <label>
                Max. reistijd (min)
                <input type="number" min="1" max="180" @bind="_maxTravel" />
            </label>
            <label>
                Vervoer
                <select @bind="_transport">
                    <option value="@TransportLabels.Bike">@Culture["Transport.Bike"]</option>
                    <option value="@TransportLabels.EBike">@Culture["Transport.EBike"]</option>
                    <option value="@TransportLabels.Car">@Culture["Transport.Car"]</option>
                    <option value="@TransportLabels.PublicTransport">@Culture["Transport.Transit"]</option>
                    <option value="@TransportLabels.Walking">@Culture["Transport.Walk"]</option>
                </select>
            </label>
            <label>
                Beschikbaarheid
                <select @bind="_availability">
                    <option value="">Alle</option>
                    <option value="direct">Per direct</option>
                    <option value="parttime">Parttime</option>
                    <option value="fulltime">Fulltime</option>
                    <option value="seizoen">Seizoenswerk</option>
                </select>
            </label>
            <label>
                Rijbewijs
                <input @bind="_license" placeholder="B" />
            </label>
            <button class="login-submit" type="submit" disabled="@_loading">Zoeken</button>
        </form>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="state-message">@_message</p>
        }

        @if (_results.Count == 0 && !_loading)
        {
            <p class="state-message">Geen anonieme kandidaten gevonden met deze filters.</p>
        }

        <div class="drilldown-grid">
            @foreach (var card in _results)
            {
                <TalentPoolResultCard Card="card"
                                      ShowRiasec="ShowRiasecTagFilter"
                                      CanMutate="_canMutate"
                                      UnlockLabel="@Culture["Talent.Unlock"]"
                                      OnUnlock="UnlockAsync" />
            }
        </div>
    </article>
</div>

@code {
    private bool _loading;
    private bool _canMutate = true;
    private string? _message;
    private string _tags = "";
    private int? _maxTravel = 45;
    private string _license = "";
    private string _availability = "";
    private string _transport = TransportLabels.Bike;
    private List<AnonymousTalentCard> _results = [];
    private bool ShowRiasecTagFilter => Configuration.GetValue(TalentPoolRiasecVisibility.ConfigKey, false);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _canMutate = ResolveCanMutate(auth.User);
        await SearchAsync();
    }

    private static bool ResolveCanMutate(System.Security.Claims.ClaimsPrincipal user)
    {
        foreach (UserRole role in Enum.GetValues<UserRole>())
        {
            if (RoleClaimMatching.HasRole(user, role.ToString()) && JobsyRoles.CanMutateEmployerData(role))
            {
                return true;
            }
        }

        return false;
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            var tags = ShowRiasecTagFilter ? _tags : "";
            _results = await Api.SearchTalentPoolAsync(tags, _maxTravel, _license, _availability, _transport) ?? [];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _results = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UnlockAsync(Guid candidateUserId)
    {
        _message = null;
        try
        {
            var msg = "Hallo! We hebben interesse in een gesprek via Lobsy.";
            await Api.UnlockTalentContactAsync(candidateUserId, msg);
            _message = "Contactverzoek verstuurd (1 token).";
            Navigation.NavigateTo("/werkgever/talentpool?tab=contact");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }
}
