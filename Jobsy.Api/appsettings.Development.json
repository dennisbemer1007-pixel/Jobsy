{
  "JobsyFeatures": {
    "ExposeRegistrationActivationLinks": true
  },
  "JobsyAuth": {
    "AllowDevelopmentAuth": true,
    "DevelopmentAuthSecret": "local-dev-jobsy-auth-secret",
    "ExternalProvisionSecret": "local-dev-jobsy-provision-secret"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
